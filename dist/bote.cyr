# Requires (compile-verified; the leaves of dist/bote.deps):
include "lib/hashmap.cyr"
include "lib/ws_server.cyr"
include "lib/bayan.cyr"
include "lib/syscalls.cyr"

# --- log.cyr ---

# bote::log — operational logging through sakshi.
#
# ## Before you compile this (it is the first module of both dist bundles)
#
# Minimum cyrius: 6.7.13
#
#   6.7.13 and later compile both bundles, pass the core-only smoke test and
#   answer a ping. 6.7.2 through 6.7.12 still compile dist/bote-core.cyr, but
#   stop on dist/bote.cyr with "undefined variable
#   'SANDHI_SERVER_FAIL_CONFIG'": its transports need sandhi 1.10.10. 6.7.1 and
#   earlier stop at the first `const` below, with "expected '=', got
#   identifier". scripts/bundle-min-cyrius.sh measures this on every installed
#   toolchain. Re-run it at every pin move, and whenever bote starts using a
#   newer language feature.
#
#   A copied bundle (src/vendor/bote-core.cyr) rather than a [deps.bote]
#   pin must also declare "sakshi" in its own [deps] stdlib. This module
#   calls sakshi, and the bundle's requires block does not include it. A
#   pinned consumer gets sakshi through bote's deps.libro (patra includes
#   it); a copied file brings neither. Without it the build stops on
#   undefined sakshi_* functions.
#
# ## Contract
#
# - **Every line goes through sakshi**, to sakshi's configured output, which
#   is stderr unless an embedder or `BOTE_LOG_FILE` says otherwise. Never
#   stdout: on the stdio transport stdout is the JSON-RPC wire, and one stray
#   byte there corrupts the client's stream.
# - **Library code never configures sakshi.** Modules call `bote_log_*` and
#   sakshi's level filter decides. Only an entry point calls `bote_log_init`,
#   which reads `BOTE_LOG` / `BOTE_LOG_FILE`. An embedder that vendors a dist
#   bundle keeps its own `sakshi_set_level` / `sakshi_output_*` choices, and
#   bote's lines land wherever it sends sakshi's.
# - **Levels** (sakshi's): ERROR for a failure an operator must act on
#   (a bind that failed, a listener given up), WARN for a refusal or an
#   anomaly the process survives (an auth rejection, an SSRF block, a path
#   escape), INFO for lifecycle (starting, listening, stopped), DEBUG for
#   one line per request, TRACE for what is under a request (it also turns
#   on sandhi's spans in the binaries).
# - **Never log a secret.** No bearer token, JWT, cookie, request body or
#   tool argument goes into a line. A tool name, a method name, a status,
#   a length or an errno does.
#
# ## Building a line without the heap
#
# A line lives in a buffer on the caller's stack, `BOTE_LOG_LINE_BYTES` long:
#
#   var ln[BOTE_LOG_LINE_BYTES];
#   bote_log_line(&ln, SK_INFO, "listening");
#   bote_log_str(&ln, "transport", "http");
#   bote_log_int(&ln, "port", port);
#   bote_log_emit(&ln);
#
# renders `listening transport=http port=8390`. When the level is filtered
# out, `bote_log_line` marks the buffer dead and every later call on it
# returns at once, so a suppressed line costs one compare and builds nothing.
# Nothing here allocates: the dispatch hot path can carry a DEBUG line at no
# measurable cost while the level is INFO (benches: 3.4.0 CHANGELOG).
#
# Buffer layout: +0 level, +8 used bytes (-1 = dead), +16 truncated flag,
# +24 text (`BOTE_LOG_TEXT_CAP` bytes).
#
# ## Values are logfmt, and request-derived ones are escaped
#
# `bote_log_str` writes `key=value`. A value made only of printable ASCII,
# with no space, `"`, `=` or `\`, goes out bare. Anything else is quoted:
# `"` and `\` are backslash-escaped, `\n` `\r` `\t` are spelled out, and any
# other control byte (and 0x7F) is `\xHH`. Bytes 0x80 and up pass through, so
# UTF-8 survives. A tool name or a JSON-RPC method comes from the client, so
# without this a value holding `\n[1] [ERROR] ...` would forge a second log
# line. A value longer than `BOTE_LOG_VALUE_MAX` bytes is cut and ends `...`.
# A line that outgrows its buffer ends `...` too.

# A compiler older than cyrius 6.7.2 stops on the next line with "expected
# '=', got identifier": it has no `const`. See "Minimum cyrius" at the top of
# this module.
const BOTE_LOG_LINE_BYTES = 280;
const BOTE_LOG_TEXT_CAP = 216;

var BOTE_LOG_OFF = 0 - 1;
var BOTE_LOG_UNKNOWN = 0 - 100;
var BOTE_LOG_VALUE_MAX = 96;

# ================================================================
# Level names
# ================================================================

# ASCII-case-insensitive equality of cstring `s` and lowercase literal `lit`.
fn _bote_log_name_is(s, lit): i64 {
    var i = 0;
    while (1 == 1) {
        var a = load8(s + i) & 0xFF;
        var b = load8(lit + i) & 0xFF;
        if (a >= 65 && a <= 90) { a = a + 32; }
        if (a != b) { return 0; }
        if (a == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Map a level name to sakshi's SK_*. `off` / `none` give BOTE_LOG_OFF, which
# filters out even FATAL. Anything else, and a null pointer, gives
# BOTE_LOG_UNKNOWN so the caller can leave the level where it is.
fn bote_log_level_from_name(name): i64 {
    if (name == 0) { return BOTE_LOG_UNKNOWN; }
    if (_bote_log_name_is(name, "off") == 1) { return BOTE_LOG_OFF; }
    if (_bote_log_name_is(name, "none") == 1) { return BOTE_LOG_OFF; }
    if (_bote_log_name_is(name, "fatal") == 1) { return SK_FATAL; }
    if (_bote_log_name_is(name, "error") == 1) { return SK_ERROR; }
    if (_bote_log_name_is(name, "warn") == 1) { return SK_WARN; }
    if (_bote_log_name_is(name, "warning") == 1) { return SK_WARN; }
    if (_bote_log_name_is(name, "info") == 1) { return SK_INFO; }
    if (_bote_log_name_is(name, "debug") == 1) { return SK_DEBUG; }
    if (_bote_log_name_is(name, "trace") == 1) { return SK_TRACE; }
    return BOTE_LOG_UNKNOWN;
}

# Lowercase name of a level, as `BOTE_LOG` spells it: the inverse of
# bote_log_level_from_name for every level it returns. Below FATAL is "off".
fn bote_log_level_name(level): i64 {
    if (level < SK_FATAL) { return "off"; }
    if (level == SK_FATAL) { return "fatal"; }
    if (level == SK_ERROR) { return "error"; }
    if (level == SK_WARN) { return "warn"; }
    if (level == SK_INFO) { return "info"; }
    if (level == SK_DEBUG) { return "debug"; }
    return "trace";
}

# 1 when a line at `level` would be emitted at sakshi's current level.
fn bote_log_enabled(level): i64 {
    if (level <= sakshi_get_level()) { return 1; }
    return 0;
}

# ================================================================
# Plain messages (a trusted cstring literal, no fields)
# ================================================================

# Hand `len` bytes at `msg` to sakshi at `level`. The per-level calls keep
# sakshi's compile-time elision (`SAKSHI_LEVEL`, `SAKSHI_DISABLE_*`) working.
fn _bote_log_send(level, msg, len): i64 {
    if (level == SK_FATAL) { return sakshi_fatal(msg, len); }
    if (level == SK_ERROR) { return sakshi_error(msg, len); }
    if (level == SK_WARN) { return sakshi_warn(msg, len); }
    if (level == SK_INFO) { return sakshi_info(msg, len); }
    if (level == SK_DEBUG) { return sakshi_debug(msg, len); }
    return sakshi_trace(msg, len);
}

# The level check here is a fast path that skips the strlen. sakshi's own
# filter is the authority: its per-level calls check again, so dropping this
# line changes cost, not output.
fn bote_log(level, msg): i64 {
    if (level > sakshi_get_level()) { return 0; }
    return _bote_log_send(level, msg, strlen(msg));
}

fn bote_log_fatal(msg): i64 { return bote_log(SK_FATAL, msg); }
fn bote_log_error(msg): i64 { return bote_log(SK_ERROR, msg); }
fn bote_log_warn(msg): i64 { return bote_log(SK_WARN, msg); }
fn bote_log_info(msg): i64 { return bote_log(SK_INFO, msg); }
fn bote_log_debug(msg): i64 { return bote_log(SK_DEBUG, msg); }
fn bote_log_trace(msg): i64 { return bote_log(SK_TRACE, msg); }

# ================================================================
# Lines with fields
# ================================================================

# Append one byte to the line. When it is full, end the text with "..."
# once and drop the rest.
fn _bote_log_put(ln, b): i64 {
    var used = load64(ln + 8);
    if (used < 0) { return 0; }
    if (used >= BOTE_LOG_TEXT_CAP) {
        if (load64(ln + 16) == 0) {
            store64(ln + 16, 1);
            store8(ln + 24 + BOTE_LOG_TEXT_CAP - 3, 46);
            store8(ln + 24 + BOTE_LOG_TEXT_CAP - 2, 46);
            store8(ln + 24 + BOTE_LOG_TEXT_CAP - 1, 46);
        }
        return 0;
    }
    store8(ln + 24 + used, b);
    store64(ln + 8, used + 1);
    return 0;
}

fn _bote_log_put_cstr(ln, s): i64 {
    var i = 0;
    while (load8(s + i) != 0) {
        _bote_log_put(ln, load8(s + i));
        i = i + 1;
    }
    return 0;
}

fn _bote_log_hex_digit(n): i64 {
    if (n < 10) { return 48 + n; }
    return 87 + n;                  # 'a' - 10
}

# 1 when byte `c` may appear in a bare (unquoted) logfmt value.
fn _bote_log_bare_byte(c): i64 {
    if (c <= 32) { return 0; }      # control bytes and space
    if (c >= 127) { return 0; }     # DEL, and 0x80+ (quoted so UTF-8 stays one token)
    if (c == 34) { return 0; }      # "
    if (c == 61) { return 0; }      # =
    if (c == 92) { return 0; }      # backslash
    return 1;
}

# Start a line at `level` with the trusted message `msg`. When the level is
# filtered out the line is dead, and every call on it is a no-op.
fn bote_log_line(ln, level, msg): i64 {
    store64(ln, level);
    store64(ln + 16, 0);
    if (level > sakshi_get_level()) {
        store64(ln + 8, 0 - 1);
        return 0;
    }
    store64(ln + 8, 0);
    _bote_log_put_cstr(ln, msg);
    return 0;
}

# Append ` key=value`. `key` is a trusted literal; `val` is any cstring
# (request-derived or not) and is escaped as the header describes. A null
# `val` is written as `""`.
fn bote_log_str(ln, key, val): i64 {
    if (load64(ln + 8) < 0) { return 0; }
    _bote_log_put(ln, 32);
    _bote_log_put_cstr(ln, key);
    _bote_log_put(ln, 61);
    if (val == 0) {
        _bote_log_put(ln, 34);
        _bote_log_put(ln, 34);
        return 0;
    }
    var n = strlen(val);
    var cut = 0;
    if (n > BOTE_LOG_VALUE_MAX) { n = BOTE_LOG_VALUE_MAX; cut = 1; }
    var bare = 1;
    if (n == 0) { bare = 0; }
    var i = 0;
    while (i < n) {
        if (_bote_log_bare_byte(load8(val + i) & 0xFF) == 0) { bare = 0; }
        i = i + 1;
    }
    if (bare == 0) { _bote_log_put(ln, 34); }
    i = 0;
    while (i < n) {
        var c = load8(val + i) & 0xFF;
        if (bare == 1) {
            _bote_log_put(ln, c);
        } elif (c == 34 || c == 92) {
            _bote_log_put(ln, 92);
            _bote_log_put(ln, c);
        } elif (c == 10) {
            _bote_log_put(ln, 92); _bote_log_put(ln, 110);
        } elif (c == 13) {
            _bote_log_put(ln, 92); _bote_log_put(ln, 114);
        } elif (c == 9) {
            _bote_log_put(ln, 92); _bote_log_put(ln, 116);
        } elif (c < 32 || c == 127) {
            _bote_log_put(ln, 92); _bote_log_put(ln, 120);
            _bote_log_put(ln, _bote_log_hex_digit(c >> 4));
            _bote_log_put(ln, _bote_log_hex_digit(c & 15));
        } else {
            _bote_log_put(ln, c);
        }
        i = i + 1;
    }
    if (cut == 1) {
        _bote_log_put(ln, 46); _bote_log_put(ln, 46); _bote_log_put(ln, 46);
    }
    if (bare == 0) { _bote_log_put(ln, 34); }
    return 0;
}

# Append ` key=<decimal n>`.
fn bote_log_int(ln, key, n): i64 {
    if (load64(ln + 8) < 0) { return 0; }
    _bote_log_put(ln, 32);
    _bote_log_put_cstr(ln, key);
    _bote_log_put(ln, 61);
    if (n == 0) { return _bote_log_put(ln, 48); }
    var digits[24];
    var k = 0;
    var neg = 0;
    if (n < 0) { neg = 1; }
    # Digits from the (possibly negative) value without negating it, so
    # i64::MIN formats instead of overflowing back to itself.
    while (n != 0) {
        var q = n / 10;
        var d = n - q * 10;
        if (d < 0) { d = 0 - d; }
        store8(&digits + k, 48 + d);
        k = k + 1;
        n = q;
    }
    if (neg == 1) { _bote_log_put(ln, 45); }
    while (k > 0) {
        k = k - 1;
        _bote_log_put(ln, load8(&digits + k));
    }
    return 0;
}

# Hand the line to sakshi. A dead line emits nothing.
fn bote_log_emit(ln): i64 {
    var used = load64(ln + 8);
    if (used < 0) { return 0; }
    return _bote_log_send(load64(ln), ln + 24, used);
}

# The text built so far and its length — for tests, and for an embedder that
# wants the rendered bytes without emitting them.
fn bote_log_line_text(ln): i64 { return ln + 24; }
fn bote_log_line_len(ln): i64 { return load64(ln + 8); }

# ================================================================
# Entry-point configuration
# ================================================================

# Configure sakshi from the environment. Call once, from a binary's main,
# after alloc_init(). Library code must not call it.
#
#   BOTE_LOG       off | fatal | error | warn | info | debug | trace
#                  (case-insensitive; `none` = off, `warning` = warn).
#                  Default: info. An unrecognised value keeps the default
#                  and is reported as a warning.
#   BOTE_LOG_FILE  append lines to this file instead of stderr. When it
#                  cannot be opened, lines stay on stderr and the failure is
#                  reported. Operator-supplied, never request-derived.
#
# Returns the level now in force.
fn bote_log_init(): i64 {
    sakshi_set_level(SK_INFO);
    var name = getenv("BOTE_LOG");
    var unknown = 0;
    if (name != 0) {
        var lv = bote_log_level_from_name(name);
        if (lv == BOTE_LOG_UNKNOWN) { unknown = 1; }
        else { sakshi_set_level(lv); }
    }
    var path = getenv("BOTE_LOG_FILE");
    if (path != 0 && load8(path) != 0) {
        var fd = sakshi_output_file(path);
        if (fd < 0) {
            var ln[BOTE_LOG_LINE_BYTES];
            bote_log_line(&ln, SK_WARN, "BOTE_LOG_FILE could not be opened; logging to stderr");
            bote_log_str(&ln, "path", path);
            bote_log_int(&ln, "errno", 0 - fd);
            bote_log_emit(&ln);
        }
    }
    if (unknown == 1) {
        var ul[BOTE_LOG_LINE_BYTES];
        bote_log_line(&ul, SK_WARN, "BOTE_LOG not recognised; using info");
        bote_log_str(&ul, "value", name);
        bote_log_emit(&ul);
    }
    return sakshi_get_level();
}

# --- error.cyr ---

# bote::error — BoteError tags and JSON-RPC code mapping
# Mirrors rust-old/src/error.rs

enum BoteErrTag {
    BOTE_ERR_TOOL_NOT_FOUND = 0;
    BOTE_ERR_INVALID_PARAMS = 1;
    BOTE_ERR_EXEC_FAILED = 2;
    BOTE_ERR_PROTOCOL = 3;
    BOTE_ERR_PARSE = 4;
    BOTE_ERR_TRANSPORT_CLOSED = 5;
    BOTE_ERR_BIND_FAILED = 6;
    BOTE_ERR_REQUEST_CANCELLED = 7;
    BOTE_ERR_SCHEMA_VIOLATION = 8;
    BOTE_ERR_SANDBOX = 9;
    BOTE_ERR_JSON = 10;
    BOTE_ERR_IO = 11;
    BOTE_ERR_TAG_COUNT = 12;
}

# BoteError struct (32 bytes):
#   +0  tag       i64
#   +8  tool      cstr or 0
#   +16 reason    cstr or 0
#   +24 extra     vec of cstr (SCHEMA_VIOLATION violations) or 0

fn bote_err_new(tag, tool, reason) {
    return bote_err_new_a(default_alloc(), tag, tool, reason);
}

fn bote_err_new_a(a, tag, tool, reason) {
    var e = alloc_via(a, 32);
    store64(e, tag);
    store64(e + 8, tool);
    store64(e + 16, reason);
    store64(e + 24, 0);
    return e;
}

fn bote_err_with_violations(tag, tool, violations_vec) {
    return bote_err_with_violations_a(default_alloc(), tag, tool, violations_vec);
}

fn bote_err_with_violations_a(a, tag, tool, violations_vec) {
    var e = alloc_via(a, 32);
    store64(e, tag);
    store64(e + 8, tool);
    store64(e + 16, 0);
    store64(e + 24, violations_vec);
    return e;
}

fn bote_err_tag(e) { return load64(e); }
fn bote_err_tool(e) { return load64(e + 8); }
fn bote_err_reason(e) { return load64(e + 16); }
fn bote_err_violations(e) { return load64(e + 24); }

# Map a BoteErrTag to its JSON-RPC error code (negative).
#
# TOOL_NOT_FOUND is -32602 (invalid params), not -32601 (method not found).
# The method, tools/call, exists; only the `name` it was given names nothing.
# That is the MCP tools spec's own example since 2025-06-18:
# {"code":-32602,"message":"Unknown tool: invalid_tool_name"}. bote answered
# -32601 through 3.4.4. A client could read that as "this server does not
# implement tools/call".
fn bote_err_rpc_code(tag) {
    if (tag == BOTE_ERR_PARSE) { return 0 - 32700; }
    if (tag == BOTE_ERR_PROTOCOL) { return 0 - 32600; }
    if (tag == BOTE_ERR_TOOL_NOT_FOUND) { return 0 - 32602; }
    if (tag == BOTE_ERR_INVALID_PARAMS) { return 0 - 32602; }
    if (tag == BOTE_ERR_SCHEMA_VIOLATION) { return 0 - 32602; }
    if (tag == BOTE_ERR_EXEC_FAILED) { return 0 - 32000; }
    if (tag == BOTE_ERR_SANDBOX) { return 0 - 32000; }
    if (tag == BOTE_ERR_TRANSPORT_CLOSED) { return 0 - 32003; }
    if (tag == BOTE_ERR_BIND_FAILED) { return 0 - 32003; }
    if (tag == BOTE_ERR_REQUEST_CANCELLED) { return 0 - 32800; }
    if (tag == BOTE_ERR_JSON) { return 0 - 32700; }
    if (tag == BOTE_ERR_IO) { return 0 - 32603; }
    return 0 - 32603;
}

# Build a Display string for a BoteError. Mirrors the Rust thiserror messages.
fn bote_err_format(e) { return bote_err_format_a(default_alloc(), e); }

fn bote_err_format_a(a, e) {
    var tag = bote_err_tag(e);
    var tool = bote_err_tool(e);
    var reason = bote_err_reason(e);
    var sb = str_builder_new_a(a);

    if (tag == BOTE_ERR_TOOL_NOT_FOUND) {
        str_builder_add_cstr_a(a, sb, "tool not found: ");
        if (tool != 0) { str_builder_add_cstr_a(a, sb, tool); }
    } elif (tag == BOTE_ERR_INVALID_PARAMS) {
        str_builder_add_cstr_a(a, sb, "invalid params for tool '");
        if (tool != 0) { str_builder_add_cstr_a(a, sb, tool); }
        str_builder_add_cstr_a(a, sb, "': ");
        if (reason != 0) { str_builder_add_cstr_a(a, sb, reason); }
    } elif (tag == BOTE_ERR_EXEC_FAILED) {
        str_builder_add_cstr_a(a, sb, "tool execution failed: ");
        if (tool != 0) { str_builder_add_cstr_a(a, sb, tool); }
        str_builder_add_cstr_a(a, sb, " - ");
        if (reason != 0) { str_builder_add_cstr_a(a, sb, reason); }
    } elif (tag == BOTE_ERR_PROTOCOL) {
        str_builder_add_cstr_a(a, sb, "protocol error: ");
        if (reason != 0) { str_builder_add_cstr_a(a, sb, reason); }
    } elif (tag == BOTE_ERR_PARSE) {
        str_builder_add_cstr_a(a, sb, "parse error: ");
        if (reason != 0) { str_builder_add_cstr_a(a, sb, reason); }
    } elif (tag == BOTE_ERR_TRANSPORT_CLOSED) {
        str_builder_add_cstr_a(a, sb, "transport closed");
    } elif (tag == BOTE_ERR_BIND_FAILED) {
        str_builder_add_cstr_a(a, sb, "transport bind failed: ");
        if (reason != 0) { str_builder_add_cstr_a(a, sb, reason); }
    } elif (tag == BOTE_ERR_REQUEST_CANCELLED) {
        str_builder_add_cstr_a(a, sb, "request cancelled: ");
        if (reason != 0) { str_builder_add_cstr_a(a, sb, reason); }
    } elif (tag == BOTE_ERR_SCHEMA_VIOLATION) {
        str_builder_add_cstr_a(a, sb, "schema violation for tool '");
        if (tool != 0) { str_builder_add_cstr_a(a, sb, tool); }
        str_builder_add_cstr_a(a, sb, "': ");
        var vs = bote_err_violations(e);
        if (vs != 0) {
            var n = vec_len(vs);
            var i = 0;
            while (i < n) {
                if (i > 0) { str_builder_add_cstr_a(a, sb, "; "); }
                str_builder_add_cstr_a(a, sb, vec_get(vs, i));
                i = i + 1;
            }
        }
    } elif (tag == BOTE_ERR_SANDBOX) {
        str_builder_add_cstr_a(a, sb, "sandbox error for tool '");
        if (tool != 0) { str_builder_add_cstr_a(a, sb, tool); }
        str_builder_add_cstr_a(a, sb, "': ");
        if (reason != 0) { str_builder_add_cstr_a(a, sb, reason); }
    } elif (tag == BOTE_ERR_JSON) {
        str_builder_add_cstr_a(a, sb, "json error: ");
        if (reason != 0) { str_builder_add_cstr_a(a, sb, reason); }
    } elif (tag == BOTE_ERR_IO) {
        str_builder_add_cstr_a(a, sb, "io error: ");
        if (reason != 0) { str_builder_add_cstr_a(a, sb, reason); }
    } else {
        str_builder_add_cstr_a(a, sb, "unknown error");
    }
    return str_builder_build_a(a, sb);
}

# --- protocol.cyr ---

# bote::protocol — JSON-RPC 2.0 types
# Mirrors rust-old/src/protocol.rs
#
# Cyrius has no nested JSON value type, so id/params/result/data are
# carried as raw JSON-literal C strings ("1", "\"abc\"", "null", "{...}").
# A 0 sentinel for `id` means "not present" (notification).

# JsonRpcRequest (32 bytes):
#   +0  jsonrpc  cstr ("2.0")
#   +8  id       cstr or 0 (0 = notification)
#   +16 method   cstr
#   +24 params   cstr or 0 (raw JSON literal, defaults to "null")

fn req_new(id, method) {
    var r = alloc(32);
    store64(r, "2.0");
    store64(r + 8, id);
    store64(r + 16, method);
    store64(r + 24, "null");
    return r;
}

fn req_notification(method) {
    var r = alloc(32);
    store64(r, "2.0");
    store64(r + 8, 0);
    store64(r + 16, method);
    store64(r + 24, "null");
    return r;
}

fn req_with_params(r, params) {
    store64(r + 24, params);
    return r;
}

fn req_jsonrpc(r) { return load64(r); }
fn req_id(r) { return load64(r + 8); }
fn req_method(r) { return load64(r + 16); }
fn req_params(r) { return load64(r + 24); }

fn req_is_notification(r) {
    if (load64(r + 8) == 0) { return 1; }
    return 0;
}

# JsonRpcError (24 bytes):
#   +0  code    i64 (i32 in Rust; cyrius is i64 always)
#   +8  message cstr
#   +16 data    cstr or 0 (raw JSON literal)

fn rpc_err_new(code, message, data) {
    var e = alloc(24);
    store64(e, code);
    store64(e + 8, message);
    store64(e + 16, data);
    return e;
}

fn rpc_err_code(e) { return load64(e); }
fn rpc_err_message(e) { return load64(e + 8); }
fn rpc_err_data(e) { return load64(e + 16); }

# JsonRpcResponse (32 bytes):
#   +0  jsonrpc  cstr ("2.0")
#   +8  id       cstr (raw JSON literal — required, even on error)
#   +16 result   cstr or 0 (raw JSON literal)
#   +24 error    ptr to JsonRpcError or 0

fn resp_success(id, result) {
    var r = alloc(32);
    store64(r, "2.0");
    store64(r + 8, id);
    store64(r + 16, result);
    store64(r + 24, 0);
    return r;
}

# The request arena (3.4.15). `alloc` never frees, so what a request leaves on
# the heap stays for the life of the process. Every byte bote allocates to
# answer one message goes here instead, and each transport rewinds it when the
# next message starts. What outlives a request stays on the heap: `args` and
# everything else a handler or a sink is handed, since either may keep it, and
# sessions.
#
# The arena is part of a request's state, a block of BOTE_REQ_STATE_BYTES:
#   +0  arena   made on first use
#   +8  token   the token an accepted request presented, on the arena
#   +16 kept    its copy on the heap, once a handler has been handed one
#   +24 why     why this thread's last bote_fetch_in_child failed (src/fetch.cyr), or 0
#   +32 stream  what can hold a `subscriptions/listen` stream open for this message: 0,
#               nothing; 1, an HTTP transport, which opens it itself once the dispatcher
#               has accepted it (3.7.2); or a BoteStream, a connection that is the stream
#               (3.7.3), whose functions the codec calls
#   +40 cancel  (3.7.5) how the connection says the request being served is cancelled:
#               fn(ctx, a, id) → 1 when it has been, or 0 for a transport that cannot say
#   +48 ctx     its context
#   +56 id      the raw id of the request being served, or 0
#   +64 gone    1 once bote_cancelled has found it cancelled
#   +72 claims  (3.7.5) the claims a `subscriptions/listen` was judged with, for the
#               transport that holds its stream, or 0
# A transport that serves one message at a time uses the process's block. A server
# that serves on worker threads (3.7.0, src/conn.cyr) sets _bote_req_state_fp to a
# function returning the calling thread's block, before its first worker starts.
var BOTE_REQ_STATE_BYTES = 80;
var BOTE_REQ_STATE_WHY = 24;
var BOTE_REQ_STATE_STREAM = 32;
var BOTE_REQ_STATE_CANCEL = 40;
var _bote_req_g[10];
var _bote_req_state_fp = 0;

fn bote_req_state() {
    if (_bote_req_state_fp == 0) { return &_bote_req_g; }
    return fncall0(_bote_req_state_fp);
}

fn bote_req_alloc() {
    var s = &_bote_req_g;
    if (_bote_req_state_fp != 0) { s = fncall0(_bote_req_state_fp); }
    var a = load64(s);
    if (a == 0) {
        a = bote_req_arena_new();
        store64(s, a);
    }
    return a;
}

# The registries' lock (3.7.1). A threaded server's workers read the tool, prompt and
# resource registries and the dispatcher's handler maps for every request, and registering
# while it serves writes them: a map that grows moves its entries, and a reader at that
# moment misses a tool or reads past the old table. Readers share the lock, a writer has it
# alone, and a writer that is waiting holds new readers off. It is one word, the readers
# counted in its low bits and BOTE_RW_WRITER above them, and it is taken only once a thread
# exists (`_threads_active`, which a section cannot see change: only thread_create sets it,
# and nothing it guards creates a thread).
#
# ⚠ Not re-entrant either way: a holder that takes it again waits for a writer that waits
# for the holder. Each registry's public functions take it for their own body only and call
# their `_u` forms, which take nothing, inside it.
var BOTE_RW_WRITER = 1099511627776;   # 2^40: far above any count of readers
var _bote_reg_lock = 0;

# A thread waiting on the lock gives its CPU up every BOTE_RW_SPINS turns (3.7.2). With more
# workers than cores, readers spun through whole scheduler slices where the writer they
# waited for could have run: a registration under load took 48 ms on one CPU. The next turn.
var BOTE_RW_SPINS = 64;

fn _bote_reg_wait(spins) {
    if (spins % BOTE_RW_SPINS == BOTE_RW_SPINS - 1) { sys_sched_yield(); }
    return spins + 1;
}

fn bote_reg_read() {
    if (_threads_active == 0) { return 0; }
    while (1 == 1) {
        if ((atomic_fetch_add(&_bote_reg_lock, 1) & BOTE_RW_WRITER) == 0) { return 0; }
        atomic_fetch_add(&_bote_reg_lock, 0 - 1);
        var sp = 0;
        while ((atomic_load(&_bote_reg_lock) & BOTE_RW_WRITER) != 0) { sp = _bote_reg_wait(sp); }
    }
    return 0;
}

fn bote_reg_read_end() {
    if (_threads_active == 0) { return 0; }
    atomic_fetch_add(&_bote_reg_lock, 0 - 1);
    return 0;
}

fn bote_reg_write() {
    if (_threads_active == 0) { return 0; }
    var held = 0;
    var sp = 0;
    while (held == 0) {
        var s = atomic_load(&_bote_reg_lock);
        if ((s & BOTE_RW_WRITER) == 0) { held = atomic_cas(&_bote_reg_lock, s, s + BOTE_RW_WRITER); }
        if (held == 0) { sp = _bote_reg_wait(sp); }
    }
    # The readers inside finish; none comes in past the writer bit.
    while ((atomic_load(&_bote_reg_lock) & (BOTE_RW_WRITER - 1)) != 0) { sp = _bote_reg_wait(sp); }
    atomic_fence();
    return 0;
}

fn bote_reg_write_end() {
    if (_threads_active == 0) { return 0; }
    atomic_fetch_add(&_bote_reg_lock, 0 - BOTE_RW_WRITER);
    return 0;
}

# The arena itself (3.7.0). lib/alloc.cyr's growable arena, when the chunk after the one
# in use is too small for a request, links a new chunk in front of it and keeps both. A
# client whose every message was a little larger than the last therefore added a chunk a
# message, for good: 300 refused resources/read calls, the URI growing from 12 KB to
# 42 KB, kept 105 MB. Filed in cyrius's repository as
# 2026-11-02-bote-growable-arena-keeps-a-chunk-per-larger-request.md. This one takes
# the first chunk ahead that is large enough, and only when there is none adds one, at
# the end of the chain, of the chunk size doubled until the request fits. A chunk is
# added only when a message needs more room than every chunk ahead of it has, so what a
# client can make it keep is bounded by the largest message it sends.
#
# State (40 B): +0 the first chunk, +8 the chunk in use, +16 its next free byte, +24 its
# end, +32 the chunk size. A chunk: +0 the next, +8 its capacity, its bytes from +16.
var BOTE_REQ_CHUNK = 65536;
var BOTE_REQ_ALLOC_MAX = 1099511627776;   # 1 TiB: past this the doubling would overflow

fn _bote_ar_use(st, ch) {
    store64(st + 8, ch);
    store64(st + 16, ch + 16);
    store64(st + 24, ch + 16 + load64(ch + 8));
    return 0;
}

fn _bote_ar_take(st, ch, size) {
    _bote_ar_use(st, ch);
    store64(st + 16, ch + 16 + size);
    return ch + 16;
}

fn _bote_ar_alloc(st, size) {
    if (size <= 0 || size > BOTE_REQ_ALLOC_MAX) { return 0; }
    size = (size + 7) & (0 - 8);
    var p = load64(st + 16);
    if (p + size <= load64(st + 24)) {
        store64(st + 16, p + size);
        return p;
    }
    var prev = load64(st + 8);
    var c = load64(prev);
    while (c != 0) {
        if (load64(c + 8) >= size) { return _bote_ar_take(st, c, size); }
        prev = c;
        c = load64(c);
    }
    var cap = load64(st + 32);
    while (cap < size) { cap = cap * 2; }
    var ch = alloc(cap + 16);
    if (ch == 0) { return 0; }
    store64(ch, 0);
    store64(ch + 8, cap);
    store64(prev, ch);
    return _bote_ar_take(st, ch, size);
}

fn _bote_ar_realloc(st, old, old_size, new_size) {
    var p = _bote_ar_alloc(st, new_size);
    if (p == 0 || old == 0) { return p; }
    var n = old_size;
    if (new_size < n) { n = new_size; }
    memcpy(p, old, n);
    return p;
}

fn _bote_ar_free(st, ptr) { return 0; }

fn _bote_ar_reset(st) { return _bote_ar_use(st, load64(st)); }

# A request arena of its own, as an Allocator, or 0 when the heap is out.
fn bote_req_arena_new() {
    var st = alloc(40);
    var ch = alloc(BOTE_REQ_CHUNK + 16);
    if (st == 0 || ch == 0) { return 0; }
    store64(ch, 0);
    store64(ch + 8, BOTE_REQ_CHUNK);
    store64(st, ch);
    store64(st + 32, BOTE_REQ_CHUNK);
    _bote_ar_use(st, ch);
    return allocator_new(&_bote_ar_alloc, &_bote_ar_realloc, &_bote_ar_free, &_bote_ar_reset, st);
}

# Where the calling thread's request arena is now, into `m` (16 B: the chunk in use and its
# next free byte), for bote_req_release (3.7.2). What a function allocates on the arena
# after the mark and has copied off before it releases it goes then, and not at the next
# message: fs_read's 64 KB buffer stayed for the rest of its message, 6.5 MB for a batch of
# a hundred, and 128 KB a call where nothing rewinds. Nothing allocated after the mark may
# be used after the release.
fn bote_req_mark(m) { return bote_arena_mark(bote_req_alloc(), m); }
fn bote_req_release(m) { return bote_arena_release(bote_req_alloc(), m); }

# The same for any arena `a` (3.7.5): a bote_req_arena_new's, a thread's own or a listen
# carrier's. On an allocator that is no bote arena the mark is empty and the release does
# nothing, so a function handed any allocator may mark and release it.
fn bote_arena_mark(a, m) {
    store64(m, 0);
    store64(m + 8, 0);
    if (a == 0 || load64(a) != &_bote_ar_alloc) { return m; }
    var st = load64(a + 32);
    store64(m, load64(st + 8));
    store64(m + 8, load64(st + 16));
    return m;
}

fn bote_arena_release(a, m) {
    if (load64(m) == 0 || a == 0 || load64(a) != &_bote_ar_alloc) { return 0; }
    var st = load64(a + 32);
    _bote_ar_use(st, load64(m));
    store64(st + 16, load64(m + 8));
    return 0;
}

# Every byte the arena `a` (a bote_req_arena_new) holds, across its chunks.
fn bote_req_arena_bytes(a) {
    var c = load64(load64(a + 32));
    var n = 0;
    while (c != 0) {
        n = n + load64(c + 8);
        c = load64(c);
    }
    return n;
}

# 1 when `s` is an RFC 6749 §3.3 scope-token. A scope goes out inside a quoted header
# parameter, and this is what keeps one from ending it.
fn bote_scope_token_ok(s) {
    if (s == 0 || load8(s) == 0) { return 0; }
    var i = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i);
        if (c < 33 || c > 126 || c == 34 || c == 92) { return 0; }
        i = i + 1;
    }
    return 1;
}

# 1 when every entry of the vec `scopes` is a scope-token; 0 for none is 1.
fn bote_scope_list_ok(scopes) {
    if (scopes == 0) { return 1; }
    var i = 0;
    while (i < vec_len(scopes)) {
        if (bote_scope_token_ok(vec_get(scopes, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# The token an accepted request presented, on the arena, and its copy on the heap once
# a handler has been handed one. A refused call must keep nothing, so that copy waits.

# Start a message: whatever the previous one left on the arena is gone.
fn bote_req_begin() {
    var al = bote_req_alloc();
    reset_via(al);
    var s = bote_req_state();
    store64(s + 8, 0);
    store64(s + 16, 0);
    store64(s + BOTE_REQ_STATE_STREAM, 0);
    store64(s + BOTE_REQ_STATE_CANCEL, 0);
    store64(s + BOTE_REQ_STATE_CANCEL + 8, 0);
    store64(s + BOTE_REQ_STATE_CANCEL + 16, 0);
    store64(s + BOTE_REQ_STATE_CANCEL + 24, 0);
    store64(s + BOTE_REQ_STATE_CANCEL + 32, 0);
    return al;
}

# The claims the dispatcher judged a `subscriptions/listen` with, for the transport that
# opens its stream next (3.7.5): what it keeps of the listen is judged by the same.
fn bote_req_set_listen_claims(claims) {
    store64(bote_req_state() + BOTE_REQ_STATE_CANCEL + 32, claims);
    return claims;
}

fn bote_req_listen_claims() { return load64(bote_req_state() + BOTE_REQ_STATE_CANCEL + 32); }

# ---- cancellation (3.7.5) ----------------------------------------------------------
#
# A client cancels a request in flight: on Streamable HTTP by closing its response
# stream, on stdio with `notifications/cancelled` naming it (MCP 2026-07-28, cancellation;
# 2025-11-25's stdio is the same). A handler runs to its end on the thread that called it,
# so cancelling one is cooperative: a handler that runs long asks bote_cancelled() as it
# goes, and stops when it says 1. The transport answers the question for the message it is
# serving, through the check it sets with bote_req_set_cancel after bote_req_begin; the
# codec names the request. Once a check has said 1 nothing more goes out for the request,
# its response included, and a tools/call is audited as cancelled. A request whose handler
# never asks runs to its end and is answered, which the spec allows: a cancellation that
# arrives after the work is done may be ignored.

# The connection's check for this message: fn(ctx, a, id), 1 when the request whose raw id
# is `id` has been cancelled. `a` is the request arena, rewound past what the check
# allocated once it returns.
fn bote_req_set_cancel(fp, ctx) {
    var s = bote_req_state();
    store64(s + BOTE_REQ_STATE_CANCEL, fp);
    store64(s + BOTE_REQ_STATE_CANCEL + 8, ctx);
    return 0;
}

# The request now being served, by its raw id (the codec's), and not cancelled yet.
fn bote_req_set_request_id(id) {
    var s = bote_req_state();
    store64(s + BOTE_REQ_STATE_CANCEL + 16, id);
    store64(s + BOTE_REQ_STATE_CANCEL + 24, 0);
    return 0;
}

# 1 when this message's connection can say whether its request is cancelled.
fn bote_req_cancel_live() { return load64(bote_req_state() + BOTE_REQ_STATE_CANCEL) != 0; }

# 1 once bote_cancelled has said 1 for the request being served.
fn bote_req_was_cancelled() { return load64(bote_req_state() + BOTE_REQ_STATE_CANCEL + 24); }

# 1 when the client has cancelled the request the calling thread is serving: what a
# handler asks while it works. Each call asks the connection once, a poll or a look at what
# has arrived, and a 1 stays 1. 0 off a handler's own thread, with no request being
# served, and wherever the transport cannot say.
fn bote_cancelled() {
    var s = bote_req_state();
    if (load64(s + BOTE_REQ_STATE_CANCEL + 24) == 1) { return 1; }
    var fp = load64(s + BOTE_REQ_STATE_CANCEL);
    if (fp == 0 || load64(s + BOTE_REQ_STATE_CANCEL + 16) == 0) { return 0; }
    var m[16];
    bote_req_mark(&m);
    var r = fncall3(fp, load64(s + BOTE_REQ_STATE_CANCEL + 8), bote_req_alloc(), load64(s + BOTE_REQ_STATE_CANCEL + 16));
    bote_req_release(&m);
    if (r != 1) { return 0; }
    store64(s + BOTE_REQ_STATE_CANCEL + 24, 1);
    return 1;
}

# What can hold a stream open for the message being dispatched (3.7.2): 0, 1 or a
# BoteStream, as above. The transport sets it around the dispatch, and only then is
# `subscriptions/listen` served: a dispatcher one embedder serves on HTTP and on stdio
# answers it on stdio as a method it does not have, unless stdio carries streams too.
fn bote_req_set_stream(on) {
    store64(bote_req_state() + BOTE_REQ_STATE_STREAM, on);
    return on;
}

fn bote_req_stream() { return load64(bote_req_state() + BOTE_REQ_STATE_STREAM); }

# A BoteStream (3.7.3), 24 B: how a connection that is itself the stream, stdio's, a Unix
# socket's or a WebSocket's, takes a listen over. +0 open, fn(ctx, a, req, resp): what to
# send in the place of `resp`, the dispatcher's acceptance, or 0 for nothing, when it has
# written the stream's first messages itself; +8 cancel, fn(ctx, a, request_id), the raw
# `requestId` of a `notifications/cancelled`, or 0; +16 ctx. The codec calls them
# (src/codec.cyr), so the core knows the shape and not what is behind it.
fn bote_stream_new(open_fp, cancel_fp, ctx) {
    var st = alloc(24);
    store64(st, open_fp);
    store64(st + 8, cancel_fp);
    store64(st + 16, ctx);
    return st;
}

fn bote_stream_open_a(st, a, req, resp) { return fncall4(load64(st), load64(st + 16), a, req, resp); }
fn bote_stream_cancel_a(st, a, id) { return fncall3(load64(st + 8), load64(st + 16), a, id); }

# The token noted for this message, or 0.
fn bote_req_token() { return load64(bote_req_state() + 8); }

# `token` is on the arena and is this message's claims.
fn bote_req_note_token(token) {
    var s = bote_req_state();
    store64(s + 8, token);
    store64(s + 16, 0);
    return token;
}

# bote_req_note_token, with the heap copy an earlier message of the same connection
# already made of it, or 0. A connection that presents its token once, for every message
# after, then keeps one copy, not one per message.
fn bote_req_note_token_kept(token, kept) {
    var s = bote_req_state();
    store64(s + 8, token);
    store64(s + 16, kept);
    return token;
}

# The heap copy of this message's token a handler has been handed, or 0.
fn bote_req_kept() { return load64(bote_req_state() + 16); }

# `claims` as a handler may have them, and a handler may keep them. Once for a message, so
# a batch of calls makes one copy.
fn bote_req_claims_kept(claims) {
    var s = bote_req_state();
    if (claims == 0 || claims != load64(s + 8)) { return claims; }
    if (load64(s + 16) == 0) {
        var n = strlen(claims) + 1;
        var k = alloc(n);
        memcpy(k, claims, n);
        store64(s + 16, k);
    }
    return load64(s + 16);
}

fn resp_success_a(a, id, result) {
    var r = alloc_via(a, 32);
    store64(r, "2.0");
    store64(r + 8, id);
    store64(r + 16, result);
    store64(r + 24, 0);
    return r;
}

fn resp_error_a(a, id, code, message) {
    var e = alloc_via(a, 24);
    store64(e, code);
    store64(e + 8, message);
    store64(e + 16, 0);
    var r = alloc_via(a, 32);
    store64(r, "2.0");
    store64(r + 8, id);
    store64(r + 16, 0);
    store64(r + 24, e);
    return r;
}

fn resp_error_data_a(a, id, code, message, data) {
    var e = alloc_via(a, 24);
    store64(e, code);
    store64(e + 8, message);
    store64(e + 16, data);
    var r = alloc_via(a, 32);
    store64(r, "2.0");
    store64(r + 8, id);
    store64(r + 16, 0);
    store64(r + 24, e);
    return r;
}

fn resp_error(id, code, message) {
    var r = alloc(32);
    store64(r, "2.0");
    store64(r + 8, id);
    store64(r + 16, 0);
    store64(r + 24, rpc_err_new(code, message, 0));
    return r;
}

# resp_error with a `data` member: a raw JSON literal, or 0 to omit it.
fn resp_error_data(id, code, message, data) {
    var r = alloc(32);
    store64(r, "2.0");
    store64(r + 8, id);
    store64(r + 16, 0);
    store64(r + 24, rpc_err_new(code, message, data));
    return r;
}

fn resp_jsonrpc(r) { return load64(r); }
fn resp_id(r) { return load64(r + 8); }
fn resp_result(r) { return load64(r + 16); }
fn resp_error_obj(r) { return load64(r + 24); }

# --- jsonx.cyr ---

# bote::jsonx — nested-aware JSON value extractor
#
# Why: bayan's `json_parse` (lib/bayan.cyr, formerly lib/json.cyr) is
# flat-only — it truncates on nested objects/arrays.
# For dispatch we need to pull "name", "arguments", "version" out of a
# tools/call params object whose "arguments" is itself an object.
#
# This module exposes:
#   jsonx_get_raw(obj_cstr, key) → cstr (raw JSON value) or 0
#   jsonx_get_str(obj_cstr, key) → cstr (the string's raw JSON text, no quotes;
#                                  escapes are not decoded) or 0
#   jsonx_valid(buf, len)        → 1 if buf is one RFC 8259 JSON text, else 0
#   bote_json_escape(sb, cstr)   → appends cstr as a JSON string body (3.4.6)
#
# Limitations: no escape decoding inside strings (only \" is honored for
# detecting closing quote). No whitespace tolerance inside structured values.

# Maximum nesting depth before _jx_skip_struct bails. Audit 1.9.4
# defensive cap — caps adversarial input from walking a hand-crafted
# 100k-deep-but-valid-JSON tree. 64 is well above any legitimate
# protocol message; MCP tool args rarely exceed depth 5.
var JSONX_MAX_DEPTH = 64;

# Skip whitespace; return new index.
fn _jx_skip_ws(buf, len, i) {
    while (i < len) {
        var c = load8(buf + i);
        if (c == 32 || c == 9 || c == 10 || c == 13) { i = i + 1; }
        else { return i; }
    }
    return i;
}

# Skip a JSON string starting at buf[i] (load8(buf+i) == '"').
# Returns index AFTER the closing quote.
fn _jx_skip_string(buf, len, i) {
    i = i + 1;
    while (i < len) {
        var c = load8(buf + i);
        if (c == 92) { i = i + 2; }
        elif (c == 34) { return i + 1; }
        else { i = i + 1; }
    }
    return i;
}

# Skip a JSON value at buf[i]. Returns index AFTER the value.
# Handles: string, number, true/false/null, object, array (recursively).
fn _jx_skip_value(buf, len, i) {
    i = _jx_skip_ws(buf, len, i);
    if (i >= len) { return i; }
    var c = load8(buf + i);
    if (c == 34) { return _jx_skip_string(buf, len, i); }
    if (c == 123) { return _jx_skip_struct(buf, len, i, 123, 125); }
    if (c == 91)  { return _jx_skip_struct(buf, len, i, 91, 93); }
    # Bare token: number, true, false, null — read until terminator.
    while (i < len) {
        var cc = load8(buf + i);
        if (cc == 44 || cc == 125 || cc == 93 || cc == 32 || cc == 9 || cc == 10 || cc == 13) {
            return i;
        }
        i = i + 1;
    }
    return i;
}

# Skip a balanced object/array. open=123 close=125 OR open=91 close=93.
# Bounded by JSONX_MAX_DEPTH (default 64) — pathologically nested input
# bails to end-of-buffer (caller sees end-of-input) rather than walking
# an attacker-crafted deep structure. The 64 KB inbound HTTP buffer
# already caps the absolute worst case, but the explicit guard keeps
# us safe if anyone ever raises that buffer size.
fn _jx_skip_struct(buf, len, i, open, close) {
    var depth = 0;
    while (i < len) {
        var c = load8(buf + i);
        if (c == 34) { i = _jx_skip_string(buf, len, i); }
        elif (c == open) {
            depth = depth + 1;
            if (depth > JSONX_MAX_DEPTH) { return len; }
            i = i + 1;
        }
        elif (c == close) {
            depth = depth - 1;
            i = i + 1;
            if (depth == 0) { return i; }
        }
        else { i = i + 1; }
    }
    return i;
}

# The code unit of a low surrogate `\uDC00`-`\uDFFF` at src + i, or -1.
fn _jx_low_surrogate(src, i, n) {
    if (i + 5 >= n) { return 0 - 1; }
    if (load8(src + i) != 92 || load8(src + i + 1) != 117) { return 0 - 1; }
    var h1 = _jx_hexval(load8(src + i + 2));
    var h2 = _jx_hexval(load8(src + i + 3));
    var h3 = _jx_hexval(load8(src + i + 4));
    var h4 = _jx_hexval(load8(src + i + 5));
    if ((h1 < 0) || (h2 < 0) || (h3 < 0) || (h4 < 0)) { return 0 - 1; }
    var cu = ((h1 * 4096) + (h2 * 256)) + ((h3 * 16) + h4);
    if (cu < 56320 || cu > 57343) { return 0 - 1; }
    return cu;
}

fn _jx_hexval(c) {
    if ((c >= 48) && (c <= 57))  { return c - 48; }        # 0-9
    if ((c >= 97) && (c <= 102)) { return (c - 97) + 10; }  # a-f
    if ((c >= 65) && (c <= 70))  { return (c - 65) + 10; }  # A-F
    return 0 - 1;
}
# Decode the JSON string body at src (n bytes, its escapes unread) into out,
# which has room for n + 1, and may be src itself. Returns the decoded length; a
# `\u0000` leaves a NUL inside it. An escape it cannot read is kept as its
# character. A lone surrogate becomes U+FFFD.
fn _jx_unescape_into(src, n, out) {
    var i = 0;
    var o = 0;
    while (i < n) {
        var c = load8(src + i);
        if ((c == 92) && ((i + 1) < n)) {    # backslash
            var d = load8(src + i + 1);
            if (d == 110)      { store8(out + o, 10); o = o + 1; i = i + 2; }   # \n
            elif (d == 116)    { store8(out + o, 9);  o = o + 1; i = i + 2; }   # \t
            elif (d == 114)    { store8(out + o, 13); o = o + 1; i = i + 2; }   # \r
            elif (d == 34)     { store8(out + o, 34); o = o + 1; i = i + 2; }   # \"
            elif (d == 92)     { store8(out + o, 92); o = o + 1; i = i + 2; }   # \\
            elif (d == 47)     { store8(out + o, 47); o = o + 1; i = i + 2; }   # \/
            elif (d == 98)     { store8(out + o, 8);  o = o + 1; i = i + 2; }   # \b
            elif (d == 102)    { store8(out + o, 12); o = o + 1; i = i + 2; }   # \f
            elif ((d == 117) && ((i + 5) < n)) {                                # \uXXXX
                var h1 = _jx_hexval(load8(src + i + 2));
                var h2 = _jx_hexval(load8(src + i + 3));
                var h3 = _jx_hexval(load8(src + i + 4));
                var h4 = _jx_hexval(load8(src + i + 5));
                if ((h1 < 0) || (h2 < 0) || (h3 < 0) || (h4 < 0)) {
                    store8(out + o, d); o = o + 1; i = i + 2;    # malformed -> keep 'u'
                } else {
                    var cp = ((h1 * 4096) + (h2 * 256)) + ((h3 * 16) + h4);
                    var low = _jx_low_surrogate(src, i + 6, n);
                    if (cp >= 55296 && cp <= 56319 && low >= 0) {
                        # A surrogate pair is one code point, four UTF-8 bytes.
                        cp = 65536 + ((cp - 55296) * 1024) + (low - 56320);
                        store8(out + o, 240 + (cp / 262144)); o = o + 1;
                        store8(out + o, 128 + ((cp / 4096) % 64)); o = o + 1;
                        store8(out + o, 128 + ((cp / 64) % 64)); o = o + 1;
                        store8(out + o, 128 + (cp % 64)); o = o + 1;
                        i = i + 6;
                    } elif (cp >= 55296 && cp <= 57343) {
                        # A lone surrogate is not text: U+FFFD.
                        store8(out + o, 239); o = o + 1;
                        store8(out + o, 191); o = o + 1;
                        store8(out + o, 189); o = o + 1;
                    } elif (cp < 128) {
                        store8(out + o, cp); o = o + 1;
                    } elif (cp < 2048) {
                        store8(out + o, 192 + (cp / 64)); o = o + 1;
                        store8(out + o, 128 + (cp - ((cp / 64) * 64))); o = o + 1;
                    } else {
                        var hi = cp / 4096;
                        var mid = (cp / 64) - (hi * 64);
                        var lo = cp - ((cp / 64) * 64);
                        store8(out + o, 224 + hi); o = o + 1;
                        store8(out + o, 128 + mid); o = o + 1;
                        store8(out + o, 128 + lo); o = o + 1;
                    }
                    i = i + 6;
                }
            }
            else { store8(out + o, d); o = o + 1; i = i + 2; }  # unknown escape -> keep char
        } else {
            store8(out + o, c); o = o + 1; i = i + 1;
        }
    }
    store8(out + o, 0);
    return o;
}

# 1 when the n bytes at p hold a backslash.
fn _jx_has_escape(p, n) {
    var i = 0;
    while (i < n) {
        if (load8(p + i) == 92) { return 1; }
        i = i + 1;
    }
    return 0;
}

# One pass over the object at buf for `n` keys: `keys` holds a (cstr, length)
# pair per key, and pos[i] gets the offset of the first occurrence's value, or
# -1. This is the one key scanner: _jx_find_value_pos is its one-key form, so
# the codec, the dispatcher and the validator cannot read a message differently.
# A key is matched as what it decodes to: `"c\u006et"` is the key `cnt`, here for
# the validator and for a handler alike.
fn _jx_scan(buf, len, keys, n, pos) {
    var k = 0;
    while (k < n) { store64(pos + k * 8, 0 - 1); k = k + 1; }
    var i = _jx_skip_ws(buf, len, 0);
    if (i >= len || load8(buf + i) != 123) { return 0; }
    i = i + 1;
    var left = n;
    var dec[256];
    while (i < len) {
        i = _jx_skip_ws(buf, len, i);
        if (i >= len) { return 0; }
        if (load8(buf + i) != 34) { return 0; }
        var ks = i + 1;
        var ke = _jx_skip_string(buf, len, i);
        var kl = ke - ks - 1;
        var kp = buf + ks;
        if (kl > 0 && kl < 256 && _jx_has_escape(kp, kl) == 1) {
            kl = _jx_unescape_into(kp, kl, &dec);
            kp = &dec;
        }
        i = _jx_skip_ws(buf, len, ke);
        if (i >= len || load8(buf + i) != 58) { return 0; }
        i = _jx_skip_ws(buf, len, i + 1);
        k = 0;
        while (k < n) {
            if (kl == load64(keys + k * 16 + 8) && load64(pos + k * 8) < 0) {
                if (memeq(kp, load64(keys + k * 16), kl) == 1) {
                    store64(pos + k * 8, i);
                    left = left - 1;
                    if (left == 0) { return 0; }
                    k = n;
                }
            }
            k = k + 1;
        }
        var ve = _jx_skip_value(buf, len, i);
        i = _jx_skip_ws(buf, len, ve);
        if (i < len && load8(buf + i) == 44) { i = i + 1; }
    }
    return 0;
}

# Every member of the object `obj`, for code that cannot name the keys it wants: a
# schema's `properties`, read at registration. A vec on the heap of key, raw value,
# key, raw value, in order. Each key is what it decodes to, as _jx_scan matches
# one, so a name read here is one a message can reach. Empty for anything else.
fn _jx_members(obj) {
    var out = vec_new();
    if (obj == 0) { return out; }
    var len = strlen(obj);
    var i = _jx_skip_ws(obj, len, 0);
    if (i >= len || load8(obj + i) != 123) { return out; }
    i = i + 1;
    while (i < len) {
        i = _jx_skip_ws(obj, len, i);
        if (i >= len || load8(obj + i) != 34) { return out; }
        var ke = _jx_skip_string(obj, len, i);
        var kl = ke - i - 2;
        var key = alloc(kl + 1);
        _jx_unescape_into(obj + i + 1, kl, key);
        i = _jx_skip_ws(obj, len, ke);
        if (i >= len || load8(obj + i) != 58) { return out; }
        i = _jx_skip_ws(obj, len, i + 1);
        var ve = _jx_skip_value(obj, len, i);
        var val = alloc(ve - i + 1);
        memcpy(val, obj + i, ve - i);
        store8(val + ve - i, 0);
        vec_push(out, key);
        vec_push(out, val);
        i = _jx_skip_ws(obj, len, ve);
        if (i < len && load8(obj + i) == 44) { i = i + 1; }
    }
    return out;
}

# Past the array element at buf[i]: the next element, its closing `]`, or len when
# the array stops making sense. A walk starts one past the `[`, at _jx_skip_ws.
fn _jx_array_next(buf, len, i) {
    var e = _jx_skip_value(buf, len, i);
    if (e <= i) { return len; }
    i = _jx_skip_ws(buf, len, e);
    if (i < len && load8(buf + i) == 44) { i = _jx_skip_ws(buf, len, i + 1); }
    return i;
}

# Find a key inside a flat JSON object (one level). Returns index of the
# value's first byte (after `:` and whitespace), or 0 - 1 if not found.
fn _jx_find_value_pos(buf, len, key) {
    var k[16];
    store64(&k, key);
    store64(&k + 8, strlen(key));
    var p[8];
    _jx_scan(buf, len, &k, 1, &p);
    return load64(&p);
}

# Get raw JSON value bytes for key. Returns cstr (alloc'd, null-terminated)
# containing the verbatim source bytes, or 0 if key not found / input malformed.
fn jsonx_get_raw(obj_cstr, key) {
    if (obj_cstr == 0) { return 0; }
    var len = strlen(obj_cstr);
    var pos = _jx_find_value_pos(obj_cstr, len, key);
    if (pos == 0 - 1) { return 0; }
    var end = _jx_skip_value(obj_cstr, len, pos);
    var n = end - pos;
    var out = alloc(n + 1);
    memcpy(out, obj_cstr + pos, n);
    store8(out + n, 0);
    return out;
}

# Get a string value for key (no quotes). Returns 0 if not found or value
# is not a JSON string. No escape decoding (\\ \" \n \t are passed through
# verbatim — adequate for tool names and version strings).
fn jsonx_get_str(obj_cstr, key) {
    if (obj_cstr == 0) { return 0; }
    var len = strlen(obj_cstr);
    var pos = _jx_find_value_pos(obj_cstr, len, key);
    if (pos == 0 - 1) { return 0; }
    if (load8(obj_cstr + pos) != 34) { return 0; }
    var end = _jx_skip_string(obj_cstr, len, pos);
    # Truncated input (no closing quote): _jx_skip_string returns end == len,
    # so end - pos - 2 can go negative. Clamp to 0 (returns empty string).
    var inner_len = end - pos - 2;
    if (inner_len < 0) { inner_len = 0; }
    var out = alloc(inner_len + 1);
    memcpy(out, obj_cstr + pos + 1, inner_len);
    store8(out + inner_len, 0);
    return out;
}

# The value at pos as jsonx_get_raw returns it: its raw JSON bytes, owned by `a`.
fn _jx_raw_at_a(a, buf, len, pos) {
    if (pos < 0) { return 0; }
    var end = _jx_skip_value(buf, len, pos);
    var n = end - pos;
    var out = alloc_via(a, n + 1);
    memcpy(out, buf + pos, n);
    store8(out + n, 0);
    return out;
}

# The value at pos as jsonx_get_str returns it: 0 unless it is a string.
fn _jx_str_at_a(a, buf, len, pos) {
    if (pos < 0) { return 0; }
    if (load8(buf + pos) != 34) { return 0; }
    var end = _jx_skip_string(buf, len, pos);
    var inner_len = end - pos - 2;
    if (inner_len < 0) { inner_len = 0; }
    var out = alloc_via(a, inner_len + 1);
    memcpy(out, buf + pos + 1, inner_len);
    store8(out + inner_len, 0);
    return out;
}

# _jx_str_at_a with its escapes decoded: what the string means, for the fields
# bote itself compares. `"tools\/list"` is tools/list, and a client that writes
# it that way must not get -32601. A decoded NUL would end the cstr early and
# make it mean something else, so that string stays as it was sent, and matches
# nothing.
fn _jx_str_dec_at_a(a, buf, len, pos) {
    var s = _jx_str_at_a(a, buf, len, pos);
    if (s == 0) { return 0; }
    var n = strlen(s);
    if (_jx_has_escape(s, n) == 0) { return s; }
    var out = alloc_via(a, n + 1);
    var dn = _jx_unescape_into(s, n, out);
    if (strlen(out) != dn) { return s; }
    return out;
}

fn jsonx_get_str_dec_a(a, obj_cstr, key) {
    if (obj_cstr == 0) { return 0; }
    var len = strlen(obj_cstr);
    return _jx_str_dec_at_a(a, obj_cstr, len, _jx_find_value_pos(obj_cstr, len, key));
}

fn jsonx_get_raw_a(a, obj_cstr, key) {
    if (obj_cstr == 0) { return 0; }
    var len = strlen(obj_cstr);
    return _jx_raw_at_a(a, obj_cstr, len, _jx_find_value_pos(obj_cstr, len, key));
}

fn jsonx_get_str_a(a, obj_cstr, key) {
    if (obj_cstr == 0) { return 0; }
    var len = strlen(obj_cstr);
    return _jx_str_at_a(a, obj_cstr, len, _jx_find_value_pos(obj_cstr, len, key));
}

# Returns 1 if obj_cstr contains key, 0 otherwise.
fn jsonx_has(obj_cstr, key) {
    if (obj_cstr == 0) { return 0; }
    if (_jx_find_value_pos(obj_cstr, strlen(obj_cstr), key) == 0 - 1) { return 0; }
    return 1;
}

# Returns 1 if obj_cstr (after leading ws) starts with `{`.
fn jsonx_is_object(obj_cstr) {
    if (obj_cstr == 0) { return 0; }
    var len = strlen(obj_cstr);
    var i = _jx_skip_ws(obj_cstr, len, 0);
    if (i >= len) { return 0; }
    if (load8(obj_cstr + i) != 123) { return 0; }
    return 1;
}

# ================================================================
# Syntax validation (3.4.5)
# ================================================================
#
# The extractors above trust their input: they find a key by scanning and
# never check that the text around it is JSON. JSON-RPC 2.0 §5.1 needs the
# distinction, though. Invalid JSON is a parse error (-32700), and a valid
# JSON text that is not a request is an invalid request (-32600). Through
# 3.4.4 the codec could not tell them apart. `not json` answered -32600,
# and a truncated object that happened to contain a "method" was
# dispatched.
#
# jsonx_valid checks RFC 8259 syntax in one pass and allocates nothing.
# It rejects:
#   - unescaped control bytes inside strings, and malformed escapes;
#   - leading zeros, a bare `-`, a `.` without digits, an `e` without digits;
#   - trailing commas;
#   - anything after the value but whitespace.
# It does not check UTF-8. Bytes >= 0x80 pass through as they always have.
#
# Nesting is capped at JSONX_MAX_DEPTH. That is the same cap _jx_skip_struct
# bails at, so every text this accepts can also be walked by the
# extractors. Recursion depth is bounded by the same cap.

fn _jx_is_digit(c) {
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}

fn _jx_is_hex(c) {
    if (c >= 48 && c <= 57) { return 1; }
    if (c >= 65 && c <= 70) { return 1; }
    if (c >= 97 && c <= 102) { return 1; }
    return 0;
}

# Index after the string at buf[i] (a `"`), or -1.
fn _jx_valid_string(buf, len, i) {
    i = i + 1;
    while (i < len) {
        var c = load8(buf + i);
        if (c == 34) { return i + 1; }
        if (c < 32) { return 0 - 1; }
        if (c == 92) {
            if (i + 1 >= len) { return 0 - 1; }
            var e = load8(buf + i + 1);
            if (e == 117) {
                if (i + 6 > len) { return 0 - 1; }
                var h = 2;
                while (h < 6) {
                    if (_jx_is_hex(load8(buf + i + h)) == 0) { return 0 - 1; }
                    h = h + 1;
                }
                i = i + 6;
            } elif (e == 34 || e == 92 || e == 47 || e == 98 || e == 102 || e == 110 || e == 114 || e == 116) {
                i = i + 2;
            } else {
                return 0 - 1;
            }
        } else {
            i = i + 1;
        }
    }
    return 0 - 1;
}

# Index after the number at buf[i], or -1. RFC 8259 §6:
# -? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]? [0-9]+)?
fn _jx_valid_number(buf, len, i) {
    if (i < len && load8(buf + i) == 45) { i = i + 1; }
    if (i >= len) { return 0 - 1; }
    var c = load8(buf + i);
    if (c == 48) {
        i = i + 1;
    } elif (c >= 49 && c <= 57) {
        while (i < len && _jx_is_digit(load8(buf + i)) == 1) { i = i + 1; }
    } else {
        return 0 - 1;
    }
    if (i < len && load8(buf + i) == 46) {
        i = i + 1;
        if (i >= len || _jx_is_digit(load8(buf + i)) == 0) { return 0 - 1; }
        while (i < len && _jx_is_digit(load8(buf + i)) == 1) { i = i + 1; }
    }
    if (i < len && (load8(buf + i) == 101 || load8(buf + i) == 69)) {
        i = i + 1;
        if (i < len && (load8(buf + i) == 43 || load8(buf + i) == 45)) { i = i + 1; }
        if (i >= len || _jx_is_digit(load8(buf + i)) == 0) { return 0 - 1; }
        while (i < len && _jx_is_digit(load8(buf + i)) == 1) { i = i + 1; }
    }
    return i;
}

# Index after the literal `lit` (n bytes) at buf[i], or -1.
fn _jx_valid_literal(buf, len, i, lit, n) {
    if (i + n > len) { return 0 - 1; }
    if (memeq(buf + i, lit, n) == 0) { return 0 - 1; }
    return i + n;
}

# Index after the object at buf[i] (a `{`), or -1. `depth` counts this one.
fn _jx_valid_object(buf, len, i, depth) {
    i = _jx_skip_ws(buf, len, i + 1);
    if (i < len && load8(buf + i) == 125) { return i + 1; }
    while (i < len) {
        if (load8(buf + i) != 34) { return 0 - 1; }
        i = _jx_valid_string(buf, len, i);
        if (i < 0) { return 0 - 1; }
        i = _jx_skip_ws(buf, len, i);
        if (i >= len || load8(buf + i) != 58) { return 0 - 1; }
        i = _jx_valid_value(buf, len, i + 1, depth);
        if (i < 0) { return 0 - 1; }
        i = _jx_skip_ws(buf, len, i);
        if (i >= len) { return 0 - 1; }
        var c = load8(buf + i);
        if (c == 125) { return i + 1; }
        if (c != 44) { return 0 - 1; }
        i = _jx_skip_ws(buf, len, i + 1);
    }
    return 0 - 1;
}

# Index after the array at buf[i] (a `[`), or -1. `depth` counts this one.
fn _jx_valid_array(buf, len, i, depth) {
    i = _jx_skip_ws(buf, len, i + 1);
    if (i < len && load8(buf + i) == 93) { return i + 1; }
    while (i < len) {
        i = _jx_valid_value(buf, len, i, depth);
        if (i < 0) { return 0 - 1; }
        i = _jx_skip_ws(buf, len, i);
        if (i >= len) { return 0 - 1; }
        var c = load8(buf + i);
        if (c == 93) { return i + 1; }
        if (c != 44) { return 0 - 1; }
        i = _jx_skip_ws(buf, len, i + 1);
    }
    return 0 - 1;
}

# Index after the value at buf[i] (leading whitespace skipped), or -1.
# `depth` is the number of containers already open around it.
fn _jx_valid_value(buf, len, i, depth) {
    i = _jx_skip_ws(buf, len, i);
    if (i >= len) { return 0 - 1; }
    var c = load8(buf + i);
    if (c == 34) { return _jx_valid_string(buf, len, i); }
    if (c == 123 || c == 91) {
        if (depth >= JSONX_MAX_DEPTH) { return 0 - 1; }
        if (c == 123) { return _jx_valid_object(buf, len, i, depth + 1); }
        return _jx_valid_array(buf, len, i, depth + 1);
    }
    if (c == 116) { return _jx_valid_literal(buf, len, i, "true", 4); }
    if (c == 102) { return _jx_valid_literal(buf, len, i, "false", 5); }
    if (c == 110) { return _jx_valid_literal(buf, len, i, "null", 4); }
    return _jx_valid_number(buf, len, i);
}

# 1 when buf[0..len) is exactly one JSON text, surrounding whitespace
# allowed; 0 otherwise, or when buf is 0.
fn jsonx_valid(buf, len) {
    if (buf == 0) { return 0; }
    var end = _jx_valid_value(buf, len, 0, 0);
    if (end < 0) { return 0; }
    if (_jx_skip_ws(buf, len, end) != len) { return 0; }
    return 1;
}

# ================================================================
# String escaping (3.4.6)
# ================================================================
#
# Through 3.4.5 the escaper lived in dispatch.cyr as the private
# `_json_emit_escaped`, and it escaped only `"`, `\`, LF, CR and TAB. It
# copied every other byte below 0x20 through raw, which RFC 8259 §7
# forbids. Every serializer in bote uses it, so a tool result holding an ESC
# or a BEL went out as JSON no client can parse. The 2026-10-15 consumer
# audit measured this on the 3.4.5 binary, with `fs_read` of an
# ANSI-coloured log.
#
# The escape table is lib/str.cyr's `str_builder_add_json_str`: `"` and `\`
# get a backslash, control bytes become `\b \f \n \r \t` or `\u00XX`, and
# bytes from 0x20 up pass through, so UTF-8 is untouched. bote does not call
# that function because it takes a Str and writes the surrounding quotes,
# while every bote call site holds a cstr and writes its own quotes. A Str
# per escaped string would be an allocation for nothing. Runs of plain bytes
# go in with one copy each.

# Append bytes [p, p + n) to sb in one copy. str_builder has no public
# length-taking append, so this passes str_builder_add a Str view built on
# the stack: the {data, len} pair lib/str.cyr reads with str_data / str_len.
fn _jx_add_run(sb, p, n) {
    if (n <= 0) { return 0; }
    var view[16];
    store64(&view, p);
    store64(&view + 8, n);
    var vp = &view;
    str_builder_add(sb, vp);
    return 0;
}

# Append the escape for control, quote or backslash byte c.
fn _jx_add_escape(sb, c) {
    str_builder_putc(sb, 92);
    if (c == 34 || c == 92) { str_builder_putc(sb, c); return 0; }
    if (c == 8) { str_builder_putc(sb, 98); return 0; }
    if (c == 9) { str_builder_putc(sb, 116); return 0; }
    if (c == 10) { str_builder_putc(sb, 110); return 0; }
    if (c == 12) { str_builder_putc(sb, 102); return 0; }
    if (c == 13) { str_builder_putc(sb, 114); return 0; }
    str_builder_putc(sb, 117);
    str_builder_putc(sb, 48);
    str_builder_putc(sb, 48);
    var hi = (c >> 4) & 15;
    var lo = c & 15;
    if (hi < 10) { str_builder_putc(sb, 48 + hi); } else { str_builder_putc(sb, 87 + hi); }
    if (lo < 10) { str_builder_putc(sb, 48 + lo); } else { str_builder_putc(sb, 87 + lo); }
    return 0;
}

# Append `cstr` to sb as the contents of a JSON string, without the
# surrounding quotes. The output is always a valid JSON string body. A NUL
# ends a cstr, so text after an embedded NUL is not emitted. Returns 0, and
# 0 for a null cstr, which appends nothing.
# The length of the UTF-8 sequence at p, or 0 when it is not one (RFC 3629):
# overlong forms, surrogates and anything past U+10FFFF are not. A NUL fails the
# continuation test, so it never reads past the end of a cstr.
fn _jx_utf8_len(p) {
    var c = load8(p);
    var n = 0;
    var lo = 128;
    var hi = 191;
    if (c >= 194 && c <= 223) { n = 2; }
    elif (c >= 224 && c <= 239) {
        n = 3;
        if (c == 224) { lo = 160; }
        if (c == 237) { hi = 159; }
    } elif (c >= 240 && c <= 244) {
        n = 4;
        if (c == 240) { lo = 144; }
        if (c == 244) { hi = 143; }
    } else {
        return 0;
    }
    var b = load8(p + 1);
    if (b < lo || b > hi) { return 0; }
    var k = 2;
    while (k < n) {
        b = load8(p + k);
        if (b < 128 || b > 191) { return 0; }
        k = k + 1;
    }
    return n;
}

fn bote_json_escape(sb, cstr) {
    if (cstr == 0) { return 0; }
    var start = 0;
    var i = 0;
    while (1 == 1) {
        var c = load8(cstr + i);
        if (c == 0) {
            _jx_add_run(sb, cstr + start, i - start);
            return 0;
        }
        if (c == 34 || c == 92 || c < 32) {
            _jx_add_run(sb, cstr + start, i - start);
            _jx_add_escape(sb, c);
            start = i + 1;
            i = i + 1;
        } elif (c < 128) {
            i = i + 1;
        } else {
            # RFC 8259 §8.1: JSON text is UTF-8. A file, a page or a client
            # may hand bote anything, and a strict parser refuses the whole
            # message over one bad byte.
            var u = _jx_utf8_len(cstr + i);
            if (u == 0) {
                _jx_add_run(sb, cstr + start, i - start);
                str_builder_add_cstr(sb, "\\ufffd");
                start = i + 1;
                i = i + 1;
            } else {
                i = i + u;
            }
        }
    }
    return 0;
}

# The pre-3.4.6 private name. Every bote module calls it, and so does hoosh
# (six call sites in its own src/), so it stays as an alias.
fn _json_emit_escaped(sb, cstr) {
    return bote_json_escape(sb, cstr);
}

# --- registry.cyr ---

# bote::registry — Tool registration, discovery, and parameter validation
# Mirrors rust-old/src/registry.rs
#
# Registration checks a tool definition and compiles its input schema
# (3.4.8), so every registered tool is validated by src/schema.cyr's
# compiled_validate: types, enums, bounds, nested objects and required
# fields. registry_validate_params keeps a required-fields-only fallback for
# a definition that somehow carries no compiled schema.

include "lib/hashmap.cyr"

# ================================================================
# ToolAnnotations — tri-state hint flags (MCP 2025-11-25)
# ================================================================
#
# Each hint is i64: 0 = unset, 1 = true, 2 = false.
# Serialization: skip when unset; emit "true" or "false" otherwise.
#
# Layout (32 bytes):
#   +0  read_only_hint
#   +8  destructive_hint
#   +16 idempotent_hint
#   +24 open_world_hint

enum AnnHint {
    HINT_UNSET = 0;
    HINT_TRUE = 1;
    HINT_FALSE = 2;
}

fn ann_new() {
    var a = alloc(32);
    store64(a, HINT_UNSET);
    store64(a + 8, HINT_UNSET);
    store64(a + 16, HINT_UNSET);
    store64(a + 24, HINT_UNSET);
    return a;
}

fn ann_read_only_hint(a) { return load64(a); }
fn ann_destructive_hint(a) { return load64(a + 8); }
fn ann_idempotent_hint(a) { return load64(a + 16); }
fn ann_open_world_hint(a) { return load64(a + 24); }

fn ann_set_read_only(a, v) { store64(a, v); return a; }
fn ann_set_destructive(a, v) { store64(a + 8, v); return a; }
fn ann_set_idempotent(a, v) { store64(a + 16, v); return a; }
fn ann_set_open_world(a, v) { store64(a + 24, v); return a; }

# Preset: read-only tool (no side effects).
fn ann_read_only() {
    var a = ann_new();
    store64(a, HINT_TRUE);
    store64(a + 8, HINT_FALSE);
    store64(a + 16, HINT_TRUE);
    store64(a + 24, HINT_FALSE);
    return a;
}

# Preset: destructive tool.
fn ann_destructive() {
    var a = ann_new();
    store64(a, HINT_FALSE);
    store64(a + 8, HINT_TRUE);
    store64(a + 16, HINT_FALSE);
    store64(a + 24, HINT_TRUE);
    return a;
}

# ================================================================
# ToolSchema — JSON Schema subset
# ================================================================
#
# Layout (24 bytes):
#   +0  schema_type cstr ("object", "string", ...)
#   +8  properties  vec of {key_cstr, value_cstr_raw_json} pairs (16 bytes each) or 0
#   +16 required    vec of cstr or 0

fn schema_new(schema_type, properties_vec, required_vec) {
    var s = alloc(24);
    store64(s, schema_type);
    store64(s + 8, properties_vec);
    store64(s + 16, required_vec);
    return s;
}

fn schema_type(s) { return load64(s); }
fn schema_properties(s) { return load64(s + 8); }
fn schema_required(s) { return load64(s + 16); }

# Property pair (16 bytes): key_cstr, value_cstr (raw JSON literal)
fn schema_prop_new(key, value) {
    var p = alloc(16);
    store64(p, key);
    store64(p + 8, value);
    return p;
}
fn schema_prop_key(p) { return load64(p); }
fn schema_prop_value(p) { return load64(p + 8); }

# ================================================================
# ToolDef
# ================================================================
#
# Layout (80 bytes):
#   +0  name         cstr
#   +8  description  cstr
#   +16 input_schema ptr to ToolSchema
#   +24 version      cstr or 0
#   +32 deprecated   cstr or 0 (deprecation message)
#   +40 annotations  ptr to ToolAnnotations or 0
#   +48 compiled     ptr to CompiledSchema or 0 (set by tool_def_with_compiled)
#   +56 profiles     vec of cstr tags or 0 (set by tool_def_with_profiles)
#   +64 param_headers vec of ParamHeader or 0 (read from the schema at registration)
#   +72 required_scopes vec of cstr or 0 (all of them, for a token to call this tool)
#
# Profiles are opaque consumer-defined tags (e.g. "security", "web", "full")
# used to expose curated tool subsets via a `profile` filter on tools/list.
# bote does no interpretation — membership is exact-match; an untagged tool
# (profiles == 0) is in no profile. See _build_tools_list_result_a in dispatch.

fn tool_def_new(name, description, input_schema) {
    var d = alloc(80);
    store64(d, name);
    store64(d + 8, description);
    store64(d + 16, input_schema);
    store64(d + 24, 0);
    store64(d + 32, 0);
    store64(d + 40, 0);
    store64(d + 48, 0);
    store64(d + 56, 0);
    store64(d + 64, 0);
    store64(d + 72, 0);
    return d;
}

fn tool_def_with_version(d, version) { store64(d + 24, version); return d; }
fn tool_def_with_deprecated(d, msg) { store64(d + 32, msg); return d; }
fn tool_def_with_annotations(d, ann) { store64(d + 40, ann); return d; }
fn tool_def_with_compiled(d, c) { store64(d + 48, c); return d; }
fn tool_def_with_profiles(d, profiles) { store64(d + 56, profiles); return d; }
fn tool_def_with_required_scopes(d, scopes) { store64(d + 72, scopes); return d; }

fn tool_def_name(d) { return load64(d); }
fn tool_def_description(d) { return load64(d + 8); }
fn tool_def_input_schema(d) { return load64(d + 16); }
fn tool_def_version(d) { return load64(d + 24); }
fn tool_def_deprecated(d) { return load64(d + 32); }
fn tool_def_annotations(d) { return load64(d + 40); }
fn tool_def_compiled(d) { return load64(d + 48); }
fn tool_def_profiles(d) { return load64(d + 56); }
fn tool_def_param_headers(d) { return load64(d + 64); }
fn tool_def_required_scopes(d) { return load64(d + 72); }

# Exact-match membership: 1 if `profile` (non-null) is one of the tool's
# profile tags, else 0. A null profile or an untagged tool returns 0.
fn tool_def_has_profile(d, profile) {
    if (profile == 0) { return 0; }
    var profs = tool_def_profiles(d);
    if (profs == 0) { return 0; }
    var n = vec_len(profs);
    var i = 0;
    while (i < n) {
        if (streq(vec_get(profs, i), profile) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# ToolRegistry
# ================================================================
#
# Layout (24 bytes):
#   +0  entries  hashmap: name_cstr -> ToolDef ptr
#   +8  versions hashmap: name_cstr -> vec of ToolDef ptrs
#   +16 names    vec of name_cstr (insertion order, for list())

fn tool_registry_new() {
    var r = alloc(24);
    store64(r, map_new());
    store64(r + 8, map_new());
    store64(r + 16, vec_new());
    return r;
}

fn registry_entries(r) { return load64(r); }
fn registry_versions_map(r) { return load64(r + 8); }
fn registry_names(r) { return load64(r + 16); }

# 1 when `name` follows the MCP tools spec's naming guidance (2025-11-25,
# "Tool Names"): 1-128 characters, each an ASCII letter, a digit, `_`, `-`
# or `.`.
fn _reg_name_ok(name) {
    if (name == 0) { return 0; }
    var n = 0;
    while (load8(name + n) != 0) {
        var c = load8(name + n);
        var ok = 0;
        if (c >= 48 && c <= 57) { ok = 1; }
        if (c >= 65 && c <= 90) { ok = 1; }
        if (c >= 97 && c <= 122) { ok = 1; }
        if (c == 95 || c == 45 || c == 46) { ok = 1; }
        if (ok == 0) { return 0; }
        n = n + 1;
        if (n > 128) { return 0; }
    }
    if (n == 0) { return 0; }
    return 1;
}

# 1 when `raw` is a JSON Schema in its own right: valid JSON that is an
# object, `true` or `false` (2020-12).
fn _reg_subschema_ok(raw) {
    if (raw == 0) { return 0; }
    if (jsonx_valid(raw, strlen(raw)) == 0) { return 0; }
    if (jsonx_is_object(raw) == 1) { return 1; }
    if (streq(raw, "true") == 1 || streq(raw, "false") == 1) { return 1; }
    return 0;
}

# ================================================================
# x-mcp-header
# ================================================================
#
# A tool can have an argument mirrored into an `Mcp-Param-{Name}` header. A client
# drops a tool whose annotation breaks the rules, so bote refuses to register one,
# and HTTP checks the headers against what is read here.
#
# ParamHeader (16 bytes):
#   +0 field  cstr, the whole header name
#   +8 path   vec of cstr, the `properties` keys that lead to the value

var REG_MCP_HEADER = "x-mcp-header";

fn param_header_field(p) { return load64(p); }
fn param_header_path(p) { return load64(p + 8); }

# The words of the space-separated `s`, as a vec of cstrs.
fn _reg_words(s) {
    var out = vec_new();
    var start = 0;
    var k = 0;
    while (load8(s + k) != 0) {
        if (load8(s + k) == 32) {
            var w = alloc(k - start + 1);
            memcpy(w, s + start, k - start);
            store8(w + k - start, 0);
            vec_push(out, w);
            start = k + 1;
        }
        k = k + 1;
    }
    return out;
}

# The keywords that hold a subschema but do not extend a chain of `properties`
# keys. Reading only these, and not every value, keeps a `default` or an `enum` that
# happens to hold the word from counting as an annotation.
var _reg_below_kws = 0;

fn _reg_below() {
    if (_reg_below_kws == 0) {
        _reg_below_kws = _reg_words("items prefixItems contains additionalProperties unevaluatedProperties unevaluatedItems propertyNames not if then else oneOf anyOf allOf patternProperties dependentSchemas $defs definitions ");
    }
    return _reg_below_kws;
}

# 1 when `c` is an RFC 9110 tchar.
fn _reg_tchar(c) {
    if (c >= 48 && c <= 57) { return 1; }
    if (c >= 65 && c <= 90) { return 1; }
    if (c >= 97 && c <= 122) { return 1; }
    if (c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39) { return 1; }
    if (c == 42 || c == 43 || c == 45 || c == 46 || c == 94 || c == 95) { return 1; }
    if (c == 96 || c == 124 || c == 126) { return 1; }
    return 0;
}

fn _reg_token_ok(s) {
    if (load8(s) == 0) { return 0; }
    var i = 0;
    while (load8(s + i) != 0) {
        if (_reg_tchar(load8(s + i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn _reg_lower(c) {
    if (c >= 65 && c <= 90) { return c + 32; }
    return c;
}

# 1 when two cstrs differ at most in the case of their ASCII letters.
fn _reg_ieq(x, y) {
    var i = 0;
    while (_reg_lower(load8(x + i)) == _reg_lower(load8(y + i))) {
        if (load8(x + i) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# The schema `raw` has an annotation: why it is not allowed, or 0, having added it
# to `out`. `reach` says the keys that led here were all `properties` keys.
fn _reg_header_take(raw, path, reach, out) {
    if (reach == 0 || vec_len(path) == 0) {
        return "x-mcp-header must sit on a property reached through `properties` keys alone";
    }
    var name = jsonx_get_str_dec_a(default_alloc(), raw, REG_MCP_HEADER);
    if (name == 0 || _reg_token_ok(name) == 0) {
        return "x-mcp-header must be a non-empty HTTP token";
    }
    var ty = jsonx_get_str(raw, "type");
    if (ty == 0 || (streq(ty, "string") == 0 && streq(ty, "integer") == 0 && streq(ty, "boolean") == 0)) {
        return "x-mcp-header needs a property of type string, integer or boolean";
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Mcp-Param-");
    str_builder_add_cstr(sb, name);
    var field = str_data(str_builder_build(sb));
    var i = 0;
    while (i < vec_len(out)) {
        if (_reg_ieq(field, param_header_field(vec_get(out, i))) == 1) {
            return "x-mcp-header values must be unique, ignoring case";
        }
        i = i + 1;
    }
    var p = alloc(16);
    store64(p, field);
    store64(p + 8, path);
    vec_push(out, p);
    return 0;
}

fn _reg_path_with(path, key) {
    var out = vec_new();
    var i = 0;
    while (i < vec_len(path)) {
        vec_push(out, vec_get(path, i));
        i = i + 1;
    }
    vec_push(out, key);
    return out;
}

# 1 when `kw` holds an object of subschemas by name.
fn _reg_by_name(kw) {
    if (streq(kw, "patternProperties") == 1 || streq(kw, "dependentSchemas") == 1) { return 1; }
    if (streq(kw, "$defs") == 1 || streq(kw, "definitions") == 1) { return 1; }
    return 0;
}

# Walk what the keyword `kw` of _reg_below holds: one subschema, an array of them,
# or an object of them by name.
fn _reg_scan_below(kw, v, out) {
    var subs = vec_new();
    if (_sch_is_array(v) == 1) {
        subs = _sch_split_array(v);
    } elif (_reg_by_name(kw) == 1) {
        var m = _jx_members(v);
        var k = 1;
        while (k < vec_len(m)) {
            vec_push(subs, vec_get(m, k));
            k = k + 2;
        }
    } else {
        vec_push(subs, v);
    }
    var i = 0;
    while (i < vec_len(subs)) {
        var why = _reg_scan_headers(vec_get(subs, i), vec_new(), 0, out);
        if (why != 0) { return why; }
        i = i + 1;
    }
    return 0;
}

# Walk the schema `raw`. Returns why an annotation in it is not allowed, or 0.
fn _reg_scan_headers(raw, path, reach, out) {
    if (jsonx_is_object(raw) == 0) { return 0; }
    var why = 0;
    if (jsonx_has(raw, REG_MCP_HEADER) == 1) {
        why = _reg_header_take(raw, path, reach, out);
        if (why != 0) { return why; }
    }
    var m = _jx_members(jsonx_get_raw(raw, "properties"));
    var i = 0;
    while (i < vec_len(m)) {
        why = _reg_scan_headers(vec_get(m, i + 1), _reg_path_with(path, vec_get(m, i)), reach, out);
        if (why != 0) { return why; }
        i = i + 2;
    }
    var kws = _reg_below();
    i = 0;
    while (i < vec_len(kws)) {
        var v = jsonx_get_raw(raw, vec_get(kws, i));
        if (v != 0) {
            why = _reg_scan_below(vec_get(kws, i), v, out);
            if (why != 0) { return why; }
        }
        i = i + 1;
    }
    return 0;
}

# Every ParamHeader of `tool_def` into `out`. Returns why one is not allowed, or 0.
# The property schemas must already have passed registry_check_tool_def's checks.
fn _reg_scan_tool(tool_def, out) {
    var props = schema_properties(tool_def_input_schema(tool_def));
    if (props == 0) { return 0; }
    var i = 0;
    while (i < vec_len(props)) {
        var pair = vec_get(props, i);
        var path = _reg_path_with(vec_new(), schema_prop_key(pair));
        var why = _reg_scan_headers(schema_prop_value(pair), path, 1, out);
        if (why != 0) { return why; }
        i = i + 1;
    }
    return 0;
}

# Why `tool_def` cannot be registered, as a message, or 0 when it can (3.4.8).
#
# - The name follows the MCP tools spec's guidance. Every consumer's names
#   already do, and a `Str` passed where bote takes a cstr fails it: phylax
#   passed one for every name and its tools/list crashed.
# - inputSchema exists and is an object schema. The spec says it "MUST be a
#   valid JSON Schema object (not null)". t-ron passed `str_from("object")`
#   as the type, and tools/list emitted the Str header as garbage bytes.
# - Each property schema is valid JSON (an object or a boolean), and each
#   property and each required entry has a name.
# - Each `x-mcp-header` keeps the rules of MCP 2026-07-28.
# - Each required scope is a scope-token.
#
# Public, so a consumer can check a definition before it registers one.
fn registry_check_tool_def(tool_def) {
    if (tool_def == 0) { return "no tool definition"; }
    if (_reg_name_ok(tool_def_name(tool_def)) == 0) {
        return "the tool name must be 1-128 characters from A-Z a-z 0-9 _ - .";
    }
    var schema = tool_def_input_schema(tool_def);
    if (schema == 0) { return "inputSchema is missing"; }
    var st = schema_type(schema);
    if (st == 0 || streq(st, "object") == 0) { return "inputSchema type must be \"object\""; }
    var props = schema_properties(schema);
    if (props != 0) {
        var np = vec_len(props);
        var i = 0;
        while (i < np) {
            var pair = vec_get(props, i);
            var key = schema_prop_key(pair);
            if (key == 0 || strlen(key) == 0) { return "an inputSchema property has no name"; }
            if (_reg_subschema_ok(schema_prop_value(pair)) == 0) {
                return "an inputSchema property's schema is not a valid JSON Schema (an object or a boolean)";
            }
            i = i + 1;
        }
    }
    var req = schema_required(schema);
    if (req != 0) {
        var nr = vec_len(req);
        var j = 0;
        while (j < nr) {
            var rq = vec_get(req, j);
            if (rq == 0 || strlen(rq) == 0) { return "an inputSchema required entry is empty"; }
            j = j + 1;
        }
    }
    var scopes = tool_def_required_scopes(tool_def);
    if (scopes != 0) {
        var k = 0;
        while (k < vec_len(scopes)) {
            if (bote_scope_token_ok(vec_get(scopes, k)) == 0) { return "a required scope must be a non-empty token with no space, quote or backslash"; }
            k = k + 1;
        }
    }
    return _reg_scan_tool(tool_def, vec_new());
}

# One ERROR line for a refused registration. The name is logged only when
# it passed the name check; otherwise it may be the bytes of a Str header.
fn _reg_log_refused(tool_def, why) {
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_ERROR, "tool registration refused");
    if (tool_def != 0 && _reg_name_ok(tool_def_name(tool_def)) == 1) {
        bote_log_str(&ln, "tool", tool_def_name(tool_def));
    }
    bote_log_str(&ln, "reason", why);
    bote_log_emit(&ln);
    return 0;
}

# Register `tool_def`. Returns 0, or a BoteError when registry_check_tool_def
# refuses it, in which case nothing is registered and an ERROR line says why.
# The input schema is compiled here unless tool_def_with_compiled already
# attached one (3.4.8). Through 3.4.7 nothing compiled it, so every tool was
# checked only for its required fields.
# One WARN for a keyword on a property that tools/list advertises and validation
# does not enforce, so that a schema's author is told, and the tool still works:
# extra keywords are the client's to read. See the validator's subset in
# schema.cyr. A non-string `enum` and a type array are the same gap.
fn _reg_warn_kw(tool, key, kw) {
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_WARN, "schema keyword not enforced");
    bote_log_str(&ln, "tool", tool);
    bote_log_str(&ln, "property", key);
    bote_log_str(&ln, "keyword", kw);
    bote_log_emit(&ln);
    return 0;
}

fn _reg_warn_unenforced(tool_def) {
    var props = schema_properties(tool_def_input_schema(tool_def));
    if (props == 0) { return 0; }
    var kws = _reg_words("anyOf oneOf allOf not $ref pattern minLength maxLength minItems maxItems const ");
    var i = 0;
    while (i < vec_len(props)) {
        var pair = vec_get(props, i);
        var v = schema_prop_value(pair);
        var k = 0;
        while (k < vec_len(kws)) {
            if (jsonx_has(v, vec_get(kws, k)) == 1) {
                _reg_warn_kw(tool_def_name(tool_def), schema_prop_key(pair), vec_get(kws, k));
            }
            k = k + 1;
        }
        if (jsonx_has(v, "type") == 1 && jsonx_get_str(v, "type") == 0) {
            _reg_warn_kw(tool_def_name(tool_def), schema_prop_key(pair), "type array");
        }
        i = i + 1;
    }
    return 0;
}

# What registration does before it touches the registry: refuses a malformed definition
# (a BoteError), compiles its schema and reads its headers. 0 when it may be added.
fn _registry_prepare(tool_def) {
    var why = registry_check_tool_def(tool_def);
    if (why != 0) {
        _reg_log_refused(tool_def, why);
        var tn = "";
        if (tool_def != 0 && _reg_name_ok(tool_def_name(tool_def)) == 1) { tn = tool_def_name(tool_def); }
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, tn, why);
    }
    if (tool_def_compiled(tool_def) == 0) {
        tool_def_with_compiled(tool_def, compiled_compile(tool_def_input_schema(tool_def)));
    }
    var headers = vec_new();
    _reg_scan_tool(tool_def, headers);
    if (vec_len(headers) > 0) { store64(tool_def + 64, headers); }
    _reg_warn_unenforced(tool_def);
    return 0;
}

# Add a prepared definition, with the registries' lock held to write (3.7.1).
fn _registry_add_u(r, tool_def) {
    var name = tool_def_name(tool_def);
    var entries = registry_entries(r);
    var names = registry_names(r);
    if (map_has(entries, name) == 0) {
        vec_push(names, name);
    }
    map_set(entries, name, tool_def);

    var ver = tool_def_version(tool_def);
    if (ver != 0) {
        var vmap = registry_versions_map(r);
        var bucket = map_get(vmap, name);
        if (bucket == 0) {
            bucket = vec_new();
            map_set(vmap, name, bucket);
        }
        vec_push(bucket, tool_def);
    }
    return 0;
}

fn registry_register(r, tool_def) {
    var err = _registry_prepare(tool_def);
    if (err != 0) { return err; }
    bote_reg_write();
    _registry_add_u(r, tool_def);
    bote_reg_write_end();
    return 0;
}

fn _registry_get_u(r, name) { return map_get(registry_entries(r), name); }

fn registry_get(r, name) {
    bote_reg_read();
    var t = _registry_get_u(r, name);
    bote_reg_read_end();
    return t;
}

fn registry_contains(r, name) {
    bote_reg_read();
    var h = map_has(registry_entries(r), name);
    bote_reg_read_end();
    return h;
}

fn registry_len(r) {
    bote_reg_read();
    var n = map_count(registry_entries(r));
    bote_reg_read_end();
    return n;
}

fn registry_is_empty(r) {
    if (registry_len(r) == 0) { return 1; }
    return 0;
}

# Return a vec of ToolDef pointers in insertion order.
fn registry_list(r) {
    var out = vec_new();
    bote_reg_read();
    var names = registry_names(r);
    var entries = registry_entries(r);
    var n = vec_len(names);
    var i = 0;
    while (i < n) {
        var name = vec_get(names, i);
        if (map_has(entries, name) == 1) {
            vec_push(out, map_get(entries, name));
        }
        i = i + 1;
    }
    bote_reg_read_end();
    return out;
}

fn registry_get_versioned(r, name, version) {
    bote_reg_read();
    var t = _registry_get_versioned_u(r, name, version);
    bote_reg_read_end();
    return t;
}

fn _registry_get_versioned_u(r, name, version) {
    var bucket = map_get(registry_versions_map(r), name);
    if (bucket == 0) { return 0; }
    var n = vec_len(bucket);
    var i = 0;
    while (i < n) {
        var t = vec_get(bucket, i);
        var v = tool_def_version(t);
        if (v != 0 && streq(v, version) == 1) { return t; }
        i = i + 1;
    }
    return 0;
}

# The vec of a tool's versions: the registry's own, which a registration that runs beside
# a read may grow (3.7.1).
fn registry_list_versions(r, name) {
    bote_reg_read();
    var bucket = map_get(registry_versions_map(r), name);
    bote_reg_read_end();
    if (bucket == 0) { return vec_new(); }
    return bucket;
}

# Remove a tool. Returns the removed ToolDef ptr or 0 if absent.
fn registry_deregister(r, name) {
    bote_reg_write();
    var t = _registry_deregister_u(r, name);
    bote_reg_write_end();
    return t;
}

fn _registry_deregister_u(r, name) {
    var entries = registry_entries(r);
    var existing = map_get(entries, name);
    if (existing == 0) { return 0; }
    map_delete(entries, name);
    map_delete(registry_versions_map(r), name);
    # Compact the names vec.
    var names = registry_names(r);
    var n = vec_len(names);
    var i = 0;
    while (i < n) {
        if (streq(vec_get(names, i), name) == 1) {
            vec_remove(names, i);
            i = n;
        }
        i = i + 1;
    }
    return existing;
}

# Mark a tool deprecated with a message. No-op if tool absent. A write (3.7.2): a list
# built beside it sized the reply without the message and then wrote it in.
fn registry_deprecate(r, name, message) {
    bote_reg_write();
    var t = _registry_get_u(r, name);
    if (t != 0) { tool_def_with_deprecated(t, message); }
    bote_reg_write_end();
    return 0;
}

# ================================================================
# validate_params
# ================================================================
#
# Returns 0 on success, or a BoteError ptr on failure.
# Caller checks `bote_err_tag(err)` for the specific failure mode.

# Trim leading whitespace; return first non-ws byte (0 if EOS).
fn _vp_first_nonws(s) {
    if (s == 0) { return 0; }
    var i = 0;
    while (1 == 1) {
        var c = load8(s + i);
        if (c == 0) { return 0; }
        if (c == 32 || c == 9 || c == 10 || c == 13) { i = i + 1; }
        else { return c; }
    }
    return 0;
}

fn registry_validate_params(r, name, params_cstr) {
    return registry_validate_params_a(default_alloc(), r, name, params_cstr);
}

# registry_validate_params with the error and its text on `a`.
fn registry_validate_params_a(a, r, name, params_cstr) {
    return registry_validate_def_a(a, registry_get(r, name), name, params_cstr);
}

# registry_validate_params_a against `t`, the definition the caller found for `name`, or 0
# when it found none (3.7.2): a call judged by what one look at the registry found cannot
# be validated by a definition registered since.
fn registry_validate_def_a(a, t, name, params_cstr) {
    if (t == 0) {
        return bote_err_new_a(a, BOTE_ERR_TOOL_NOT_FOUND, name, 0);
    }

    # 1. params must be a JSON object.
    if (_vp_first_nonws(params_cstr) != 123) {
        return bote_err_new_a(a, BOTE_ERR_INVALID_PARAMS, name, "params must be an object");
    }

    # 2. Compiled schema path (preferred — full type/enum/bounds/nested checks).
    var compiled = tool_def_compiled(t);
    if (compiled != 0) {
        var violations = compiled_check_a(a, compiled, params_cstr);
        if (violations != 0) {
            return bote_err_with_violations_a(a, BOTE_ERR_SCHEMA_VIOLATION, name, violations);
        }
        return 0;
    }

    # 3. Fallback: required-field-present check. Unreachable for a definition
    # registry_register accepted (it compiles one); kept for a ToolDef placed
    # in the registry by other means. jsonx_has, not bayan's flat parser, which
    # refuses a whole object over a repeated key: RFC 8259 allows one, and the
    # field is there.
    var schema = tool_def_input_schema(t);
    var required = schema_required(schema);
    if (required == 0) { return 0; }
    var nreq = vec_len(required);
    if (nreq == 0) { return 0; }

    var i = 0;
    while (i < nreq) {
        var req_key = vec_get(required, i);
        if (jsonx_has(params_cstr, req_key) == 0) {
            var sb = str_builder_new_a(a);
            str_builder_add_cstr_a(a, sb, "missing required field: ");
            str_builder_add_cstr_a(a, sb, req_key);
            var msg = str_builder_build_a(a, sb);
            return bote_err_new_a(a, BOTE_ERR_INVALID_PARAMS, name, str_data(msg));
        }
        i = i + 1;
    }
    return 0;
}

# --- prompts.cyr ---

# bote::prompts — MCP prompts capability (prompts/list + prompts/get)
#
# Mirrors the tool registry (src/registry.cyr): a PromptRegistry holds
# prompt metadata (for prompts/list) plus a name→handler map (for
# prompts/get generation). The dispatcher owns an optional PromptRegistry;
# the `prompts` capability is advertised at initialize iff one is present
# (see src/dispatch.cyr _build_capabilities). JSON serialization lives in
# dispatch.cyr alongside the other MCP method builders.
#
# Prompt handler ABI (mirrors the 2.0 tool ABI):
#   fn h(arguments_cstr, claims) → result_cstr
# where `arguments_cstr` is the prompts/get `arguments` object (JSON) and
# the returned cstr is the full prompts/get result body, e.g.
#   {"description":"...","messages":[{"role":"user","content":{...}}]}
#
# Requires (entry point includes, before this module): hashmap (pulled by
# src/registry.cyr), vec, str, string. No local includes — matches dispatch.

# ================================================================
# PromptArgument — one declared argument (surfaced in prompts/list)
# ================================================================
#
# Layout (24 bytes):
#   +0  name        cstr
#   +8  description cstr or 0
#   +16 required    i64 (0 = optional, 1 = required)

fn prompt_arg_new(name, description, required) {
    var a = alloc(24);
    store64(a, name);
    store64(a + 8, description);
    store64(a + 16, required);
    return a;
}

fn prompt_arg_name(a) { return load64(a); }
fn prompt_arg_description(a) { return load64(a + 8); }
fn prompt_arg_required(a) { return load64(a + 16); }

# ================================================================
# PromptDef — prompt metadata
# ================================================================
#
# Layout (32 bytes):
#   +0  name            cstr
#   +8  description     cstr or 0
#   +16 arguments       vec of PromptArgument ptrs or 0
#   +24 required_scopes vec of cstr or 0: all of them, for a token to get this prompt

fn prompt_def_new(name, description, arguments) {
    var p = alloc(32);
    store64(p, name);
    store64(p + 8, description);
    store64(p + 16, arguments);
    store64(p + 24, 0);
    return p;
}

fn prompt_def_name(p) { return load64(p); }
fn prompt_def_description(p) { return load64(p + 8); }
fn prompt_def_arguments(p) { return load64(p + 16); }
fn prompt_def_required_scopes(p) { return load64(p + 24); }

# What a token must hold to get this prompt, or to complete its arguments: a vec of
# RFC 6749 scope-tokens, all of them. Returns `p`.
fn prompt_def_with_required_scopes(p, scopes) { store64(p + 24, scopes); return p; }

# ================================================================
# PromptRegistry
# ================================================================
#
# Layout (24 bytes):
#   +0  entries  hashmap: name_cstr -> PromptDef ptr
#   +8  names    vec of name_cstr (insertion order, for list())
#   +16 handlers hashmap: name_cstr -> handler fn ptr

fn prompt_registry_new() {
    var r = alloc(24);
    store64(r, map_new());
    store64(r + 8, vec_new());
    store64(r + 16, map_new());
    return r;
}

fn prompt_registry_entries(r) { return load64(r); }
fn prompt_registry_names(r) { return load64(r + 8); }
fn prompt_registry_handlers(r) { return load64(r + 16); }

# Register (or replace) a prompt + its generator handler. Returns 0, or -1 with nothing
# registered when a required scope is no scope-token: it would go out in a 403's header.
fn prompt_registry_register(r, prompt_def, handler_fp) {
    if (bote_scope_list_ok(prompt_def_required_scopes(prompt_def)) == 0) { return 0 - 1; }
    var name = prompt_def_name(prompt_def);
    # Under the registries' lock (3.7.1, src/protocol.cyr), as every function below.
    bote_reg_write();
    var entries = prompt_registry_entries(r);
    if (map_has(entries, name) == 0) {
        vec_push(prompt_registry_names(r), name);
    }
    map_set(entries, name, prompt_def);
    map_set(prompt_registry_handlers(r), name, handler_fp);
    bote_reg_write_end();
    return 0;
}

fn _prompt_registry_get_u(r, name) { return map_get(prompt_registry_entries(r), name); }

fn prompt_registry_get(r, name) {
    bote_reg_read();
    var p = _prompt_registry_get_u(r, name);
    bote_reg_read_end();
    return p;
}

fn prompt_registry_contains(r, name) {
    bote_reg_read();
    var h = map_has(prompt_registry_entries(r), name);
    bote_reg_read_end();
    return h;
}

# The prompt `name`, or 0, and its handler through *fp_out, 0 when it has none, from one
# look at the registry (3.7.2): what prompts/get judges and what serves it are then the
# same registration, whatever replaces it meanwhile.
fn prompt_registry_serving(r, name, fp_out) {
    bote_reg_read();
    var p = _prompt_registry_get_u(r, name);
    var fp = 0;
    if (map_has(prompt_registry_handlers(r), name) == 1) { fp = map_get(prompt_registry_handlers(r), name); }
    bote_reg_read_end();
    store64(fp_out, fp);
    return p;
}

# Handler fn ptr for `name`, or 0 if the prompt is unknown.
fn prompt_registry_handler(r, name) {
    bote_reg_read();
    var fp = 0;
    if (map_has(prompt_registry_handlers(r), name) == 1) { fp = map_get(prompt_registry_handlers(r), name); }
    bote_reg_read_end();
    return fp;
}

fn prompt_registry_len(r) {
    bote_reg_read();
    var n = map_count(prompt_registry_entries(r));
    bote_reg_read_end();
    return n;
}

# Return a vec of PromptDef pointers in insertion order.
fn prompt_registry_list(r) {
    var out = vec_new();
    bote_reg_read();
    var names = prompt_registry_names(r);
    var entries = prompt_registry_entries(r);
    var n = vec_len(names);
    var i = 0;
    while (i < n) {
        var name = vec_get(names, i);
        if (map_has(entries, name) == 1) {
            vec_push(out, map_get(entries, name));
        }
        i = i + 1;
    }
    bote_reg_read_end();
    return out;
}

# --- resources.cyr ---

# bote::resources — MCP resources capability (resources/list + resources/read)
#
# Mirrors src/prompts.cyr: a ResourceRegistry holds resource metadata (for
# resources/list) plus a uri→handler map (for resources/read). The
# dispatcher owns an optional ResourceRegistry; the `resources` capability
# is advertised at initialize iff one is present (see src/dispatch.cyr
# _build_capabilities). JSON serialization for the listing lives in
# dispatch.cyr; read bodies are produced by the handler.
#
# Resource read-handler ABI (mirrors the 2.0 tool ABI):
#   fn h(uri_cstr, claims) → result_cstr
# where `uri_cstr` is the requested resource URI and the returned cstr is
# the full resources/read result body, e.g.
#   {"contents":[{"uri":"...","mimeType":"...","text":"..."}]}
# (MCP ResourceContents — bare uri/mimeType/text|blob, NOT a content block).
#
# A URI no resource has goes to the first ResourceTemplate it matches, whose
# handler has the same ABI. An exact resource always wins.
#
# subscribe / listChanged are intentionally out until a server→client push
# path exists (they need the notification channel that is not yet wired).
#
# Requires (entry point includes, before this module): hashmap (pulled by
# src/registry.cyr), vec, str, string. No local includes — matches dispatch.

# ================================================================
# ResourceDef — resource metadata (surfaced in resources/list)
# ================================================================
#
# Layout (40 bytes):
#   +0  uri             cstr
#   +8  name            cstr
#   +16 description     cstr or 0
#   +24 mime_type       cstr or 0
#   +32 required_scopes vec of cstr or 0: all of them, for a token to read this resource

fn resource_def_new(uri, name, description, mime_type) {
    var r = alloc(40);
    store64(r, uri);
    store64(r + 8, name);
    store64(r + 16, description);
    store64(r + 24, mime_type);
    store64(r + 32, 0);
    return r;
}

fn resource_def_uri(r) { return load64(r); }
fn resource_def_name(r) { return load64(r + 8); }
fn resource_def_description(r) { return load64(r + 16); }
fn resource_def_mime_type(r) { return load64(r + 24); }
fn resource_def_required_scopes(r) { return load64(r + 32); }

# What a token must hold to read this resource: a vec of RFC 6749 scope-tokens, all of
# them. Returns `r`.
fn resource_def_with_required_scopes(r, scopes) { store64(r + 32, scopes); return r; }

# ================================================================
# ResourceTemplate — a family of resources behind one URI template
# ================================================================
#
# Layout (48 bytes):
#   +0  uri_template    cstr, literal text and `{name}` expressions
#   +8  name            cstr
#   +16 description     cstr or 0
#   +24 mime_type       cstr or 0
#   +32 handler         fn ptr, set at registration
#   +40 required_scopes vec of cstr or 0: all of them, to read a URI it serves or complete
#                       its variables
#
# RFC 6570 level 1: a `{name}` stands for one non-empty value holding none of
# `/`, `?` or `#`, which that level percent-encodes. The operators of the higher
# levels are refused, not read as text. Two expressions in one path segment are
# refused too: one value per segment keeps a match linear in the URI, which a client
# writes, where two could make it quadratic. A handler gets the URI as sent, reads
# the value with resource_template_var_a and owns its percent-decoding.

fn resource_template_new(uri_template, name, description, mime_type) {
    var t = alloc(48);
    store64(t, uri_template);
    store64(t + 8, name);
    store64(t + 16, description);
    store64(t + 24, mime_type);
    store64(t + 32, 0);
    store64(t + 40, 0);
    return t;
}

fn resource_template_uri(t) { return load64(t); }
fn resource_template_name(t) { return load64(t + 8); }
fn resource_template_description(t) { return load64(t + 16); }
fn resource_template_mime_type(t) { return load64(t + 24); }
fn resource_template_handler(t) { return load64(t + 32); }
fn resource_template_required_scopes(t) { return load64(t + 40); }

# What a token must hold to read a URI this template serves, or to complete its
# variables: a vec of RFC 6749 scope-tokens, all of them. Returns `t`.
fn resource_template_with_required_scopes(t, scopes) { store64(t + 40, scopes); return t; }

fn _rt_delim(c) {
    if (c == 47 || c == 63 || c == 35) { return 1; }
    return 0;
}

fn _rt_name_char(c) {
    if (c >= 48 && c <= 57) { return 1; }
    if (c >= 65 && c <= 90) { return 1; }
    if (c >= 97 && c <= 122) { return 1; }
    if (c == 95) { return 1; }
    return 0;
}

# 1 when the expression at tpl[i], whose name is n bytes, repeats one ahead of it.
fn _rt_repeated(tpl, i, n) {
    var k = 0;
    while (k < i) {
        if (load8(tpl + k) == 123 && load8(tpl + k + n + 1) == 125 && memeq(tpl + k + 1, tpl + i + 1, n) == 1) { return 1; }
        k = k + 1;
    }
    return 0;
}

# Why `tpl` cannot be a template, as a message, or 0 when it can. `}` closes what
# `{` opened, a name is letters, digits and `_`, and there is one expression at least,
# at most one in a segment, and one of a name: RFC 6570 gives a repeat the same value,
# and a match would have to compare them.
fn resource_template_check(tpl) {
    if (tpl == 0) { return "a template needs a uriTemplate"; }
    var i = 0;
    var total = 0;
    var seg = 0;
    while (load8(tpl + i) != 0) {
        var c = load8(tpl + i);
        if (c == 125) { return "a template has a `}` with no `{`"; }
        if (_rt_delim(c) == 1) { seg = 0; }
        if (c == 123) {
            seg = seg + 1;
            total = total + 1;
            if (seg > 1) { return "a template segment holds one expression at most"; }
            var n = i + 1;
            while (_rt_name_char(load8(tpl + n)) == 1) { n = n + 1; }
            if (n == i + 1 || load8(tpl + n) != 125) {
                return "a template expression must be `{name}`: bote serves RFC 6570 level 1";
            }
            if (_rt_repeated(tpl, i, n - i - 1) == 1) { return "a template names an expression once"; }
            i = n;
        }
        i = i + 1;
    }
    if (total == 0) { return "a template has no expression: register it as a resource"; }
    return 0;
}

# Match tpl[t...] against uri[u...]. With `want` set, the value of that expression
# goes to out, as an offset into uri and a length. Literal bytes are walked here, and
# only an expression recurses, once for each it holds, which is fixed by the template.
fn _rt_match(tpl, t, uri, u, want, out) {
    while (1 == 1) {
        var c = load8(tpl + t);
        if (c == 123) {
            var close = t + 1;
            while (load8(tpl + close) != 125) { close = close + 1; }
            var end = u;
            while (load8(uri + end) != 0 && _rt_delim(load8(uri + end)) == 0) { end = end + 1; }
            # The longest value that leaves the rest of the template matching.
            while (end > u) {
                if (_rt_match(tpl, close + 1, uri, end, want, out) == 1) {
                    if (want != 0 && strlen(want) == close - t - 1 && memeq(want, tpl + t + 1, close - t - 1) == 1) {
                        store64(out, u);
                        store64(out + 8, end - u);
                    }
                    return 1;
                }
                end = end - 1;
            }
            return 0;
        }
        if (c != load8(uri + u)) { return 0; }
        if (c == 0) { return 1; }
        t = t + 1;
        u = u + 1;
    }
    return 0;
}

# 1 when `uri` is what the valid template `tpl` expands to, for some values.
fn resource_template_matches(tpl, uri) {
    if (tpl == 0 || uri == 0) { return 0; }
    return _rt_match(tpl, 0, uri, 0, 0, 0);
}

# The value `uri` gives the expression `name` of `tpl`, as sent, on `a`. 0 when the
# URI does not match or the template has no such expression.
fn resource_template_var_a(a, tpl, uri, name) {
    if (tpl == 0 || uri == 0 || name == 0) { return 0; }
    var span[16];
    store64(&span, 0 - 1);
    store64(&span + 8, 0);
    if (_rt_match(tpl, 0, uri, 0, name, &span) == 0 || load64(&span) < 0) { return 0; }
    var n = load64(&span + 8);
    var out = alloc_via(a, n + 1);
    memcpy(out, uri + load64(&span), n);
    store8(out + n, 0);
    return out;
}

# ================================================================
# ResourceRegistry
# ================================================================
#
# Layout (32 bytes):
#   +0  entries   hashmap: uri_cstr -> ResourceDef ptr
#   +8  uris      vec of uri_cstr (insertion order, for list())
#   +16 handlers  hashmap: uri_cstr -> handler fn ptr
#   +24 templates vec of ResourceTemplate (insertion order)

fn resource_registry_new() {
    var r = alloc(32);
    store64(r, map_new());
    store64(r + 8, vec_new());
    store64(r + 16, map_new());
    store64(r + 24, vec_new());
    return r;
}

fn resource_registry_entries(r) { return load64(r); }
fn resource_registry_uris(r) { return load64(r + 8); }
fn resource_registry_handlers(r) { return load64(r + 16); }
fn resource_registry_templates(r) { return load64(r + 24); }

# Register (or replace) a resource + its read handler. Returns 0, or -1 with nothing
# registered when a required scope is no scope-token: it would go out in a 403's header.
fn resource_registry_register(r, resource_def, handler_fp) {
    if (bote_scope_list_ok(resource_def_required_scopes(resource_def)) == 0) { return 0 - 1; }
    var uri = resource_def_uri(resource_def);
    # Under the registries' lock (3.7.1, src/protocol.cyr), as every function below.
    bote_reg_write();
    var entries = resource_registry_entries(r);
    if (map_has(entries, uri) == 0) {
        vec_push(resource_registry_uris(r), uri);
    }
    map_set(entries, uri, resource_def);
    map_set(resource_registry_handlers(r), uri, handler_fp);
    bote_reg_write_end();
    return 0;
}

fn _resource_registry_get_u(r, uri) { return map_get(resource_registry_entries(r), uri); }

fn resource_registry_get(r, uri) {
    bote_reg_read();
    var d = _resource_registry_get_u(r, uri);
    bote_reg_read_end();
    return d;
}

fn resource_registry_contains(r, uri) {
    bote_reg_read();
    var h = map_has(resource_registry_entries(r), uri);
    bote_reg_read_end();
    return h;
}

# Read-handler fn ptr for `uri`, or 0 if the resource is unknown.
fn resource_registry_handler(r, uri) {
    bote_reg_read();
    var fp = 0;
    if (map_has(resource_registry_handlers(r), uri) == 1) { fp = map_get(resource_registry_handlers(r), uri); }
    bote_reg_read_end();
    return fp;
}

# Register (or replace, by uriTemplate) a template + its read handler. Returns 0, or -1
# with nothing registered when a required scope is no scope-token.
fn resource_registry_register_template(r, template, handler_fp) {
    if (bote_scope_list_ok(resource_template_required_scopes(template)) == 0) { return 0 - 1; }
    bote_reg_write();
    store64(template + 32, handler_fp);
    var ts = resource_registry_templates(r);
    var i = 0;
    var placed = 0;
    while (i < vec_len(ts) && placed == 0) {
        if (streq(resource_template_uri(vec_get(ts, i)), resource_template_uri(template)) == 1) {
            vec_set(ts, i, template);
            placed = 1;
        }
        i = i + 1;
    }
    if (placed == 0) { vec_push(ts, template); }
    bote_reg_write_end();
    return 0;
}

# The first template `uri` matches, which is the one that serves it, or 0.
fn resource_registry_template_for(r, uri) {
    bote_reg_read();
    var t = _resource_registry_template_for_u(r, uri);
    bote_reg_read_end();
    return t;
}

fn _resource_registry_template_for_u(r, uri) {
    var ts = resource_registry_templates(r);
    var i = 0;
    while (i < vec_len(ts)) {
        var t = vec_get(ts, i);
        if (resource_template_matches(resource_template_uri(t), uri) == 1) { return t; }
        i = i + 1;
    }
    return 0;
}

# The template whose uriTemplate is `tpl` exactly, or 0: what a completion names.
fn resource_registry_template_named(r, tpl) {
    bote_reg_read();
    var ts = resource_registry_templates(r);
    var found = 0;
    var i = 0;
    while (i < vec_len(ts) && found == 0) {
        if (streq(resource_template_uri(vec_get(ts, i)), tpl) == 1) { found = vec_get(ts, i); }
        i = i + 1;
    }
    bote_reg_read_end();
    return found;
}

# What serves `uri`, from one look at the registry (3.7.2): the handler through *fp_out,
# and the scopes it requires, or 0 for none. That is the resource registered at `uri` when
# it has a handler, else the first template `uri` matches; *fp_out is 0 for neither. What
# resources/read judges and what serves it are then the same registration.
fn resource_registry_serving(r, uri, fp_out) {
    bote_reg_read();
    var fp = 0;
    var scopes = 0;
    if (map_has(resource_registry_handlers(r), uri) == 1) { fp = map_get(resource_registry_handlers(r), uri); }
    if (fp != 0) {
        scopes = resource_def_required_scopes(_resource_registry_get_u(r, uri));
    } else {
        var t = _resource_registry_template_for_u(r, uri);
        if (t != 0) {
            fp = resource_template_handler(t);
            scopes = resource_template_required_scopes(t);
        }
    }
    bote_reg_read_end();
    store64(fp_out, fp);
    return scopes;
}

# Read-handler fn ptr of the first template `uri` matches, or 0.
fn resource_registry_template_handler(r, uri) {
    var t = resource_registry_template_for(r, uri);
    if (t == 0) { return 0; }
    return resource_template_handler(t);
}

fn resource_registry_len(r) {
    bote_reg_read();
    var n = map_count(resource_registry_entries(r));
    bote_reg_read_end();
    return n;
}

# Return a vec of ResourceDef pointers in insertion order.
fn resource_registry_list(r) {
    var out = vec_new();
    bote_reg_read();
    var uris = resource_registry_uris(r);
    var entries = resource_registry_entries(r);
    var n = vec_len(uris);
    var i = 0;
    while (i < n) {
        var uri = vec_get(uris, i);
        if (map_has(entries, uri) == 1) {
            vec_push(out, map_get(entries, uri));
        }
        i = i + 1;
    }
    bote_reg_read_end();
    return out;
}

# --- events.cyr ---

# bote::events — event topic constants + EventSink abstraction
# Mirrors rust-old/src/events.rs (trait + topic constants).
#
# Cyrius has no traits, so EventSink is a (publish_fp, ctx) struct.
# Backends (e.g. MajraEvents in src/events_majra.cyr — v1.2) wrap their state
# in `ctx` and provide a publish function pointer with signature:
#
#   fn my_publish(ctx, topic_cstr, payload_json_cstr) → 0

# ================================================================
# Topic constants (cstr literals)
# ================================================================
fn TOPIC_TOOL_COMPLETED()    { return "bote/tool/completed"; }
fn TOPIC_TOOL_FAILED()       { return "bote/tool/failed"; }
fn TOPIC_TOOL_REGISTERED()   { return "bote/tool/registered"; }
fn TOPIC_TOOL_ANNOUNCE()     { return "bote/tool/announce"; }
fn TOPIC_TOOL_DISCOVERED()   { return "bote/tool/discovered"; }
fn TOPIC_TOOL_DEPRECATED()   { return "bote/tool/deprecated"; }
fn TOPIC_TOOL_DEREGISTERED() { return "bote/tool/deregistered"; }
fn TOPIC_PROMPT_REGISTERED()  { return "bote/prompt/registered"; }
fn TOPIC_RESOURCE_REGISTERED() { return "bote/resource/registered"; }
fn TOPIC_SANDBOX_CREATED()   { return "bote/sandbox/created"; }
fn TOPIC_SANDBOX_DESTROYED() { return "bote/sandbox/destroyed"; }
fn TOPIC_SANDBOX_ERROR()     { return "bote/sandbox/error"; }

# ================================================================
# EventSink (32 bytes):
#   +0  publish_fp  function pointer (or 0 for no-op sink)
#   +8  ctx         opaque pointer passed to publish_fp
#   +16 list_only   1 when it ignores tool-call events
#   +24 updated_fp  fn(ctx, uri), told a resource's contents changed (3.7.4), or 0
# ================================================================

fn event_sink_new(publish_fp, ctx) {
    var s = alloc(32);
    store64(s, publish_fp);
    store64(s + 8, ctx);
    store64(s + 16, 0);
    store64(s + 24, 0);
    return s;
}

# A resource update is not an event (3.7.4): it carries a URI and no payload, so nothing
# is built for it and nothing kept, and a sink hears of it only through this. The listen
# sinks (src/listen.cyr) do; majra's and the legacy drain's do not.
fn event_sink_with_updated(s, fp) { store64(s + 24, fp); return s; }

fn event_sink_updated(sink, uri) {
    if (sink == 0) { return 0; }
    var fp = load64(sink + 24);
    if (fp == 0) { return 0; }
    fncall2(fp, load64(sink + 8), uri);
    return 0;
}

# Say this sink ignores tool-call events, so dispatch need not build them.
fn event_sink_set_list_only(s) { store64(s + 16, 1); return s; }

# A no-op sink: publish_fp = 0, ctx = 0. Equivalent to "events disabled".
fn event_sink_noop() {
    return event_sink_new(0, 0);
}

fn event_sink_publish_fp(sink) { return load64(sink); }
fn event_sink_ctx(sink) { return load64(sink + 8); }

# Publish an event. Safe to call with sink==0 or noop sink (both no-op).
# topic and payload are cstrs; payload is a raw JSON literal (e.g. "{...}").
fn event_sink_publish(sink, topic, payload) {
    if (sink == 0) { return 0; }
    var fp = load64(sink);
    if (fp == 0) { return 0; }
    var ctx = load64(sink + 8);
    fncall3(fp, ctx, topic, payload);
    return 0;
}

# --- audit.cyr ---

# bote::audit — tool-call audit logging
# Mirrors rust-old/src/audit.rs (trait + ToolCallEvent).
#
# Cyrius has no traits, so AuditSink is a (log_fp, ctx) struct.
# Backends (e.g. LibroAudit in src/audit_libro.cyr — v1.2) wrap their state
# in `ctx` and provide a log function pointer with signature:
#
#   fn my_log(ctx, event_ptr) → 0

# ================================================================
# ToolCallEvent (40 bytes):
#   +0  tool_name     cstr
#   +8  duration_ms   i64
#   +16 success       0/1
#   +24 error         cstr or 0 (only set when success == 0)
#   +32 caller_id     cstr or 0
# ================================================================

fn tool_call_event_new(tool_name, duration_ms, success, error, caller_id) {
    var e = alloc(40);
    store64(e, tool_name);
    store64(e + 8, duration_ms);
    store64(e + 16, success);
    store64(e + 24, error);
    store64(e + 32, caller_id);
    return e;
}

fn tool_call_event_tool_name(e)   { return load64(e); }
fn tool_call_event_duration_ms(e) { return load64(e + 8); }
fn tool_call_event_success(e)     { return load64(e + 16); }
fn tool_call_event_error(e)       { return load64(e + 24); }
fn tool_call_event_caller_id(e)   { return load64(e + 32); }

# Serialize a ToolCallEvent to a JSON cstr. Skips error/caller_id when 0.
# Mirrors Rust's `#[serde(skip_serializing_if = "Option::is_none")]`.
fn tool_call_event_to_json(e) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"tool_name\":\"");
    _json_emit_escaped(sb, tool_call_event_tool_name(e));
    str_builder_add_cstr(sb, "\",\"duration_ms\":");
    str_builder_add_int(sb, tool_call_event_duration_ms(e));
    str_builder_add_cstr(sb, ",\"success\":");
    if (tool_call_event_success(e) == 1) { str_builder_add_cstr(sb, "true"); }
    else { str_builder_add_cstr(sb, "false"); }
    var err = tool_call_event_error(e);
    if (err != 0) {
        str_builder_add_cstr(sb, ",\"error\":\"");
        _json_emit_escaped(sb, err);
        str_builder_add_cstr(sb, "\"");
    }
    var cid = tool_call_event_caller_id(e);
    if (cid != 0) {
        str_builder_add_cstr(sb, ",\"caller_id\":\"");
        _json_emit_escaped(sb, cid);
        str_builder_add_cstr(sb, "\"");
    }
    str_builder_add_cstr(sb, "}");
    return str_data(str_builder_build(sb));
}

# ================================================================
# AuditSink (16 bytes):
#   +0  log_fp  function pointer (or 0 for no-op sink)
#   +8  ctx     opaque pointer passed to log_fp
# ================================================================

fn audit_sink_new(log_fp, ctx) {
    var s = alloc(16);
    store64(s, log_fp);
    store64(s + 8, ctx);
    return s;
}

fn audit_sink_noop() { return audit_sink_new(0, 0); }
fn audit_sink_log_fp(sink) { return load64(sink); }
fn audit_sink_ctx(sink) { return load64(sink + 8); }

# Log an event. Safe to call with sink==0 or noop sink (both no-op).
fn audit_sink_log(sink, event) {
    if (sink == 0) { return 0; }
    var fp = load64(sink);
    if (fp == 0) { return 0; }
    var ctx = load64(sink + 8);
    fncall2(fp, ctx, event);
    return 0;
}

# --- audit_libro.cyr ---

# bote::audit::libro — LibroAudit adapter
# Mirrors rust-old/src/audit.rs::libro_impl::LibroAudit.
#
# Wraps a libro audit chain with bote's AuditSink contract:
#   - Severity: SEV_INFO on success, SEV_ERROR on failure
#   - Action:   "tool.completed" on success, "tool.failed" on failure
#   - Source:   "bote" by default (override via libro_audit_with_source)
#   - Agent:    caller_id from the event takes precedence over configured agent_id
#   - Details:  serialized ToolCallEvent JSON
#
# REQUIRED INIT (caller's main, before any chain operations):
#   alloc_init();   # bump allocator
#   fl_init();      # freelist (libro entries live here)
#   ed25519_init(); # sigil signing constants
#
# Wire-up:
#   var chain = chain_new();
#   var la = libro_audit_new(chain);
#   var sink = audit_sink_new(&libro_audit_log, la);
#   dispatcher_set_audit(d, sink);
#
# IMPORTANT: libro's chain_append* takes `Str` (fat strings), not raw cstrs.
# This adapter wraps every cstr boundary value via str_from before calling
# into libro. Callers should pass plain cstrs in ToolCallEvent — the wrap
# happens here.
#
# Known issue (v1.2.1): when libro + majra + the full bote test/demo binary
# are linked together, the libro_audit_log path triggers a heap heisenbug
# (main re-entry / infinite loop). The adapter shape is correct (works in
# isolated probes); live integration in a multi-include binary needs cyrius
# investigation — tracked for v1.3.0.

# LibroAudit (24 bytes):
#   +0  chain     libro chain ptr
#   +8  source    cstr (default "bote")
#   +16 agent_id  cstr or 0 (default 0)

# The lock on libro's chains (3.7.1). libro locks nothing, and on a threaded server this
# sink appends to a chain from one worker while a libro tool (src/libro_tools.cyr) walks it
# from another, so both take this. One for every chain: they are few, and appends are short.
# Taken only once threads are running, and made the first time it is, by compare-and-swap.
var _bote_libro_mtx = 0;

fn _bote_libro_mutex() {
    var m = atomic_load(&_bote_libro_mtx);
    if (m != 0) { return m; }
    atomic_cas(&_bote_libro_mtx, 0, mutex_new());
    return atomic_load(&_bote_libro_mtx);
}

fn bote_libro_lock() {
    if (_threads_active != 0) { mutex_lock(_bote_libro_mutex()); }
    return 0;
}

fn bote_libro_unlock() {
    if (_threads_active != 0) { mutex_unlock(_bote_libro_mutex()); }
    return 0;
}

fn libro_audit_new(chain) {
    var la = alloc(24);
    store64(la, chain);
    store64(la + 8, "bote");
    store64(la + 16, 0);
    return la;
}

fn libro_audit_with_source(la, source)     { store64(la + 8, source);   return la; }
fn libro_audit_with_agent_id(la, agent_id) { store64(la + 16, agent_id); return la; }

fn libro_audit_chain(la)    { return load64(la); }
fn libro_audit_source(la)   { return load64(la + 8); }
fn libro_audit_agent_id(la) { return load64(la + 16); }

# AuditSink-compatible log function.
# ctx is a LibroAudit ptr.
#
# IMPORTANT: libro's chain_append* expects `Str` (fat strings) for source /
# action / details / agent, NOT raw cstrs. Bote stores tool names and
# similar as cstrs, so we wrap them via str_from at the boundary.
fn libro_audit_log(ctx, event) {
    bote_libro_lock();
    _libro_audit_log_held(ctx, event);
    bote_libro_unlock();
    return 0;
}

fn _libro_audit_log_held(ctx, event) {
    if (ctx == 0 || event == 0) { return 0; }
    var chain = libro_audit_chain(ctx);
    if (chain == 0) { return 0; }

    var success = tool_call_event_success(event);
    var severity = SEV_INFO;
    var action_cstr = "tool.completed";
    if (success == 0) { severity = SEV_ERROR; action_cstr = "tool.failed"; }

    var source_str  = str_from(libro_audit_source(ctx));
    var action_str  = str_from(action_cstr);
    var details_str = str_from(tool_call_event_to_json(event));

    # The configured identity only. caller_id is whatever the client put in
    # its params, so it stays in the details as a claim, not as who did this.
    var agent_cstr = libro_audit_agent_id(ctx);

    if (agent_cstr != 0) {
        chain_append_with_agent(chain, severity, source_str, action_str,
          details_str, str_from(agent_cstr));
    } else {
        chain_append(chain, severity, source_str, action_str, details_str);
    }
    return 0;
}

# --- events_majra.cyr ---

# bote::events::majra — MajraEvents adapter
# Mirrors rust-old/src/events.rs::majra_impl::MajraEvents.
#
# Wraps a majra PubSub instance with bote's EventSink contract.
# topic and payload are passed straight through to pubsub_publish.
#
# Wire-up:
#   var ps = pubsub_new();
#   var sink = event_sink_new(&majra_events_publish, ps);
#   dispatcher_set_events(d, sink);
#
# Subscribe to bote topics from your own code:
#   var rx = pubsub_subscribe(ps, "bote/tool/#");

# EventSink-compatible publish function.
# ctx is a majra PubSub ptr.
fn majra_events_publish(ctx, topic, payload) {
    if (ctx == 0) { return 0; }
    pubsub_publish(ctx, topic, payload);
    return 0;
}

# --- dispatch.cyr ---

# bote::dispatch — JSON-RPC tool dispatcher
# Mirrors rust-old/src/dispatch.rs (sync path; streaming/audit/events deferred)
#
# Requires (entry point includes):
#   string, fmt, alloc, vec, str, hashmap, fnptr,
#   src/error.cyr, src/protocol.cyr, src/registry.cyr, src/jsonx.cyr

# ================================================================
# Supported MCP protocol versions
# ================================================================
#
# ⚠ THE ONE LIST. `session.cyr`'s `validate_protocol_version` — which is
# what the HTTP-family transports run the `MCP-Protocol-Version` header
# through — delegates here rather than carrying its own copy. It used to
# carry one, and the two drifted: both listed the same three versions, so
# adding a fourth to either alone produced a server that negotiates a
# version over stdio and 400s the same version over HTTP. Adding a version
# is one line, here.
#
# `2025-06-18` retired JSON-RPC batching from the spec. bote still accepts
# batch arrays on every version — a superset is harmless to a client that
# never sends one — so the revision needs no behavioural branch.

fn _mcp_is_supported(v) {
    if (v == 0) { return 0; }
    if (streq(v, "2024-11-05") == 1) { return 1; }
    if (streq(v, "2025-03-26") == 1) { return 1; }
    if (streq(v, "2025-06-18") == 1) { return 1; }
    if (streq(v, "2025-11-25") == 1) { return 1; }
    return 0;
}

# The newest revision `initialize` negotiates. 2026-07-28 has no `initialize`, so
# it is not on this list: a client offering it there gets legacy semantics.
fn _mcp_latest_version() { return "2025-11-25"; }

# The stateless revision (3.5.0). A request says which revision it is, in its own
# `_meta`, and nothing carries over from the one before it.
fn _mcp_is_modern(v) {
    if (v == 0) { return 0; }
    if (streq(v, "2026-07-28") == 1) { return 1; }
    return 0;
}

# Every revision bote serves, newest first, as a JSON array.
fn _mcp_emit_versions(sb) {
    str_builder_add_cstr(sb, "[\"2026-07-28\",\"2025-11-25\",\"2025-06-18\",\"2025-03-26\",\"2024-11-05\"]");
    return 0;
}

fn _bote_server_version() { return "3.7.5"; }

# ================================================================
# Tool name validation (project_tool convention)
# ================================================================
#
# Returns 0 if valid, BoteError ptr otherwise.

fn _is_alnum_or_under(c) {
    if (c >= 48 && c <= 57) { return 1; }
    if (c >= 65 && c <= 90) { return 1; }
    if (c >= 97 && c <= 122) { return 1; }
    if (c == 95) { return 1; }
    return 0;
}

fn validate_tool_name(name) {
    if (name == 0) {
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, "", "tool name must be 1-256 characters");
    }
    var n = strlen(name);
    if (n == 0 || n > 256) {
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, "", "tool name must be 1-256 characters");
    }
    var i = 0;
    var has_under = 0;
    while (i < n) {
        var c = load8(name + i);
        if (_is_alnum_or_under(c) == 0) {
            return bote_err_new(BOTE_ERR_INVALID_PARAMS, name, "tool name must be alphanumeric + underscore");
        }
        if (c == 95) { has_under = 1; }
        i = i + 1;
    }
    if (has_under == 0) {
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, name,
          "tool name must contain at least one underscore (project_tool format)");
    }
    return 0;
}

# ================================================================
# Dispatcher struct (72 bytes):
#   +0  registry            ptr
#   +8  handlers            hashmap: name_cstr -> fn ptr (sync handler)
#   +16 streaming_handlers  hashmap: name_cstr -> fn ptr (reserved for v1.3)
#   +24 audit_sink          AuditSink ptr or 0 (no-op when 0)
#   +32 event_sink          EventSink ptr or 0 (no-op when 0)
#   +40 prompt_registry     PromptRegistry ptr or 0 (prompts capability off
#                           when 0; created lazily by dispatcher_register_prompt)
#   +48 resource_registry   ResourceRegistry ptr or 0 (resources capability off
#                           when 0; created lazily by dispatcher_register_resource)
#   +56 completion_handler  fn ptr or 0 (completions capability off when 0;
#                           set via dispatcher_set_completion)
#   +64 notifications        0/1 — 1 when the server has a working server→client
#                           notification path (a transport that drains
#                           list_changed to clients). Gates the `listChanged`
#                           sub-capabilities. Set by the transport wiring, NOT
#                           in core: only a transport with a drain path
#                           (streamable) may advertise listChanged; stdio/http/
#                           ws must not promise notifications they can't deliver.
# ================================================================

#   +72 server_name           cstr — the `serverInfo.name` this dispatcher
#                           advertises at initialize, or 0 for bote's own.
#   +80 server_version        cstr — the matching `serverInfo.version`, or 0.
#                           Set together via dispatcher_set_server_info.
#   +88 scope_check           fn ptr (claims, scope, ctx) → 1 when held, or 0.
#   +96 scope_ctx             passed to it. Set via dispatcher_set_scope_check.
#   +104 listen               what carries `subscriptions/listen` streams (3.7.2): a
#                           ListenHub (src/listen.cyr), opaque here, or 0, when the
#                           method is not served. Set by the transport wiring.
fn dispatcher_new(reg) {
    var d = alloc(112);
    store64(d, reg);
    store64(d + 8, map_new());
    store64(d + 16, map_new());
    store64(d + 24, 0);
    store64(d + 32, 0);
    store64(d + 40, 0);
    store64(d + 48, 0);
    store64(d + 56, 0);
    store64(d + 64, 0);
    store64(d + 72, 0);
    store64(d + 80, 0);
    store64(d + 88, 0);
    store64(d + 96, 0);
    store64(d + 104, 0);
    return d;
}

fn dispatcher_registry(d)   { return load64(d); }
fn dispatcher_handlers(d)   { return load64(d + 8); }
fn dispatcher_streaming(d)  { return load64(d + 16); }
fn dispatcher_audit_sink(d) { return load64(d + 24); }
fn dispatcher_event_sink(d) { return load64(d + 32); }
fn dispatcher_prompts(d)    { return load64(d + 40); }
fn dispatcher_resources(d)  { return load64(d + 48); }
fn dispatcher_completion(d) { return load64(d + 56); }
fn dispatcher_notifications(d) { return load64(d + 64); }

fn dispatcher_server_name(d)    { return load64(d + 72); }
fn dispatcher_server_version(d) { return load64(d + 80); }

# Set the `serverInfo` this dispatcher advertises at `initialize`.
#
# **A dispatcher embedded in another product must not introduce itself as
# "bote".** Before 3.3.0 `_build_initialize_result` hardcoded
# `"serverInfo":{"name":"bote"}`, so every consumer's MCP clients saw bote's
# identity and bote's version rather than the host application's — which is
# wrong for every downstream, and for a host whose own oracle emits its own name
# it is a wire divergence with no workaround short of hand-rolling the envelope.
#
# Both arguments are cstrs. Passing 0 for either keeps bote's own value for that
# field, so `dispatcher_set_server_info(d, "agnosai", 0)` renames the server and
# keeps bote's version. Unset (the default) is byte-identical to pre-3.3.0.
fn dispatcher_set_server_info(d, name, version) {
    store64(d + 72, name);
    store64(d + 80, version);
    return d;
}

# Who can say what a token grants. Claims are opaque to bote, so what reads them is
# supplied: jwt_scope_check for a JWT, and for anything else the validator's author.
# A broader scope that implies a narrower one is this function's to account for.
fn dispatcher_set_scope_check(d, fp, ctx) {
    store64(d + 88, fp);
    store64(d + 96, ctx);
    return d;
}

# What carries this dispatcher's `subscriptions/listen` streams (3.7.2), or 0 for none,
# when the method is not found. A transport that can hold a stream open sets it.
fn dispatcher_set_listen(d, hub) { store64(d + 104, hub); return d; }
fn dispatcher_listen(d) { return load64(d + 104); }

fn dispatcher_set_audit(d, sink) { store64(d + 24, sink); return d; }
fn dispatcher_set_events(d, sink) { store64(d + 32, sink); return d; }
fn dispatcher_set_prompts(d, preg) { store64(d + 40, preg); return d; }
fn dispatcher_set_resources(d, rreg) { store64(d + 48, rreg); return d; }

# Set the completion handler. ABI: fn h(params_cstr, claims) → result_cstr,
# where params is the completion/complete params ({ref, argument, ...}) and
# the result is the full {"completion":{"values":[...]}} body. Setting it
# flips the `completions` capability on at initialize.
fn dispatcher_set_completion(d, handler_fp) { store64(d + 56, handler_fp); return d; }

# Declare that this dispatcher's transport can deliver server→client
# notifications (a list_changed drain path). Flips the `listChanged`
# sub-capabilities on at initialize. Set by the transport wiring only.
fn dispatcher_set_notifications(d, on) { store64(d + 64, on); return d; }

# Register a sync tool handler. **2.0 ABI**: handler signature is
#   fn h(args_cstr, claims) → result_cstr (claims always 0 today)
# The handler maps are under the registries' lock (3.7.1, src/protocol.cyr), as the
# registries are: a threaded server reads them for every call.
fn dispatcher_handle(d, name, handler_fp) {
    bote_reg_write();
    map_set(dispatcher_handlers(d), name, handler_fp);
    bote_reg_write_end();
    return 0;
}

# Register a streaming tool handler (placeholder — dispatch_streaming not yet ported).
fn dispatcher_handle_streaming(d, name, handler_fp) {
    bote_reg_write();
    map_set(dispatcher_streaming(d), name, handler_fp);
    bote_reg_write_end();
    return 0;
}

fn dispatcher_is_streaming_tool(d, name) {
    bote_reg_read();
    var h = map_has(dispatcher_streaming(d), name);
    bote_reg_read_end();
    return h;
}

# The tool `name`, or 0, from one look at the registries (3.7.2), with what serves it: its
# handler through *fp_out, *has_out 1 when one is set (a handler may be registered as 0),
# and with a `ver`, *ver_out 1 when that version is registered. A call is judged by this
# and served by it, so a tool registered or replaced while the call runs cannot lend it a
# definition its scopes were not checked against.
fn _dsp_tool_serving(d, name, ver, ver_out, has_out, fp_out) {
    bote_reg_read();
    var t = _registry_get_u(dispatcher_registry(d), name);
    var has = map_has(dispatcher_handlers(d), name);
    var fp = 0;
    if (has == 1) { fp = map_get(dispatcher_handlers(d), name); }
    var vok = 1;
    if (ver != 0 && _registry_get_versioned_u(dispatcher_registry(d), name, ver) == 0) { vok = 0; }
    bote_reg_read_end();
    store64(ver_out, vok);
    store64(has_out, has);
    store64(fp_out, fp);
    return t;
}

# The handler registered for tool `name`, through *has_out 1 when there is one (a handler
# may be registered as 0), or 0.
fn _dsp_handler(d, name, has_out) {
    bote_reg_read();
    var fp = 0;
    var has = map_has(dispatcher_handlers(d), name);
    if (has == 1) { fp = map_get(dispatcher_handlers(d), name); }
    bote_reg_read_end();
    store64(has_out, has);
    return fp;
}

# Build {"tool_name":"<name>"} for a register/dereg/deprecate event payload.
fn _emit_tool_name_payload(name) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"tool_name\":\"");
    _json_emit_escaped(sb, name);
    str_builder_add_cstr(sb, "\"}");
    return str_data(str_builder_build(sb));
}

# Dynamic registration: validates the tool name, registers in registry,
# inserts handler. Returns 0 on success, BoteError ptr on failure.
# Emits TOPIC_TOOL_REGISTERED on success.
fn dispatcher_register_tool(d, tool_def, handler_fp) {
    if (tool_def == 0) { return bote_err_new(BOTE_ERR_INVALID_PARAMS, "", "tool definition is null"); }
    var name = tool_def_name(tool_def);
    var verr = validate_tool_name(name);
    if (verr != 0) { return verr; }
    var rerr = _registry_prepare(tool_def);
    if (rerr != 0) { return rerr; }
    # The tool and its handler in one write (3.7.1), so a call on another worker never
    # finds the one without the other; the event after, with nothing held.
    bote_reg_write();
    map_set(dispatcher_handlers(d), name, handler_fp);
    _registry_add_u(dispatcher_registry(d), tool_def);
    bote_reg_write_end();
    event_sink_publish(dispatcher_event_sink(d), TOPIC_TOOL_REGISTERED(),
      _emit_tool_name_payload(name));
    return 0;
}

# Returns 0 on success, BoteError ptr on failure (tool not found).
# Emits TOPIC_TOOL_DEREGISTERED on success.
fn dispatcher_deregister_tool(d, name) {
    bote_reg_write();
    var removed = _registry_deregister_u(dispatcher_registry(d), name);
    map_delete(dispatcher_handlers(d), name);
    map_delete(dispatcher_streaming(d), name);
    bote_reg_write_end();
    if (removed == 0) {
        return bote_err_new(BOTE_ERR_TOOL_NOT_FOUND, name, 0);
    }
    event_sink_publish(dispatcher_event_sink(d), TOPIC_TOOL_DEREGISTERED(),
      _emit_tool_name_payload(name));
    return 0;
}

# Why a prompt, resource or template with a required scope that is no RFC 6749
# scope-token is not registered: the scope would go out in a 403's header (3.6.6).
var DSP_SCOPE_NOT_TOKEN = "a required scope must be a non-empty token with no space, quote or backslash";

# The registry at `d + off`, the one `fresh` becomes when there is none yet (3.7.2). Two
# threads registering the first prompt or resource at once each made one, and the first
# stored was lost with what was registered in it. The swap publishes `fresh` after its
# maps, so a reader that sees it sees them; a loser's `fresh` is left unused.
fn _dsp_made(d, off, fresh) {
    if (atomic_cas(d + off, 0, fresh) == 1) { return fresh; }
    return atomic_load(d + off);
}

# Register an MCP prompt + its generator handler. Lazily stands up the
# dispatcher's PromptRegistry on first call — which is also what flips the
# `prompts` capability on at initialize (see _build_capabilities). Prompt
# names are freeform (no project_tool underscore convention). Returns 0, or a
# BoteError with nothing registered.
fn dispatcher_register_prompt(d, prompt_def, handler_fp) {
    if (prompt_def == 0 || prompt_def_name(prompt_def) == 0) {
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, "", "prompt definition has no name");
    }
    if (bote_scope_list_ok(prompt_def_required_scopes(prompt_def)) == 0) {
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, prompt_def_name(prompt_def), DSP_SCOPE_NOT_TOKEN);
    }
    var preg = dispatcher_prompts(d);
    if (preg == 0) { preg = _dsp_made(d, 40, prompt_registry_new()); }
    prompt_registry_register(preg, prompt_def, handler_fp);
    # Emit a prompt-set-changed event so a client-notification sink can push
    # notifications/prompts/list_changed (no-op when no sink is wired, e.g.
    # the startup registrations before the transport sets its sink).
    var pb = str_builder_new();
    str_builder_add_cstr(pb, "{\"prompt_name\":\"");
    _json_emit_escaped(pb, prompt_def_name(prompt_def));
    str_builder_add_cstr(pb, "\"}");
    event_sink_publish(dispatcher_event_sink(d), TOPIC_PROMPT_REGISTERED(),
      str_data(str_builder_build(pb)));
    return 0;
}

# Register an MCP resource + its read handler. Lazily stands up the
# dispatcher's ResourceRegistry on first call — which is also what flips the
# `resources` capability on at initialize (see _build_capabilities).
# Returns 0, or a BoteError with nothing registered.
fn dispatcher_register_resource(d, resource_def, handler_fp) {
    if (resource_def == 0 || resource_def_uri(resource_def) == 0) {
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, "", "resource definition has no uri");
    }
    if (bote_scope_list_ok(resource_def_required_scopes(resource_def)) == 0) {
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, resource_def_uri(resource_def), DSP_SCOPE_NOT_TOKEN);
    }
    var rreg = dispatcher_resources(d);
    if (rreg == 0) { rreg = _dsp_made(d, 48, resource_registry_new()); }
    resource_registry_register(rreg, resource_def, handler_fp);
    _dsp_resource_changed(d);
    return 0;
}

# A resource or a template registered (3.7.2): `notifications/resources/list_changed`
# for whoever listens for it.
fn _dsp_resource_changed(d) {
    event_sink_publish(dispatcher_event_sink(d), TOPIC_RESOURCE_REGISTERED(), "{}");
    return 0;
}

# Register a resource template + its read handler. Stands up the registry the way
# dispatcher_register_resource does. Returns 0, or a BoteError saying why not, with
# nothing registered.
fn dispatcher_register_resource_template(d, template, handler_fp) {
    if (template == 0 || resource_template_name(template) == 0) {
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, "", "a resource template needs a name");
    }
    var why = resource_template_check(resource_template_uri(template));
    if (why != 0) { return bote_err_new(BOTE_ERR_INVALID_PARAMS, resource_template_name(template), why); }
    if (bote_scope_list_ok(resource_template_required_scopes(template)) == 0) {
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, resource_template_name(template), DSP_SCOPE_NOT_TOKEN);
    }
    var rreg = dispatcher_resources(d);
    if (rreg == 0) { rreg = _dsp_made(d, 48, resource_registry_new()); }
    resource_registry_register_template(rreg, template, handler_fp);
    _dsp_resource_changed(d);
    return 0;
}

# ================================================================
# JSON helpers — escape, build literals
# ================================================================

# `_json_emit_escaped`, the escaper every module calls, lives in jsonx.cyr
# since 3.4.6 as `bote_json_escape`, with the old name kept as an alias.

# Append "key":"value" (value JSON-escaped). Caller responsible for commas.
fn _json_emit_str_field(sb, key, value) {
    str_builder_add_cstr(sb, "\"");
    str_builder_add_cstr(sb, key);
    str_builder_add_cstr(sb, "\":\"");
    _json_emit_escaped(sb, value);
    str_builder_add_cstr(sb, "\"");
    return 0;
}

# Append "key":raw  where raw is already JSON-formatted.
fn _json_emit_raw_field(sb, key, raw) {
    str_builder_add_cstr(sb, "\"");
    str_builder_add_cstr(sb, key);
    str_builder_add_cstr(sb, "\":");
    str_builder_add_cstr(sb, raw);
    return 0;
}

# Build a JSON object representation of a ToolSchema.
fn _emit_schema(sb, schema) {
    str_builder_add_cstr(sb, "{\"type\":\"");
    var t = schema_type(schema);
    if (t != 0) { _json_emit_escaped(sb, t); }
    str_builder_add_cstr(sb, "\"");

    var props = schema_properties(schema);
    if (props != 0 && vec_len(props) > 0) {
        str_builder_add_cstr(sb, ",\"properties\":{");
        var n = vec_len(props);
        var i = 0;
        while (i < n) {
            if (i > 0) { str_builder_add_cstr(sb, ","); }
            var p = vec_get(props, i);
            str_builder_add_cstr(sb, "\"");
            _json_emit_escaped(sb, schema_prop_key(p));
            str_builder_add_cstr(sb, "\":");
            str_builder_add_cstr(sb, schema_prop_value(p));
            i = i + 1;
        }
        str_builder_add_cstr(sb, "}");
    }

    var req = schema_required(schema);
    if (req != 0 && vec_len(req) > 0) {
        str_builder_add_cstr(sb, ",\"required\":[");
        var nr = vec_len(req);
        var ri = 0;
        while (ri < nr) {
            if (ri > 0) { str_builder_add_cstr(sb, ","); }
            str_builder_add_cstr(sb, "\"");
            _json_emit_escaped(sb, vec_get(req, ri));
            str_builder_add_cstr(sb, "\"");
            ri = ri + 1;
        }
        str_builder_add_cstr(sb, "]");
    }
    str_builder_add_cstr(sb, "}");
    return 0;
}

# Append a single tri-state annotation hint as "key":true/false.
# `first` is 1 when no hint has been emitted yet (suppresses the leading
# comma); returns the updated `first` flag. HINT_UNSET emits nothing.
fn _emit_hint_field(sb, first, key, hint) {
    if (hint == HINT_UNSET) { return first; }
    if (first == 0) { str_builder_add_cstr(sb, ","); }
    str_builder_add_cstr(sb, "\"");
    str_builder_add_cstr(sb, key);
    if (hint == HINT_TRUE) { str_builder_add_cstr(sb, "\":true"); }
    else { str_builder_add_cstr(sb, "\":false"); }
    return 0;
}

# Append ,"annotations":{...} for a ToolDef's ToolAnnotations ptr.
# Emits nothing when `ann` is 0 or every hint is unset (so the leading
# comma is only produced when at least one hint is serialized). MCP
# 2025-11-25 ToolAnnotations: readOnlyHint/destructiveHint/idempotentHint/
# openWorldHint, each an optional boolean (skip when unset).
fn _emit_annotations(sb, ann) {
    if (ann == 0) { return 0; }
    var r = ann_read_only_hint(ann);
    var dd = ann_destructive_hint(ann);
    var idem = ann_idempotent_hint(ann);
    var ow = ann_open_world_hint(ann);
    if (r == HINT_UNSET && dd == HINT_UNSET && idem == HINT_UNSET && ow == HINT_UNSET) {
        return 0;
    }
    str_builder_add_cstr(sb, ",\"annotations\":{");
    var first = 1;
    first = _emit_hint_field(sb, first, "readOnlyHint", r);
    first = _emit_hint_field(sb, first, "destructiveHint", dd);
    first = _emit_hint_field(sb, first, "idempotentHint", idem);
    first = _emit_hint_field(sb, first, "openWorldHint", ow);
    str_builder_add_cstr(sb, "}");
    return 0;
}

# ================================================================
# Method handlers
# ================================================================

# Append the MCP `capabilities` object advertised at initialize.
#
# Advertised keys are DERIVED from what bote actually implements, so we
# never advertise a capability we can't honor:
#   - `tools`: always — bote is a tool server (an empty registry is still
#     tool-capable).
#   - `prompts`: advertised iff the dispatcher has a PromptRegistry (i.e. at
#     least one prompt was registered — see dispatcher_register_prompt).
#   - `resources`: advertised iff the dispatcher has a ResourceRegistry (see
#     dispatcher_register_resource). `subscribe`/`listChanged` omitted — no
#     resource-mutation producer feeds them yet.
#   - `completions`: advertised iff a completion handler is set (see
#     dispatcher_set_completion).
#   - `listChanged` (tools + prompts): advertised ONLY when
#     dispatcher_notifications(d) == 1 — i.e. the transport wired a
#     server→client drain path (streamable's per-session buffers). The
#     register/dereg + prompt-register events already fire; the flag confirms
#     they actually reach a client. Kept OUT of core so stdio/http/ws (no
#     drain path) never promise notifications they can't deliver.
#   - logging: NOT YET — it exists only to gate `notifications/message`;
#     advertising it would promise log messages bote can't send.
#
# Version policy: every capability below exists across all supported
# protocol versions (2024-11-05 … 2025-11-25), so none is gated on the
# negotiated version. A version-exclusive capability would branch on the
# negotiated version passed in here.
fn _build_capabilities(sb, d) {
    return _build_capabilities_lc(sb, d, dispatcher_notifications(d));
}

# `lc` is whether listChanged may be promised, which needs a way to deliver it.
fn _build_capabilities_lc(sb, d, lc) { return _build_capabilities_sub(sb, d, lc, 0); }

# _build_capabilities_lc, and `resources.subscribe` when `sub` is 1 (3.7.4): only where a
# listen carries `resourceSubscriptions`. The legacy `initialize` never says it, having no
# `resources/subscribe`.
fn _build_capabilities_sub(sb, d, lc, sub) {
    str_builder_add_cstr(sb, "{\"tools\":{");
    if (lc == 1) { str_builder_add_cstr(sb, "\"listChanged\":true"); }
    str_builder_add_cstr(sb, "}");
    if (dispatcher_prompts(d) != 0) {
        str_builder_add_cstr(sb, ",\"prompts\":{");
        if (lc == 1) { str_builder_add_cstr(sb, "\"listChanged\":true"); }
        str_builder_add_cstr(sb, "}");
    }
    if (dispatcher_resources(d) != 0) {
        str_builder_add_cstr(sb, ",\"resources\":{");
        if (lc == 1) { str_builder_add_cstr(sb, "\"listChanged\":true"); }
        if (sub == 1) {
            if (lc == 1) { str_builder_add_cstr(sb, ","); }
            str_builder_add_cstr(sb, "\"subscribe\":true");
        }
        str_builder_add_cstr(sb, "}");
    }
    if (dispatcher_completion(d) != 0) {
        str_builder_add_cstr(sb, ",\"completions\":{}");
    }
    str_builder_add_cstr(sb, "}");
    return 0;
}

# Build the initialize response result body.
# {"name":...,"version":...}. Escaped since 3.4.6: both come from the embedder
# through dispatcher_set_server_info, and a quote in either broke the reply.
fn _dsp_emit_server_info(sb, d) {
    var sname = dispatcher_server_name(d);
    if (sname == 0) { sname = "bote"; }
    var sver = dispatcher_server_version(d);
    if (sver == 0) { sver = _bote_server_version(); }
    str_builder_add_cstr(sb, "{\"name\":\"");
    _json_emit_escaped(sb, sname);
    str_builder_add_cstr(sb, "\",\"version\":\"");
    _json_emit_escaped(sb, sver);
    str_builder_add_cstr(sb, "\"}");
    return 0;
}

fn _build_initialize_result_a(a, d, params_cstr) {
    var requested = jsonx_get_str_a(a, params_cstr, "protocolVersion");
    var negotiated = _mcp_latest_version();
    if (_mcp_is_supported(requested) == 1) { negotiated = requested; }

    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 512);
    str_builder_add_cstr(sb, "{\"protocolVersion\":\"");
    str_builder_add_cstr(sb, negotiated);
    str_builder_add_cstr(sb, "\",\"capabilities\":");
    _build_capabilities(sb, d);
    str_builder_add_cstr(sb, ",\"serverInfo\":");
    _dsp_emit_server_info(sb, d);
    str_builder_add_cstr(sb, "}");
    return str_data(str_builder_build_a(a, sb));
}

# Build the prompts/list response result body.
fn _build_prompts_list_result(a, preg) {
    bote_reg_read();
    var names = prompt_registry_names(preg);
    var n = vec_len(names);
    var room = 32;
    var i = 0;
    while (i < n) {
        var c = _prompt_registry_get_u(preg, vec_get(names, i));
        room = room + 64 + _dsp_room(prompt_def_name(c)) + _dsp_room(prompt_def_description(c));
        var cargs = prompt_def_arguments(c);
        if (cargs != 0) {
            var ci = 0;
            while (ci < vec_len(cargs)) {
                var carg = vec_get(cargs, ci);
                room = room + 64 + _dsp_room(prompt_arg_name(carg)) + _dsp_room(prompt_arg_description(carg));
                ci = ci + 1;
            }
        }
        i = i + 1;
    }
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, room);
    str_builder_add_cstr(sb, "{\"prompts\":[");
    i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        var p = _prompt_registry_get_u(preg, vec_get(names, i));
        str_builder_add_cstr(sb, "{");
        _json_emit_str_field(sb, "name", prompt_def_name(p));
        var pd = prompt_def_description(p);
        if (pd != 0) {
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "description", pd);
        }
        var pargs = prompt_def_arguments(p);
        if (pargs != 0 && vec_len(pargs) > 0) {
            str_builder_add_cstr(sb, ",\"arguments\":[");
            var na = vec_len(pargs);
            var ai = 0;
            while (ai < na) {
                if (ai > 0) { str_builder_add_cstr(sb, ","); }
                var parg = vec_get(pargs, ai);
                str_builder_add_cstr(sb, "{");
                _json_emit_str_field(sb, "name", prompt_arg_name(parg));
                var ad = prompt_arg_description(parg);
                if (ad != 0) {
                    str_builder_add_cstr(sb, ",");
                    _json_emit_str_field(sb, "description", ad);
                }
                if (prompt_arg_required(parg) == 1) {
                    str_builder_add_cstr(sb, ",\"required\":true");
                }
                str_builder_add_cstr(sb, "}");
                ai = ai + 1;
            }
            str_builder_add_cstr(sb, "]");
        }
        str_builder_add_cstr(sb, "}");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    bote_reg_read_end();
    return str_data(str_builder_build_a(a, sb));
}

# Does tool `t` belong in a `profile`-filtered listing? A null profile means
# no filter was requested, so every tool matches (full listing, unchanged).
fn _tool_matches_profile(t, profile) {
    if (profile == 0) { return 1; }
    return tool_def_has_profile(t, profile);
}

# Build the tools/list response result body.
#
# `profile` (cstr or 0) is an OPTIONAL bote extension: when a client passes
# {"profile":"<tag>"} in tools/list params, only tools tagged with that
# profile are returned (exact-match). When absent (0), the full tool list is
# returned — byte-identical to pre-extension behavior.
# Room for one tool's entry in tools/list. The helpers that write it grow a
# builder on the heap, so this sizes the arena builder up front. A short
# estimate costs one growth on the heap, nothing worse.
fn _dsp_room(cstr) {
    if (cstr == 0) { return 0; }
    return 6 * strlen(cstr);
}

fn _dsp_tool_list_room(t) {
    var n = 256 + _dsp_room(tool_def_name(t)) + _dsp_room(tool_def_description(t));
    n = n + _dsp_room(tool_def_version(t)) + _dsp_room(tool_def_deprecated(t));
    var props = schema_properties(tool_def_input_schema(t));
    if (props != 0) {
        var i = 0;
        while (i < vec_len(props)) {
            var pair = vec_get(props, i);
            n = n + 8 + _dsp_room(schema_prop_key(pair)) + _dsp_room(schema_prop_value(pair));
            i = i + 1;
        }
    }
    var req = schema_required(tool_def_input_schema(t));
    if (req != 0) {
        var j = 0;
        while (j < vec_len(req)) { n = n + 8 + _dsp_room(vec_get(req, j)); j = j + 1; }
    }
    return n;
}

fn _build_tools_list_result_a(a, reg, profile) {
    bote_reg_read();
    var sb = str_builder_new_a(a);
    var room = 64;
    var rnames = registry_names(reg);
    var ri = 0;
    while (ri < vec_len(rnames)) {
        room = room + _dsp_tool_list_room(_registry_get_u(reg, vec_get(rnames, ri)));
        ri = ri + 1;
    }
    _sb_grow_a(a, sb, room);
    str_builder_add_cstr(sb, "{\"tools\":[");
    var n = vec_len(rnames);
    var i = 0;
    var emitted = 0;
    while (i < n) {
        var t = _registry_get_u(reg, vec_get(rnames, i));
        if (_tool_matches_profile(t, profile) == 0) {
            i = i + 1;
            continue;
        }
        if (emitted > 0) { str_builder_add_cstr(sb, ","); }
        emitted = emitted + 1;
        str_builder_add_cstr(sb, "{");
        _json_emit_str_field(sb, "name", tool_def_name(t));
        str_builder_add_cstr(sb, ",");
        _json_emit_str_field(sb, "description", tool_def_description(t));
        str_builder_add_cstr(sb, ",\"inputSchema\":");
        _emit_schema(sb, tool_def_input_schema(t));
        var v = tool_def_version(t);
        if (v != 0) {
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "version", v);
        }
        var dep = tool_def_deprecated(t);
        if (dep != 0) {
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "deprecated", dep);
        }
        _emit_annotations(sb, tool_def_annotations(t));
        str_builder_add_cstr(sb, "}");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    bote_reg_read_end();
    return str_data(str_builder_build_a(a, sb));
}

# Extract and validate the tool name from a tools/call request's params.
# Returns cstr (name) or 0; sets *err_out (BoteError ptr) on failure.
fn _extract_tool_name(params_cstr, err_out) {
    var name = jsonx_get_str(params_cstr, "name");
    if (name == 0 || strlen(name) == 0) {
        store64(err_out, bote_err_new(BOTE_ERR_INVALID_PARAMS, "", "missing or empty 'name' field"));
        return 0;
    }
    store64(err_out, 0);
    return name;
}

# 1 when `sink` (an AuditSink or EventSink: +0 callback, +8 ctx) is installed
# with a callback, i.e. when audit_sink_log / event_sink_publish would call
# something. Both return early otherwise, so building what they would be
# handed is wasted work (3.4.1).
fn _dsp_sink_live(sink) {
    if (sink == 0) { return 0; }
    if (load64(sink) == 0) { return 0; }
    return 1;
}

# 1 when an event sink wants tool-call events: live, and not one that takes only
# tool-set changes (event_sink_set_list_only).
fn _dsp_sink_wants_calls(sink) {
    if (_dsp_sink_live(sink) == 0) { return 0; }
    if (load64(sink + 16) == 1) { return 0; }
    return 1;
}

# MCP's code for resources/read on a URI nothing serves (resources spec,
# "Error Handling"). It sits in JSON-RPC's server-defined range.
var BOTE_RPC_RESOURCE_NOT_FOUND = 0 - 32002;

# A failed tool call's result: {"content":[{"type":"text","text":"..."}],
# "isError":true}. Kept here rather than in content.cyr so the dispatcher
# needs no module it did not need before; content_text_error_response is
# the public name for it.
# A refused call is a call: the audit trail and the failed-call topic see it as
# they see one that failed in its handler. Copied to the heap, since a sink may
# keep what it is handed.
fn _dsp_record_refusal(d, name, params, plen, caller_pos, msg) {
    var audit_on = _dsp_sink_live(dispatcher_audit_sink(d));
    var events_on = _dsp_sink_wants_calls(dispatcher_event_sink(d));
    if (audit_on == 0 && events_on == 0) { return 0; }
    var h = default_alloc();
    var ev = tool_call_event_new(_slice_cstr(h, name, 0, strlen(name)), 0, 0,
      _slice_cstr(h, msg, 0, strlen(msg)), _jx_str_at_a(h, params, plen, caller_pos));
    if (audit_on == 1) { audit_sink_log(dispatcher_audit_sink(d), ev); }
    if (events_on == 1) {
        event_sink_publish(dispatcher_event_sink(d), TOPIC_TOOL_FAILED(), tool_call_event_to_json(ev));
    }
    return 0;
}

# `s` on one line. stdio and the Unix transport frame a message by its newline,
# and in valid JSON a raw LF or CR can only be whitespace between tokens, so a
# handler that pretty-prints cannot be allowed to split a response.
fn _dsp_one_line(a, s) {
    var n = strlen(s);
    var i = 0;
    while (i < n) {
        var c = load8(s + i);
        if (c == 10 || c == 13) { break; }
        i = i + 1;
    }
    if (i == n) { return s; }
    var out = alloc_via(a, n + 1);
    var o = 0;
    i = 0;
    while (i < n) {
        var ch = load8(s + i);
        if (ch != 10 && ch != 13) { store8(out + o, ch); o = o + 1; }
        i = i + 1;
    }
    store8(out + o, 0);
    return out;
}

# A prompt, resource or completion handler's result goes into the response as it
# stands, so it has to be JSON, on one line. Only tools/call checked this.
fn _dsp_checked_result(a, id, result) {
    if (jsonx_valid(result, strlen(result)) == 0) {
        return resp_error_a(a, id, 0 - 32603, "internal error: the handler returned invalid JSON");
    }
    return resp_success_a(a, id, _dsp_one_line(a, result));
}

fn _dsp_tool_error_result(text) { return _dsp_tool_error_result_a(default_alloc(), text); }

fn _dsp_tool_error_result_a(a, text) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, strlen(text) * 6 + 64);
    str_builder_add_cstr(sb, "{\"content\":[{\"type\":\"text\",\"text\":\"");
    if (text != 0) { _json_emit_escaped(sb, text); }
    str_builder_add_cstr(sb, "\"}],\"isError\":true}");
    return str_data(str_builder_build_a(a, sb));
}

# A successful tool call's result carrying `text` as one text block (3.4.8).
fn _dsp_tool_text_result(text) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"content\":[{\"type\":\"text\",\"text\":\"");
    if (text != 0) { _json_emit_escaped(sb, text); }
    str_builder_add_cstr(sb, "\"}]}");
    return str_data(str_builder_build(sb));
}

# 1 when the n bytes at p equal cstr lit.
fn _dsp_bytes_eq(p, n, lit) {
    if (n != strlen(lit)) { return 0; }
    return memeq(p, lit, n);
}

# 1 when the n bytes at p name an MCP content block type (tools spec, "Tool
# Result").
fn _dsp_is_content_type(p, n) {
    if (_dsp_bytes_eq(p, n, "text") == 1 || _dsp_bytes_eq(p, n, "image") == 1) { return 1; }
    if (_dsp_bytes_eq(p, n, "audio") == 1 || _dsp_bytes_eq(p, n, "resource") == 1) { return 1; }
    if (_dsp_bytes_eq(p, n, "resource_link") == 1) { return 1; }
    return 0;
}

# What a handler's result (valid JSON) is, from one pass over its top-level
# members, with nothing allocated: bit 1 when `content` is an array, bit 2
# when `isError` is true, bit 4 when `type` is an MCP content type. 0 for a
# result that is not an object.
var DSP_SHAPE_CONTENT = 1;
var DSP_SHAPE_ISERROR = 2;
var DSP_SHAPE_BLOCK = 4;
fn _dsp_result_shape(buf) {
    var len = strlen(buf);
    var i = _jx_skip_ws(buf, len, 0);
    if (i >= len || load8(buf + i) != 123) { return 0; }
    var flags = 0;
    i = _jx_skip_ws(buf, len, i + 1);
    while (i < len && load8(buf + i) == 34) {
        var ks = i + 1;
        var ke = _jx_skip_string(buf, len, i);
        var klen = ke - ks - 1;
        i = _jx_skip_ws(buf, len, ke);
        if (i >= len || load8(buf + i) != 58) { return flags; }
        var vs = _jx_skip_ws(buf, len, i + 1);
        var ve = _jx_skip_value(buf, len, vs);
        if (vs < len) {
            var vc = load8(buf + vs);
            if (vc == 91 && _dsp_bytes_eq(buf + ks, klen, "content") == 1) {
                flags = flags | DSP_SHAPE_CONTENT;
            } elif (vc == 116 && _dsp_bytes_eq(buf + ks, klen, "isError") == 1 && _dsp_bytes_eq(buf + vs, ve - vs, "true") == 1) {
                flags = flags | DSP_SHAPE_ISERROR;
            } elif (vc == 34 && _dsp_bytes_eq(buf + ks, klen, "type") == 1 && _dsp_is_content_type(buf + vs + 1, ve - vs - 2) == 1) {
                flags = flags | DSP_SHAPE_BLOCK;
            }
        }
        i = _jx_skip_ws(buf, len, ve);
        if (i < len && load8(buf + i) == 44) { i = _jx_skip_ws(buf, len, i + 1); }
    }
    return flags;
}

# The CallToolResult the client gets for what tool `name`'s handler
# returned, and through *fail_out the failure message for the audit and the
# event (0 when the call succeeded). 3.4.8; through 3.4.7 a handler's return
# went out verbatim.
#   - nothing (0): a failed call, as since 3.4.5;
#   - not valid JSON: a failed call. The bytes are not sent, because they
#     would break the reply;
#   - an object whose `content` is an array: a CallToolResult already, sent
#     as it is. `"isError": true` in it makes the call a failure for the audit;
#   - one content block (an object whose `type` is an MCP content type):
#     lifted into a one-element `content` array;
#   - anything else (a bare record, an array, a number, a string): sent as a
#     text block holding the JSON text, so the model still sees the data.
# A domain object that happens to carry a `type` member ({"type":"person"})
# is not mistaken for a block: only the five content types lift.
fn _dsp_coerce_result(name, result, fail_out) {
    store64(fail_out, 0);
    if (result == 0) {
        var m0 = str_data(bote_err_format(bote_err_new(BOTE_ERR_EXEC_FAILED, name, "the handler returned no result")));
        store64(fail_out, m0);
        return _dsp_tool_error_result(m0);
    }
    if (jsonx_valid(result, strlen(result)) == 0) {
        var m1 = str_data(bote_err_format(bote_err_new(BOTE_ERR_EXEC_FAILED, name, "the handler returned a result that is not valid JSON")));
        store64(fail_out, m1);
        return _dsp_tool_error_result(m1);
    }
    result = _dsp_one_line(default_alloc(), result);
    var shape = _dsp_result_shape(result);
    if ((shape & DSP_SHAPE_CONTENT) != 0) {
        if ((shape & DSP_SHAPE_ISERROR) != 0) {
            store64(fail_out, "the tool reported an error (isError)");
        }
        return result;
    }
    if ((shape & DSP_SHAPE_BLOCK) != 0) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "{\"content\":[");
        str_builder_add_cstr(sb, result);
        str_builder_add_cstr(sb, "]}");
        return str_data(str_builder_build(sb));
    }
    return _dsp_tool_text_result(result);
}

# 1 when a list request's params carry a non-null `cursor`. bote returns
# every item in one page and never issues a cursor, so any cursor a client
# sends is one it was never given. The pagination spec says an invalid
# cursor SHOULD be -32602 (3.4.5). Through 3.4.4 it was ignored and the
# first page went out again, which a client joining pages would take as
# duplicates. A null cursor is read as absent, like a null params.
fn _dsp_cursor_given(params) {
    if (params == 0) { return 0; }
    var c = jsonx_get_raw_a(bote_req_alloc(), params, "cursor");
    if (c == 0) { return 0; }
    if (load8(c) == 110) { return 0; }
    return 1;
}

fn _dsp_cursor_refusal_a(a, id) {
    return resp_error_a(a, id, 0 - 32602, "invalid cursor: this server returns every item in one page and issues no cursors");
}

# prefix + name + suffix as one message cstr; suffix may be 0.
fn _dsp_named_msg(prefix, name, suffix) { return _dsp_named_msg_a(default_alloc(), prefix, name, suffix); }

fn _dsp_named_msg_a(a, prefix, name, suffix) {
    var sb = str_builder_new_a(a);
    str_builder_add_cstr_a(a, sb, prefix);
    if (name != 0) { str_builder_add_cstr_a(a, sb, name); }
    if (suffix != 0) { str_builder_add_cstr_a(a, sb, suffix); }
    return str_data(str_builder_build_a(a, sb));
}

# The first argument `pdef` declares required that `args_obj` (a JSON
# object) lacks, or 0 when none is missing.
fn _prompt_missing_required(pdef, args_obj) {
    if (pdef == 0) { return 0; }
    var pa = prompt_def_arguments(pdef);
    if (pa == 0) { return 0; }
    var n = vec_len(pa);
    var i = 0;
    while (i < n) {
        var a = vec_get(pa, i);
        if (prompt_arg_required(a) == 1 && jsonx_has(args_obj, prompt_arg_name(a)) == 0) {
            return prompt_arg_name(a);
        }
        i = i + 1;
    }
    return 0;
}

# Build the resources/list response result body.
fn _build_resources_list_result(a, rreg) {
    bote_reg_read();
    var uris = resource_registry_uris(rreg);
    var n = vec_len(uris);
    var room = 32;
    var i = 0;
    while (i < n) {
        var c = _resource_registry_get_u(rreg, vec_get(uris, i));
        room = room + 64 + _dsp_room(resource_def_uri(c)) + _dsp_room(resource_def_name(c));
        room = room + _dsp_room(resource_def_description(c)) + _dsp_room(resource_def_mime_type(c));
        i = i + 1;
    }
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, room);
    str_builder_add_cstr(sb, "{\"resources\":[");
    i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        var r = _resource_registry_get_u(rreg, vec_get(uris, i));
        str_builder_add_cstr(sb, "{");
        _json_emit_str_field(sb, "uri", resource_def_uri(r));
        str_builder_add_cstr(sb, ",");
        _json_emit_str_field(sb, "name", resource_def_name(r));
        var rd = resource_def_description(r);
        if (rd != 0) {
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "description", rd);
        }
        var rm = resource_def_mime_type(r);
        if (rm != 0) {
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "mimeType", rm);
        }
        str_builder_add_cstr(sb, "}");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    bote_reg_read_end();
    return str_data(str_builder_build_a(a, sb));
}

# Build the resources/templates/list response result body.
fn _build_resource_templates_result(a, rreg) {
    bote_reg_read();
    var ts = resource_registry_templates(rreg);
    var n = vec_len(ts);
    var room = 32;
    var i = 0;
    while (i < n) {
        var c = vec_get(ts, i);
        room = room + 64 + _dsp_room(resource_template_uri(c)) + _dsp_room(resource_template_name(c));
        room = room + _dsp_room(resource_template_description(c)) + _dsp_room(resource_template_mime_type(c));
        i = i + 1;
    }
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, room);
    str_builder_add_cstr(sb, "{\"resourceTemplates\":[");
    i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        var t = vec_get(ts, i);
        str_builder_add_cstr(sb, "{");
        _json_emit_str_field(sb, "uriTemplate", resource_template_uri(t));
        str_builder_add_cstr(sb, ",");
        _json_emit_str_field(sb, "name", resource_template_name(t));
        var td = resource_template_description(t);
        if (td != 0) {
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "description", td);
        }
        var tm = resource_template_mime_type(t);
        if (tm != 0) {
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "mimeType", tm);
        }
        str_builder_add_cstr(sb, "}");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    bote_reg_read_end();
    return str_data(str_builder_build_a(a, sb));
}

# ================================================================
# dispatch — main entry
# ================================================================
#
# Returns a JsonRpcResponse ptr, or 0 if the request is a notification.

fn dispatcher_dispatch(d, request, claims) {
    return dispatcher_dispatch_a(default_alloc(), d, request, claims);
}

# ================================================================
# MCP 2026-07-28 (3.5.0)
#
# bote serves this revision and the older ones from one process. Each request
# says which it is: `_meta` naming this revision is served statelessly, and
# anything else as it always was. A dual-era client probes with server/discover
# and falls back to `initialize` on any error it does not recognise, so a legacy
# client never sees this path.
#
# The methods are the same code on both paths. A modern result differs by what
# surrounds it: resultType on all of them, `ttlMs` and `cacheScope` on the list
# results and resources/read, and serverInfo in `_meta`.
#
# ttlMs is 0, which tells a client to re-fetch: a promise that a list stays fresh
# needs a way to say it changed, and that is subscriptions/listen (roadmap 3.7.x).
# For the same reason, this path advertises no listChanged. cacheScope is
# "private" because a tool list may differ per authorization context.
# ================================================================

var DSP_META_VERSION = "io.modelcontextprotocol/protocolVersion";
var DSP_META_CAPABILITIES = "io.modelcontextprotocol/clientCapabilities";

fn _dsp_emit_modern_meta(sb, d) {
    str_builder_add_cstr(sb, "\"_meta\":{\"io.modelcontextprotocol/serverInfo\":");
    _dsp_emit_server_info(sb, d);
    str_builder_add_cstr(sb, "}");
    return 0;
}

fn _build_discover_result_a(a, d) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 512);
    str_builder_add_cstr(sb, "{\"resultType\":\"complete\",\"supportedVersions\":");
    _mcp_emit_versions(sb);
    str_builder_add_cstr(sb, ",\"capabilities\":");
    # The changes a listen stream carries, where this message's transport carries one
    # (3.7.2; 3.7.3).
    var lc = _dsp_listen_here(d);
    _build_capabilities_sub(sb, d, lc, lc);
    str_builder_add_cstr(sb, ",");
    _dsp_emit_modern_meta(sb, d);
    str_builder_add_cstr(sb, ",\"ttlMs\":0,\"cacheScope\":\"private\"}");
    return str_data(str_builder_build_a(a, sb));
}

# -32022, naming what bote does serve, so a client can pick from it.
fn _dsp_unsupported_version(a, id, requested) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 128 + strlen(requested) * 6);
    str_builder_add_cstr(sb, "{\"supported\":");
    _mcp_emit_versions(sb);
    str_builder_add_cstr(sb, ",\"requested\":\"");
    _json_emit_escaped(sb, requested);
    str_builder_add_cstr(sb, "\"}");
    return resp_error_data_a(a, id, 0 - 32022, "Unsupported protocol version", str_data(str_builder_build_a(a, sb)));
}

fn _dsp_cacheable(method) {
    if (streq(method, "tools/list") == 1) { return 1; }
    if (streq(method, "prompts/list") == 1) { return 1; }
    if (streq(method, "resources/list") == 1) { return 1; }
    if (streq(method, "resources/templates/list") == 1) { return 1; }
    if (streq(method, "resources/read") == 1) { return 1; }
    return 0;
}

# `result` with this revision's fields added. What a handler already set is left
# alone: a repeated key would make the object ambiguous.
fn _dsp_modern_result(a, d, method, result) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, strlen(result) + 256);
    str_builder_add_cstr(sb, "{");
    var sep = "";
    if (jsonx_has(result, "resultType") == 0) {
        str_builder_add_cstr(sb, "\"resultType\":\"complete\"");
        sep = ",";
    }
    if (_dsp_cacheable(method) == 1 && jsonx_has(result, "ttlMs") == 0) {
        str_builder_add_cstr(sb, sep);
        str_builder_add_cstr(sb, "\"ttlMs\":0,\"cacheScope\":\"private\"");
        sep = ",";
    }
    if (jsonx_has(result, "_meta") == 0) {
        str_builder_add_cstr(sb, sep);
        _dsp_emit_modern_meta(sb, d);
        sep = ",";
    }
    var n = strlen(result);
    var i = _jx_skip_ws(result, n, 0) + 1;
    i = _jx_skip_ws(result, n, i);
    if (load8(result + i) != 125) { str_builder_add_cstr(sb, sep); }
    str_builder_add_cstr(sb, result + i);
    return str_data(str_builder_build_a(a, sb));
}

fn _dsp_modern_response(a, d, method, resp) {
    if (resp == 0) { return 0; }
    var err = resp_error_obj(resp);
    if (err != 0) {
        # -32002 is the older revisions' resource-not-found. This one uses
        # -32602, and must not emit -32002 at all.
        if (rpc_err_code(err) == BOTE_RPC_RESOURCE_NOT_FOUND) { store64(err, 0 - 32602); }
        return resp;
    }
    var result = resp_result(resp);
    if (jsonx_is_object(result) == 0) {
        return resp_error_a(a, resp_id(resp), 0 - 32603, "internal error: the handler's result is not an object");
    }
    return resp_success_a(a, resp_id(resp), _dsp_modern_result(a, d, method, result));
}

# What a call gets where HTTP's 403 is out of reach: a batch element, a WebSocket frame.
# Outside the JSON-RPC reserved range, as MCP asks of a code it does not define.
var BOTE_RPC_INSUFFICIENT_SCOPE = 0 - 31403;

# `req`, a vec of scopes, when `claims` does not hold them all, or 0. Each caller has
# returned for claims of 0 first: with no token in play there is nothing to compare, as
# on stdio, which takes its credentials from the environment, and with no validator set.
# A scope required with nothing to read it is refused, not waved through.
fn _dsp_scopes_lacking(d, req, claims) {
    if (req == 0 || vec_len(req) == 0) { return 0; }
    var fp = load64(d + 88);
    if (fp == 0) { return req; }
    var i = 0;
    while (i < vec_len(req)) {
        if (fncall3(fp, claims, vec_get(req, i), load64(d + 96)) != 1) { return req; }
        i = i + 1;
    }
    return 0;
}

# The scopes the tool `name` requires, when `claims` does not hold them all, or 0 when
# it may run, or no such tool is registered.
fn dispatcher_scopes_missing(d, name, claims) {
    if (claims == 0) { return 0; }
    return _dsp_def_scopes_missing(d, registry_get(dispatcher_registry(d), name), claims);
}

# The same for the tool definition `t` a call found, or 0 for none.
fn _dsp_def_scopes_missing(d, t, claims) {
    if (claims == 0 || t == 0) { return 0; }
    return _dsp_scopes_lacking(d, tool_def_required_scopes(t), claims);
}

# The same for the prompt `name` (3.6.6).
fn dispatcher_prompt_scopes_missing(d, name, claims) {
    if (claims == 0 || name == 0 || dispatcher_prompts(d) == 0) { return 0; }
    var p = prompt_registry_get(dispatcher_prompts(d), name);
    if (p == 0) { return 0; }
    return _dsp_scopes_lacking(d, prompt_def_required_scopes(p), claims);
}

# The same for reading `uri`, judged by what would serve it, as resources/read finds that:
# the handler of the resource registered at that URI, else the first template it matches
# (3.6.6). A resource registered with no handler is served by the template, and so is
# judged by it (3.7.0): it was judged by the resource, which may require nothing, and
# served by a template that required a scope.
fn dispatcher_resource_scopes_missing(d, uri, claims) {
    if (claims == 0 || uri == 0 || dispatcher_resources(d) == 0) { return 0; }
    var fp[8];
    return _dsp_scopes_lacking(d, resource_registry_serving(dispatcher_resources(d), uri, &fp), claims);
}

# The same for a completion/complete's `ref`, on `a` (3.6.6): a completion offers what a
# prompt's arguments or a template's variables may be, which is the prompt's or the
# template's to grant. ref/prompt names a prompt; ref/resource names a template by its
# uriTemplate, or a URI, judged as resources/read would.
fn dispatcher_completion_scopes_missing_a(a, d, params, claims) {
    if (claims == 0 || params == 0) { return 0; }
    var ref = jsonx_get_raw_a(a, params, "ref");
    if (ref == 0) { return 0; }
    var kind = jsonx_get_str_dec_a(a, ref, "type");
    if (kind == 0) { return 0; }
    if (streq(kind, "ref/prompt") == 1) {
        return dispatcher_prompt_scopes_missing(d, jsonx_get_str_dec_a(a, ref, "name"), claims);
    }
    if (streq(kind, "ref/resource") == 0) { return 0; }
    var uri = jsonx_get_str_dec_a(a, ref, "uri");
    if (uri == 0 || dispatcher_resources(d) == 0) { return 0; }
    var t = resource_registry_template_named(dispatcher_resources(d), uri);
    if (t != 0) { return _dsp_scopes_lacking(d, resource_template_required_scopes(t), claims); }
    return dispatcher_resource_scopes_missing(d, uri, claims);
}

# Named, because HTTP sends this one -32602 as a 400.
var DSP_CAPS_MISSING = "io.modelcontextprotocol/clientCapabilities is required and must be an object";

# dispatcher_dispatch with bote's own bytes on `a`. `a` must outlive the response
# and nothing else. Stays on the global heap: what a handler is handed (it may
# keep it) and what a sink is handed (ditto).
fn dispatcher_dispatch_a(a, d, request, claims) {
    if (req_is_notification(request) == 1) { return 0; }
    var params = req_params(request);
    var plen = 0;
    if (params != 0) { plen = strlen(params); }
    # One pass for `_meta` and what tools/call reads, so choosing the era costs that
    # method no second walk of its params, and legacy traffic compares no method here.
    var keys[80];
    store64(&keys, "name");            store64(&keys + 8, 4);
    store64(&keys + 16, "version");    store64(&keys + 24, 7);
    store64(&keys + 32, "arguments");  store64(&keys + 40, 9);
    store64(&keys + 48, "caller_id");  store64(&keys + 56, 9);
    store64(&keys + 64, "_meta");      store64(&keys + 72, 5);
    var pos[40];
    _jx_scan(params, plen, &keys, 5, &pos);

    var meta = _jx_raw_at_a(a, params, plen, load64(&pos + 32));
    if (meta == 0 || jsonx_has(meta, DSP_META_VERSION) == 0) {
        return _dsp_serve_a(a, d, request, claims, &pos, plen);
    }
    var method = req_method(request);
    # `initialize` selects legacy semantics, whatever else it carries.
    if (streq(method, "initialize") == 1) {
        return _dsp_serve_a(a, d, request, claims, &pos, plen);
    }

    # A required field missing or of the wrong type is malformed: -32602.
    var id = req_id(request);
    var pv = jsonx_get_str_dec_a(a, meta, DSP_META_VERSION);
    if (pv == 0) {
        return resp_error_a(a, id, 0 - 32602, "io.modelcontextprotocol/protocolVersion must be a string");
    }
    if (_mcp_is_modern(pv) == 0) {
        # An older revision named per request is that revision's behaviour.
        if (_mcp_is_supported(pv) == 1) {
            return _dsp_serve_a(a, d, request, claims, &pos, plen);
        }
        return _dsp_unsupported_version(a, id, pv);
    }
    var caps = jsonx_get_raw_a(a, meta, DSP_META_CAPABILITIES);
    if (caps == 0 || jsonx_is_object(caps) == 0) {
        return resp_error_a(a, id, 0 - 32602, DSP_CAPS_MISSING);
    }

    if (streq(method, "server/discover") == 1) {
        return resp_success_a(a, id, _build_discover_result_a(a, d));
    }
    if (streq(method, "subscriptions/listen") == 1) { return _dsp_listen_a(a, d, id, req_params(request), claims); }
    # Removed from this revision, with `initialize`.
    if (streq(method, "ping") == 1) {
        return resp_error_a(a, id, 0 - 32601, "method not found: ping");
    }
    return _dsp_modern_response(a, d, method, _dsp_serve_a(a, d, request, claims, &pos, plen));
}

# ================================================================
# subscriptions/listen (3.7.2, MCP 2026-07-28)
# ================================================================
#
# A client opens a stream for the changes it opts in to: `params.notifications` names
# them, each opt-in, and the server MUST NOT send one it was not asked for. The dispatcher
# judges the request and the transport carries the stream (src/listen.cyr): what comes
# back here is the acknowledgement's `notifications`, the honored subset, which the
# transport sends as the stream's first message. The subset narrows what was asked to
# what this server delivers: a list's change when it has that list, and (3.7.4) a resource's
# update for the URIs of `resourceSubscriptions` it has room for, when it has resources.
#
# A URI is honored when it is a non-empty string with no NUL, at most BOTE_LISTEN_URI_MAX
# bytes decoded, and not a repeat, while there is room: BOTE_LISTEN_URIS of them in
# BOTE_LISTEN_URI_ROOM bytes, each with its NUL, which is what a stream keeps of them. The
# acknowledgement lists exactly those, so a client knows which it will hear of. An update
# names the URI that changed (dispatcher_resource_updated), and reaches every subscription
# to that URI or to one it falls under: the same URI, or one it begins with followed by `/`,
# `?` or `#`, or by anything when it ends in `/`. The spec allows the URI sent to be a
# sub-resource of the one subscribed.

var BOTE_LISTEN_TOOLS = 1;
var BOTE_LISTEN_PROMPTS = 2;
var BOTE_LISTEN_RESOURCES = 4;
var BOTE_LISTEN_UPDATES = 8;
var BOTE_LISTEN_URIS = 32;
var BOTE_LISTEN_URI_ROOM = 4096;
var BOTE_LISTEN_URI_MAX = 1024;
var DSP_LISTEN_FILTER = "Invalid params: 'notifications' is required and must be a valid SubscriptionFilter";

# 1 when `raw`, a field of the filter, is absent or a boolean, and *on_out says whether it
# is `true`.
fn _dsp_listen_flag(raw, on_out) {
    store64(on_out, 0);
    if (raw == 0) { return 1; }
    if (streq(raw, "true") == 1) {
        store64(on_out, 1);
        return 1;
    }
    return streq(raw, "false");
}

# 1 when `raw` is absent or an array of strings.
fn _dsp_listen_strings(raw) {
    if (raw == 0) { return 1; }
    var n = strlen(raw);
    if (n == 0 || load8(raw) != 91) { return 0; }
    var i = _jx_skip_ws(raw, n, 1);
    while (i < n && load8(raw + i) != 93) {
        if (load8(raw + i) != 34) { return 0; }
        i = _jx_array_next(raw, n, i);
    }
    return 1;
}

# The honored subset of a listen request's filter, as BOTE_LISTEN_* bits, or -1 when
# `notifications` is missing or not a SubscriptionFilter. With no claims: see
# _dsp_listen_mask_a.
fn dispatcher_listen_mask_a(a, d, params) { return _dsp_listen_mask_a(a, d, params, 0); }

# The same for a listen made with `claims` (3.7.5): a URI they may not read is not honored.
fn _dsp_listen_mask_a(a, d, params, claims) {
    if (params == 0) { return 0 - 1; }
    var f = jsonx_get_raw_a(a, params, "notifications");
    if (f == 0 || jsonx_is_object(f) == 0) { return 0 - 1; }
    var t[8];
    var p[8];
    var r[8];
    if (_dsp_listen_flag(jsonx_get_raw_a(a, f, "toolsListChanged"), &t) == 0) { return 0 - 1; }
    if (_dsp_listen_flag(jsonx_get_raw_a(a, f, "promptsListChanged"), &p) == 0) { return 0 - 1; }
    if (_dsp_listen_flag(jsonx_get_raw_a(a, f, "resourcesListChanged"), &r) == 0) { return 0 - 1; }
    if (_dsp_listen_strings(jsonx_get_raw_a(a, f, "resourceSubscriptions")) == 0) { return 0 - 1; }
    var mask = 0;
    if (load64(&t) == 1) { mask = mask | BOTE_LISTEN_TOOLS; }
    if (load64(&p) == 1 && dispatcher_prompts(d) != 0) { mask = mask | BOTE_LISTEN_PROMPTS; }
    if (load64(&r) == 1 && dispatcher_resources(d) != 0) { mask = mask | BOTE_LISTEN_RESOURCES; }
    if (dispatcher_resources(d) != 0 && _dsp_listen_uris_a(a, d, jsonx_get_raw_a(a, f, "resourceSubscriptions"), claims) != 0) {
        mask = mask | BOTE_LISTEN_UPDATES;
    }
    return mask;
}

# The string at `pos` of `raw`, decoded on `a`, when it can be a subscription's URI: not
# empty, no NUL. 0 otherwise.
fn _dsp_listen_uri_a(a, raw, n, pos) {
    var s = _jx_str_at_a(a, raw, n, pos);
    if (s == 0) { return 0; }
    var sl = strlen(s);
    var out = alloc_via(a, sl + 1);
    var dn = _jx_unescape_into(s, sl, out);
    if (dn == 0 || strlen(out) != dn) { return 0; }
    return out;
}

# 1 when what would serve `uri` requires a scope (3.7.5), judged as resources/read is.
fn _dsp_uri_scoped(d, uri) {
    if (d == 0 || uri == 0 || dispatcher_resources(d) == 0) { return 0; }
    var fp[8];
    var sc = resource_registry_serving(dispatcher_resources(d), uri, &fp);
    if (sc == 0 || vec_len(sc) == 0) { return 0; }
    return 1;
}

# The URIs of `raw`, a `resourceSubscriptions` already found to be a list of strings, that
# a stream honors, decoded, on `a`, in the order sent (above). 0 when none is. One the
# `claims` may not read, judged by what would serve it as resources/read judges it, is not
# honored (3.7.5): through 3.7.4 a token without a resource's scope heard of every change
# to it, and learned the URIs behind a scoped template.
fn _dsp_listen_uris_a(a, d, raw, claims) {
    if (raw == 0) { return 0; }
    var n = strlen(raw);
    var out = vec_new_a(a);
    var used = 0;
    var i = _jx_skip_ws(raw, n, 1);
    while (i < n && load8(raw + i) != 93 && vec_len(out) < BOTE_LISTEN_URIS) {
        var u = _dsp_listen_uri_a(a, raw, n, i);
        if (u != 0 && dispatcher_resource_scopes_missing(d, u, claims) != 0) { u = 0; }
        if (u != 0) {
            var ul = strlen(u);
            if (ul <= BOTE_LISTEN_URI_MAX && used + ul + 1 <= BOTE_LISTEN_URI_ROOM && _dsp_listen_seen(out, u) == 0) {
                vec_push_a(a, out, u);
                used = used + ul + 1;
            }
        }
        i = _jx_array_next(raw, n, i);
    }
    if (vec_len(out) == 0) { return 0; }
    return out;
}

fn _dsp_listen_seen(v, u) {
    var i = 0;
    while (i < vec_len(v)) {
        if (streq(vec_get(v, i), u) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# The acknowledgement's params for the bits `mask`: {"notifications":{...}}.
fn bote_listen_ack_params_a(a, mask) { return bote_listen_ack_uris_a(a, mask, 0); }

# The same, with the honored URIs `uris` (a vec of decoded strings, or 0) as its
# `resourceSubscriptions` when `mask` has BOTE_LISTEN_UPDATES (3.7.4).
fn bote_listen_ack_uris_a(a, mask, uris) {
    var sb = str_builder_new_a(a);
    var room = 160;
    var k = 0;
    while (uris != 0 && k < vec_len(uris)) {
        room = room + strlen(vec_get(uris, k)) * 6 + 3;
        k = k + 1;
    }
    _sb_grow_a(a, sb, room);
    str_builder_add_cstr(sb, "{\"notifications\":{");
    var sep = "";
    if ((mask & BOTE_LISTEN_TOOLS) != 0) {
        str_builder_add_cstr(sb, "\"toolsListChanged\":true");
        sep = ",";
    }
    if ((mask & BOTE_LISTEN_PROMPTS) != 0) {
        str_builder_add_cstr(sb, sep);
        str_builder_add_cstr(sb, "\"promptsListChanged\":true");
        sep = ",";
    }
    if ((mask & BOTE_LISTEN_RESOURCES) != 0) {
        str_builder_add_cstr(sb, sep);
        str_builder_add_cstr(sb, "\"resourcesListChanged\":true");
        sep = ",";
    }
    if ((mask & BOTE_LISTEN_UPDATES) != 0 && uris != 0) {
        str_builder_add_cstr(sb, sep);
        str_builder_add_cstr(sb, "\"resourceSubscriptions\":[");
        k = 0;
        while (k < vec_len(uris)) {
            if (k > 0) { str_builder_add_cstr(sb, ","); }
            str_builder_add_cstr(sb, "\"");
            bote_json_escape(sb, vec_get(uris, k));
            str_builder_add_cstr(sb, "\"");
            k = k + 1;
        }
        str_builder_add_cstr(sb, "]");
    }
    str_builder_add_cstr(sb, "}}");
    return str_data(str_builder_build_a(a, sb));
}

# Say the resource at `uri` has changed (3.7.4): every listen subscribed to it, or to a
# resource it falls under, is sent `notifications/resources/updated` naming it. Any thread
# may call it; nothing keeps `uri`. 0, or -1 for no URI.
fn dispatcher_resource_updated(d, uri) {
    if (uri == 0 || load8(uri) == 0) { return 0 - 1; }
    return event_sink_updated(dispatcher_event_sink(d), uri);
}

# 1 when this message came on a transport that can carry a listen stream for `d`
# (bote_req_stream): an HTTP transport, when `d` has a hub (3.7.2), or a connection that
# is itself the stream (3.7.3).
fn _dsp_listen_here(d) {
    var st = bote_req_stream();
    if (st == 0) { return 0; }
    if (st == 1) { return dispatcher_listen(d) != 0; }
    return 1;
}

# A subscriptions/listen request: -32601 where this message's transport carries no stream
# (_dsp_listen_here), -32602 for a filter that is not one, else a response whose result is
# the acknowledgement's params, for the transport to open the stream with. It is no answer
# to send as it is.
fn _dsp_listen_a(a, d, id, params, claims) {
    if (_dsp_listen_here(d) == 0) { return resp_error_a(a, id, 0 - 32601, "method not found: subscriptions/listen"); }
    # MCP's ids are never null (3.7.4), and a subscription's id is how it is cancelled.
    if (streq(id, "null") == 1) { return resp_error_a(a, id, 0 - 32600, "invalid request: a subscriptions/listen id must not be null"); }
    var mask = _dsp_listen_mask_a(a, d, params, claims);
    if (mask < 0) { return resp_error_a(a, id, 0 - 32602, DSP_LISTEN_FILTER); }
    var uris = 0;
    if ((mask & BOTE_LISTEN_UPDATES) != 0) {
        uris = _dsp_listen_uris_a(a, d, jsonx_get_raw_a(a, jsonx_get_raw_a(a, params, "notifications"), "resourceSubscriptions"), claims);
    }
    bote_req_set_listen_claims(claims);
    return resp_success_a(a, id, bote_listen_ack_uris_a(a, mask, uris));
}

# The methods themselves, for both eras: what differs between them is around this.
# `pos` is the router's pass over the params: name, version, arguments, caller_id.
fn _dsp_serve_a(a, d, request, claims, pos, plen) {
    var id = req_id(request);
    var method = req_method(request);
    var params = req_params(request);
    var reg = dispatcher_registry(d);

    if (streq(method, "tools/call") == 1) {
        var name = _jx_str_dec_at_a(a, params, plen, load64(pos));
        if (name == 0 || strlen(name) == 0) {
            var ne = bote_err_new_a(a, BOTE_ERR_INVALID_PARAMS, "", "missing or empty 'name' field");
            return resp_error_a(a, id, bote_err_rpc_code(bote_err_tag(ne)), str_data(bote_err_format_a(a, ne)));
        }

        # The tool, its handler and the version asked for, from one look (3.7.2): the
        # whole call is judged by and served by what this found.
        var ver = _jx_str_dec_at_a(a, params, plen, load64(pos + 8));
        var ver_ok[8];
        var has_fp[8];
        var fp_slot[8];
        var t = _dsp_tool_serving(d, name, ver, &ver_ok, &has_fp, &fp_slot);

        # Ahead of everything else about the call: a token that may not run this tool
        # learns nothing about its arguments. HTTP answers this with a 403 before it
        # gets here, and this is what a batch and a WebSocket reach.
        if (_dsp_def_scopes_missing(d, t, claims) != 0) {
            var smsg = _dsp_named_msg_a(a, "insufficient scope for tool: ", name, 0);
            _dsp_record_refusal(d, name, params, plen, load64(pos + 24), smsg);
            return resp_error_a(a, id, BOTE_RPC_INSUFFICIENT_SCOPE, smsg);
        }

        # Optional: version negotiation
        if (load64(&ver_ok) == 0) {
            var sb = str_builder_new_a(a);
            str_builder_add_cstr_a(a, sb, "version '");
            str_builder_add_cstr_a(a, sb, ver);
            str_builder_add_cstr_a(a, sb, "' not found");
            var verr = bote_err_new_a(a, BOTE_ERR_INVALID_PARAMS, name, str_data(str_builder_build_a(a, sb)));
            return resp_error_a(a, id, bote_err_rpc_code(bote_err_tag(verr)), str_data(bote_err_format_a(a, verr)));
        }

        # Extract arguments (default to "{}" if absent), caller_id (optional).
        # On the arena for now: every refusal below leaves nothing behind.
        var args = _jx_raw_at_a(a, params, plen, load64(pos + 16));
        if (args == 0) { args = "{}"; }
        var caller_id = 0;

        # A non-object `arguments` breaks CallToolRequest's own schema: the
        # request is malformed, which is a protocol error.
        if (jsonx_is_object(args) == 0) {
            return resp_error_a(a, id, 0 - 32602, _dsp_named_msg_a(a, "'arguments' must be an object for tool '", name, "'"));
        }

        # Validate. An unknown tool is a protocol error (-32602). Arguments
        # that fail the tool's inputSchema are a tool execution error: a
        # result with isError, so the model sees what it got wrong and can
        # retry (MCP 2025-11-25, SEP-1303). They were a -32602 protocol
        # error through 3.4.4.
        var verr2 = registry_validate_def_a(a, t, name, args);
        if (verr2 != 0) {
            var vmsg = str_data(bote_err_format_a(a, verr2));
            _dsp_record_refusal(d, name, params, plen, load64(pos + 24), vmsg);
            if (bote_err_tag(verr2) == BOTE_ERR_TOOL_NOT_FOUND) {
                return resp_error_a(a, id, bote_err_rpc_code(BOTE_ERR_TOOL_NOT_FOUND), vmsg);
            }
            return resp_success_a(a, id, _dsp_tool_error_result_a(a, vmsg));
        }

        # Deprecation event (best-effort; never blocks dispatch)
        if (t != 0) {
            var dep = tool_def_deprecated(t);
            if (dep != 0) {
                var ds = str_builder_new_a(a);
                _sb_grow_a(a, ds, (strlen(name) + strlen(dep)) * 6 + 64);
                str_builder_add_cstr_a(a, ds, "{\"tool_name\":\"");
                _json_emit_escaped(ds, name);
                str_builder_add_cstr_a(a, ds, "\",\"message\":\"");
                _json_emit_escaped(ds, dep);
                str_builder_add_cstr_a(a, ds, "\"}");
                event_sink_publish(dispatcher_event_sink(d), TOPIC_TOOL_DEPRECATED(),
                  str_data(str_builder_build_a(a, ds)));
            }
        }

        # Dispatch with timing + audit + event hooks.
        #
        # 3.4.1: the duration and the tool-call event exist only for an audit
        # or event sink. With neither installed nobody reads them, so skip the
        # two clock reads and the event build. Each clock read is a
        # clock_gettime syscall, measured at 1.35 µs on the reference host —
        # together over half of an unobserved tools/call.
        var audit_on = _dsp_sink_live(dispatcher_audit_sink(d));
        var events_on = _dsp_sink_wants_calls(dispatcher_event_sink(d));
        var t_start = 0;
        if (audit_on == 1 || events_on == 1) {
            t_start = clock_now_ns();
            # A sink may keep what it is handed.
            name = _jx_str_dec_at_a(default_alloc(), params, plen, load64(pos));
            caller_id = _jx_str_at_a(default_alloc(), params, plen, load64(pos + 24));
        }
        var fp = load64(&fp_slot);
        if (load64(&has_fp) == 0) {
            var nf = bote_err_new_a(a, BOTE_ERR_TOOL_NOT_FOUND, name, 0);
            var msg_nh = str_data(bote_err_format_a(a, nf));
            if (audit_on == 1 || events_on == 1) {
                var dur_nh = (clock_now_ns() - t_start) / 1000000;
                var ev_nh = tool_call_event_new(name, dur_nh, 0, msg_nh, caller_id);
                if (audit_on == 1) { audit_sink_log(dispatcher_audit_sink(d), ev_nh); }
                if (events_on == 1) {
                    event_sink_publish(dispatcher_event_sink(d), TOPIC_TOOL_FAILED(),
                      tool_call_event_to_json(ev_nh));
                }
            }
            return resp_error_a(a, id, bote_err_rpc_code(bote_err_tag(nf)), msg_nh);
        }
        # A handler may keep `args` (2.0 ABI), so it reaches the heap here,
        # past every refusal, and not before.
        args = _slice_cstr(default_alloc(), args, 0, strlen(args));
        # 2.0 ABI: fncall2 with claims (always 0 in 2.0; populated in 2.x)
        # Whatever the handler returned, the client gets a CallToolResult
        # (_dsp_coerce_result, 3.4.8). A failed call — no result, invalid
        # JSON, or a result carrying isError — is audited and published as
        # a failure.
        var fail_slot[8];
        var result = _dsp_coerce_result(name, fncall2(fp, args, bote_req_claims_kept(claims)), &fail_slot);
        var no_result = load64(&fail_slot);
        # A call its handler found cancelled did not complete, whatever it returned (3.7.5).
        # Only the sinks read it.
        if ((audit_on == 1 || events_on == 1) && bote_req_was_cancelled() == 1) { no_result = "cancelled"; }
        if (audit_on == 1 || events_on == 1) {
            var dur_ms = (clock_now_ns() - t_start) / 1000000;
            if (no_result == 0) {
                var ev_ok = tool_call_event_new(name, dur_ms, 1, 0, caller_id);
                if (audit_on == 1) { audit_sink_log(dispatcher_audit_sink(d), ev_ok); }
                if (events_on == 1) {
                    event_sink_publish(dispatcher_event_sink(d), TOPIC_TOOL_COMPLETED(),
                      tool_call_event_to_json(ev_ok));
                }
            } else {
                var ev_nr = tool_call_event_new(name, dur_ms, 0, no_result, caller_id);
                if (audit_on == 1) { audit_sink_log(dispatcher_audit_sink(d), ev_nr); }
                if (events_on == 1) {
                    event_sink_publish(dispatcher_event_sink(d), TOPIC_TOOL_FAILED(),
                      tool_call_event_to_json(ev_nr));
                }
            }
        }
        return resp_success_a(a, id, result);
    }

    if (streq(method, "initialize") == 1) {
        return resp_success_a(a, id, _build_initialize_result_a(a, d, params));
    }

    # ping — the MCP keepalive. The receiver MUST answer promptly with an
    # empty result; a client that gets an error back reads the server as
    # unhealthy and may tear the session down.
    #
    # Deliberately ahead of every capability gate and taking no params: a
    # ping has to work on a bare dispatcher with no registries wired, which
    # is the state a client probes during startup. Emits no audit or event
    # record — it is liveness, not activity, and a keepalive every few
    # seconds would swamp the chain.
    #
    # bote answers pings; it does not originate them. Server→client pings
    # need the push path that real-time streaming brings (roadmap 3.7.x).
    if (streq(method, "ping") == 1) {
        return resp_success_a(a, id, "{}");
    }

    if (streq(method, "tools/list") == 1) {
        if (_dsp_cursor_given(params) == 1) { return _dsp_cursor_refusal_a(a, id); }
        var lprofile = 0;
        if (params != 0) { lprofile = jsonx_get_str_a(a, params, "profile"); }
        return resp_success_a(a, id, _build_tools_list_result_a(a, reg, lprofile));
    }

    # prompts/* only when the prompts capability is enabled (a PromptRegistry
    # is present). Otherwise fall through to method-not-found (-32601), which
    # matches the un-advertised capability.
    if (streq(method, "prompts/list") == 1 && dispatcher_prompts(d) != 0) {
        if (_dsp_cursor_given(params) == 1) { return _dsp_cursor_refusal_a(a, id); }
        return resp_success_a(a, id, _build_prompts_list_result(a, dispatcher_prompts(d)));
    }

    if (streq(method, "prompts/get") == 1 && dispatcher_prompts(d) != 0) {
        var pname = jsonx_get_str_dec_a(a, params, "name");
        if (pname == 0 || strlen(pname) == 0) {
            var pe = bote_err_new_a(a, BOTE_ERR_INVALID_PARAMS, "", "missing or empty 'name' field");
            return resp_error_a(a, id, bote_err_rpc_code(bote_err_tag(pe)), str_data(bote_err_format_a(a, pe)));
        }
        # The prompt and its handler from one look (3.7.2), as for a tool.
        var ph_slot[8];
        var pdef = prompt_registry_serving(dispatcher_prompts(d), pname, &ph_slot);
        var phandler = load64(&ph_slot);
        if (phandler == 0) {
            return resp_error_a(a, id, 0 - 32602, _dsp_named_msg_a(a, "prompt not found: ", pname, 0));
        }
        # As for a tool: a token that may not get this prompt learns nothing past its name.
        if (claims != 0 && pdef != 0 && _dsp_scopes_lacking(d, prompt_def_required_scopes(pdef), claims) != 0) {
            return resp_error_a(a, id, BOTE_RPC_INSUFFICIENT_SCOPE, _dsp_named_msg_a(a, "insufficient scope for prompt: ", pname, 0));
        }
        var pargs = jsonx_get_raw_a(a, params, "arguments");
        if (pargs == 0) { pargs = "{}"; }
        # The MCP prompts spec: invalid prompt name and missing required
        # arguments are both -32602 (3.4.5 added the second; the handler
        # used to be called without them).
        if (jsonx_is_object(pargs) == 0) {
            return resp_error_a(a, id, 0 - 32602, _dsp_named_msg_a(a, "'arguments' must be an object for prompt '", pname, "'"));
        }
        var pmissing = _prompt_missing_required(pdef, pargs);
        if (pmissing != 0) {
            var pmb = str_builder_new_a(a);
            str_builder_add_cstr_a(a, pmb, "missing required argument '");
            str_builder_add_cstr_a(a, pmb, pmissing);
            str_builder_add_cstr_a(a, pmb, "' for prompt '");
            str_builder_add_cstr_a(a, pmb, pname);
            str_builder_add_cstr_a(a, pmb, "'");
            return resp_error_a(a, id, 0 - 32602, str_data(str_builder_build_a(a, pmb)));
        }
        # Past every refusal: a handler may keep what it is handed.
        pargs = _slice_cstr(default_alloc(), pargs, 0, strlen(pargs));
        var presult = fncall2(phandler, pargs, bote_req_claims_kept(claims));
        if (presult == 0) { presult = "{\"messages\":[]}"; }
        return _dsp_checked_result(a, id, presult);
    }

    # resources/* only when the resources capability is enabled (a
    # ResourceRegistry is present). Otherwise fall through to -32601.
    if (streq(method, "resources/list") == 1 && dispatcher_resources(d) != 0) {
        if (_dsp_cursor_given(params) == 1) { return _dsp_cursor_refusal_a(a, id); }
        return resp_success_a(a, id, _build_resources_list_result(a, dispatcher_resources(d)));
    }

    if (streq(method, "resources/read") == 1 && dispatcher_resources(d) != 0) {
        var ruri = jsonx_get_str_dec_a(a, params, "uri");
        if (ruri == 0 || strlen(ruri) == 0) {
            var re = bote_err_new_a(a, BOTE_ERR_INVALID_PARAMS, "", "missing or empty 'uri' field");
            return resp_error_a(a, id, bote_err_rpc_code(bote_err_tag(re)), str_data(bote_err_format_a(a, re)));
        }
        # What serves the URI and the scopes it requires, from one look (3.7.2).
        var rh_slot[8];
        var rscopes = resource_registry_serving(dispatcher_resources(d), ruri, &rh_slot);
        var rhandler = load64(&rh_slot);
        if (rhandler == 0) {
            # -32002 with the URI in `data`, as the MCP resources spec has
            # it. It was -32602 through 3.4.4.
            var rdb = str_builder_new_a(a);
            _sb_grow_a(a, rdb, strlen(ruri) * 6 + 16);
            str_builder_add_cstr_a(a, rdb, "{\"uri\":\"");
            _json_emit_escaped(rdb, ruri);
            str_builder_add_cstr_a(a, rdb, "\"}");
            return resp_error_data_a(a, id, BOTE_RPC_RESOURCE_NOT_FOUND,
              _dsp_named_msg_a(a, "resource not found: ", ruri, 0), str_data(str_builder_build_a(a, rdb)));
        }
        if (claims != 0 && _dsp_scopes_lacking(d, rscopes, claims) != 0) {
            return resp_error_a(a, id, BOTE_RPC_INSUFFICIENT_SCOPE, _dsp_named_msg_a(a, "insufficient scope for resource: ", ruri, 0));
        }
        # Past every refusal: a handler may keep what it is handed.
        ruri = _slice_cstr(default_alloc(), ruri, 0, strlen(ruri));
        var rresult = fncall2(rhandler, ruri, bote_req_claims_kept(claims));
        if (rresult == 0) { rresult = "{\"contents\":[]}"; }
        return _dsp_checked_result(a, id, rresult);
    }

    # resources/templates/list. An empty list when none is registered: this used to
    # be -32601, which some clients send whenever `resources` is advertised and read
    # as a server failure. Gated like the other resources/* methods, and refuses a
    # pagination `cursor` like the other list methods.
    if (streq(method, "resources/templates/list") == 1 && dispatcher_resources(d) != 0) {
        if (_dsp_cursor_given(params) == 1) { return _dsp_cursor_refusal_a(a, id); }
        return resp_success_a(a, id, _build_resource_templates_result(a, dispatcher_resources(d)));
    }

    # completion/complete only when a completion handler is set. The handler
    # receives the raw params ({ref, argument, ...}) and returns the full
    # {"completion":{"values":[...]}} body. Otherwise fall through to -32601.
    if (streq(method, "completion/complete") == 1 && dispatcher_completion(d) != 0) {
        if (jsonx_is_object(params) == 0) {
            return resp_error_a(a, id, 0 - 32602, "completion/complete params must be an object");
        }
        if (dispatcher_completion_scopes_missing_a(a, d, params, claims) != 0) {
            return resp_error_a(a, id, BOTE_RPC_INSUFFICIENT_SCOPE, "insufficient scope for completion: the prompt or resource it names");
        }
        var cparams = _slice_cstr(default_alloc(), params, 0, strlen(params));
        var cresult = fncall2(dispatcher_completion(d), cparams, bote_req_claims_kept(claims));
        if (cresult == 0) { cresult = "{\"completion\":{\"values\":[]}}"; }
        return _dsp_checked_result(a, id, cresult);
    }

    # The router answers it for a request that named this revision.
    if (streq(method, "server/discover") == 1) {
        return resp_error_a(a, id, 0 - 32602, "server/discover needs _meta naming 2026-07-28 and clientCapabilities");
    }

    # Unknown method — JSON-RPC §5.1
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 128);
    str_builder_add_cstr_a(a, sb, "method not found: ");
    str_builder_add_cstr_a(a, sb, method);
    return resp_error_a(a, id, 0 - 32601, str_data(str_builder_build_a(a, sb)));
}

# --- codec.cyr ---

# bote::codec — JSON-RPC parse, serialize, batch dispatch
# Mirrors rust-old/src/transport/codec.rs

# Hard cap on JSON-RPC batch length. Defends against the 1.9.4 audit's
# "no batch-size cap" amplification DoS — a 1 MiB body of `[{},{},...]`
# would otherwise spin allocating per-element responses until OOM.
# 100 is generous; real clients batch single-digit calls.
var CODEC_MAX_BATCH = 100;

# ================================================================
# Helpers
# ================================================================

# Slice n bytes from src starting at off into a new null-terminated cstr.
fn _slice_cstr(a, src, off, n) {
    var out = alloc_via(a, n + 1);
    memcpy(out, src + off, n);
    store8(out + n, 0);
    return out;
}

# Skip whitespace; return new index.
fn _cdc_skip_ws(buf, len, i) {
    while (i < len) {
        var c = load8(buf + i);
        if (c == 32 || c == 9 || c == 10 || c == 13) { i = i + 1; }
        else { return i; }
    }
    return i;
}

# The two line-framed transports refuse a line that does not fit their buffer:
# they answer this once, then skip to its newline. Its tail must not run as a
# message of its own.
fn codec_line_too_long() {
    return _cdc_parse_error_a(bote_req_begin(), "line too long");
}

# The offset just past the first newline in the n bytes at buf, or -1.
fn codec_line_end(buf, n) {
    var i = 0;
    while (i < n) {
        if (load8(buf + i) == 10) { return i + 1; }
        i = i + 1;
    }
    return 0 - 1;
}

# Parse a JSON-RPC request object (cstr) into a JsonRpcRequest ptr.
# Returns 0 on failure. One pass over the message; `a` owns every field.
fn codec_parse_request_a(a, line) {
    if (line == 0) { return 0; }
    var len = strlen(line);
    var keys[64];
    store64(&keys, "jsonrpc");      store64(&keys + 8, 7);
    store64(&keys + 16, "method");  store64(&keys + 24, 6);
    store64(&keys + 32, "id");      store64(&keys + 40, 2);
    store64(&keys + 48, "params");  store64(&keys + 56, 6);
    var pos[32];
    _jx_scan(line, len, &keys, 4, &pos);

    var jsonrpc = _jx_str_at_a(a, line, len, load64(&pos));
    if (jsonrpc == 0) { return 0; }
    var method = _jx_str_dec_at_a(a, line, len, load64(&pos + 8));
    if (method == 0) { return 0; }

    # id is a raw JSON literal (may be number, string-with-quotes, null);
    # 0 means absent → notification.
    var id_raw = _jx_raw_at_a(a, line, len, load64(&pos + 16));
    var params = _jx_raw_at_a(a, line, len, load64(&pos + 24));
    if (params == 0) { params = "null"; }

    var r = alloc_via(a, 32);
    store64(r, jsonrpc);
    store64(r + 8, id_raw);
    store64(r + 16, method);
    store64(r + 24, params);
    return r;
}

fn codec_parse_request(line) {
    return codec_parse_request_a(default_alloc(), line);
}

# Copy cstr `src` (n bytes) to p; return the address after it.
fn _cdc_put(p, src, n) {
    memcpy(p, src, n);
    return p + n;
}

# Serialize a JsonRpcResponse to a cstr. A success is sized first and written
# once: no builder, no growth, no second copy. `a` owns the bytes.
fn codec_serialize_response_a(a, resp) {
    if (resp == 0) { return ""; }
    var id = resp_id(resp);
    if (id == 0) { id = "null"; }
    var err = resp_error_obj(resp);
    if (err != 0) {
        # Sized here: a client wrote the id and often the message, and a plain add
        # past the room it has grows on the heap. An escaped byte is at most six.
        var msg = rpc_err_message(err);
        var data = rpc_err_data(err);
        var room = 256 + strlen(id);
        if (msg != 0) { room = room + strlen(msg) * 6; }
        if (data != 0) { room = room + strlen(data); }
        var eb = str_builder_new_a(a);
        _sb_grow_a(a, eb, room);
        str_builder_add_cstr(eb, "{\"jsonrpc\":\"");
        str_builder_add_cstr(eb, resp_jsonrpc(resp));
        str_builder_add_cstr(eb, "\",\"id\":");
        str_builder_add_cstr(eb, id);
        str_builder_add_cstr(eb, ",\"error\":{\"code\":");
        str_builder_add_int(eb, rpc_err_code(err));
        str_builder_add_cstr(eb, ",\"message\":\"");
        _json_emit_escaped(eb, msg);
        str_builder_add_cstr(eb, "\"");
        if (data != 0) {
            str_builder_add_cstr(eb, ",\"data\":");
            str_builder_add_cstr(eb, data);
        }
        str_builder_add_cstr(eb, "}}");
        return str_data(str_builder_build_a(a, eb));
    }
    var result = resp_result(resp);
    if (result == 0) { result = "null"; }
    var ver = resp_jsonrpc(resp);
    var vl = strlen(ver);
    var il = strlen(id);
    var rl = strlen(result);
    var out = alloc_via(a, 12 + vl + 7 + il + 10 + rl + 2);
    var p = _cdc_put(out, "{\"jsonrpc\":\"", 12);
    p = _cdc_put(p, ver, vl);
    p = _cdc_put(p, "\",\"id\":", 7);
    p = _cdc_put(p, id, il);
    p = _cdc_put(p, ",\"result\":", 10);
    p = _cdc_put(p, result, rl);
    store8(p, 125);
    store8(p + 1, 0);
    return out;
}

fn codec_serialize_response(resp) {
    return codec_serialize_response_a(default_alloc(), resp);
}

# Build a JSON-RPC parse-error response and return its serialized form.
fn _cdc_error_text_a(a, code, prefix, reason) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 128);
    str_builder_add_cstr(sb, prefix);
    str_builder_add_cstr(sb, reason);
    return codec_serialize_response_a(a, resp_error_a(a, "null", code, str_data(str_builder_build_a(a, sb))));
}

fn _cdc_parse_error_a(a, reason) { return _cdc_error_text_a(a, 0 - 32700, "parse error: ", reason); }
fn _cdc_invalid_request_a(a, reason) { return _cdc_error_text_a(a, 0 - 32600, "invalid request: ", reason); }
fn _cdc_parse_error(reason) { return _cdc_parse_error_a(default_alloc(), reason); }
fn _cdc_invalid_request(reason) { return _cdc_invalid_request_a(default_alloc(), reason); }

# One DEBUG line for a dispatched request (3.4.0): method, id, the tool for
# a tools/call, how it ended, and how long dispatch took. Method, id and tool
# name are client-supplied and go through bote_log_str's escaping; params
# and results are never logged.
fn _cdc_log_request(req, resp, t0) { return _cdc_log_request_a(default_alloc(), req, resp, t0); }

fn _cdc_log_request_a(a, req, resp, t0) {
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_DEBUG, "request");
    var method = req_method(req);
    bote_log_str(&ln, "method", method);
    var id = req_id(req);
    if (id != 0) { bote_log_str(&ln, "id", id); }
    if (method != 0) {
        if (streq(method, "tools/call") == 1) {
            bote_log_str(&ln, "tool", jsonx_get_str_a(a, req_params(req), "name"));
        }
    }
    if (bote_req_was_cancelled() == 1) {
        bote_log_str(&ln, "status", "cancelled");
    } elif (resp == 0) {
        bote_log_str(&ln, "status", "notification");
    } elif (resp_error_obj(resp) != 0) {
        bote_log_str(&ln, "status", "error");
        bote_log_int(&ln, "code", rpc_err_code(resp_error_obj(resp)));
    } elif (_cdc_is_tool_error(a, resp_result(resp)) == 1) {
        # A failed tool call is a result, not an error, since 3.4.5 covers
        # input validation too: without this it would log as "ok".
        bote_log_str(&ln, "status", "tool_error");
    } else {
        bote_log_str(&ln, "status", "ok");
    }
    bote_log_int(&ln, "us", (clock_now_ns() - t0) / 1000);
    bote_log_emit(&ln);
    return 0;
}

# 1 when `result` (a raw JSON literal) is a tool result carrying
# "isError":true.
fn _cdc_is_tool_error(a, result) {
    if (result == 0) { return 0; }
    var flag = jsonx_get_raw_a(a, result, "isError");
    if (flag == 0) { return 0; }
    return streq(flag, "true");
}

# 1 when `raw`, a value jsonx_get_raw took from a validated message, may be
# a request id: a string, a number or null (JSON-RPC 2.0 §4). An object, an
# array or a boolean may not.
fn _cdc_id_ok(raw) {
    var c = load8(raw);
    if (c == 34 || c == 45 || c == 110) { return 1; }
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}

# 1 when `raw` may be a request's params. JSON-RPC 2.0 §4.2 allows only a
# structured value (an object or an array). An explicit null is taken as
# absent, as codec_parse_request already does for a missing member: some
# clients send it, and it carries nothing a method could misread.
fn _cdc_params_ok(raw) {
    var c = load8(raw);
    if (c == 123 || c == 91 || c == 110) { return 1; }
    return 0;
}

# Parse one request object (`line`, already known to be valid JSON) into a
# request the dispatcher may be handed. Returns the request, or 0 with
# *err_out set to the serialized -32600 response. bridge.cyr's
# single-message path calls this too, so the two cannot drift apart.
#
# The id is echoed in the error when it could be read; a missing or
# unusable id is answered with null (JSON-RPC 2.0 §5).
fn _cdc_admit(line, err_out) { return _cdc_admit_a(default_alloc(), line, err_out); }

fn _cdc_admit_a(a, line, err_out) {
    store64(err_out, 0);
    var req = codec_parse_request_a(a, line);
    if (req == 0) {
        bote_log_debug("request rejected: malformed JSON-RPC object");
        # JSON-RPC §5: the id is null only when it cannot be read.
        var eid = jsonx_get_raw_a(a, line, "id");
        if (eid == 0 || _cdc_id_ok(eid) == 0) { eid = "null"; }
        store64(err_out, codec_serialize_response_a(a, resp_error_a(a, eid, 0 - 32600, "invalid request: malformed object")));
        return 0;
    }
    var id = req_id(req);
    if (id != 0 && _cdc_id_ok(id) == 0) {
        store64(err_out, _cdc_invalid_request_a(a, "id must be a string, a number or null"));
        return 0;
    }
    if (id == 0) { id = "null"; }
    if (streq(req_jsonrpc(req), "2.0") == 0) {
        var sb = str_builder_new_a(a);
        _sb_grow_a(a, sb, 128);
        str_builder_add_cstr(sb, "unsupported jsonrpc version '");
        str_builder_add_cstr(sb, req_jsonrpc(req));
        str_builder_add_cstr(sb, "'");
        store64(err_out, codec_serialize_response_a(a, resp_error_a(a, id, 0 - 32600, str_data(str_builder_build_a(a, sb)))));
        return 0;
    }
    if (_cdc_params_ok(req_params(req)) == 0) {
        store64(err_out, codec_serialize_response_a(a, resp_error_a(a, id, 0 - 32600,
              "invalid request: params must be an object or an array")));
        return 0;
    }
    return req;
}

# Process a single request body. Returns serialized response cstr or 0 (notif).
fn _cdc_process_single_a(a, line, dispatcher, claims) {
    # The clock is read only when DEBUG is on; at the default level the
    # per-request cost of logging is one level compare.
    var dbg = bote_log_enabled(SK_DEBUG);
    var t0 = 0;
    if (dbg == 1) { t0 = clock_now_ns(); }
    var err_slot[8];
    var req = _cdc_admit_a(a, line, &err_slot);
    if (req == 0) { return load64(&err_slot); }
    # The request, named for its cancellation check (3.7.5): the state once, for every
    # message, since on a worker it is a thread-local lookup.
    var rs = bote_req_state();
    store64(rs + BOTE_REQ_STATE_CANCEL + 16, req_id(req));
    var resp = dispatcher_dispatch_a(a, dispatcher, req, claims);
    if (dbg == 1) { _cdc_log_request_a(a, req, resp, t0); }
    store64(rs + BOTE_REQ_STATE_CANCEL + 16, 0);
    # A request its handler found cancelled gets nothing more, its response included
    # (MCP 2026-07-28: the server MUST NOT send any further messages for it).
    if (load64(rs + BOTE_REQ_STATE_CANCEL + 24) == 1) {
        store64(rs + BOTE_REQ_STATE_CANCEL + 24, 0);
        return 0;
    }
    # A connection that is itself the stream takes a listen over, and hears its cancel
    # (3.7.3, a BoteStream in src/protocol.cyr). From the state already in hand.
    var st = load64(rs + BOTE_REQ_STATE_STREAM);
    if (st > 1) {
        if (resp == 0) {
            if (streq(req_method(req), "notifications/cancelled") == 1) {
                var cid = 0;
                if (req_params(req) != 0) { cid = jsonx_get_raw_a(a, req_params(req), "requestId"); }
                bote_stream_cancel_a(st, a, cid);
            }
            return 0;
        }
        if (resp_error_obj(resp) == 0 && streq(req_method(req), "subscriptions/listen") == 1) {
            return bote_stream_open_a(st, a, req, resp);
        }
    }
    if (resp == 0) { return 0; }
    return codec_serialize_response_a(a, resp);
}

# ---- cancellation on a line transport (3.7.5) ---------------------------------------

# A request id as a value, on `a`, from its `n` raw bytes: "s" and the decoded string, or
# "n" and the raw number, so `"a/b"` and `"a\/b"` are one id and `7` and `"7"` are two.
# JSON-RPC compares ids by value. A string whose value holds a NUL is "r" and its spelling:
# a C string cannot hold the value, and its spelling must not pass for another's value
# (`"\u0000a"` was `"\\u0000a"` through 3.7.4). Numbers are compared as spelled.
fn bote_id_key_a(a, raw, n) {
    var k = alloc_via(a, n + 2);
    if (n > 0 && load8(raw) == 34) {
        var cp = alloc_via(a, n + 1);
        memcpy(cp, raw, n);
        store8(cp + n, 0);
        var s = _jx_str_at_a(a, cp, n, 0);
        if (s == 0) { s = ""; }
        var sl = strlen(s);
        var dec = s;
        if (_jx_has_escape(s, sl) == 1) {
            dec = alloc_via(a, sl + 1);
            var dn = _jx_unescape_into(s, sl, dec);
            if (strlen(dec) != dn) {
                store8(k, 114);
                memcpy(k + 1, raw, n);
                store8(k + 1 + n, 0);
                return k;
            }
        }
        store8(k, 115);
        memcpy(k + 1, dec, strlen(dec) + 1);
        return k;
    }
    store8(k, 110);
    memcpy(k + 1, raw, n);
    store8(k + 1 + n, 0);
    return k;
}

# 1 when the `n` bytes at `p` hold `needle`.
fn _cdc_holds(p, n, needle) {
    var k = strlen(needle);
    var c0 = load8(needle);
    var i = 0;
    while (i + k <= n) {
        if (load8(p + i) == c0 && memeq(p + i, needle, k) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# 1 when the `n` bytes at `p`, one line, are a `notifications/cancelled` whose `requestId`
# is the id whose key is `want`. A line is copied and read only when it spells the method
# plainly or holds an escape, which may spell it another way: the codec reads
# `notifications\/cancelled` as the same method.
fn _cdc_line_cancels_a(a, p, n, want) {
    if (n <= 0) { return 0; }
    if (_cdc_holds(p, n, "notifications/cancelled") == 0 && _cdc_holds(p, n, "\\") == 0) { return 0; }
    var line = alloc_via(a, n + 1);
    memcpy(line, p, n);
    store8(line + n, 0);
    if (jsonx_valid(line, n) == 0) { return 0; }
    var req = codec_parse_request_a(a, line);
    if (req == 0 || req_id(req) != 0 || req_method(req) == 0) { return 0; }
    if (streq(req_method(req), "notifications/cancelled") == 0 || req_params(req) == 0) { return 0; }
    var rid = jsonx_get_raw_a(a, req_params(req), "requestId");
    if (rid == 0) { return 0; }
    if (streq(bote_id_key_a(a, rid, strlen(rid)), want) == 0) { return 0; }
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_TRACE, "request cancelled by the client");
    var why = jsonx_get_str_dec_a(a, req_params(req), "reason");
    if (why != 0) { bote_log_str(&ln, "reason", why); }
    bote_log_emit(&ln);
    return 1;
}

# For a transport whose messages are lines (stdio, a Unix socket): 1 when a complete line
# of the `n` bytes at `p` cancels the request whose raw id is `id`. *done is set to the
# bytes the complete lines take, which a later look need not read again. The lines stay
# where they are, for the transport to serve in their turn: a cancellation it then reads
# names a request already answered, or one already cancelled, and is ignored.
fn codec_lines_cancel_a(a, p, n, id, done) {
    store64(done, 0);
    if (id == 0) { return 0; }
    var want = bote_id_key_a(a, id, strlen(id));
    var i = 0;
    var start = 0;
    var hit = 0;
    var m[16];
    while (i < n) {
        if (load8(p + i) == 10) {
            # Each line's reading goes once it is read: a buffer of them costs one at a time.
            bote_arena_mark(a, &m);
            if (hit == 0 && _cdc_line_cancels_a(a, p + start, i - start, want) == 1) { hit = 1; }
            bote_arena_release(a, &m);
            start = i + 1;
        }
        i = i + 1;
    }
    store64(done, start);
    return hit;
}

# Walk a top-level JSON array (cstr starting with `[`); for each element,
# extract its raw bytes and append to the returned vec of cstrs.
# Caller verifies non-empty.
fn _cdc_split_array(a, buf) {
    var out = vec_new_a(a);
    var len = strlen(buf);
    var i = _cdc_skip_ws(buf, len, 0);
    if (i >= len) { return out; }
    if (load8(buf + i) != 91) { return out; }
    i = i + 1;
    while (i < len) {
        i = _cdc_skip_ws(buf, len, i);
        if (i >= len) { return out; }
        if (load8(buf + i) == 93) { return out; }
        var start = i;
        var end = _jx_skip_value(buf, len, i);
        vec_push_a(a, out, _slice_cstr(a, buf, start, end - start));
        i = _cdc_skip_ws(buf, len, end);
        if (i < len) { if (load8(buf + i) == 44) { i = i + 1; } }
    }
    return out;
}

# Process a raw JSON-RPC message. Returns serialized response cstr or 0.
#
# The whole message is syntax-checked first (jsonx_valid), so that invalid
# JSON is a parse error (-32700) and every later step reads valid JSON.
# Only then does the shape decide: an object is one request, an array is a
# batch, and any other JSON value is an invalid request (-32600).
fn codec_process_message(input, dispatcher, claims) {
    return codec_process_message_a(default_alloc(), input, dispatcher, claims);
}

# codec_process_message with every byte bote owns on `a`, the response included:
# the caller keeps `a` until it has sent the response.
fn codec_process_message_a(a, input, dispatcher, claims) {
    if (input == 0) { return _cdc_parse_error_a(a, "empty input"); }
    var len = strlen(input);
    var i = _cdc_skip_ws(input, len, 0);
    if (i >= len) { return _cdc_parse_error_a(a, "empty input"); }
    if (jsonx_valid(input, len) == 0) { return _cdc_parse_error_a(a, "invalid JSON"); }
    var first = load8(input + i);

    if (first == 91) {
        # Array (batch)
        var elems = _cdc_split_array(a, input);
        var n = vec_len(elems);
        if (n == 0) { return _cdc_invalid_request_a(a, "empty batch"); }
        # DoS guard: cap batch size. A pathological client sending a
        # 1 MiB body of `[{},{},...]` (~300k elements) would otherwise
        # process each, build a per-element response, and accumulate
        # bump-allocated buffers until OOM. 100 is generous for any
        # legitimate batch use case (real clients batch <10 calls).
        if (n > CODEC_MAX_BATCH) {
            return _cdc_invalid_request_a(a, "batch too large");
        }
        # A batch carries no stream: 2026-07-28 has no batches, and an answer in an array
        # cannot be one.
        bote_req_set_stream(0);
        var responses = vec_new_a(a);
        var ei = 0;
        while (ei < n) {
            var elem = vec_get(elems, ei);
            # Each element must be an object
            if (jsonx_is_object(elem) == 0) {
                vec_push_a(a, responses, _cdc_invalid_request_a(a, "batch element is not an object"));
            } else {
                var single = _cdc_process_single_a(a, elem, dispatcher, claims);
                if (single != 0) { vec_push_a(a, responses, single); }
            }
            ei = ei + 1;
        }
        var nr = vec_len(responses);
        if (nr == 0) { return 0; }
        var sb = str_builder_new_a(a);
        str_builder_add_cstr_a(a, sb, "[");
        var ri = 0;
        while (ri < nr) {
            if (ri > 0) { str_builder_add_cstr_a(a, sb, ","); }
            str_builder_add_cstr_a(a, sb, vec_get(responses, ri));
            ri = ri + 1;
        }
        str_builder_add_cstr_a(a, sb, "]");
        return str_data(str_builder_build_a(a, sb));
    }

    if (first == 123) {
        return _cdc_process_single_a(a, input, dispatcher, claims);
    }

    return _cdc_invalid_request_a(a, "expected object or array");
}

# --- schema.cyr ---

# bote::schema — JSON Schema compilation and validation
# Mirrors rust-old/src/schema.rs
#
# Cyrius limitations vs Rust:
#   - No floats. A number is read exactly for its type (integral or not,
#     exponents included) and truncated toward zero for its bounds; see
#     _sch_num_parse.
#   - apply_defaults is not yet implemented (would need JSON object mutation).

# ================================================================
# SchemaTypeTag
# ================================================================

enum SchemaTypeTag {
    SCH_STRING = 0;
    SCH_NUMBER = 1;
    SCH_INTEGER = 2;
    SCH_BOOLEAN = 3;
    SCH_ARRAY = 4;
    SCH_OBJECT = 5;
    SCH_ANY = 6;
    SCH_NEVER = 7;
}

# ================================================================
# PropertyDef (80 bytes):
#   +0  type_tag         i64
#   +8  description      cstr or 0
#   +16 enum_values      vec of cstrs (string only) or 0
#   +24 default          cstr (raw JSON literal) or 0
#   +32 has_min          0/1
#   +40 minimum          i64
#   +48 has_max          0/1
#   +56 maximum          i64
#   +64 items            PropertyDef ptr (array element type) or 0
#   +72 nested_compiled  CompiledSchema ptr (object nested schema) or 0
# ================================================================

fn prop_new(tag) {
    var p = alloc(80);
    store64(p, tag);
    store64(p + 8, 0);
    store64(p + 16, 0);
    store64(p + 24, 0);
    store64(p + 32, 0);
    store64(p + 40, 0);
    store64(p + 48, 0);
    store64(p + 56, 0);
    store64(p + 64, 0);
    store64(p + 72, 0);
    return p;
}

fn prop_tag(p) { return load64(p); }
fn prop_description(p) { return load64(p + 8); }
fn prop_enum_values(p) { return load64(p + 16); }
fn prop_default(p) { return load64(p + 24); }
fn prop_has_min(p) { return load64(p + 32); }
fn prop_min(p) { return load64(p + 40); }
fn prop_has_max(p) { return load64(p + 48); }
fn prop_max(p) { return load64(p + 56); }
fn prop_items(p) { return load64(p + 64); }
fn prop_nested(p) { return load64(p + 72); }

# ================================================================
# CompiledSchema (24 bytes):
#   +0  properties  hashmap: name_cstr -> PropertyDef ptr
#   +8  required    vec of name_cstrs
#   +16 names       vec of name_cstrs (insertion order)
# ================================================================

fn compiled_new() {
    var c = alloc(24);
    store64(c, map_new());
    store64(c + 8, vec_new());
    store64(c + 16, vec_new());
    return c;
}

fn compiled_properties(c) { return load64(c); }
fn compiled_required(c) { return load64(c + 8); }
fn compiled_names(c) { return load64(c + 16); }

fn compiled_get_property(c, name) {
    return map_get(compiled_properties(c), name);
}

fn compiled_add_property(c, name, prop) {
    map_set(compiled_properties(c), name, prop);
    vec_push(compiled_names(c), name);
    return 0;
}

fn compiled_set_required(c, required_vec) {
    store64(c + 8, required_vec);
    return 0;
}

# ================================================================
# Helpers — JSON value type detection on raw cstr
# ================================================================

# Returns the first non-whitespace byte of `s`, or 0 if EOS.
fn _sch_first_nonws(s) {
    if (s == 0) { return 0; }
    var i = 0;
    while (1 == 1) {
        var c = load8(s + i);
        if (c == 0) { return 0; }
        if (c == 32 || c == 9 || c == 10 || c == 13) { i = i + 1; }
        else { return c; }
    }
    return 0;
}

# Type-detection predicates on raw JSON value cstrs.
fn _sch_is_string(v) { if (_sch_first_nonws(v) == 34) { return 1; } return 0; }
fn _sch_is_array(v)  { if (_sch_first_nonws(v) == 91) { return 1; } return 0; }
fn _sch_is_object(v) { if (_sch_first_nonws(v) == 123) { return 1; } return 0; }
fn _sch_is_boolean(v) {
    var c = _sch_first_nonws(v);
    if (c == 116 || c == 102) { return 1; }
    return 0;
}
fn _sch_is_null(v) { if (_sch_first_nonws(v) == 110) { return 1; } return 0; }

# Magnitude a parsed number saturates at: 2^62.
var SCH_NUM_SAT = 4611686018427387904;

fn _sch_is_digit(c) {
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}

# Parse the JSON number at the start of v (RFC 8259 §6; leading whitespace
# allowed, parsing stops where the number ends). Writes the value truncated
# toward zero to *val_out, its magnitude saturating at SCH_NUM_SAT. Returns 2
# when the value is integral, 1 when it has a non-zero fractional part, and 0
# when v does not begin with a JSON number.
#
# Integral is JSON Schema 2020-12's rule, the dialect MCP 2025-11-25 defaults
# to: a number with a zero fractional part is an integer, so `5.0` and `1e2`
# are integers. Through 3.4.7 the validator rejected any `.` for `integer`,
# and it read numbers up to the first non-digit, so `5e2` counted as 5. That
# only became reachable in production once schemas were compiled at
# registration (3.4.8).
#
# Truncating toward zero never makes a valid value fail a bound, because the
# rounding is monotonic. A fractional bound can therefore only let a value
# slightly outside it through: `minimum` 4.5 admits 4.1. Exact decimal
# comparison is not implemented.
fn _sch_num_parse(v, val_out) {
    store64(val_out, 0);
    if (v == 0) { return 0; }
    var i = 0;
    while (load8(v + i) == 32 || load8(v + i) == 9 || load8(v + i) == 10 || load8(v + i) == 13) { i = i + 1; }
    var neg = 0;
    if (load8(v + i) == 45) { neg = 1; i = i + 1; }
    if (_sch_is_digit(load8(v + i)) == 0) { return 0; }
    var istart = i;
    if (load8(v + i) == 48) { i = i + 1; }
    else { while (_sch_is_digit(load8(v + i)) == 1) { i = i + 1; } }
    var ilen = i - istart;
    var fstart = i;
    var flen = 0;
    if (load8(v + i) == 46) {
        i = i + 1;
        if (_sch_is_digit(load8(v + i)) == 0) { return 0; }
        fstart = i;
        while (_sch_is_digit(load8(v + i)) == 1) { i = i + 1; }
        flen = i - fstart;
    }
    var e = 0;
    if (load8(v + i) == 101 || load8(v + i) == 69) {
        i = i + 1;
        var eneg = 0;
        if (load8(v + i) == 43) { i = i + 1; }
        elif (load8(v + i) == 45) { eneg = 1; i = i + 1; }
        if (_sch_is_digit(load8(v + i)) == 0) { return 0; }
        while (_sch_is_digit(load8(v + i)) == 1) {
            if (e < 100000) { e = e * 10 + (load8(v + i) - 48); }
            i = i + 1;
        }
        if (eneg == 1) { e = 0 - e; }
    }
    # The digits, integer part then fraction, scaled by 10^(e - flen). The
    # first `keep` of them are the integer part of the value.
    var dlen = ilen + flen;
    var scale = e - flen;
    var keep = dlen;
    if (scale < 0) {
        keep = dlen + scale;
        if (keep < 0) { keep = 0; }
    }
    var integral = 2;
    var n = 0;
    var k = 0;
    while (k < dlen) {
        var ch = 0;
        if (k < ilen) { ch = load8(v + istart + k); }
        else { ch = load8(v + fstart + k - ilen); }
        if (k < keep) {
            if (n < SCH_NUM_SAT / 10) { n = n * 10 + (ch - 48); }
            else { n = SCH_NUM_SAT; }
        } elif (ch != 48) {
            integral = 1;
        }
        k = k + 1;
    }
    var m = 0;
    while (m < scale && n != 0) {
        if (n < SCH_NUM_SAT / 10) { n = n * 10; }
        else { n = SCH_NUM_SAT; m = scale; }
        m = m + 1;
    }
    if (n > SCH_NUM_SAT) { n = SCH_NUM_SAT; }
    if (neg == 1) { n = 0 - n; }
    store64(val_out, n);
    return integral;
}

# Strip surrounding quotes from a JSON-string cstr ("hello" → hello).
# Caller guarantees v is a string literal. Returns a cstr owned by `a`.
fn _sch_unquote(v) { return _sch_unquote_a(default_alloc(), v); }

fn _sch_unquote_a(a, v) {
    var len = strlen(v);
    if (len < 2) { return ""; }
    var inner = len - 2;
    var out = alloc_via(a, inner + 1);
    memcpy(out, v + 1, inner);
    store8(out + inner, 0);
    return out;
}

# The value of the JSON number v, truncated toward zero (0 when v is not a
# number). It reads fractions and exponents through _sch_num_parse, so a
# bound or an argument written `5e2` is 500, not 5 (3.4.8).
fn _sch_parse_int(v) {
    var t[8];
    _sch_num_parse(v, &t);
    return load64(&t);
}

# Walk a top-level JSON array (cstr starting with `[`); push each raw element
# bytes into a returned vec of cstrs.
fn _sch_split_array(buf) { return _sch_split_array_a(default_alloc(), buf); }

fn _sch_split_array_a(a, buf) {
    var out = vec_new_a(a);
    if (buf == 0) { return out; }
    var len = strlen(buf);
    var i = _cdc_skip_ws(buf, len, 0);
    if (i >= len) { return out; }
    if (load8(buf + i) != 91) { return out; }
    i = i + 1;
    while (i < len) {
        i = _cdc_skip_ws(buf, len, i);
        if (i >= len) { return out; }
        if (load8(buf + i) == 93) { return out; }
        var start = i;
        var end = _jx_skip_value(buf, len, i);
        var elen = end - start;
        var elem = alloc_via(a, elen + 1);
        memcpy(elem, buf + start, elen);
        store8(elem + elen, 0);
        vec_push_a(a, out, elem);
        i = _cdc_skip_ws(buf, len, end);
        if (i < len) { if (load8(buf + i) == 44) { i = i + 1; } }
    }
    return out;
}

# ================================================================
# parse_property — JSON Schema property → PropertyDef
# ================================================================

fn parse_property(raw_json) {
    # The schema `false` allows nothing (2020-12). Read as "no type", it allowed
    # anything.
    if (raw_json != 0 && streq(raw_json, "false") == 1) { return prop_new(SCH_NEVER); }
    var type_str = jsonx_get_str(raw_json, "type");
    var tag = SCH_ANY;
    if (type_str != 0) {
        if (streq(type_str, "string") == 1) { tag = SCH_STRING; }
        elif (streq(type_str, "number") == 1) { tag = SCH_NUMBER; }
        elif (streq(type_str, "integer") == 1) { tag = SCH_INTEGER; }
        elif (streq(type_str, "boolean") == 1) { tag = SCH_BOOLEAN; }
        elif (streq(type_str, "array") == 1) { tag = SCH_ARRAY; }
        elif (streq(type_str, "object") == 1) { tag = SCH_OBJECT; }
    }
    var p = prop_new(tag);
    store64(p + 8, jsonx_get_str(raw_json, "description"));

    if (tag == SCH_STRING) {
        var enum_raw = jsonx_get_raw(raw_json, "enum");
        if (enum_raw != 0) {
            var vals = vec_new();
            var elems = _sch_split_array(enum_raw);
            var ne = vec_len(elems);
            var ei = 0;
            while (ei < ne) {
                var ev = vec_get(elems, ei);
                if (_sch_is_string(ev) == 1) {
                    vec_push(vals, _sch_unquote(ev));
                }
                ei = ei + 1;
            }
            store64(p + 16, vals);
        }
        var def_s = jsonx_get_str(raw_json, "default");
        if (def_s != 0) { store64(p + 24, def_s); }
    } elif (tag == SCH_NUMBER) {
        var min_s = jsonx_get_raw(raw_json, "minimum");
        if (min_s != 0) { store64(p + 32, 1); store64(p + 40, _sch_parse_int(min_s)); }
        var max_s = jsonx_get_raw(raw_json, "maximum");
        if (max_s != 0) { store64(p + 48, 1); store64(p + 56, _sch_parse_int(max_s)); }
        var def_n = jsonx_get_raw(raw_json, "default");
        if (def_n != 0) { store64(p + 24, def_n); }
    } elif (tag == SCH_INTEGER) {
        var imin = jsonx_get_raw(raw_json, "minimum");
        if (imin != 0) { store64(p + 32, 1); store64(p + 40, _sch_parse_int(imin)); }
        var imax = jsonx_get_raw(raw_json, "maximum");
        if (imax != 0) { store64(p + 48, 1); store64(p + 56, _sch_parse_int(imax)); }
        var def_i = jsonx_get_raw(raw_json, "default");
        if (def_i != 0) { store64(p + 24, def_i); }
    } elif (tag == SCH_BOOLEAN) {
        var def_b = jsonx_get_raw(raw_json, "default");
        if (def_b != 0) { store64(p + 24, def_b); }
    } elif (tag == SCH_ARRAY) {
        var items_raw = jsonx_get_raw(raw_json, "items");
        if (items_raw != 0) { store64(p + 64, parse_property(items_raw)); }
    } elif (tag == SCH_OBJECT) {
        store64(p + 72, _compile_object_body(raw_json));
    }
    return p;
}

# Compile an object schema's body (its `properties` + `required`) into
# a fresh CompiledSchema.
fn _compile_object_body(raw_json) {
    var c = compiled_new();
    var members = _jx_members(jsonx_get_raw(raw_json, "properties"));
    var mi = 0;
    while (mi < vec_len(members)) {
        compiled_add_property(c, vec_get(members, mi), parse_property(vec_get(members, mi + 1)));
        mi = mi + 2;
    }
    var req_raw = jsonx_get_raw(raw_json, "required");
    if (req_raw != 0) {
        var req_vec = vec_new();
        var elems = _sch_split_array(req_raw);
        var ne = vec_len(elems);
        var ei = 0;
        while (ei < ne) {
            var ev = vec_get(elems, ei);
            if (_sch_is_string(ev) == 1) {
                vec_push(req_vec, _sch_unquote(ev));
            }
            ei = ei + 1;
        }
        compiled_set_required(c, req_vec);
    }
    return c;
}

# ================================================================
# compile — ToolSchema → CompiledSchema
# ================================================================

fn compiled_compile(schema) {
    var c = compiled_new();
    var props = schema_properties(schema);
    if (props != 0) {
        var n = vec_len(props);
        var i = 0;
        while (i < n) {
            var pair = vec_get(props, i);
            compiled_add_property(c, schema_prop_key(pair), parse_property(schema_prop_value(pair)));
            i = i + 1;
        }
    }
    var req = schema_required(schema);
    if (req != 0) {
        store64(c + 8, req);
    }
    return c;
}

# ================================================================
# validate — params (raw JSON cstr) against CompiledSchema
# ================================================================
#
# Returns vec of violation cstrs. Empty vec == ok.

# `slot` is {vec, allocator, count}. The vec is created by the first violation,
# so a request that passes validation allocates none. Collection stops at
# BOTE_SCH_MAX_VIOLATIONS: a message can hold far more, and a client learns
# nothing from the thousandth that it did not from the thirty-second.
var BOTE_SCH_MAX_VIOLATIONS = 32;
fn _vs_alloc(slot) { return load64(slot + 8); }
fn _vs_full(slot) {
    if (load64(slot + 16) >= BOTE_SCH_MAX_VIOLATIONS) { return 1; }
    return 0;
}

fn _violation_push(slot, msg) {
    if (_vs_full(slot) == 1) { return 0; }
    var a = _vs_alloc(slot);
    var v = load64(slot);
    if (v == 0) { v = vec_new_a(a); store64(slot, v); }
    vec_push_a(a, v, msg);
    store64(slot + 16, load64(slot + 16) + 1);
    return 0;
}

fn _violation(slot, path, msg) {
    if (_vs_full(slot) == 1) { return 0; }
    var a = _vs_alloc(slot);
    var sb = str_builder_new_a(a);
    str_builder_add_cstr_a(a, sb, path);
    str_builder_add_cstr_a(a, sb, ": ");
    str_builder_add_cstr_a(a, sb, msg);
    _violation_push(slot, str_data(str_builder_build_a(a, sb)));
    return 0;
}

fn _validate_value(path, value, prop, violations) {
    var tag = prop_tag(prop);
    if (tag == SCH_ANY) { return 0; }
    if (tag == SCH_NEVER) {
        _violation(violations, path, "not allowed by the schema");
        return 0;
    }

    if (tag == SCH_STRING) {
        if (_sch_is_string(value) == 0) {
            _violation(violations, path, "expected string");
            return 0;
        }
        var allowed = prop_enum_values(prop);
        if (allowed != 0) {
            var raw_str = _sch_unquote_a(_vs_alloc(violations), value);
            var n = vec_len(allowed);
            var i = 0;
            var found = 0;
            while (i < n) {
                if (streq(vec_get(allowed, i), raw_str) == 1) { found = 1; }
                i = i + 1;
            }
            if (found == 0) {
                var ea = _vs_alloc(violations);
                var sb = str_builder_new_a(ea);
                str_builder_add_cstr_a(ea, sb, "value '");
                str_builder_add_cstr_a(ea, sb, raw_str);
                str_builder_add_cstr_a(ea, sb, "' not in enum");
                _violation(violations, path, str_data(str_builder_build_a(ea, sb)));
            }
        }
        return 0;
    }

    if (tag == SCH_NUMBER) {
        var nslot[8];
        if (_sch_num_parse(value, &nslot) == 0) {
            _violation(violations, path, "expected number");
            return 0;
        }
        var nv = load64(&nslot);
        # A fractional value is past its truncation: -0.9 is under 0 and 10.9
        # is over 10, though each truncates onto the bound.
        var nfrac = 0;
        if (_sch_num_parse(value, &nslot) == 1) { nfrac = 1; }
        var nneg = 0;
        if (_sch_first_nonws(value) == 45) { nneg = 1; }
        if (prop_has_min(prop) == 1) {
            if (nv < prop_min(prop) || (nfrac == 1 && nneg == 1 && nv == prop_min(prop))) {
                _violation(violations, path, "less than minimum");
            }
        }
        if (prop_has_max(prop) == 1) {
            if (nv > prop_max(prop) || (nfrac == 1 && nneg == 0 && nv == prop_max(prop))) {
                _violation(violations, path, "greater than maximum");
            }
        }
        return 0;
    }

    if (tag == SCH_INTEGER) {
        var islot[8];
        if (_sch_num_parse(value, &islot) != 2) {
            _violation(violations, path, "expected integer");
            return 0;
        }
        var iv = load64(&islot);
        # Past the range a value can be held in, a handler would read a
        # different number from the one sent.
        if (iv >= SCH_NUM_SAT || iv <= 0 - SCH_NUM_SAT) {
            _violation(violations, path, "integer out of range");
            return 0;
        }
        if (prop_has_min(prop) == 1) {
            if (iv < prop_min(prop)) { _violation(violations, path, "less than minimum"); }
        }
        if (prop_has_max(prop) == 1) {
            if (iv > prop_max(prop)) { _violation(violations, path, "greater than maximum"); }
        }
        return 0;
    }

    if (tag == SCH_BOOLEAN) {
        if (_sch_is_boolean(value) == 0) {
            _violation(violations, path, "expected boolean");
        }
        return 0;
    }

    if (tag == SCH_ARRAY) {
        if (_sch_is_array(value) == 0) {
            _violation(violations, path, "expected array");
            return 0;
        }
        var items_prop = prop_items(prop);
        if (items_prop != 0) {
            var ia = _vs_alloc(violations);
            var elems = _sch_split_array_a(ia, value);
            var n = vec_len(elems);
            var i = 0;
            while (i < n && _vs_full(violations) == 0) {
                var sb = str_builder_new_a(ia);
                str_builder_add_cstr_a(ia, sb, path);
                str_builder_add_cstr_a(ia, sb, "[");
                str_builder_add_int_a(ia, sb, i);
                str_builder_add_cstr_a(ia, sb, "]");
                _validate_value(str_data(str_builder_build_a(ia, sb)), vec_get(elems, i), items_prop, violations);
                i = i + 1;
            }
        }
        return 0;
    }

    if (tag == SCH_OBJECT) {
        if (_sch_is_object(value) == 0) {
            _violation(violations, path, "expected object");
            return 0;
        }
        var nested = prop_nested(prop);
        if (nested != 0) {
            _validate_against(path, value, nested, violations);
        }
        return 0;
    }
    return 0;
}

# Validate `value_cstr` (a JSON object) against `compiled` schema, prefixing
# all violations with `path` (use "" for top-level).
fn _validate_against(path, value_cstr, compiled, violations) {
    if (_sch_is_object(value_cstr) == 0) {
        _violation(violations, path, "expected object");
        return 0;
    }
    # Required fields
    var req = compiled_required(compiled);
    if (req != 0) {
        var nr = vec_len(req);
        var ri = 0;
        while (ri < nr) {
            var rkey = vec_get(req, ri);
            if (jsonx_has(value_cstr, rkey) == 0) {
                var ra = _vs_alloc(violations);
                var sb = str_builder_new_a(ra);
                str_builder_add_cstr_a(ra, sb, "missing required field: ");
                str_builder_add_cstr_a(ra, sb, rkey);
                if (strlen(path) > 0) {
                    _violation(violations, path, str_data(str_builder_build_a(ra, sb)));
                } else {
                    _violation_push(violations, str_data(str_builder_build_a(ra, sb)));
                }
            }
            ri = ri + 1;
        }
    }
    # Type-check provided fields against properties (extra fields permitted)
    var names = compiled_names(compiled);
    var nn = vec_len(names);
    var ni = 0;
    var vlen = strlen(value_cstr);
    var pa = _vs_alloc(violations);
    while (ni < nn && _vs_full(violations) == 0) {
        var name = vec_get(names, ni);
        var vpos = _jx_find_value_pos(value_cstr, vlen, name);
        if (vpos != 0 - 1) {
            var prop = compiled_get_property(compiled, name);
            var raw_val = _jx_raw_at_a(pa, value_cstr, vlen, vpos);
            var sub_path = name;
            if (strlen(path) > 0) {
                var sbp = str_builder_new_a(pa);
                str_builder_add_cstr_a(pa, sbp, path);
                str_builder_add_cstr_a(pa, sbp, ".");
                str_builder_add_cstr_a(pa, sbp, name);
                sub_path = str_data(str_builder_build_a(pa, sbp));
            }
            _validate_value(sub_path, raw_val, prop, violations);
        }
        ni = ni + 1;
    }
    return 0;
}

# Public entry: validate `params_cstr` against `compiled`.
# Returns vec of violation cstrs (empty vec == ok).
fn compiled_validate(compiled, params_cstr) {
    var v = compiled_check_a(default_alloc(), compiled, params_cstr);
    if (v == 0) { return vec_new(); }
    return v;
}

# compiled_validate without the empty vec: the violations, on `a`, or 0 when
# there are none.
fn compiled_check_a(a, compiled, params_cstr) {
    var slot[24];
    store64(&slot, 0);
    store64(&slot + 8, a);
    store64(&slot + 16, 0);
    if (_sch_is_object(params_cstr) == 0) {
        _violation_push(&slot, "params must be an object");
        return load64(&slot);
    }
    _validate_against("", params_cstr, compiled, &slot);
    return load64(&slot);
}

# --- stream.cyr ---

# bote::stream — progress + cancellation primitives
# Mirrors rust-old/src/stream.rs (data + JSON serialization;
# thread-spawning / mpsc-channel integration deferred until streaming dispatch
# is wired through a transport).
#
# Sentinel: total = 0 - 1 (i.e. -1) means "no total given".
# message = 0 means "no message".

# CancellationToken (8 bytes): pointer to a single i64 flag. Multiple clones
# share the same flag (they hold the same pointer).
#
# ⚠ `bote_`-prefixed since 3.3.5, and the prefix is load-bearing. The
# unprefixed `cancel_token_new` collided with stdlib `lib/async.cyr`'s own
# `cancel_token_new` — cyrius has ONE flat fn namespace with
# "last definition wins", so which body won was decided by include order.
# In bote's own binaries `src/` is included after `lib/`, so bote's won and
# nothing misbehaved; but a consumer vendoring `dist/bote.cyr` and including
# `async.cyr` AFTER it silently got async's instead, with no error and no
# warning on their side. The two happen to be semantically identical
# (an 8-byte heap flag initialised to 0), which is why this was carried as a
# benign diagnostic from 3.3.0 — it was a latent trap, not a live bug.
#
# The whole family is prefixed, not just the one name that collided:
# `cancel_token_cancel` / `cancel_token_is_cancelled` do not clash with
# async's `cancel_token_signal` / `cancel_token_check` today, but a token
# minted by `bote_cancel_token_new` and cancelled by a bare
# `cancel_token_cancel` is an incoherent surface, and half a namespace is
# worse than either whole.
fn bote_cancel_token_new() {
    var flag = alloc(8);
    store64(flag, 0);
    return flag;
}

fn bote_cancel_token_cancel(t) { store64(t, 1); return 0; }
fn bote_cancel_token_is_cancelled(t) { return load64(t); }

# ProgressUpdate (24 bytes):
#   +0  progress  i64
#   +8  total     i64 (0 - 1 means "no total")
#   +16 message   cstr or 0

fn progress_update_new(progress, total, message) {
    var u = alloc(24);
    store64(u, progress);
    store64(u + 8, total);
    store64(u + 16, message);
    return u;
}

fn progress_update_progress(u) { return load64(u); }
fn progress_update_total(u) { return load64(u + 8); }
fn progress_update_message(u) { return load64(u + 16); }

fn progress_update_has_total(u) {
    if (load64(u + 8) == 0 - 1) { return 0; }
    return 1;
}

# ProgressSender (16 bytes):
#   +0  updates_vec  vec of ProgressUpdate ptrs (collected synchronously for now)
#   +8  closed       0/1 (1 = receiver dropped, send becomes no-op)
#
# When real channels arrive (lib/thread.cyr MPSC), swap the vec for a chan ptr.

fn progress_sender_new() {
    var s = alloc(16);
    store64(s, vec_new());
    store64(s + 8, 0);
    return s;
}

fn progress_sender_updates(s) { return load64(s); }
fn progress_sender_close(s) { store64(s + 8, 1); return 0; }
fn progress_sender_is_closed(s) { return load64(s + 8); }

fn progress_sender_send(s, update) {
    if (progress_sender_is_closed(s) == 1) { return 0; }
    vec_push(progress_sender_updates(s), update);
    return 0;
}

# Convenience: report progress out of total.
fn progress_sender_report(s, progress, total) {
    return progress_sender_send(s, progress_update_new(progress, total, 0));
}

# Convenience: report progress with a message.
fn progress_sender_report_msg(s, progress, total, message) {
    return progress_sender_send(s, progress_update_new(progress, total, message));
}

# StreamContext (16 bytes):
#   +0  progress     ProgressSender ptr
#   +8  cancellation CancellationToken ptr

fn stream_context_new() {
    var c = alloc(16);
    store64(c, progress_sender_new());
    store64(c + 8, bote_cancel_token_new());
    return c;
}

fn stream_context_progress(c) { return load64(c); }
fn stream_context_cancellation(c) { return load64(c + 8); }

# ================================================================
# JSON-RPC notification wire builders
# ================================================================
#
# `notification_wire` is the generic server→client notification envelope:
#   {"jsonrpc":"2.0","method":<method>,"params":<params>}
# `method` is a plain string (JSON-escaped); `params` is a raw JSON literal
# cstr already shaped by the caller (0 ⇒ emit {}). These builders only
# produce the wire bytes — delivery is the transport's job (the streamable
# ResumptionBuffer; see src/transport_streamable.cyr).

fn notification_wire(method, params) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"method\":\"");
    _json_emit_escaped(sb, method);
    str_builder_add_cstr(sb, "\",\"params\":");
    if (params == 0) { str_builder_add_cstr(sb, "{}"); }
    else { str_builder_add_cstr(sb, params); }
    str_builder_add_cstr(sb, "}");
    return str_data(str_builder_build(sb));
}

# `notifications/tools/list_changed` — the tool set changed.
fn tools_list_changed_notification() {
    return notification_wire("notifications/tools/list_changed", "{}");
}

# `notifications/prompts/list_changed` — the prompt set changed.
fn prompts_list_changed_notification() {
    return notification_wire("notifications/prompts/list_changed", "{}");
}

# `notifications/resources/list_changed` — the resource set changed.
fn resources_list_changed_notification() {
    return notification_wire("notifications/resources/list_changed", "{}");
}

# `notifications/resources/updated` — the resource at `uri` changed.
fn resource_updated_notification(uri) {
    var pb = str_builder_new();
    str_builder_add_cstr(pb, "{\"uri\":\"");
    _json_emit_escaped(pb, uri);
    str_builder_add_cstr(pb, "\"}");
    return notification_wire("notifications/resources/updated", str_data(str_builder_build(pb)));
}

# Build a JSON-RPC notification cstr for a progress update.
# request_id is a raw JSON literal cstr (e.g. "1", "\"abc\"", "null").
fn progress_notification(request_id, update) {
    var pb = str_builder_new();
    str_builder_add_cstr(pb, "{\"progressToken\":");
    if (request_id == 0) { str_builder_add_cstr(pb, "null"); }
    else { str_builder_add_cstr(pb, request_id); }
    str_builder_add_cstr(pb, ",\"progress\":");
    str_builder_add_int(pb, progress_update_progress(update));
    if (progress_update_has_total(update) == 1) {
        str_builder_add_cstr(pb, ",\"total\":");
        str_builder_add_int(pb, progress_update_total(update));
    }
    var msg = progress_update_message(update);
    if (msg != 0) {
        str_builder_add_cstr(pb, ",\"message\":\"");
        _json_emit_escaped(pb, msg);
        str_builder_add_cstr(pb, "\"");
    }
    str_builder_add_cstr(pb, "}");
    return notification_wire("notifications/progress", str_data(str_builder_build(pb)));
}

# --- session.cyr ---

# bote::session — MCP session lifecycle (MCP 2025-11-25)
# Mirrors rust-old/src/session.rs

# ================================================================
# Header name constants
# ================================================================
fn mcp_protocol_version_header() { return "MCP-Protocol-Version"; }
fn mcp_session_id_header() { return "MCP-Session-Id"; }

# ================================================================
# validate_protocol_version(version_cstr) → 0 ok / err_msg cstr
# ================================================================
# ⚠ The supported-version list is NOT here — `_mcp_is_supported`
# (`src/dispatch.cyr`) is the one list, and this defers to it. Through
# 3.3.12 this function carried a second copy; both happened to name the
# same three versions, so the duplication was invisible until a fourth
# was needed. The effect of the drift is asymmetric and easy to miss: a
# version missing HERE is a hard 400 on the `MCP-Protocol-Version` header
# in every HTTP-family transport, while stdio — which never reads the
# header and negotiates through `_mcp_is_supported` — accepts it happily.
#
# dispatch.cyr precedes session.cyr in every compile unit that has both
# (all three binaries, `tests/bote*.tcyr`, `dist/bote.cyr`), and the
# transport-free `[lib.core]` profile carries dispatch without session,
# so the single-pass forward reference always resolves.
#
# bote_protocol_known adds the one revision `initialize` never negotiates, and
# allocates nothing, because a transport asks it about a client's header.
fn bote_protocol_known(v) {
    if (v == 0) { return 0; }
    if (_mcp_is_supported(v) == 1) { return 1; }
    return _mcp_is_modern(v);
}

fn validate_protocol_version(v) {
    if (v == 0) { return "unsupported MCP protocol version: (null)"; }
    if (bote_protocol_known(v) == 1) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "unsupported MCP protocol version: ");
    str_builder_add_cstr(sb, v);
    return str_data(str_builder_build(sb));
}

# ================================================================
# bote_origin_ok(origin_cstr, allowed_origins_vec) → 1 / 0
#
# What every HTTP-family transport asks before it does anything else. MCP:
# servers MUST validate Origin, and a present, invalid one gets 403. No Origin
# passes: a browser sends one on anything cross-origin, and a command-line
# client sends none. With no list every present Origin is refused, so a website
# cannot reach a server nobody configured for it. Allocates nothing, because it
# runs before auth.
# ================================================================
fn bote_origin_ok(origin, allowed_origins) {
    if (origin == 0) { return 1; }
    if (strlen(origin) == 0) { return 1; }
    if (allowed_origins == 0) { return 0; }
    var n = vec_len(allowed_origins);
    var i = 0;
    while (i < n) {
        var o = vec_get(allowed_origins, i);
        if (streq(o, "*") == 1 || streq(o, origin) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# bote_origin_self(origin_cstr, host_cstr, allowed_origins_vec) → 1 / 0
#
# 1 when `origin` is the server's own loopback address, the request's `Host` as a
# URL. With no list set that one Origin passes: it is a page on this very port, and
# a rebinding page's Origin carries the attacker's name, so it cannot be this. A
# list, once set, is the whole policy.
# ================================================================
fn _ses_loopback_len(host) {
    if (memeq(host, "localhost", 9) == 1) { return 9; }
    if (memeq(host, "127.0.0.1", 9) == 1) { return 9; }
    if (memeq(host, "[::1]", 5) == 1) { return 5; }
    return 0;
}

fn _ses_loopback(host) {
    var n = _ses_loopback_len(host);
    if (n == 0) { return 0; }
    if (load8(host + n) == 0 || load8(host + n) == 58) { return 1; }
    return 0;
}

fn bote_origin_self(origin, host, allowed_origins) {
    if (origin == 0 || host == 0) { return 0; }
    if (allowed_origins != 0 && vec_len(allowed_origins) > 0) { return 0; }
    if (strlen(host) < 5 || _ses_loopback(host) == 0) { return 0; }
    var n = strlen(origin);
    if (n > 7 && memeq(origin, "http://", 7) == 1) { return streq(origin + 7, host); }
    if (n > 8 && memeq(origin, "https://", 8) == 1) { return streq(origin + 8, host); }
    return 0;
}

# What a transport asks of a request's Origin. `Host` is read only for an Origin the
# list has already refused.
fn bote_http_origin_ok(origin, allowed_origins, buf, n) {
    if (bote_origin_ok(origin, allowed_origins) == 1) { return 1; }
    return bote_origin_self(origin, sandhi_server_find_header_a(bote_req_alloc(), buf, n, "Host"), allowed_origins);
}

# ================================================================
# validate_origin(origin_cstr, allowed_origins_vec) → 0 ok / err_msg cstr
# ================================================================
fn validate_origin(origin, allowed_origins) {
    if (bote_origin_ok(origin, allowed_origins) == 1) { return 0; }
    if (allowed_origins == 0) { return "no origins allowed (strict mode)"; }
    if (vec_len(allowed_origins) == 0) { return "no origins allowed (strict mode)"; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "origin not allowed: ");
    str_builder_add_cstr(sb, origin);
    return str_data(str_builder_build(sb));
}

# ================================================================
# Session ID generation — 32 hex chars from random_bytes() (16 bytes of
# kernel entropy via SYS_GETRANDOM; the /dev/urandom read this comment
# used to describe was replaced at 1.9.4 — see the note at _session_id).
# ================================================================

fn _hex_byte(b, out) {
    var hi = (b >> 4) & 15;
    var lo = b & 15;
    if (hi < 10) { store8(out, 48 + hi); } else { store8(out, 87 + hi); }
    if (lo < 10) { store8(out + 1, 48 + lo); } else { store8(out + 1, 87 + lo); }
    return 0;
}

# A test's stand-in for random_bytes, fn (buf, n) → bytes filled, or 0 for the kernel's.
var _bote_ses_random = 0;

fn _gen_session_id() {
    var raw = alloc(16);

    var out = alloc(33);
    # 3.2.0 (aarch64 portability): entropy comes from getrandom(2) via the
    # stdlib `random_bytes` wrapper. This replaces a raw
    # `syscall(SYS_OPEN, "/dev/urandom", 0, 0)` + read-loop + close.
    #
    # SYS_OPEN is defined ONLY in lib/syscalls_x86_64_linux.cyr — aarch64
    # Linux uses the generic syscall table, which has openat(2) and no
    # open(2) — so that reference was `undefined variable 'SYS_OPEN'` at
    # compile time on aarch64, breaking the cross-build for bote and for
    # every consumer vendoring dist/bote.cyr. SYS_GETRANDOM is defined on
    # both arches, so random_bytes is portable with no #ifdef fork.
    #
    # It is also the better primitive on its own merits (lib/random.cyr:3):
    # one syscall instead of three, blocks until the kernel CSPRNG is
    # seeded, and works where /dev/urandom is not reachable — early boot, a
    # chroot, or a landlocked process. random_bytes loops internally, so
    # the explicit short-read loop this replaces is now upstream's problem;
    # it returns the byte count filled, or -errno.
    #
    # 1.9.4 audit M2: a clock-based fallback was predictable. There is no
    # acceptable substitute for kernel entropy here — refuse to mint a
    # session ID rather than ship a guessable one. That fail-closed
    # contract is preserved exactly; only the source of the bytes changed.
    var got = 0;
    if (_bote_ses_random != 0) { got = fncall2(_bote_ses_random, raw, 16); }
    else { got = random_bytes(raw, 16); }
    if (got != 16) {
        # 3.4.0: through sakshi (was a raw eprint). The exit is unchanged.
        var ln[BOTE_LOG_LINE_BYTES];
        bote_log_line(&ln, SK_FATAL, "kernel CSPRNG unavailable for session id; exiting 90");
        bote_log_int(&ln, "rc", got);
        bote_log_emit(&ln);
        # The whole process (3.7.1). sys_exit ends the calling thread alone, and on a worker
        # that left the server up, the store's lock held by a thread that was gone.
        sys_exit_group(90);
    }
    var i = 0;
    while (i < 16) {
        _hex_byte(load8(raw + i), out + i * 2);
        i = i + 1;
    }
    store8(out + 32, 0);
    return out;
}

# ================================================================
# McpSession (40 bytes):
#   +0  session_id        cstr
#   +8  protocol_version  cstr
#   +16 created_at_ns     i64 (monotonic)
#   +24 last_active_ns    i64
#   +32 outbound          OPAQUE ptr or 0 — a per-session server→client
#                         notification bundle. session.cyr treats it as an
#                         opaque i64 and never dereferences or frees it: the
#                         buffer types (ResumptionBuffer / EventIdGenerator)
#                         live in transport_streamable.cyr, which comes
#                         after session.cyr in every include order (cyrius
#                         is single-pass) and which the HTTP transport,
#                         also a session user, does not need — so it must
#                         stay type-agnostic. The streamable
#                         transport lazily allocs the bundle (see
#                         _strm_session_outbound); it drops with the session.
# ================================================================
fn mcp_session_new(sid, protocol_version, now_ns) {
    var s = alloc(40);
    store64(s, sid);
    store64(s + 8, protocol_version);
    store64(s + 16, now_ns);
    store64(s + 24, now_ns);
    store64(s + 32, 0);
    return s;
}

fn mcp_session_id(s) { return load64(s); }
fn mcp_session_protocol_version(s) { return load64(s + 8); }
fn mcp_session_created_at(s) { return load64(s + 16); }
fn mcp_session_last_active(s) { return load64(s + 24); }
fn mcp_session_touch(s, now_ns) { store64(s + 24, now_ns); return 0; }
fn mcp_session_outbound(s) { return load64(s + 32); }
fn mcp_session_set_outbound(s, ptr) { store64(s + 32, ptr); return 0; }

# ================================================================
# SessionStore (32 bytes):
#   +0  sessions    hashmap: sid_cstr -> McpSession ptr
#   +8  ids         vec of sid_cstrs (insertion order — for prune iteration)
#   +16 timeout_ns  i64
#   +24 lock        a mutex (3.7.0): a threaded server's workers share the store. Every
#                   function below takes it; code that reads the map or the ids itself,
#                   or what a session points at, holds it with session_store_lock.
# ================================================================
fn session_store_new(timeout_ns) {
    var st = alloc(32);
    store64(st, map_new());
    store64(st + 8, vec_new());
    store64(st + 16, timeout_ns);
    store64(st + 24, mutex_new());
    return st;
}

fn session_store_lock(st)   { return mutex_lock(load64(st + 24)); }
fn session_store_unlock(st) { return mutex_unlock(load64(st + 24)); }

# Default: 1 hour timeout (3600 * 1e9 ns).
fn session_store_default() {
    return session_store_new(3600000000000);
}

fn session_store_sessions(st) { return load64(st); }
fn session_store_ids(st) { return load64(st + 8); }
fn session_store_timeout_ns(st) { return load64(st + 16); }

# Create a new session and return its ID (cstr).
# The most live sessions a store holds. Each costs a few KB for the life of the
# process, and `initialize` is the one request that needs no session, so a
# client looping on it must not be able to grow this without limit.
var BOTE_SESSION_MAX = 4096;

# Returns the new session id, or 0 when the store is full of live sessions.
fn session_store_create(st, protocol_version) {
    # The clock is read before the lock (3.7.1): a system call on most hosts, it need not
    # hold the other workers.
    var now = clock_now_ns();
    session_store_lock(st);
    if (vec_len(session_store_ids(st)) >= BOTE_SESSION_MAX) {
        _ses_prune(st, now);
        if (vec_len(session_store_ids(st)) >= BOTE_SESSION_MAX) {
            session_store_unlock(st);
            return 0;
        }
    }
    # Drawn only once there is room, so a full store keeps nothing for a refusal.
    var sid = _gen_session_id();
    var session = mcp_session_new(sid, protocol_version, now);
    map_set(session_store_sessions(st), sid, session);
    vec_push(session_store_ids(st), sid);
    session_store_unlock(st);
    return sid;
}

# Validate and touch a session. Returns the session ptr or 0 if unknown.
fn session_store_validate(st, sid) {
    var now = clock_now_ns();
    session_store_lock(st);
    var s = map_get(session_store_sessions(st), sid);
    if (s == 0) {
        session_store_unlock(st);
        return 0;
    }
    if (now - mcp_session_last_active(s) >= session_store_timeout_ns(st)) {
        _ses_prune(st, now);
        session_store_unlock(st);
        return 0;
    }
    mcp_session_touch(s, now);
    session_store_unlock(st);
    return s;
}

# Remove a session. Returns 1 if found, 0 if not.
fn session_store_remove(st, sid) {
    session_store_lock(st);
    if (map_has(session_store_sessions(st), sid) == 0) {
        session_store_unlock(st);
        return 0;
    }
    map_delete(session_store_sessions(st), sid);
    var ids = session_store_ids(st);
    var n = vec_len(ids);
    var i = 0;
    while (i < n) {
        if (streq(vec_get(ids, i), sid) == 1) {
            vec_remove(ids, i);
            i = n;
        }
        i = i + 1;
    }
    session_store_unlock(st);
    return 1;
}

# Number of active sessions.
fn session_store_active_count(st) {
    session_store_lock(st);
    var n = map_count(session_store_sessions(st));
    session_store_unlock(st);
    return n;
}

# Prune sessions inactive longer than timeout. Returns the number pruned.
fn session_store_prune_expired(st) {
    var now = clock_now_ns();
    session_store_lock(st);
    var n = _ses_prune(st, now);
    session_store_unlock(st);
    return n;
}

# session_store_prune_expired at `now`, with the lock held.
fn _ses_prune(st, now) {
    var timeout = session_store_timeout_ns(st);
    var sessions = session_store_sessions(st);
    var ids = session_store_ids(st);
    var pruned = 0;
    var i = 0;
    while (i < vec_len(ids)) {
        var sid = vec_get(ids, i);
        var s = map_get(sessions, sid);
        if (s == 0) {
            vec_remove(ids, i);
        } else {
            var age = now - mcp_session_last_active(s);
            if (age >= timeout) {
                map_delete(sessions, sid);
                vec_remove(ids, i);
                pruned = pruned + 1;
            } else {
                i = i + 1;
            }
        }
    }
    return pruned;
}

# --- discovery.cyr ---

# bote::discovery — cross-node tool announcements
# Mirrors rust-old/src/discovery.rs.
#
# The Rust version publishes announcements via majra pub/sub. Cyrius doesn't
# have a `lib/majra.cyr` port yet (will land with v0.2.0 events module), so
# this module ships the data layer + a callback-based announcement sink:
# callers register a function pointer that receives each announcement.
# When the events module lands, the publisher path becomes a one-line wire-up.

# ToolAnnouncement (16 bytes):
#   +0  node_id  cstr
#   +8  tools    vec of ToolDef ptrs
fn announcement_new(node_id, tools) {
    var a = alloc(16);
    store64(a, node_id);
    store64(a + 8, tools);
    return a;
}

fn announcement_node_id(a) { return load64(a); }
fn announcement_tools(a) { return load64(a + 8); }

# Serialize a ToolAnnouncement to JSON: {"node_id":"...","tools":[...]}
# Reuses dispatch's _emit_schema for each tool's inputSchema.
fn announcement_to_json(a) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"node_id\":\"");
    _json_emit_escaped(sb, announcement_node_id(a));
    str_builder_add_cstr(sb, "\",\"tools\":[");
    var tools = announcement_tools(a);
    if (tools != 0) {
        var n = vec_len(tools);
        var i = 0;
        while (i < n) {
            if (i > 0) { str_builder_add_cstr(sb, ","); }
            var t = vec_get(tools, i);
            str_builder_add_cstr(sb, "{");
            _json_emit_str_field(sb, "name", tool_def_name(t));
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "description", tool_def_description(t));
            str_builder_add_cstr(sb, ",\"inputSchema\":");
            _emit_schema(sb, tool_def_input_schema(t));
            var v = tool_def_version(t);
            if (v != 0) {
                str_builder_add_cstr(sb, ",");
                _json_emit_str_field(sb, "version", v);
            }
            var dep = tool_def_deprecated(t);
            if (dep != 0) {
                str_builder_add_cstr(sb, ",");
                _json_emit_str_field(sb, "deprecated", dep);
            }
            str_builder_add_cstr(sb, "}");
            i = i + 1;
        }
    }
    str_builder_add_cstr(sb, "]}");
    return str_data(str_builder_build(sb));
}

# DiscoveryService (24 bytes):
#   +0  node_id     cstr
#   +8  event_sink  EventSink ptr (or 0 — announcements then build-only)
#   +16 topic       cstr — TOPIC_TOOL_ANNOUNCE
#
# v1.0.0 used a bare publish_fp here; v1.1.0 unifies on EventSink so callers
# can plug in MajraEvents (v1.2.0) the same way they would for tool-call events.

fn discovery_topic_announce() { return TOPIC_TOOL_ANNOUNCE(); }

fn discovery_new(node_id, event_sink) {
    var d = alloc(24);
    store64(d, node_id);
    store64(d + 8, event_sink);
    store64(d + 16, discovery_topic_announce());
    return d;
}

fn discovery_node_id(d)    { return load64(d); }
fn discovery_event_sink(d) { return load64(d + 8); }
fn discovery_topic(d)      { return load64(d + 16); }

# Announce a vec of ToolDef ptrs. If no event_sink is configured, the
# announcement is built but not delivered (no-op). Returns the JSON string
# emitted (useful for tests + future SSE streams).
fn discovery_announce(d, tools) {
    var ann = announcement_new(discovery_node_id(d), tools);
    var json = announcement_to_json(ann);
    event_sink_publish(discovery_event_sink(d), discovery_topic(d), json);
    return json;
}

# DiscoveryReceiver — a vec-backed mailbox a test/consumer drains via try_recv.
# When events lands, this becomes a thin wrapper over a majra subscription.

fn discovery_receiver_new() {
    var r = alloc(8);
    store64(r, vec_new());
    return r;
}

fn discovery_receiver_queue(r) { return load64(r); }

# Push an announcement (JSON cstr) into the receiver's queue.
fn discovery_receiver_push(r, json) {
    vec_push(discovery_receiver_queue(r), json);
    return 0;
}

# Pop the next announcement JSON or 0 if empty.
fn discovery_receiver_try_recv(r) {
    var q = discovery_receiver_queue(r);
    if (vec_len(q) == 0) { return 0; }
    var head = vec_get(q, 0);
    vec_remove(q, 0);
    return head;
}

fn discovery_receiver_len(r) { return vec_len(discovery_receiver_queue(r)); }

# --- auth.cyr ---

# bote::auth — bearer-token middleware (RFC 6750).
#
# First slice of the roadmap `auth` item. OAuth 2.1 + PKCE follow in
# later releases; this one delivers the substrate they all sit on:
# extract `Authorization: Bearer <token>` from an HTTP request, hand
# the token to a caller-supplied validator function pointer, and emit
# a spec-compliant 401 if the token is missing or rejected.
#
# The middleware is **opt-in**: a transport config with no validator
# set behaves exactly as it did before this release. A config that
# does set one calls `auth_bearer_check` on every request and short-
# circuits with 401 when validation fails. Validator signature:
#
#     fn validator(token_cstr, ctx) → claims_ptr | 0
#
# A non-zero return is treated as success; the value is opaque to
# bote (today) — future releases will pass it down to handlers when
# request-scoped context lands. Returning 0 means "reject".
#
# MCP says a server MUST validate that a token was issued for it, and bote cannot do
# that for a validator it knows nothing about. auth_validator_jwt does, given an
# audience. Any other validator has to.
#
# Why fn pointer + ctx instead of a hardcoded scheme? Real deployments
# vary: static-list dev servers, JWT verifiers (HS256 / RS256), opaque
# tokens against a backend lookup, OAuth introspection. The shape lets
# each consumer drop in their own validator without bote knowing the
# crypto.

# ================================================================
# Authorization header → token cstr
# ================================================================

# Return a cstr on the request arena containing the token after "Bearer ",
# or 0 if the header is absent or doesn't start with "Bearer ".
# Per RFC 6750 §2.1, the scheme name is case-insensitive.
fn auth_bearer_extract(buf, blen) {
    var hdr = sandhi_server_find_header_a(bote_req_alloc(), buf, blen, "Authorization");
    if (hdr == 0) { return 0; }

    # Match "Bearer " (7 chars) case-insensitively at the start
    if (strlen(hdr) < 7) { return 0; }
    var b0 = load8(hdr);     if (b0 != 66 && b0 != 98)  { return 0; }   # B/b
    var b1 = load8(hdr + 1); if (b1 != 101 && b1 != 69) { return 0; }   # E/e
    var b2 = load8(hdr + 2); if (b2 != 97 && b2 != 65)  { return 0; }   # A/a
    var b3 = load8(hdr + 3); if (b3 != 114 && b3 != 82) { return 0; }   # R/r
    var b4 = load8(hdr + 4); if (b4 != 101 && b4 != 69) { return 0; }   # E/e
    var b5 = load8(hdr + 5); if (b5 != 114 && b5 != 82) { return 0; }   # R/r
    if (load8(hdr + 6) != 32) { return 0; }                              # space

    # Skip leading optional whitespace (some clients double-space)
    var start = 7;
    while (load8(hdr + start) == 32) { start = start + 1; }
    if (load8(hdr + start) == 0) { return 0; }   # empty token

    # Find end of header (NUL).
    var end = start;
    while (load8(hdr + end) != 0) { end = end + 1; }

    # Trim trailing OWS (space or tab). sandhi_server_find_header already stripped
    # the CR; this guards against a stray space the caller left.
    var done = 0;
    while (done == 0 && end > start) {
        var c = load8(hdr + end - 1);
        if (c == 32 || c == 9) { end = end - 1; }
        else { done = 1; }
    }

    var token_len = end - start;
    if (token_len <= 0) { return 0; }
    var out = alloc_via(bote_req_alloc(), token_len + 1);
    memcpy(out, hdr + start, token_len);
    store8(out + token_len, 0);
    return out;
}

# ================================================================
# Validators (built-in shapes — consumers provide their own)
# ================================================================

# Always-pass validator. Only useful for tests / disabling auth checks
# in dev. ctx is ignored.
fn auth_validator_allow_all(token, ctx) {
    if (token == 0) { return 0; }
    if (load8(token) == 0) { return 0; }
    return token;
}

# Static-allowlist validator. ctx is a vec of cstr tokens. Returns the
# token cstr (truthy) on match, 0 otherwise.
#
# Constant-time inner comparison: lengths are checked first (leaks token
# length, unavoidable), then bytes are XOR-accumulated with no early
# exit. Outer vec walk also doesn't early-exit on match — defeats both
# the per-byte timing oracle (byte-by-byte token guessing) AND the
# match-position oracle (which entry matched). Fix for the 1.9.4 audit's
# H2 finding.
#
# CT-compare and vec walk are inlined here to stay under cyrius 4.7.1's
# function-table headroom for src/main.cyr.
fn auth_validator_allowlist(token, allowed_vec) {
    if (token == 0 || allowed_vec == 0) { return 0; }
    var tlen = strlen(token);
    var n = vec_len(allowed_vec);
    var matched = 0;
    var i = 0;
    while (i < n) {
        var cand = vec_get(allowed_vec, i);
        if (cand != 0) {
            if (strlen(cand) == tlen) {
                var diff = 0;
                var j = 0;
                while (j < tlen) {
                    diff = diff | (load8(token + j) ^ load8(cand + j));
                    j = j + 1;
                }
                if (diff == 0) { matched = 1; }
            }
        }
        i = i + 1;
    }
    if (matched == 1) { return token; }
    return 0;
}

# ================================================================
# 401 response builder
# ================================================================

# Send a spec-compliant 401 with WWW-Authenticate. `realm` is what
# clients display in their auth prompt (e.g. "mcp" or your app name).
fn auth_send_unauthorized(cfd, realm) {
    var ra = bote_req_alloc();
    var sb = str_builder_new_a(ra);
    str_builder_add_cstr_a(ra, sb, "WWW-Authenticate: Bearer realm=\"");
    if (realm == 0) { str_builder_add_cstr_a(ra, sb, "mcp"); }
    else { str_builder_add_cstr_a(ra, sb, realm); }
    str_builder_add_cstr_a(ra, sb, "\"\r\n");
    var hdrs = str_data(str_builder_build_a(ra, sb));
    # sandhi_server_send_response builds: status line + Content-Type + Content-Length
    # + extra hdrs + blank line + body. We want a 401 with our header.
    sandhi_server_send_response_a(ra, cfd, HTTP_UNAUTHORIZED, "Unauthorized",
      "text/plain", "", 0, hdrs);
    return 0;
}

# A 401 with `params` after `Bearer`, or `realm="mcp"` when it is 0. RFC 6750 §3.1: a
# token that was refused gets an error code, and a request with none does not.
fn auth_send_challenge(cfd, params, refused) { return auth_send_challenge_hdr(cfd, params, refused, 0); }

# auth_send_challenge with `extra` response headers after the challenge, or 0.
fn auth_send_challenge_hdr(cfd, params, refused, extra) {
    var ra = bote_req_alloc();
    var sb = str_builder_new_a(ra);
    str_builder_add_cstr_a(ra, sb, "WWW-Authenticate: Bearer ");
    if (params == 0) { str_builder_add_cstr_a(ra, sb, "realm=\"mcp\""); }
    else { str_builder_add_cstr_a(ra, sb, params); }
    if (refused == 1) { str_builder_add_cstr_a(ra, sb, ", error=\"invalid_token\""); }
    str_builder_add_cstr_a(ra, sb, "\r\n");
    if (extra != 0) { str_builder_add_cstr_a(ra, sb, extra); }
    sandhi_server_send_response_a(ra, cfd, HTTP_UNAUTHORIZED, "Unauthorized",
      "text/plain", "", 0, str_data(str_builder_build_a(ra, sb)));
    return 0;
}

# A 403 for a token that lacks a scope (RFC 6750 §3.1, MCP's scope challenge): every
# scope in `scopes` is named, so a client asks once. `metadata` is the
# `resource_metadata` parameter or 0, and `extra` further response headers or 0. A
# scope that is no scope-token is left out, and `scope` with it when none is one:
# registration refuses those, but one set on a tool after it must not end the header.
fn auth_send_insufficient_scope(cfd, scopes, metadata, extra) {
    var ra = bote_req_alloc();
    var sb = str_builder_new_a(ra);
    str_builder_add_cstr_a(ra, sb, "WWW-Authenticate: Bearer error=\"insufficient_scope\"");
    var named = 0;
    var i = 0;
    while (i < vec_len(scopes)) {
        if (bote_scope_token_ok(vec_get(scopes, i)) == 1) {
            if (named == 0) { str_builder_add_cstr_a(ra, sb, ", scope=\""); }
            else { str_builder_add_cstr_a(ra, sb, " "); }
            str_builder_add_cstr_a(ra, sb, vec_get(scopes, i));
            named = named + 1;
        }
        i = i + 1;
    }
    if (named > 0) { str_builder_add_cstr_a(ra, sb, "\""); }
    if (metadata != 0) {
        str_builder_add_cstr_a(ra, sb, ", ");
        str_builder_add_cstr_a(ra, sb, metadata);
    }
    str_builder_add_cstr_a(ra, sb, "\r\n");
    if (extra != 0) { str_builder_add_cstr_a(ra, sb, extra); }
    sandhi_server_send_response_a(ra, cfd, HTTP_FORBIDDEN, "Forbidden",
      "text/plain", "", 0, str_data(str_builder_build_a(ra, sb)));
    return 0;
}

# ================================================================
# Middleware entry — call from each transport handler.
#
# Returns 0 on pass (no validator configured, or token validated).
# Returns HTTP_UNAUTHORIZED (401) on rejection — the response is
# already on the wire, caller should `return 0;` to its handler frame.
# ================================================================

fn _auth_log_rejected(reason) {
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_WARN, "request refused");
    bote_log_int(&ln, "status", HTTP_UNAUTHORIZED);
    bote_log_str(&ln, "reason", reason);
    bote_log_emit(&ln);
    return 0;
}

# Send an HTTP refusal and log it in one call (3.4.0). The HTTP-family
# transports refuse a request before dispatch for a dozen reasons, and each
# used to answer with a bare status and say nothing. `level` is SK_WARN for
# a security mitigation firing (403 origin, 413 oversized, a rejected
# Transfer-Encoding) and SK_DEBUG for an ordinary client mistake (404, 405,
# an unknown session, a protocol-version mismatch). Returns `status`.
fn bote_http_log_refusal(level, transport, status, reason) {
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, level, "request refused");
    bote_log_str(&ln, "transport", transport);
    bote_log_int(&ln, "status", status);
    bote_log_str(&ln, "reason", reason);
    bote_log_emit(&ln);
    return 0;
}

fn bote_http_refuse(cfd, level, transport, status, text, reason) {
    bote_http_log_refusal(level, transport, status, reason);
    sandhi_server_send_status_a(bote_req_alloc(), cfd, status, text);
    return status;
}

# bote_http_refuse with `extra` response headers, CRLF-terminated, or 0: the bridge's
# CORS, without which a page reads a refusal as a network error.
fn bote_http_refuse_hdr(cfd, level, transport, status, text, reason, extra) {
    if (extra == 0) { return bote_http_refuse(cfd, level, transport, status, text, reason); }
    bote_http_log_refusal(level, transport, status, reason);
    sandhi_server_send_response_a(bote_req_alloc(), cfd, status, text, "text/plain", "", 0, extra);
    return status;
}

# A 405. RFC 9110 15.5.6: it MUST name what the resource does allow, and `allow`
# is that header, CRLF included.
fn bote_http_refuse_method(cfd, transport, allow) {
    return bote_http_refuse_method_hdr(cfd, transport, allow, 0);
}

# bote_http_refuse_method with `extra` response headers ahead of `allow`, or 0.
fn bote_http_refuse_method_hdr(cfd, transport, allow, extra) {
    var a = bote_req_alloc();
    var hdrs = allow;
    if (extra != 0) {
        var sb = str_builder_new_a(a);
        str_builder_add_cstr_a(a, sb, extra);
        str_builder_add_cstr_a(a, sb, allow);
        hdrs = str_data(str_builder_build_a(a, sb));
    }
    bote_http_log_refusal(SK_DEBUG, transport, HTTP_METHOD_NOT_ALLOWED, "method");
    sandhi_server_send_response_a(a, cfd, HTTP_METHOD_NOT_ALLOWED, "Method Not Allowed",
      "text/plain", "", 0, hdrs);
    return HTTP_METHOD_NOT_ALLOWED;
}

fn auth_bearer_check(cfd, buf, blen, validator_fp, validator_ctx, claims_out) {
    if (validator_fp == 0) { return 0; }    # auth disabled
    var rc = auth_bearer_check_c(cfd, buf, blen, validator_fp, validator_ctx, claims_out, 0);
    if (rc == 0 && claims_out != 0) { store64(claims_out, bote_req_claims_kept(load64(claims_out))); }
    return rc;
}

# auth_bearer_check, with `challenge` after `Bearer` on a 401: bote_prm_challenge. For one
# message: claims that are the token stay on the arena until the dispatcher hands them
# to a handler, so a request refused after this keeps nothing. auth_bearer_check is for
# what holds claims across messages.
fn auth_bearer_check_c(cfd, buf, blen, validator_fp, validator_ctx, claims_out, challenge) {
    return auth_bearer_check_hdr(cfd, buf, blen, validator_fp, validator_ctx, claims_out, challenge, 0);
}

# auth_bearer_check_c with `extra` headers on the 401, or 0.
fn auth_bearer_check_hdr(cfd, buf, blen, validator_fp, validator_ctx, claims_out, challenge, extra) {
    if (validator_fp == 0) { return 0; }    # auth disabled

    # 3.4.0: each rejection is a WARN line naming why. The token is never
    # logged, valid or not.
    var token = auth_bearer_extract(buf, blen);
    if (token == 0) {
        _auth_log_rejected("missing_token");
        auth_send_challenge_hdr(cfd, challenge, 0, extra);
        return HTTP_UNAUTHORIZED;
    }
    var claims = fncall2(validator_fp, token, validator_ctx);
    if (claims == 0) {
        _auth_log_rejected("invalid_token");
        auth_send_challenge_hdr(cfd, challenge, 1, extra);
        return HTTP_UNAUTHORIZED;
    }
    # 2.5.0: surface validator's return so transport can thread to handler.
    if (claims == token) { bote_req_note_token(token); }
    if (claims_out != 0) { store64(claims_out, claims); }
    return 0;
}

# 1 when the request's head holds a NUL. RFC 9110 5.5: a recipient MUST refuse a field
# value holding one or replace it. bote reads a value up to its NUL, and the stdlib's
# WebSocket handshake to the end of its line, so the two would judge different bytes.
#
# The head ends at the first CRLF CRLF, or at `n` when there is none. One pass finds
# whichever of that and a NUL comes first, eight bytes at a time where a word holds
# neither a NUL nor a CR, as strlen reads: a third of what finding the end first and
# then scanning to it cost (3.6.5's CHANGELOG has the measure).
fn bote_http_head_nul(buf, n) {
    var lo = 0x0101010101010101;
    var hi = 0x8080808080808080;
    var cr = 0x0D0D0D0D0D0D0D0D;
    var i = 0;
    while (i < n) {
        var word = 0;
        if (i + 8 <= n) {
            var v = load64(buf + i);
            var c = v ^ cr;
            if (((((v - lo) & (v ^ 0xFFFFFFFFFFFFFFFF)) | ((c - lo) & (c ^ 0xFFFFFFFFFFFFFFFF))) & hi) == 0) { word = 1; }
        }
        if (word == 1) {
            i = i + 8;
        } else {
            var b = load8(buf + i);
            if (b == 0) { return 1; }
            if (b == 13 && i + 4 <= n && load8(buf + i + 1) == 10 && load8(buf + i + 2) == 13 && load8(buf + i + 3) == 10) { return 0; }
            i = i + 1;
        }
    }
    return 0;
}

# 1 when the request carries a Content-Length that is not a number. sandhi reads
# a malformed one as 0, the same as none, and a body would then be read to the
# end of the buffer on a length nobody declared.
fn bote_http_clen_bad(buf, n) {
    var v = sandhi_server_find_header_a(bote_req_alloc(), buf, n, "Content-Length");
    if (v == 0) { return 0; }
    if (load8(v) == 0) { return 1; }
    var i = 0;
    while (load8(v + i) != 0) {
        var c = load8(v + i);
        if (c < 48 || c > 57) { return 1; }
        i = i + 1;
    }
    return 0;
}

# HTTP request smuggling mitigation: each HTTP-family transport inlines
# `if (sandhi_server_find_header(buf, n, "Transfer-Encoding") != 0) { 400 + return }`
# right after its Origin check. We don't dechunk; rejecting any inbound
# Transfer-Encoding eliminates the CL.TE / TE.CL smuggling class
# (RFC 9112 §6). Inlined rather than helper'd to stay under cyrius
# 4.7.1's function-table headroom for the production main.cyr build.

# --- jwt.cyr ---

# bote::jwt — JWT access tokens, signed HS256, RS256 or ES256 (RFC 7519, RFC 7515, RFC 7518).
#
# Verifies `<base64url(header)>.<base64url(payload)>.<base64url(sig)>` tokens. Pairs
# with the bearer middleware (1.9.0): plug in `auth_validator_jwt` as the fn-pointer
# and a JwtSecret as the ctx. jwt_secret_new holds a shared key, for HS256, and
# jwt_secret_from_jwks holds an authorization server's public keys, for RS256 and ES256.
#
# Those two never mix, which is what makes algorithm confusion impossible here rather
# than unlikely. Each key is bound to one algorithm when it is loaded (RFC 8725 §3.1), a
# token's `alg` only selects among keys of that algorithm, and a public key is never
# handed to the HMAC. Nothing in a token picks a key but `kid`, among keys the operator
# gave: `jwk`, `jku`, `x5u` and `x5c` are not read.
#
# Validation performed — this list is enforced, not aspirational:
#   - exactly two `.` separators (3 segments), non-empty
#   - each segment is base64url as RFC 7515 §2 writes it: no padding and no spare bits.
#     So an HS256 or RS256 signature has one spelling, and a token's text can key a
#     revocation list. ES256 cannot promise that: (r, n - s) is a second valid signature
#     for any token, and JWS has no rule against it, so key on `jti` instead
#   - header decodes, its `alg` is EXACTLY a JSON string this ctx may use (a parsed
#     field read, byte-exact, case sensitive per RFC 7515 §4.1.1), and it has no `crit`,
#     which RFC 7515 §4.1.11 says to refuse unless every name in it is understood
#   - HMAC-SHA256 compared in constant time, or the key's public verify
#   - `exp`, if present, is strictly in the future, and `nbf`, if present, is
#     not (`clock_epoch_secs()`, RFC 7519 §4.1.4 and §4.1.5, no leeway), checked
#     only AFTER the signature verifies, so neither runs on attacker bytes, and again
#     each time a remembered token comes back
#
# A public-key verify is not cheap, and it runs ahead of everything a token could be
# judged by, so a forged token costs what a good one does: see the CHANGELOG for the
# measure, and put a rate limit ahead of a server that takes tokens from the internet.
# A token that passed is remembered, so a good one costs that once (see "Tokens already
# verified" below); a forged one is never remembered.
#
# auth_validator_jwt adds what makes this an MCP access-token check. MCP says a
# server MUST validate that a token was issued for it, so with an audience set on the
# JwtSecret, `aud` must name it, `exp` must be present, and `iss` must be one of the
# issuers if any are set. A token for another server is the confused deputy that
# rule exists to stop. Set no audience and a token that names one is refused, because
# RFC 7519 §4.1.3 says a recipient that cannot identify itself in `aud` must.
#
# A request's bytes go on the request arena, so a forged token leaves nothing behind.
#
# NOT validated: `sub`, `jti`, `client_id`, and RFC 9068's `typ`, which many
# authorization servers do not set: a token of another kind is stopped by `aud`.
# Returns 1 on valid, 0 on any failure. The validator returns the original token
# cstr, as opaque "claims" for handlers, and jwt_scope_check reads scopes from that.

# The shortest key RFC 7518 §3.2 allows HS256: the size of the hash output.
var BOTE_JWT_MIN_KEY = 32;

# What one public key may verify. A key has exactly one (RFC 8725 §3.1).
var BOTE_JWT_RS256 = 1;
var BOTE_JWT_ES256 = 2;

# An RSA modulus, in bytes: RFC 7518 §3.3 asks for 2048 bits, and sigil holds 4096.
var BOTE_JWT_RSA_MIN = 256;
var BOTE_JWT_RSA_MAX = 512;

# The largest JWKS file a binary will read.
var BOTE_JWKS_MAX = 1048576;

fn _jwt_b64u_val(c) {
    if (c >= 65 && c <= 90) { return c - 65; }
    if (c >= 97 && c <= 122) { return c - 71; }
    if (c >= 48 && c <= 57) { return c + 4; }
    if (c == 45) { return 62; }
    if (c == 95) { return 63; }
    return 0 - 1;
}

# The base64url text enc[0, elen) decoded onto `a`, NUL-terminated, its length in
# *out_len_p, or 0 when it is anything but what RFC 7515 §2 writes. Not bayan's decoder:
# that keeps its output on the heap, and a forged token is a client's bytes.
fn _jwt_b64u_a(a, enc, elen, out_len_p) {
    if (enc == 0 || elen <= 0 || elen % 4 == 1) { return 0; }
    var out = alloc_via(a, (elen / 4) * 3 + 4);
    var acc = 0;
    var bits = 0;
    var o = 0;
    var i = 0;
    while (i < elen) {
        var v = _jwt_b64u_val(load8(enc + i));
        if (v < 0) { return 0; }
        acc = ((acc << 6) | v) & 0xFFFFFF;
        bits = bits + 6;
        if (bits >= 8) {
            bits = bits - 8;
            store8(out + o, (acc >> bits) & 255);
            o = o + 1;
        }
        i = i + 1;
    }
    if ((acc & ((1 << bits) - 1)) != 0) { return 0; }
    store8(out + o, 0);
    store64(out_len_p, o);
    return out;
}

fn jwt_b64u_decode(enc, elen, out_len_p) {
    return _jwt_b64u_a(default_alloc(), enc, elen, out_len_p);
}

# HMAC-SHA256 — `sigil`'s `hmac_sha256(key, klen, msg, mlen, out)` is
# RFC 2104 with proper ipad/opad construction. We call it directly via
# the bundled `lib/sigil.cyr` rather than reimplementing.

# ================================================================
# JWT verify
# ================================================================

# Constant-time byte equality on n bytes.
fn _jwt_ct_eq(a, b, n) {
    var diff = 0;
    var i = 0;
    while (i < n) {
        diff = diff | (load8(a + i) ^ load8(b + i));
        i = i + 1;
    }
    if (diff == 0) { return 1; }
    return 0;
}

# Find next '.' in cstr starting at offset; return its offset or -1.
fn _jwt_dot(s, len, from) {
    var i = from;
    while (i < len) {
        if (load8(s + i) == 46) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# ================================================================
# Claim readers — (buf, len) based, deliberately NOT cstr based
# ================================================================
#
# These take an explicit length rather than a NUL-terminated cstr, and
# so use jsonx's `_jx_*` internals rather than its public
# `jsonx_get_str` / `jsonx_get_raw` entry points.
#
# That is a security choice, not a style one. Every public jsonx entry
# point begins with `strlen(obj_cstr)` (src/jsonx.cyr:126, :142, :160).
# The decoded JWT header and payload are attacker-controlled bytes; an
# embedded NUL byte would truncate the strlen view, hiding everything
# after it. For `alg` that is merely wrong; for `exp` it is
# **fail-open** — a hidden `exp` reads as "no exp claim" and the token
# is accepted forever. bayan's base64url decoder does NUL-terminate its
# output (lib/bayan.cyr), so the cstr path would compile and appear to
# work, which is exactly what makes the trap worth naming here.

# Read the JSON string field `key` out of the object in buf[0..len) and
# compare it byte-exactly to `want`.
#
# Returns 1 only on: key present, value is a properly terminated JSON
# string, and its contents equal `want` exactly. Everything else — key
# absent, value a number/bool/null/object/array, unterminated string,
# different length, different bytes — returns 0. Fail-closed.
fn _jwt_str_field_eq(buf, len, key, want) {
    var pos = _jx_find_value_pos(buf, len, key);
    if (pos == 0 - 1) { return 0; }
    if (pos >= len) { return 0; }
    if (load8(buf + pos) != 34) { return 0; }        # not a JSON string
    var end = _jx_skip_string(buf, len, pos);
    if (end <= pos + 1) { return 0; }
    # _jx_skip_string returns `len` when it runs off the end without
    # finding a closing quote. Requiring the byte before `end` to be a
    # quote separates "closed at the last byte" from "never closed", so
    # a truncated `{"alg":"HS256` cannot masquerade as a closed value.
    if (load8(buf + end - 1) != 34) { return 0; }
    var inner = end - pos - 2;                       # strip both quotes
    var wlen = strlen(want);
    if (inner != wlen) { return 0; }
    if (memeq(buf + pos + 1, want, wlen) == 1) { return 1; }
    return 0;
}

# 1 when the value at buf[pos] is a JSON string that decodes to exactly `want`, on `a`.
# Decoded, because an encoder may write `https:\/\/` and that is the same text. By
# length, because a decoded NUL must not make a shorter string look equal.
fn _jwt_str_is(a, buf, len, pos, want) {
    if (pos >= len || load8(buf + pos) != 34) { return 0; }
    var end = _jx_skip_string(buf, len, pos);
    if (end <= pos + 1 || load8(buf + end - 1) != 34) { return 0; }
    var n = end - pos - 2;
    var out = alloc_via(a, n + 1);
    var dn = _jx_unescape_into(buf + pos + 1, n, out);
    if (dn != strlen(want)) { return 0; }
    return memeq(out, want, dn);
}

# 1 when `aud` in payload names `want`: RFC 7519 §4.1.3 lets it be one string or an
# array of them. Anything else names nobody.
fn _jwt_aud_has(a, payload, plen, want) {
    var pos = _jx_find_value_pos(payload, plen, "aud");
    if (pos == 0 - 1) { return 0; }
    if (load8(payload + pos) != 91) { return _jwt_str_is(a, payload, plen, pos, want); }
    var i = _jx_skip_ws(payload, plen, pos + 1);
    while (i < plen && load8(payload + i) != 93) {
        if (_jwt_str_is(a, payload, plen, i, want) == 1) { return 1; }
        i = _jx_array_next(payload, plen, i);
    }
    return 0;
}

# 1 when `iss` in payload is one of `issuers`.
fn _jwt_iss_in(a, payload, plen, issuers) {
    var pos = _jx_find_value_pos(payload, plen, "iss");
    if (pos == 0 - 1) { return 0; }
    var i = 0;
    while (i < vec_len(issuers)) {
        if (_jwt_str_is(a, payload, plen, pos, vec_get(issuers, i)) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Parse an unsigned decimal integer from buf[from..end).
#
# Returns the value, or -1 on ANY of: an empty span, a non-digit byte
# anywhere in the span, or more digits than an i64 can hold. -1 is an
# unambiguous sentinel here because a NumericDate is never negative, so
# the caller never has to guess whether 0 meant "absent" or
# "unparseable" — a conflation that would be fail-open for `exp`.
#
# The digit cap is what makes overflow impossible rather than merely
# unlikely: 18 digits maxes at ~1e18, comfortably inside i64's ~9.22e18,
# so the accumulator cannot wrap. (An overflowing exp would wrap
# negative and read as long-expired — fail-closed, but by accident. We
# would rather reject it on purpose.) 18 digits is ~31 billion years of
# Unix time; no legitimate token comes close.
#
# Deliberately not `str_to_int` (lib/str.cyr): that one silently SKIPS
# non-digits and keeps accumulating, so it parses "1e9" as 19. Nor
# `atoi`, which needs a NUL-terminated cstr we do not have here.
fn _jwt_parse_uint(buf, from, end) {
    if (end <= from) { return 0 - 1; }
    if (end - from > 18) { return 0 - 1; }
    var v = 0;
    var i = from;
    while (i < end) {
        var c = load8(buf + i);
        if (c < 48 || c > 57) { return 0 - 1; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}

# What the time checks read. A test points this at a clock of its own, to put a token on
# either side of its `exp` and `nbf`; 0, the default, is the wall clock.
var _bote_jwt_clock = 0;

fn _jwt_now() {
    if (_bote_jwt_clock != 0) { return fncall0(_bote_jwt_clock); }
    return clock_epoch_secs();
}

# The NumericDate a time claim holds: -1 when the claim is absent, -2 when it is
# malformed.
#
# 3.2.0: the `exp` check is new code. The module header had claimed it since 2.2.0 and no
# such check existed: `jwt_verify_hs256` accepted a structurally valid, correctly
# signed, arbitrarily expired token. See
# docs/development/issues/archive/2026-07-30-jwt-module-is-orphaned-and-documents-an-exp-check-it-does-not-perform.md
#
# Absent is legal: RFC 7519 §4.1.4 and §4.1.5 make both claims optional. Present but no
# NumericDate is malformed, and must not be folded into absent. RFC 7519 §2 defines a
# NumericDate as a JSON *number*, so a quoted `"exp": "1785461260"`, a bool, null or a
# nested object is refused: treating it as absent is the fail-open direction, which would
# let a crafted claim buy unlimited lifetime. _jwt_parse_uint rejects all of those (a
# leading quote is byte 34, not a digit), and its -1 keeps that distinct from a real 0.
fn _jwt_time_claim(payload, plen, key) {
    var pos = _jx_find_value_pos(payload, plen, key);
    if (pos == 0 - 1) { return 0 - 1; }
    var v = _jwt_parse_uint(payload, pos, _jx_skip_value(payload, plen, pos));
    if (v == 0 - 1) { return 0 - 2; }
    return v;
}

# 1 when now is inside the window of a token whose `exp` and `nbf` are these, -1 for one
# that is absent. A token judged again later, from the cache, is judged here too.
#
# chrono documents 0 as "clock unknown" (e.g. an agnos RTC read mid-update), NOT the
# epoch: lib/chrono.cyr:50. Treating it as 0 would make every token look expired and lock
# every client out, so an unreadable clock skips the window, which is the established
# house behaviour: sigil's `_x509_in_window` does exactly this.
#
# RFC 7519 §4.1.4: "the current date/time MUST be before the expiration date/time listed
# in the exp claim", so now == exp is a reject. §4.1.5: the time MUST be after or equal
# to `nbf`, so now == nbf passes.
#
# No leeway. The RFC permits "some small leeway" for clock skew and bote does not take
# it: a resource server that silently honours a token past its stated expiry is doing
# something the operator cannot see in the logs, and the size of that grace would be an
# invisible security parameter. Consumers that need skew tolerance should fix their
# clocks or wrap this validator.
fn _jwt_window_ok(exp, nbf) { return _jwt_window_at(exp, nbf, 0 - 1); }

# _jwt_window_ok on a clock reading the caller already took, or -1 to take one here.
fn _jwt_window_at(exp, nbf, now) {
    # A clock read is a syscall, and a token with neither claim needs none.
    if (exp == 0 - 1 && nbf == 0 - 1) { return 1; }
    if (now == 0 - 1) { now = _jwt_now(); }
    if (now == 0) { return 1; }
    if (exp != 0 - 1 && exp <= now) { return 0; }
    if (nbf != 0 - 1 && now < nbf) { return 0; }
    return 1;
}

# ================================================================
# Public keys
# ================================================================
#
# JwtKey (40 bytes), built at load and read by every token:
#   +0  alg   BOTE_JWT_RS256 or BOTE_JWT_ES256
#   +8  kid   cstr or 0
#   +16 pub   the modulus, big-endian, or Qx || Qy
#   +24 len   its length
#   +32 exp   RSA's public exponent, big-endian, 3 bytes

fn _jwt_key_alg(k) { return load64(k); }
fn _jwt_key_kid(k) { return load64(k + 8); }
fn _jwt_key_pub(k) { return load64(k + 16); }
fn _jwt_key_len(k) { return load64(k + 24); }
fn _jwt_key_exp(k) { return load64(k + 32); }

# A key's parts on `a`: a set is read on the request arena, and only the keys it holds
# are kept, by _jwt_key_keep, once they are known to differ from the ones in use.
fn _jwt_key_new_a(a, alg, kid, material, len, exp) {
    var k = alloc_via(a, 40);
    store64(k, alg);
    store64(k + 8, kid);
    store64(k + 16, material);
    store64(k + 24, len);
    store64(k + 32, exp);
    return k;
}

# A copy of the key `k` on the heap, its parts with it: it outlives the message.
fn _jwt_key_keep(k) {
    var len = _jwt_key_len(k);
    var material = alloc(len);
    memcpy(material, _jwt_key_pub(k), len);
    var e = 0;
    if (_jwt_key_exp(k) != 0) {
        e = alloc(3);
        memcpy(e, _jwt_key_exp(k), 3);
    }
    var kid = 0;
    if (_jwt_key_kid(k) != 0) {
        var kl = strlen(_jwt_key_kid(k));
        kid = alloc(kl + 1);
        memcpy(kid, _jwt_key_kid(k), kl + 1);
    }
    return _jwt_key_new_a(default_alloc(), _jwt_key_alg(k), kid, material, len, e);
}

# 1 when the keys `k` and `j` verify the same tokens: the same algorithm, kid and
# material. A kid that differs is another key, because it decides which tokens pick it.
# Every RSA key holds e = 65537 (_jwk_rsa_key_a), so the exponent decides nothing here, and
# the length decides the algorithm: a modulus is 256 to 512 bytes, a P-256 key 64.
fn _jwt_key_same(k, j) {
    if (_jwt_key_len(k) != _jwt_key_len(j)) { return 0; }
    if (memeq(_jwt_key_pub(k), _jwt_key_pub(j), _jwt_key_len(k)) == 0) { return 0; }
    var kk = _jwt_key_kid(k);
    var jk = _jwt_key_kid(j);
    if ((kk == 0 && jk != 0) || (kk != 0 && jk == 0)) { return 0; }
    if (kk != 0 && streq(kk, jk) == 0) { return 0; }
    return 1;
}

# 1 when every key of `keys` is in `others`.
fn _jwt_keys_in(keys, others) {
    var i = 0;
    while (i < vec_len(keys)) {
        var found = 0;
        var j = 0;
        while (j < vec_len(others) && found == 0) {
            if (_jwt_key_same(vec_get(keys, i), vec_get(others, j)) == 1) { found = 1; }
            j = j + 1;
        }
        if (found == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# 1 when the two vecs hold the same keys, in any order (3.7.0): they verify the same tokens.
# Compared in order, a server that serves its set in another order each time made every
# fetch a change, each one a heap copy of the keys kept for good and an emptied cache.
fn _jwt_keys_same(old, fresh) {
    if (old == 0) { return 0; }
    if (_jwt_keys_in(old, fresh) == 0) { return 0; }
    return _jwt_keys_in(fresh, old);
}

# The base64url member `name` of `jwk`, decoded on `a`, or 0.
fn _jwk_bytes_a(a, jwk, name, len_out) {
    var v = jsonx_get_str_dec_a(a, jwk, name);
    if (v == 0) { return 0; }
    return _jwt_b64u_a(a, v, strlen(v), len_out);
}

# 1 when `jwk` holds what must never be in a file of public keys: a private exponent or
# prime, or a shared secret. Refused outright: the file is in the wrong hands.
fn _jwk_is_private(jwk) {
    if (jsonx_has(jwk, "d") == 1 || jsonx_has(jwk, "p") == 1 || jsonx_has(jwk, "q") == 1) { return 1; }
    if (jsonx_has(jwk, "k") == 1) { return 1; }
    return 0;
}

# An RSA modulus and exponent bote will use: 2048 bits at the least, minimal, odd, and
# e = 65537. A small `e` is what signature forgeries against lax verifiers need, and
# nothing issues one.
fn _jwk_rsa_key_a(a, jwk, kid) {
    var nl[8];
    var el[8];
    var n = _jwk_bytes_a(a, jwk, "n", &nl);
    var e = _jwk_bytes_a(a, jwk, "e", &el);
    if (n == 0 || e == 0) { return 0; }
    var len = load64(&nl);
    if (len < BOTE_JWT_RSA_MIN || len > BOTE_JWT_RSA_MAX) { return 0; }
    if (load8(n) < 128 && (len == BOTE_JWT_RSA_MIN || load8(n) == 0)) { return 0; }
    if ((load8(n + len - 1) & 1) == 0) { return 0; }
    if (load64(&el) != 3 || load8(e) != 1 || load8(e + 1) != 0 || load8(e + 2) != 1) { return 0; }
    return _jwt_key_new_a(a, BOTE_JWT_RS256, kid, n, len, e);
}

# 1 when the 64 bytes Qx || Qy are a point on P-256. sigil asks on every verify too, and
# this says so once, at startup, and not as every token failing.
# sigil's curve check makes what it needs itself. This called _ecv_init too, the verify's
# tables, which outside a scope of sigil's takes one of its crypto lanes for the rest of the
# calling thread's life (sigil 3.13.14): the main thread loading keys at startup kept a lane
# no worker could have, and a worker that refreshed the keys and exited kept one for good
# (3.7.2). The verify's tables are _jwt_p256_warm's.
fn _jwt_on_curve(q) {
    var x[32];
    var y[32];
    u256_load_be(&x, q);
    u256_load_be(&y, q + 32);
    return pt_is_on_curve(&x, &y);
}

# sigil's P-256 tables, built on the thread that takes the first EC key (3.7.1): a fetch
# forked while another thread builds one would leave the child waiting on its claim. Once
# for the process: each build is a sign and a verify, 13 ms, and it ran for every EC key of
# every set that changed (3.7.2). sigil's sign and verify open their own lane scopes.
var _jwt_p256_warmed = 0;
var _jwt_p256_warm_fp = &ecdsa_p256_warm;   # what builds them; a test counts the builds

fn _jwt_p256_warm() {
    if (atomic_load(&_jwt_p256_warmed) == 1) { return 0; }
    fncall0(_jwt_p256_warm_fp);
    atomic_store(&_jwt_p256_warmed, 1);
    return 0;
}

fn _jwk_ec_key_a(a, jwk, kid) {
    var crv = jsonx_get_str_dec_a(a, jwk, "crv");
    if (crv == 0 || streq(crv, "P-256") == 0) { return 0; }
    var xl[8];
    var yl[8];
    var x = _jwk_bytes_a(a, jwk, "x", &xl);
    var y = _jwk_bytes_a(a, jwk, "y", &yl);
    if (x == 0 || y == 0 || load64(&xl) != 32 || load64(&yl) != 32) { return 0; }
    var q = alloc_via(a, 64);
    memcpy(q, x, 32);
    memcpy(q + 32, y, 32);
    if (_jwt_on_curve(q) == 0) { return 0; }
    return _jwt_key_new_a(a, BOTE_JWT_ES256, kid, q, 64, 0);
}

# The JwtKey `jwk` makes, on `a`, or 0 when bote cannot use it: a real set also holds keys
# for encryption and for algorithms bote does not verify, and those are not an error.
fn _jwk_key_a(a, jwk) {
    var usage = jsonx_get_str_dec_a(a, jwk, "use");
    if (usage != 0 && streq(usage, "sig") == 0) { return 0; }
    var kty = jsonx_get_str_dec_a(a, jwk, "kty");
    if (kty == 0) { return 0; }
    var alg = jsonx_get_str_dec_a(a, jwk, "alg");
    var kid = jsonx_get_str_dec_a(a, jwk, "kid");
    if (streq(kty, "RSA") == 1 && (alg == 0 || streq(alg, "RS256") == 1)) { return _jwk_rsa_key_a(a, jwk, kid); }
    if (streq(kty, "EC") == 1 && (alg == 0 || streq(alg, "ES256") == 1)) { return _jwk_ec_key_a(a, jwk, kid); }
    return 0;
}

# 1 when `json` is valid JSON and its `keys` member an array. The elements then, on `a`.
fn _jwks_elements_a(a, json) {
    if (json == 0 || jsonx_valid(json, strlen(json)) == 0 || jsonx_is_object(json) == 0) { return 0; }
    var keys = jsonx_get_raw_a(a, json, "keys");
    if (keys == 0 || load8(keys) != 91) { return 0; }
    var out = vec_new_a(a);
    var len = strlen(keys);
    var i = _jx_skip_ws(keys, len, 1);
    while (i < len && load8(keys + i) != 93) {
        vec_push_a(a, out, _jx_raw_at_a(a, keys, len, i));
        i = _jx_array_next(keys, len, i);
    }
    return out;
}

# Why a JWK Set cannot be loaded, as a message, or 0 when it can. Public, so a caller can
# say why before it builds one. Read on the request arena: it keeps nothing.
fn jwt_jwks_check(json) {
    var a = bote_req_alloc();
    var elems = _jwks_elements_a(a, json);
    if (elems == 0) { return "a JWK Set is a JSON object with a `keys` array"; }
    var kids = vec_new_a(a);
    var usable = 0;
    var i = 0;
    while (i < vec_len(elems)) {
        var jwk = vec_get(elems, i);
        if (_jwk_is_private(jwk) == 1) { return "a JWK Set must hold public keys only, and this one holds a private key"; }
        var k = _jwk_key_a(a, jwk);
        if (k != 0) {
            usable = usable + 1;
            if (_jwt_key_kid(k) != 0) {
                var j = 0;
                while (j < vec_len(kids)) {
                    if (streq(vec_get(kids, j), _jwt_key_kid(k)) == 1) { return "two keys in a JWK Set share a kid"; }
                    j = j + 1;
                }
                vec_push_a(a, kids, _jwt_key_kid(k));
            }
        }
        i = i + 1;
    }
    if (usable == 0) { return "a JWK Set holds no key bote can use: RS256 of 2048 to 4096 bits with e = 65537, or ES256 on P-256"; }
    return 0;
}

# The key a token's header names, or 0. Its `kid` picks one. With no `kid` there must be
# exactly one key of its `alg`: trying each in turn would hand a forged token one
# expensive verify per key.
fn _jwt_key_pick(a, header, hlen, keys) {
    var alg = 0;
    if (_jwt_str_field_eq(header, hlen, "alg", "RS256") == 1) { alg = BOTE_JWT_RS256; }
    elif (_jwt_str_field_eq(header, hlen, "alg", "ES256") == 1) { alg = BOTE_JWT_ES256; }
    if (alg == 0) { return 0; }
    var pos = _jx_find_value_pos(header, hlen, "kid");
    var found = 0;
    var i = 0;
    while (i < vec_len(keys)) {
        var k = vec_get(keys, i);
        if (_jwt_key_alg(k) == alg) {
            if (pos == 0 - 1) {
                if (found != 0) { return 0; }
                found = k;
            } elif (_jwt_key_kid(k) != 0 && _jwt_str_is(a, header, hlen, pos, _jwt_key_kid(k)) == 1) {
                return k;
            }
        }
        i = i + 1;
    }
    return found;
}

# 1 when the signature of `token` verifies under the public key `k`. Each signature is
# exactly its key's length, so sigil never sees a bad one.
fn _jwt_pk_ok(a, token, dot2, tlen, k) {
    var sl[8];
    var sig = _jwt_b64u_a(a, token + dot2 + 1, tlen - dot2 - 1, &sl);
    if (sig == 0) { return 0; }
    if (_jwt_key_alg(k) == BOTE_JWT_ES256) {
        if (load64(&sl) != 64) { return 0; }
        return ecdsa_p256_verify(_jwt_key_pub(k), token, dot2, sig);
    }
    if (load64(&sl) != _jwt_key_len(k)) { return 0; }
    return rsa_pkcs1v15_verify_sha256(_jwt_key_pub(k), _jwt_key_len(k), _jwt_key_exp(k), 3, token, dot2, sig, _jwt_key_len(k));
}

# 1 when the HS256 signature of `token` verifies under the shared key.
fn _jwt_hs_ok(a, token, dot2, tlen, key, key_len) {
    # Compute HMAC-SHA256 over `header_b64u . payload_b64u`.
    var expected[32];
    hmac_sha256(key, key_len, token, dot2, &expected);

    # Decode the signature segment. _jwt_b64u_a takes one spelling, so comparing
    # the bytes compares the text.
    var slen_slot[8]; store64(&slen_slot, 0);
    var actual = _jwt_b64u_a(a, token + dot2 + 1, tlen - dot2 - 1, &slen_slot);
    if (actual == 0) { return 0; }
    if (load64(&slen_slot) != 32) { return 0; }
    return _jwt_ct_eq(&expected, actual, 32);
}

# The verified payload of `token` on `a`, its length in *plen_out, or 0. `s` is a JwtSecret.
fn _jwt_payload_a(a, token, s, plen_out) {
    var keys = jwt_secret_keys(s);
    var key = jwt_secret_data(s);
    var key_len = jwt_secret_len(s);
    if (token == 0) { return 0; }
    if (keys == 0 && (key == 0 || key_len <= 0)) { return 0; }
    var tlen = strlen(token);
    if (tlen < 16) { return 0; }   # impossibly short

    var dot1 = _jwt_dot(token, tlen, 0);
    if (dot1 <= 0) { return 0; }
    var dot2 = _jwt_dot(token, tlen, dot1 + 1);
    if (dot2 <= dot1 + 1 || dot2 >= tlen - 1) { return 0; }

    # Header check: decode and require `alg` to be EXACTLY what this ctx verifies.
    #
    # 3.2.0: this was a naive substring scan for the five bytes "HS256"
    # anywhere in the decoded header. That is satisfied by
    # `{"alg":"none","kid":"HS256-2024"}` — the literal occurs inside
    # the `kid` VALUE, so the downgrade guard the scan existed to
    # provide did not hold. It now reads `alg` as a parsed JSON field
    # and compares byte-exactly.
    #
    # This runs BEFORE the signature, on unverified bytes, and that is
    # deliberate: it is the algorithm-downgrade guard, so it has to
    # gate what the signature step will even attempt. It is also cheap
    # and total — no allocation, no recursion beyond jsonx's own
    # depth-capped skip.
    var hlen_slot[8]; store64(&hlen_slot, 0);
    var header = _jwt_b64u_a(a, token, dot1, &hlen_slot);
    if (header == 0) { return 0; }
    var hlen = load64(&hlen_slot);
    if (_jx_find_value_pos(header, hlen, "crit") != 0 - 1) { return 0; }
    if (keys != 0) {
        var k = _jwt_key_pick(a, header, hlen, keys);
        # A key the set does not hold may be one the authorization server has just
        # published: ask its key source, as often as the cooldown allows, and pick again.
        if (k == 0 && _jwt_refetch_for_kid(s, header, hlen) == 1) {
            k = _jwt_key_pick(a, header, hlen, jwt_secret_keys(s));
        }
        if (k == 0) { return 0; }
        if (_jwt_pk_ok(a, token, dot2, tlen, k) == 0) { return 0; }
    } else {
        if (_jwt_str_field_eq(header, hlen, "alg", "HS256") == 0) { return 0; }
        if (_jwt_hs_ok(a, token, dot2, tlen, key, key_len) == 0) { return 0; }
    }

    # ---- everything below here runs on VERIFIED bytes only ----
    #
    # Ordering is load-bearing. Before 3.2.0 the ct-compare above was
    # the function's terminal statement, so any claim check bolted on
    # ahead of it would have been parsing attacker-controlled input
    # that had not been authenticated yet. The signature gates the
    # claims, never the reverse.
    #
    # A signed token whose payload is not valid base64url is malformed.
    # The signature covers the encoded text, so this is reachable — and
    # it is a reject, not a pass.
    var payload = _jwt_b64u_a(a, token + dot1 + 1, dot2 - dot1 - 1, plen_out);
    if (payload == 0) { return 0; }
    var exp = _jwt_time_claim(payload, load64(plen_out), "exp");
    var nbf = _jwt_time_claim(payload, load64(plen_out), "nbf");
    if (exp == 0 - 2 || nbf == 0 - 2) { return 0; }
    if (_jwt_window_ok(exp, nbf) == 0) { return 0; }
    return payload;
}

# Verify an HS256 JWT. Returns 1 on valid, 0 otherwise.
fn jwt_verify_hs256(token, key, key_len) {
    var s[136];    # BOTE_JWT_SECRET_BYTES
    memset(&s, 0, 136);
    store64(&s, key);
    store64(&s + 8, key_len);
    var plen[8];
    if (_jwt_payload_a(bote_req_alloc(), token, &s, &plen) == 0) { return 0; }
    return 1;
}

# ================================================================
# Tokens already verified
# ================================================================
#
# A public-key verify is the slowest thing a request does, so a token that passes is
# remembered: by the SHA-256 of all of its text, which is all the signature covered, with
# its `exp` and `nbf`. Everything else the check decides, the signature, the key, `alg`,
# `crit`, `aud` and `iss`, depends on that text and this JwtSecret alone, so a token seen
# again is judged on the clock alone, by _jwt_window_ok, as it would be in full. A token
# that fails is never stored, so a forged one costs what it did, plus its hash.
#
# Direct-mapped: a slot is picked by the low bits of the digest, and a token that lands
# on a taken slot replaces it. Only a token that verified is stored, so a client can aim
# at a slot only with tokens the authorization server issued it, and what that costs
# another token is one verify more. The table is allocated when the first token is stored
# and never grows. A slot (48 B): +0 digest, +32 exp, +40 nbf, -1 for either when
# absent. An empty slot is zero, and no token's digest is.
#
# On worker threads (3.7.0) the table is read and written under the handle's mutex, taken
# only once threads are running. Each clear moves the handle's generation on, and a token
# is stored only if the generation is the one it read before it was verified: a token a
# worker verified with keys a refresh has since replaced is not remembered past them.

var BOTE_JWT_CACHE_DEFAULT = 1024;
var BOTE_JWT_CACHE_MAX = 65536;
var BOTE_JWT_SLOT_BYTES = 48;

# Remember up to `slots` tokens, rounded up to a power of two and at most
# BOTE_JWT_CACHE_MAX, or none for 0. What was remembered is forgotten. Set it when the
# handle is configured: a table this replaces is not reclaimed.
fn jwt_secret_with_cache(s, slots) {
    var n = 0;
    if (slots > 0) {
        n = 1;
        while (n < slots && n < BOTE_JWT_CACHE_MAX) { n = n * 2; }
    }
    _jwt_lock(s);
    store64(s + 40, n);
    store64(s + 48, 0);
    store64(s + 128, load64(s + 128) + 1);
    _jwt_unlock(s);
    return s;
}

fn _jwt_lock(s) {
    if (_threads_active != 0 && load64(s + 120) != 0) { mutex_lock(load64(s + 120)); }
    return 0;
}

fn _jwt_unlock(s) {
    if (_threads_active != 0 && load64(s + 120) != 0) { mutex_unlock(load64(s + 120)); }
    return 0;
}

# Forget every token judged before, with the lock held.
fn _jwt_cache_clear_held(s) {
    var t = load64(s + 48);
    if (t != 0) { memset(t, 0, load64(s + 40) * BOTE_JWT_SLOT_BYTES); }
    store64(s + 128, load64(s + 128) + 1);
    return 0;
}

fn _jwt_cache_clear(s) {
    _jwt_lock(s);
    _jwt_cache_clear_held(s);
    _jwt_unlock(s);
    return 0;
}

fn _jwt_cache_slot(s, digest) {
    return load64(s + 48) + (load64(digest) & (load64(s + 40) - 1)) * BOTE_JWT_SLOT_BYTES;
}

# A token is remembered only when there is room: with none, it is verified again next time.
fn _jwt_cache_put(s, digest, payload, plen) {
    if (load64(s + 48) == 0) {
        var t = alloc(load64(s + 40) * BOTE_JWT_SLOT_BYTES);
        if (t == 0) { return 0; }
        store64(s + 48, t);
    }
    var e = _jwt_cache_slot(s, digest);
    memcpy(e, digest, 32);
    store64(e + 32, _jwt_time_claim(payload, plen, "exp"));
    store64(e + 40, _jwt_time_claim(payload, plen, "nbf"));
    return 0;
}

# The slot holding `digest`, or 0.
fn _jwt_cache_find(s, digest) {
    if (load64(s + 48) == 0) { return 0; }
    var e = _jwt_cache_slot(s, digest);
    if (_jwt_ct_eq(e, digest, 32) == 0) { return 0; }
    return e;
}

# ================================================================
# Keys from a source (3.6.6)
# ================================================================
#
# An authorization server publishes its keys at its `jwks_uri` and rotates them there. A
# handle with a key source asks it for the set: when it is first configured
# (jwt_secret_refresh), when the keys it holds are `every` seconds old, and when a token
# names a key it does not hold, the moment a new one comes into use. Never more often than
# the cooldown, BOTE_JWKS_COOLDOWN or `every` if that is shorter, so a client sending kids
# no server issued gets one fetch a cooldown. A source that fails is asked again after the
# cooldown, then twice that, up to `every`, and meanwhile the keys it gave last are used:
# an authorization server that is down does not take the resource server with it. A clock
# that goes back opens the gate; an unknown one (0) asks nothing on a timer.
#
# A source is fn (ctx, why_out) → the set's text, or 0 with a reason written through
# why_out. bote_jwks_fetch (src/jwks.cyr) fetches a jwks_uri; a test gives a fake.

var BOTE_JWKS_REFRESH_DEFAULT = 600;
var BOTE_JWKS_COOLDOWN = 60;

# Refresh `s` from the source `fp` with `ctx`, every `every` seconds, or 600 for 0 or less.
# It holds no keys until jwt_secret_refresh first succeeds. Returns `s`.
fn jwt_secret_with_key_source(s, fp, ctx, every) {
    if (every <= 0) { every = BOTE_JWKS_REFRESH_DEFAULT; }
    store64(s + 72, fp);
    store64(s + 80, ctx);
    store64(s + 88, every);
    store64(s + 96, 0);
    store64(s + 104, 0);
    store64(s + 112, 0);
    return s;
}

fn jwt_secret_key_source(s) { return load64(s + 72); }
fn jwt_secret_refresh_every(s) { return load64(s + 88); }
fn jwt_secret_fetched_at(s) { return load64(s + 96); }
fn jwt_secret_fetch_failures(s) { return load64(s + 112); }

fn _jwt_cooldown(s) {
    var every = load64(s + 88);
    if (every < BOTE_JWKS_COOLDOWN) { return every; }
    return BOTE_JWKS_COOLDOWN;
}

# How long after the last ask the next may come: the cooldown, and after failures twice
# that for each one past the first, up to `every`.
fn _jwt_backoff(s) {
    var b = _jwt_cooldown(s);
    var every = load64(s + 88);
    var f = load64(s + 112);
    var i = 1;
    while (i < f && b < every) {
        b = b * 2;
        i = i + 1;
    }
    if (b > every && every > _jwt_cooldown(s)) { b = every; }
    return b;
}

# 1 when the source may be asked at `now`, last asked at `tried`. A clock that went back
# opens the gate, but not one that went back by less than the cooldown (3.7.1): that is a
# worker that read the clock a second before another took the ask, and so would take it
# again.
fn _jwt_gate_at(s, tried, now) {
    if (tried == 0) { return 1; }
    if (now < tried) {
        if (tried - now > _jwt_cooldown(s)) { return 1; }
        return 0;
    }
    if (now - tried >= _jwt_backoff(s)) { return 1; }
    return 0;
}

fn _jwt_gate_open(s, now) { return _jwt_gate_at(s, load64(s + 104), now); }

# 1 for the one caller that takes the ask at `now` (3.7.0). The gate is judged on the
# `tried` it read, and a compare-and-swap moves that to `now`, so workers that find the
# keys due together make one fetch between them, and the others go on with the keys held.
fn _jwt_take(s, now) {
    var tried = load64(s + 104);
    if (_jwt_gate_at(s, tried, now) == 0) { return 0; }
    return atomic_cas(s + 104, tried, now);
}

# 1 when the keys are due a refresh at `now`: old, or never fetched, and the gate open. For
# a handle with a source; an unknown clock is never due.
fn _jwt_refresh_due(s, now) {
    if (now == 0) { return 0; }
    if (_jwt_gate_open(s, now) == 0) { return 0; }
    var fetched = load64(s + 96);
    if (fetched == 0 || now < fetched) { return 1; }
    if (now - fetched >= load64(s + 88)) { return 1; }
    return 0;
}

# Ask the source now, at `now`: 0 when its set was taken, or why not. Says so in the log:
# INFO for a set that changed, DEBUG for one that did not, WARN for a failure, which keeps
# the keys it had. Neither a key nor the set is logged.
fn _jwt_refresh_at(s, now) {
    store64(s + 104, now);
    return _jwt_ask(s, now);
}

# _jwt_refresh_at, its ask already taken.
fn _jwt_ask(s, now) {
    var why[8];
    store64(&why, 0);
    var body = fncall2(load64(s + 72), load64(s + 80), &why);
    var reason = load64(&why);
    if (body == 0 && reason == 0) { reason = "the key source gave nothing"; }
    var changed[8];
    store64(&changed, 0);
    if (body != 0) { reason = _jwt_set_jwks(s, body, &changed); }
    if (reason != 0) {
        store64(s + 112, load64(s + 112) + 1);
        var wl[BOTE_LOG_LINE_BYTES];
        bote_log_line(&wl, SK_WARN, "jwks refresh failed; keeping the keys it has");
        bote_log_str(&wl, "reason", reason);
        bote_log_int(&wl, "failures", load64(s + 112));
        bote_log_int(&wl, "retry_s", _jwt_backoff(s));
        bote_log_emit(&wl);
        return reason;
    }
    store64(s + 96, now);
    store64(s + 112, 0);
    var kl[BOTE_LOG_LINE_BYTES];
    if (load64(&changed) == 1) {
        bote_log_line(&kl, SK_INFO, "jwks keys changed");
    } else {
        bote_log_line(&kl, SK_DEBUG, "jwks keys unchanged");
    }
    bote_log_int(&kl, "keys", vec_len(jwt_secret_keys(s)));
    bote_log_emit(&kl);
    return 0;
}

# Ask the source now, whatever the gate: 0 when its set was taken, or why not. What a
# binary calls at startup, and an embedder on a schedule of its own.
fn jwt_secret_refresh(s) {
    if (load64(s + 72) == 0) { return "the handle has no key source"; }
    return _jwt_refresh_at(s, _jwt_now());
}

# A token's header named an RS256 or ES256 key the set does not hold: ask the source, when
# the gate allows. 1 when it gave a set, which is then worth a second pick.
fn _jwt_refetch_for_kid(s, header, hlen) {
    if (load64(s + 72) == 0) { return 0; }
    # On agnos a fetch runs in this process (src/fetch.cyr), and what sandhi's client
    # allocates stays: a client must not be able to make one by naming a kid (3.7.0). The
    # timer still refreshes there.
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    if (_jwt_str_field_eq(header, hlen, "alg", "RS256") == 0 && _jwt_str_field_eq(header, hlen, "alg", "ES256") == 0) { return 0; }
    var now = _jwt_now();
    if (now == 0 || _jwt_take(s, now) == 0) { return 0; }
    bote_log(SK_DEBUG, "jwks asked again for a key it does not hold");
    if (_jwt_ask(s, now) != 0) { return 0; }
    return 1;
}

# ================================================================
# Validator adapter — plugs into auth_bearer_check via the existing
# fn-pointer + ctx surface (1.9.0).
#
# ctx is a JwtSecret handle (BOTE_JWT_SECRET_BYTES, 120):
#   +0  secret    cstr, for HS256, or 0
#   +8  length
#   +16 audience  cstr or 0: this server's resource identifier
#   +24 issuers   vec of cstrs or 0: the authorization servers it trusts
#   +32 keys      vec of JwtKey or 0, for RS256 and ES256
#   +40 slots     how many tokens already verified it remembers, a power of two, or 0
#   +48 table     those slots, or 0 until the first token is stored
#   +56 hits      tokens judged from the table
#   +64 misses    tokens verified in full while it was on
#   +72 source    fn (ctx, why_out) → a JWK Set's text, or 0 with a reason; or 0
#   +80 source_ctx
#   +88 every     seconds between refreshes from the source
#   +96 fetched   when the source last gave a set that was taken, 0 for never
#   +104 tried    when the source was last asked, 0 for never
#   +112 failures asked since then without a set taken
#   +120 lock     a mutex for the table, taken once threads are running (3.7.0)
#   +128 gen      moved on by every clear of the table
# jwt_secret_new(secret_cstr) builds one for HS256, and jwt_secret_from_jwks(json) one for
# public keys. A handle holds one or the other, and that is what decides what it verifies.
# ================================================================

var BOTE_JWT_SECRET_BYTES = 136;

fn jwt_secret_new(key) {
    # sigil builds its tables on first use, a claim flag held while it does. A fetch forked
    # from one worker while another builds one leaves the child waiting on that flag, so a
    # handle builds what its verifies will need now, on the thread making it (3.7.1): the
    # SHA-256 tables here, the P-256 ones when it takes an EC key (_jwt_p256_warm).
    sha256_global_init();
    var s = alloc(BOTE_JWT_SECRET_BYTES);
    memset(s, 0, BOTE_JWT_SECRET_BYTES);
    store64(s, key);
    if (key != 0) { store64(s + 8, strlen(key)); }
    store64(s + 40, BOTE_JWT_CACHE_DEFAULT);
    store64(s + 120, mutex_new());
    return s;
}

# A JwtSecret for the public keys in the JWK Set `json`, or 0 when jwt_jwks_check refuses
# it. A key bote cannot use is left out, with a WARN naming it. The set is checked before
# the handle is made, so a refused one keeps nothing.
fn jwt_secret_from_jwks(json) {
    if (jwt_jwks_check(json) != 0) { return 0; }
    var s = jwt_secret_new(0);
    if (jwt_secret_set_jwks(s, json) != 0) { return 0; }
    return s;
}

# Give `s` the public keys of the JWK Set `json` (3.6.6): 0, or why not, with the keys it
# had kept. The set is read on the request arena and compared with the keys in use, and
# only a set that differs is kept, on the heap, which forgets every token judged under the
# old one: a key that left the set must not go on passing tokens from the cache. A handle
# with an HS256 secret takes no keys.
fn jwt_secret_set_jwks(s, json) {
    var changed[8];
    return _jwt_set_jwks(s, json, &changed);
}

fn _jwt_set_jwks(s, json, changed_out) {
    store64(changed_out, 0);
    if (jwt_secret_data(s) != 0) { return "a handle holds an HS256 secret or public keys, never both"; }
    var why = jwt_jwks_check(json);
    if (why != 0) { return why; }
    var a = bote_req_alloc();
    var elems = _jwks_elements_a(a, json);
    var fresh = vec_new_a(a);
    var i = 0;
    while (i < vec_len(elems)) {
        var k = _jwk_key_a(a, vec_get(elems, i));
        if (k != 0) { vec_push_a(a, fresh, k); }
        i = i + 1;
    }
    if (_jwt_keys_same(jwt_secret_keys(s), fresh) == 1) { return 0; }
    var kept = vec_new();
    var ec = 0;
    i = 0;
    while (i < vec_len(fresh)) {
        vec_push(kept, _jwt_key_keep(vec_get(fresh, i)));
        if (_jwt_key_alg(vec_get(fresh, i)) == BOTE_JWT_ES256) { ec = 1; }
        i = i + 1;
    }
    if (ec == 1) { _jwt_p256_warm(); }
    i = 0;
    while (i < vec_len(elems)) {
        if (_jwk_key_a(a, vec_get(elems, i)) == 0) {
            var ln[BOTE_LOG_LINE_BYTES];
            bote_log_line(&ln, SK_WARN, "jwks key skipped");
            bote_log_int(&ln, "index", i);
            bote_log_emit(&ln);
        }
        i = i + 1;
    }
    # The keys are published, filled, under the lock that clears the table: a worker
    # reads either the old set and its tokens or the new set and none.
    _jwt_lock(s);
    atomic_fence();
    store64(s + 32, kept);
    _jwt_cache_clear_held(s);
    _jwt_unlock(s);
    store64(changed_out, 1);
    return 0;
}

# Each changes what a token is judged by, so each forgets what was judged before.
fn jwt_secret_with_audience(s, audience) { store64(s + 16, audience); _jwt_cache_clear(s); return s; }
fn jwt_secret_with_issuers(s, issuers) { store64(s + 24, issuers); _jwt_cache_clear(s); return s; }

fn jwt_secret_data(s) { return load64(s); }
fn jwt_secret_len(s)  { return load64(s + 8); }
fn jwt_secret_audience(s) { return load64(s + 16); }
fn jwt_secret_issuers(s) { return load64(s + 24); }
fn jwt_secret_keys(s) { return load64(s + 32); }
fn jwt_secret_cache_slots(s) { return load64(s + 40); }
fn jwt_secret_cache_hits(s) { return load64(s + 56); }
fn jwt_secret_cache_misses(s) { return load64(s + 64); }

# 1 when the verified payload is meant for this server.
fn _jwt_for_us(a, payload, plen, s) {
    var aud = jwt_secret_audience(s);
    if (aud == 0) {
        if (_jx_find_value_pos(payload, plen, "aud") != 0 - 1) { return 0; }
    } else {
        if (_jx_find_value_pos(payload, plen, "exp") == 0 - 1) { return 0; }
        if (_jwt_aud_has(a, payload, plen, aud) == 0) { return 0; }
    }
    var issuers = jwt_secret_issuers(s);
    if (issuers != 0 && vec_len(issuers) > 0) {
        if (_jwt_iss_in(a, payload, plen, issuers) == 0) { return 0; }
    }
    return 1;
}

# Validator with the bearer-middleware signature: (token, ctx) → claims | 0
fn auth_validator_jwt(token, jwt_secret) {
    if (jwt_secret == 0 || token == 0) { return 0; }
    # A handle with a key source reads the clock once here, for its refresh and for a
    # remembered token's window.
    var now = 0 - 1;
    if (load64(jwt_secret + 72) != 0) {
        now = _jwt_now();
        if (_jwt_refresh_due(jwt_secret, now) == 1 && _jwt_take(jwt_secret, now) == 1) {
            _jwt_ask(jwt_secret, now);
        }
    }
    var digest[32];
    var cached = load64(jwt_secret + 40) > 0;
    var gen = 0;
    if (cached == 1) {
        sha256(token, strlen(token), &digest);
        var hit = 0;
        var exp = 0;
        var nbf = 0;
        _jwt_lock(jwt_secret);
        gen = load64(jwt_secret + 128);
        var e = _jwt_cache_find(jwt_secret, &digest);
        if (e != 0) {
            hit = 1;
            exp = load64(e + 32);
            nbf = load64(e + 40);
            store64(jwt_secret + 56, load64(jwt_secret + 56) + 1);
        } else {
            store64(jwt_secret + 64, load64(jwt_secret + 64) + 1);
        }
        _jwt_unlock(jwt_secret);
        if (hit == 1) {
            if (_jwt_window_at(exp, nbf, now) == 0) { return 0; }
            bote_log(SK_TRACE, "jwt verified from the cache");
            return token;
        }
    }
    var a = bote_req_alloc();
    var plen[8];
    var payload = _jwt_payload_a(a, token, jwt_secret, &plen);
    if (payload == 0) { return 0; }
    if (_jwt_for_us(a, payload, load64(&plen), jwt_secret) == 0) { return 0; }
    if (cached == 1) {
        _jwt_lock(jwt_secret);
        if (load64(jwt_secret + 128) == gen) { _jwt_cache_put(jwt_secret, &digest, payload, load64(&plen)); }
        _jwt_unlock(jwt_secret);
    }
    return token;   # opaque claims = the validated token
}

# The name this had when HS256 was all it did.
fn auth_validator_jwt_hs256(token, jwt_secret) { return auth_validator_jwt(token, jwt_secret); }

# ================================================================
# Scopes
# ================================================================
#
# A scope check with the signature dispatcher_set_scope_check takes. RFC 9068 §2.2.3 puts a
# token's scopes in `scope`, space-separated. Some authorization servers use `scp`, as
# that or as an array, so that is read when `scope` is absent. Matching is exact:
# RFC 6749 §3.3 makes a scope case-sensitive, and `files:read` is not `files:read-all`.
#
# `rules` holds what a broader scope implies, which MCP says a server must account for,
# or is 0. It is a flat vec of broad, narrow: jwt_scope_rules_new, jwt_scope_rule.

fn jwt_scope_rules_new() { return vec_new(); }

fn jwt_scope_rule(rules, broad, narrow) {
    vec_push(rules, broad);
    vec_push(rules, narrow);
    return rules;
}

# 1 when the space-separated `list` holds exactly `want`.
fn _jwt_list_has(list, want) {
    var wl = strlen(want);
    var i = 0;
    while (load8(list + i) != 0) {
        while (load8(list + i) == 32) { i = i + 1; }
        var s = i;
        while (load8(list + i) != 0 && load8(list + i) != 32) { i = i + 1; }
        if (i - s == wl && wl > 0 && memeq(list + s, want, wl) == 1) { return 1; }
    }
    return 0;
}

# What the token grants, space-separated, or 0. An array element holding a space is
# dropped, so that it cannot read as two.
fn _jwt_granted_a(a, payload, plen) {
    var pos = _jx_find_value_pos(payload, plen, "scope");
    if (pos == 0 - 1) { pos = _jx_find_value_pos(payload, plen, "scp"); }
    if (pos == 0 - 1) { return 0; }
    if (load8(payload + pos) != 91) { return _jx_str_dec_at_a(a, payload, plen, pos); }
    var out = alloc_via(a, plen + 1);
    var n = 0;
    var i = _jx_skip_ws(payload, plen, pos + 1);
    while (i < plen && load8(payload + i) != 93) {
        var one = _jx_str_dec_at_a(a, payload, plen, i);
        if (one != 0 && strchr(one, 32) == 0 - 1) {
            var ol = strlen(one);
            memcpy(out + n, one, ol);
            store8(out + n + ol, 32);
            n = n + ol + 1;
        }
        i = _jx_array_next(payload, plen, i);
    }
    store8(out + n, 0);
    return out;
}

# 1 when `list` holds `want`, or a scope the rules say implies it. Rules chain, and each
# is followed once, so that a cycle ends and a dense set stays quadratic.
fn _jwt_scope_held(a, list, want, rules) {
    if (_jwt_list_has(list, want) == 1) { return 1; }
    if (rules == 0) { return 0; }
    var n = vec_len(rules) / 2;
    var seen = alloc_via(a, n + 1);
    memset(seen, 0, n + 1);
    var wanted = alloc_via(a, (n + 1) * 8);
    store64(wanted, want);
    var next = 0;
    var end = 1;
    while (next < end) {
        var w = load64(wanted + next * 8);
        next = next + 1;
        var i = 0;
        while (i < n) {
            if (load8(seen + i) == 0 && streq(vec_get(rules, i * 2 + 1), w) == 1) {
                store8(seen + i, 1);
                var broad = vec_get(rules, i * 2);
                if (_jwt_list_has(list, broad) == 1) { return 1; }
                store64(wanted + end * 8, broad);
                end = end + 1;
            }
            i = i + 1;
        }
    }
    return 0;
}

# 1 when the JWT `claims`, which a validator has already verified, grants `scope`. What
# is not a JWT grants nothing.
fn jwt_scope_check(claims, scope, rules) {
    if (claims == 0 || scope == 0) { return 0; }
    var tlen = strlen(claims);
    var dot1 = _jwt_dot(claims, tlen, 0);
    if (dot1 <= 0) { return 0; }
    var dot2 = _jwt_dot(claims, tlen, dot1 + 1);
    var a = bote_req_alloc();
    var plen[8];
    var payload = _jwt_b64u_a(a, claims + dot1 + 1, dot2 - dot1 - 1, &plen);
    if (payload == 0) { return 0; }
    var list = _jwt_granted_a(a, payload, load64(&plen));
    if (list == 0) { return 0; }
    return _jwt_scope_held(a, list, scope, rules);
}

# --- pkce.cyr ---

# bote::pkce — RFC 7636 PKCE helpers (Proof Key for Code Exchange).
#
# OAuth 2.1 / RFC 7636 require PKCE on every authorization-code flow.
# Bote isn't an authorization server (we're a resource server), but
# providing the verifier+challenge primitives lets MCP clients running
# inside bote-hosted handlers initiate the auth dance without
# reimplementing the (small but easy-to-mess-up) crypto.
#
# This module ships:
#   pkce_code_verifier(out_buf, len)     — write `len` URL-safe random
#                                          bytes [43..128] from urandom
#   pkce_code_challenge_s256(verifier)   — challenge = base64url(sha256(verifier))
#
# The S256 method is the only one OAuth 2.1 mandates; "plain" is
# explicitly removed in 2.1, so we don't ship it. Uses sigil's
# `hmac_sha256`-companion `sha256` one-shot for the digest and an
# inline base64url encoder for the challenge.
#
# Dependencies: sigil (`sha256`) and `random` (`random_bytes`) only.
#
# 3.2.0 removed a stale "Requires: src/jwt.cyr to be included first
# (for jwt_b64u_decode's alphabet table — we share `_b64u_alphabet`
# across the two helpers)" note. It was wrong in every particular:
# this module names no jwt symbol, there is no shared
# `_b64u_alphabet` (this file has its own `_pkce_alphabet` at the
# 66-char unreserved set, and a separate 64-char literal inline in
# `pkce_code_challenge_s256`), and a test including only src/pkce.cyr
# compiles and passes the RFC 7636 Appendix B vector.

# RFC 7636 §4.1: the unreserved characters allowed in code_verifier.
# 66 chars: A-Z a-z 0-9 - . _ ~
var _pkce_alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~";

# Generate a random URL-safe code_verifier of length `len` (RFC 7636
# allows 43-128). Writes to `out_buf` (must be `len + 1` bytes; gets
# NUL-terminated). Returns 0 on success, non-zero on entropy failure.
#
# Reads `len` bytes from /dev/urandom and maps each into the 66-char
# unreserved alphabet via mod 66. Mod-bias is negligible for 66 (the
# 256/66 = 3 remainder gives a worst-case bias of ~0.4% per char,
# well below practical guessing impact for 43+-char tokens).
fn pkce_code_verifier(out_buf, len) {
    if (len < 43) { return 1; }
    if (len > 128) { return 1; }
    # 3.2.0 (aarch64 portability): getrandom(2) via the stdlib
    # `random_bytes` wrapper, replacing a raw
    # `syscall(SYS_OPEN, "/dev/urandom", 0, 0)` + read-loop + close.
    # SYS_OPEN exists only on x86_64 (aarch64's generic table has openat
    # and no open), so that reference failed the aarch64 build outright.
    # SYS_GETRANDOM is defined on both arches. Same fail-closed contract:
    # anything short of a full fill returns non-zero and writes nothing.
    # See src/session.cyr's _gen_session_id for the full rationale.
    var raw = alloc(len);
    if (random_bytes(raw, len) != len) { return 1; }
    var i = 0;
    while (i < len) {
        var b = load8(raw + i);
        store8(out_buf + i, load8(_pkce_alphabet + (b % 66)));
        i = i + 1;
    }
    store8(out_buf + len, 0);
    return 0;
}

# Compute the S256 code_challenge for `verifier` (cstr).
# challenge = base64url-no-padding(sha256(verifier))
# Returns a NUL-terminated cstr (alloc'd; 43 chars + NUL).
fn pkce_code_challenge_s256(verifier) {
    if (verifier == 0) { return 0; }
    var vlen = strlen(verifier);
    if (vlen < 43 || vlen > 128) { return 0; }
    var digest = alloc(32);
    sha256(verifier, vlen, digest);
    # Inline base64url-encode of the 32-byte digest. 32 bytes → 43
    # base64url chars (no padding). Same alphabet as jwt_b64u (shared
    # _pkce_alphabet here is *different* — JWT uses base64url over the
    # 64-char alphabet, PKCE uses the 66-char unreserved set for the
    # verifier; for the challenge we encode the digest in standard
    # base64url, NOT the 66-char set).
    var b64u = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
    var out = alloc(44);
    var di = 0;
    var oi = 0;
    while (di + 3 <= 32) {
        var b0 = load8(digest + di);
        var b1 = load8(digest + di + 1);
        var b2 = load8(digest + di + 2);
        store8(out + oi,     load8(b64u + (b0 >> 2)));
        store8(out + oi + 1, load8(b64u + ((b0 & 3) << 4 | (b1 >> 4))));
        store8(out + oi + 2, load8(b64u + ((b1 & 15) << 2 | (b2 >> 6))));
        store8(out + oi + 3, load8(b64u + (b2 & 63)));
        di = di + 3;
        oi = oi + 4;
    }
    # 32 bytes = 30 + 2 → trailing 2-byte tail produces 3 chars (no padding)
    var t0 = load8(digest + 30);
    var t1 = load8(digest + 31);
    store8(out + oi,     load8(b64u + (t0 >> 2)));
    store8(out + oi + 1, load8(b64u + ((t0 & 3) << 4 | (t1 >> 4))));
    store8(out + oi + 2, load8(b64u + ((t1 & 15) << 2)));
    store8(out + 43, 0);
    return out;
}

# --- conn.cyr ---

# bote::conn — per-connection socket deadlines for the transports (3.4.3),
# and the serve entry the HTTP-family ones share (3.4.12).
#
# Every bote transport serves one connection at a time: the Unix transport
# runs its own accept loop, and the HTTP-family ones run inside sandhi's
# single-threaded `sandhi_server_run_opts`. A connection that blocks the
# server therefore blocks every other client too.
#
# ## Send: on by default
#
# A blocking write parks once the kernel send buffer and the peer's receive
# window are both full, which happens only when the peer has stopped reading.
# Without a deadline, a client that floods requests and never reads the
# replies wedges the server for good. That was measured on 3.4.2 against both
# the Unix and the WebSocket transport: a healthy client's `ping` went
# unanswered. No healthy client leaves its receive window full for
# BOTE_SEND_TIMEOUT_MS, so a send deadline only ever drops a peer that is
# already broken. Each transport applies it to every connection it serves,
# and drops the connection when a write fails.
#
# ## Receive on Unix clients: off by default
#
# The Unix transport is line-oriented and persistent: an MCP client may keep
# its connection open and quiet between requests, exactly as a WebSocket
# client may. A default receive deadline would drop those healthy clients,
# which is the defect 3.3.7 fixed for WebSocket (`ws_config_with_idle_ms`,
# default off). So BOTE_UNIX_IDLE_MS defaults to 0, no deadline. An operator
# who prefers to reap quiet peers, so that one idle client cannot hold the
# single-threaded server, sets it. The HTTP-family transports keep sandhi's
# own read deadlines (a 30 s idle budget and a 60 s whole-request budget per
# connection), and WebSocket keeps `ws_config_with_idle_ms`.
#
# ## Configuration
#
# Both are plain globals. An embedder assigns them before starting a
# transport; the binaries read BOTE_SEND_TIMEOUT_MS / BOTE_UNIX_IDLE_MS from
# the environment (src/main_common.cyr). Milliseconds; 0 disables. On agnos
# the stdlib records the deadline in its syscall peer instead of a socket
# option, and a 0 there means the peer's 30 s default, not "never".
#
# ## Serving
#
# The HTTP-family transports start through bote_conn_serve. sandhi_server_run
# takes no options struct, so a failed start recorded nothing and bote could
# only say that socket, bind, listen or accept had failed. run_opts records
# the step and the errno in the struct it is given. A new struct reads the same
# defaults as none (tests/bote.tcyr pins that), so that record is the only
# difference. It needs sandhi 1.10.10, which is what sets the minimum cyrius
# at the top of src/log.cyr.

var BOTE_SEND_TIMEOUT_MS = 30000;
var BOTE_UNIX_IDLE_MS = 0;
var BOTE_ERRNO_EADDRINUSE = 98;

# Apply `ms` as fd's send (`send` = 1) or receive (`send` = 0) deadline.
# ms <= 0 leaves the socket as it is. Returns 0 or the stdlib's -errno.
fn _bote_conn_deadline(fd, ms, send) {
    if (ms <= 0) { return 0; }
    var secs = ms / 1000;
    var usecs = (ms - secs * 1000) * 1000;
    if (send == 1) { return sock_set_send_timeout(fd, secs, usecs); }
    return sock_set_recv_timeout(fd, secs, usecs);
}

# Give a connection the send deadline every transport applies.
fn bote_conn_send_deadline(fd) {
    return _bote_conn_deadline(fd, BOTE_SEND_TIMEOUT_MS, 1);
}

# Give a Unix-transport client its receive deadline, if one is configured.
fn bote_conn_unix_idle_deadline(fd) {
    return _bote_conn_deadline(fd, BOTE_UNIX_IDLE_MS, 0);
}

# ## A client gone (3.7.5)
#
# How a socket transport tells that the client of a request in flight has gone, which is
# its cancellation on Streamable HTTP. poll(2) with no wait: POLLHUP, POLLERR or POLLNVAL,
# and with `half` POLLRDHUP too, which is all TCP shows of a client that closed (a FIN),
# though a client that only shut its sending side shows the same. A Unix socket shows
# POLLHUP once the client has closed both, so it passes `half` 0 and a client that shuts
# its sending side and waits for its answers gets them. Input waiting is not a close.
var BOTE_POLL_IN = 1;
var BOTE_POLL_ERR = 8;
var BOTE_POLL_HUP = 16;
var BOTE_POLL_NVAL = 32;
var BOTE_POLL_RDHUP = 8192;

# 1 when the client at `fd` has gone; 0 while it is there, and on agnos, which has no poll.
fn bote_conn_gone(fd, half) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var pfd[8];
    store32(&pfd, fd);
    store16(&pfd + 4, BOTE_POLL_IN | BOTE_POLL_RDHUP);
    store16(&pfd + 6, 0);
    var ts[16];
    store64(&ts, 0);
    store64(&ts + 8, 0);
    if (sys_ppoll(&pfd, 1, &ts, 0, 8) <= 0) { return 0; }
    var ev = load16(&pfd + 6);
    if ((ev & (BOTE_POLL_HUP | BOTE_POLL_ERR | BOTE_POLL_NVAL)) != 0) { return 1; }
    if (half == 1 && (ev & BOTE_POLL_RDHUP) != 0) { return 1; }
    return 0;
    #endif
}

# 1 when the client at `fd` has input waiting, without waiting for any; 0 on agnos.
fn bote_conn_readable(fd) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var pfd[8];
    store32(&pfd, fd);
    store16(&pfd + 4, BOTE_POLL_IN);
    store16(&pfd + 6, 0);
    var ts[16];
    store64(&ts, 0);
    store64(&ts + 8, 0);
    if (sys_ppoll(&pfd, 1, &ts, 0, 8) <= 0) { return 0; }
    return (load16(&pfd + 6) & BOTE_POLL_IN) != 0;
    #endif
}

# One WARN line for a peer dropped because a write to it failed: with the
# send deadline in place, that means it stopped reading for
# BOTE_SEND_TIMEOUT_MS. `err` is the stdlib's negative errno.
fn bote_conn_log_send_drop(transport, err) {
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_WARN, "client dropped: a write to it failed (stopped reading?)");
    bote_log_str(&ln, "transport", transport);
    bote_log_int(&ln, "errno", 0 - err);
    bote_log_int(&ln, "send_timeout_ms", BOTE_SEND_TIMEOUT_MS);
    bote_log_emit(&ln);
    return 0;
}

# The log name of a SANDHI_SERVER_FAIL_* step. "unknown" is a failed serve with
# nothing recorded, which means its options struct could not be allocated.
fn bote_conn_serve_step_name(step) {
    if (step == SANDHI_SERVER_FAIL_CONFIG) { return "config"; }
    if (step == SANDHI_SERVER_FAIL_ALLOC) { return "alloc"; }
    if (step == SANDHI_SERVER_FAIL_SOCKET) { return "socket"; }
    if (step == SANDHI_SERVER_FAIL_BIND) { return "bind"; }
    if (step == SANDHI_SERVER_FAIL_LISTEN) { return "listen"; }
    if (step == SANDHI_SERVER_FAIL_ACCEPT) { return "accept"; }
    if (step == SANDHI_SERVER_FAIL_THREAD) { return "thread"; }
    return "unknown";
}

# One ERROR line for a serve that returned non-zero: the step that failed, and
# the errno when that step has one. `opts` is the struct the serve was given.
fn bote_conn_log_serve_failure(transport, port, opts) {
    var step_slot[8]; var err_slot[8];
    sandhi_server_last_failure(opts, &step_slot, &err_slot);
    var step = load64(&step_slot);
    var err = load64(&err_slot);
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_ERROR, "serve failed");
    bote_log_str(&ln, "transport", transport);
    bote_log_str(&ln, "step", bote_conn_serve_step_name(step));
    bote_log_int(&ln, "port", port);
    if (err != 0) { bote_log_int(&ln, "errno", err); }
    if (step == SANDHI_SERVER_FAIL_BIND && err == BOTE_ERRNO_EADDRINUSE) {
        bote_log_str(&ln, "cause", "port in use");
    }
    bote_log_emit(&ln);
    return 0;
}

# Serve `handler_fp` on addr:port. Returns only on failure, having said why.
fn bote_conn_serve(transport, addr, port, handler_fp, ctx) {
    var opts = sandhi_server_options_new();
    var rc = sandhi_server_run_opts(addr, port, handler_fp, ctx, opts);
    if (rc != 0) { bote_conn_log_serve_failure(transport, port, opts); }
    return rc;
}

# ================================================================
# Serving on worker threads (3.7.0)
# ================================================================
#
# bote_conn_serve_pooled serves on `workers` threads, sandhi's pool: the calling thread
# only accepts, and hands each connection to the next free worker, so a client that is
# slow to send or to read, or a token that is slow to verify, holds one worker and not
# the server. With 0 workers it is bote_conn_serve. On agnos, whose threads run one at a
# time, sandhi serves the pool on the calling thread.
#
# Each thread then has a request state of its own (src/protocol.cyr): bote_conn_arm
# claims a thread-local slot for it before the first worker starts, and a thread's state
# is made the first time it asks. The thread that arms keeps the state it had. On Linux
# a thread_create'd thread is given a thread-local block when it starts, and only one
# that was not, the main thread, can lack one; sigil's crypto_tls_main_init gives the
# calling thread one if it has none. bote_conn_arm calls it, and when the arming thread
# is not the main one, so does every lookup, which a main thread with no block would
# otherwise fault on. That costs each lookup sigil's check, which on an x86 kernel without
# FSGSBASE (before Linux 5.9) is two system calls until the main thread has a block: arm
# from the main thread.

var _bote_conn_slot = 0 - 1;
var _bote_conn_main = 0;

fn _bote_conn_req_state() {
    if (_bote_conn_main == 0) { crypto_tls_main_init(); }
    var s = thread_local_get(_bote_conn_slot);
    if (s == 0) {
        # Zeroed: a cancellation check (3.7.5) is a function bote calls.
        s = alloc(BOTE_REQ_STATE_BYTES);
        memset(s, 0, BOTE_REQ_STATE_BYTES);
        thread_local_set(_bote_conn_slot, s);
    }
    return s;
}

# Give every thread a request state of its own: 0, or -1 when no thread-local slot is
# left. Once is enough; later calls do nothing.
fn bote_conn_arm() {
    if (_bote_conn_slot >= 0) { return 0; }
    crypto_tls_main_init();
    #ifdef CYRIUS_TARGET_LINUX
    if (sys_gettid() == sys_getpid()) { _bote_conn_main = 1; }
    #endif
    #ifndef CYRIUS_TARGET_LINUX
    _bote_conn_main = 1;
    #endif
    var slot = thread_local_alloc();
    if (slot < 0) { return 0 - 1; }
    thread_local_set(slot, bote_req_state());
    _bote_conn_slot = slot;
    _bote_req_state_fp = &_bote_conn_req_state;
    return 0;
}

# A sink the dispatcher calls from every worker, made to take its turn: the sink a
# threaded server is handed was written for one caller at a time (libro's chain, majra's
# hub). Wrap (16 B): +0 the sink, +8 a mutex.
fn _bote_conn_audit_serial(w, event) {
    mutex_lock(load64(w + 8));
    audit_sink_log(load64(w), event);
    mutex_unlock(load64(w + 8));
    return 0;
}

fn _bote_conn_events_serial(w, topic, payload) {
    mutex_lock(load64(w + 8));
    event_sink_publish(load64(w), topic, payload);
    mutex_unlock(load64(w + 8));
    return 0;
}

fn _bote_conn_updated_serial(w, uri) {
    mutex_lock(load64(w + 8));
    event_sink_updated(load64(w), uri);
    mutex_unlock(load64(w + 8));
    return 0;
}

fn _bote_conn_serial_wrap(sink) {
    var w = alloc(16);
    store64(w, sink);
    store64(w + 8, mutex_new());
    return w;
}

# Make `d`'s audit and event sinks take their turn, as a threaded server must before its
# first worker starts. A sink with no function is left alone; an event sink's list-only
# flag is kept. Returns d.
fn bote_conn_serial_sinks(d) {
    var au = dispatcher_audit_sink(d);
    if (au != 0 && audit_sink_log_fp(au) != 0 && audit_sink_log_fp(au) != &_bote_conn_audit_serial) {
        dispatcher_set_audit(d, audit_sink_new(&_bote_conn_audit_serial, _bote_conn_serial_wrap(au)));
    }
    var ev = dispatcher_event_sink(d);
    if (ev != 0 && event_sink_publish_fp(ev) != 0 && event_sink_publish_fp(ev) != &_bote_conn_events_serial) {
        var ns = event_sink_new(&_bote_conn_events_serial, _bote_conn_serial_wrap(ev));
        store64(ns + 16, load64(ev + 16));
        if (load64(ev + 24) != 0) { event_sink_with_updated(ns, &_bote_conn_updated_serial); }
        dispatcher_set_events(d, ns);
    }
    return d;
}

# Serve `handler_fp` on addr:port on `workers` threads, or as bote_conn_serve with 0.
# Returns only on failure, having said why.
fn bote_conn_serve_pooled(transport, addr, port, handler_fp, ctx, workers) {
    if (workers <= 0) { return bote_conn_serve(transport, addr, port, handler_fp, ctx); }
    if (bote_conn_arm() != 0) {
        var ln[BOTE_LOG_LINE_BYTES];
        bote_log_line(&ln, SK_ERROR, "serve failed");
        bote_log_str(&ln, "transport", transport);
        bote_log_str(&ln, "step", "thread_local");
        bote_log_int(&ln, "port", port);
        bote_log_emit(&ln);
        return 1;
    }
    var opts = sandhi_server_options_new();
    sandhi_server_options_max_conns(opts, workers);
    var rc = sandhi_server_run_pooled(addr, port, handler_fp, ctx, opts);
    if (rc != 0) { bote_conn_log_serve_failure(transport, port, opts); }
    return rc;
}

# --- fetch.cyr ---

# bote::fetch — an outbound request, made in a child process (3.6.5).
#
# sandhi's HTTP client gives the TLS stack the global heap, not the arena it was handed, so
# every https:// request keeps about 175 KB that nothing frees: 179,000 B per request,
# measured on cyrius 6.7.18 (sandhi 1.13.7), and filed in sandhi's repository as
# 2026-11-02-bote-tls-connect-keeps-each-connection-on-the-heap.md. Its DNS lookup has no
# deadline either, so a lost reply holds the serving loop. bote makes the request in a
# child: what the child allocates goes when it exits, and the parent stops waiting at a
# deadline of its own and ends it. The child answers with a record, which the parent
# reads onto the request arena.
#
# A fork, a pipe and a reap cost about 145 µs, and a whole GET to a loopback server made
# that way about 0.6 ms; a TLS handshake costs more.
#
# Fork copies the calling thread alone. A lock another thread held at that moment stays
# held in the child, where nothing will let it go, so on a worker thread (3.7.0) the
# allocators' locks are taken across the fork and let go on both sides: _bf_fork. The
# reason a fetch failed is the calling thread's (bote_req_state).
#
# On agnos the function runs in this process, as it did before: the target has no ppoll
# and its waitpid takes other arguments.
#
# A record is what the child's function writes with bote_fetch_put_*, and the parent reads
# back, in the same order, with bote_fetch_int and bote_fetch_str. Record (24 B): +0 data,
# +8 len, +16 cap. Cursor (24 B): +0 data, +8 len, +16 offset.

# Why the calling thread's last bote_fetch_in_child failed, or 0.
fn bote_fetch_why() { return load64(bote_req_state() + BOTE_REQ_STATE_WHY); }

fn _bf_why(why) {
    store64(bote_req_state() + BOTE_REQ_STATE_WHY, why);
    return 0;
}

# On the request arena: a child's own copy of it, which goes with the child, and on agnos
# this process's, which the next message rewinds.
fn _bf_rec_new() {
    var a = bote_req_alloc();
    var r = alloc_via(a, 24);
    store64(r, alloc_via(a, 4096));
    store64(r + 8, 0);
    store64(r + 16, 4096);
    return r;
}

# Room for `n` more bytes. In the child, on its own heap, which goes with it.
fn _bf_room(r, n) {
    var len = load64(r + 8);
    var cap = load64(r + 16);
    if (len + n <= cap) { return 0; }
    while (cap < len + n) { cap = cap * 2; }
    var d = alloc_via(bote_req_alloc(), cap);
    memcpy(d, load64(r), len);
    store64(r, d);
    store64(r + 16, cap);
    return 0;
}

fn bote_fetch_put_int(r, v) {
    _bf_room(r, 8);
    store64(load64(r) + load64(r + 8), v);
    store64(r + 8, load64(r + 8) + 8);
    return 0;
}

# `n` bytes from `p`, and a NUL after them, so the reader hands back a cstr in place.
fn bote_fetch_put_bytes(r, p, n) {
    bote_fetch_put_int(r, n);
    _bf_room(r, n + 1);
    var at = load64(r) + load64(r + 8);
    memcpy(at, p, n);
    store8(at + n, 0);
    store64(r + 8, load64(r + 8) + n + 1);
    return 0;
}

# A cstr, or 0, which reads back as 0.
fn bote_fetch_put_str(r, s) {
    if (s == 0) { return bote_fetch_put_int(r, 0 - 1); }
    return bote_fetch_put_bytes(r, s, strlen(s));
}

# The next int, or 0 past the record's end.
fn bote_fetch_int(c) {
    var off = load64(c + 16);
    if (off + 8 > load64(c + 8)) { return 0; }
    store64(c + 16, off + 8);
    return load64(load64(c) + off);
}

# The next cstr, in place, its length in *len_out when that is not 0; 0 for a 0, or past
# the record's end.
fn bote_fetch_str(c, len_out) {
    var n = bote_fetch_int(c);
    if (len_out != 0) { store64(len_out, 0); }
    if (n < 0) { return 0; }
    var off = load64(c + 16);
    if (n > load64(c + 8) - off - 1) { return 0; }
    store64(c + 16, off + n + 1);
    if (len_out != 0) { store64(len_out, n); }
    return load64(c) + off;
}

fn _bf_write_all(fd, p, n) {
    var off = 0;
    while (off < n) {
        var w = sys_write(fd, p + off, n - off);
        if (w == 0 - 4) { w = 0; }
        elif (w <= 0) { return 0 - 1; }
        off = off + w;
    }
    return 0;
}

#ifndef CYRIUS_TARGET_AGNOS
# Readable within `ms`, or -1 for no deadline: >0 ready or hung up, 0 the time ran out.
fn _bf_poll_in(fd, ms) {
    var pfd[8];
    store32(&pfd, fd);
    store16(&pfd + 4, 1);   # POLLIN
    store16(&pfd + 6, 0);
    var ts[16];
    var tsp = 0;
    if (ms >= 0) {
        store64(&ts, ms / 1000);
        store64(&ts + 8, (ms % 1000) * 1000000);
        tsp = &ts;
    }
    var r = sys_ppoll(&pfd, 1, tsp, 0, 8);
    while (r == 0 - 4) { r = sys_ppoll(&pfd, 1, tsp, 0, 8); }
    return r;
}

# While a request its client can cancel waits on a child (3.7.5), it asks every
# BOTE_FETCH_CANCEL_MS whether it has been, and a cancelled one ends the child.
var BOTE_FETCH_CANCEL_MS = 100;

# Read exactly `n` bytes into `p` by the deadline `end` (clock_now_ms), or 0 for none.
# 1, or 0 with the reason set; *eof is set to 1 when a read stopped at the end of the
# pipe: the child has closed it, by exiting.
fn _bf_read_all(fd, p, n, end, eof) {
    var got = 0;
    var live = bote_req_cancel_live();
    while (got < n) {
        var ms = 0 - 1;
        if (end != 0) {
            ms = end - clock_now_ms();
            if (ms <= 0) { _bf_why("deadline"); return 0; }
        }
        var slice = ms;
        if (live == 1 && (slice < 0 || slice > BOTE_FETCH_CANCEL_MS)) { slice = BOTE_FETCH_CANCEL_MS; }
        var pr = _bf_poll_in(fd, slice);
        if (pr == 0 && slice != ms) {
            if (bote_cancelled() == 1) { _bf_why("cancelled"); return 0; }
            continue;
        }
        if (pr == 0) { _bf_why("deadline"); return 0; }
        if (pr < 0) { _bf_why("poll"); return 0; }
        var r = sys_read(fd, p + got, n - got);
        if (r == 0 - 4) { r = 0; }
        elif (r == 0) { _bf_why("short reply"); store64(eof, 1); return 0; }
        elif (r < 0) { _bf_why("short reply"); return 0; }
        got = got + r;
    }
    return 1;
}

# sys_fork, with the allocators' locks held across it once threads are running, so the
# child gets them free: a thread that held one when the fork came would otherwise leave
# the child's first allocation waiting for ever. These are lib/alloc.cyr's and
# lib/freelist.cyr's own, which cyrius gives no hook for (filed in cyrius's repository as
# 2026-11-02-bote-fork-needs-the-allocator-locks.md). Taken in the order neither
# allocator ever nests them in.
fn _bf_fork() {
    if (_threads_active == 0) { return sys_fork(); }
    _fl_lock_acquire();
    _alloc_lock_acquire();
    var pid = sys_fork();
    _alloc_lock_release();
    _fl_lock_release();
    return pid;
}

# The child's side: run `fp(ctx, record)`, send the record, exit. Never returns. `ppid`
# is the parent's pid from before the fork: one that died before the prctl took is a
# parent the signal will never come from, so the child goes at once.
fn _bf_child(fp, ctx, wr, ppid) {
    #ifdef CYRIUS_TARGET_LINUX
    sys_prctl(1, SIGKILL, 0, 0, 0);    # PR_SET_PDEATHSIG: it ends with this process
    if (sys_getppid() != ppid) { sys_exit(0); }
    #endif
    var r = _bf_rec_new();
    fncall2(fp, ctx, r);
    var len[8];
    store64(&len, load64(r + 8));
    if (_bf_write_all(wr, &len, 8) == 0) { _bf_write_all(wr, load64(r), load64(r + 8)); }
    sys_exit(0);
    return 0;
}
#endif

# Run `fp(ctx, record)` in a child and read the record it writes into the cursor `cur`, on
# the request arena. At most `cap` bytes come back, and the parent waits `deadline_ms` at
# the most, or for ever with 0; a child still running then is killed. 1, or 0 with
# bote_fetch_why saying why.
fn bote_fetch_in_child(fp, ctx, cap, deadline_ms, cur) {
    _bf_why(0);
    store64(cur, 0);
    store64(cur + 8, 0);
    store64(cur + 16, 0);
    #ifdef CYRIUS_TARGET_AGNOS
    var ar = _bf_rec_new();
    fncall2(fp, ctx, ar);
    if (load64(ar + 8) > cap) { _bf_why("too large"); return 0; }
    store64(cur, load64(ar));
    store64(cur + 8, load64(ar + 8));
    return 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var fds[8];
    if (sys_pipe(&fds) < 0) { _bf_why("pipe"); return 0; }
    var rd = load32(&fds);
    var wr = load32(&fds + 4);
    var ppid = sys_getpid();
    var pid = _bf_fork();
    if (pid < 0) {
        sys_close(rd);
        sys_close(wr);
        _bf_why("fork");
        return 0;
    }
    if (pid == 0) {
        sys_close(rd);
        _bf_child(fp, ctx, wr, ppid);
    }
    sys_close(wr);
    var eof[8];
    store64(&eof, 0);
    var end = 0;
    if (deadline_ms > 0) { end = clock_now_ms() + deadline_ms; }
    var ok = 0;
    var len[8];
    if (_bf_read_all(rd, &len, 8, end, &eof) == 1) {
        var n = load64(&len);
        if (n < 0 || n > cap) {
            _bf_why("too large");
        } else {
            # Every string in a record carries its own NUL, so nothing is added after it.
            var buf = alloc_via(bote_req_alloc(), n + 1);
            if (buf == 0) {
                _bf_why("memory");
            } elif (_bf_read_all(rd, buf, n, end, &eof) == 1) {
                store64(cur, buf);
                store64(cur + 8, n);
                ok = 1;
            }
        }
    }
    sys_close(rd);
    # A child that closed the pipe has exited: it is not signalled, because with SIGCHLD
    # ignored it may be reaped already and its pid someone else's.
    if (ok == 0 && load64(&eof) == 0) { sys_kill(pid, SIGKILL); }
    var st[8];
    var w = sys_waitpid(pid, &st, 0);
    while (w == 0 - 4) { w = sys_waitpid(pid, &st, 0); }
    if (ok == 0 && bote_fetch_why() == 0) { _bf_why("short reply"); }
    return ok;
    #endif
}

# --- jwks.cyr ---

# bote::jwks — a JWK Set fetched from an authorization server's `jwks_uri` (3.6.6).
#
# bote_jwks_fetch is a key source for a JwtSecret (jwt_secret_with_key_source, src/jwt.cyr),
# which decides when to ask. Each ask is one GET, made in a child (src/fetch.cyr): sandhi
# keeps about 175 KB on the heap for every https:// request, and the child takes it away.
#
# The URL is the operator's, not a client's, so the SSRF guard, which would refuse an
# authorization server on the operator's own network, is not applied. What is: https://,
# with the system's trust roots or BOTE_JWKS_CA's, or http:// to a loopback address, which
# no one on a network can answer for; no userinfo; no redirect followed; at most
# BOTE_JWKS_MAX bytes back; and BOTE_JWKS_TIMEOUT_MS for all of it, the DNS lookup
# included, after which the child is killed. The name is resolved by the stdlib's
# net_resolve_ipv4, which has a deadline of its own, through sandhi's resolve hook, unless
# an embedder has a hook installed, which then decides. IPv4 only.
#
# JwksSource (16 B): +0 url, +8 trust store path or 0, both kept on the heap.

var BOTE_JWKS_TIMEOUT_MS = 5000;

# 1 when `host` is a loopback name or address: an IPv4 literal in 127.0.0.0/8, or
# `localhost` or a name under it, which net_resolve_ipv4 answers 127.0.0.1 for without
# asking anyone (RFC 6761).
fn _jwks_loopback(host) {
    if (streq(host, "localhost") == 1) { return 1; }
    var n = strlen(host);
    if (n > 10 && streq(host + n - 10, ".localhost") == 1) { return 1; }
    var v4 = net_parse_ipv4(host);
    if (v4 == 0 - 1) { return 0; }
    if ((v4 & 255) == 127) { return 1; }
    return 0;
}

# Why `url`, with the trust store `ca` or 0, cannot be fetched, as a message, or 0.
fn bote_jwks_url_check(url, ca) {
    if (url == 0) { return "a jwks_uri is an http:// or https:// URL"; }
    # sandhi's parser refuses an empty host as well as another scheme.
    var u = sandhi_url_parse_a(bote_req_alloc(), url);
    if (u == 0) { return "a jwks_uri is an http:// or https:// URL with a host"; }
    var host = sandhi_url_host(u);
    # sandhi has no userinfo; a `@` before the path would be read as part of the host.
    var i = 0;
    if (sandhi_url_scheme(u) == SANDHI_URL_HTTPS) { i = 8; } else { i = 7; }
    while (load8(url + i) != 0 && load8(url + i) != 47 && load8(url + i) != 63 && load8(url + i) != 35) {
        if (load8(url + i) == 64) { return "a jwks_uri carries no userinfo"; }
        i = i + 1;
    }
    var j = 0;
    while (load8(host + j) != 0) {
        if (load8(host + j) == 58) { return "a jwks_uri names its host or an IPv4 address: bote fetches it over IPv4"; }
        j = j + 1;
    }
    if (sandhi_url_scheme(u) == SANDHI_URL_HTTPS) { return 0; }
    if (ca != 0) { return "BOTE_JWKS_CA is for an https:// jwks_uri"; }
    if (_jwks_loopback(host) == 0) { return "an http:// jwks_uri must name a loopback address: anywhere else, https://"; }
    return 0;
}

# A source for `url` and the trust store `ca` or 0, or 0 when bote_jwks_url_check refuses.
fn bote_jwks_source_new(url, ca) {
    if (bote_jwks_url_check(url, ca) != 0) { return 0; }
    var src = alloc(16);
    var ul = strlen(url);
    var u = alloc(ul + 1);
    memcpy(u, url, ul + 1);
    store64(src, u);
    store64(src + 8, 0);
    if (ca != 0) {
        var cl = strlen(ca);
        var c = alloc(cl + 1);
        memcpy(c, ca, cl + 1);
        store64(src + 8, c);
    }
    return src;
}

fn bote_jwks_source_url(src) { return load64(src); }

# The resolve hook the child installs: an IPv4 address from net_resolve_ipv4, which gives
# up on DNS in two tries of 2 s, and none for IPv6.
fn _jwks_resolve(ctx, host, family) {
    if (family != SANDHI_RESOLVE_V4) { return 0; }
    return net_resolve_ipv4(host);
}

# The child: the GET, and a record of sandhi's error kind, the status and the body.
fn _jwks_child(src, rec) {
    var a = bote_req_alloc();
    var hooked = 0;
    if (_sandhi_client_resolver_fn == 0) {
        sandhi_client_set_resolver(&_jwks_resolve, 0);
        hooked = 1;
    }
    var h = sandhi_headers_new();
    sandhi_headers_set(h, "Accept", "application/jwk-set+json, application/json");
    sandhi_headers_set(h, "User-Agent", "bote-jwks/1.0 (AGNOS)");
    var o = sandhi_http_options_new_a(a);
    sandhi_http_options_connect_ms(o, BOTE_JWKS_TIMEOUT_MS);
    sandhi_http_options_read_ms(o, BOTE_JWKS_TIMEOUT_MS);
    sandhi_http_options_write_ms(o, BOTE_JWKS_TIMEOUT_MS);
    sandhi_http_options_total_ms(o, BOTE_JWKS_TIMEOUT_MS);
    sandhi_http_options_max_response_bytes(o, BOTE_JWKS_MAX);
    if (load64(src + 8) != 0) {
        sandhi_http_options_tls_policy(o, sandhi_tls_policy_new_trust_store_a(a, load64(src + 8)));
    }
    var r = sandhi_http_get_opts_a(a, load64(src), h, o);
    if (hooked == 1) { sandhi_client_clear_resolver(); }
    bote_fetch_put_int(rec, sandhi_http_err_kind(r));
    bote_fetch_put_int(rec, sandhi_http_status(r));
    if (r == 0 || sandhi_http_err_kind(r) != SANDHI_OK) { return bote_fetch_put_str(rec, 0); }
    return bote_fetch_put_bytes(rec, sandhi_http_body(r), sandhi_http_body_len(r));
}

# Why sandhi's error kind `kind` failed a fetch.
fn _jwks_kind_reason(kind) {
    if (kind == SANDHI_ERR_CONNECT) { return "could not connect to the jwks_uri"; }
    if (kind == SANDHI_ERR_TLS) { return "TLS to the jwks_uri failed: an untrusted or wrong certificate"; }
    if (kind == SANDHI_ERR_TIMEOUT) { return "the jwks_uri did not answer in time"; }
    if (kind == SANDHI_ERR_DISCOVERY) { return "the jwks_uri's host has no IPv4 address"; }
    if (kind == SANDHI_ERR_PROTOCOL) { return "the jwks_uri gave no HTTP reply bote can read, or one over BOTE_JWKS_MAX"; }
    return "the request to the jwks_uri failed";
}

# "the jwks_uri answered HTTP <status>", on the request arena.
fn _jwks_status_reason(status) {
    var lead = "the jwks_uri answered HTTP ";
    var ll = strlen(lead);
    var out = alloc_via(bote_req_alloc(), ll + 24);
    memcpy(out, lead, ll);
    var digits[24];
    var n = 0;
    var v = status;
    if (v < 0) { v = 0; }
    while (n == 0 || v > 0) {
        store8(&digits + n, 48 + v % 10);
        v = v / 10;
        n = n + 1;
    }
    var i = 0;
    while (i < n) {
        store8(out + ll + i, load8(&digits + n - 1 - i));
        i = i + 1;
    }
    store8(out + ll + n, 0);
    return out;
}

# The key source: the JWK Set at the source's URL, on the request arena, or 0 with why
# written through `why_out`. A reply other than 200, or a body holding a NUL, is refused.
fn bote_jwks_fetch(src, why_out) {
    var cur[24];
    if (bote_fetch_in_child(&_jwks_child, src, BOTE_JWKS_MAX + 64, BOTE_JWKS_TIMEOUT_MS, &cur) == 0) {
        if (streq(bote_fetch_why(), "deadline") == 1) {
            store64(why_out, "the jwks_uri did not answer in time");
        } else {
            store64(why_out, "the request to the jwks_uri did not finish");
        }
        return 0;
    }
    var kind = bote_fetch_int(&cur);
    var status = bote_fetch_int(&cur);
    var bl[8];
    var body = bote_fetch_str(&cur, &bl);
    if (kind != SANDHI_OK) { store64(why_out, _jwks_kind_reason(kind)); return 0; }
    if (status != 200) { store64(why_out, _jwks_status_reason(status)); return 0; }
    if (body == 0 || strlen(body) != load64(&bl)) { store64(why_out, "the jwks_uri's reply holds a NUL"); return 0; }
    return body;
}

# --- http_era.cyr ---

# bote::http_era — which MCP era an HTTP request belongs to, and what the
# 2026-07-28 revision asks of one that is modern.
#
# One endpoint serves both eras. `MCP-Protocol-Version` and `_meta` say which a
# POST is: bote_http_era reads them once the body is in hand, because a refusal
# has to carry the request's id, and either refuses the POST or hands it to the
# legacy path or to bote_http_serve_modern. The dispatcher already routes on
# `_meta`; what lives here is what only HTTP has, the headers and the status codes.
#
# Every refusal here has a JSON-RPC error in its body. That is how a client tells
# a modern server from a legacy one: a 400 without a recognized error sends it
# back to `initialize`.

var BOTE_RPC_HEADER_MISMATCH = 0 - 32020;
var BOTE_HTTP_ACCEPTED = 202;

var BOTE_HTTP_LEGACY = 0;
var BOTE_HTTP_MODERN = 1;
var BOTE_HTTP_REFUSED = 2;

# The largest integer an `x-mcp-header` value may be: 2^53 - 1.
var BOTE_SAFE_INT = 9007199254740991;

# What every reply here needs. On the caller's stack, 40 bytes:
#   +0  cfd
#   +8  transport  name, for the log
#   +16 buf        the request as read
#   +24 n          its length
#   +32 extra      response headers, or 0
fn bote_http_ctx(hc, cfd, transport, buf, n, extra) {
    store64(hc, cfd);
    store64(hc + 8, transport);
    store64(hc + 16, buf);
    store64(hc + 24, n);
    store64(hc + 32, extra);
    return hc;
}

fn _he_cfd(hc) { return load64(hc); }
fn _he_transport(hc) { return load64(hc + 8); }
fn _he_buf(hc) { return load64(hc + 16); }
fn _he_n(hc) { return load64(hc + 24); }
fn _he_extra(hc) { return load64(hc + 32); }

# ================================================================
# Refusing with a JSON-RPC error in the body
# ================================================================

fn _he_status_text(status) {
    if (status == HTTP_OK) { return "OK"; }
    if (status == HTTP_BAD_REQUEST) { return "Bad Request"; }
    if (status == HTTP_NOT_FOUND) { return "Not Found"; }
    return "Internal Server Error";
}

fn _he_refuse_json(hc, level, status, reason, json) {
    bote_http_log_refusal(level, _he_transport(hc), status, reason);
    sandhi_server_send_response_a(bote_req_alloc(), _he_cfd(hc), status, _he_status_text(status),
      "application/json", json, strlen(json), _he_extra(hc));
    return BOTE_HTTP_REFUSED;
}

fn _he_refuse(hc, level, status, reason, id, code, msg) {
    var a = bote_req_alloc();
    return _he_refuse_json(hc, level, status, reason,
      codec_serialize_response_a(a, resp_error_a(a, id, code, msg)));
}

# 400 + -32020: what every header failure is.
fn _he_refuse_header(hc, reason, id, msg) {
    return _he_refuse(hc, SK_WARN, HTTP_BAD_REQUEST, reason, id, BOTE_RPC_HEADER_MISMATCH, msg);
}

# "Header mismatch: Mcp-Name header value 'foo' does not match body value 'bar'",
# as the spec's example has it.
fn _he_mismatch_msg_a(a, header, hv, bv) {
    var sb = str_builder_new_a(a);
    str_builder_add_cstr_a(a, sb, "Header mismatch: ");
    str_builder_add_cstr_a(a, sb, header);
    str_builder_add_cstr_a(a, sb, " header value '");
    str_builder_add_cstr_a(a, sb, hv);
    str_builder_add_cstr_a(a, sb, "' does not match body value '");
    str_builder_add_cstr_a(a, sb, bv);
    str_builder_add_cstr_a(a, sb, "'");
    return str_data(str_builder_build_a(a, sb));
}

# The request's id for a refusal, when it can be read. The extractors trust their
# input, so a body that is not JSON has none.
fn _he_id_a(a, body) {
    if (jsonx_valid(body, strlen(body)) == 0) { return "null"; }
    var id = jsonx_get_raw_a(a, body, "id");
    if (id == 0 || _cdc_id_ok(id) == 0) { return "null"; }
    return id;
}

# ================================================================
# Reading a header's value
# ================================================================

# `name`'s value, without the whitespace RFC 9110 does not count as part of it.
# sandhi leaves tabs and a trailing space. 0 when absent.
fn _he_header_a(a, buf, n, name) {
    var v = sandhi_server_find_header_a(a, buf, n, name);
    if (v == 0) { return 0; }
    while (load8(v) == 32 || load8(v) == 9) { v = v + 1; }
    var e = strlen(v);
    while (e > 0 && (load8(v + e - 1) == 32 || load8(v + e - 1) == 9)) { e = e - 1; }
    store8(v + e, 0);
    return v;
}

# 1 when the header `name` is on more than one line. Lines of one field combine into
# one comma-separated value (RFC 9110 §5.3), which no body value matches, and a proxy
# that reads the last line would otherwise act on one bote never compared.
fn _he_repeated(hc, name) {
    var buf = _he_buf(hc);
    var n = _he_n(hc);
    var nlen = strlen(name);
    var seen = 0;
    var i = 0;
    while (i < n) {
        # Past the line ending, so the request line is never read as a header.
        while (i < n && load8(buf + i) != 10) { i = i + 1; }
        i = i + 1;
        if (i + nlen >= n || load8(buf + i) == 13 || load8(buf + i) == 10) { return 0; }
        if (load8(buf + i + nlen) == 58 && _hsv_iceq(buf + i, name, nlen) == 1) {
            seen = seen + 1;
            if (seen > 1) { return 1; }
        }
    }
    return 0;
}

# 1 when the value `v` of the header `name` can be read: on one line, and holding
# only what a field value may, visible ASCII, space and tab.
fn _he_field_ok(hc, name, v) {
    var i = 0;
    var c = load8(v);
    while (c != 0) {
        if (c != 9 && (c < 32 || c > 126)) { return 0; }
        i = i + 1;
        c = load8(v + i);
    }
    if (_he_repeated(hc, name) == 1) { return 0; }
    return 1;
}

# The value of `ch` in the standard Base64 alphabet, or -1.
fn _he_b64_val(ch) {
    if (ch >= 65 && ch <= 90) { return ch - 65; }
    if (ch >= 97 && ch <= 122) { return ch - 71; }
    if (ch >= 48 && ch <= 57) { return ch + 4; }
    if (ch == 43) { return 62; }
    if (ch == 47) { return 63; }
    return 0 - 1;
}

# The standard Base64 at p[0, n) as a cstr on `a`, or 0 when it is not canonical
# Base64 or decodes to a NUL, which a cstr cannot hold. Not bayan_base64_decode:
# that keeps its output on the heap, which never frees, and this is a client's
# header on a path that may refuse it.
fn _he_b64_decode_a(a, p, n) {
    if (n % 4 != 0) { return 0; }
    var pad = 0;
    while (pad < 2 && n > 0 && load8(p + n - 1) == 61) {
        n = n - 1;
        pad = pad + 1;
    }
    var out = alloc_via(a, (n / 4) * 3 + 3);
    var acc = 0;
    var bits = 0;
    var o = 0;
    var i = 0;
    while (i < n) {
        var v = _he_b64_val(load8(p + i));
        if (v < 0) { return 0; }
        acc = ((acc << 6) | v) & 0xFFFFFF;
        bits = bits + 6;
        if (bits >= 8) {
            bits = bits - 8;
            var b = (acc >> bits) & 255;
            if (b == 0) { return 0; }
            store8(out + o, b);
            o = o + 1;
        }
        i = i + 1;
    }
    if ((acc & ((1 << bits) - 1)) != 0) { return 0; }
    store8(out + o, 0);
    return out;
}

# What `Mcp-Name` or an `Mcp-Param` header says: the value as sent, or a
# `=?base64?…?=` sentinel decoded. The markers are case-sensitive, so anything else
# is a plain value. 0 when a sentinel does not decode.
fn _he_field_value_a(a, v) {
    var n = strlen(v);
    if (n < 11 || memeq(v, "=?base64?", 9) == 0 || memeq(v + n - 2, "?=", 2) == 0) { return v; }
    return _he_b64_decode_a(a, v + 9, n - 11);
}

# The params key `Mcp-Name` mirrors for `method`, or 0 when it has none.
fn _he_name_key(method) {
    if (streq(method, "tools/call") == 1) { return "name"; }
    if (streq(method, "prompts/get") == 1) { return "name"; }
    if (streq(method, "resources/read") == 1) { return "uri"; }
    return 0;
}

# ================================================================
# The version a request names
# ================================================================

# `MCP-Protocol-Version` against what bote speaks. Sends the refusal and returns
# BOTE_HTTP_REFUSED, or returns 0. With no header: a client of 2025-03-26 or earlier
# never sends one, and bote serves those revisions, so it passes unless `require`.
# `body` is read only for a refusal's id: "" when a request has none.
fn bote_http_check_version(hc, hv, require, body) {
    var a = bote_req_alloc();
    if (hv == 0) {
        if (require == 0) { return 0; }
        return _he_refuse_header(hc, "protocol_version_missing", _he_id_a(a, body), "missing required header: MCP-Protocol-Version");
    }
    if (bote_protocol_known(hv) == 1) { return 0; }
    return _he_refuse_json(hc, SK_DEBUG, HTTP_BAD_REQUEST, "protocol_version",
      codec_serialize_response_a(a, _dsp_unsupported_version(a, _he_id_a(a, body), hv)));
}

# The version `body` names in `params._meta`, or 0.
fn _he_body_version_a(a, body) {
    var meta = jsonx_get_raw_a(a, jsonx_get_raw_a(a, body, "params"), "_meta");
    return jsonx_get_str_dec_a(a, meta, DSP_META_VERSION);
}

# 1 when an element of the batch `body` names the modern revision. A POST carries
# one message on that revision, and a batch has no headers of its own to check.
fn _he_batch_is_modern(a, body) {
    var elems = _cdc_split_array(a, body);
    var i = 0;
    while (i < vec_len(elems) && i < CODEC_MAX_BATCH) {
        var ev = _he_body_version_a(a, vec_get(elems, i));
        if (ev != 0 && _mcp_is_modern(ev) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# The modern path
# ================================================================

# 1 when the header text `hv` says what the argument `raw` holds, its raw JSON. A
# string is compared decoded and an integer by value, so `42.0` is `42`. A NUL is
# something no header can say, an integer outside the safe range is not allowed one,
# and an object or an array has no text to compare.
fn _he_param_matches(a, hv, raw) {
    var c = load8(raw);
    if (c == 34) {
        var n = strlen(raw) - 2;
        var out = alloc_via(a, n + 1);
        if (_jx_unescape_into(raw + 1, n, out) != strlen(out)) { return 0; }
        return streq(hv, out);
    }
    if (c == 123 || c == 91) { return 0; }
    if (c == 116 || c == 102) { return streq(hv, raw); }
    var bv[8];
    if (_sch_num_parse(raw, &bv) != 2) { return streq(hv, raw); }
    if (load64(&bv) > BOTE_SAFE_INT || load64(&bv) < 0 - BOTE_SAFE_INT) { return 0; }
    var hlen = strlen(hv);
    if (_jx_valid_number(hv, hlen, 0) != hlen) { return 0; }
    var nv[8];
    if (_sch_num_parse(hv, &nv) != 2 || load64(&nv) != load64(&bv)) { return 0; }
    return 1;
}

# What `args` holds at `path`, as raw JSON, or 0 when nothing is there. A `null` is
# nothing, as the spec has it: a client sends no header for one.
fn _he_arg_at_a(a, args, path) {
    var v = args;
    var i = 0;
    while (i < vec_len(path)) {
        v = jsonx_get_raw_a(a, v, vec_get(path, i));
        if (v == 0) { return 0; }
        i = i + 1;
    }
    if (streq(v, "null") == 1) { return 0; }
    return v;
}

# "Mcp-Param-Region does not match the body", and the like. Neither side's value
# goes in: an argument is the caller's, and this text can reach a log downstream.
fn _he_param_msg_a(a, field, tail) {
    var sb = str_builder_new_a(a);
    str_builder_add_cstr_a(a, sb, "Header mismatch: ");
    str_builder_add_cstr_a(a, sb, field);
    str_builder_add_cstr_a(a, sb, tail);
    return str_data(str_builder_build_a(a, sb));
}

# One ParamHeader `p` of a tools/call. 0, or BOTE_HTTP_REFUSED once refused. A header
# with no value in the body refuses too: a conforming client never sends one, and
# what it says matches nothing bote would run.
fn _he_check_param(hc, id, args, p) {
    var a = bote_req_alloc();
    var field = param_header_field(p);
    var raw = _he_arg_at_a(a, args, param_header_path(p));
    var hv = _he_header_a(a, _he_buf(hc), _he_n(hc), field);
    if (hv == 0) {
        if (raw == 0) { return 0; }
        return _he_refuse_header(hc, "param_header_missing", id, _he_param_msg_a(a, field, " is missing and the body has its value"));
    }
    if (_he_field_ok(hc, field, hv) == 0) {
        return _he_refuse_header(hc, "param_header_invalid", id, _he_param_msg_a(a, field, " is malformed"));
    }
    var v = _he_field_value_a(a, hv);
    if (v == 0) {
        return _he_refuse_header(hc, "param_header_invalid", id, _he_param_msg_a(a, field, " is not valid Base64"));
    }
    if (raw == 0) {
        return _he_refuse_header(hc, "param_header_mismatch", id, _he_param_msg_a(a, field, " has no value in the body"));
    }
    if (_he_param_matches(a, v, raw) == 0) {
        return _he_refuse_header(hc, "param_header_mismatch", id, _he_param_msg_a(a, field, " does not match the body"));
    }
    return 0;
}

# The `Mcp-Param` headers of the tools/call `req` of the tool `name`, which must not be
# 0: a map's hash is seeded, so a null key crashes only on the runs where a tool has
# landed in slot 0. An unknown tool declares none, and is the dispatcher's to refuse.
fn _he_check_params(hc, req, name, dispatcher) {
    var tool = registry_get(dispatcher_registry(dispatcher), name);
    if (tool == 0) { return 0; }
    var decls = tool_def_param_headers(tool);
    if (decls == 0) { return 0; }
    var args = jsonx_get_raw_a(bote_req_alloc(), req_params(req), "arguments");
    var i = 0;
    while (i < vec_len(decls)) {
        if (_he_check_param(hc, req_id(req), args, vec_get(decls, i)) != 0) { return BOTE_HTTP_REFUSED; }
        i = i + 1;
    }
    return 0;
}

# The checks on a request that said it is modern. BOTE_HTTP_MODERN with *req_out
# set, or BOTE_HTTP_REFUSED.
fn _he_admit_modern(hc, body, bv, dispatcher, req_out) {
    var a = bote_req_alloc();
    var buf = _he_buf(hc);
    var n = _he_n(hc);
    var len = strlen(body);
    var first = _cdc_skip_ws(body, len, 0);
    if (first >= len || jsonx_valid(body, len) == 0) {
        return _he_refuse_json(hc, SK_DEBUG, HTTP_BAD_REQUEST, "parse_error", _cdc_parse_error_a(a, "invalid JSON"));
    }
    if (load8(body + first) != 123) {
        return _he_refuse_json(hc, SK_DEBUG, HTTP_BAD_REQUEST, "not_one_message",
          _cdc_invalid_request_a(a, "a POST carries one message"));
    }
    var err_slot[8];
    var req = _cdc_admit_a(a, body, &err_slot);
    if (req == 0) {
        return _he_refuse_json(hc, SK_DEBUG, HTTP_BAD_REQUEST, "invalid_request", load64(&err_slot));
    }
    # This revision defines no header requirements for a notification.
    if (req_is_notification(req) == 1) {
        store64(req_out, req);
        return BOTE_HTTP_MODERN;
    }

    var id = req_id(req);
    var method = req_method(req);
    if (bv == 0) {
        return _he_refuse(hc, SK_DEBUG, HTTP_BAD_REQUEST, "meta_missing", id, 0 - 32602,
          "_meta needs a string io.modelcontextprotocol/protocolVersion");
    }
    if (_he_repeated(hc, "MCP-Protocol-Version") == 1) {
        return _he_refuse_header(hc, "version_header_invalid", id, "malformed header: MCP-Protocol-Version");
    }

    var hm = _he_header_a(a, buf, n, "Mcp-Method");
    if (hm == 0) { return _he_refuse_header(hc, "method_header_missing", id, "missing required header: Mcp-Method"); }
    if (_he_field_ok(hc, "Mcp-Method", hm) == 0) { return _he_refuse_header(hc, "method_header_invalid", id, "malformed header: Mcp-Method"); }
    if (streq(hm, method) == 0) {
        return _he_refuse_header(hc, "method_header_mismatch", id, _he_mismatch_msg_a(a, "Mcp-Method", hm, method));
    }

    var key = _he_name_key(method);
    var bn = 0;
    if (key != 0) {
        var hn = _he_header_a(a, buf, n, "Mcp-Name");
        if (hn == 0) { return _he_refuse_header(hc, "name_header_missing", id, "missing required header: Mcp-Name"); }
        if (_he_field_ok(hc, "Mcp-Name", hn) == 0) { return _he_refuse_header(hc, "name_header_invalid", id, "malformed header: Mcp-Name"); }
        var nv = _he_field_value_a(a, hn);
        if (nv == 0) { return _he_refuse_header(hc, "name_header_invalid", id, "Mcp-Name is not valid Base64"); }
        # A body with no such field is the dispatcher's -32602.
        bn = jsonx_get_str_dec_a(a, req_params(req), key);
        if (bn != 0 && streq(nv, bn) == 0) {
            return _he_refuse_header(hc, "name_header_mismatch", id, _he_mismatch_msg_a(a, "Mcp-Name", nv, bn));
        }
    }

    # A request that named this revision named one with no `initialize`. The
    # dispatcher takes an `initialize` as legacy; here the header settles it.
    if (streq(method, "initialize") == 1) {
        return _he_refuse(hc, SK_DEBUG, HTTP_NOT_FOUND, "method", id, 0 - 32601, "method not found: initialize");
    }
    if (bn != 0 && streq(method, "tools/call") == 1 && _he_check_params(hc, req, bn, dispatcher) != 0) {
        return BOTE_HTTP_REFUSED;
    }
    store64(req_out, req);
    return BOTE_HTTP_MODERN;
}

# The status a JSON-RPC error from the dispatcher goes out with. The spec sets 404 for
# -32601 and 400 for -32020, -32021 and -32022. What it leaves open stays in-band on a
# 200: a client reads a JSON-RPC error out of a 200 or a 400 and not out of a 500, and a
# 5xx is what a proxy retries. A -32602 is a 400 only for a `_meta` field, which
# bote_http_serve_modern picks out.
fn _he_status_for(code) {
    if (code == 0 - 32601) { return HTTP_NOT_FOUND; }
    if (code == 0 - 32600 || code == 0 - 32700) { return HTTP_BAD_REQUEST; }
    if (code == BOTE_RPC_HEADER_MISMATCH || code == 0 - 32021 || code == 0 - 32022) { return HTTP_BAD_REQUEST; }
    return HTTP_OK;
}

# 202 with no body: what a notification gets, in either era.
fn bote_http_send_accepted(cfd, extra) {
    sandhi_server_send_response_a(bote_req_alloc(), cfd, BOTE_HTTP_ACCEPTED, "Accepted", "text/plain", "", 0, extra);
    return 0;
}

# MCP 2026-07-28 on Streamable HTTP: closing the response stream is the cancellation, and
# the server MUST treat a client's disconnect as one. The legacy path never asks: there a
# disconnect is not a cancellation, and bote's HTTP transports end with the response.
fn _he_cancelled(cfd, a, id) { return bote_conn_gone(cfd, 1); }

# Answer a request bote_http_era admitted. Sessions play no part: this revision
# has none, so `Mcp-Session-Id` and `Last-Event-ID` are ignored and none is minted.
fn bote_http_serve_modern(hc, req, dispatcher, claims) {
    var a = bote_req_alloc();
    var dbg = bote_log_enabled(SK_DEBUG);
    var t0 = 0;
    if (dbg == 1) { t0 = clock_now_ns(); }
    # This connection can hold a `subscriptions/listen` stream open (3.7.2), and a client
    # that closes it has cancelled its request (3.7.5).
    bote_req_set_stream(1);
    bote_req_set_cancel(&_he_cancelled, _he_cfd(hc));
    bote_req_set_request_id(req_id(req));
    var resp = dispatcher_dispatch_a(a, dispatcher, req, claims);
    bote_req_set_stream(0);
    bote_req_set_cancel(0, 0);
    if (dbg == 1) { _cdc_log_request_a(a, req, resp, t0); }
    # Nothing more goes out for a cancelled request: its client has gone.
    if (bote_req_was_cancelled() == 1) {
        bote_req_set_request_id(0);
        return 0;
    }
    bote_req_set_request_id(0);
    if (resp == 0) { return bote_http_send_accepted(_he_cfd(hc), _he_extra(hc)); }
    # A listen the dispatcher accepted opens a stream, not a reply (3.7.2, src/listen.cyr).
    if (resp_error_obj(resp) == 0 && dispatcher_listen(dispatcher) != 0 && streq(req_method(req), "subscriptions/listen") == 1) {
        var lr = bote_listen_http(dispatcher_listen(dispatcher), hc, req, resp, dispatcher);
        if (lr == 0) { return 0; }
        resp = lr;
    }
    var status = HTTP_OK;
    var err = resp_error_obj(resp);
    if (err != 0) {
        status = _he_status_for(rpc_err_code(err));
        if (streq(rpc_err_message(err), DSP_CAPS_MISSING) == 1) { status = HTTP_BAD_REQUEST; }
    }
    var json = codec_serialize_response_a(a, resp);
    sandhi_server_send_response_a(a, _he_cfd(hc), status, _he_status_text(status), "application/json", json, strlen(json), _he_extra(hc));
    return 0;
}

# ================================================================
# The era of a POST
# ================================================================

# BOTE_HTTP_LEGACY, BOTE_HTTP_MODERN with *req_out set, or BOTE_HTTP_REFUSED once
# the refusal is sent. `require` is the transport's require_protocol.
fn bote_http_era(hc, body, require, dispatcher, req_out) {
    var a = bote_req_alloc();
    store64(req_out, 0);
    var hv = _he_header_a(a, _he_buf(hc), _he_n(hc), "MCP-Protocol-Version");
    var bv = _he_body_version_a(a, body);
    var modern_body = 0;
    if (bv != 0) { modern_body = _mcp_is_modern(bv); }
    var len = strlen(body);
    var first = _cdc_skip_ws(body, len, 0);
    if (first < len && load8(body + first) == 91 && jsonx_valid(body, len) == 1 && _he_batch_is_modern(a, body) == 1) {
        return _he_refuse_json(hc, SK_DEBUG, HTTP_BAD_REQUEST, "not_one_message",
          _cdc_invalid_request_a(a, "a POST carries one message"));
    }

    # A modern request always needs the header. Without `require` a legacy one does
    # not, and even with it `initialize` does not: a client has no version to send
    # until the reply gives it one.
    if (modern_body == 1) { require = 1; }
    if (require == 1 && modern_body == 0 && hv == 0) {
        var bm = jsonx_get_str_dec_a(a, body, "method");
        if (bm != 0 && streq(bm, "initialize") == 1) { require = 0; }
    }
    if (bote_http_check_version(hc, hv, require, body) != 0) { return BOTE_HTTP_REFUSED; }
    if (hv == 0) { return BOTE_HTTP_LEGACY; }
    if (bv != 0 && streq(hv, bv) == 0) {
        return _he_refuse_header(hc, "version_header_mismatch", _he_id_a(a, body),
          _he_mismatch_msg_a(a, "MCP-Protocol-Version", hv, bv));
    }
    if (_mcp_is_modern(hv) == 0) { return BOTE_HTTP_LEGACY; }
    return _he_admit_modern(hc, body, bv, dispatcher, req_out);
}

# --- oauth_metadata.cyr ---

# bote::oauth_metadata — OAuth 2.0 Protected Resource Metadata (RFC 9728).
#
# A server that takes tokens says where they come from. MCP requires it of a protected
# server, in a document at a well-known URL that a client reads before it has a token,
# so it is served ahead of the bearer check. The Origin check still comes first.
#
# The resource identifier comes from the operator and never from a request. A client
# refuses a document whose `resource` is not the URL it asked for, and that comparison
# is its defence against impersonation (RFC 9728 §7.3), so `Host` is not read here: bote
# cannot know its public URL behind a proxy, and a client chooses what `Host` says.
#
# bote is the resource server and not the authorization server. It names the servers
# that issue its tokens and takes no part in the flow.
#
# A token that lacks a tool's scope is answered here too, with the same metadata in its
# challenge: bote_http_scope_gate. The check itself is the dispatcher's.
#
# The document and the challenge a 401 carries are built once, here, so a request
# allocates nothing for them. A bearer validator is what enforces a token: configuring
# this says where to get one and requires nothing.

var BOTE_PRM_WELL_KNOWN = "/.well-known/oauth-protected-resource";

# ================================================================
# Checking what the operator wrote
# ================================================================

# 1 when `c` may stand in one of these URLs: what RFC 3986 allows outside a query, a
# fragment and userinfo. Each of these URLs goes out inside a quoted header parameter
# too, so this is also what keeps a value from ending the parameter or the line.
fn _prm_url_char(c) {
    if (c <= 32 || c >= 127) { return 0; }
    if (c == 34 || c == 35 || c == 60 || c == 62 || c == 63 || c == 64) { return 0; }
    if (c == 92 || c == 94 || c == 96 || c == 123 || c == 124 || c == 125) { return 0; }
    return 1;
}

# Where the host of `url` starts, or 0 unless `url` is one bote can publish: https, or
# http on this machine. RFC 9728 makes a resource identifier an https URL, and MCP
# serves an authorization server over https. A loopback server has no certificate to
# show, and the traffic does not leave the machine.
fn _prm_host_at(url) {
    var at = 0;
    if (memeq(url, "https://", 8) == 1) { at = 8; }
    elif (memeq(url, "http://", 7) == 1) {
        var n = _ses_loopback_len(url + 7);
        if (n == 0) { return 0; }
        var c = load8(url + 7 + n);
        if (c != 0 && c != 58 && c != 47) { return 0; }
        at = 7;
    }
    if (at == 0) { return 0; }
    var first = load8(url + at);
    if (first == 0 || first == 47 || first == 58) { return 0; }
    var i = at;
    while (load8(url + i) != 0) {
        if (_prm_url_char(load8(url + i)) == 0) { return 0; }
        i = i + 1;
    }
    return at;
}

# Why these cannot be published, as a message, or 0 when they can. A refresh token is
# not a resource requirement, so MCP says to leave `offline_access` out. Public, so a
# caller can say why before it builds one.
fn bote_prm_check(resource, servers, scopes) {
    if (resource == 0 || _prm_host_at(resource) == 0) {
        return "the resource must be an https URL, or http on loopback, with no query, fragment or userinfo";
    }
    if (servers == 0 || vec_len(servers) == 0) { return "at least one authorization server is required"; }
    var i = 0;
    while (i < vec_len(servers)) {
        var s = vec_get(servers, i);
        if (s == 0 || _prm_host_at(s) == 0) {
            return "an authorization server must be an https URL, or http on loopback, with no query, fragment or userinfo";
        }
        i = i + 1;
    }
    if (scopes != 0) {
        i = 0;
        while (i < vec_len(scopes)) {
            var sc = vec_get(scopes, i);
            if (bote_scope_token_ok(sc) == 0) { return "a scope must be a non-empty token with no space, quote or backslash"; }
            if (streq(sc, "offline_access") == 1) { return "offline_access is not a resource's to require"; }
            i = i + 1;
        }
    }
    return 0;
}

# ================================================================
# ProtectedResource — built once, read by every request
# ================================================================
#
# Layout (40 bytes):
#   +0  path       cstr, where the document is served
#   +8  json       cstr, the document
#   +16 json_len
#   +24 challenge  cstr, what a 401 says after `Bearer`
#   +32 metadata   cstr, the `resource_metadata` parameter, for a 403 to use

# RFC 9728 §3.1: the well-known path, then the resource's path, with a lone `/` gone.
fn _prm_path(resource) {
    var p = resource + _prm_host_at(resource);
    while (load8(p) != 0 && load8(p) != 47) { p = p + 1; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, BOTE_PRM_WELL_KNOWN);
    if (streq(p, "/") == 0) { str_builder_add_cstr(sb, p); }
    return str_data(str_builder_build(sb));
}

fn _prm_add_array(sb, key, v) {
    str_builder_add_cstr(sb, ",\"");
    str_builder_add_cstr(sb, key);
    str_builder_add_cstr(sb, "\":[");
    var i = 0;
    while (i < vec_len(v)) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "\"");
        bote_json_escape(sb, vec_get(v, i));
        str_builder_add_cstr(sb, "\"");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]");
    return 0;
}

# `resource_metadata` must be absolute, and its scheme and host are the identifier's.
fn _prm_metadata(resource, path) {
    var hostlen = _prm_host_at(resource);
    while (load8(resource + hostlen) != 0 && load8(resource + hostlen) != 47) { hostlen = hostlen + 1; }
    var origin = alloc(hostlen + 1);
    memcpy(origin, resource, hostlen);
    store8(origin + hostlen, 0);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "resource_metadata=\"");
    str_builder_add_cstr(sb, origin);
    str_builder_add_cstr(sb, path);
    str_builder_add_cstr(sb, "\"");
    return str_data(str_builder_build(sb));
}

fn _prm_challenge(metadata, scopes) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, metadata);
    if (scopes != 0 && vec_len(scopes) > 0) {
        str_builder_add_cstr(sb, ", scope=\"");
        var i = 0;
        while (i < vec_len(scopes)) {
            if (i > 0) { str_builder_add_cstr(sb, " "); }
            str_builder_add_cstr(sb, vec_get(scopes, i));
            i = i + 1;
        }
        str_builder_add_cstr(sb, "\"");
    }
    return str_data(str_builder_build(sb));
}

# A ProtectedResource, or 0 when bote_prm_check refuses these. `resource` is the MCP
# endpoint's public URL, exactly as a client reaches it. `servers` and `scopes` are vecs
# of cstrs, and `scopes` and `name` may be 0.
fn bote_prm_new(resource, servers, scopes, name) {
    if (bote_prm_check(resource, servers, scopes) != 0) { return 0; }
    var path = _prm_path(resource);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"resource\":\"");
    bote_json_escape(sb, resource);
    str_builder_add_cstr(sb, "\"");
    _prm_add_array(sb, "authorization_servers", servers);
    if (scopes != 0 && vec_len(scopes) > 0) { _prm_add_array(sb, "scopes_supported", scopes); }
    str_builder_add_cstr(sb, ",\"bearer_methods_supported\":[\"header\"]");
    if (name != 0) {
        str_builder_add_cstr(sb, ",\"resource_name\":\"");
        bote_json_escape(sb, name);
        str_builder_add_cstr(sb, "\"");
    }
    str_builder_add_cstr(sb, "}");
    var json = str_data(str_builder_build(sb));
    var metadata = _prm_metadata(resource, path);
    var p = alloc(40);
    store64(p, path);
    store64(p + 8, json);
    store64(p + 16, strlen(json));
    store64(p + 24, _prm_challenge(metadata, scopes));
    store64(p + 32, metadata);
    return p;
}

fn bote_prm_path(p) { return load64(p); }
fn bote_prm_json(p) { return load64(p + 8); }

# What a 401 says, or 0 with no metadata configured, which leaves the plain challenge.
fn bote_prm_challenge(p) {
    if (p == 0) { return 0; }
    return load64(p + 24);
}

# The `resource_metadata` parameter, or 0 with none configured.
fn bote_prm_metadata(p) {
    if (p == 0) { return 0; }
    return load64(p + 32);
}

# ================================================================
# Serving it
# ================================================================

# Answer this request if it is for the document. 1 when it has been answered, however,
# and 0 when it is not for the document, which with none configured costs one compare.
fn bote_prm_route(hc, p, method, path, allowed_origins) {
    if (p == 0) { return 0; }
    var a = bote_req_alloc();
    if (streq(sandhi_server_path_only_a(a, path), bote_prm_path(p)) == 0) { return 0; }
    var cfd = _he_cfd(hc);
    var transport = _he_transport(hc);
    var buf = _he_buf(hc);
    var n = _he_n(hc);
    var origin = sandhi_server_find_header_a(a, buf, n, "Origin");
    if (bote_http_origin_ok(origin, allowed_origins, buf, n) == 0) {
        bote_http_refuse(cfd, SK_WARN, transport, HTTP_FORBIDDEN, "Forbidden", "origin");
        return 1;
    }
    # Past the Origin check, every reply carries the context's headers: the bridge's CORS.
    if (sandhi_server_find_header_a(a, buf, n, "Transfer-Encoding") != 0) {
        bote_http_refuse_hdr(cfd, SK_WARN, transport, HTTP_BAD_REQUEST, "Bad Request", "transfer_encoding", _he_extra(hc));
        return 1;
    }
    if (streq(method, "GET") == 0) {
        bote_http_refuse_method_hdr(cfd, transport, "Allow: GET\r\n", _he_extra(hc));
        return 1;
    }
    sandhi_server_send_response_a(a, cfd, HTTP_OK, "OK", "application/json",
      bote_prm_json(p), load64(p + 16), _he_extra(hc));
    return 1;
}

# ================================================================
# A token that lacks a scope
# ================================================================

# Answer a request this token may not make with a 403, ahead of the dispatcher, which has
# no status to send: a tools/call, a prompts/get, a resources/read, or a
# completion/complete for a prompt or a template the token may not reach (3.6.6). 1 when
# it has been answered. The scopes come from the dispatcher's own functions, so the two
# cannot judge one request differently. A batch is the dispatcher's alone: one message
# cannot carry two statuses, and that is why the check lives there as well as here. A body
# that is no JSON is the codec's to refuse, and a notification gets no reply.
fn bote_http_scope_gate(hc, dispatcher, body, claims, p) {
    if (claims == 0) { return 0; }
    if (jsonx_valid(body, strlen(body)) == 0 || jsonx_has(body, "id") == 0) { return 0; }
    var a = bote_req_alloc();
    var method = jsonx_get_str_dec_a(a, body, "method");
    if (method == 0) { return 0; }
    var params = jsonx_get_raw_a(a, body, "params");
    var scopes = 0;
    if (streq(method, "tools/call") == 1) {
        var name = jsonx_get_str_dec_a(a, params, "name");
        if (name == 0) { return 0; }
        scopes = dispatcher_scopes_missing(dispatcher, name, claims);
        if (scopes == 0) { return 0; }
        var plen = strlen(params);
        _dsp_record_refusal(dispatcher, name, params, plen, _jx_find_value_pos(params, plen, "caller_id"),
          _dsp_named_msg_a(a, "insufficient scope for tool: ", name, 0));
    } elif (streq(method, "prompts/get") == 1) {
        scopes = dispatcher_prompt_scopes_missing(dispatcher, jsonx_get_str_dec_a(a, params, "name"), claims);
    } elif (streq(method, "resources/read") == 1) {
        scopes = dispatcher_resource_scopes_missing(dispatcher, jsonx_get_str_dec_a(a, params, "uri"), claims);
    } elif (streq(method, "completion/complete") == 1) {
        if (dispatcher_completion(dispatcher) == 0) { return 0; }
        scopes = dispatcher_completion_scopes_missing_a(a, dispatcher, params, claims);
    }
    if (scopes == 0) { return 0; }
    bote_http_log_refusal(SK_WARN, _he_transport(hc), HTTP_FORBIDDEN, "insufficient_scope");
    auth_send_insufficient_scope(_he_cfd(hc), scopes, bote_prm_metadata(p), _he_extra(hc));
    return 1;
}

# --- listen.cyr ---

# bote::listen — `subscriptions/listen` streams, held off the serving threads (3.7.2).
#
# MCP 2026-07-28 replaces the GET stream with `subscriptions/listen`: a client names the
# changes it wants, each opt-in, and the server answers with a stream that stays open. On
# HTTP that is a text/event-stream response. Its first message is
# `notifications/subscriptions/acknowledged`, naming what the server agreed to honor; then
# one notification for each change of a kind it honors; a `: keepalive` comment every
# BOTE_LISTEN_KEEPALIVE_MS; and a result only when the server ends the stream, which here
# is only when nothing asked for can be honored. Every message on it carries the listen
# request's id in `_meta`, under `io.modelcontextprotocol/subscriptionId`.
#
# A stream held by the thread that answered it would hold a worker, or a one-loop server,
# for as long as it is open. So a hub holds them instead. The worker writes the response's
# head and the acknowledgement, hands a duplicate of the socket to one of the hub's slots,
# and goes back to serving, sandhi closing its own copy. One hub thread, started by the
# first stream, waits on every parked socket and on a wake pipe: a client that closes, or
# sends anything at all, is gone, and its slot is free. A change any thread publishes
# through the hub's sink is a bit, so changes of one kind coalesce: a list's change says
# only that it changed. The thread writes each stream its frame, never blocking: a write
# the socket cannot take whole is a client that has stopped reading, and its stream ends.
#
# A stream keeps nothing: the slots are made with the hub, frames are built in its own
# buffers, and the id is copied into the slot, which bounds it at BOTE_LISTEN_ID_MAX.
#
# agnos runs its threads one at a time, so a hub thread there would hold the server: there
# is no hub, and the method is not found.
#
# ListenHub (160 B):
#   +0  lock          a mutex over the slots
#   +8  slots         `max` of BOTE_LISTEN_SLOT_BYTES
#   +16 max
#   +24 open          slots holding a stream
#   +32 pending       BOTE_LISTEN_* bits of the changes waiting to go out, set by any thread
#   +40 wake_rd       the hub thread's end of its wake pipe
#   +48 wake_wr
#   +56 started       1 once the hub thread runs
#   +64 keepalive_ms
#   +72 next          the EventSink the hub's sink passes every event on to, or 0
#   +80 pollfds       max + 1 of them, the hub thread's own
#   +88 frame         BOTE_LISTEN_FRAME_MAX bytes, the hub thread's own
#   +96 polled        max + 1 slot pointers, beside the pollfds
# A slot (BOTE_LISTEN_SLOT_BYTES): +0 fd, -1 when free and -2 while a worker opens it,
# +8 the BOTE_LISTEN_* bits it honors, +16 the id's length, +24 the id, a raw JSON literal,
# (3.7.4) +280 its room for the URIs of `resourceSubscriptions` it honors, made the first
# time a stream on the slot has any and kept for the next, so a stream allocates nothing
# after the first, +288 the bytes used there, +296 how many, each a decoded string and NUL,
# (3.7.4) +304 the BOTE_LISTEN_* kinds it is owed: changes made while it was being opened,
# (3.7.5) +312 1 when its listen was judged with claims, +320 the dispatcher that judged it.
# In the room each URI is a flag byte, the URI and its NUL: the flag is 1 when what serves
# the URI required a scope as it was kept, which the listen's claims held.
#
# A resource that requires a scope (3.7.5): the dispatcher honors no URI the listen's claims
# may not read, and a stream whose listen was made with claims is told of an update to a
# URI that requires a scope only when it holds that URI exactly, kept with its flag: a
# stream keeps no token, so a URI under one it holds, or a scope added since, it is not
# told of. Less than happened, for a scope it may hold, and never more than its token may
# read. A stream made with no claims compares nothing, as resources/read does.
#
# A resource's update (3.7.4, dispatcher_resource_updated) comes from any thread with a URI,
# and is queued: at most BOTE_LISTEN_QUEUE URIs, each one once, under a lock. The thread that
# writes the streams takes the queue and tells each subscription of every URI it covers.
# With no stream open an update is kept for nobody; one too long to queue, or one arriving
# with the queue full, overflows it, and each subscription is then told of every URI it
# holds: more than happened, never less. A hub and a ListenLine share these fields:
#   +104 queue        BOTE_LISTEN_QUEUE entries of BOTE_LISTEN_ENTRY bytes
#   +112 queued       how many
#   +120 overflowed   1 once one could not be queued
#   +128 its lock     the hub's mutex, or the line's own
#   +136 scratch      where the writing thread takes the queue to
#   +144 arena        the writing thread's, for the frames, rewound at each pass
#   +152 seen         every change and update counted, whether or not a stream is open
#
# A change made while a stream is being opened must reach it (3.7.4): the client lists after
# its acknowledgement, so a change before the acknowledgement is in what it lists, and one
# after must be told. A ListenLine counts a subscription open before it writes the
# acknowledgement, and only its own loop writes, after the message. A hub's worker writes the
# acknowledgement and the hub thread the changes, so the hub thread may not write first: the
# worker reads `seen` before it sends anything, and a stream parked with `seen` moved since is
# owed every kind it honors, which the hub thread then tells it. More than happened, never less.
#
# Where the connection is itself the stream, on stdio, a Unix socket or a WebSocket (3.7.3),
# there is no hub thread: a ListenLine holds that connection's subscriptions, and the loop
# that serves the connection writes their changes, between its replies. Each subscription is
# a slot as above, its +0 1 while it is open. The transport hands the codec the line's
# BoteStream for each message (bote_listen_line_begin), and the codec gives it a listen the
# dispatcher accepted and a `notifications/cancelled` (src/codec.cyr). The loop waits on its
# connection and on the line's wake pipe at once (bote_listen_line_await), so a change made
# on another thread is written while the connection is quiet. The acknowledgement is the
# listen's first message on the connection, as on HTTP, and `notifications/cancelled` naming
# the listen's id ends it, after which the server sends nothing more for it.
#
# ListenLine (160 B), its middle laid out as a hub's, so the sink and the wake pipe are
# shared, and its tail (3.7.4) as a hub's, so the update queue is:
#   +0  stream        its BoteStream (src/protocol.cyr)
#   +8  slots         `max` of BOTE_LISTEN_SLOT_BYTES
#   +16 max
#   +24 open          slots holding a subscription
#   +32 pending       as a hub's
#   +40 wake_rd
#   +48 wake_wr
#   +56 dispatcher    the connection's, set when one is attached
#   +64 write         fn(ctx, json) → 0, or below 0 when the connection would not take it
#   +72 next          as a hub's
#   +80 write ctx
#   +88 frame         BOTE_LISTEN_FRAME_MAX bytes
#   +96 broken        1 once a write to the connection failed (3.7.4)

var BOTE_LISTEN_MAX_DEFAULT = 256;
var BOTE_LISTEN_KEEPALIVE_MS = 15000;
var BOTE_LISTEN_ID_MAX = 256;
var BOTE_LISTEN_SLOT_BYTES = 328;
var BOTE_LISTEN_FRAME_MAX = 1024;
var BOTE_LISTEN_SUB_KEY = "io.modelcontextprotocol/subscriptionId";
var BOTE_LISTEN_ID_LONG = "a subscriptions/listen id is at most 256 bytes";
var BOTE_LISTEN_ID_OPEN = "a subscriptions/listen with this id is open";
var BOTE_LISTEN_FULL = "Subscription limit reached";
var BOTE_LISTEN_HELD = "internal error: the stream could not be held open";
var BOTE_LISTEN_MAX_BOUND = 65536;
var BOTE_LISTEN_QUEUE = 16;
var BOTE_LISTEN_OWED = 16;      # a pending bit: a stream parked is owed what it honors
var BOTE_LISTEN_ENTRY = 1032;   # one queued URI: BOTE_LISTEN_URI_MAX bytes and its NUL, rounded
var BOTE_LISTEN_SSE_PRE = "event: message\ndata: ";
var BOTE_LISTEN_SSE_POST = "\n\n";

# The change a published topic is, as a BOTE_LISTEN_* bit, or 0.
fn _bl_kind(topic) {
    if (streq(topic, TOPIC_TOOL_REGISTERED()) == 1 || streq(topic, TOPIC_TOOL_DEREGISTERED()) == 1) { return BOTE_LISTEN_TOOLS; }
    if (streq(topic, TOPIC_PROMPT_REGISTERED()) == 1) { return BOTE_LISTEN_PROMPTS; }
    if (streq(topic, TOPIC_RESOURCE_REGISTERED()) == 1) { return BOTE_LISTEN_RESOURCES; }
    return 0;
}

# The notification a BOTE_LISTEN_* bit sends.
fn _bl_method(bit) {
    if (bit == BOTE_LISTEN_TOOLS) { return "notifications/tools/list_changed"; }
    if (bit == BOTE_LISTEN_PROMPTS) { return "notifications/prompts/list_changed"; }
    return "notifications/resources/list_changed";
}

fn bote_listen_open(h) {
    if (h == 0) { return 0; }
    return atomic_load(h + 24);
}

fn bote_listen_hub_with_keepalive(h, ms) {
    if (h != 0 && ms > 0) { store64(h + 64, ms); }
    return h;
}

#ifdef CYRIUS_TARGET_AGNOS
fn bote_listen_hub_new(max) { return 0; }
fn bote_listen_sink(h, next) { return next; }
fn bote_listen_http(h, hc, req, resp, d) { return resp_error_a(bote_req_alloc(), req_id(req), 0 - 32601, "method not found: subscriptions/listen"); }
fn bote_listen_line_new(max) { return 0; }
fn bote_listen_line_begin(c) { return bote_req_begin(); }
fn bote_listen_line_attach(c, d, write_fp, ctx) { return 0; }
fn bote_listen_line_detach(c) { return 0; }
fn bote_listen_line_await(c, fd, deadline) { return 1; }
fn bote_listen_line_wait(c, fd, deadline) { return 1; }
fn bote_listen_line_deliver(c) { return 0; }
fn bote_listen_line_broken(c) { return 0; }
#endif

#ifndef CYRIUS_TARGET_AGNOS
var _BL_POLLIN = 1;
var _BL_SEND = 16448;   # MSG_DONTWAIT | MSG_NOSIGNAL, the same on both Linux arches

fn _bl_nonblock(fd) {
    var fl = sys_fcntl(fd, F_GETFL, 0);
    if (fl < 0) { return fl; }
    return sys_fcntl(fd, F_SETFL, fl | O_NONBLOCK);
}

# What a stream or a wake pipe holds lives for hours, so no program an embedder's runner
# executes inherits it (3.7.3): close-on-exec, and the wake pipe's ends non-blocking too.
# A child forked with no exec still holds them until it exits. The duplicate of a stream's
# socket is made with F_DUPFD_CLOEXEC (1030 on Linux), through `_bl_dup_cmd`, which a test
# makes fail.
var _bl_dup_cmd = 1030;

fn _bl_wake_end(fd) {
    sys_fcntl(fd, F_SETFD, FD_CLOEXEC);
    return _bl_nonblock(fd);
}

# What starts the hub thread, thread_create unless a test makes it fail.
var _bl_spawn = &thread_create;

# A hub for at most `max` streams, or 0 for none.
fn bote_listen_hub_new(max) {
    if (max <= 0) { return 0; }
    var h = alloc(160);
    var slots = alloc(max * BOTE_LISTEN_SLOT_BYTES);
    var pfd = alloc((max + 1) * 8);
    var polled = alloc((max + 1) * 8);
    var frame = alloc(BOTE_LISTEN_FRAME_MAX);
    var fds[8];
    if (h == 0 || slots == 0 || pfd == 0 || polled == 0 || frame == 0 || sys_pipe(&fds) < 0) { return 0; }
    var i = 0;
    while (i < max) {
        store64(slots + i * BOTE_LISTEN_SLOT_BYTES, 0 - 1);
        store64(slots + i * BOTE_LISTEN_SLOT_BYTES + 280, 0);
        i = i + 1;
    }
    store64(h, mutex_new());
    if (_bl_updates_new(h, load64(h)) < 0) { return 0; }
    store64(h + 8, slots);
    store64(h + 16, max);
    store64(h + 24, 0);
    store64(h + 32, 0);
    store64(h + 40, load32(&fds));
    store64(h + 48, load32(&fds + 4));
    store64(h + 56, 0);
    store64(h + 64, BOTE_LISTEN_KEEPALIVE_MS);
    store64(h + 72, 0);
    store64(h + 80, pfd);
    store64(h + 88, frame);
    store64(h + 96, polled);
    _bl_wake_end(load64(h + 40));
    _bl_wake_end(load64(h + 48));
    return h;
}

# ---- the sink -------------------------------------------------------------------

# Wake the hub thread: one byte down its pipe, which a pipe already full of them needs not.
fn _bl_wake(h) {
    var b[8];
    store8(&b, 1);
    sys_write(load64(h + 48), &b, 1);
    return 0;
}

fn _bl_raise(h, bit) {
    var set = 0;
    while (set == 0) {
        var p = atomic_load(h + 32);
        set = atomic_cas(h + 32, p, p | bit);
    }
    return _bl_wake(h);
}

# A change with no stream open tells nobody, and is not kept for the first to open. It is
# counted, and the count is made visible before the open streams are read (3.7.5): a park
# does the same the other way round (_bl_park), so one of the two sees the other. Without
# the fences x86 let either read come before its own write was seen, and a change made as
# a stream parked reached nobody, 1 in about 3,500 on x86 (found by the 3.7.4 review).
fn _bl_publish(h, topic, payload) {
    var bit = _bl_kind(topic);
    if (bit != 0) {
        atomic_fetch_add(h + 152, 1);
        atomic_fence();
    }
    if (bit != 0 && atomic_load(h + 24) > 0) { _bl_raise(h, bit); }
    var next = load64(h + 72);
    if (next != 0) { event_sink_publish(next, topic, payload); }
    return 0;
}

# The EventSink that carries the dispatcher's changes to `h`'s streams, a hub's or a
# ListenLine's, and passes every event on to `next`. Its list-only flag is `next`'s, or set
# when there is none. With no hub, `next` itself.
fn bote_listen_sink(h, next) {
    if (h == 0) { return next; }
    store64(h + 72, next);
    var s = event_sink_new(&_bl_publish, h);
    event_sink_with_updated(s, &_bl_updated);
    if (next == 0 || load64(next + 16) == 1) { event_sink_set_list_only(s); }
    return s;
}

# ---- resource updates (3.7.4) -----------------------------------------------------

# A hub's or a line's update queue, its scratch and its arena, under `lock`: 0, or -1.
fn _bl_updates_new(x, lock) {
    var q = alloc(BOTE_LISTEN_QUEUE * BOTE_LISTEN_ENTRY);
    var sc = alloc(BOTE_LISTEN_QUEUE * BOTE_LISTEN_ENTRY);
    var ar = bote_req_arena_new();
    if (q == 0 || sc == 0 || ar == 0 || lock == 0) { return 0 - 1; }
    store64(x + 104, q);
    store64(x + 112, 0);
    store64(x + 120, 0);
    store64(x + 128, lock);
    store64(x + 136, sc);
    store64(x + 144, ar);
    store64(x + 152, 0);
    return 0;
}

fn _bl_queued(q, cnt, uri) {
    var i = 0;
    while (i < cnt) {
        if (streq(q + i * BOTE_LISTEN_ENTRY, uri) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# The update of `uri`, queued for `x`'s subscriptions, and the writing thread woken.
fn _bl_queue(x, uri) {
    atomic_fetch_add(x + 152, 1);
    atomic_fence();
    if (atomic_load(x + 24) <= 0) { return 0; }
    var n = strlen(uri);
    mutex_lock(load64(x + 128));
    var cnt = load64(x + 112);
    if (n > BOTE_LISTEN_URI_MAX) {
        store64(x + 120, 1);
    } elif (_bl_queued(load64(x + 104), cnt, uri) == 0) {
        if (cnt >= BOTE_LISTEN_QUEUE) {
            store64(x + 120, 1);
        } else {
            memcpy(load64(x + 104) + cnt * BOTE_LISTEN_ENTRY, uri, n + 1);
            store64(x + 112, cnt + 1);
        }
    }
    mutex_unlock(load64(x + 128));
    return _bl_raise(x, BOTE_LISTEN_UPDATES);
}

# The sink's update hook: queued here, and passed on.
fn _bl_updated(x, uri) {
    _bl_queue(x, uri);
    var next = load64(x + 72);
    if (next != 0) { event_sink_updated(next, uri); }
    return 0;
}

# The updates waiting, taken into the scratch, the queue emptied: how many, and through
# *over_out whether it overflowed.
fn _bl_take_updates(x, over_out) {
    mutex_lock(load64(x + 128));
    var cnt = load64(x + 112);
    memcpy(load64(x + 136), load64(x + 104), cnt * BOTE_LISTEN_ENTRY);
    store64(over_out, load64(x + 120));
    store64(x + 112, 0);
    store64(x + 120, 0);
    mutex_unlock(load64(x + 128));
    return cnt;
}

# 1 when an update of `u` reaches a subscription to `sub`: the same URI, or one under it,
# `sub` then `/`, `?` or `#`, or anything after a `sub` that ends in `/`.
fn _bl_covers(sub, u) {
    var sl = strlen(sub);
    if (sl == 0 || strlen(u) < sl || memeq(u, sub, sl) == 0) { return 0; }
    var c = load8(u + sl);
    if (c == 0 || load8(sub + sl - 1) == 47) { return 1; }
    if (c == 47 || c == 63 || c == 35) { return 1; }
    return 0;
}

# 1 when one of slot `s`'s URIs covers `u`.
# 1 when slot `s` is told of an update to `u`: a URI it holds covers it, and, made with
# claims, a `u` that requires a scope is one it holds exactly, flagged (above).
fn _bl_slot_covers(s, u) {
    var r = load64(s + 280);
    var scoped = 0 - 1;
    var at = 0;
    var k = 0;
    while (k < load64(s + 296)) {
        var e = r + at + 1;
        if (_bl_covers(e, u) == 1) {
            if (load64(s + 312) == 0) { return 1; }
            if (scoped < 0) { scoped = _dsp_uri_scoped(load64(s + 320), u); }
            if (scoped == 0) { return 1; }
            if (load8(r + at) == 1 && streq(e, u) == 1) { return 1; }
        }
        at = at + strlen(e) + 2;
        k = k + 1;
    }
    return 0;
}

# One update to the stream in slot `s`, by `send_fp`, its frame on `a` and gone once sent:
# a pass kept every frame until its end, 38 MB for 256 streams (the 3.7.4 review). 1 when
# the stream took it.
fn _bl_send_one(x, a, s, u, send_fp) {
    var m[16];
    bote_arena_mark(a, &m);
    var ok = fncall4(send_fp, x, a, s, u);
    bote_arena_release(a, &m);
    return ok;
}

# The URIs the acknowledgement `ack` lists, kept in slot `s`'s room: how many. The
# dispatcher bounded them to fit; none clears what a stream before kept there.
fn _bl_keep_uris(a, s, ack, d) {
    store64(s + 288, 0);
    store64(s + 296, 0);
    var claims = bote_req_listen_claims();
    store64(s + 312, 0);
    if (claims != 0) { store64(s + 312, 1); }
    store64(s + 320, d);
    var raw = jsonx_get_raw_a(a, jsonx_get_raw_a(a, ack, "notifications"), "resourceSubscriptions");
    if (raw == 0) { return 0; }
    if (load64(s + 280) == 0) { store64(s + 280, alloc(BOTE_LISTEN_URI_ROOM + BOTE_LISTEN_URIS)); }
    var room = load64(s + 280);
    var n = strlen(raw);
    var used = 0;
    var cnt = 0;
    var i = _jx_skip_ws(raw, n, 1);
    while (i < n && load8(raw + i) != 93) {
        var u = _dsp_listen_uri_a(a, raw, n, i);
        # Judged again as it is kept, with the claims the dispatcher judged it with, in one
        # look: what serves it may have changed since.
        if (u != 0 && dispatcher_resource_scopes_missing(d, u, claims) != 0) { u = 0; }
        if (u != 0 && cnt < BOTE_LISTEN_URIS && used + strlen(u) + 2 <= BOTE_LISTEN_URI_ROOM + BOTE_LISTEN_URIS) {
            store8(room + used, 0);
            if (claims != 0 && _dsp_uri_scoped(d, u) == 1) { store8(room + used, 1); }
            memcpy(room + used + 1, u, strlen(u) + 1);
            used = used + strlen(u) + 2;
            cnt = cnt + 1;
        }
        i = _jx_array_next(raw, n, i);
    }
    store64(s + 288, used);
    store64(s + 296, cnt);
    return cnt;
}

# The update of `uri` for the subscription in slot `s`, between `pre` and `post`, on `a`.
fn _bl_update_a(a, s, uri, pre, post) {
    var idl = load64(s + 16);
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, strlen(uri) * 6 + idl + 200);
    str_builder_add_cstr(sb, pre);
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/resources/updated\",\"params\":{\"uri\":\"");
    bote_json_escape(sb, uri);
    str_builder_add_cstr(sb, "\",\"_meta\":{\"");
    str_builder_add_cstr(sb, BOTE_LISTEN_SUB_KEY);
    str_builder_add_cstr(sb, "\":");
    var k = 0;
    while (k < idl) {
        str_builder_add_byte(sb, load8(s + 24 + k));
        k = k + 1;
    }
    str_builder_add_cstr(sb, "}}}");
    str_builder_add_cstr(sb, post);
    return str_data(str_builder_build_a(a, sb));
}

# For slot `s` of `x`: send_fp(x, a, s, uri) for each of the `nu` updates taken that one of
# its URIs covers, or, overflowed, for each URI it holds. 1, or 0 once one was not taken.
fn _bl_each_update(x, a, s, nu, over, send_fp) {
    if (over == 1) {
        var r = load64(s + 280);
        var at = 0;
        var k = 0;
        while (k < load64(s + 296)) {
            var e = r + at + 1;
            # Made with claims, a URI that requires a scope now, kept without one, is not told.
            var tell = 1;
            if (load64(s + 312) == 1 && load8(r + at) == 0 && _dsp_uri_scoped(load64(s + 320), e) == 1) { tell = 0; }
            if (tell == 1 && _bl_send_one(x, a, s, e, send_fp) == 0) { return 0; }
            at = at + strlen(e) + 2;
            k = k + 1;
        }
        return 1;
    }
    var q = load64(x + 136);
    var j = 0;
    while (j < nu) {
        var u = q + j * BOTE_LISTEN_ENTRY;
        if (_bl_slot_covers(s, u) == 1 && _bl_send_one(x, a, s, u, send_fp) == 0) { return 0; }
        j = j + 1;
    }
    return 1;
}

# ---- the slots ------------------------------------------------------------------

fn _bl_slot(h, i) { return load64(h + 8) + i * BOTE_LISTEN_SLOT_BYTES; }

# A free slot, reserved for the caller, or 0 when every slot holds a stream.
fn _bl_reserve(h) {
    mutex_lock(load64(h));
    var got = 0;
    var i = 0;
    while (i < load64(h + 16) && got == 0) {
        var s = _bl_slot(h, i);
        if (load64(s) == 0 - 1) {
            store64(s, 0 - 2);
            got = s;
        }
        i = i + 1;
    }
    mutex_unlock(load64(h));
    return got;
}

fn _bl_release(h, s) {
    if (s == 0) { return 0; }
    mutex_lock(load64(h));
    store64(s, 0 - 1);
    mutex_unlock(load64(h));
    return 0;
}

# A stream that never opened: its slot back, and the socket it would have been closed.
fn _bl_drop(h, s, fd) {
    if (fd >= 0) { sys_close(fd); }
    return _bl_release(h, s);
}

# Park the stream in slot `s`. `seen` is the hub's count of changes when its worker began:
# moved since, the stream is owed every kind it honors, and the hub thread is woken to say so.
fn _bl_park(h, s, fd, mask, id, idl, seen) {
    mutex_lock(load64(h));
    store64(s + 8, mask);
    store64(s + 16, idl);
    memcpy(s + 24, id, idl);
    store64(s + 304, 0);
    store64(s, fd);
    # Counted open, and the count seen, before `seen` is read (see _bl_publish).
    atomic_fetch_add(h + 24, 1);
    atomic_fence();
    var owe = 0;
    if (atomic_load(h + 152) != seen) {
        store64(s + 304, mask);
        owe = 1;
    }
    mutex_unlock(load64(h));
    if (owe == 1) { _bl_raise(h, BOTE_LISTEN_OWED); }
    return 0;
}

# End the stream in slot `s`, with the lock held. `why` names the reason in the log.
fn _bl_close_held(h, s, why) {
    sys_close(load64(s));
    store64(s, 0 - 1);
    atomic_fetch_add(h + 24, 0 - 1);
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_DEBUG, "listen stream closed");
    bote_log_str(&ln, "reason", why);
    bote_log_int(&ln, "open", load64(h + 24));
    bote_log_emit(&ln);
    return 0;
}

# ---- frames ---------------------------------------------------------------------

# Append `n` bytes of `p` to `buf` at *at.
fn _bl_put(buf, at, p, n) {
    memcpy(buf + load64(at), p, n);
    store64(at, load64(at) + n);
    return 0;
}

fn _bl_puts(buf, at, s) { return _bl_put(buf, at, s, strlen(s)); }

# `payload`, `n` bytes of an SSE event, as one chunk of a chunked body at `out`. Its length.
fn _bl_chunk(out, payload, n) {
    var hex[24];
    var hi = 0;
    var v = n;
    var tmp[24];
    var ti = 0;
    while (v > 0 || ti == 0) {
        var dgt = v & 15;
        if (dgt < 10) { store8(&tmp + ti, 48 + dgt); } else { store8(&tmp + ti, 87 + dgt); }
        v = v >> 4;
        ti = ti + 1;
    }
    while (ti > 0) {
        ti = ti - 1;
        store8(&hex + hi, load8(&tmp + ti));
        hi = hi + 1;
    }
    var at[8];
    store64(&at, 0);
    _bl_put(out, &at, &hex, hi);
    _bl_puts(out, &at, "\r\n");
    _bl_put(out, &at, payload, n);
    _bl_puts(out, &at, "\r\n");
    return load64(&at);
}

# The change notification `method` for the subscription in slot `s`, appended to `buf` at
# *at: its JSON-RPC message.
fn _bl_note(buf, at, s, method) {
    _bl_puts(buf, at, "{\"jsonrpc\":\"2.0\",\"method\":\"");
    _bl_puts(buf, at, method);
    _bl_puts(buf, at, "\",\"params\":{\"_meta\":{\"");
    _bl_puts(buf, at, BOTE_LISTEN_SUB_KEY);
    _bl_puts(buf, at, "\":");
    _bl_put(buf, at, s + 24, load64(s + 16));
    _bl_puts(buf, at, "}}}");
    return 0;
}

# One change notification for the stream in slot `s`, as a chunk, in the hub's frame
# buffer. Its length.
fn _bl_change_frame(h, s, method) {
    var ev[512];
    var at[8];
    store64(&at, 0);
    _bl_puts(&ev, &at, "event: message\ndata: ");
    _bl_note(&ev, &at, s, method);
    _bl_puts(&ev, &at, "\n\n");
    return _bl_chunk(load64(h + 88), &ev, load64(&at));
}

# Write `n` bytes at `p` to the stream in slot `s` without waiting: 1 when the socket took
# all of them.
fn _bl_send(s, p, n) {
    return sys_sendto(load64(s), p, n, _BL_SEND, 0, 0) == n;
}

# ---- the HTTP side --------------------------------------------------------------

# The acknowledgement for `id`, from `ack`, the params the dispatcher made, between `pre`
# and `post`, on `a`: an SSE event, or the bare message.
fn _bl_ack_a(a, ack, id, pre, post) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, strlen(ack) + strlen(id) + 160);
    str_builder_add_cstr(sb, pre);
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/subscriptions/acknowledged\",\"params\":{");
    # `ack` is {"notifications":{...}}: its members, then the stamp.
    var i = 1;
    while (i < strlen(ack) - 1) {
        str_builder_add_byte(sb, load8(ack + i));
        i = i + 1;
    }
    str_builder_add_cstr(sb, ",\"_meta\":{\"");
    str_builder_add_cstr(sb, BOTE_LISTEN_SUB_KEY);
    str_builder_add_cstr(sb, "\":");
    str_builder_add_cstr(sb, id);
    str_builder_add_cstr(sb, "}}}");
    str_builder_add_cstr(sb, post);
    return str_data(str_builder_build_a(a, sb));
}

fn _bl_ack_event_a(a, ack, id) { return _bl_ack_a(a, ack, id, BOTE_LISTEN_SSE_PRE, BOTE_LISTEN_SSE_POST); }

# The stream's result, which ends it, for `id`, between `pre` and `post`, on `a`.
fn _bl_result_a(a, id, d, pre, post) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, strlen(id) * 2 + 512);
    str_builder_add_cstr(sb, pre);
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":");
    str_builder_add_cstr(sb, id);
    str_builder_add_cstr(sb, ",\"result\":{\"resultType\":\"complete\",\"_meta\":{\"");
    str_builder_add_cstr(sb, BOTE_LISTEN_SUB_KEY);
    str_builder_add_cstr(sb, "\":");
    str_builder_add_cstr(sb, id);
    str_builder_add_cstr(sb, ",\"io.modelcontextprotocol/serverInfo\":");
    _dsp_emit_server_info(sb, d);
    str_builder_add_cstr(sb, "}}}");
    str_builder_add_cstr(sb, post);
    return str_data(str_builder_build_a(a, sb));
}

fn _bl_result_event_a(a, id, d) { return _bl_result_a(a, id, d, BOTE_LISTEN_SSE_PRE, BOTE_LISTEN_SSE_POST); }

# Every parked stream, ended: nobody serves them.
fn _bl_close_all(h, why) {
    mutex_lock(load64(h));
    var i = 0;
    while (i < load64(h + 16)) {
        var s = _bl_slot(h, i);
        if (load64(s) >= 0) { _bl_close_held(h, s, why); }
        i = i + 1;
    }
    mutex_unlock(load64(h));
    return 0;
}

# The hub thread, started by the first stream: 1 once it runs. When it cannot start, every
# stream parked meanwhile ends, before and after the next caller may try again (3.7.3): a
# stream another worker parked while this start was failing was left with nobody to serve it.
fn _bl_start(h) {
    while (1 == 1) {
        var st = atomic_load(h + 56);
        if (st == 2) { return 1; }
        if (st == 0 && atomic_cas(h + 56, 0, 1) == 1) {
            if (fncall2(_bl_spawn, &_bl_run, h) != 0) {
                atomic_store(h + 56, 2);
                return 1;
            }
            bote_log(SK_ERROR, "listen: the hub thread did not start; its streams are not served");
            _bl_close_all(h, "no hub thread");
            atomic_store(h + 56, 0);
            return 0;
        }
        # Another start is under way: its outcome, before this stream counts on it (3.7.4).
        # A second close afterwards, as 3.7.3 had, could end a stream a later start served.
        sys_sched_yield();
    }
    return 0;
}

# The BOTE_LISTEN_* bits the acknowledgement's params `ack` name: bote_listen_ack_params_a's
# own bytes. A stream honors what its first message said it would (3.7.3): judged again, a
# prompt registered between the two made the acknowledgement say nothing and the stream stay.
fn _bl_true(raw) {
    if (raw == 0) { return 0; }
    return streq(raw, "true");
}

fn _bl_ack_mask_a(a, ack) {
    var f = jsonx_get_raw_a(a, ack, "notifications");
    if (f == 0) { return 0; }
    var m = 0;
    if (_bl_true(jsonx_get_raw_a(a, f, "toolsListChanged")) == 1) { m = m | BOTE_LISTEN_TOOLS; }
    if (_bl_true(jsonx_get_raw_a(a, f, "promptsListChanged")) == 1) { m = m | BOTE_LISTEN_PROMPTS; }
    if (_bl_true(jsonx_get_raw_a(a, f, "resourcesListChanged")) == 1) { m = m | BOTE_LISTEN_RESOURCES; }
    if (jsonx_get_raw_a(a, f, "resourceSubscriptions") != 0) { m = m | BOTE_LISTEN_UPDATES; }
    return m;
}

fn _bl_ack_mask(ack) { return _bl_ack_mask_a(bote_req_alloc(), ack); }

# Serve the listen request `req`, which the dispatcher `d` accepted with `resp`, on the HTTP
# connection `hc`: 0 once the stream is open, or closed already when nothing asked for can be
# honored, or a response to send in its place.
fn bote_listen_http(h, hc, req, resp, d) {
    var a = bote_req_alloc();
    var seen = atomic_load(h + 152);
    var id = req_id(req);
    var idl = strlen(id);
    if (idl > BOTE_LISTEN_ID_MAX) { return resp_error_a(a, id, 0 - 32602, BOTE_LISTEN_ID_LONG); }
    var mask = _bl_ack_mask_a(a, resp_result(resp));
    var cfd = _he_cfd(hc);
    var s = 0;
    var fd = 0 - 1;
    if (mask != 0) {
        s = _bl_reserve(h);
        if (s == 0) {
            var wl[BOTE_LOG_LINE_BYTES];
            bote_log_line(&wl, SK_WARN, "subscriptions/listen refused: every stream slot is taken");
            bote_log_int(&wl, "max", load64(h + 16));
            bote_log_emit(&wl);
            return resp_error_a(a, id, 0 - 32603, BOTE_LISTEN_FULL);
        }
        # The socket the stream will be, held before anything is sent (3.7.3): a client was
        # acknowledged and then cut off, with no word in the log, when it could not be.
        fd = sys_fcntl(cfd, _bl_dup_cmd, 3);
        if (fd < 0) {
            _bl_release(h, s);
            var dl[BOTE_LOG_LINE_BYTES];
            bote_log_line(&dl, SK_WARN, "subscriptions/listen refused: the stream's socket could not be held");
            bote_log_int(&dl, "errno", 0 - fd);
            bote_log_emit(&dl);
            return resp_error_a(a, id, 0 - 32603, BOTE_LISTEN_HELD);
        }
    }
    var hdr = "Cache-Control: no-cache\r\n";
    if (_he_extra(hc) != 0) {
        var hb = str_builder_new_a(a);
        str_builder_add_cstr_a(a, hb, hdr);
        str_builder_add_cstr_a(a, hb, _he_extra(hc));
        hdr = str_data(str_builder_build_a(a, hb));
    }
    if (sandhi_server_send_chunked_start_a(a, cfd, HTTP_OK, "text/event-stream", hdr) < 0) { return _bl_drop(h, s, fd); }
    var ack = _bl_ack_event_a(a, resp_result(resp), id);
    if (sandhi_server_send_chunk(cfd, ack, strlen(ack)) < 0) { return _bl_drop(h, s, fd); }
    if (mask == 0) {
        var res = _bl_result_event_a(a, id, d);
        sandhi_server_send_chunk(cfd, res, strlen(res));
        sandhi_server_send_chunked_end(cfd);
        return 0;
    }
    _bl_keep_uris(a, s, resp_result(resp), d);
    _bl_park(h, s, fd, mask, id, idl, seen);
    if (_bl_start(h) == 0) { return 0; }
    _bl_wake(h);
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_DEBUG, "listen stream opened");
    bote_log_int(&ln, "honored", mask);
    bote_log_int(&ln, "open", bote_listen_open(h));
    bote_log_emit(&ln);
    return 0;
}

# ---- the hub thread -------------------------------------------------------------

# The pollfds: the wake pipe first, then every parked stream, each beside its slot. How many.
fn _bl_pollset(h) {
    var pfd = load64(h + 80);
    var polled = load64(h + 96);
    store32(pfd, load64(h + 40));
    store16(pfd + 4, _BL_POLLIN);
    store16(pfd + 6, 0);
    var n = 1;
    mutex_lock(load64(h));
    var i = 0;
    while (i < load64(h + 16)) {
        var s = _bl_slot(h, i);
        if (load64(s) >= 0) {
            store32(pfd + n * 8, load64(s));
            store16(pfd + n * 8 + 4, _BL_POLLIN);
            store16(pfd + n * 8 + 6, 0);
            store64(polled + n * 8, s);
            n = n + 1;
        }
        i = i + 1;
    }
    mutex_unlock(load64(h));
    return n;
}

# 1 when the pollfd `i` of `pfd` came back with any event.
fn _bl_fired(pfd, i) {
    if (load8(pfd + i * 8 + 6) != 0 || load8(pfd + i * 8 + 7) != 0) { return 1; }
    return 0;
}

fn _bl_poll(pfd, n, ms) {
    var ts[16];
    store64(&ts, ms / 1000);
    store64(&ts + 8, (ms % 1000) * 1000000);
    return sys_ppoll(pfd, n, &ts, 0, 8);
}

# The pending bits, taken: they are 0 after.
fn _bl_take_pending(h) {
    var taken = 0;
    var p = 0;
    while (taken == 0) {
        p = atomic_load(h + 32);
        taken = atomic_cas(h + 32, p, 0);
    }
    return p;
}

# Every stream that honors one of `bits` gets its notification; one that will not take it
# whole ends.
fn _bl_send_changes(h, bits) {
    var over[8];
    store64(&over, 0);
    var nu = 0;
    if ((bits & BOTE_LISTEN_UPDATES) != 0) { nu = _bl_take_updates(h, &over); }
    var a = load64(h + 144);
    reset_via(a);
    mutex_lock(load64(h));
    var i = 0;
    while (i < load64(h + 16)) {
        var s = _bl_slot(h, i);
        var owed = 0;
        if (load64(s) >= 0) {
            owed = load64(s + 304);
            store64(s + 304, 0);
        }
        var sb = bits | owed;
        var b = 1;
        while (b <= BOTE_LISTEN_RESOURCES && load64(s) >= 0) {
            if ((sb & b) != 0 && (load64(s + 8) & b) != 0) {
                var n = _bl_change_frame(h, s, _bl_method(b));
                if (_bl_send(s, load64(h + 88), n) == 0) { _bl_close_held(h, s, "stopped reading"); }
            }
            b = b * 2;
        }
        if ((sb & BOTE_LISTEN_UPDATES) != 0 && load64(s) >= 0 && (load64(s + 8) & BOTE_LISTEN_UPDATES) != 0) {
            # Owed, it is told of every URI it holds; else of those taken that it covers.
            var sover = load64(&over);
            if ((owed & BOTE_LISTEN_UPDATES) != 0) { sover = 1; }
            if (_bl_each_update(h, a, s, nu, sover, &_bl_update_send) == 0) { _bl_close_held(h, s, "stopped reading"); }
        }
        i = i + 1;
    }
    mutex_unlock(load64(h));
    return 0;
}

# One update to an HTTP stream, as an SSE event in a chunk: 1 when the socket took it whole.
fn _bl_update_send(h, a, s, uri) {
    var ev = _bl_update_a(a, s, uri, BOTE_LISTEN_SSE_PRE, BOTE_LISTEN_SSE_POST);
    var n = strlen(ev);
    var out = alloc_via(a, n + 32);
    return _bl_send(s, out, _bl_chunk(out, ev, n));
}

fn _bl_keepalive(h) {
    var ka = ": keepalive\n\n";
    var kn = _bl_chunk(load64(h + 88), ka, strlen(ka));
    mutex_lock(load64(h));
    var i = 0;
    while (i < load64(h + 16)) {
        var s = _bl_slot(h, i);
        if (load64(s) >= 0 && _bl_send(s, load64(h + 88), kn) == 0) { _bl_close_held(h, s, "stopped reading"); }
        i = i + 1;
    }
    mutex_unlock(load64(h));
    return 0;
}

fn _bl_run(h) {
    var drain[64];
    var last = clock_now_ms();
    while (1 == 1) {
        var n = _bl_pollset(h);
        var wait = load64(h + 64) - (clock_now_ms() - last);
        if (wait < 0) { wait = 0; }
        var pr = _bl_poll(load64(h + 80), n, wait);
        var pfd = load64(h + 80);
        if (pr > 0) {
            if (_bl_fired(pfd, 0) == 1) {
                while (sys_read(load64(h + 40), &drain, 64) > 0) { }
            }
            # A client that closed, or sent anything: gone. Its slot is checked for the same
            # socket, which a stream opened since could have taken.
            mutex_lock(load64(h));
            var i = 1;
            while (i < n) {
                if (_bl_fired(pfd, i) == 1) {
                    var s = load64(load64(h + 96) + i * 8);
                    if (load64(s) == load32(pfd + i * 8)) { _bl_close_held(h, s, "gone"); }
                }
                i = i + 1;
            }
            mutex_unlock(load64(h));
        }
        var bits = _bl_take_pending(h);
        if (bits != 0) { _bl_send_changes(h, bits); }
        if (clock_now_ms() - last >= load64(h + 64)) {
            _bl_keepalive(h);
            last = clock_now_ms();
        }
    }
    return 0;
}

# ---- a connection that is itself the stream (3.7.3) -----------------------------------

# A ListenLine for at most `max` subscriptions on one connection at a time, or 0 for none.
fn bote_listen_line_new(max) {
    if (max <= 0) { return 0; }
    var c = alloc(160);
    var slots = alloc(max * BOTE_LISTEN_SLOT_BYTES);
    var frame = alloc(BOTE_LISTEN_FRAME_MAX);
    var fds[8];
    if (c == 0 || slots == 0 || frame == 0 || sys_pipe(&fds) < 0) { return 0; }
    var i = 0;
    while (i < max) {
        store64(slots + i * BOTE_LISTEN_SLOT_BYTES, 0 - 1);
        store64(slots + i * BOTE_LISTEN_SLOT_BYTES + 280, 0);
        i = i + 1;
    }
    if (_bl_updates_new(c, mutex_new()) < 0) { return 0; }
    store64(c, bote_stream_new(&_bll_open, &_bll_cancel, c));
    store64(c + 8, slots);
    store64(c + 16, max);
    store64(c + 24, 0);
    store64(c + 32, 0);
    store64(c + 40, load32(&fds));
    store64(c + 48, load32(&fds + 4));
    store64(c + 56, 0);
    store64(c + 64, 0);
    store64(c + 72, 0);
    store64(c + 80, 0);
    store64(c + 88, frame);
    _bl_wake_end(load64(c + 40));
    _bl_wake_end(load64(c + 48));
    return c;
}

# Start a message on the connection `c` serves: bote_req_begin, and the line's BoteStream
# for the codec while a connection is attached. With no line, bote_req_begin alone.
fn bote_listen_line_begin(c) {
    var a = bote_req_begin();
    if (c != 0 && load64(c + 64) != 0) { bote_req_set_stream(load64(c)); }
    return a;
}

# No subscription, and nothing pending from before.
fn _bll_clear(c) {
    var i = 0;
    while (i < load64(c + 16)) {
        store64(_bl_slot(c, i), 0 - 1);
        i = i + 1;
    }
    atomic_store(c + 24, 0);
    store64(c + 96, 0);
    # Nor any update queued for the connection before (3.7.5): the next one's first pass
    # told its subscriptions of updates made before they listened.
    mutex_lock(load64(c + 128));
    store64(c + 112, 0);
    store64(c + 120, 0);
    mutex_unlock(load64(c + 128));
    _bl_take_pending(c);
    var drain[64];
    while (sys_read(load64(c + 40), &drain, 64) > 0) { }
    return 0;
}

# 1 once a write to the connection has failed (3.7.4): the transport then drops it, as it
# does when a reply will not go. A frame not sent whole leaves the connection out of step.
fn bote_listen_line_broken(c) {
    if (c == 0) { return 0; }
    return load64(c + 96);
}

# The connection `c` serves from now, on the dispatcher `d`, written to through
# write_fp(ctx, json). It starts with no subscription.
fn bote_listen_line_attach(c, d, write_fp, ctx) {
    if (c == 0) { return 0; }
    _bll_clear(c);
    store64(c + 56, d);
    store64(c + 64, write_fp);
    store64(c + 80, ctx);
    return 0;
}

# The connection has gone, and its subscriptions with it.
fn bote_listen_line_detach(c) {
    if (c == 0) { return 0; }
    var n = atomic_load(c + 24);
    _bll_clear(c);
    store64(c + 64, 0);
    store64(c + 80, 0);
    # The message being served may not be the last on this thread (3.7.4): one dispatched
    # after, without a begin, found the stream and a writer of 0.
    bote_req_set_stream(0);
    if (n > 0) {
        var ln[BOTE_LOG_LINE_BYTES];
        bote_log_line(&ln, SK_DEBUG, "listen subscriptions ended");
        bote_log_str(&ln, "reason", "gone");
        bote_log_int(&ln, "count", n);
        bote_log_emit(&ln);
    }
    return 0;
}

# The open subscription whose id is the value of the `idl` bytes at `id`, or 0.
fn _bll_find_a(c, a, id, idl) {
    var want = bote_id_key_a(a, id, idl);
    var i = 0;
    while (i < load64(c + 16)) {
        var s = _bl_slot(c, i);
        if (load64(s) == 1 && streq(bote_id_key_a(a, s + 24, load64(s + 16)), want) == 1) { return s; }
        i = i + 1;
    }
    return 0;
}

fn _bll_free_slot(c) {
    var i = 0;
    while (i < load64(c + 16)) {
        var s = _bl_slot(c, i);
        if (load64(s) == 0 - 1) { return s; }
        i = i + 1;
    }
    return 0;
}

fn _bll_refuse_a(a, id, code, msg) { return codec_serialize_response_a(a, resp_error_a(a, id, code, msg)); }

# The BoteStream's open: the listen `req`, which the dispatcher accepted with `resp`, on
# the connection `c` serves. 0 once its first messages are written, or the reply to send
# instead: the id too long, the id already open, or every slot taken.
fn _bll_open(c, a, req, resp) {
    var id = req_id(req);
    var idl = strlen(id);
    if (idl > BOTE_LISTEN_ID_MAX) { return _bll_refuse_a(a, id, 0 - 32602, BOTE_LISTEN_ID_LONG); }
    if (load64(c + 64) == 0) { return _bll_refuse_a(a, id, 0 - 32601, "method not found: subscriptions/listen"); }
    if (_bll_find_a(c, a, id, idl) != 0) { return _bll_refuse_a(a, id, 0 - 32600, BOTE_LISTEN_ID_OPEN); }
    var d = load64(c + 56);
    var mask = _bl_ack_mask_a(a, resp_result(resp));
    var s = 0;
    if (mask != 0) {
        s = _bll_free_slot(c);
        if (s == 0) {
            var wl[BOTE_LOG_LINE_BYTES];
            bote_log_line(&wl, SK_WARN, "subscriptions/listen refused: every subscription slot is taken");
            bote_log_int(&wl, "max", load64(c + 16));
            bote_log_emit(&wl);
            return _bll_refuse_a(a, id, 0 - 32603, BOTE_LISTEN_FULL);
        }
    }
    var w = load64(c + 64);
    var ctx = load64(c + 80);
    # Open before the acknowledgement goes (3.7.4), so a change made while it is written is
    # raised for it, and written after it by this loop: through 3.7.3 a change the instant
    # the client read the acknowledgement could find none open, and be kept for nobody.
    if (mask != 0) {
        _bl_keep_uris(a, s, resp_result(resp), load64(c + 56));
        store64(s + 8, mask);
        store64(s + 16, idl);
        memcpy(s + 24, id, idl);
        store64(s, 1);
        atomic_store(c + 24, load64(c + 24) + 1);
    }
    if (fncall2(w, ctx, _bl_ack_a(a, resp_result(resp), id, "", "")) < 0) {
        store64(c + 96, 1);
        if (mask != 0) {
            store64(s, 0 - 1);
            atomic_store(c + 24, load64(c + 24) - 1);
        }
        return 0;
    }
    if (mask == 0) {
        if (fncall2(w, ctx, _bl_result_a(a, id, d, "", "")) < 0) { store64(c + 96, 1); }
        return 0;
    }
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_DEBUG, "listen subscription opened");
    bote_log_int(&ln, "honored", mask);
    bote_log_int(&ln, "open", load64(c + 24));
    bote_log_emit(&ln);
    return 0;
}

# The BoteStream's cancel: `id`, a `notifications/cancelled`'s raw `requestId`, ends the
# subscription it names, compared byte for byte with the listen's id as it was sent. Any
# other is a request the line does not hold.
fn _bll_cancel(c, a, id) {
    if (id == 0) { return 0; }
    var s = _bll_find_a(c, a, id, strlen(id));
    if (s == 0) { return 0; }
    store64(s, 0 - 1);
    atomic_store(c + 24, load64(c + 24) - 1);
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_DEBUG, "listen subscription ended");
    bote_log_str(&ln, "reason", "cancelled");
    bote_log_int(&ln, "open", load64(c + 24));
    bote_log_emit(&ln);
    return 0;
}

# Wait on the connection's `fd` and on the line's wake pipe at once, until `deadline`, a
# clock_now_ms time, or for as long as it takes when that is 0: 1 when `fd` has input or
# has closed, 2 when changes are waiting, 0 when the deadline passed. A poll that fails is
# taken as input, which the read then answers.
fn bote_listen_line_wait(c, fd, deadline) {
    var pfd[16];
    while (1 == 1) {
        store32(&pfd, fd);
        store16(&pfd + 4, _BL_POLLIN);
        store16(&pfd + 6, 0);
        store32(&pfd + 8, load64(c + 40));
        store16(&pfd + 12, _BL_POLLIN);
        store16(&pfd + 14, 0);
        var r = 0;
        if (deadline == 0) {
            r = sys_ppoll(&pfd, 2, 0, 0, 8);
        } else {
            var left = deadline - clock_now_ms();
            if (left <= 0) { return 0; }
            r = _bl_poll(&pfd, 2, left);
        }
        if (r < 0) { return 1; }
        if (r > 0) {
            if (_bl_fired(&pfd, 1) == 1) { return 2; }
            if (_bl_fired(&pfd, 0) == 1) { return 1; }
        }
    }
    return 1;
}

# Write each subscription the changes waiting that it asked for: 0, or -1 when the
# connection would not take one.
fn bote_listen_line_deliver(c) {
    var drain[64];
    while (sys_read(load64(c + 40), &drain, 64) > 0) { }
    var bits = _bl_take_pending(c);
    if (bits == 0 || load64(c + 64) == 0) { return 0; }
    var over[8];
    store64(&over, 0);
    var nu = 0;
    if ((bits & BOTE_LISTEN_UPDATES) != 0) { nu = _bl_take_updates(c, &over); }
    var a = load64(c + 144);
    reset_via(a);
    var f = load64(c + 88);
    var at[8];
    var i = 0;
    while (i < load64(c + 16)) {
        var s = _bl_slot(c, i);
        var b = 1;
        while (b <= BOTE_LISTEN_RESOURCES && load64(s) == 1) {
            if ((bits & b) != 0 && (load64(s + 8) & b) != 0) {
                store64(&at, 0);
                _bl_note(f, &at, s, _bl_method(b));
                store8(f + load64(&at), 0);
                if (fncall2(load64(c + 64), load64(c + 80), f) < 0) {
                    store64(c + 96, 1);
                    return 0 - 1;
                }
            }
            b = b * 2;
        }
        if ((bits & BOTE_LISTEN_UPDATES) != 0 && load64(s) == 1 && (load64(s + 8) & BOTE_LISTEN_UPDATES) != 0) {
            if (_bl_each_update(c, a, s, nu, load64(&over), &_bll_update_write) == 0) {
                store64(c + 96, 1);
                return 0 - 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

# One update to a line's connection, through its writer: 1 when it took it.
fn _bll_update_write(c, a, s, uri) {
    if (fncall2(load64(c + 64), load64(c + 80), _bl_update_a(a, s, uri, "", "")) < 0) { return 0; }
    return 1;
}

# bote_listen_line_wait, writing the changes as they come: 1 when `fd` has input or has
# closed, 0 when the deadline passed, -1 when the connection would not take a change.
fn bote_listen_line_await(c, fd, deadline) {
    while (1 == 1) {
        var w = bote_listen_line_wait(c, fd, deadline);
        if (w != 2) { return w; }
        if (bote_listen_line_deliver(c) < 0) { return 0 - 1; }
    }
    return 1;
}
#endif

# --- transport_stdio.cyr ---

# bote::transport::stdio — line-oriented JSON-RPC over stdin/stdout
# Mirrors rust-old/src/transport/stdio.rs; (3.7.3) listen through a ListenLine

# Buffer for in-flight stdin data (large enough for any reasonable JSON-RPC line).
# Heap-allocated to avoid the cyrius static-buffer size limit.
var STDIO_BUF_SIZE = 131072;
var _stdio_buf = 0;
var _stdio_buf_len = 0;
var _stdio_out = 1;

# `subscriptions/listen` over this connection (3.7.3): a ListenLine (src/listen.cyr), or 0,
# when the method is not found. Set before transport_stdio_run. While it is set the loop
# waits on stdin and on the line at once, and writes a change between its replies.
var _stdio_listen = 0;
fn transport_stdio_with_listen(c) { _stdio_listen = c; return c; }

# SIGPIPE, ignored while stdio serves (3.7.4), as sandhi's serve loops ignore it: a client
# that closed its end of stdout killed the process with it, where a write now fails and the
# loop ends, saying so.
var BOTE_SIGPIPE = 13;

# The loop ends: stdout will not take a reply or a change.
fn _stdio_gone() {
    bote_log_warn("stdio: stdout is gone; stopping");
    return 0;
}

# A reply's writer and the line's: one message, one line. -1 once stdout has gone.
fn _stdio_listen_write(fd, json) {
    if (sys_write(fd, json, strlen(json)) < 0) { return 0 - 1; }
    if (sys_write(fd, "\n", 1) < 0) { return 0 - 1; }
    return 0;
}

# Cancellation (3.7.5): a client cancels a request on stdio with `notifications/cancelled`
# naming it, which it sends while the request runs. A handler that asks bote_cancelled()
# brings this check in: what stdin has ready is read in after what the buffer holds, while
# there is room, without waiting, and the complete lines past the message being served are
# looked through, each once. They stay in the buffer and are served in their turn. A read
# that finds the end of stdin is remembered for the loop, since a terminal's end is read
# only once; the end of stdin is not a cancellation, because a client may send its last
# request and close stdin before it reads the answer.
var _stdio_in = 0;
var _stdio_from = 0;    # where what follows the message being served begins
var _stdio_seen = 0;    # how far a check has looked, for this message
var _stdio_eof = 0;

fn _stdio_cancelled(ctx, a, id) {
    var room = STDIO_BUF_SIZE - _stdio_buf_len;
    if (room > 0 && _stdio_eof == 0 && bote_conn_readable(_stdio_in) == 1) {
        var n = sys_read(_stdio_in, _stdio_buf + _stdio_buf_len, room);
        if (n > 0) { _stdio_buf_len = _stdio_buf_len + n; }
        elif (n == 0) { _stdio_eof = 1; }
    }
    if (_stdio_seen < _stdio_from) { _stdio_seen = _stdio_from; }
    var done[8];
    var hit = codec_lines_cancel_a(a, _stdio_buf + _stdio_seen, _stdio_buf_len - _stdio_seen, id, &done);
    _stdio_seen = _stdio_seen + load64(&done);
    return hit;
}

# Begin the message at `from`, what follows it there: the arena, as bote_req_begin.
fn _stdio_begin(from) {
    var a = bote_listen_line_begin(_stdio_listen);
    _stdio_from = from;
    _stdio_seen = from;
    bote_req_set_cancel(&_stdio_cancelled, 0);
    return a;
}

fn _stdio_init() {
    if (_stdio_buf == 0) {
        _stdio_buf = alloc(STDIO_BUF_SIZE);
    }
    _stdio_buf_len = 0;
    _stdio_eof = 0;
    return 0;
}

# Process all complete (newline-terminated) lines in the stdio buffer.
# Returns 0 if no lines processed; 1 if at least one line was dispatched.
fn _stdio_process_lines(dispatcher) {
    var processed = 0;
    var scanned = 0;
    var line_start = 0;
    while (scanned < _stdio_buf_len) {
        if (load8(_stdio_buf + scanned) == 10) {
            # Replace newline with NUL → cstr
            var line_len = scanned - line_start;
            store8(_stdio_buf + scanned, 0);
            if (line_len > 0) {
                var line_ptr = _stdio_buf + line_start;
                var resp = codec_process_message_a(_stdio_begin(scanned + 1), line_ptr, dispatcher, 0);
                if (resp != 0 && _stdio_listen_write(_stdio_out, resp) < 0) { return 0 - 1; }
                if (bote_listen_line_broken(_stdio_listen) == 1) { return 0 - 1; }
                processed = 1;
            }
            line_start = scanned + 1;
        }
        scanned = scanned + 1;
    }
    # Shift leftover (partial line) to start of buffer
    if (line_start > 0) {
        var leftover = _stdio_buf_len - line_start;
        if (leftover > 0) {
            memcpy(_stdio_buf, _stdio_buf + line_start, leftover);
        }
        _stdio_buf_len = leftover;
    }
    return processed;
}

# Run the stdio transport loop. Reads stdin until EOF, dispatches each
# newline-terminated message, writes responses to stdout.
fn transport_stdio_run(dispatcher) { return _stdio_serve(dispatcher, 0, 1); }

# The loop over `in_fd` and `out_fd`, the connection's two ends.
fn _stdio_serve(dispatcher, in_fd, out_fd) {
    signal_ignore(BOTE_SIGPIPE);
    _stdio_init();
    _stdio_out = out_fd;
    _stdio_in = in_fd;
    bote_listen_line_attach(_stdio_listen, dispatcher, &_stdio_listen_write, out_fd);
    var r = _stdio_loop(dispatcher, in_fd);
    bote_listen_line_detach(_stdio_listen);
    return r;
}

fn _stdio_loop(dispatcher, in_fd) {
    var skipping = 0;
    while (1 == 1) {
        var space = STDIO_BUF_SIZE - _stdio_buf_len;
        if (space <= 0) {
            if (_stdio_listen_write(_stdio_out, codec_line_too_long()) < 0) { return _stdio_gone(); }
            skipping = 1;
            _stdio_buf_len = 0;
            space = STDIO_BUF_SIZE;
        }
        # A client gone from stdout is gone. A cancellation check may have read the end.
        var n = 0;
        if (_stdio_eof == 0) {
            if (_stdio_listen != 0 && bote_listen_line_await(_stdio_listen, in_fd, 0) < 0) { return _stdio_gone(); }
            n = sys_read(in_fd, _stdio_buf + _stdio_buf_len, space);
        }
        if (n <= 0) {
            # EOF — process any final line that lacks a trailing newline
            if (_stdio_buf_len > 0) {
                store8(_stdio_buf + _stdio_buf_len, 0);
                var resp = codec_process_message_a(_stdio_begin(_stdio_buf_len), _stdio_buf, dispatcher, 0);
                if (resp != 0) { _stdio_listen_write(_stdio_out, resp); }
            }
            return 0;
        }
        if (skipping == 1) {
            var at = _stdio_buf + _stdio_buf_len;
            var le = codec_line_end(at, n);
            if (le < 0) { continue; }
            skipping = 0;
            n = n - le;
            if (n > 0) { memcpy(at, at + le, n); }
        }
        _stdio_buf_len = _stdio_buf_len + n;
        if (_stdio_process_lines(dispatcher) < 0) { return _stdio_gone(); }
    }
    return 0;
}

# --- transport_http.cyr ---

# bote::transport::http — HTTP/1.1 transport for JSON-RPC
# Mirrors rust-old/src/transport/http.rs (sync, single-conn-at-a-time).
#
# Built on cyrius stdlib `lib/sandhi.cyr` (the 5.10.x fold of the old
# lib/http_server.cyr) — request reading,
# parsing, and response builders all live there. This file just wires the
# MCP middleware (origin / protocol-version / session) and routes
# `POST <endpoint>` to codec_process_message.

# ================================================================
# HttpConfig (72 bytes):
#   +0  endpoint_path     cstr (e.g. "/mcp")
#   +8  bind_addr         i64 (network-order IPv4)
#   +16 port              i64
#   +24 allowed_origins   vec of cstrs or 0
#   +32 require_protocol  0/1
#   +40 session_store     SessionStore ptr or 0
#   +48 dispatcher        Dispatcher ptr (set by transport_http_run)
#   +56 bearer_validator  fn ptr (token, ctx) → claims | 0, or 0 to disable
#   +64 bearer_ctx        i64 ctx passed verbatim to validator
#   +72 resource_metadata ProtectedResource or 0
# ================================================================

fn http_config_new(path, addr, port) {
    var c = alloc(80);
    store64(c, path);
    store64(c + 8, addr);
    store64(c + 16, port);
    store64(c + 24, 0);
    store64(c + 32, 0);
    store64(c + 40, 0);
    store64(c + 48, 0);
    store64(c + 56, 0);
    store64(c + 64, 0);
    store64(c + 72, 0);
    return c;
}

fn http_config_with_allowed_origins(c, vec) { store64(c + 24, vec); return c; }
fn http_config_with_require_protocol(c, r)  { store64(c + 32, r);   return c; }
fn http_config_with_session_store(c, st)    { store64(c + 40, st);  return c; }
fn http_config_with_bearer_validator(c, fp, ctx) {
    store64(c + 56, fp);
    store64(c + 64, ctx);
    return c;
}

fn http_config_with_resource_metadata(c, p) { store64(c + 72, p); return c; }

fn http_config_path(c)             { return load64(c); }
fn http_config_addr(c)             { return load64(c + 8); }
fn http_config_port(c)             { return load64(c + 16); }
fn http_config_allowed_origins(c)  { return load64(c + 24); }
fn http_config_require_protocol(c) { return load64(c + 32); }
fn http_config_session_store(c)    { return load64(c + 40); }
fn http_config_dispatcher(c)       { return load64(c + 48); }
fn http_config_bearer_validator(c) { return load64(c + 56); }
fn http_config_bearer_ctx(c)       { return load64(c + 64); }
fn http_config_resource_metadata(c) { return load64(c + 72); }

# ================================================================
# Middleware. Each returns 0 on pass, or the HTTP status code on rejection
# (and writes the rejection response on cfd).
# ================================================================

fn _http_check_origin(cfd, buf, blen, config) {
    var origin = sandhi_server_find_header_a(bote_req_alloc(), buf, blen, "Origin");
    if (bote_http_origin_ok(origin, http_config_allowed_origins(config), buf, blen) == 1) { return 0; }
    bote_http_refuse(cfd, SK_WARN, "http", HTTP_FORBIDDEN, "Forbidden", "origin");
    return HTTP_FORBIDDEN;
}

fn _http_check_session(cfd, buf, blen, config, method) {
    var st = http_config_session_store(config);
    if (st == 0) { return 0; }
    var sid = sandhi_server_find_header_a(bote_req_alloc(), buf, blen, "MCP-Session-Id");
    if (sid == 0) {
        if (streq(method, "initialize") == 1) { return 0; }
        bote_http_refuse(cfd, SK_DEBUG, "http", HTTP_NOT_FOUND, "Not Found", "session_missing");
        return HTTP_NOT_FOUND;
    }
    if (session_store_validate(st, sid) == 0) {
        bote_http_refuse(cfd, SK_DEBUG, "http", HTTP_NOT_FOUND, "Not Found", "session_unknown");
        return HTTP_NOT_FOUND;
    }
    return 0;
}

fn _http_peek_method(body) {
    var m = jsonx_get_str_a(bote_req_alloc(), body, "method");
    if (m == 0) { return ""; }
    return m;
}

# ================================================================
# Request handler — invoked per connection by sandhi's serve loop
# ================================================================

fn _http_handle(config, cfd, buf, n) {
    # 3.4.3: bound every write to this client (src/conn.cyr). sandhi's
    # server sets only read deadlines on the connections it accepts.
    bote_conn_send_deadline(cfd);
    var a = bote_req_begin();
    if (bote_http_head_nul(buf, n) == 1) {
        bote_http_refuse(cfd, SK_WARN, "http", HTTP_BAD_REQUEST, "Bad Request", "nul_in_head");
        return 0;
    }
    var method = sandhi_server_get_method_a(a, buf, n);
    var path   = sandhi_server_get_path_a(a, buf, n);
    var hc[40];
    bote_http_ctx(&hc, cfd, "http", buf, n, 0);
    var prm = http_config_resource_metadata(config);
    if (bote_prm_route(&hc, prm, method, path, http_config_allowed_origins(config)) == 1) { return 0; }

    if (streq(method, "POST") == 0) {
        bote_http_refuse_method(cfd, "http", "Allow: POST\r\n");
        return 0;
    }
    if (streq(sandhi_server_path_only_a(bote_req_alloc(), path), http_config_path(config)) == 0) {
        bote_http_refuse(cfd, SK_DEBUG, "http", HTTP_NOT_FOUND, "Not Found", "path");
        return 0;
    }

    if (_http_check_origin(cfd, buf, n, config) != 0) { return 0; }
    if (sandhi_server_find_header_a(bote_req_alloc(), buf, n, "Transfer-Encoding") != 0) {
        bote_http_refuse(cfd, SK_WARN, "http", HTTP_BAD_REQUEST, "Bad Request", "transfer_encoding"); return 0;
    }
    var claims_slot[8]; store64(&claims_slot, 0);
    if (auth_bearer_check_c(cfd, buf, n,
        http_config_bearer_validator(config),
        http_config_bearer_ctx(config),
        &claims_slot, bote_prm_challenge(prm)) != 0) { return 0; }

    var bo = sandhi_server_body_offset(buf, n);
    if (bo < 0 || bo > n) {
        bote_http_refuse(cfd, SK_DEBUG, "http", HTTP_BAD_REQUEST, "Bad Request", "malformed_request");
        return 0;
    }
    if (bote_http_clen_bad(buf, n) == 1) {
        bote_http_refuse(cfd, SK_WARN, "http", HTTP_BAD_REQUEST, "Bad Request", "content_length");
        return 0;
    }
    var clen = sandhi_server_content_length(buf, n);
    # 1.9.6 audit M1: 413 on oversized declared body (before clamp).
    if (clen > 61440) {
        bote_http_refuse(cfd, SK_WARN, "http", HTTP_PAYLOAD_TOO_LARGE, "Payload Too Large", "payload_too_large"); return 0;
    }
    if (clen <= 0) { clen = n - bo; }
    if (clen < 0) { clen = 0; }
    # Clamp to the bytes we actually received. Guards against a lying
    # Content-Length header declaring more body than arrived on the wire —
    # without this, memcpy would read past the request buffer.
    if (clen > n - bo) { clen = n - bo; }
    # In place: the request buffer is this handler's, and the headers read
    # below sit before the body.
    var body = buf + bo;
    store8(body + clen, 0);
    # A NUL would end the message early, and whatever follows it would go
    # unread by the syntax check.
    if (strlen(body) != clen) {
        bote_http_refuse(cfd, SK_WARN, "http", HTTP_BAD_REQUEST, "Bad Request", "nul_in_body");
        return 0;
    }

    var mreq[8];
    var era = bote_http_era(&hc, body, http_config_require_protocol(config), http_config_dispatcher(config), &mreq);
    if (era == BOTE_HTTP_REFUSED) { return 0; }
    if (bote_http_scope_gate(&hc, http_config_dispatcher(config), body, load64(&claims_slot), prm) != 0) { return 0; }
    if (era == BOTE_HTTP_MODERN) {
        return bote_http_serve_modern(&hc, load64(&mreq), http_config_dispatcher(config), load64(&claims_slot));
    }

    # Initialize: optionally create a session, return MCP-Session-Id header.
    # Only a session store needs the method before dispatch reads it.
    var extra = 0;
    var st = http_config_session_store(config);
    var rpc_method = "";
    if (st != 0) { rpc_method = _http_peek_method(body); }
    if (_http_check_session(cfd, buf, n, config, rpc_method) != 0) { return 0; }
    var resp = codec_process_message_a(bote_req_alloc(), body, http_config_dispatcher(config), load64(&claims_slot));

    # A session exists once `initialize` has succeeded. Minted before dispatch,
    # a request the codec refused still got one.
    if (st != 0 && streq(rpc_method, "initialize") == 1 && resp != 0 && jsonx_has(resp, "result") == 1) {
        var pv = jsonx_get_str(jsonx_get_raw_a(bote_req_alloc(), body, "params"), "protocolVersion");
        if (pv == 0) { pv = "2025-11-25"; }
        var sid = session_store_create(st, pv);
        if (sid == 0) {
            bote_http_refuse(cfd, SK_WARN, "http", HTTP_SERVICE_UNAVAILABLE, "Service Unavailable", "session_store_full");
            return 0;
        }
        var sb = str_builder_new_a(bote_req_alloc());
        str_builder_add_cstr(sb, "MCP-Session-Id: ");
        str_builder_add_cstr(sb, sid);
        str_builder_add_cstr(sb, "\r\n");
        extra = str_data(str_builder_build_a(bote_req_alloc(), sb));
    }
    if (resp == 0) { return bote_http_send_accepted(cfd, 0); }
    sandhi_server_send_response_a(bote_req_alloc(), cfd, HTTP_OK, "OK", "application/json",
      resp, strlen(resp), extra);
    return 0;
}

# ================================================================
# Server entry — defers to bote_conn_serve
# ================================================================

fn transport_http_run(dispatcher, config) {
    store64(config + 48, dispatcher);
    return bote_conn_serve("http",
      http_config_addr(config),
      http_config_port(config),
      &_http_handle,
      config);
}

# --- transport_unix.cyr ---

# bote::transport::unix — line-oriented JSON-RPC over a Unix domain socket.
# Mirrors rust-old/src/transport/unix.rs (sync, single-connection-at-a-time).
#
# net.cyr only has AF_INET helpers, so we open the AF_UNIX socket directly.

var AF_UNIX = 1;

# Build a sockaddr_un (110 bytes) at addr_buf with `path` (cstr).
# Returns the actual struct length to pass to bind() (sun_family + path + NUL).
fn _unix_sockaddr(addr_buf, path) {
    memset(addr_buf, 0, 110);
    store16(addr_buf, AF_UNIX);
    var plen = strlen(path);
    if (plen > 107) { plen = 107; }
    memcpy(addr_buf + 2, path, plen);
    store8(addr_buf + 2 + plen, 0);
    return 2 + plen + 1;
}

# Write one reply line: `resp` and its newline, whole. 0, or the stdlib's
# -errno when the write failed, in which case the connection is unusable and
# is dropped (logged once here).
#
# 3.4.3: was two bare `sock_send` calls whose results were ignored, and a
# peer that stopped reading parked the transport in write(2) forever. Every
# client now carries a send deadline (src/conn.cyr); a write it cuts short
# lands here and drops the peer. `sock_send_all` finishes the line or reports
# why not, where a bare `sock_send` could leave half a line on the wire.
fn _unix_reply(cfd, resp) {
    var r = sock_send_all(cfd, resp, strlen(resp));
    if (r >= 0) { r = sock_send_all(cfd, "\n", 1); }
    if (r < 0) {
        bote_conn_log_send_drop("unix", r);
        return r;
    }
    return 0;
}

# `subscriptions/listen` over each connection (3.7.3): a ListenLine (src/listen.cyr), or 0,
# when the method is not found. Set before transport_unix_run. A client's subscriptions end
# with its connection.
var _unix_listen = 0;
fn transport_unix_with_listen(c) { _unix_listen = c; return c; }

var UNIX_BUF_SIZE = 131072;

# Cancellation (3.7.5), as on stdio (src/transport_stdio.cyr): a `notifications/cancelled`
# naming the request, among the complete lines that have arrived past it, read in without
# waiting while there is room; or a client that has closed the connection, both ways, and
# will not read the answer. One that only shut its sending side still gets its answers.
var _unix_cfd = 0 - 1;
var _unix_cbuf = 0;
var _unix_cblen = 0;    # the slot holding how many bytes the buffer holds
var _unix_from = 0;
var _unix_seen = 0;

fn _unix_cancelled(ctx, a, id) {
    if (bote_conn_gone(_unix_cfd, 0) == 1) { return 1; }
    var blen = load64(_unix_cblen);
    var room = UNIX_BUF_SIZE - blen;
    if (room > 0 && bote_conn_readable(_unix_cfd) == 1) {
        var n_t, n_v = sock_recv(_unix_cfd, _unix_cbuf + blen, room);
        if (is_err_result(n_t) == 0 && n_v > 0) {
            blen = blen + n_v;
            store64(_unix_cblen, blen);
        }
    }
    if (_unix_seen < _unix_from) { _unix_seen = _unix_from; }
    var done[8];
    var hit = codec_lines_cancel_a(a, _unix_cbuf + _unix_seen, blen - _unix_seen, id, &done);
    _unix_seen = _unix_seen + load64(&done);
    return hit;
}

fn _unix_begin(from) {
    var a = bote_listen_line_begin(_unix_listen);
    _unix_from = from;
    _unix_seen = from;
    bote_req_set_cancel(&_unix_cancelled, 0);
    return a;
}

# Process complete (newline-terminated) lines in the per-connection buffer.
# Returns 1 if any was processed, 0 if none, and -1 when a reply could not be
# written: the caller then drops the connection. What a cancellation check reads in
# while a line is served is served in the same pass.
fn _unix_process_lines(cfd, dispatcher, buf, blen_ptr) {
    var processed = 0;
    var scanned = 0;
    var line_start = 0;
    while (scanned < load64(blen_ptr)) {
        if (load8(buf + scanned) == 10) {
            store8(buf + scanned, 0);
            var line_len = scanned - line_start;
            if (line_len > 0) {
                var resp = codec_process_message_a(_unix_begin(scanned + 1), buf + line_start, dispatcher, 0);
                if (resp != 0) {
                    if (_unix_reply(cfd, resp) < 0) { return 0 - 1; }
                }
                if (bote_listen_line_broken(_unix_listen) == 1) { return 0 - 1; }
                processed = 1;
            }
            line_start = scanned + 1;
        }
        scanned = scanned + 1;
    }
    if (line_start > 0) {
        var leftover = load64(blen_ptr) - line_start;
        if (leftover > 0) { memcpy(buf, buf + line_start, leftover); }
        store64(blen_ptr, leftover);
    }
    return processed;
}

# ================================================================
# Accept-error policy (3.2.1)
# ================================================================
# Through 3.2.0 the accept loop was `if (cfd >= 0) { ... }` with no
# else — so on ANY persistent accept error it re-issued accept(2)
# immediately, forever: 100% of one core, no backoff, no bound, no
# diagnostic. Under EMFILE the pending connection is not dequeued
# either, so it retried the same connection at full speed.
#
# This is an availability defect, not a privilege one: the socket is
# chmod 0600 (below), so no other UID can even connect. The realistic
# trigger is bote's own fd exhaustion — libro/patra chain fds,
# fs_tools, web_tools' sandhi client sockets — or a low RLIMIT_NOFILE.
#
# `_unix_accept_action` is deliberately a pure fn of errno so the
# policy is unit-testable without a live socket (see
# tests/bote_transport_unix.tcyr). The loop below holds the state.

enum BoteUnixAccept {
    BOTE_ACCEPT_RETRY = 0;      # transient — retry immediately
    BOTE_ACCEPT_BACKOFF = 1;    # resource pressure — sleep, then retry
    BOTE_ACCEPT_FATAL = 2;      # listener unusable — hand back to the caller
}

# Every errno `_unix_accept_action` classifies, spelled by this file.
# BOTE_-prefixed per CLAUDE.md's flat-global-namespace rule — a bare
# `ECONNABORTED` could alias a dep symbol. Through 3.3.11 the five
# names the Linux syscall peer does carry (EINTR / EAGAIN / EINVAL /
# EMFILE / ENFILE) were used bare, and on the agnos target — whose
# peer defines NO errno names — they silently bound to sigil's own
# bare errno enum (`lib/sigil.cyr:44`), i.e. a dependency's leaked
# constants, correct only by coincidence of value. The loop these
# classify runs on Linux alone (agnos fail-closes above), where the
# generic errno numbers are identical on x86_64 and aarch64.
var BOTE_ERRNO_EINTR = 4;
var BOTE_ERRNO_EBADF = 9;
var BOTE_ERRNO_EAGAIN = 11;
var BOTE_ERRNO_ENOMEM = 12;
var BOTE_ERRNO_EINVAL = 22;
var BOTE_ERRNO_ENFILE = 23;
var BOTE_ERRNO_EMFILE = 24;
var BOTE_ERRNO_EPROTO = 71;
var BOTE_ERRNO_ENOTSOCK = 88;
var BOTE_ERRNO_EOPNOTSUPP = 95;
var BOTE_ERRNO_ECONNABORTED = 103;
var BOTE_ERRNO_ENOBUFS = 105;

# Capped exponential backoff: 1ms doubling to 250ms, reset on success.
# BOTE_UNIX_ACCEPT_GIVEUP consecutive backoffs (~50s once the cap is
# reached: 1+2+4+…+128 = 255ms, then 250ms × 192) end the loop rather
# than sleeping forever on a listener that is never coming back.
var BOTE_UNIX_BACKOFF_MIN_MS = 1;
var BOTE_UNIX_BACKOFF_MAX_MS = 250;
var BOTE_UNIX_ACCEPT_GIVEUP = 200;

# Classify a POSITIVE errno from accept(2). Pure.
#
# Unknown errnos fall to BACKOFF, not FATAL, on purpose: misclassifying
# a recoverable condition as fatal would take a working server down,
# while backoff is wrong only in that it wastes up to ~50s before the
# give-up counter ends the loop. Sleeping is never as bad as spinning.
fn _unix_accept_action(err) {
    # Transient — the connection attempt failed, the listener is fine.
    if (err == BOTE_ERRNO_EINTR) { return BOTE_ACCEPT_RETRY; }
    if (err == BOTE_ERRNO_ECONNABORTED) { return BOTE_ACCEPT_RETRY; }
    if (err == BOTE_ERRNO_EPROTO) { return BOTE_ACCEPT_RETRY; }
    # Currently unreachable — the listen fd is never made non-blocking
    # and carries no SO_RCVTIMEO, so accept(2) cannot return EAGAIN.
    # Kept so the loop stays correct if that ever changes.
    if (err == BOTE_ERRNO_EAGAIN) { return BOTE_ACCEPT_RETRY; }

    # Structurally fatal — accept on this fd can never succeed again.
    if (err == BOTE_ERRNO_EBADF) { return BOTE_ACCEPT_FATAL; }
    if (err == BOTE_ERRNO_EINVAL) { return BOTE_ACCEPT_FATAL; }
    if (err == BOTE_ERRNO_ENOTSOCK) { return BOTE_ACCEPT_FATAL; }
    if (err == BOTE_ERRNO_EOPNOTSUPP) { return BOTE_ACCEPT_FATAL; }

    # EMFILE / ENFILE / ENOBUFS / ENOMEM and anything unrecognised.
    return BOTE_ACCEPT_BACKOFF;
}

# Next backoff delay in ms given the current one (0 = none yet).
fn _unix_backoff_next(cur_ms) {
    if (cur_ms <= 0) { return BOTE_UNIX_BACKOFF_MIN_MS; }
    var next = cur_ms * 2;
    if (next > BOTE_UNIX_BACKOFF_MAX_MS) { return BOTE_UNIX_BACKOFF_MAX_MS; }
    return next;
}

# One connection is served at a time, so one read buffer serves them all.
var _unix_buf = 0;
fn _unix_handle_client(cfd, dispatcher) {
    bote_listen_line_attach(_unix_listen, dispatcher, &_unix_reply, cfd);
    var r = _unix_serve_client(cfd, dispatcher);
    bote_listen_line_detach(_unix_listen);
    return r;
}

# The idle deadline's line, from the wait or the read: the same either way.
fn _unix_log_idle() {
    var rl[BOTE_LOG_LINE_BYTES];
    bote_log_line(&rl, SK_DEBUG, "unix client idle; closed");
    bote_log_int(&rl, "idle_ms", BOTE_UNIX_IDLE_MS);
    bote_log_emit(&rl);
    return 0;
}

fn _unix_serve_client(cfd, dispatcher) {
    if (_unix_buf == 0) { _unix_buf = alloc(UNIX_BUF_SIZE); }
    var buf = _unix_buf;
    var blen_store[8];
    var blen_slot = &blen_store;
    store64(blen_slot, 0);
    _unix_cfd = cfd;
    _unix_cbuf = buf;
    _unix_cblen = blen_slot;
    var skipping = 0;
    var heard = clock_now_ms();
    while (1 == 1) {
        var blen = load64(blen_slot);
        var space = UNIX_BUF_SIZE - blen;
        if (space <= 0) {
            if (_unix_reply(cfd, codec_line_too_long()) < 0) { return 0; }
            skipping = 1;
            store64(blen_slot, 0);
            blen = 0;
            space = UNIX_BUF_SIZE;
        }
        # With subscriptions possible, changes go out while the client is quiet; the idle
        # deadline still counts from what the client last sent.
        if (_unix_listen != 0) {
            var deadline = 0;
            if (BOTE_UNIX_IDLE_MS > 0) { deadline = heard + BOTE_UNIX_IDLE_MS; }
            var w = bote_listen_line_await(_unix_listen, cfd, deadline);
            if (w < 0) { return 0; }
            if (w == 0) { return _unix_log_idle(); }
        }
        var n_t, n_v = sock_recv(cfd, buf + blen, space);
        heard = clock_now_ms();
        if (is_err_result(n_t) == 1) {
            # EAGAIN is the opt-in idle deadline (BOTE_UNIX_IDLE_MS) firing;
            # anything else is the peer going away. Either way, close.
            if (n_v == BOTE_ERRNO_EAGAIN) { return _unix_log_idle(); }
            var rl[BOTE_LOG_LINE_BYTES];
            bote_log_line(&rl, SK_DEBUG, "unix client read failed; closed");
            bote_log_int(&rl, "errno", n_v);
            bote_log_emit(&rl);
            return 0;
        }
        var n = n_v;
        if (n <= 0) {
            # EOF — flush any final unterminated line.
            if (blen > 0) {
                store8(buf + blen, 0);
                var resp = codec_process_message_a(_unix_begin(blen), buf, dispatcher, 0);
                if (resp != 0) { _unix_reply(cfd, resp); }
            }
            return 0;
        }
        if (skipping == 1) {
            var le = codec_line_end(buf + blen, n);
            if (le < 0) { continue; }
            skipping = 0;
            n = n - le;
            if (n > 0) { memcpy(buf + blen, buf + blen + le, n); }
        }
        store64(blen_slot, blen + n);
        if (_unix_process_lines(cfd, dispatcher, buf, blen_slot) < 0) { return 0; }
    }
    return 0;
}

# Bind a Unix socket at `path` and accept connections, dispatching each
# newline-terminated message via codec_process_message. Removes any prior
# socket file at that path.
# One ERROR line for a listener step that failed: which step, the socket
# path, and the errno the kernel gave (3.4.0; every one of these returned 1
# without a word before).
fn _unix_log_fail(step, path, err) {
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_ERROR, "unix transport failed");
    bote_log_str(&ln, "step", step);
    bote_log_str(&ln, "path", path);
    bote_log_int(&ln, "errno", err);
    bote_log_emit(&ln);
    return 1;
}

fn transport_unix_run(dispatcher, path) {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no AF_UNIX domain sockets — the Unix-socket transport
    # fail-closes there (bote's TCP / streamable / ws transports carry
    # traffic instead). Guarding the entry drops the whole AF_UNIX subtree
    # (socket/bind/chmod/listen/accept — unrelated syscall numbers on
    # agnos) off the agnos target; mirrors majra's ipc AF_UNIX guard.
    bote_log_error("unix transport unavailable: agnos has no AF_UNIX sockets");
    return 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # 3.2.0 (aarch64 portability): sys_unlink / sys_chmod are the stdlib's
    # arch-portable wrappers. The raw SYS_UNLINK / SYS_CHMOD constants they
    # replaced are defined only in lib/syscalls_x86_64_linux.cyr — aarch64
    # Linux's generic table has unlinkat(2) and fchmodat(2) and neither
    # bare form — so both were hard `undefined variable` errors there.
    #
    # 3.2.1: every remaining raw `syscall(SYS_*, ...)` in this function
    # now goes through its stdlib peer wrapper too. Three of them
    # (sys_socket / sys_bind / sys_listen / sys_close) were already
    # arch-correct — the peers define SYS_SOCKET as 41 on x86_64 and 198
    # on aarch64 — so that part is style, and it is what lets CI ban a
    # bare `syscall(SYS_` in src/ outright.
    #
    # The accept call was NOT style. See the sys_accept4 note below.
    # sockaddr_un holds 107 bytes: a longer path would bind one name and chmod
    # another, so the socket keeps the umask's mode.
    if (strlen(path) > 107) { return _unix_log_fail("path_too_long", path, 36); }
    # Only a socket is replaced. It is the one thing open(2) refuses here, so an
    # open that works means a file, and that is somebody's data.
    var pfd = file_open(path, O_RDONLY | O_NONBLOCK | O_NOFOLLOW, 0);
    if (pfd >= 0) {
        file_close(pfd);
        return _unix_log_fail("path_not_a_socket", path, 17);
    }
    sys_unlink(path);
    var sfd = sys_socket(AF_UNIX, SOCK_STREAM, 0);
    if (sfd < 0) { return _unix_log_fail("socket", path, 0 - sfd); }
    var addr = alloc(110);
    var addrlen = _unix_sockaddr(addr, path);
    var br = sys_bind(sfd, addr, addrlen);
    if (br < 0) { sys_close(sfd); return _unix_log_fail("bind", path, 0 - br); }
    # 1.9.6 audit L1: restrict perms so only the owning UID can connect.
    # Without this the socket inherits the process umask (typically 0022 →
    # mode 0755) and any local user can dial it.
    var cr = sys_chmod(path, 0x180);   # 0o600 = 384 decimal = 0x180
    if (cr < 0) {
        sys_close(sfd);
        sys_unlink(path);
        return _unix_log_fail("chmod", path, 0 - cr);
    }
    var lr = sys_listen(sfd, 16);
    if (lr < 0) { sys_close(sfd); return _unix_log_fail("listen", path, 0 - lr); }
    var ll[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ll, SK_INFO, "listening");
    bote_log_str(&ll, "transport", "unix");
    bote_log_str(&ll, "path", path);
    bote_log_emit(&ll);

    # 3.2.1: `sys_accept4(sfd, 0, 0, 0)` replaces
    # `syscall(SYS_ACCEPT, sfd, 0, 0)`.
    #
    # `SYS_ACCEPT` is defined in NEITHER syscall peer. Its only definition
    # anywhere in lib/ is `lib/net.cyr:12` — a bare, unguarded
    # `var SYS_ACCEPT = 43`, the **x86_64** number. On aarch64 it resolved
    # to 43 regardless of arch and worked only because the cyrius backend
    # emits a runtime renumber chain (`ESYSXLAT`, 43 → 202) ahead of every
    # `svc`. That is an implementation detail, not a documented guarantee,
    # and 43 on aarch64 is `statfs` — an unlisted number does not fail
    # loudly, it calls the wrong syscall.
    #
    # `sys_accept4` issues `SYS_ACCEPT4`, which the peers define natively
    # per arch (x86_64 288, aarch64 242). Neither number is in the
    # renumber table because neither needs to be. `accept4(fd, NULL, NULL,
    # 0)` is defined to be exactly `accept(fd, NULL, NULL)`.
    #
    # The stdlib makes this argument itself, at `sys_getpeername` in
    # lib/syscalls_linux_common.cyr: sandhi hardcoded a raw
    # `syscall(52, ...)` for getpeername, which on aarch64 is **fchmod**
    # and *succeeds* — "the caller believes it obtained a peer address
    # while its buffer is untouched garbage. Verified on real pi." Its
    # conclusion is explicit: do NOT solve that class with an ESYSXLAT
    # entry; take the number from the per-arch peer. This does that.
    #
    # Note `sock_accept()` (lib/net.cyr) would NOT have fixed it — its own
    # non-agnos branch issues the same bare 43. It would have relocated
    # the dependence into the stdlib, not removed it.
    #
    # flags stays 0 for exact behavioural parity with the accept(2) this
    # replaces. `SOCK_CLOEXEC` is available here and is the usual reason
    # to reach for accept4; adopting it would be a behaviour change and
    # belongs in its own bite.
    var backoff_ms = 0;
    var consecutive = 0;
    while (1 == 1) {
        var cfd = sys_accept4(sfd, 0, 0, 0);
        if (cfd >= 0) {
            if (consecutive > 0) {
                var rl[BOTE_LOG_LINE_BYTES];
                bote_log_line(&rl, SK_INFO, "unix accept recovered");
                bote_log_int(&rl, "attempts", consecutive);
                bote_log_emit(&rl);
            }
            backoff_ms = 0;
            consecutive = 0;
            # 3.4.3: a send deadline on every client, and the idle deadline
            # when an operator configured one (src/conn.cyr explains why the
            # first is on by default and the second is not).
            bote_conn_send_deadline(cfd);
            bote_conn_unix_idle_deadline(cfd);
            _unix_handle_client(cfd, dispatcher);
            sys_close(cfd);
        } else {
            # 3.2.1: was `if (cfd >= 0) { ... }` with no else — a 100%-CPU
            # spin forever on any persistent error. See the policy block
            # above `_unix_accept_action`.
            var act = _unix_accept_action(0 - cfd);
            if (act == BOTE_ACCEPT_FATAL) {
                sys_close(sfd);
                return _unix_log_fail("accept", path, 0 - cfd);
            }
            if (act == BOTE_ACCEPT_BACKOFF) {
                consecutive = consecutive + 1;
                # One WARN when a backoff episode starts, not one per retry:
                # an fd-exhausted listener would otherwise write up to
                # BOTE_UNIX_ACCEPT_GIVEUP lines in a few seconds.
                if (consecutive == 1) {
                    var bl[BOTE_LOG_LINE_BYTES];
                    bote_log_line(&bl, SK_WARN, "unix accept failing; backing off");
                    bote_log_int(&bl, "errno", 0 - cfd);
                    bote_log_emit(&bl);
                }
                if (consecutive > BOTE_UNIX_ACCEPT_GIVEUP) {
                    sys_close(sfd);
                    var gl[BOTE_LOG_LINE_BYTES];
                    bote_log_line(&gl, SK_ERROR, "unix transport gave up accepting");
                    bote_log_int(&gl, "errno", 0 - cfd);
                    bote_log_int(&gl, "attempts", consecutive);
                    bote_log_emit(&gl);
                    return 1;
                }
                backoff_ms = _unix_backoff_next(backoff_ms);
                sleep_ms(backoff_ms);
            }
        }
    }
    return 0;
    #endif
}

# --- bridge.cyr ---

# bote::bridge — TypeScript-bridge HTTP transport with CORS + MCP envelope wrap
# Mirrors rust-old/src/bridge.rs.
#
# Reuses transport_http.cyr for socket/parsing/response plumbing. Adds:
#   - POST /            — JSON-RPC dispatch, wraps tools/call results in MCP envelope
#   - OPTIONS /         — CORS preflight (204 + headers)
#   - GET /health       — liveness check ("ok")
#   - CORS headers on every response
#
# An MCP envelope for a tool result looks like:
#   { "content": [{"type":"text","text":"..."}] }
# wrap_tool_result passes through if the value already has a "content" array.

# ================================================================
# BridgeConfig (56 bytes):
#   +0  bind_addr        i64 (network-order IPv4)
#   +8  port             i64
#   +16 allowed_origins  vec of cstrs or 0 (0 / empty / contains "*" → wildcard)
#   +24 dispatcher       Dispatcher ptr (set by transport_bridge_run)
#   +32 bearer_validator fn ptr (token, ctx) → claims | 0, or 0 to disable
#   +40 bearer_ctx       i64 ctx passed verbatim to validator
#   +48 resource_metadata ProtectedResource or 0
# ================================================================

fn bridge_config_new(addr, port) {
    var c = alloc(56);
    store64(c, addr);
    store64(c + 8, port);
    store64(c + 16, 0);
    store64(c + 24, 0);
    store64(c + 32, 0);
    store64(c + 40, 0);
    store64(c + 48, 0);
    return c;
}

fn bridge_config_with_resource_metadata(c, p) { store64(c + 48, p); return c; }
fn bridge_config_resource_metadata(c) { return load64(c + 48); }

fn bridge_config_with_origins(c, vec)        { store64(c + 16, vec); return c; }
fn bridge_config_with_dispatcher(c, d)       { store64(c + 24, d);   return c; }
fn bridge_config_with_bearer_validator(c, fp, ctx) {
    store64(c + 32, fp);
    store64(c + 40, ctx);
    return c;
}
fn bridge_config_addr(c)             { return load64(c); }
fn bridge_config_port(c)             { return load64(c + 8); }
fn bridge_config_origins(c)          { return load64(c + 16); }
fn bridge_config_dispatcher(c)       { return load64(c + 24); }
fn bridge_config_bearer_validator(c) { return load64(c + 32); }
fn bridge_config_bearer_ctx(c)       { return load64(c + 40); }

# ================================================================
# Envelope wrappers
# ================================================================

# Wrap a raw tool result cstr (raw JSON literal) into the MCP envelope
# unless it already has a top-level `content` array.
#
# Three input shapes, three behaviours:
#   1. Object with a `content` array → pass through verbatim. Used by
#      handlers that pre-shape their own envelope.
#   2. Object with a `type` field (a single MCP content block, possibly
#      carrying annotations) → lift into a 1-element content array.
#      This preserves any block-level annotations the handler attached
#      via `content_with_annotations` (1.9.6); the block is spliced
#      verbatim rather than re-stringified as a `text` payload.
#   3. Anything else (scalar, string, non-block object, array) → wrap
#      the JSON-escaped text under a synthesised `text` block.
fn wrap_tool_result(result) { return wrap_tool_result_a(default_alloc(), result); }

fn wrap_tool_result_a(a, result) {
    if (result == 0) { result = "null"; }
    if (jsonx_is_object(result) == 1) {
        # (1) Passthrough — has a `content` array.
        if (jsonx_has(result, "content") == 1) {
            var c = jsonx_get_raw_a(a, result, "content");
            if (c != 0) {
                var ci = 0;
                var clen = strlen(c);
                while (ci < clen) {
                    var cc = load8(c + ci);
                    if (cc == 32 || cc == 9 || cc == 10 || cc == 13) { ci = ci + 1; }
                    else {
                        if (cc == 91) { return result; }
                        ci = clen;
                    }
                }
            }
        }
        # (2) Single content block — lift into the envelope without
        # decomposing. Preserves annotations (1.9.6 → 2.7.0).
        if (jsonx_has(result, "type") == 1) {
            var sb_lift = str_builder_new_a(a);
            _sb_grow_a(a, sb_lift, strlen(result) + 16);
            str_builder_add_cstr(sb_lift, "{\"content\":[");
            str_builder_add_cstr(sb_lift, result);
            str_builder_add_cstr(sb_lift, "]}");
            return str_data(str_builder_build_a(a, sb_lift));
        }
    }
    # (3) Else build a synthesised text-block envelope. The text payload
    # is the raw JSON, JSON-escaped.
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, strlen(result) * 6 + 64);
    str_builder_add_cstr(sb, "{\"content\":[{\"type\":\"text\",\"text\":\"");
    _json_emit_escaped(sb, result);
    str_builder_add_cstr(sb, "\"}]}");
    return str_data(str_builder_build_a(a, sb));
}

# Wrap an error message into an MCP envelope with isError: true.
fn wrap_error_result(message) { return wrap_error_result_a(default_alloc(), message); }

fn wrap_error_result_a(a, message) {
    var sb = str_builder_new_a(a);
    var room = 64;
    if (message != 0) { room = room + strlen(message) * 6; }
    _sb_grow_a(a, sb, room);
    str_builder_add_cstr(sb, "{\"content\":[{\"type\":\"text\",\"text\":\"");
    if (message != 0) { _json_emit_escaped(sb, message); }
    str_builder_add_cstr(sb, "\"}],\"isError\":true}");
    return str_data(str_builder_build_a(a, sb));
}

# ================================================================
# Bridge-aware message processor
# ================================================================
#
# Like codec_process_message, but for tools/call responses:
#   - success: wrap result in MCP envelope (passthrough if already shaped)
#   - error:   convert to success(wrap_error_result(message)) per SY contract
#              (JSON-RPC 2.0 forbids both result+error; SY wants the envelope)
# Other methods (initialize, tools/list, batch elements) pass through unchanged.

fn _bridge_process_single(a, line, dispatcher, claims) {
    # The codec's own admission checks, so a request the codec refuses is
    # refused here the same way (3.4.5; this was a second copy before).
    var err_slot[8];
    var req = _cdc_admit_a(a, line, &err_slot);
    if (req == 0) { return load64(&err_slot); }
    var resp = dispatcher_dispatch_a(a, dispatcher, req, claims);
    if (resp == 0) { return 0; }

    # Bridge wrapping only applies to tools/call.
    if (streq(req_method(req), "tools/call") == 1) {
        var success_result = resp_result(resp);
        var err_obj = resp_error_obj(resp);
        if (success_result != 0) {
            var wrapped = wrap_tool_result_a(a, success_result);
            return codec_serialize_response_a(a, resp_success_a(a, resp_id(resp), wrapped));
        }
        if (err_obj != 0) {
            var wrapped_err = wrap_error_result_a(a, rpc_err_message(err_obj));
            return codec_serialize_response_a(a, resp_success_a(a, resp_id(resp), wrapped_err));
        }
    }
    return codec_serialize_response_a(a, resp);
}

fn bridge_process_message(input, dispatcher, claims) {
    return bridge_process_message_a(default_alloc(), input, dispatcher, claims);
}

fn bridge_process_message_a(a, input, dispatcher, claims) {
    if (input == 0) { return _cdc_parse_error_a(a, "empty input"); }
    var len = strlen(input);
    var i = _cdc_skip_ws(input, len, 0);
    if (i >= len) { return _cdc_parse_error_a(a, "empty input"); }
    if (jsonx_valid(input, len) == 0) { return _cdc_parse_error_a(a, "invalid JSON"); }
    var first = load8(input + i);

    # Batch arrays defer to the codec (no per-element wrapping; the bridge
    # contract is single-tool-call → MCP envelope).
    if (first == 91) { return codec_process_message_a(a, input, dispatcher, claims); }
    if (first == 123) { return _bridge_process_single(a, input, dispatcher, claims); }
    return _cdc_invalid_request_a(a, "expected object or array");
}

# ================================================================
# CORS header builder
# ================================================================
#
# Returns a cstr of CORS headers (each line ending in CRLF) ready to splice
# into _http_send_* via the extra_headers slot. allowed_origins is a vec or 0.

fn _bridge_cors_origin(allowed_origins, request_origin) {
    if (request_origin == 0 || allowed_origins == 0) { return 0; }
    var n = vec_len(allowed_origins);
    var i = 0;
    while (i < n) {
        if (streq(vec_get(allowed_origins, i), "*") == 1) { return "*"; }
        i = i + 1;
    }
    var j = 0;
    while (j < n) {
        if (streq(vec_get(allowed_origins, j), request_origin) == 1) {
            return request_origin;
        }
        j = j + 1;
    }
    return 0;
}

# The CORS headers for an Origin that passed, or none: no header at all is what
# tells a browser no, and `null` would match a sandboxed iframe's Origin.
fn _bridge_cors_headers(allowed_origins, request_origin) {
    var acao = _bridge_cors_origin(allowed_origins, request_origin);
    if (acao == 0) { return ""; }
    var a = bote_req_alloc();
    var sb = str_builder_new_a(a);
    str_builder_add_cstr_a(a, sb, "Access-Control-Allow-Origin: ");
    str_builder_add_cstr_a(a, sb, acao);
    str_builder_add_cstr_a(a, sb, "\r\nVary: Origin\r\nAccess-Control-Allow-Methods: POST, GET, OPTIONS\r\n");
    str_builder_add_cstr_a(a, sb, "Access-Control-Allow-Headers: content-type, authorization\r\n");
    # A page reads a response header only if told it may, and a 401 or 403 says nothing else.
    str_builder_add_cstr_a(a, sb, "Access-Control-Expose-Headers: WWW-Authenticate\r\n");
    return str_data(str_builder_build_a(a, sb));
}

fn _bridge_send_health(cfd, allowed_origins, request_origin) {
    var cors = _bridge_cors_headers(allowed_origins, request_origin);
    sandhi_server_send_response_a(bote_req_alloc(), cfd, HTTP_OK, "OK", "text/plain", "ok", 2, cors);
    return 0;
}

# ================================================================
# Per-connection handler — invoked per connection by sandhi's serve loop
# ================================================================
#
# BridgeConfig now carries the dispatcher in the +24 slot (see
# bridge_config_with_dispatcher below). We pass the config as ctx.

fn _bridge_handle(config, cfd, buf, n) {
    # 3.4.3: bound every write to this client (src/conn.cyr).
    bote_conn_send_deadline(cfd);
    var allowed_origins = bridge_config_origins(config);
    var dispatcher      = bridge_config_dispatcher(config);

    var a = bote_req_begin();
    if (bote_http_head_nul(buf, n) == 1) {
        bote_http_refuse(cfd, SK_WARN, "bridge", HTTP_BAD_REQUEST, "Bad Request", "nul_in_head");
        return 0;
    }
    var method = sandhi_server_get_method_a(a, buf, n);
    var path   = sandhi_server_get_path_a(a, buf, n);
    var origin = sandhi_server_find_header_a(bote_req_alloc(), buf, n, "Origin");
    # Before everything, the preflight included: an Origin the operator did not
    # allow never reaches a tool.
    if (bote_http_origin_ok(origin, allowed_origins, buf, n) == 0) {
        bote_http_refuse(cfd, SK_WARN, "bridge", HTTP_FORBIDDEN, "Forbidden", "origin");
        return 0;
    }
    var cors   = _bridge_cors_headers(allowed_origins, origin);

    # OPTIONS preflight
    if (streq(method, "OPTIONS") == 1) {
        sandhi_server_send_204_a(bote_req_alloc(), cfd, cors);
        return 0;
    }
    var hc[40];
    bote_http_ctx(&hc, cfd, "bridge", buf, n, cors);
    var prm = bridge_config_resource_metadata(config);
    if (bote_prm_route(&hc, prm, method, path, allowed_origins) == 1) { return 0; }
    # GET /health
    if (streq(method, "GET") == 1) {
        if (streq(sandhi_server_path_only_a(bote_req_alloc(), path), "/health") == 1) {
            _bridge_send_health(cfd, allowed_origins, origin);
            return 0;
        }
        bote_http_refuse_hdr(cfd, SK_DEBUG, "bridge", HTTP_NOT_FOUND, "Not Found", "path", cors);
        return 0;
    }
    # Anything other than POST is rejected.
    if (streq(method, "POST") == 0) {
        bote_http_refuse_method_hdr(cfd, "bridge", "Allow: POST, GET, OPTIONS\r\n", cors);
        return 0;
    }
    # Only "/" is the bridge endpoint.
    if (streq(sandhi_server_path_only_a(bote_req_alloc(), path), "/") == 0) {
        bote_http_refuse_hdr(cfd, SK_DEBUG, "bridge", HTTP_NOT_FOUND, "Not Found", "path", cors);
        return 0;
    }

    # Reject ambiguous Transfer-Encoding (HTTP smuggling guard, RFC 9112)
    if (sandhi_server_find_header_a(bote_req_alloc(), buf, n, "Transfer-Encoding") != 0) {
        bote_http_refuse_hdr(cfd, SK_WARN, "bridge", HTTP_BAD_REQUEST, "Bad Request", "transfer_encoding", cors); return 0;
    }
    # Bearer auth (no-op when no validator configured)
    var claims_slot[8]; store64(&claims_slot, 0);
    if (auth_bearer_check_hdr(cfd, buf, n,
        bridge_config_bearer_validator(config),
        bridge_config_bearer_ctx(config),
        &claims_slot, bote_prm_challenge(prm), cors) != 0) { return 0; }

    # 413 cap on oversized declared bodies (audit M1). 60 KB headroom
    # keeps us inside the 64 KB recv buffer with room for headers.
    if (bote_http_clen_bad(buf, n) == 1) {
        bote_http_refuse_hdr(cfd, SK_WARN, "bridge", HTTP_BAD_REQUEST, "Bad Request", "content_length", cors);
        return 0;
    }
    var declared_clen = sandhi_server_content_length(buf, n);
    if (declared_clen > 61440) {
        bote_http_refuse_hdr(cfd, SK_WARN, "bridge", HTTP_PAYLOAD_TOO_LARGE, "Payload Too Large", "payload_too_large", cors); return 0;
    }

    var body_off = sandhi_server_body_offset(buf, n);
    if (body_off < 0 || body_off > n) {
        bote_http_refuse_hdr(cfd, SK_DEBUG, "bridge", HTTP_BAD_REQUEST, "Bad Request", "malformed_request", cors);
        return 0;
    }
    var clen = sandhi_server_content_length(buf, n);
    if (clen <= 0) { clen = n - body_off; }
    if (clen < 0) { clen = 0; }
    if (clen > n - body_off) { clen = n - body_off; }
    var body = buf + body_off;
    store8(body + clen, 0);
    # A NUL would end the message early, and whatever follows it would go
    # unread by the syntax check.
    if (strlen(body) != clen) {
        bote_http_refuse_hdr(cfd, SK_WARN, "bridge", HTTP_BAD_REQUEST, "Bad Request", "nul_in_body", cors);
        return 0;
    }

    # The modern revision has the same rules here as on any HTTP endpoint. What the
    # bridge does differently below is its own contract with legacy callers.
    var mreq[8];
    var era = bote_http_era(&hc, body, 0, dispatcher, &mreq);
    if (era == BOTE_HTTP_REFUSED) { return 0; }
    if (bote_http_scope_gate(&hc, dispatcher, body, load64(&claims_slot), prm) != 0) { return 0; }
    if (era == BOTE_HTTP_MODERN) {
        return bote_http_serve_modern(&hc, load64(&mreq), dispatcher, load64(&claims_slot));
    }

    var resp = bridge_process_message_a(a, body, dispatcher, load64(&claims_slot));
    if (resp == 0) {
        sandhi_server_send_204_a(bote_req_alloc(), cfd, cors);
        return 0;
    }
    sandhi_server_send_response_a(bote_req_alloc(), cfd, HTTP_OK, "OK", "application/json",
      resp, strlen(resp), cors);
    return 0;
}

# ================================================================
# Server entry — defers to bote_conn_serve
# ================================================================

fn transport_bridge_run(dispatcher, config) {
    bridge_config_with_dispatcher(config, dispatcher);
    return bote_conn_serve("bridge",
      bridge_config_addr(config),
      bridge_config_port(config),
      &_bridge_handle,
      config);
}

# --- transport_streamable.cyr ---

# bote::transport::streamable — Streamable HTTP transport (MCP 2025-11-25 and
# 2026-07-28, on one endpoint: src/http_era.cyr chooses per request)
# Mirrors rust-old/src/transport/streamable.rs.
#
# Single endpoint serves both POST (JSON-RPC) and GET (SSE). GET is the legacy
# era's: it is 405 to a request that names 2026-07-28, which has no GET stream.
# Built on stdlib lib/sandhi.cyr chunked primitives (the 5.10.x fold of
# the old lib/http_server.cyr).
#
# What's implemented in v1.4.0:
#   - POST <endpoint>  → JSON-RPC dispatch (identical to transport_http)
#   - GET  <endpoint>  → opens SSE stream, emits priming event + retry hint
#                        + replays buffered events if Last-Event-ID is set,
#                        then closes
#   - Origin / MCP-Protocol-Version / MCP-Session-Id middleware (from session.cyr)
#   - EventIdGenerator (monotonic "evt-N" counter)
#   - StreamEvent + ResumptionBuffer (bounded ring of recent events)
#
# What's deferred (waits on streaming dispatch / lib/thread.cyr v1.5+):
#   - Server-initiated push events on the GET stream (the resumption buffer
#     is wired in but stays empty until something publishes to it)
#   - $/cancelRequest mid-stream

# ================================================================
# EventIdGenerator (8 bytes): monotonic counter
# ================================================================

fn event_id_gen_new() {
    var g = alloc(8);
    store64(g, 0);
    return g;
}

# Returns a new alloc'd cstr "evt-N" and bumps the counter.
fn event_id_gen_next(g) {
    var n = load64(g);
    store64(g, n + 1);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "evt-");
    str_builder_add_int(sb, n);
    return str_data(str_builder_build(sb));
}

# ================================================================
# StreamEvent (24 bytes):
#   +0  id    cstr ("evt-N")
#   +8  type  cstr ("message")
#   +16 data  cstr (JSON payload, may be "")
# ================================================================

fn stream_event_new(id, data) {
    var e = alloc(24);
    store64(e, id);
    store64(e + 8, "message");
    store64(e + 16, data);
    return e;
}

# Primer event (empty data, sent on GET connect to confirm the stream).
fn stream_event_primer(id) { return stream_event_new(id, ""); }

fn stream_event_id(e)   { return load64(e); }
fn stream_event_type(e) { return load64(e + 8); }
fn stream_event_data(e) { return load64(e + 16); }

# Render a StreamEvent in SSE wire format:
#   id: <id>\n
#   event: <type>\n
#   data: <data>\n
#   \n
fn stream_event_to_wire(e) { return stream_event_to_wire_a(default_alloc(), e); }

# stream_event_to_wire on `a`: what the transport sends, on the request arena.
fn stream_event_to_wire_a(a, e) {
    var sb = str_builder_new_a(a);
    str_builder_add_cstr_a(a, sb, "id: ");
    str_builder_add_cstr_a(a, sb, stream_event_id(e));
    str_builder_add_cstr_a(a, sb, "\nevent: ");
    str_builder_add_cstr_a(a, sb, stream_event_type(e));
    str_builder_add_cstr_a(a, sb, "\ndata: ");
    str_builder_add_cstr_a(a, sb, stream_event_data(e));
    str_builder_add_cstr_a(a, sb, "\n\n");
    return str_data(str_builder_build_a(a, sb));
}

# ================================================================
# ResumptionBuffer (24 bytes):
#   +0  events    vec of StreamEvent ptrs (insertion order)
#   +8  max_size  i64
#   +16 unused    reserved
# ================================================================

fn resumption_buffer_new(max_size) {
    var rb = alloc(24);
    store64(rb, vec_new());
    store64(rb + 8, max_size);
    store64(rb + 16, 0);
    return rb;
}

fn resumption_buffer_default() { return resumption_buffer_new(1000); }

fn resumption_buffer_events(rb)   { return load64(rb); }
fn resumption_buffer_max_size(rb) { return load64(rb + 8); }
fn resumption_buffer_len(rb)      { return vec_len(load64(rb)); }

# Push an event. Evicts oldest when over max_size.
fn resumption_buffer_push(rb, event) {
    var events = resumption_buffer_events(rb);
    if (vec_len(events) >= resumption_buffer_max_size(rb)) {
        vec_remove(events, 0);
    }
    vec_push(events, event);
    return 0;
}

# Return a vec of events whose IDs come after `last_event_id`.
# Returns empty vec if last_event_id isn't found (client missed too much),
# or if last_event_id is null/empty (streq on null would segfault;
# empty string never matches a real "evt-N" id).
fn resumption_buffer_events_after(rb, last_event_id) {
    return resumption_buffer_events_after_a(default_alloc(), rb, last_event_id);
}

# resumption_buffer_events_after, the vec on `a`.
fn resumption_buffer_events_after_a(a, rb, last_event_id) {
    var out = vec_new_a(a);
    if (last_event_id == 0) { return out; }
    if (load8(last_event_id) == 0) { return out; }
    var events = resumption_buffer_events(rb);
    var n = vec_len(events);
    var found_at = 0 - 1;
    var i = 0;
    while (i < n) {
        var e = vec_get(events, i);
        if (streq(stream_event_id(e), last_event_id) == 1) {
            found_at = i;
            i = n;
        }
        i = i + 1;
    }
    if (found_at < 0) { return out; }
    var j = found_at + 1;
    while (j < n) {
        vec_push_a(a, out, vec_get(events, j));
        j = j + 1;
    }
    return out;
}

# ================================================================
# SessionOutbound (16 bytes) — per-session server→client push state:
#   +0  buffer  ResumptionBuffer ptr (this session's pending notifications)
#   +8  id_gen  EventIdGenerator ptr — PER SESSION on purpose. IDs must never
#               straddle another session's: resumption_buffer_events_after
#               matches an EXACT id and returns empty on a miss, so a shared
#               global generator would let one session's Last-Event-ID land in
#               a gap (an id consumed by a different session) and silently
#               resume nothing. A per-session counter keeps each buffer's ids
#               dense and self-contained.
# ================================================================

fn session_outbound_new() {
    var so = alloc(16);
    store64(so, resumption_buffer_default());
    store64(so + 8, event_id_gen_new());
    return so;
}

fn session_outbound_buffer(so) { return load64(so); }
fn session_outbound_id_gen(so) { return load64(so + 8); }

# Lazily get (or create) the SessionOutbound bundle for an McpSession,
# stashing it in the session's opaque outbound slot (session.cyr keeps that
# slot type-agnostic). Returns the bundle. Installed with a compare-and-swap
# (3.7.0): two workers that both find the slot empty keep one bundle between
# them, so a notification pushed into it is not lost with the other.
fn _strm_session_outbound(session) {
    var so = mcp_session_outbound(session);
    if (so != 0) { return so; }
    so = session_outbound_new();
    if (atomic_cas(session + 32, 0, so) == 1) { return so; }
    return mcp_session_outbound(session);
}

# ================================================================
# Client-notification sink — bridges dispatcher EventSink topics to the
# per-session outbound buffers as MCP notifications.
# ================================================================
#
# Wired as the dispatcher's EventSink (dispatcher_set_events); ctx is the
# SessionStore. On a tool-set change it broadcasts notifications/tools/
# list_changed into EVERY active session's buffer (each with that session's
# own event id), for delivery on that session's next GET. Non-tool-set
# topics (completed/failed/deprecated/…) are audit events, not client
# notifications, and are ignored here.

fn _strm_notify_publish(ctx, topic, payload) {
    var wire = 0;
    if (streq(topic, TOPIC_TOOL_REGISTERED()) == 1
      || streq(topic, TOPIC_TOOL_DEREGISTERED()) == 1) {
        wire = tools_list_changed_notification();
    } elif (streq(topic, TOPIC_PROMPT_REGISTERED()) == 1) {
        wire = prompts_list_changed_notification();
    } elif (streq(topic, TOPIC_RESOURCE_REGISTERED()) == 1) {
        wire = resources_list_changed_notification();
    } else {
        return 0;
    }
    if (ctx == 0) { return 0; }
    # Under the store's lock, which also guards every session's buffer: a worker
    # may be draining one while this pushes to it.
    session_store_lock(ctx);
    var ids = session_store_ids(ctx);
    var sessions = session_store_sessions(ctx);
    var n = vec_len(ids);
    var i = 0;
    while (i < n) {
        var session = map_get(sessions, vec_get(ids, i));
        if (session != 0) {
            var so = _strm_session_outbound(session);
            resumption_buffer_push(session_outbound_buffer(so),
              stream_event_new(event_id_gen_next(session_outbound_id_gen(so)), wire));
        }
        i = i + 1;
    }
    session_store_unlock(ctx);
    return 0;
}

# Build the client-notification EventSink for a SessionStore. Pass to
# dispatcher_set_events so tool register/dereg fan out to session buffers.
fn strm_notify_sink(store) {
    return event_sink_set_list_only(event_sink_new(&_strm_notify_publish, store));
}

# ================================================================
# StreamableConfig (96 bytes):
#   +0  endpoint_path     cstr (e.g. "/mcp")
#   +8  bind_addr         i64
#   +16 port              i64
#   +24 allowed_origins   vec of cstrs or 0
#   +32 require_protocol  0/1
#   +40 session_store     SessionStore ptr or 0
#   +48 retry_ms          i64 (SSE retry hint, default 5000)
#   +56 dispatcher        Dispatcher ptr (set by transport_streamable_run)
#   +64 bearer_validator  fn ptr (token, ctx) → claims | 0, or 0 to disable
#   +72 bearer_ctx        i64 ctx passed verbatim to validator
#   +80 resource_metadata Protected Resource Metadata (src/oauth_metadata.cyr) or 0
#   +88 workers           worker threads to serve on (3.7.0), or 0 for the calling
#                         thread alone. With workers, bote's own state is safe
#                         between them and the dispatcher's sinks take turns
#                         (bote_conn_serial_sinks); a handler is called from any
#                         of them. bote's own tools are safe there, and so is
#                         registering while serving (3.7.1). An ES256 verify
#                         holds one of sigil's 64 crypto lanes while it runs,
#                         and finding none free refuses the token: more than
#                         64 workers verifying at once turn good tokens away.
#                         Each worker keeps its own request arena, bounded by
#                         the largest message it has served.
# ================================================================

fn streamable_config_new(path, addr, port) {
    var c = alloc(96);
    store64(c, path);
    store64(c + 8, addr);
    store64(c + 16, port);
    store64(c + 24, 0);
    store64(c + 32, 0);
    store64(c + 40, 0);
    store64(c + 48, 5000);
    store64(c + 56, 0);
    store64(c + 64, 0);
    store64(c + 72, 0);
    store64(c + 80, 0);
    store64(c + 88, 0);
    return c;
}

fn streamable_config_with_workers(c, n) { store64(c + 88, n); return c; }
fn streamable_config_workers(c) { return load64(c + 88); }

fn streamable_config_with_resource_metadata(c, p) { store64(c + 80, p); return c; }
fn streamable_config_resource_metadata(c) { return load64(c + 80); }

fn streamable_config_with_allowed_origins(c, vec) { store64(c + 24, vec); return c; }
fn streamable_config_with_require_protocol(c, r)  { store64(c + 32, r);   return c; }
fn streamable_config_with_session_store(c, st)    { store64(c + 40, st);  return c; }
fn streamable_config_with_retry_ms(c, ms)         { store64(c + 48, ms);  return c; }
fn streamable_config_with_bearer_validator(c, fp, ctx) {
    store64(c + 64, fp);
    store64(c + 72, ctx);
    return c;
}

fn streamable_config_path(c)             { return load64(c); }
fn streamable_config_addr(c)             { return load64(c + 8); }
fn streamable_config_port(c)             { return load64(c + 16); }
fn streamable_config_allowed_origins(c)  { return load64(c + 24); }
fn streamable_config_require_protocol(c) { return load64(c + 32); }
fn streamable_config_session_store(c)    { return load64(c + 40); }
fn streamable_config_retry_ms(c)         { return load64(c + 48); }
fn streamable_config_dispatcher(c)       { return load64(c + 56); }
fn streamable_config_bearer_validator(c) { return load64(c + 64); }
fn streamable_config_bearer_ctx(c)       { return load64(c + 72); }

# ================================================================
# Per-process resumption buffer + event-id generator (one per server)
# ================================================================

var _strm_event_ids = 0;
var _strm_resumption = 0;

fn _strm_init() {
    if (_strm_event_ids == 0)  { _strm_event_ids  = event_id_gen_new(); }
    if (_strm_resumption == 0) { _strm_resumption = resumption_buffer_default(); }
    return 0;
}

# ================================================================
# Middleware (reuses transport_http patterns; same checks)
# ================================================================

fn _strm_check_origin(cfd, buf, blen, config) {
    var origin = sandhi_server_find_header_a(bote_req_alloc(), buf, blen, "Origin");
    if (bote_http_origin_ok(origin, streamable_config_allowed_origins(config), buf, blen) == 1) { return 0; }
    bote_http_refuse(cfd, SK_WARN, "streamable", HTTP_FORBIDDEN, "Forbidden", "origin");
    return HTTP_FORBIDDEN;
}

fn _strm_check_session(cfd, buf, blen, config, method) {
    var st = streamable_config_session_store(config);
    if (st == 0) { return 0; }
    var sid = sandhi_server_find_header_a(bote_req_alloc(), buf, blen, "MCP-Session-Id");
    if (sid == 0) {
        if (streq(method, "initialize") == 1) { return 0; }
        bote_http_refuse(cfd, SK_DEBUG, "streamable", HTTP_NOT_FOUND, "Not Found", "session_missing");
        return HTTP_NOT_FOUND;
    }
    if (session_store_validate(st, sid) == 0) {
        bote_http_refuse(cfd, SK_DEBUG, "streamable", HTTP_NOT_FOUND, "Not Found", "session_unknown");
        return HTTP_NOT_FOUND;
    }
    return 0;
}

fn _strm_peek_method(body) {
    var m = jsonx_get_str_a(bote_req_alloc(), body, "method");
    if (m == 0) { return ""; }
    return m;
}

# ================================================================
# POST handler — JSON-RPC dispatch (identical shape to transport_http)
# ================================================================

# Does the client's Accept header allow an SSE (text/event-stream) response?
# Absent Accept → treated as no (answer with application/json).
fn _strm_accepts_sse(buf, n) {
    var acc = sandhi_server_find_header_a(bote_req_alloc(), buf, n, "Accept");
    if (acc == 0) { return 0; }
    if (strstr(acc, "text/event-stream") >= 0) { return 1; }
    return 0;
}

# Resolve the requesting session's SessionOutbound bundle from MCP-Session-Id,
# or 0 (storeless / no header / unknown session).
fn _strm_post_session_outbound(buf, n, config) {
    var st = streamable_config_session_store(config);
    if (st == 0) { return 0; }
    var sid = sandhi_server_find_header_a(bote_req_alloc(), buf, n, "MCP-Session-Id");
    if (sid == 0) { return 0; }
    var session = session_store_validate(st, sid);
    if (session == 0) { return 0; }
    return _strm_session_outbound(session);
}

# Frame a JSON-RPC response as an id-less SSE `message` event. Id-less on
# purpose: a synthetic id would pollute the client's Last-Event-ID (see
# _strm_handle_get) — only the drained notifications carry resumable ids.
fn _strm_response_frame(resp) {
    var a = bote_req_alloc();
    var rb = str_builder_new_a(a);
    str_builder_add_cstr_a(a, rb, "event: message\ndata: ");
    str_builder_add_cstr_a(a, rb, resp);
    str_builder_add_cstr_a(a, rb, "\n\n");
    return str_data(str_builder_build_a(a, rb));
}

fn _strm_handle_post(cfd, buf, n, config) {
    var claims_slot[8]; store64(&claims_slot, 0);
    if (_strm_check_origin(cfd, buf, n, config) != 0) { return 0; }
    if (sandhi_server_find_header_a(bote_req_alloc(), buf, n, "Transfer-Encoding") != 0) {
        bote_http_refuse(cfd, SK_WARN, "streamable", HTTP_BAD_REQUEST, "Bad Request", "transfer_encoding"); return 0;
    }
    if (auth_bearer_check_c(cfd, buf, n,
        streamable_config_bearer_validator(config),
        streamable_config_bearer_ctx(config),
        &claims_slot, bote_prm_challenge(streamable_config_resource_metadata(config))) != 0) { return 0; }

    var bo = sandhi_server_body_offset(buf, n);
    if (bo < 0 || bo > n) {
        bote_http_refuse(cfd, SK_DEBUG, "streamable", HTTP_BAD_REQUEST, "Bad Request", "malformed_request");
        return 0;
    }
    if (bote_http_clen_bad(buf, n) == 1) {
        bote_http_refuse(cfd, SK_WARN, "streamable", HTTP_BAD_REQUEST, "Bad Request", "content_length");
        return 0;
    }
    var clen = sandhi_server_content_length(buf, n);
    if (clen > 61440) {
        bote_http_refuse(cfd, SK_WARN, "streamable", HTTP_PAYLOAD_TOO_LARGE, "Payload Too Large", "payload_too_large"); return 0;
    }
    if (clen <= 0) { clen = n - bo; }
    if (clen < 0) { clen = 0; }
    if (clen > n - bo) { clen = n - bo; }
    # In place: the request buffer is this handler's, and the headers read
    # below sit before the body.
    var body = buf + bo;
    store8(body + clen, 0);
    # A NUL would end the message early, and whatever follows it would go
    # unread by the syntax check.
    if (strlen(body) != clen) {
        bote_http_refuse(cfd, SK_WARN, "streamable", HTTP_BAD_REQUEST, "Bad Request", "nul_in_body");
        return 0;
    }

    var hc[40];
    var mreq[8];
    bote_http_ctx(&hc, cfd, "streamable", buf, n, 0);
    var era = bote_http_era(&hc, body, streamable_config_require_protocol(config), streamable_config_dispatcher(config), &mreq);
    if (era == BOTE_HTTP_REFUSED) { return 0; }
    if (bote_http_scope_gate(&hc, streamable_config_dispatcher(config), body, load64(&claims_slot),
        streamable_config_resource_metadata(config)) != 0) { return 0; }
    if (era == BOTE_HTTP_MODERN) {
        return bote_http_serve_modern(&hc, load64(&mreq), streamable_config_dispatcher(config), load64(&claims_slot));
    }

    var rpc_method = _strm_peek_method(body);
    if (_strm_check_session(cfd, buf, n, config, rpc_method) != 0) { return 0; }

    var extra = 0;
    var st = streamable_config_session_store(config);
    var resp = codec_process_message_a(bote_req_alloc(), body, streamable_config_dispatcher(config), load64(&claims_slot));

    # A session exists once `initialize` has succeeded. Minted before dispatch,
    # a request the codec refused still got one.
    if (st != 0 && streq(rpc_method, "initialize") == 1 && resp != 0 && jsonx_has(resp, "result") == 1) {
        var pv = jsonx_get_str(jsonx_get_raw_a(bote_req_alloc(), body, "params"), "protocolVersion");
        if (pv == 0) { pv = "2025-11-25"; }
        var sid = session_store_create(st, pv);
        if (sid == 0) {
            bote_http_refuse(cfd, SK_WARN, "streamable", HTTP_SERVICE_UNAVAILABLE, "Service Unavailable", "session_store_full");
            return 0;
        }
        var sb = str_builder_new_a(bote_req_alloc());
        str_builder_add_cstr(sb, "MCP-Session-Id: ");
        str_builder_add_cstr(sb, sid);
        str_builder_add_cstr(sb, "\r\n");
        extra = str_data(str_builder_build_a(bote_req_alloc(), sb));
    }
    if (resp == 0) { return bote_http_send_accepted(cfd, 0); }
    # Piggyback: when the client accepts SSE and its session has pending
    # notifications, answer with text/event-stream — the JSON-RPC response
    # (id-less frame) followed by the drained notifications — so a client that
    # never opens a GET stream still receives them. `initialize` can't have
    # pending events (its session was just created this request), so it always
    # takes the application/json path below.
    var pso = _strm_post_session_outbound(buf, n, config);
    var pend = 0;
    if (pso != 0 && _strm_accepts_sse(buf, n) == 1) {
        pend = _strm_drain_events_a(bote_req_alloc(), st, session_outbound_buffer(pso), 0);
    }
    if (pend != 0 && vec_len(pend) > 0) {
        sandhi_server_send_chunked_start_a(bote_req_alloc(), cfd, HTTP_OK, "text/event-stream", extra);
        var rframe = _strm_response_frame(resp);
        # A failed write means the peer stopped reading: drop it at once, as the
        # GET path does, or each event waits out its own send deadline while
        # every other client waits too.
        var pw = sandhi_server_send_chunk(cfd, rframe, strlen(rframe));
        var pi = 0;
        var pn = vec_len(pend);
        while (pi < pn && pw >= 0) {
            var w = stream_event_to_wire_a(bote_req_alloc(), vec_get(pend, pi));
            pw = sandhi_server_send_chunk(cfd, w, strlen(w));
            pi = pi + 1;
        }
        if (pw < 0) {
            bote_conn_log_send_drop("streamable", pw);
            return 0;
        }
        sandhi_server_send_chunked_end(cfd);
        return 0;
    }
    sandhi_server_send_response_a(bote_req_alloc(), cfd, HTTP_OK, "OK", "application/json",
      resp, strlen(resp), extra);
    return 0;
}

# ================================================================
# GET handler — open SSE stream
# ================================================================

# Send `retry: <ms>\n\n` over the chunked stream. Per SSE spec this hints
# the client at how long to wait before reconnecting.
fn _strm_send_retry(cfd, retry_ms) {
    var a = bote_req_alloc();
    var sb = str_builder_new_a(a);
    str_builder_add_cstr(sb, "retry: ");
    str_builder_add_int(sb, retry_ms);
    str_builder_add_cstr(sb, "\n\n");
    var s = str_data(str_builder_build_a(a, sb));
    sandhi_server_send_chunk(cfd, s, strlen(s));
    return 0;
}

# Select the events to drain for a GET: strictly after a non-empty
# Last-Event-ID cursor, else everything currently buffered (the "deliver on
# next GET" model). Pure — returns a vec of StreamEvent ptrs; the handler
# renders + sends them. Split out so the drain is unit-testable without a
# live socket. An empty Last-Event-ID is treated as absent (drain-all) rather
# than passed to events_after, which would return empty on the empty string.
fn _strm_drain_events(rbuf, last_id) {
    return _strm_drain_events_a(bote_req_alloc(), 0, rbuf, last_id);
}

# _strm_drain_events, copied onto `a` under the lock of the store `st` (0 for
# none), so what is sent is what the buffer held at one moment while another
# worker pushes to it (3.7.0).
fn _strm_drain_events_a(a, st, rbuf, last_id) {
    if (st != 0) { session_store_lock(st); }
    var out = 0;
    if (last_id != 0 && load8(last_id) != 0) {
        out = resumption_buffer_events_after_a(a, rbuf, last_id);
    } else {
        var ev = resumption_buffer_events(rbuf);
        out = vec_new_a(a);
        var i = 0;
        while (i < vec_len(ev)) {
            vec_push_a(a, out, vec_get(ev, i));
            i = i + 1;
        }
    }
    if (st != 0) { session_store_unlock(st); }
    return out;
}

fn _strm_handle_get(cfd, buf, n, config) {
    if (_strm_check_origin(cfd, buf, n, config) != 0) { return 0; }
    if (sandhi_server_find_header_a(bote_req_alloc(), buf, n, "Transfer-Encoding") != 0) {
        bote_http_refuse(cfd, SK_WARN, "streamable", HTTP_BAD_REQUEST, "Bad Request", "transfer_encoding"); return 0;
    }
    if (auth_bearer_check_c(cfd, buf, n,
        streamable_config_bearer_validator(config),
        streamable_config_bearer_ctx(config),
        0, bote_prm_challenge(streamable_config_resource_metadata(config))) != 0) { return 0; }
    var gv = sandhi_server_find_header_a(bote_req_alloc(), buf, n, "MCP-Protocol-Version");
    if (gv != 0 && _mcp_is_modern(gv) == 1) {
        bote_http_refuse_method(cfd, "streamable", "Allow: POST\r\n");
        return 0;
    }
    var hc[40];
    bote_http_ctx(&hc, cfd, "streamable", buf, n, 0);
    if (bote_http_check_version(&hc, gv, streamable_config_require_protocol(config), "") != 0) { return 0; }
    if (_strm_check_session(cfd, buf, n, config, "") != 0) { return 0; }

    # Resolve the drain source: the per-session outbound buffer when a
    # session store is configured and the client presented a valid
    # MCP-Session-Id, else the process-global buffer (back-compat for
    # storeless deployments — that buffer simply stays empty).
    var rbuf = _strm_resumption;
    var st = streamable_config_session_store(config);
    if (st != 0) {
        var sid = sandhi_server_find_header_a(bote_req_alloc(), buf, n, "MCP-Session-Id");
        if (sid != 0) {
            var session = session_store_validate(st, sid);
            if (session != 0) {
                rbuf = session_outbound_buffer(_strm_session_outbound(session));
            }
        }
    }

    # Open the SSE stream. 3.4.3: every write below is checked. Under the
    # send deadline (src/conn.cyr) a client that stopped reading fails a
    # write, and carrying on would make each later write wait out the full
    # deadline again, so the first failure ends the stream.
    var sse_r = sandhi_server_send_chunked_start_a(bote_req_alloc(), cfd, HTTP_OK, "text/event-stream", 0);
    if (sse_r < 0) { bote_conn_log_send_drop("streamable", sse_r); return 0; }

    # Primer — an SSE COMMENT (leading ':'), NOT an event. It confirms the
    # stream is up + flushes headers without carrying an `id:`, so per the SSE
    # spec it never becomes the client's Last-Event-ID. A synthetic primer id
    # would be fatal to resumption: it is in no buffer, so the client's next
    # events_after would miss and silently resume nothing.
    var primer = ": bote stream open\n\n";
    sse_r = sandhi_server_send_chunk(cfd, primer, strlen(primer));
    if (sse_r < 0) { bote_conn_log_send_drop("streamable", sse_r); return 0; }

    # Drain buffered notifications (unconditional when there is no cursor).
    var last_id = sandhi_server_find_header_a(bote_req_alloc(), buf, n, "Last-Event-ID");
    var drain = _strm_drain_events_a(bote_req_alloc(), st, rbuf, last_id);
    var di = 0;
    var dn = vec_len(drain);
    while (di < dn) {
        var ev = vec_get(drain, di);
        var wire = stream_event_to_wire_a(bote_req_alloc(), ev);
        sse_r = sandhi_server_send_chunk(cfd, wire, strlen(wire));
        if (sse_r < 0) { bote_conn_log_send_drop("streamable", sse_r); return 0; }
        di = di + 1;
    }

    # Retry hint + close. Real-time held-open push is a later (threaded)
    # phase; today the stream delivers the buffered drain and closes.
    _strm_send_retry(cfd, streamable_config_retry_ms(config));
    sandhi_server_send_chunked_end(cfd);
    return 0;
}

# ================================================================
# Top-level handler — dispatched by sandhi's serve loop
# ================================================================

fn _strm_handle(config, cfd, buf, n) {
    # 3.4.3: bound every write to this client, the SSE stream included
    # (src/conn.cyr).
    bote_conn_send_deadline(cfd);
    var a = bote_req_begin();
    if (bote_http_head_nul(buf, n) == 1) {
        bote_http_refuse(cfd, SK_WARN, "streamable", HTTP_BAD_REQUEST, "Bad Request", "nul_in_head");
        return 0;
    }
    var method = sandhi_server_get_method_a(a, buf, n);
    var path   = sandhi_server_get_path_a(a, buf, n);
    var hc[40];
    bote_http_ctx(&hc, cfd, "streamable", buf, n, 0);
    if (bote_prm_route(&hc, streamable_config_resource_metadata(config), method, path,
        streamable_config_allowed_origins(config)) == 1) { return 0; }

    # Path must match the configured endpoint (strip query first).
    if (streq(sandhi_server_path_only_a(bote_req_alloc(), path), streamable_config_path(config)) == 0) {
        bote_http_refuse(cfd, SK_DEBUG, "streamable", HTTP_NOT_FOUND, "Not Found", "path");
        return 0;
    }

    if (streq(method, "POST") == 1) { return _strm_handle_post(cfd, buf, n, config); }
    if (streq(method, "GET") == 1)  { return _strm_handle_get(cfd, buf, n, config); }

    bote_http_refuse_method(cfd, "streamable", "Allow: POST, GET\r\n");
    return 0;
}

# ================================================================
# Server entry
# ================================================================

fn transport_streamable_run(dispatcher, config) {
    _strm_init();
    store64(config + 56, dispatcher);
    var workers = streamable_config_workers(config);
    if (workers > 0) { bote_conn_serial_sinks(dispatcher); }
    return bote_conn_serve_pooled("streamable",
      streamable_config_addr(config),
      streamable_config_port(config),
      &_strm_handle,
      config,
      workers);
}

# --- transport_ws.cyr ---

# bote::transport::ws — MCP over WebSocket (RFC 6455)
#
# Built on stdlib lib/sandhi.cyr (HTTP routing; the 5.10.x fold of the
# old lib/http_server.cyr) and
# lib/ws_server.cyr (WS upgrade + frame I/O, 4.5.1+).
#
# ws_server is pulled out of [deps] stdlib auto-inject so other test
# files don't carry its weight — include it here directly. 2.7.2.
#
# COMPAT SHIM (cyrius 6.3.x): lib/ws_server.cyr still calls the pre-6.x
# name `http_find_header`, but the stdlib's http_* header helpers were
# renamed to sandhi_server_* and ws_server.cyr was missed in the sweep,
# so the symbol dangles undefined. sandhi_server_find_header has the
# identical (buf, blen, name) → allocated-cstr-or-0 contract, so forward
# to it. Must precede the ws_server include (cyrius is single-pass).
# Upstream fix needed: stdlib lib/ws_server.cyr should call
# sandhi_server_find_header directly (cyrius bug — the http_*→sandhi_*
# rename missed it). Remove this shim once that lands.
fn http_find_header(buf, blen, name): i64 {
    return sandhi_server_find_header_a(bote_req_alloc(), buf, blen, name);
}
include "lib/ws_server.cyr"

# Wire format: each WebSocket TEXT frame is one JSON-RPC 2.0 message.
# Control frames (ping/pong/close) are handled transparently by
# ws_server_recv; this file is just the MCP-specific wire-up.
#
# Middleware (origin / protocol-version) runs on the HTTP upgrade request
# — same checks as transport_http. Session binding is deferred until
# streaming dispatch lands (v1.6+); the WS socket itself is the session.

# ================================================================
# WsConfig (72 bytes — was 64 before 3.3.7):
#   +0  endpoint_path     cstr (e.g. "/mcp")
#   +8  bind_addr         i64 (network-order IPv4)
#   +16 port              i64
#   +24 allowed_origins   vec of cstrs or 0
#   +32 require_protocol  0/1
#   +40 dispatcher        Dispatcher ptr (set by transport_ws_run)
#   +48 bearer_validator  fn ptr (token, ctx) → claims | 0, or 0 to disable
#   +56 bearer_ctx        i64 ctx passed verbatim to validator
#   +64 idle_ms           frame-loop receive deadline, 0 = none (3.3.7)
#   +72 listen            a ListenLine for `subscriptions/listen` over each
#                         connection (3.7.3, src/listen.cyr), or 0
#
# Bearer auth applies on the upgrade HTTP request only, not per-frame —
# WS has a single Upgrade and the connection's identity is fixed at
# that point.
# ================================================================

fn ws_config_new(path, addr, port) {
    var c = alloc(80);
    store64(c, path);
    store64(c + 8, addr);
    store64(c + 16, port);
    store64(c + 24, 0);
    store64(c + 32, 0);
    store64(c + 40, 0);
    store64(c + 48, 0);
    store64(c + 56, 0);
    # +64 idle_ms — APPENDED at 3.3.7 (64 -> 72 bytes). Appended, never
    # inserted: every existing offset above is unchanged, so a reader of
    # this struct at the old offsets stays correct. That is the rule bote
    # codified after libro 2.8.11 PREPENDED a field to `struct error` and
    # silently broke every raw-offset read of it (see CHANGELOG 3.3.4).
    #
    # 0 = no receive deadline, and that is the DEFAULT — see
    # _bote_ws_handler for why an inherited HTTP-shaped deadline is wrong
    # for a long-lived frame loop.
    store64(c + 64, 0);
    store64(c + 72, 0);
    return c;
}

fn ws_config_with_allowed_origins(c, vec) { store64(c + 24, vec); return c; }
fn ws_config_with_require_protocol(c, r)  { store64(c + 32, r);   return c; }
fn ws_config_with_bearer_validator(c, fp, ctx) {
    store64(c + 48, fp);
    store64(c + 56, ctx);
    return c;
}

fn ws_config_path(c)             { return load64(c); }
fn ws_config_addr(c)             { return load64(c + 8); }
fn ws_config_port(c)             { return load64(c + 16); }
fn ws_config_allowed_origins(c)  { return load64(c + 24); }
fn ws_config_require_protocol(c) { return load64(c + 32); }
fn ws_config_dispatcher(c)       { return load64(c + 40); }
fn ws_config_bearer_validator(c) { return load64(c + 48); }
fn ws_config_bearer_ctx(c)       { return load64(c + 56); }

# Receive deadline for the established WebSocket frame loop, in
# milliseconds. 0 (the default) means no deadline.
#
# Set this only if you want idle connections reaped. It does NOT affect
# the HTTP upgrade handshake, which keeps sandhi's own slowloris guard —
# see _bote_ws_handler.
#
# ⚠ sandhi's server is single-threaded, so any connected peer occupies
# the server for as long as it is connected. A deadline here bounds how
# long an idle peer can do that; it does not make the server concurrent.
fn ws_config_with_idle_ms(c, ms)  { store64(c + 64, ms); return c; }
fn ws_config_idle_ms(c)           { return load64(c + 64); }
fn ws_config_with_listen(c, l)    { store64(c + 72, l); return c; }
fn ws_config_listen(c)            { return load64(c + 72); }

# ================================================================
# Middleware — same shape as transport_http, run pre-upgrade
# ================================================================

fn _ws_check_origin(cfd, buf, blen, config) {
    var origin = sandhi_server_find_header_a(bote_req_alloc(), buf, blen, "Origin");
    if (bote_http_origin_ok(origin, ws_config_allowed_origins(config), buf, blen) == 1) { return 0; }
    bote_http_refuse(cfd, SK_WARN, "ws", HTTP_FORBIDDEN, "Forbidden", "origin");
    return HTTP_FORBIDDEN;
}

fn _ws_check_protocol(cfd, buf, blen, config) {
    var v = sandhi_server_find_header_a(bote_req_alloc(), buf, blen, "MCP-Protocol-Version");
    if (v == 0) {
        if (ws_config_require_protocol(config) == 1) {
            bote_http_refuse(cfd, SK_DEBUG, "ws", HTTP_BAD_REQUEST, "Bad Request", "protocol_version_missing");
            return HTTP_BAD_REQUEST;
        }
        return 0;
    }
    if (bote_protocol_known(v) == 0) {
        bote_http_refuse(cfd, SK_DEBUG, "ws", HTTP_BAD_REQUEST, "Bad Request", "protocol_version");
        return HTTP_BAD_REQUEST;
    }
    return 0;
}

# One frame's bytes, the whole of what a frame may hold: this transport serves
# one connection at a time. ws_server_recv allocates the length a frame's header
# claims before any of its payload arrives, on a heap that never frees, so 14
# bytes from a peer cost 1 MiB, once per connection.
var _ws_frame_buf = 0;

# The headers ws_server_handshake reads, judged here first, on the arena: it copies each
# to the heap before it decides, so a long one would be kept for good, a refused upgrade's
# too. Its own rules, and a bound on `Connection`, the one it leaves free. What it keeps
# per upgrade is then about 1.6 KB, which only the stdlib can give back.
var BOTE_WS_CONNECTION_MAX = 256;

# 1 when `c` is a byte of the base64 alphabet, RFC 4648 4.
fn _ws_b64_char(c) {
    if (c >= 65 && c <= 90) { return 1; }
    if (c >= 97 && c <= 122) { return 1; }
    if (c >= 48 && c <= 57) { return 1; }
    if (c == 43 || c == 47) { return 1; }
    return 0;
}

# 1 when `key` is the base64 of 16 bytes, RFC 6455 4.1: 22 of the alphabet and `==`.
fn _ws_key_ok(key) {
    if (strlen(key) != 24) { return 0; }
    var i = 0;
    while (i < 22) {
        if (_ws_b64_char(load8(key + i)) == 0) { return 0; }
        i = i + 1;
    }
    if (load8(key + 22) != 61 || load8(key + 23) != 61) { return 0; }
    return 1;
}

# The head holds no NUL by now (bote_http_head_nul), so each value read here is the
# whole of the line the handshake will copy.
fn _ws_upgrade_ok(buf, n) {
    var a = bote_req_alloc();
    var up = sandhi_server_find_header_a(a, buf, n, "Upgrade");
    var cn = sandhi_server_find_header_a(a, buf, n, "Connection");
    var ver = sandhi_server_find_header_a(a, buf, n, "Sec-WebSocket-Version");
    var key = sandhi_server_find_header_a(a, buf, n, "Sec-WebSocket-Key");
    if (up == 0 || cn == 0 || ver == 0 || key == 0) { return 0; }
    if (streq(up, "websocket") == 0 && streq(up, "WebSocket") == 0) { return 0; }
    if (streq(ver, "13") == 0 || _ws_key_ok(key) == 0) { return 0; }
    if (strlen(cn) > BOTE_WS_CONNECTION_MAX) { return 0; }
    return 1;
}

# The token a connection presented, for its frames, and how long one may be. One
# connection at a time is served, so one buffer serves them all, and a connection that
# ends leaves nothing on the heap. A handler is handed a copy (bote_req_claims_kept), one
# per connection.
var BOTE_WS_TOKEN_MAX = 65536;
var _ws_token_buf = 0;

# How often a connection's token is judged again, in milliseconds, by the validator that
# took it: a frame that arrives this long after the last judgement is held until the token
# passes again. A token that has expired, or whose key is gone, then ends the connection
# with 1008 (RFC 6455 7.4.1, policy violation), within this long of it. 0 judges every
# frame. A verified token is remembered (src/jwt.cyr), so a judgement costs a hash and a
# lookup, and this bounds what a connection can make the server spend on it.
var BOTE_WS_RECHECK_MS = 1000;

# A close frame with 1008 and its reason, from the stack: ws_server_send_close puts its
# payload on the heap.
fn _ws_send_close_policy(ws) {
    var cl[32];
    var reason = "token no longer valid";
    var rl = strlen(reason);
    store8(&cl, 1008 >> 8);
    store8(&cl + 1, 1008 & 255);
    memcpy(&cl + 2, reason, rl);
    return ws_server_send_frame(ws, WS_OP_CLOSE, &cl, 2 + rl);
}

# 1 when it is time to judge the token again: `last` is when it was last judged, by
# clock_now_ms, and a clock that went back counts as time.
fn _ws_recheck_due(now, last) {
    if (now < last) { return 1; }
    if (now - last >= BOTE_WS_RECHECK_MS) { return 1; }
    return 0;
}

# The next data frame as a cstr, in _ws_frame_buf, valid until the next call.
# 0 when the peer closed, a frame broke a bound, or the socket failed, and BOTE_WS_CONTROL
# once a ping or a pong is answered (3.7.4): the frame loop then waits on its listen line
# again, where through 3.7.3 it read on, and a client that pinged heard no change until it
# sent a request.
var BOTE_WS_CONTROL = 1;

fn _bote_ws_recv(ws) {
    if (_ws_frame_buf == 0) { _ws_frame_buf = alloc(WS_MAX_PAYLOAD + 1); }
    var op_slot[8];
    while (1 == 1) {
        var n = ws_server_recv_frame(ws, _ws_frame_buf, WS_MAX_PAYLOAD, &op_slot);
        if (n < 0) { return 0; }
        var op = load64(&op_slot);
        if (op == WS_OP_CLOSE) {
            ws_server_send_close(ws, 1000, "");
            return 0;
        }
        if (op >= 8) {
            if (n > 125) { return 0; }
            if (op == WS_OP_PING) { ws_server_send_pong(ws, _ws_frame_buf, n); }
            return BOTE_WS_CONTROL;
        } elif (op == WS_OP_TEXT || op == WS_OP_BINARY || op == WS_OP_CONTINUATION) {
            store8(_ws_frame_buf + n, 0);
            return _ws_frame_buf;
        }
    }
    return 0;
}

# The listen line's writer: one message, one text frame. A frame not sent whole leaves the
# stream out of step, so the caller drops the connection.
fn _ws_listen_write(ws, json) {
    var sr = ws_server_send_text(ws, json);
    if (sr < 0) {
        bote_conn_log_send_drop("ws", sr);
        return sr;
    }
    return 0;
}

# The presented token judged again when it is due (3.6.6), before a frame is served or a
# change goes out: 1 while it holds, 0 once it has failed and the connection is closed with
# 1008. *judged is when it was last judged.
fn _ws_token_holds(config, ws, held, judged) {
    if (held == 0) { return 1; }
    var now = clock_now_ms();
    if (_ws_recheck_due(now, load64(judged)) == 0) { return 1; }
    if (fncall2(ws_config_bearer_validator(config), held, ws_config_bearer_ctx(config)) == 0) {
        bote_log_warn("ws token no longer valid; connection closed");
        _ws_send_close_policy(ws);
        return 0;
    }
    store64(judged, now);
    return 1;
}

# ================================================================
# Upgrade handler — invoked per connection by sandhi's serve loop
# ================================================================

fn _bote_ws_handler(config, cfd, buf, n) {
    # 3.4.3: bound every write to this client, the handshake reply and every
    # frame after it (src/conn.cyr). A WebSocket peer that floods requests
    # and never reads the replies used to park the server in write(2) for
    # good, and with it every other client of this single-threaded loop.
    bote_conn_send_deadline(cfd);
    var a = bote_req_begin();
    if (bote_http_head_nul(buf, n) == 1) {
        bote_http_refuse(cfd, SK_WARN, "ws", HTTP_BAD_REQUEST, "Bad Request", "nul_in_head");
        return 0;
    }
    var method = sandhi_server_get_method_a(a, buf, n);
    var path   = sandhi_server_get_path_a(a, buf, n);

    # Only GET on the configured endpoint is valid for a WS upgrade.
    if (streq(method, "GET") == 0) {
        bote_http_refuse_method(cfd, "ws", "Allow: GET\r\n");
        return 0;
    }
    if (streq(sandhi_server_path_only_a(bote_req_alloc(), path), ws_config_path(config)) == 0) {
        bote_http_refuse(cfd, SK_DEBUG, "ws", HTTP_NOT_FOUND, "Not Found", "path");
        return 0;
    }

    if (_ws_check_origin(cfd, buf, n, config) != 0) { return 0; }
    if (sandhi_server_find_header_a(bote_req_alloc(), buf, n, "Transfer-Encoding") != 0) {
        bote_http_refuse(cfd, SK_WARN, "ws", HTTP_BAD_REQUEST, "Bad Request", "transfer_encoding"); return 0;
    }
    var claims_slot[8]; store64(&claims_slot, 0);
    if (auth_bearer_check_c(cfd, buf, n,
        ws_config_bearer_validator(config),
        ws_config_bearer_ctx(config),
        &claims_slot, 0) != 0) { return 0; }
    if (_ws_check_protocol(cfd, buf, n, config) != 0) { return 0; }
    if (_ws_upgrade_ok(buf, n) == 0) {
        bote_http_refuse(cfd, SK_DEBUG, "ws", HTTP_BAD_REQUEST, "Bad Request", "ws_handshake");
        return 0;
    }
    # Past every refusal but the handshake's: the token moves off the arena, which each
    # frame rewinds, to be judged again while the connection lasts. When the validator's
    # claims are the token, they are that copy too.
    var ws_claims = load64(&claims_slot);
    var ws_token = 0;
    var ws_fp = ws_config_bearer_validator(config);
    var ws_held = 0;
    if (ws_fp != 0) {
        var presented = auth_bearer_extract(buf, n);
        var tl = strlen(presented);
        if (tl >= BOTE_WS_TOKEN_MAX) {
            bote_http_refuse(cfd, SK_WARN, "ws", HTTP_BAD_REQUEST, "Bad Request", "token_size");
            return 0;
        }
        if (_ws_token_buf == 0) { _ws_token_buf = alloc(BOTE_WS_TOKEN_MAX); }
        memcpy(_ws_token_buf, presented, tl + 1);
        ws_held = _ws_token_buf;
        if (ws_claims != 0 && ws_claims == bote_req_token()) {
            ws_claims = _ws_token_buf;
            ws_token = 1;
        }
    }

    var ws = ws_server_handshake(cfd, buf, n);
    if (ws == 0) {
        bote_http_refuse(cfd, SK_DEBUG, "ws", HTTP_BAD_REQUEST, "Bad Request", "ws_handshake");
        return 0;
    }

    # ⚠ 3.3.7 — REPLACE the inherited receive deadline before entering the
    # frame loop. This is a bug fix, not a tuning knob.
    #
    # bote does not own this accept loop: sandhi's serve loop sets
    # SO_RCVTIMEO on every accepted connection as a slowloris guard, with a
    # 30 s default (SANDHI_SERVER_DEFAULT_IDLE_MS). That is exactly right
    # for HTTP, where a request is expected promptly — and measured working:
    # an unterminated POST to the HTTP transport is dropped at 30.3 s.
    #
    # It is wrong once the connection has been upgraded. A WebSocket is
    # long-lived and legitimately idle between messages, but the deadline
    # follows `cfd` into the frame loop, where `ws_server_recv_frame` maps
    # ANY sock_recv error — EAGAIN from this timeout included — to -1, and
    # `ws_server_recv` turns that into "peer closed". bote only answers
    # PINGs, it never initiates one, so nothing keeps the socket warm.
    # Result before this fix: a healthy but quiet client was silently
    # dropped after 30 s, with no close frame.
    #
    # Reproduced end to end, not inferred: 3 s idle survives, 33 s gets EOF.
    # ⚠ The first probe that "disproved" this was itself broken — it drained
    # only 4 bytes of the pre-idle response, so its post-idle read returned
    # STALE BUFFERED BYTES and looked alive. Any regression test here must
    # drain the socket fully before idling, or it will pass while broken.
    #
    # Default is 0 = no deadline, which is what a WebSocket wants. An
    # operator who does want idle peers reaped sets ws_config_with_idle_ms.
    var idle_ms = ws_config_idle_ms(config);
    var idle_s = idle_ms / 1000;
    sock_set_recv_timeout(cfd, idle_s, (idle_ms - idle_s * 1000) * 1000);

    # ws_server_send_frame writes the header and the payload separately, so
    # without this every reply waits on the peer's delayed ACK: about 40 ms.
    sock_set_nodelay(cfd, 1);

    var lc = ws_config_listen(config);
    bote_listen_line_attach(lc, ws_config_dispatcher(config), &_ws_listen_write, ws);
    var r = _ws_frames(config, ws, cfd, ws_claims, ws_token, ws_held);
    bote_listen_line_detach(lc);
    return r;
}

# Each frame is one JSON-RPC message. Loop until peer closes or the socket errors out
# (_bote_ws_recv returns 0). The first frame to hand a handler the token makes its one heap
# copy, and every later frame hands over that one. With a listen line, the loop waits on the
# socket and the line at once, and writes a change while the client is quiet (3.7.3); the
# idle deadline still counts from the client's last frame.
fn _ws_frames(config, ws, cfd, ws_claims, ws_token, ws_held) {
    var lc = ws_config_listen(config);
    var idle_ms = ws_config_idle_ms(config);
    var ws_kept = 0;
    var judged[8];
    store64(&judged, clock_now_ms());
    var heard = clock_now_ms();
    var mark[16];
    while (1 == 1) {
        if (lc != 0) {
            var deadline = 0;
            if (idle_ms > 0) { deadline = heard + idle_ms; }
            var w = bote_listen_line_wait(lc, cfd, deadline);
            while (w == 2) {
                # Between messages nothing rewinds the arena, so what judging the token puts
                # there goes with the judgement (3.7.4): a quiet client with its cache off
                # grew it 87 bytes a change.
                bote_req_mark(&mark);
                var holds = _ws_token_holds(config, ws, ws_held, &judged);
                bote_req_release(&mark);
                if (holds == 0) { return 0; }
                if (bote_listen_line_deliver(lc) < 0) { return 0; }
                w = bote_listen_line_wait(lc, cfd, deadline);
            }
            if (w == 0) {
                var il[BOTE_LOG_LINE_BYTES];
                bote_log_line(&il, SK_DEBUG, "ws client idle; closed");
                bote_log_int(&il, "idle_ms", idle_ms);
                bote_log_emit(&il);
                return 0;
            }
        }
        var a = bote_listen_line_begin(lc);
        if (ws_token == 1) { bote_req_note_token_kept(ws_claims, ws_kept); }
        var msg = _bote_ws_recv(ws);
        if (msg == 0) { return 0; }
        heard = clock_now_ms();
        if (msg == BOTE_WS_CONTROL) { continue; }
        if (_ws_token_holds(config, ws, ws_held, &judged) == 0) { return 0; }
        var resp = codec_process_message_a(a, msg, ws_config_dispatcher(config), ws_claims);
        if (ws_token == 1) { ws_kept = bote_req_kept(); }
        if (bote_listen_line_broken(lc) == 1) { return 0; }
        if (resp != 0) {
            # 3.4.3: a failed frame write (the send deadline firing, or the
            # peer gone) leaves the stream desynchronised mid-frame, so the
            # connection is dropped rather than read from again.
            var sr = ws_server_send_text(ws, resp);
            if (sr < 0) {
                bote_conn_log_send_drop("ws", sr);
                return 0;
            }
        }
    }
    return 0;
}

# ================================================================
# Server entry — defers to bote_conn_serve
# ================================================================

fn transport_ws_run(dispatcher, config) {
    store64(config + 40, dispatcher);
    return bote_conn_serve("ws",
      ws_config_addr(config),
      ws_config_port(config),
      &_bote_ws_handler,
      config);
}

# --- content.cyr ---

# bote::content — typed MCP content blocks (spec 2025-11-25).
#
# A tool handler that wants to return anything richer than a plain text
# result builds one or more blocks with the constructors below, collects
# them into a vec, and returns `content_array(blocks)` or
# `content_array_error(blocks)`. `src/bridge.cyr`'s `wrap_tool_result`
# is already a pass-through when a result has a top-level `content`
# array, so handlers can opt into blocks without any transport changes.
#
# Five block types per MCP:
#   text           {"type":"text","text":"..."}
#   image          {"type":"image","data":"<b64>","mimeType":"..."}
#   audio          {"type":"audio","data":"<b64>","mimeType":"..."}
#   resource       {"type":"resource","resource":{"uri":"...","mimeType":"...","text":"..."}}
#                  (embedded — the resource's text body travels in the envelope)
#   resource_link  {"type":"resource_link","uri":"...","name":"...","mimeType":"..."}
#                  (reference — the client fetches by URI)
#
# Convention: every constructor returns an alloc'd cstr. Every string
# argument is a cstr; `_json_emit_escaped` handles JSON quoting at the
# boundary (dispatched from src/dispatch.cyr). mimeType strings are
# passed through unchecked — the handler is responsible for RFC 6838
# compliance.

# ================================================================
# Text block
# ================================================================

fn content_text(text) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"type\":\"text\",\"text\":\"");
    if (text != 0) { _json_emit_escaped(sb, text); }
    str_builder_add_cstr(sb, "\"}");
    return str_data(str_builder_build(sb));
}

# ================================================================
# Binary blocks (image, audio) — both take base64-encoded data +
# a mimeType. The constructors are structurally identical; factored
# through a private helper to keep the two spec variants obvious.
# ================================================================

fn _content_binary(kind, b64_data, mime) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"type\":\"");
    str_builder_add_cstr(sb, kind);
    str_builder_add_cstr(sb, "\",\"data\":\"");
    if (b64_data != 0) { _json_emit_escaped(sb, b64_data); }
    str_builder_add_cstr(sb, "\",\"mimeType\":\"");
    if (mime != 0) { _json_emit_escaped(sb, mime); }
    str_builder_add_cstr(sb, "\"}");
    return str_data(str_builder_build(sb));
}

fn content_image(b64_data, mime) { return _content_binary("image", b64_data, mime); }
fn content_audio(b64_data, mime) { return _content_binary("audio", b64_data, mime); }

# ================================================================
# Resource block — embedded resource contents travel in the envelope.
# Any of text / mime / uri may be 0 (omitted from the emitted object).
# Per MCP spec, `uri` is required and `text` is required for text
# resources; handlers should supply both. Binary resources use a
# different shape (blob) — add a constructor variant when needed.
# ================================================================

fn content_resource(uri, mime, text) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"type\":\"resource\",\"resource\":{\"uri\":\"");
    if (uri != 0) { _json_emit_escaped(sb, uri); }
    str_builder_add_cstr(sb, "\"");
    if (mime != 0) {
        str_builder_add_cstr(sb, ",\"mimeType\":\"");
        _json_emit_escaped(sb, mime);
        str_builder_add_cstr(sb, "\"");
    }
    if (text != 0) {
        str_builder_add_cstr(sb, ",\"text\":\"");
        _json_emit_escaped(sb, text);
        str_builder_add_cstr(sb, "\"");
    }
    str_builder_add_cstr(sb, "}}");
    return str_data(str_builder_build(sb));
}

# ================================================================
# Resource link — reference only; client fetches the URI itself.
# ================================================================

fn content_resource_link(uri, name, mime) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"type\":\"resource_link\",\"uri\":\"");
    if (uri != 0) { _json_emit_escaped(sb, uri); }
    str_builder_add_cstr(sb, "\"");
    if (name != 0) {
        str_builder_add_cstr(sb, ",\"name\":\"");
        _json_emit_escaped(sb, name);
        str_builder_add_cstr(sb, "\"");
    }
    if (mime != 0) {
        str_builder_add_cstr(sb, ",\"mimeType\":\"");
        _json_emit_escaped(sb, mime);
        str_builder_add_cstr(sb, "\"");
    }
    str_builder_add_cstr(sb, "}");
    return str_data(str_builder_build(sb));
}

# ================================================================
# Envelopes — collect blocks into a tool-result response.
# Each block in `blocks` is an already-built cstr (one of the
# constructors above, or any caller-supplied object).
# ================================================================

fn _content_blocks_array(sb, blocks) {
    str_builder_add_cstr(sb, "[");
    var n = vec_len(blocks);
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, vec_get(blocks, i));
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]");
    return 0;
}

# {"content":[...]}
fn content_array(blocks) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"content\":");
    _content_blocks_array(sb, blocks);
    str_builder_add_cstr(sb, "}");
    return str_data(str_builder_build(sb));
}

# {"content":[...],"isError":true} — marks a failed tool execution that
# still wants to return content (MCP spec: errors may carry explanation
# content, distinguished from protocol errors by the isError flag).
fn content_array_error(blocks) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"content\":");
    _content_blocks_array(sb, blocks);
    str_builder_add_cstr(sb, ",\"isError\":true}");
    return str_data(str_builder_build(sb));
}

# Single-block shorthand: wrap one already-built block cstr.
fn content_single(block) {
    var v = vec_new();
    vec_push(v, block);
    return content_array(v);
}

# Convenience: a plain text response (equivalent to
# content_single(content_text(s)), saves a vec alloc for the common case).
fn content_text_response(text) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"content\":[{\"type\":\"text\",\"text\":\"");
    if (text != 0) { _json_emit_escaped(sb, text); }
    str_builder_add_cstr(sb, "\"}]}");
    return str_data(str_builder_build(sb));
}

# The failed-execution twin of content_text_response:
# {"content":[{"type":"text","text":"..."}],"isError":true}. The dispatcher
# answers input-validation failures with it (MCP 2025-11-25, SEP-1303), and
# a handler may return it for its own failures.
fn content_text_error_response(text) {
    return _dsp_tool_error_result(text);
}

# ================================================================
# Binary resource (blob) variant of content_resource. The MCP spec
# distinguishes text resources (carry a `text` field) from binary
# resources (carry a `blob` field with base64-encoded data). Use this
# constructor when the resource body isn't UTF-8.
# ================================================================

fn content_resource_blob(uri, mime, b64_data) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"type\":\"resource\",\"resource\":{\"uri\":\"");
    if (uri != 0) { _json_emit_escaped(sb, uri); }
    str_builder_add_cstr(sb, "\"");
    if (mime != 0) {
        str_builder_add_cstr(sb, ",\"mimeType\":\"");
        _json_emit_escaped(sb, mime);
        str_builder_add_cstr(sb, "\"");
    }
    if (b64_data != 0) {
        str_builder_add_cstr(sb, ",\"blob\":\"");
        _json_emit_escaped(sb, b64_data);
        str_builder_add_cstr(sb, "\"");
    }
    str_builder_add_cstr(sb, "}}");
    return str_data(str_builder_build(sb));
}

# Annotations (MCP spec optional metadata): take a pre-built block cstr
# and splice an `annotations` field in before the closing `}`. Either
# arg may be null/empty/-1; if both are absent the input is returned
# unchanged. Caller responsible for valid block input (any of the
# constructors above produces well-formed JSON).
fn content_with_annotations(block, audience, priority) {
    if (block == 0) { return block; }
    var has_a = 0;
    if (audience != 0) { if (vec_len(audience) > 0) { has_a = 1; } }
    var has_p = 0;
    if (priority >= 0) { has_p = 1; }
    if (has_a == 0 && has_p == 0) { return block; }
    var bn = strlen(block);
    if (bn < 2) { return block; }
    if (load8(block + bn - 1) != 125) { return block; }   # '}'
    var sb = str_builder_new();
    # copy block minus trailing '}' as a single buffer
    var pre = alloc(bn);
    memcpy(pre, block, bn - 1);
    store8(pre + bn - 1, 0);
    str_builder_add_cstr(sb, pre);
    str_builder_add_cstr(sb, ",\"annotations\":{");
    if (has_a == 1) {
        str_builder_add_cstr(sb, "\"audience\":[");
        var an = vec_len(audience);
        var ai = 0;
        while (ai < an) {
            if (ai > 0) { str_builder_add_cstr(sb, ","); }
            str_builder_add_cstr(sb, "\"");
            _json_emit_escaped(sb, vec_get(audience, ai));
            str_builder_add_cstr(sb, "\"");
            ai = ai + 1;
        }
        str_builder_add_cstr(sb, "]");
    }
    if (has_p == 1) {
        if (has_a == 1) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "\"priority\":");
        str_builder_add_int(sb, priority);
    }
    str_builder_add_cstr(sb, "}}");
    return str_data(str_builder_build(sb));
}

# --- sandbox.cyr ---

# bote::sandbox — pluggable sandbox runner for tool handlers.
#
# Same fn-pointer + ctx adapter pattern as AuditSink (src/audit.cyr) and
# EventSink (src/events.cyr). Bote ships the abstract surface and a noop
# adapter; consumers wire their backend (kavach — multi-backend sandboxing
# — is the canonical choice in the AGNOS ecosystem; CLAUDE.md's stack table
# tracks the version it is checked against, and kavach is NOT a declared
# dep, so nothing here pins it) by providing a fn pointer that satisfies
# the SandboxRunner shape:
#
#   fn run(ctx, command_cstr, timeout_ms) → result_cstr (JSON)
#
# Result is a JSON cstr the handler can return verbatim or post-process.
# Suggested shape (matches kavach's ExecResult):
#   {"exit_code":N,"stdout":"...","stderr":"...","duration_ms":N,"timed_out":0|1}
#
# ⚠ kavach's own `sandbox_exec(sandbox, command)` is 2-arg and has no
# timeout, so an adapter bridging to it drops `timeout_ms` — bote's shape
# is the superset on purpose, since a backend that CAN bound execution
# should not have to invent a channel to be told the bound.
#
# In `dist/bote.cyr`; deliberately not in `dist/bote-core.cyr` —
# DEPS-PATTERN.md carries the reasoning.
#
# Tool handlers that don't use the sandbox are unaffected — the dispatcher
# doesn't know about this module. Tool handlers that DO use it just call
# `sandbox_run(s, command, timeout)` from inside their handler body.

# ================================================================
# SandboxRunner (16 bytes):
#   +0  run_fp   fn ptr (ctx, command_cstr, timeout_ms) → result_cstr
#   +8  ctx      i64 (passed verbatim to run_fp; backend's state)
# ================================================================

fn sandbox_runner_new(run_fp, ctx) {
    var s = alloc(16);
    store64(s, run_fp);
    store64(s + 8, ctx);
    return s;
}

fn sandbox_runner_fp(s)  { return load64(s); }
fn sandbox_runner_ctx(s) { return load64(s + 8); }

# Invoke the runner. `command` is an opaque cstr the backend interprets
# (a shell command line, an argv vec, a JSON spec — backend's choice).
# `timeout_ms` is a hint; the backend may clamp to its own ceiling.
# Returns the runner's JSON result. If the runner is null, returns an
# error envelope (so handlers don't have to null-check).
fn sandbox_run(s, command, timeout_ms) {
    if (s == 0) { return "{\"exit_code\":-1,\"stderr\":\"no sandbox configured\"}"; }
    var fp = sandbox_runner_fp(s);
    if (fp == 0) { return "{\"exit_code\":-1,\"stderr\":\"no sandbox configured\"}"; }
    return fncall3(fp, sandbox_runner_ctx(s), command, timeout_ms);
}

# Built-in noop runner — for testing and for environments where
# sandboxing isn't required (echoes the command back as stdout, exit 0).
# Drop-in replacement when you want sandbox API surface but no isolation.
fn sandbox_runner_noop(ctx, command, timeout_ms) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"exit_code\":0,\"stdout\":\"");
    if (command != 0) { _json_emit_escaped(sb, command); }
    str_builder_add_cstr(sb, "\",\"stderr\":\"\",\"duration_ms\":0,\"timed_out\":0}");
    return str_data(str_builder_build(sb));
}

# Convenience: a SandboxRunner backed by the noop adapter. Useful for
# handler unit tests that need a non-null sandbox without spinning up
# a real backend.
fn sandbox_runner_noop_new() {
    return sandbox_runner_new(&sandbox_runner_noop, 0);
}

# --- host.cyr ---

# bote::host — HostRegistry + SSRF guard.
#
# Second slice of the roadmap `host` module (content blocks landed in
# 1.7.0). Registry holds named external hosts bote is allowed to route
# requests to (e.g. for `resource_link` fetches or tool-to-tool proxy);
# SSRF guard rejects URLs targeting loopback / link-local / private /
# cloud-metadata endpoints before any network call.
#
# Wire shapes:
#
#   HostEntry (32 bytes):
#     +0  name          cstr   logical identifier
#     +8  url           cstr   base URL (http:// or https://)
#     +16 headers       vec of cstrs (alternating key/value) or 0
#     +24 capabilities  vec of cstrs (e.g. "fetch", "tools/call") or 0
#
#   HostRegistry (16 bytes):
#     +0  entries       hashmap: name cstr → HostEntry ptr
#     +8  count         i64 (cached vec_len of map_keys — O(1) lookup)

# ================================================================
# HostEntry
# ================================================================

fn host_entry_new(name, url) {
    var e = alloc(32);
    store64(e, name);
    store64(e + 8, url);
    store64(e + 16, 0);
    store64(e + 24, 0);
    return e;
}

fn host_entry_with_headers(e, headers) { store64(e + 16, headers); return e; }
fn host_entry_with_capabilities(e, caps) { store64(e + 24, caps); return e; }

fn host_entry_name(e)         { return load64(e); }
fn host_entry_url(e)          { return load64(e + 8); }
fn host_entry_headers(e)      { return load64(e + 16); }
fn host_entry_capabilities(e) { return load64(e + 24); }

# Capability check: returns 1 if caps is null (no restriction) or if
# `cap` is present in the vec; 0 if the vec exists and doesn't contain it.
fn host_entry_allows(e, cap) {
    var caps = host_entry_capabilities(e);
    if (caps == 0) { return 1; }
    var n = vec_len(caps);
    var i = 0;
    while (i < n) {
        if (streq(vec_get(caps, i), cap) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# ================================================================
# HostRegistry
# ================================================================

fn host_registry_new() {
    var r = alloc(16);
    store64(r, map_new());
    store64(r + 8, 0);
    return r;
}

fn host_registry_entries(r) { return load64(r); }
fn host_registry_count(r)   { return load64(r + 8); }

# Insert / replace. Bumps count only on fresh insert (replacement
# keeps the count stable so callers can trust it as a O(1) size hint).
fn host_registry_add(r, entry) {
    var name = host_entry_name(entry);
    var m = host_registry_entries(r);
    if (map_has(m, name) == 0) {
        store64(r + 8, host_registry_count(r) + 1);
    }
    map_set(m, name, entry);
    return 0;
}

fn host_registry_has(r, name) { return map_has(host_registry_entries(r), name); }
fn host_registry_get(r, name) { return map_get(host_registry_entries(r), name); }

fn host_registry_names(r) { return map_keys(host_registry_entries(r)); }

# Empty the registry in-place. Existing references to the registry
# pointer stay valid; the underlying entries map is replaced fresh
# (the old map becomes unreferenced and is left to the bump allocator
# — bote has no general-purpose free, and config reload is a rare
# operation; the leak is bounded by reload frequency × config size).
# Used by host_registry_reload before repopulating.
fn host_registry_clear(r) {
    store64(r, map_new());
    store64(r + 8, 0);
    return 0;
}

# ================================================================
# Hot-reload — JSON config format
# ================================================================
#
# 2.7.1. The wire format is a JSON array of host-entry objects:
#
#   [
#     {"name":"upstream-1","url":"https://api.example.com"},
#     {"name":"upstream-2","url":"https://other.example.com",
#      "capabilities":["fetch","tools/call"]}
#   ]
#
# Required fields: `name`, `url`. Optional: `capabilities` (array of
# cstrs; absent = no restriction, matching the in-memory semantics).
# `headers` parsing is deferred — header values may carry secrets
# and need a careful redaction/audit story before they can come
# through file config. Use the in-memory `host_entry_with_headers`
# setter for now if headers are needed.
#
# Limitations: the jsonx surface used to parse is whitespace-strict
# inside structured values (matches the rest of bote's JSON
# handling). Configs emitted by `jq -c` or a one-key-per-line
# pretty-printer both work; arbitrary indentation may not.

# Buffer size for `host_registry_load_from_file`. 64 KB is well
# above any plausible host-registry config (each entry is < 500 B
# typical). Files larger than this are truncated at read time and
# the parse will fail at the truncation boundary.
var HOST_CONFIG_BUF_MAX = 65536;

# Parse a single host-entry JSON object (cstr containing `{...}`)
# into a HostEntry. Returns 0 if the object is missing `name` or
# `url`, or if `capabilities` is present but malformed.
fn host_entry_from_json(obj_cstr) {
    if (obj_cstr == 0) { return 0; }
    if (jsonx_is_object(obj_cstr) == 0) { return 0; }
    var name = jsonx_get_str(obj_cstr, "name");
    var url  = jsonx_get_str(obj_cstr, "url");
    if (name == 0 || url == 0) { return 0; }
    var e = host_entry_new(name, url);
    if (jsonx_has(obj_cstr, "capabilities") == 1) {
        var caps_raw = jsonx_get_raw(obj_cstr, "capabilities");
        if (caps_raw == 0) { return 0; }
        var caps = _host_parse_str_array(caps_raw);
        if (caps == 0) { return 0; }
        host_entry_with_capabilities(e, caps);
    }
    return e;
}

# Walk a JSON array of strings and return a vec of cstrs. Each
# element is decoded into its own freshly-allocated cstr (no
# quotes). Returns 0 if the input is not an array or any element
# is not a string. Used by host_entry_from_json.
fn _host_parse_str_array(arr_cstr) {
    if (arr_cstr == 0) { return 0; }
    var len = strlen(arr_cstr);
    var i = _jx_skip_ws(arr_cstr, len, 0);
    if (i >= len || load8(arr_cstr + i) != 91) { return 0; }
    i = _jx_skip_ws(arr_cstr, len, i + 1);
    var out = vec_new();
    while (i < len) {
        var c = load8(arr_cstr + i);
        if (c == 93) { return out; }
        if (c != 34) { return 0; }
        var end = _jx_skip_string(arr_cstr, len, i);
        var inner = end - i - 2;
        if (inner < 0) { inner = 0; }
        var s = alloc(inner + 1);
        memcpy(s, arr_cstr + i + 1, inner);
        store8(s + inner, 0);
        vec_push(out, s);
        i = _jx_skip_ws(arr_cstr, len, end);
        if (i < len && load8(arr_cstr + i) == 44) {
            i = _jx_skip_ws(arr_cstr, len, i + 1);
        }
    }
    return 0;
}

# Parse a JSON array of host-entry objects into a fresh
# HostRegistry. Returns 0 on any parse failure.
fn host_registry_load_json(json_cstr) {
    if (json_cstr == 0) { return 0; }
    var len = strlen(json_cstr);
    var i = _jx_skip_ws(json_cstr, len, 0);
    if (i >= len || load8(json_cstr + i) != 91) { return 0; }
    i = _jx_skip_ws(json_cstr, len, i + 1);
    var r = host_registry_new();
    while (i < len) {
        var c = load8(json_cstr + i);
        if (c == 93) { return r; }
        if (c != 123) { return 0; }
        var end = _jx_skip_struct(json_cstr, len, i, 123, 125);
        if (end > len) { return 0; }
        var olen = end - i;
        var obj = alloc(olen + 1);
        memcpy(obj, json_cstr + i, olen);
        store8(obj + olen, 0);
        var entry = host_entry_from_json(obj);
        if (entry == 0) { return 0; }
        host_registry_add(r, entry);
        i = _jx_skip_ws(json_cstr, len, end);
        if (i < len && load8(json_cstr + i) == 44) {
            i = _jx_skip_ws(json_cstr, len, i + 1);
        }
    }
    return 0;
}

# Read path into memory and parse via host_registry_load_json.
# Returns 0 on open / read / parse failure. Buffer size is
# HOST_CONFIG_BUF_MAX (64 KB).
fn host_registry_load_from_file(path) {
    if (path == 0) { return 0; }
    var buf = alloc(HOST_CONFIG_BUF_MAX + 1);
    var n = file_read_all(path, buf, HOST_CONFIG_BUF_MAX);
    if (n <= 0) { return 0; }
    store8(buf + n, 0);
    return host_registry_load_json(buf);
}

# Reload an existing registry from a config file. On success the
# registry pointer stays valid; only the underlying entries map
# is swapped. Returns 0 on success, -1 on failure. The caller's
# registry is left unchanged on failure (fail-safe).
fn host_registry_reload(r, path) {
    if (r == 0 || path == 0) { return 0 - 1; }
    var fresh = host_registry_load_from_file(path);
    var ln[BOTE_LOG_LINE_BYTES];
    if (fresh == 0) {
        # 3.4.0: the old entries stay in force; say that the new ones did not.
        bote_log_line(&ln, SK_WARN, "host config reload failed; keeping the previous entries");
        bote_log_str(&ln, "path", path);
        bote_log_emit(&ln);
        return 0 - 1;
    }
    store64(r,     host_registry_entries(fresh));
    store64(r + 8, host_registry_count(fresh));
    bote_log_line(&ln, SK_INFO, "host config reloaded");
    bote_log_str(&ln, "path", path);
    bote_log_int(&ln, "hosts", host_registry_count(fresh));
    bote_log_emit(&ln);
    return 0;
}

# ================================================================
# SSRF guard
# ================================================================
#
# Return codes (ssrf_ok = pass, anything else = blocked with reason).
# Callers should treat a non-zero return as "do not make this request"
# and surface the code so audit logs can distinguish a block reason.

var SSRF_OK         = 0;
var SSRF_PARSE      = 1;
var SSRF_SCHEME     = 2;
var SSRF_LOOPBACK   = 3;
var SSRF_LINK_LOCAL = 4;
var SSRF_PRIVATE    = 5;
var SSRF_METADATA   = 6;
var SSRF_UNSPEC     = 7;
var SSRF_MULTICAST  = 8;
var SSRF_SHARED     = 9;    # 100.64.0.0/10, RFC 6598 shared address space (3.4.7)
var SSRF_RESERVED   = 10;   # 240.0.0.0/4 and 192.0.0.0/24 (3.4.7)

# Return 1 if cstr `s` starts with `prefix`, else 0.
fn _ssrf_starts_with(s, prefix) {
    if (s == 0 || prefix == 0) { return 0; }
    var i = 0;
    while (1 == 1) {
        var p = load8(prefix + i);
        if (p == 0) { return 1; }
        if (load8(s + i) != p) { return 0; }
        i = i + 1;
    }
    return 0;
}

# `s` lowercased, on the request arena: a client's URL, judged once a message. It lasts
# until the next bote_req_begin.
fn _ssrf_lower(s) {
    var n = strlen(s);
    var out = alloc_via(bote_req_alloc(), n + 1);
    var i = 0;
    while (i < n) {
        var c = load8(s + i);
        if (c >= 65 && c <= 90) { c = c + 32; }
        store8(out + i, c);
        i = i + 1;
    }
    store8(out + n, 0);
    return out;
}

# Parse a CANONICAL base-10 octet out of cstr `s[pos..end]`. Canonical
# means: 1–3 digits, no leading zero on multi-digit octets, value 0-255.
# Rejecting leading zeros closes the 1.9.5 audit's octal-IPv4 bypass —
# `0177` would otherwise parse as decimal 177 here while glibc inet_aton
# treats it as octal 127 and connects to loopback. Hex (`0x7f`) fails
# here because it contains non-`[0-9]` bytes; ssrf_check refuses it.
fn _ssrf_parse_octet(s, pos, end, out_val) {
    if (pos >= end) { return 0 - 1; }
    var v = 0;
    var p = pos;
    var digits = 0;
    while (p < end) {
        var c = load8(s + p);
        if (c < 48 || c > 57) { p = end; }
        else {
            v = v * 10 + (c - 48);
            digits = digits + 1;
            p = p + 1;
        }
    }
    if (digits == 0 || digits > 3 || v > 255) { return 0 - 1; }
    # Reject leading-zero multi-digit forms: "0", "10", "127" all OK,
    # "00", "01", "010", "0177" all rejected (non-canonical / octal).
    if (digits > 1 && load8(s + pos) == 48) { return 0 - 1; }
    store64(out_val, v);
    return pos + digits;
}

# Parse a canonical dotted-decimal IPv4 literal s[start..end] into four
# bytes at out4 (first octet first). Returns 1, or 0 if it is not one.
# Shared by the IPv4 classifier and the IPv6 parser's dotted tail
# (`::ffff:1.2.3.4`), so both refuse the same non-canonical spellings.
fn _ssrf_parse_dotted(s, start, end, out4) {
    var a_slot[8]; var b_slot[8]; var c_slot[8]; var d_slot[8];
    store64(&a_slot, 0); store64(&b_slot, 0);
    store64(&c_slot, 0); store64(&d_slot, 0);

    # Find three dots first to chop s into four ranges
    var dot1 = 0 - 1; var dot2 = 0 - 1; var dot3 = 0 - 1;
    var k = start;
    while (k < end) {
        var c = load8(s + k);
        if (c == 46) {
            if (dot1 < 0) { dot1 = k; }
            elif (dot2 < 0) { dot2 = k; }
            elif (dot3 < 0) { dot3 = k; }
            else { return 0; }
        }
        k = k + 1;
    }
    if (dot3 < 0) { return 0; }

    # Each octet parse must consume EXACTLY the bytes between dots —
    # `64:ff9b::1.2.3.4` would otherwise parse as `64.2.3.4` (the
    # parser stops at ':' and returns 64) and bypass the IPv6 path.
    # 1.9.5 audit C3 fix.
    var ra = _ssrf_parse_octet(s, start, dot1, &a_slot);
    if (ra != dot1) { return 0; }
    var rb = _ssrf_parse_octet(s, dot1 + 1, dot2, &b_slot);
    if (rb != dot2) { return 0; }
    var rc = _ssrf_parse_octet(s, dot2 + 1, dot3, &c_slot);
    if (rc != dot3) { return 0; }
    var rd = _ssrf_parse_octet(s, dot3 + 1, end, &d_slot);
    if (rd != end) { return 0; }

    store8(out4, load64(&a_slot));
    store8(out4 + 1, load64(&b_slot));
    store8(out4 + 2, load64(&c_slot));
    store8(out4 + 3, load64(&d_slot));
    return 1;
}

# Classify a dotted-decimal IPv4 host substring s[start..end]. Returns
# an SSRF_* code: SSRF_OK if the address is public, otherwise the
# reason category. Returns SSRF_PARSE if not a valid IPv4 literal
# (caller should fall back to hostname classification).
fn _ssrf_classify_ipv4(s, start, end) {
    var o4[8];
    if (_ssrf_parse_dotted(s, start, end, &o4) == 0) { return SSRF_PARSE; }
    return _ssrf_classify_v4(load8(&o4), load8(&o4 + 1), load8(&o4 + 2));
}

# The IPv4 decision, on the first three octets. Shared by the string
# classifier above, ssrf_classify_ipv4_addr and the IPv6 classifier's
# embedded addresses, so a literal URL and a resolved address can never be
# judged differently (3.4.4).
#
# What counts as internal is a judgement call, made range by range (3.4.7
# added the shared, reserved and IETF ranges). 198.18.0.0/15, the
# benchmarking range, is deliberately NOT refused: fake-IP DNS proxies
# (Clash, mihomo, sing-box) answer every name with an address there, so
# refusing it would refuse every fetch on such a host, while nothing an
# attacker wants lives in it. The documentation ranges (192.0.2.0/24,
# 198.51.100.0/24, 203.0.113.0/24) are not refused either: nothing routes
# them, so a connect fails on its own.
fn _ssrf_classify_v4(a, b, c) {
    # 0.0.0.0/8 — unspecified / "any interface"
    if (a == 0) { return SSRF_UNSPEC; }
    # 127.0.0.0/8 — loopback
    if (a == 127) { return SSRF_LOOPBACK; }
    # 169.254.0.0/16 — link-local (covers AWS/GCP/Azure metadata at 169.254.169.254)
    if (a == 169 && b == 254) { return SSRF_METADATA; }
    # 10.0.0.0/8 — RFC 1918 private
    if (a == 10) { return SSRF_PRIVATE; }
    # 172.16.0.0/12
    if (a == 172 && b >= 16 && b <= 31) { return SSRF_PRIVATE; }
    # 192.168.0.0/16
    if (a == 192 && b == 168) { return SSRF_PRIVATE; }
    # 100.64.0.0/10 — RFC 6598 shared address space: carrier-grade NAT, and
    # the tailnet addresses Tailscale hands out (3.4.7)
    if (a == 100 && b >= 64 && b <= 127) { return SSRF_SHARED; }
    # 192.0.0.0/24 — IETF protocol assignments (RFC 6890): DS-Lite, NAT64
    # discovery and the like, not globally reachable (3.4.7)
    if (a == 192 && b == 0 && c == 0) { return SSRF_RESERVED; }
    # 224.0.0.0/4 — multicast
    if (a >= 224 && a <= 239) { return SSRF_MULTICAST; }
    # 240.0.0.0/4 — reserved (RFC 1112), which includes the limited
    # broadcast address 255.255.255.255 (3.4.7)
    if (a >= 240) { return SSRF_RESERVED; }
    return SSRF_OK;
}

# Classify a hostname (non-IP string). Conservative blocklist.
#
# Also rejects all-`[0-9]` hostnames as SSRF_PARSE: `2130706433` is the
# integer form of 127.0.0.1 — glibc's inet_aton accepts it, our IPv4
# parser rejects it (no dots), and a naked-digit hostname is never
# valid per RFC 952/1123. This closes the 1.9.5 audit's integer-IPv4
# bypass (audit C1).
fn _ssrf_classify_hostname(h) {
    if (streq(h, "localhost") == 1) { return SSRF_LOOPBACK; }
    if (streq(h, "metadata.google.internal") == 1) { return SSRF_METADATA; }
    if (streq(h, "metadata") == 1) { return SSRF_METADATA; }
    # All-digit hostname → reject. Also any short-form IPv4 (1, 2, or 3
    # dots with all-digit segments) we might've missed elsewhere.
    var hlen = strlen(h);
    if (hlen > 0) {
        var all_digits_or_dots = 1;
        var has_digit = 0;
        var i = 0;
        while (i < hlen) {
            var c = load8(h + i);
            if (c >= 48 && c <= 57) { has_digit = 1; }
            elif (c != 46) { all_digits_or_dots = 0; i = hlen; }
            i = i + 1;
        }
        if (all_digits_or_dots == 1 && has_digit == 1) { return SSRF_PARSE; }
    }
    return SSRF_OK;
}

# Hex digit value (0-15) of byte c, or -1.
fn _ssrf_hexval(c) {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return 0 - 1;
}

# Parse colon-separated hex groups s[0..len) into bytes at out, at most
# max_bytes. With allow_dotted, the last component may be a dotted quad
# (4 bytes). Returns the number of bytes written, or -1 if s is not a run of
# 1-4 digit groups (an empty group, a leading or trailing ':', or a fifth
# digit are all refused).
fn _ssrf_v6_groups(s, len, out, max_bytes, allow_dotted) {
    var written = 0;
    var i = 0;
    while (1 == 1) {
        var start = i;
        var nd = 0;
        var group = 0;
        while (i < len && load8(s + i) != 58) {
            var c = load8(s + i);
            if (c == 46) {
                # A dotted quad, which may only be the last component.
                if (allow_dotted == 0) { return 0 - 1; }
                if (written + 4 > max_bytes) { return 0 - 1; }
                if (_ssrf_parse_dotted(s, start, len, out + written) == 0) { return 0 - 1; }
                return written + 4;
            }
            var hv = _ssrf_hexval(c);
            if (hv < 0) { return 0 - 1; }
            nd = nd + 1;
            if (nd > 4) { return 0 - 1; }
            group = (group << 4) | hv;
            i = i + 1;
        }
        if (nd == 0) { return 0 - 1; }
        if (written + 2 > max_bytes) { return 0 - 1; }
        store8(out + written, (group >> 8) & 0xFF);
        store8(out + written + 1, group & 0xFF);
        written = written + 2;
        if (i >= len) { return written; }
        i = i + 1;
        if (i >= len) { return 0 - 1; }
    }
    return 0 - 1;
}

# Parse an IPv6 literal h[0..hlen) (no brackets, no zone id) into 16 bytes at
# out, per RFC 4291 §2.2: eight groups, or fewer around one `::` standing for
# at least one zero group, the last 32 bits optionally a dotted quad.
# Returns 1, or 0 if h is not one. tests/bote_host.tcyr checks it against
# the cyrius TLS stack's own parser (lib/tls_hostid.cyr) input by input.
fn _ssrf_parse_ipv6(h, hlen, out) {
    var z = 0;
    while (z < 16) { store8(out + z, 0); z = z + 1; }
    var dpos = 0 - 1;
    var i = 0;
    while (i + 1 < hlen) {
        if (load8(h + i) == 58 && load8(h + i + 1) == 58) {
            if (dpos >= 0) { return 0; }
            dpos = i;
            i = i + 1;
        }
        i = i + 1;
    }
    if (dpos < 0) {
        if (_ssrf_v6_groups(h, hlen, out, 16, 1) != 16) { return 0; }
        return 1;
    }
    var hb = 0;
    if (dpos > 0) {
        hb = _ssrf_v6_groups(h, dpos, out, 14, 0);
        if (hb < 0) { return 0; }
    }
    var tail[16];
    var tb = 0;
    var tail_len = hlen - (dpos + 2);
    if (tail_len > 0) {
        tb = _ssrf_v6_groups(h + dpos + 2, tail_len, &tail, 14 - hb, 1);
        if (tb < 0) { return 0; }
    }
    if (hb + tb > 14) { return 0; }
    var k = 0;
    while (k < tb) {
        store8(out + (16 - tb) + k, load8(&tail + k));
        k = k + 1;
    }
    return 1;
}

# Classify an IPv6 literal h[0..hlen) (the text between a URL's brackets).
# Since 3.4.7 the literal is parsed to its 16 bytes and judged by
# ssrf_classify_ipv6_bytes, the classifier web_fetch's resolve hook uses for
# AAAA answers. Through 3.4.6 this was a text prefix matcher. It missed every
# spelling it did not list (`0:0:0:0:0:0:0:1`, `0::1`, `fe9f::1`), and
# anything it did not recognise, garbage included, came back SSRF_OK. Now a
# literal that does not parse is SSRF_PARSE, which refuses it. A zone id
# (`fe80::1%25eth0`) is set aside and the address before it is classified.
fn _ssrf_classify_ipv6(h, hlen) {
    var alen = 0;
    while (alen < hlen && load8(h + alen) != 37) { alen = alen + 1; }
    if (alen < hlen && alen + 1 >= hlen) { return SSRF_PARSE; }
    var b16[16];
    if (_ssrf_parse_ipv6(h, alen, &b16) == 0) { return SSRF_PARSE; }
    return ssrf_classify_ipv6_bytes(&b16);
}

# Extract the host component of a URL. Writes pointers to host start /
# end into *out_start, *out_end. Returns SSRF_OK on parse success,
# SSRF_PARSE on malformed input, SSRF_SCHEME if scheme isn't http/https.
fn _ssrf_extract_host(url, out_start, out_end) {
    if (url == 0) { return SSRF_PARSE; }
    var lower = _ssrf_lower(url);

    # Scheme gate — only http:// and https:// are valid for SSRF context
    var scheme_end = 0;
    if (_ssrf_starts_with(lower, "http://") == 1) { scheme_end = 7; }
    elif (_ssrf_starts_with(lower, "https://") == 1) { scheme_end = 8; }
    else { return SSRF_SCHEME; }

    # Skip optional userinfo (user:pass@)
    var n = strlen(lower);
    var host_start = scheme_end;
    var at = 0 - 1;
    var i = scheme_end;
    while (i < n) {
        var c = load8(lower + i);
        # The authority ends at the first / ? or #, and the last @ inside it
        # ends the userinfo: `http://a@b@127.0.0.1/` and
        # `http://169.254.169.254?@example.com/` connect to the second one.
        if (c == 47 || c == 63 || c == 35) { i = n; }
        else {
            if (c == 64) { at = i; }
            i = i + 1;
        }
    }
    if (at >= 0) { host_start = at + 1; }

    # IPv6 literal? URL form is `http://[::1]:8080/...`
    if (host_start < n && load8(lower + host_start) == 91) {
        var bracket_end = host_start + 1;
        while (bracket_end < n && load8(lower + bracket_end) != 93) {
            bracket_end = bracket_end + 1;
        }
        if (bracket_end >= n) { return SSRF_PARSE; }
        # Inside brackets — exclude the [ and ]
        store64(out_start, lower + host_start + 1);
        store64(out_end,   lower + bracket_end);
        return SSRF_OK;
    }

    # Hostname / IPv4 — host ends at first ':' (port), '/' (path),
    # '?' (query), '#' (fragment), or end of string.
    var host_end = n;
    var j = host_start;
    while (j < host_end) {
        var c = load8(lower + j);
        if (c == 58 || c == 47 || c == 63 || c == 35) { host_end = j; }
        else { j = j + 1; }
    }
    if (host_end <= host_start) { return SSRF_PARSE; }

    store64(out_start, lower + host_start);
    store64(out_end,   lower + host_end);
    return SSRF_OK;
}

# Public entry: given a URL cstr, return 0 (safe) or an SSRF_* code.
# 1 when a label of `host` begins 0x: `0x7f.0.0.1` is 127.0.0.1 to inet_aton and
# a name to everything else here.
fn _ssrf_has_hex_label(host) {
    var i = 0;
    var at_start = 1;
    while (load8(host + i) != 0) {
        var c = load8(host + i);
        if (at_start == 1 && c == 48 && load8(host + i + 1) == 120) { return 1; }
        at_start = 0;
        if (c == 46) { at_start = 1; }
        i = i + 1;
    }
    return 0;
}

fn ssrf_check(url) {
    var start_slot[8]; var end_slot[8];
    store64(&start_slot, 0); store64(&end_slot, 0);
    var parse = _ssrf_extract_host(url, &start_slot, &end_slot);
    if (parse != SSRF_OK) { return parse; }

    var host_ptr = load64(&start_slot);
    var host_end_ptr = load64(&end_slot);
    var host_len = host_end_ptr - host_ptr;

    # Copy out the host as its own NUL-terminated cstr so we can feed
    # it to streq against the string blocklist.
    var host = alloc_via(bote_req_alloc(), host_len + 1);
    memcpy(host, host_ptr, host_len);
    store8(host + host_len, 0);

    # A bracketed host is an IP literal by definition (RFC 3986 §3.2.2), so
    # it goes to the IPv6 classifier whatever it contains. _ssrf_extract_host
    # leaves host_ptr just past the `[`. Through 3.4.6 the choice was "has a
    # colon", so `[zzz]` or `[]` fell through to the hostname path and passed.
    if (load8(host_ptr - 1) == 91) { return _ssrf_classify_ipv6(host, host_len); }

    # Try IPv4 literal first. _ssrf_classify_ipv4 operates on offsets
    # into the original lowered buffer; re-use our extracted copy.
    var v4 = _ssrf_classify_ipv4(host, 0, host_len);
    if (v4 != SSRF_PARSE) { return v4; }
    if (_ssrf_has_hex_label(host) == 1) { return SSRF_PARSE; }

    # Fall back to hostname blocklist (conservative; does NOT resolve DNS).
    return _ssrf_classify_hostname(host);
}

# Convenience: 1 if the URL is safe to fetch, 0 otherwise.
fn ssrf_is_safe(url) {
    if (ssrf_check(url) == SSRF_OK) { return 1; }
    return 0;
}

# ================================================================
# Resolved-address classifiers (3.4.4)
# ================================================================
#
# ssrf_check judges a URL's host string. web_fetch's resolve hook
# (src/web_tools.cyr) judges the address a name actually resolved to, which
# closes the hostname case: `127.0.0.1.nip.io`, or any name whose A record
# points inside, passes the string check and is refused here.

# Classify a packed IPv4 address as sandhi and lib/net.cyr carry it: network
# byte order in the low 32 bits, so the first octet is the lowest byte
# (127.0.0.1 is 0x0100007F).
fn ssrf_classify_ipv4_addr(addr) {
    return _ssrf_classify_v4(addr & 0xFF, (addr >> 8) & 0xFF, (addr >> 16) & 0xFF);
}

# Classify 16 raw IPv6 address bytes at `p`: an AAAA answer from web_fetch's
# resolve hook, or, since 3.4.7, a URL's IPv6 literal after
# _ssrf_parse_ipv6. One decision for both, so no spelling of an address can
# be judged differently from the address itself.
fn ssrf_classify_ipv6_bytes(p) {
    if (p == 0) { return SSRF_PARSE; }
    var zero10 = 1;
    var i = 0;
    while (i < 10) {
        if (load8(p + i) != 0) { zero10 = 0; }
        i = i + 1;
    }
    var b10 = load8(p + 10) & 0xFF;
    var b11 = load8(p + 11) & 0xFF;
    if (zero10 == 1 && b10 == 0 && b11 == 0) {
        # ::/96: :: unspecified, ::1 loopback, and the deprecated
        # IPv4-compatible ::a.b.c.d, rejected as the string classifier does.
        var tail = (load8(p + 12) & 0xFF) | (load8(p + 13) & 0xFF) | (load8(p + 14) & 0xFF);
        var last = load8(p + 15) & 0xFF;
        if (tail == 0 && last == 0) { return SSRF_UNSPEC; }
        if (tail == 0 && last == 1) { return SSRF_LOOPBACK; }
        return SSRF_PRIVATE;
    }
    # ::ffff:0:0/96 IPv4-mapped: conservative, as the string classifier.
    if (zero10 == 1 && b10 == 0xFF && b11 == 0xFF) { return SSRF_PRIVATE; }
    var b0 = load8(p) & 0xFF;
    var b1 = load8(p + 1) & 0xFF;
    # 64:ff9b::/96 NAT64 well-known prefix (RFC 6052)
    if (b0 == 0x00 && b1 == 0x64 && (load8(p + 2) & 0xFF) == 0xFF && (load8(p + 3) & 0xFF) == 0x9B) {
        return SSRF_PRIVATE;
    }
    # 64:ff9b:1::/48 NAT64 local-use prefix (RFC 8215), as the well-known
    # one (3.4.7)
    if (b0 == 0x00 && b1 == 0x64 && (load8(p + 2) & 0xFF) == 0xFF && (load8(p + 3) & 0xFF) == 0x9B
      && (load8(p + 4) & 0xFF) == 0x00 && (load8(p + 5) & 0xFF) == 0x01) {
        return SSRF_PRIVATE;
    }
    # 2002::/16 6to4: bytes 2-5 are an IPv4 address, judged as one (3.4.7).
    # `2002:7f00:1::` carries 127.0.0.1.
    if (b0 == 0x20 && b1 == 0x02) {
        var c6to4 = _ssrf_classify_v4(load8(p + 2) & 0xFF, load8(p + 3) & 0xFF, load8(p + 4) & 0xFF);
        if (c6to4 != SSRF_OK) { return c6to4; }
    }
    # fe80::/10 link-local
    if (b0 == 0xFE && (b1 & 0xC0) == 0x80) { return SSRF_LINK_LOCAL; }
    # fec0::/10 site-local: deprecated (RFC 3879), still the old private
    # range wherever a stack routes it (3.4.7)
    if (b0 == 0xFE && (b1 & 0xC0) == 0xC0) { return SSRF_PRIVATE; }
    # fc00::/7 unique local
    if ((b0 & 0xFE) == 0xFC) { return SSRF_PRIVATE; }
    # ff00::/8 multicast
    if (b0 == 0xFF) { return SSRF_MULTICAST; }
    return SSRF_OK;
}

# Dotted-quad text of a packed IPv4 address, for a log line.
fn ssrf_ipv4_addr_str(addr) {
    var sb = str_builder_new();
    var k = 0;
    while (k < 4) {
        if (k > 0) { str_builder_add_cstr(sb, "."); }
        str_builder_add_int(sb, (addr >> (k * 8)) & 0xFF);
        k = k + 1;
    }
    return str_data(str_builder_build(sb));
}

# Uncompressed hex text of 16 IPv6 bytes (`fe80:0:0:0:0:0:0:1`), for a log line.
fn ssrf_ipv6_bytes_str(p) {
    var out = alloc(40);
    var hex = "0123456789abcdef";
    var o = 0;
    var g = 0;
    while (g < 8) {
        if (g > 0) { store8(out + o, 58); o = o + 1; }
        var w = ((load8(p + g * 2) & 0xFF) << 8) | (load8(p + g * 2 + 1) & 0xFF);
        var started = 0;
        var sh = 12;
        while (sh >= 0) {
            var d = (w >> sh) & 15;
            if (d != 0 || started == 1 || sh == 0) {
                store8(out + o, load8(hex + d));
                o = o + 1;
                started = 1;
            }
            sh = sh - 4;
        }
        g = g + 1;
    }
    store8(out + o, 0);
    return out;
}

# Lowercase name of an SSRF_* code, for a log line or an error message
# (3.4.0). An unknown code is "unknown".
fn ssrf_reason(code) {
    if (code == SSRF_OK) { return "ok"; }
    if (code == SSRF_PARSE) { return "parse"; }
    if (code == SSRF_SCHEME) { return "scheme"; }
    if (code == SSRF_LOOPBACK) { return "loopback"; }
    if (code == SSRF_LINK_LOCAL) { return "link_local"; }
    if (code == SSRF_PRIVATE) { return "private"; }
    if (code == SSRF_METADATA) { return "metadata"; }
    if (code == SSRF_UNSPEC) { return "unspecified"; }
    if (code == SSRF_MULTICAST) { return "multicast"; }
    if (code == SSRF_SHARED) { return "shared"; }
    if (code == SSRF_RESERVED) { return "reserved"; }
    return "unknown";
}

# The lowercased host of `url` (userinfo, port and IPv6 brackets stripped), or 0
# when it does not parse. On the request arena since 3.6.6, so it lasts until the
# next bote_req_begin: copy it to keep it. For logging which host a request aimed
# at without logging the URL, whose userinfo or query string may carry a
# credential (3.4.0).
fn ssrf_host(url) {
    var start_slot[8]; var end_slot[8];
    store64(&start_slot, 0); store64(&end_slot, 0);
    if (_ssrf_extract_host(url, &start_slot, &end_slot) != SSRF_OK) { return 0; }
    var hp = load64(&start_slot);
    var hl = load64(&end_slot) - hp;
    var host = alloc_via(bote_req_alloc(), hl + 1);
    memcpy(host, hp, hl);
    store8(host + hl, 0);
    return host;
}

# --- libro_tools.cyr ---

# bote::libro_tools — five built-in MCP tools over a libro audit chain.
#
# Tools (all prefixed `libro_` so they're one namespace for clients):
#
#   libro_query      search / filter / paginate chain entries
#   libro_verify     verify chain integrity (hash-link + self-hash)
#   libro_export     return the chain as a JSON array (in-memory)
#   libro_proof      Merkle inclusion proof for one entry by index
#   libro_retention  apply a retention policy, return archive summary
#
# Wiring: bote calls `libro_tools_init(chain)` once, then
# `libro_tools_register(dispatcher)`. The chain pointer is stashed in a
# module-level var (handlers have a single-arg signature in cyrius, no
# closures — this is the standard workaround).
#
# All libro boundaries expect Str (fat string {data, len}); MCP args
# arrive as cstr. Every cross-boundary pass wraps with str_from() — the
# same pattern that fixed the v1.2.1 audit_libro cstr/Str heisenbug.
#
# 2.6.2 port: libro 2.x dropped the public `entry_action` /
# `entry_severity` / `entry_hash` / `entry_source` / `entry_agent_id` /
# `entry_timestamp` accessors, the `chain_entries` getter, the
# `error_code` / `error_index` / `error_msg` getters, the
# `merkle_tree_leaf_count` accessor, and renamed `merkle_proof` to
# `merkle_inclusion_proof`. All of those are now field reads on
# struct-typed handles. We re-introduce the thin accessor names
# below as module-local `_lt_*` helpers so the handler bodies stay
# readable — matches libro's `struct entry` layout (raw offsets are
# documented inline).

# ================================================================
# Module state: the chain we're wrapping, set once at init
# ================================================================

var _libro_tools_chain = 0;

fn libro_tools_init(chain) {
    _libro_tools_chain = chain;
    return 0;
}

# ================================================================
# libro 2.x struct-field accessors (used to be public; raw offsets
# now). Layout reference: `struct entry` / `struct error` /
# `struct chain` / `struct merkle_tree` in lib/libro.cyr.
#
# 3.2.0: the line-number citations that used to sit here (:200, :28,
# :1079, :2046) were already wrong at libro 2.8.2 and rotted further
# at 2.8.4. They are gone — grep the struct NAME instead, which does
# not drift on an upstream bump.
# ================================================================

# struct entry — +0 uuid_hi, +8 uuid_lo, +16 timestamp, +24 severity,
# +32 source(Str), +40 action(Str), +48 details(Str),
# +56 agent_id(Str|0), +64 prev_hash(Str), +72 hash(Str),
# +80 hash_algorithm.
fn _lt_entry_timestamp(e) { return load64(e + 16); }
fn _lt_entry_severity(e)  { return load64(e + 24); }
fn _lt_entry_source(e)    { return load64(e + 32); }
fn _lt_entry_action(e)    { return load64(e + 40); }
fn _lt_entry_agent_id(e)  { return load64(e + 56); }
fn _lt_entry_hash(e)      { return load64(e + 72); }

# struct chain — +0 entries(vec), +8 prev_hash(Str), +16 max_capacity,
# +24 overflow(vec), +32 streaming.
#
# libro 2.8.4 appended the 5th field (`streaming`, chain 32 -> 40
# bytes) for its new O(1)-memory write-through constructor
# `chain_new_streaming()`. Appended, not inserted — so the +0 read
# below is unaffected. bote stands up its chain with plain
# `chain_new()` (src/main.cyr), which keeps entries retained, which is
# what the libro_query / export / proof handlers below iterate.
fn _lt_chain_entries(c)   { return load64(c); }

# struct error — read through libro's `#derive(accessors)` getters, NOT
# raw offsets.
#
# ⚠ This is the one place where the raw-offset convention used elsewhere
# in this file actively broke. libro 2.8.11 PREPENDED `magic` and grew
# the record 48 -> 56 bytes, shifting every field +8. Contrast the 2.8.4
# `struct chain` growth documented above: that field was APPENDED, so the
# +0 read stayed valid. A field added at the END is safe to ignore; a
# field inserted at the FRONT moves everything.
#
# The stale offsets returned magic-as-code, code-as-msg and
# field_name-as-index. Because `msg` goes to `_json_emit_escaped`, which
# does `load8(cstr + i)`, decoding a tampered chain dereferenced the
# small integer error CODE as a pointer — SIGSEGV, exit 139.
#
# No test caught it: every pre-existing assertion runs the HAPPY path,
# and this block is reached only when `chain_verify` returns non-zero,
# i.e. only on a TAMPERED chain. tests/bote_libro_tools.tcyr now covers
# it end to end, and the fix is mutation-proven — restoring any old
# offset turns the suite red with exit 139.
#
# `struct error` carries `#derive(accessors)` (lib/libro.cyr:45), so
# these getters are generated by libro and track its layout
# automatically. That is why they are used here in preference to raw
# offsets: this failure mode cannot recur.
fn _lt_err_code(err)      { return error_code(err);  }
fn _lt_err_msg(err)       { return error_msg(err);   }
fn _lt_err_index(err)     { return error_index(err); }

# struct merkle_tree — +0 nodes(vec), +8 leaf_count.
fn _lt_merkle_leaf_count(t) { return load64(t + 8); }

# ================================================================
# Small helpers
# ================================================================

# Parse a JSON number field out of args_cstr. Returns 0 if absent.
# (Bote-wide pattern: 0 is "absent"; handlers treat 0 as default.)
fn _lt_get_int(args, key) {
    var raw = jsonx_get_raw(args, key);
    if (raw == 0) { return 0; }
    # The validator's reading, so `1e3` is 1000 here too. str_to_int skips
    # non-digits, which made it 13, and wraps.
    return _sch_parse_int(raw);
}

# The CallToolResult for a tool's JSON object `json` (3.4.10): the JSON as a
# text block, the same object as `structuredContent`, and `"isError":true`
# when the tool failed. The tools spec says a tool returning structured
# content SHOULD also return it serialized in a text block, which is how a
# client without structured support still reads it. Through 3.4.9 these tools
# returned the bare object. Since 3.4.8 the dispatcher has wrapped that as
# text, but a failure ({"ok":false,...}) still went out without isError.
fn _lt_result(json, is_error) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"content\":[{\"type\":\"text\",\"text\":\"");
    _json_emit_escaped(sb, json);
    str_builder_add_cstr(sb, "\"}],\"structuredContent\":");
    str_builder_add_cstr(sb, json);
    if (is_error == 1) { str_builder_add_cstr(sb, ",\"isError\":true"); }
    str_builder_add_cstr(sb, "}");
    return str_data(str_builder_build(sb));
}

# A failed call: {"ok":false,"error":"<msg>"}, as a CallToolResult with isError.
fn _lt_error(msg) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"ok\":false,\"error\":\"");
    _json_emit_escaped(sb, msg);
    str_builder_add_cstr(sb, "\"}");
    return _lt_result(str_data(str_builder_build(sb)), 1);
}

# Emit one entry as a JSON object into sb.
#
# `timestamp` is libro's RFC 3339 text (`2026-10-16T05:46:12Z`), a Str, so it
# is emitted as a JSON string (null if absent). Through 3.4.9 it went out
# through str_builder_add_int, which printed the Str's heap address: every
# libro_query and libro_export entry carried a pointer value where its time
# belonged (3.4.10). That is the struct-layout drift CLAUDE.md warns about,
# here a field whose type changed rather than moved.
fn _lt_emit_entry(sb, e) {
    str_builder_add_cstr(sb, "{\"timestamp\":");
    var ts = _lt_entry_timestamp(e);
    if (ts == 0) {
        str_builder_add_cstr(sb, "null");
    } else {
        str_builder_add_cstr(sb, "\"");
        _json_emit_escaped(sb, str_data(ts));
        str_builder_add_cstr(sb, "\"");
    }
    str_builder_add_cstr(sb, ",\"severity\":");
    str_builder_add_int(sb, _lt_entry_severity(e));
    str_builder_add_cstr(sb, ",\"source\":\"");
    _json_emit_escaped(sb, str_data(_lt_entry_source(e)));
    str_builder_add_cstr(sb, "\",\"action\":\"");
    _json_emit_escaped(sb, str_data(_lt_entry_action(e)));
    str_builder_add_cstr(sb, "\",\"agent_id\":\"");
    var aid = _lt_entry_agent_id(e);
    if (aid != 0) { _json_emit_escaped(sb, str_data(aid)); }
    str_builder_add_cstr(sb, "\",\"hash\":\"");
    _json_emit_escaped(sb, str_data(_lt_entry_hash(e)));
    str_builder_add_cstr(sb, "\"}");
    return 0;
}

# Emit a vec of entries as a JSON array into sb.
fn _lt_emit_entries_array(sb, entries) {
    str_builder_add_cstr(sb, "[");
    var n = vec_len(entries);
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        _lt_emit_entry(sb, vec_get(entries, i));
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]");
    return 0;
}

# ================================================================
# libro_query — search / filter / paginate
#
# args: {source?, agent_id?, action?, severity?, min_severity?,
#        after?, before?, offset?, limit?}
# result: {"ok":true,"entries":[{...}]}
# ================================================================

fn _libro_tool_query_held(args, claims) {
    if (_libro_tools_chain == 0) { return _lt_error("libro not configured"); }

    var q = query_new();
    var src = jsonx_get_str(args, "source");
    if (src != 0) { query_source(q, str_from(src)); }
    var aid = jsonx_get_str(args, "agent_id");
    if (aid != 0) { query_agent_id(q, str_from(aid)); }
    var act = jsonx_get_str(args, "action");
    if (act != 0) { query_action(q, str_from(act)); }

    if (jsonx_has(args, "severity") == 1) {
        query_severity(q, _lt_get_int(args, "severity"));
    }
    if (jsonx_has(args, "min_severity") == 1) {
        query_min_severity(q, _lt_get_int(args, "min_severity"));
    }
    if (jsonx_has(args, "after") == 1) {
        query_after(q, _lt_get_int(args, "after"));
    }
    if (jsonx_has(args, "before") == 1) {
        query_before(q, _lt_get_int(args, "before"));
    }

    var matched = query_apply(q, _lt_chain_entries(_libro_tools_chain));

    # Pagination: offset + limit slice the matched vec.
    var offset = _lt_get_int(args, "offset");
    var limit = _lt_get_int(args, "limit");
    var page = vec_new();
    var total = vec_len(matched);
    var start = offset;
    if (start < 0) { start = 0; }
    var end = total;
    if (limit > 0 && limit < end - start) { end = start + limit; }
    var i = start;
    while (i < end) {
        vec_push(page, vec_get(matched, i));
        i = i + 1;
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"ok\":true,\"total\":");
    str_builder_add_int(sb, total);
    str_builder_add_cstr(sb, ",\"entries\":");
    _lt_emit_entries_array(sb, page);
    str_builder_add_cstr(sb, "}");
    return _lt_result(str_data(str_builder_build(sb)), 0);
}

# ================================================================
# libro_verify — hash-link integrity check
#
# args: {} (no params)
# result: {"ok":true} | {"ok":false,"code":N,"message":"..."}
# ================================================================

fn _libro_tool_verify_held(args, claims) {
    if (_libro_tools_chain == 0) { return _lt_error("libro not configured"); }
    var err = chain_verify(_libro_tools_chain);
    if (err == 0) { return _lt_result("{\"ok\":true}", 0); }

    # Fail closed on anything that is not a libro error record.
    # `chain_verify` is documented to return 0 or an error pointer, but
    # this is the branch that decodes an attacker-triggered condition, so
    # it checks rather than trusts: `libro_is_error` rejects null, small
    # integers and misaligned pointers before any dereference, then
    # confirms the 2.8.11 magic at +0. Report the violation without
    # decoding it rather than dereferencing whatever is there.
    if (libro_is_error(err) == 0) {
        return _lt_result("{\"ok\":false,\"code\":0,\"index\":-1,\"message\":\"chain verification failed (unrecognised libro error record)\"}", 1);
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"ok\":false,\"code\":");
    str_builder_add_int(sb, _lt_err_code(err));
    str_builder_add_cstr(sb, ",\"index\":");
    str_builder_add_int(sb, _lt_err_index(err));
    str_builder_add_cstr(sb, ",\"message\":\"");
    var m = _lt_err_msg(err);
    if (m != 0) { _json_emit_escaped(sb, m); }
    str_builder_add_cstr(sb, "\"}");
    return _lt_result(str_data(str_builder_build(sb)), 1);
}

# ================================================================
# libro_export — return the chain as a JSON array of entries
#
# args: {} (no params)
# result: {"ok":true,"count":N,"entries":[...]}
# ================================================================

fn _libro_tool_export_held(args, claims) {
    if (_libro_tools_chain == 0) { return _lt_error("libro not configured"); }
    var entries = _lt_chain_entries(_libro_tools_chain);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"ok\":true,\"count\":");
    str_builder_add_int(sb, vec_len(entries));
    str_builder_add_cstr(sb, ",\"entries\":");
    _lt_emit_entries_array(sb, entries);
    str_builder_add_cstr(sb, "}");
    return _lt_result(str_data(str_builder_build(sb)), 0);
}

# ================================================================
# libro_proof — Merkle inclusion proof for entry at index
#
# args: {"index": N}
# result: {"ok":true,"root":"<hex>","leaf_count":N,"index":N} |
#         {"ok":false,"error":"..."}
#
# Note: the path hashes are omitted here to keep the response compact;
# the verifier can reconstruct the tree from libro_export and validate.
# A richer "path" field can be added in a follow-up release once the
# wire format is pinned.
# ================================================================

fn _libro_tool_proof_held(args, claims) {
    if (_libro_tools_chain == 0) { return _lt_error("libro not configured"); }
    if (jsonx_has(args, "index") == 0) { return _lt_error("missing 'index'"); }
    var idx = _lt_get_int(args, "index");

    var entries = _lt_chain_entries(_libro_tools_chain);
    if (idx < 0 || idx >= vec_len(entries)) { return _lt_error("index out of range"); }

    var tree = merkle_build(entries);
    if (tree == 0) { return _lt_error("empty chain"); }
    var proof = merkle_inclusion_proof(tree, idx);
    if (proof == 0) { return _lt_error("proof unavailable"); }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"ok\":true,\"index\":");
    str_builder_add_int(sb, idx);
    str_builder_add_cstr(sb, ",\"leaf_count\":");
    str_builder_add_int(sb, _lt_merkle_leaf_count(tree));
    str_builder_add_cstr(sb, ",\"root\":\"");
    var root = merkle_tree_root(tree);
    if (root != 0) { _json_emit_escaped(sb, str_data(root)); }
    str_builder_add_cstr(sb, "\"}");
    return _lt_result(str_data(str_builder_build(sb)), 0);
}

# ================================================================
# libro_retention — apply a retention policy, return archive summary
#
# args: {"policy": "keep_count"|"keep_duration"|"keep_after"|
#                  "pci_dss"|"hipaa"|"sox",
#        "value": N (required for keep_count/keep_duration/keep_after)}
# result: {"ok":true,"archived":N,"retained":M} |
#         {"ok":false,"error":"..."}
# ================================================================

fn _libro_tool_retention_held(args, claims) {
    if (_libro_tools_chain == 0) { return _lt_error("libro not configured"); }
    var policy_name = jsonx_get_str(args, "policy");
    if (policy_name == 0) { return _lt_error("missing 'policy'"); }

    # keep_count / keep_duration / keep_after need `value`. Through 3.4.9 a
    # missing one read as 0, so {"policy":"keep_count"} kept zero entries and
    # archived the whole chain. A negative value is refused too.
    var needs_value = 0;
    if (streq(policy_name, "keep_count") == 1 || streq(policy_name, "keep_duration") == 1 || streq(policy_name, "keep_after") == 1) {
        needs_value = 1;
    }
    if (needs_value == 1) {
        if (jsonx_has(args, "value") == 0) { return _lt_error("missing 'value' (required for keep_count, keep_duration and keep_after)"); }
        if (_lt_get_int(args, "value") < 0) { return _lt_error("'value' must not be negative"); }
    }

    var policy = 0;
    if (streq(policy_name, "keep_count") == 1) {
        policy = retention_keep_count(_lt_get_int(args, "value"));
    } elif (streq(policy_name, "keep_duration") == 1) {
        policy = retention_keep_duration(_lt_get_int(args, "value"));
    } elif (streq(policy_name, "keep_after") == 1) {
        policy = retention_keep_after(_lt_get_int(args, "value"));
    } elif (streq(policy_name, "pci_dss") == 1) {
        policy = retention_pci_dss();
    } elif (streq(policy_name, "hipaa") == 1) {
        policy = retention_hipaa();
    } elif (streq(policy_name, "sox") == 1) {
        policy = retention_sox();
    } else {
        return _lt_error("unknown policy");
    }

    var before = vec_len(_lt_chain_entries(_libro_tools_chain));
    chain_apply_retention(_libro_tools_chain, policy);
    var after = vec_len(_lt_chain_entries(_libro_tools_chain));
    var archived = before - after;
    if (archived < 0) { archived = 0; }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"ok\":true,\"archived\":");
    str_builder_add_int(sb, archived);
    str_builder_add_cstr(sb, ",\"retained\":");
    str_builder_add_int(sb, after);
    str_builder_add_cstr(sb, "}");
    return _lt_result(str_data(str_builder_build(sb)), 0);
}

# ================================================================
# Registration: add all 5 tools to the dispatcher + registry
# ================================================================

# One property: `name` with schema `json`, pushed onto `props`.
# Each tool walks the chain the audit sink may be appending to from another worker, so each
# does all its work under the chain's lock (3.7.1, src/audit_libro.cyr).
fn libro_tool_query(args, claims) {
    bote_libro_lock();
    var r = _libro_tool_query_held(args, claims);
    bote_libro_unlock();
    return r;
}

fn libro_tool_verify(args, claims) {
    bote_libro_lock();
    var r = _libro_tool_verify_held(args, claims);
    bote_libro_unlock();
    return r;
}

fn libro_tool_export(args, claims) {
    bote_libro_lock();
    var r = _libro_tool_export_held(args, claims);
    bote_libro_unlock();
    return r;
}

fn libro_tool_proof(args, claims) {
    bote_libro_lock();
    var r = _libro_tool_proof_held(args, claims);
    bote_libro_unlock();
    return r;
}

fn libro_tool_retention(args, claims) {
    bote_libro_lock();
    var r = _libro_tool_retention_held(args, claims);
    bote_libro_unlock();
    return r;
}

fn _lt_prop(props, name, json) {
    vec_push(props, schema_prop_new(name, json));
    return 0;
}

fn libro_tools_register(dispatcher) {
    var reg = dispatcher_registry(dispatcher);
    # Real input schemas since 3.4.10. Through 3.4.9 every tool registered
    # {"type":"object"} with no properties, so clients learned the arguments
    # from the description text and 3.4.8's compiled validation had nothing
    # to check.
    var qp = vec_new();
    _lt_prop(qp, "source", "{\"type\":\"string\",\"description\":\"Only entries from this source.\"}");
    _lt_prop(qp, "agent_id", "{\"type\":\"string\",\"description\":\"Only entries from this agent.\"}");
    _lt_prop(qp, "action", "{\"type\":\"string\",\"description\":\"Only entries with this action.\"}");
    _lt_prop(qp, "severity", "{\"type\":\"integer\",\"minimum\":0,\"maximum\":5,\"description\":\"Only entries at exactly this severity: 0 debug, 1 info, 2 warning, 3 error, 4 critical, 5 security.\"}");
    _lt_prop(qp, "min_severity", "{\"type\":\"integer\",\"minimum\":0,\"maximum\":5,\"description\":\"Only entries at this severity or above.\"}");
    _lt_prop(qp, "after", "{\"type\":\"integer\",\"description\":\"Only entries timestamped after this Unix time (seconds, exclusive).\"}");
    _lt_prop(qp, "before", "{\"type\":\"integer\",\"description\":\"Only entries timestamped before this Unix time (seconds, exclusive).\"}");
    _lt_prop(qp, "offset", "{\"type\":\"integer\",\"minimum\":0,\"description\":\"Skip this many matching entries (default 0).\"}");
    _lt_prop(qp, "limit", "{\"type\":\"integer\",\"minimum\":0,\"description\":\"Return at most this many entries (default: all).\"}");
    registry_register(reg, tool_def_with_annotations(tool_def_new(
          "libro_query", "Search the libro audit chain: filter by source, agent, action, severity and time, and paginate. Each entry carries its RFC 3339 timestamp, severity, source, action, agent and hash.",
          schema_new("object", qp, vec_new())), ann_read_only()));
    dispatcher_handle(dispatcher, "libro_query", &libro_tool_query);

    registry_register(reg, tool_def_with_annotations(tool_def_new(
          "libro_verify", "Verify the libro chain's hash links. Reports the first broken entry's index when verification fails.",
          schema_new("object", 0, vec_new())), ann_read_only()));
    dispatcher_handle(dispatcher, "libro_verify", &libro_tool_verify);

    registry_register(reg, tool_def_with_annotations(tool_def_new(
          "libro_export", "Return every entry on the libro chain.",
          schema_new("object", 0, vec_new())), ann_read_only()));
    dispatcher_handle(dispatcher, "libro_export", &libro_tool_export);

    var pp = vec_new();
    _lt_prop(pp, "index", "{\"type\":\"integer\",\"minimum\":0,\"description\":\"Position of the entry in the chain, from 0.\"}");
    var preq = vec_new();
    vec_push(preq, "index");
    registry_register(reg, tool_def_with_annotations(tool_def_new(
          "libro_proof", "Merkle inclusion proof for the entry at the given index: the tree root and its leaf count.",
          schema_new("object", pp, preq)), ann_read_only()));
    dispatcher_handle(dispatcher, "libro_proof", &libro_tool_proof);

    var rp = vec_new();
    _lt_prop(rp, "policy", "{\"type\":\"string\",\"enum\":[\"keep_count\",\"keep_duration\",\"keep_after\",\"pci_dss\",\"hipaa\",\"sox\"],\"description\":\"Which entries to keep. keep_count, keep_duration and keep_after need value; pci_dss, hipaa and sox are fixed policies.\"}");
    _lt_prop(rp, "value", "{\"type\":\"integer\",\"minimum\":0,\"description\":\"keep_count: how many of the newest entries to keep. keep_duration: keep entries younger than this many seconds. keep_after: keep entries after this Unix time (seconds). Required by those three.\"}");
    var rreq = vec_new();
    vec_push(rreq, "policy");
    registry_register(reg, tool_def_with_annotations(tool_def_new(
          "libro_retention", "Apply a retention policy to the libro chain: entries outside it are archived off the chain. Destructive.",
          schema_new("object", rp, rreq)), ann_set_open_world(ann_destructive(), HINT_FALSE)));
    dispatcher_handle(dispatcher, "libro_retention", &libro_tool_retention);
    return 0;
}

# --- fs_tools.cyr ---

# fs_tools — filesystem MCP tools for the bote binary
# (fs_write / fs_read / fs_mkdir).
#
# Additive: registered on an existing dispatcher by fs_tools_register(),
# called from src/main.cyr after bote_dispatcher_with_echo(). Mirrors the
# libro_tools_register() idiom.
#
# Results are MCP content blocks ({"content":[{"type":"text",...}],"isError":..})
# so an MCP client (thoth) renders them directly.
#
# SECURITY: writes/reads/mkdirs are confined to a root (env BOTE_FS_ROOT,
# default "."). A relative arg-path containing a ".." segment or a leading "/"
# is REFUSED — defense-in-depth beneath t-ron's per-tool authorization. This
# is a demo tool; the root confinement is a floor, not a full sandbox.

var FS_READ_CAP = 65536;    # max bytes fs_read returns
var FS_READ_NOTE = 32;      # room after them for the truncation note and a NUL
var BOTE_ERRNO_ENOENT = 2;
# agnos defines no O_NONBLOCK, and its file_open ignores flags it does not know.
#ifdef CYRIUS_TARGET_AGNOS
var BOTE_O_NONBLOCK = 0;
#endif
#ifndef CYRIUS_TARGET_AGNOS
var BOTE_O_NONBLOCK = O_NONBLOCK;
#endif

# ---- root + path safety ---------------------------------------------------

fn _fs_root() {
    var r = getenv("BOTE_FS_ROOT");
    if (r == 0) { return "."; }
    if (load8(r) == 0) { return "."; }
    return r;
}

# 1 if the relative path is unsafe (empty / absolute / contains "..").
fn _fs_path_unsafe(rel) {
    if (rel == 0) { return 1; }
    if (load8(rel) == 0) { return 1; }      # empty
    if (load8(rel) == 47) { return 1; }     # leading '/'  -> absolute
    var n = strlen(rel);
    var i = 0;
    while ((i + 1) < n) {
        if ((load8(rel + i) == 46) && (load8(rel + i + 1) == 46)) { return 1; }  # ".."
        i = i + 1;
    }
    return 0;
}

# Join root + "/" + rel into a fresh NUL-terminated cstr.
fn _fs_join(rel) {
    var root = _fs_root();
    var rl = strlen(root);
    var pl = strlen(rel);
    var out = alloc(rl + 1 + pl + 1);
    memcpy(out, root, rl);
    store8(out + rl, 47);                    # '/'
    memcpy(out + rl + 1, rel, pl);
    store8(out + rl + 1 + pl, 0);
    return out;
}

# mkdir every directory prefix of `full`. When include_last is 1, `full`
# itself is created too (fs_mkdir); otherwise only the parents (fs_write).
# Temporarily NUL-splits `full` in place (restored each step). Errors from
# an already-existing dir are ignored; only a later open/write failure is
# surfaced. i starts at 1 so a root '/' is never mkdir'd.
fn _fs_mkparents(full, include_last) {
    var n = strlen(full);
    var i = 1;
    while (i < n) {
        if (load8(full + i) == 47) {         # '/'
            store8(full + i, 0);
            sys_mkdir(full, 0x1ED);          # 0755; ignore EEXIST
            store8(full + i, 47);
        }
        i = i + 1;
    }
    if (include_last == 1) {
        sys_mkdir(full, 0x1ED);
    }
    return 0;
}

# ---- JSON string unescape -------------------------------------------------
# jsonx_get_str returns the RAW inner bytes (no unescaping), so a
# "content":"a\nb" arrives as the literal bytes a \ n b. Decode the JSON
# string escapes here. Writes the decoded length to *len_out and returns a
# fresh NUL-terminated buffer (decoded length <= input length + UTF-8 for \u).

# JSON string escapes -> bytes, in a fresh NUL-terminated buffer. The decoded
# length goes through `len_out`: a `\u0000` makes it longer than strlen.
fn _fs_unescape(src, len_out) {
    var n = strlen(src);
    var out = alloc(n + 1);
    store64(len_out, _jx_unescape_into(src, n, out));
    return out;
}

# ---- result builders ------------------------------------------------------

fn _fs_result(msg, is_err) {
    var sb = str_builder_new();
    var ml = strlen(msg);
    _sb_grow(sb, ml + ml / 8 + 96);
    str_builder_add_cstr(sb, "{\"content\":[{\"type\":\"text\",\"text\":\"");
    _json_emit_escaped(sb, msg);
    str_builder_add_cstr(sb, "\"}],\"isError\":");
    if (is_err == 1) { str_builder_add_cstr(sb, "true}"); }
    else { str_builder_add_cstr(sb, "false}"); }
    return str_data(str_builder_build(sb));
}

# A path the confinement check refused (3.4.0): a WARN line naming the tool
# and the path, then the error result. The path is client-supplied, so it
# goes through bote_log_str's escaping like any request-derived value.
fn _fs_refuse(tool, path, msg) {
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_WARN, "fs tool refused an unsafe path");
    bote_log_str(&ln, "tool", tool);
    bote_log_str(&ln, "path", path);
    bote_log_emit(&ln);
    return _fs_result(msg, 1);
}

fn _fs_ok(msg)  { return _fs_result(msg, 0); }
fn _fs_err(msg) { return _fs_result(msg, 1); }

# The `path` argument as the name it means: `caf\u00e9.txt` is café.txt. 0 when
# it is absent, or holds a NUL, which would end the name early.
fn _fs_arg_path(args) {
    var raw = jsonx_get_str(args, "path");
    if (raw == 0) { return 0; }
    var lslot[8];
    store64(&lslot, 0);
    var p = _fs_unescape(raw, &lslot);
    if (strlen(p) != load64(&lslot)) { return 0; }
    return p;
}

# 1 when the directory file_open just failed on with `fd` is simply not there.
# agnos answers -1 for every failure, so there the path is tried again following
# links: if that opens, the first open refused a link.
fn _fs_open_missing(path, fd) {
    #ifdef CYRIUS_TARGET_AGNOS
    var f = file_open(path, O_RDONLY, 0);
    if (f >= 0) {
        file_close(f);
        return 0;
    }
    return 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (fd == 0 - BOTE_ERRNO_ENOENT) { return 1; }
    return 0;
    #endif
}

# 1 when no directory on the way to `full`, below the root, is a symlink: a link
# already in the root must not carry a tool out of it. A directory that does not
# exist yet ends the walk, since nothing past it can be a link. No openat in the
# stdlib, so this checks by name, and a local writer racing it could still swap
# one in. No tool can create a symlink.
fn _fs_walk_ok(full) {
    var i = strlen(_fs_root()) + 1;
    var n = strlen(full);
    while (i < n) {
        if (load8(full + i) == 47) {
            store8(full + i, 0);
            var fd = file_open(full, O_RDONLY | O_DIRECTORY | O_NOFOLLOW, 0);
            var missing = 0;
            if (fd >= 0) { file_close(fd); }
            else { missing = _fs_open_missing(full, fd); }
            store8(full + i, 47);
            if (missing == 1) { return 1; }
            if (fd < 0) { return 0; }
        }
        i = i + 1;
    }
    return 1;
}

# ---- handlers -------------------------------------------------------------

# fs_write {path, content} -> writes content to <root>/<path> (parents mkdir'd).
fn fs_write_handler(args, claims) {
    var path = _fs_arg_path(args);
    if (_fs_path_unsafe(path) == 1) {
        return _fs_refuse("fs_write", path, "fs_write: refused unsafe path (must be relative, no '..')");
    }
    var raw = jsonx_get_str(args, "content");
    if (raw == 0) { raw = ""; }
    var lslot[8];
    store64(&lslot, 0);
    var data = _fs_unescape(raw, &lslot);
    var dlen = load64(&lslot);

    var full = _fs_join(path);
    if (_fs_walk_ok(full) == 0) {
        return _fs_refuse("fs_write", path, "fs_write: refused a path through a symlink");
    }
    _fs_mkparents(full, 0);
    # Atomic: a symlink at `full` is replaced rather than written through, a
    # FIFO cannot hang the server, and a failure leaves the old file whole.
    var wrote = file_write_atomic(full, data, dlen);
    if (wrote == 0) { wrote = dlen; }
    if (wrote < 0) {
        var sbe = str_builder_new();
        str_builder_add_cstr(sbe, "fs_write: failed to write ");
        str_builder_add_cstr(sbe, full);
        return _fs_err(str_data(str_builder_build(sbe)));
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "wrote ");
    str_builder_add_int(sb, wrote);
    str_builder_add_cstr(sb, " bytes to ");
    str_builder_add_cstr(sb, full);
    return _fs_ok(str_data(str_builder_build(sb)));
}

# fs_read {path} -> returns the (capped) file contents as a text block.
fn fs_read_handler(args, claims) {
    var path = _fs_arg_path(args);
    if (_fs_path_unsafe(path) == 1) {
        return _fs_refuse("fs_read", path, "fs_read: refused unsafe path (must be relative, no '..')");
    }
    var full = _fs_join(path);
    if (_fs_walk_ok(full) == 0) {
        return _fs_refuse("fs_read", path, "fs_read: refused a path through a symlink");
    }
    # On the request arena, which is the calling thread's (3.7.1): one buffer for the
    # process let two workers read into it at once, and hand a client another's file.
    # Released once the result, on the heap, is made of it (3.7.2).
    var mark[16];
    bote_req_mark(&mark);
    var res = _fs_read_into(alloc_via(bote_req_alloc(), FS_READ_CAP + FS_READ_NOTE), full);
    bote_req_release(&mark);
    return res;
}

# fs_read of the file `full`, read into `buf`: the tool's result.
fn _fs_read_into(buf, full) {
    # O_NONBLOCK: a FIFO with no writer would otherwise park this call, and with
    # it every client of the server.
    var fd = file_open(full, O_RDONLY | BOTE_O_NONBLOCK | O_NOFOLLOW, 0);
    var got = fd;
    if (fd >= 0) {
        got = 0;
        var more = 1;
        while (more == 1) {
            var n = file_read(fd, buf + got, FS_READ_CAP + 1 - got);
            if (n < 0) { got = n; more = 0; }
            elif (n == 0) { more = 0; }
            else {
                got = got + n;
                if (got > FS_READ_CAP) { more = 0; }
            }
        }
        file_close(fd);
    }
    if (got < 0) {
        var sbe = str_builder_new();
        str_builder_add_cstr(sbe, "fs_read: cannot read ");
        str_builder_add_cstr(sbe, full);
        return _fs_err(str_data(str_builder_build(sbe)));
    }
    var cut = 0;
    if (got > FS_READ_CAP) {
        cut = 1;
        got = FS_READ_CAP;
        # Not through the middle of a character.
        while (got > 0 && (load8(buf + got) & 192) == 128) { got = got - 1; }
    }
    var z = 0;
    while (z < got) {
        if (load8(buf + z) == 0) { return _fs_err("fs_read: a binary file (it holds a NUL byte)"); }
        z = z + 1;
    }
    store8(buf + got, 0);
    if (cut == 1) {
        # Silently short, a model writing this back would destroy the rest.
        memcpy(buf + got, "\n[fs_read: truncated]", 22);
    }
    return _fs_ok(buf);
}

# fs_mkdir {path} -> creates <root>/<path> (and any missing parents).
fn fs_mkdir_handler(args, claims) {
    var path = _fs_arg_path(args);
    if (_fs_path_unsafe(path) == 1) {
        return _fs_refuse("fs_mkdir", path, "fs_mkdir: refused unsafe path (must be relative, no '..')");
    }
    var full = _fs_join(path);
    if (_fs_walk_ok(full) == 0) {
        return _fs_refuse("fs_mkdir", path, "fs_mkdir: refused a path through a symlink");
    }
    _fs_mkparents(full, 1);
    # The answer is whether the directory is there now: over a file, or under
    # one, mkdir fails and this said "created" anyway.
    var dfd = file_open(full, O_RDONLY | O_DIRECTORY | O_NOFOLLOW, 0);
    if (dfd < 0) {
        var sbe = str_builder_new();
        str_builder_add_cstr(sbe, "fs_mkdir: cannot create ");
        str_builder_add_cstr(sbe, full);
        return _fs_err(str_data(str_builder_build(sbe)));
    }
    file_close(dfd);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "created directory ");
    str_builder_add_cstr(sb, full);
    return _fs_ok(str_data(str_builder_build(sb)));
}

# ---- registration ---------------------------------------------------------

# Register fs_write / fs_read / fs_mkdir on an existing dispatcher.
# Call after bote_dispatcher_with_echo() (see src/main.cyr).
# A one-property-or-two input schema: `path`, plus `content` when `with_content`.
# Both are required (3.4.10).
fn _fs_schema(with_content) {
    var props = vec_new();
    vec_push(props, schema_prop_new("path", "{\"type\":\"string\",\"description\":\"Path relative to the server root (BOTE_FS_ROOT). Absolute paths and '..' are refused.\"}"));
    var req = vec_new();
    vec_push(req, "path");
    if (with_content == 1) {
        vec_push(props, schema_prop_new("content", "{\"type\":\"string\",\"description\":\"UTF-8 text to write. It replaces the file.\"}"));
        vec_push(req, "content");
    }
    return schema_new("object", props, req);
}

fn fs_tools_register(dispatcher) {
    var reg = dispatcher_registry(dispatcher);
    # Real input schemas and annotations since 3.4.10. Through 3.4.9 these
    # registered {"type":"object"} with no properties, and fs_write wrote an
    # empty file when `content` was missing.
    var wann = ann_new();
    ann_set_read_only(wann, HINT_FALSE);
    ann_set_destructive(wann, HINT_TRUE);
    ann_set_idempotent(wann, HINT_TRUE);
    ann_set_open_world(wann, HINT_FALSE);
    registry_register(reg, tool_def_with_annotations(tool_def_new(
          "fs_write", "Write a UTF-8 text file under the server root, creating parent directories. Replaces an existing file.",
          _fs_schema(1)), wann));
    dispatcher_handle(dispatcher, "fs_write", &fs_write_handler);

    registry_register(reg, tool_def_with_annotations(tool_def_new(
          "fs_read", "Read a text file under the server root.",
          _fs_schema(0)), ann_read_only()));
    dispatcher_handle(dispatcher, "fs_read", &fs_read_handler);

    var mann = ann_new();
    ann_set_read_only(mann, HINT_FALSE);
    ann_set_destructive(mann, HINT_FALSE);
    ann_set_idempotent(mann, HINT_TRUE);
    ann_set_open_world(mann, HINT_FALSE);
    registry_register(reg, tool_def_with_annotations(tool_def_new(
          "fs_mkdir", "Create a directory under the server root, with any missing parents.",
          _fs_schema(0)), mann));
    dispatcher_handle(dispatcher, "fs_mkdir", &fs_mkdir_handler);

    return 0;
}

# --- web_tools.cyr ---

# web_tools — web MCP tools for the bote binary (web_fetch / web_search).
#
# Additive: registered on an existing dispatcher by web_tools_register(), called from src/main.cyr after
# bote_dispatcher_with_echo(). Mirrors the fs_tools_register() / libro_tools_register() idiom. daimon
# registers the same handlers as in-process builtins (mcp_web_init), so thoth reaches them through the
# spine (daimon MCP → t-ron) without reimplementing any of this.
#
# Results are MCP content blocks ({"content":[{"type":"text",...}],"isError":..}) so an MCP client (thoth)
# renders them directly. Outbound HTTP uses the sandhi client (same transport thoth's hoosh seam uses).
#
#   web_fetch  {url}            -> GET the url (http/https only), strip HTML to readable text, size-capped.
#   web_search {query, count?}  -> query a SearXNG JSON endpoint (BOTE_SEARXNG_URL, configurable, sovereign;
#                                  no third-party key) and return the top results (title · url · snippet).
#
# SECURITY: web_fetch only follows http:// / https:// (no file:, no other schemes), and since 3.4.0 refuses a
# URL that host.cyr's ssrf_check classifies as loopback / link-local / private / metadata / unspecified /
# multicast (IP literals and a hostname blocklist; no DNS resolution) — defense-in-depth beneath
# t-ron's per-tool authorization. web_search hits ONLY the operator-configured SearXNG base; absent config it
# degrades honestly (no silent default to a third party). Both are network reads; there is no write surface.

include "lib/bayan.cyr"

var WEB_FETCH_CAP = 65536;     # max bytes web_fetch returns (readable text)
var WEB_SEARCH_MAX = 10;       # hard ceiling on results returned
var WEB_BODY_CAP = 2097152;    # 2 MiB: the largest response read; a larger one fails the call
# The most one outbound request may take. Every client waits on it: the server
# handles one call at a time. 0 disables it. The binary reads BOTE_WEB_TIMEOUT_MS.
var BOTE_WEB_TIMEOUT_MS = 15000;

# ---- MCP result blocks (mirror _fs_result) --------------------------------
fn _web_result(msg, is_err) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"content\":[{\"type\":\"text\",\"text\":\"");
    _json_emit_escaped(sb, msg);
    str_builder_add_cstr(sb, "\"}],\"isError\":");
    if (is_err == 1) { str_builder_add_cstr(sb, "true}"); } else { str_builder_add_cstr(sb, "false}"); }
    return str_data(str_builder_build(sb));
}
fn _web_ok(msg)  { return _web_result(msg, 0); }
fn _web_err(msg) { return _web_result(msg, 1); }

# _web_starts_with: 1 if cstr `s` begins with cstr `prefix`. PURE (bote has no cstr_starts_with).
fn _web_starts_with(s, prefix) {
    var k = 0;
    while (load8(prefix + k) != 0) {
        if (load8(s + k) != load8(prefix + k)) { return 0; }
        k = k + 1;
    }
    return 1;
}
# _web_arg_number: read integer arg `key` from the JSON args (jsonx has no int getter); 0 if absent.
# Mirrors libro's _lt_get_int.
#
# 3.2.0: renamed from `_web_get_int`. cyrius treats a trailing `_int` / `_str` /
# `_cstr` on a function name as an overload-dispatch suffix, so `_web_get_int`
# occupied the `_int` slot of `_web_get` (below) while taking a different arity
# — the same latent landmine sakshi 2.4.7 defused in its own `_sk_write_int` /
# `_sk_write_str` pair. Dormant here (both `_web_get` call sites pass a cstr as
# arg 1), but the arity mismatch is what makes it a hazard, so the name goes.
fn _web_arg_number(args, key) {
    var raw = jsonx_get_raw(args, key);
    if (raw == 0) { return 0; }
    return _sch_parse_int(raw);
}
# _web_is_http: 1 if `url` begins with http:// or https:// (the only schemes web_fetch follows). PURE.
fn _web_is_http(url) {
    if (url == 0) { return 0; }
    if (_web_starts_with(url, "http://") == 1) { return 1; }
    if (_web_starts_with(url, "https://") == 1) { return 1; }
    return 0;
}

# ---- HTML -> readable text ------------------------------------------------
# _web_lc: ASCII-lowercase a byte.
fn _web_lc(b) { if ((b >= 65) && (b <= 90)) { return b + 32; } return b; }

# _web_tag_is: 1 if the bytes at src+i (just past a '<' or '</') spell tag `name` (lowercased), followed by a
# non-letter (so "script" matches <script>/<script src> but not <scripting>). PURE.
fn _web_tag_is(src, len, i, name) {
    var k = 0;
    while (load8(name + k) != 0) {
        if ((i + k) >= len) { return 0; }
        if (_web_lc(load8(src + i + k)) != load8(name + k)) { return 0; }
        k = k + 1;
    }
    var after = 0;
    if ((i + k) < len) { after = _web_lc(load8(src + i + k)); }
    if ((after >= 97) && (after <= 122)) { return 0; }   # a longer tag name -> not a match
    return 1;
}

# _web_skip_block: given `i` positioned just after "<script" / "<style" (the tag name), advance past the
# whole element to just after its closing "</script>" / "</style>". `close` is the lowercased close tag
# WITHOUT the '<' (e.g. "/script"). Returns the new index. PURE.
fn _web_skip_block(src, len, i, close) {
    while (i < len) {
        if (load8(src + i) == 60) {                       # '<'
            if (_web_tag_is(src, len, i + 1, close) == 1) {
                i = i + 1;
                while ((i < len) && (load8(src + i) != 62)) { i = i + 1; }   # to '>'
                if (i < len) { i = i + 1; }
                return i;
            }
        }
        i = i + 1;
    }
    return i;
}

# _web_emit: append byte `b` to dst at off, bounded by cap. Returns the new off.
fn _web_emit(dst, off, cap, b) {
    if (off < (cap - 1)) { store8(dst + off, b); off = off + 1; }
    return off;
}

# _web_html_to_text: strip HTML from src[0..len) into dst (cap), producing readable text — drops tags and the
# contents of <script>/<style>, decodes the common named/numeric entities, and collapses runs of whitespace
# to a single space (a blank line at block boundaries stays readable enough). Returns the text length.
fn _web_html_to_text(src, len, dst, cap) {
    var i = 0;
    var off = 0;
    var pend_space = 0;                                   # 1 if whitespace is pending (collapse runs)
    while ((i < len) && (off < (cap - 1))) {
        var b = load8(src + i);
        if (b == 60) {                                    # '<' -> a tag (or script/style block)
            if (_web_tag_is(src, len, i + 1, "script") == 1) { i = _web_skip_block(src, len, i + 1, "/script"); pend_space = 1; }
            elif (_web_tag_is(src, len, i + 1, "style") == 1) { i = _web_skip_block(src, len, i + 1, "/style"); pend_space = 1; }
            else {
                i = i + 1;
                while ((i < len) && (load8(src + i) != 62)) { i = i + 1; }   # skip to '>'
                if (i < len) { i = i + 1; }
                pend_space = 1;                           # a tag boundary is a word/space boundary
            }
        } elif (b == 38) {                                # '&' -> entity
            var ent = _web_decode_entity(src, len, i);    # returns (codebyte<<20 | consumed); 0 = not an entity
            if (ent != 0) {
                var eb = ent / 1048576;
                if ((eb == 32) || (eb == 9) || (eb == 10) || (eb == 13)) { pend_space = 1; }   # nbsp etc. -> collapsible whitespace
                elif ((eb < 32) || (eb == 127)) { }   # a control-byte entity (&#12; etc.) -> drop (see below)
                else {
                    if (pend_space == 1) { if (off > 0) { off = _web_emit(dst, off, cap, 32); } pend_space = 0; }
                    # &#233; is a code point, not a byte: two of them in UTF-8.
                    if (eb >= 128) {
                        off = _web_emit(dst, off, cap, 192 + (eb / 64));
                        off = _web_emit(dst, off, cap, 128 + (eb % 64));
                    } else {
                        off = _web_emit(dst, off, cap, eb);
                    }
                }
                i = i + (ent % 1048576);
            } else {
                if (pend_space == 1) { if (off > 0) { off = _web_emit(dst, off, cap, 32); } pend_space = 0; }
                off = _web_emit(dst, off, cap, 38); i = i + 1;
            }
        } elif ((b == 32) || (b == 9) || (b == 10) || (b == 13)) {   # whitespace -> collapse
            pend_space = 1; i = i + 1;
        } elif ((b < 32) || (b == 127)) {   # untrusted-page C0 control byte / NUL / DEL -> DROP: readable text
            i = i + 1;                       # has none, and it keeps the output valid JSON downstream (the shared
            # escaper doesn't \u-escape control bytes, and a raw NUL would truncate it)
        } else {
            if (pend_space == 1) { if (off > 0) { off = _web_emit(dst, off, cap, 32); } pend_space = 0; }
            off = _web_emit(dst, off, cap, b); i = i + 1;
        }
    }
    store8(dst + off, 0);
    return off;
}

# _web_decode_entity: at src+i (an '&'), decode a supported entity. Returns (decoded_byte << 20) | consumed,
# or 0 if not a recognized entity. Supports &amp; &lt; &gt; &quot; &#39; &apos; &nbsp; and &#<dec>; (< 256).
fn _web_decode_entity(src, len, i) {
    if (_web_ent_is(src, len, i, "&amp;")  == 1) { return (38  * 1048576) + 5; }
    if (_web_ent_is(src, len, i, "&lt;")   == 1) { return (60  * 1048576) + 4; }
    if (_web_ent_is(src, len, i, "&gt;")   == 1) { return (62  * 1048576) + 4; }
    if (_web_ent_is(src, len, i, "&quot;") == 1) { return (34  * 1048576) + 6; }
    if (_web_ent_is(src, len, i, "&apos;") == 1) { return (39  * 1048576) + 6; }
    if (_web_ent_is(src, len, i, "&#39;")  == 1) { return (39  * 1048576) + 5; }
    if (_web_ent_is(src, len, i, "&nbsp;") == 1) { return (32  * 1048576) + 6; }
    if ((i + 2) < len) {                                  # &#<dec>;  -> a byte if < 256
        if ((load8(src + i + 1) == 35) && (load8(src + i + 2) >= 48) && (load8(src + i + 2) <= 57)) {
            var v = 0; var j = i + 2; var d = 0;
            while ((j < len) && (load8(src + j) >= 48) && (load8(src + j) <= 57) && (d < 4)) { v = v * 10 + (load8(src + j) - 48); j = j + 1; d = d + 1; }
            if ((j < len) && (load8(src + j) == 59) && (v > 0) && (v < 256)) { return (v * 1048576) + ((j - i) + 1); }
        }
    }
    return 0;
}
fn _web_ent_is(src, len, i, lit) {
    var k = 0;
    while (load8(lit + k) != 0) {
        if ((i + k) >= len) { return 0; }
        if (load8(src + i + k) != load8(lit + k)) { return 0; }
        k = k + 1;
    }
    return 1;
}

# ---- url-encode (for the search query) ------------------------------------
# _web_urlencode: percent-encode `s` into dst (cap): unreserved chars pass; everything else -> %XX. Returns len.
fn _web_urlencode(s, dst, cap) {
    var hex = "0123456789ABCDEF";
    var i = 0; var off = 0;
    while ((load8(s + i) != 0) && (off < (cap - 4))) {
        var b = load8(s + i);
        var unreserved = 0;
        if ((b >= 48) && (b <= 57)) { unreserved = 1; }         # 0-9
        if ((b >= 65) && (b <= 90)) { unreserved = 1; }         # A-Z
        if ((b >= 97) && (b <= 122)) { unreserved = 1; }        # a-z
        if ((b == 45) || (b == 95) || (b == 46) || (b == 126)) { unreserved = 1; }   # - _ . ~
        if (unreserved == 1) { store8(dst + off, b); off = off + 1; }
        else {
            store8(dst + off, 37); off = off + 1;               # '%'
            store8(dst + off, load8(hex + ((b / 16) % 16))); off = off + 1;
            store8(dst + off, load8(hex + (b % 16))); off = off + 1;
        }
        i = i + 1;
    }
    store8(dst + off, 0);
    return off;
}

# ---- outbound GET (shared) ------------------------------------------------
# _web_get: GET `url`, returning the sandhi response handle, or 0 on a transport failure (caller reports). A
# browser-ish User-Agent is sent (some hosts / SearXNG reject an empty UA).
fn _web_get(url) {
    var h = sandhi_headers_new();
    sandhi_headers_set(h, "User-Agent", "bote-web/1.0 (AGNOS)");
    sandhi_headers_set(h, "Accept", "*/*");
    var o = sandhi_http_options_new_a(bote_req_alloc());
    sandhi_http_options_connect_ms(o, BOTE_WEB_TIMEOUT_MS);
    sandhi_http_options_read_ms(o, BOTE_WEB_TIMEOUT_MS);
    sandhi_http_options_write_ms(o, BOTE_WEB_TIMEOUT_MS);
    sandhi_http_options_total_ms(o, BOTE_WEB_TIMEOUT_MS);
    sandhi_http_options_max_response_bytes(o, WEB_BODY_CAP);
    var r = sandhi_http_get_opts_a(bote_req_alloc(), url, h, o);
    if (sandhi_http_err_kind(r) != SANDHI_OK) { return 0; }
    return r;
}

# ---- resolved-address SSRF guard (3.4.4) ----------------------------------
# ssrf_check (host.cyr) judges the URL's host *string*: IP literals and a
# hostname blocklist. It cannot see where a name points, so a name whose A
# record is 127.0.0.1 (`127.0.0.1.nip.io`, or an attacker's own zone) passed
# it and web_fetch connected inside. sandhi 1.9.14's client resolve hook
# (`sandhi_client_set_resolver`, filed by bote 3.3.7) closes that: the hook
# decides the address sandhi connects to, so classifying THERE leaves no
# window between the check and the connect (DNS rebinding), and it fires for
# literals and on every redirect hop too.
#
# The hook is installed only for the duration of web_fetch's request and the
# previous one is restored afterwards, so web_search (whose endpoint is the
# operator's BOTE_SEARXNG_URL, often on localhost) and any other sandhi
# client in an embedding process keep their own resolution. If an embedder
# had a hook installed, the guard resolves through it and classifies what it
# returns, so the two policies compose. Process-wide while installed:
# correct for today's single-threaded dispatch; the 3.5.x worker threads
# must make this per-thread.
#
# The embedder's hook is read from sandhi's private
# `_sandhi_client_resolver_fn` / `_ctx` (sandhi exposes only an installed
# 0/1). A rename there fails bote's build, not the guard.

var _web_prev_fn = 0;
var _web_prev_ctx = 0;
var _web_refused = 0;            # SSRF_* code of the refusal, 0 when none
var _web_refused_host = 0;
var _web_refused_addr = 0;

# 1 when `host` is an IPv6 literal (contains ':'). sandhi's stock resolver
# cannot dial those (it would send an AAAA query for the text), and the URL
# pre-check has already classified them.
fn _web_host_is_v6_literal(host) {
    var i = 0;
    while (load8(host + i) != 0) {
        if (load8(host + i) == 58) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn _web_refuse(code, host, addr_text) {
    _web_refused = code;
    _web_refused_host = host;
    _web_refused_addr = addr_text;
    return 0;
}

# The resolve hook: lookup(ctx, host, family) per sandhi's contract. IPv4:
# a packed address, or (0 - 1) for none / refused (sandhi then asks IPv6).
# IPv6: a pointer to 16 bytes, or 0 for none / refused.
fn _web_ssrf_resolve(ctx, host, family) {
    if (family == SANDHI_RESOLVE_V4) {
        var addr = 0 - 1;
        if (_web_prev_fn != 0) {
            addr = fncall3(_web_prev_fn, _web_prev_ctx, host, family);
        } elif (_web_host_is_v6_literal(host) == 0) {
            addr = sandhi_net_parse_ipv4(host);
            if (addr == 0 - 1) { addr = sandhi_resolve_ipv4(host); }
        }
        if (addr == 0 || addr == 0 - 1) { return 0 - 1; }
        var c4 = ssrf_classify_ipv4_addr(addr);
        if (c4 != SSRF_OK) {
            _web_refuse(c4, host, ssrf_ipv4_addr_str(addr));
            return 0 - 1;
        }
        return addr;
    }
    # IPv6 is asked only after IPv4 gave nothing. A name already refused on
    # IPv4 is refused here too: one suspicious answer condemns the name.
    if (_web_refused != 0) { return 0; }
    var p = 0;
    if (_web_prev_fn != 0) {
        p = fncall3(_web_prev_fn, _web_prev_ctx, host, family);
    } elif (_web_host_is_v6_literal(host) == 0) {
        p = sandhi_resolve_ipv6(host);
    }
    if (p == 0) { return 0; }
    var c6 = ssrf_classify_ipv6_bytes(p);
    if (c6 != SSRF_OK) {
        _web_refuse(c6, host, ssrf_ipv6_bytes_str(p));
        return 0;
    }
    return p;
}

# GET `url` with the guard installed, then restore the previous hook.
fn _web_get_guarded(url) {
    _web_refused = 0;
    _web_refused_host = 0;
    _web_refused_addr = 0;
    _web_prev_fn = _sandhi_client_resolver_fn;
    _web_prev_ctx = _sandhi_client_resolver_ctx;
    # Never chain to ourselves: if the guard's own hook were somehow still
    # installed (a restore that did not run), resolving through it would
    # recurse until the stack ran out. Measured: a mutant that skips the
    # restore dies with SIGSEGV on the next fetch without this line.
    if (_web_prev_fn == &_web_ssrf_resolve) { _web_prev_fn = 0; _web_prev_ctx = 0; }
    sandhi_client_set_resolver(&_web_ssrf_resolve, 0);
    var r = _web_get(url);
    if (_web_prev_fn == 0) { sandhi_client_clear_resolver(); }
    else { sandhi_client_set_resolver(_web_prev_fn, _web_prev_ctx); }
    _web_prev_fn = 0;
    _web_prev_ctx = 0;
    return r;
}

# ---- in a child (3.6.5) ---------------------------------------------------
# Each tool's request, and what it makes of the reply, runs in a child (src/fetch.cyr):
# sandhi keeps about 175 KB on the heap for every https:// request, and a child takes it
# away when it exits. The child answers with a record, and the parent logs and builds the
# result from it, so the guard's refusal is logged here as it always was.

# What a request that did not finish says, as a WARN naming why; a TRACE for one its
# client cancelled (3.7.5), which the request's own line reports.
fn _web_child_failed(tool) {
    var lvl = SK_WARN;
    if (bote_req_was_cancelled() == 1) { lvl = SK_TRACE; }
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, lvl, "outbound request did not finish");
    bote_log_str(&ln, "tool", tool);
    bote_log_str(&ln, "reason", bote_fetch_why());
    bote_log_emit(&ln);
    return 0;
}

# web_fetch's child: the guarded GET of `url`, then its readable text. The record: the
# guard's refusal code, host and address; the status, -1 when the request failed; the text,
# or 0 when the status is no 2xx.
fn _web_fetch_child(url, rec) {
    var r = _web_get_guarded(url);
    bote_fetch_put_int(rec, _web_refused);
    bote_fetch_put_str(rec, _web_refused_host);
    bote_fetch_put_str(rec, _web_refused_addr);
    if (r == 0) { return bote_fetch_put_int(rec, 0 - 1); }
    var status = sandhi_http_status(r);
    bote_fetch_put_int(rec, status);
    if ((status < 200) || (status >= 300)) { return bote_fetch_put_str(rec, 0); }
    var blen = sandhi_http_body_len(r);
    if (blen > WEB_BODY_CAP) { blen = WEB_BODY_CAP; }
    var out = alloc_via(bote_req_alloc(), WEB_FETCH_CAP + 1);
    _web_html_to_text(sandhi_http_body(r), blen, out, WEB_FETCH_CAP);
    return bote_fetch_put_str(rec, out);
}

# ---- web_fetch ------------------------------------------------------------
# web_fetch {url} -> readable text of the page. http/https only; HTML stripped; capped at WEB_FETCH_CAP.
fn web_fetch_handler(args, claims) {
    # On the request arena: a refused call, and a long URL, keep none of it (3.6.6).
    var url = jsonx_get_str_a(bote_req_alloc(), args, "url");
    if (url == 0) { return _web_err("web_fetch: missing 'url'"); }
    if (_web_is_http(url) == 0) { return _web_err("web_fetch: only http:// and https:// URLs are allowed"); }
    # 3.4.0: the SSRF guard SECURITY.md has always promised for outbound
    # requests. web_fetch is bote's one fetch of a CLIENT-supplied URL, and it
    # never called ssrf_check, so a client could read loopback services and
    # the cloud metadata endpoint through it. The guard classifies IP
    # literals and a hostname blocklist; it does not resolve DNS. What a name
    # resolves to is judged in the child, by the resolve hook (3.4.4, above).
    # web_search's endpoint is operator-configured (BOTE_SEARXNG_URL, often
    # on localhost) and is deliberately NOT guarded.
    var sc = ssrf_check(url);
    if (sc != SSRF_OK) {
        var ln[BOTE_LOG_LINE_BYTES];
        bote_log_line(&ln, SK_WARN, "web_fetch refused by the SSRF guard");
        bote_log_str(&ln, "reason", ssrf_reason(sc));
        bote_log_str(&ln, "host", ssrf_host(url));
        bote_log_emit(&ln);
        var sbr = str_builder_new();
        str_builder_add_cstr(sbr, "web_fetch: refused (SSRF guard: ");
        str_builder_add_cstr(sbr, ssrf_reason(sc));
        str_builder_add_cstr(sbr, ")");
        return _web_err(str_data(str_builder_build(sbr)));
    }
    var cur[24];
    if (bote_fetch_in_child(&_web_fetch_child, url, WEB_FETCH_CAP + 2 * strlen(url) + 256, BOTE_WEB_TIMEOUT_MS, &cur) == 0) {
        _web_child_failed("web_fetch");
        return _web_err("web_fetch: could not reach the URL (transport error)");
    }
    return _web_fetch_result(&cur);
}

# web_fetch's result from its child's record.
fn _web_fetch_result(cur) {
    var refused = bote_fetch_int(cur);
    var rhost = bote_fetch_str(cur, 0);
    var raddr = bote_fetch_str(cur, 0);
    var status = bote_fetch_int(cur);
    var text = bote_fetch_str(cur, 0);
    if (status == 0 - 1 && refused != 0) {
        # The name resolved to an address the guard refused (3.4.4).
        var gl[BOTE_LOG_LINE_BYTES];
        bote_log_line(&gl, SK_WARN, "web_fetch refused by the SSRF guard (resolved address)");
        bote_log_str(&gl, "reason", ssrf_reason(refused));
        bote_log_str(&gl, "host", rhost);
        bote_log_str(&gl, "addr", raddr);
        bote_log_emit(&gl);
        var sbg = str_builder_new();
        str_builder_add_cstr(sbg, "web_fetch: refused (SSRF guard: ");
        str_builder_add_cstr(sbg, ssrf_reason(refused));
        str_builder_add_cstr(sbg, ", resolved address)");
        return _web_err(str_data(str_builder_build(sbg)));
    }
    if (status == 0 - 1) { return _web_err("web_fetch: could not reach the URL (transport error)"); }
    if ((status < 200) || (status >= 300)) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "web_fetch: HTTP ");
        str_builder_add_int(sb, status);
        return _web_err(str_data(str_builder_build(sb)));
    }
    if (text == 0 || load8(text) == 0) { return _web_ok("(the page returned no readable text)"); }
    return _web_ok(text);
}

# ---- web_search -----------------------------------------------------------
# _web_searxng_base: the configured SearXNG base URL (BOTE_SEARXNG_URL), or 0 if unset (degrade honestly).
fn _web_searxng_base() {
    var b = getenv("BOTE_SEARXNG_URL");
    if (b == 0) { return 0; }
    if (load8(b) == 0) { return 0; }
    return b;
}

# What web_search's child found, the record's first int.
var WEB_SEARCH_DONE = 0;
var WEB_SEARCH_UNREACHED = 1;
var WEB_SEARCH_STATUS = 2;
var WEB_SEARCH_UNPARSED = 3;
var WEB_SEARCH_NO_RESULTS = 4;

# web_search's child: `ctx` is {query, base, count}. The record: what it found, then the
# status for WEB_SEARCH_STATUS, or the results' text, 0 for none, for WEB_SEARCH_DONE.
fn _web_search_child(ctx, rec) {
    var q = load64(ctx);
    var base = load64(ctx + 8);
    var count = load64(ctx + 16);

    # build <base>/search?q=<enc>&format=json  (trim one trailing '/' on the base)
    var bl = strlen(base);
    if ((bl > 0) && (load8(base + bl - 1) == 47)) { bl = bl - 1; }
    var enc = alloc(strlen(q) * 3 + 4);
    _web_urlencode(q, enc, strlen(q) * 3 + 4);
    var sbu = str_builder_new();
    var bi = 0; while (bi < bl) { str_builder_add_byte(sbu, load8(base + bi)); bi = bi + 1; }
    str_builder_add_cstr(sbu, "/search?q=");
    str_builder_add_cstr(sbu, enc);
    str_builder_add_cstr(sbu, "&format=json");
    var url = str_data(str_builder_build(sbu));

    var r = _web_get(url);
    if (r == 0) { return bote_fetch_put_int(rec, WEB_SEARCH_UNREACHED); }
    var status = sandhi_http_status(r);
    if ((status < 200) || (status >= 300)) {
        bote_fetch_put_int(rec, WEB_SEARCH_STATUS);
        return bote_fetch_put_int(rec, status);
    }
    # parse {"results":[{title,url,content},...]} with bayan
    # 3.2.0: bayan 1.3.0 (folded into cyrius 6.5.1) renamed the buf+len typed
    # parser `bayan_json_v_parse_str` -> `bayan_json_v_parse_buf`. Same (buf,
    # len) signature and semantics; the old name no longer exists, so building
    # against the 6.5.x stdlib failed with `refusing to emit binary with 1
    # reachable undefined function(s)`.
    var v = bayan_json_v_parse_buf(sandhi_http_body(r), sandhi_http_body_len(r));
    if (v == 0) { return bote_fetch_put_int(rec, WEB_SEARCH_UNPARSED); }
    var results = bayan_json_v_obj_get_by_cstr(v, "results");
    if (results == 0) { return bote_fetch_put_int(rec, WEB_SEARCH_NO_RESULTS); }
    var n = bayan_json_v_arr_len(results);
    var sb = str_builder_new();
    var shown = 0;
    var i = 0;
    while ((i < n) && (shown < count)) {
        var item = bayan_json_v_arr_get(results, i);
        var title = _web_json_field(item, "title");
        var link = _web_json_field(item, "url");
        var snip = _web_json_field(item, "content");
        if (link != 0) {
            str_builder_add_int(sb, shown + 1);
            str_builder_add_cstr(sb, ". ");
            if (title != 0) { str_builder_add_cstr(sb, title); }
            str_builder_add_cstr(sb, "\n   ");
            str_builder_add_cstr(sb, link);
            if (snip != 0) { str_builder_add_cstr(sb, "\n   "); str_builder_add_cstr(sb, snip); }
            str_builder_add_cstr(sb, "\n\n");
            shown = shown + 1;
        }
        i = i + 1;
    }
    bote_fetch_put_int(rec, WEB_SEARCH_DONE);
    if (shown == 0) { return bote_fetch_put_str(rec, 0); }
    return bote_fetch_put_str(rec, str_data(str_builder_build(sb)));
}

# web_search {query, count?} -> the top results from the configured SearXNG (title · url · snippet). Sovereign:
# no third-party key, no silent default — an unconfigured endpoint is reported, not faked.
fn web_search_handler(args, claims) {
    var q = jsonx_get_str_a(bote_req_alloc(), args, "query");
    if (q == 0) { return _web_err("web_search: missing 'query'"); }
    var base = _web_searxng_base();
    if (base == 0) { return _web_err("web_search: no search backend configured (set BOTE_SEARXNG_URL to a SearXNG instance)"); }
    var count = _web_arg_number(args, "count");
    if (count <= 0) { count = 5; }
    if (count > WEB_SEARCH_MAX) { count = WEB_SEARCH_MAX; }
    var ctx[24];
    store64(&ctx, q);
    store64(&ctx + 8, base);
    store64(&ctx + 16, count);
    var cur[24];
    if (bote_fetch_in_child(&_web_search_child, &ctx, WEB_BODY_CAP + 4096, BOTE_WEB_TIMEOUT_MS, &cur) == 0) {
        _web_child_failed("web_search");
        return _web_err("web_search: could not reach the SearXNG endpoint (transport error)");
    }
    return _web_search_result(&cur);
}

# web_search's result from its child's record.
fn _web_search_result(cur) {
    var found = bote_fetch_int(cur);
    if (found == WEB_SEARCH_UNREACHED) { return _web_err("web_search: could not reach the SearXNG endpoint (transport error)"); }
    if (found == WEB_SEARCH_STATUS) {
        var sbe = str_builder_new();
        str_builder_add_cstr(sbe, "web_search: SearXNG returned HTTP ");
        str_builder_add_int(sbe, bote_fetch_int(cur));
        return _web_err(str_data(str_builder_build(sbe)));
    }
    if (found == WEB_SEARCH_UNPARSED) { return _web_err("web_search: could not parse the SearXNG response"); }
    if (found == WEB_SEARCH_NO_RESULTS) { return _web_err("web_search: SearXNG response had no results array"); }
    var text = bote_fetch_str(cur, 0);
    if (text == 0) { return _web_ok("(no results)"); }
    return _web_ok(text);
}

# _web_json_field: the cstr value of string field `key` on bayan object value `item`, or 0.
fn _web_json_field(item, key) {
    if (item == 0) { return 0; }
    var f = bayan_json_v_obj_get_by_cstr(item, key);
    if (f == 0) { return 0; }
    var s = bayan_json_v_str(f);
    if (s == 0) { return 0; }
    return str_cstr(s);
}

# ---- registration ---------------------------------------------------------
# Register web_fetch / web_search on an existing dispatcher. Call after bote_dispatcher_with_echo().
fn web_tools_register(dispatcher) {
    var reg = dispatcher_registry(dispatcher);
    # Real input schemas and annotations since 3.4.10 (both registered
    # {"type":"object"} with no properties before). Both reach the outside
    # world and change nothing, so they are read-only and open-world.
    var fprops = vec_new();
    vec_push(fprops, schema_prop_new("url", "{\"type\":\"string\",\"description\":\"An http:// or https:// URL. Loopback, private, link-local, shared and reserved addresses are refused, whether written literally or resolved from a name.\"}"));
    var freq = vec_new();
    vec_push(freq, "url");
    registry_register(reg, tool_def_with_annotations(tool_def_new(
          "web_fetch", "Fetch a web page and return its readable text, size-capped.",
          schema_new("object", fprops, freq)), ann_set_open_world(ann_read_only(), HINT_TRUE)));
    dispatcher_handle(dispatcher, "web_fetch", &web_fetch_handler);

    var sprops = vec_new();
    vec_push(sprops, schema_prop_new("query", "{\"type\":\"string\",\"description\":\"Search terms.\"}"));
    vec_push(sprops, schema_prop_new("count", "{\"type\":\"integer\",\"description\":\"How many results to return, 1 to 10 (default 5). A value outside that range is clamped into it.\"}"));
    var sreq = vec_new();
    vec_push(sreq, "query");
    registry_register(reg, tool_def_with_annotations(tool_def_new(
          "web_search", "Search the web through the configured SearXNG instance and return the top results (title, URL, snippet).",
          schema_new("object", sprops, sreq)), ann_set_open_world(ann_read_only(), HINT_TRUE)));
    dispatcher_handle(dispatcher, "web_search", &web_search_handler);

    return 0;
}
