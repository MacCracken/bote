# bote::dispatch — JSON-RPC tool dispatcher
# Mirrors rust-old/src/dispatch.rs (sync path; streaming/audit/events deferred)
#
# Requires (entry point includes):
#   string, fmt, alloc, vec, str, hashmap, fnptr,
#   src/error.cyr, src/protocol.cyr, src/registry.cyr, src/jsonx.cyr

# ================================================================
# Supported MCP protocol versions
# ================================================================
#
# ⚠ THE ONE LIST. `session.cyr`'s `validate_protocol_version` — which is
# what the HTTP-family transports run the `MCP-Protocol-Version` header
# through — delegates here rather than carrying its own copy. It used to
# carry one, and the two drifted: both listed the same three versions, so
# adding a fourth to either alone produced a server that negotiates a
# version over stdio and 400s the same version over HTTP. Adding a version
# is one line, here.
#
# `2025-06-18` retired JSON-RPC batching from the spec. bote still accepts
# batch arrays on every version — a superset is harmless to a client that
# never sends one — so the revision needs no behavioural branch.

fn _mcp_is_supported(v) {
    if (v == 0) { return 0; }
    if (streq(v, "2024-11-05") == 1) { return 1; }
    if (streq(v, "2025-03-26") == 1) { return 1; }
    if (streq(v, "2025-06-18") == 1) { return 1; }
    if (streq(v, "2025-11-25") == 1) { return 1; }
    return 0;
}

# The newest revision `initialize` negotiates. 2026-07-28 has no `initialize`, so
# it is not on this list: a client offering it there gets legacy semantics.
fn _mcp_latest_version() { return "2025-11-25"; }

# The stateless revision (3.5.0). A request says which revision it is, in its own
# `_meta`, and nothing carries over from the one before it.
fn _mcp_is_modern(v) {
    if (v == 0) { return 0; }
    if (streq(v, "2026-07-28") == 1) { return 1; }
    return 0;
}

# Every revision bote serves, newest first, as a JSON array.
fn _mcp_emit_versions(sb) {
    str_builder_add_cstr(sb, "[\"2026-07-28\",\"2025-11-25\",\"2025-06-18\",\"2025-03-26\",\"2024-11-05\"]");
    return 0;
}

fn _bote_server_version() { return "3.8.14"; }

# ================================================================
# Tool name validation
# ================================================================
#
# Returns 0 if `name` may name a tool, else a BoteError. The spec's rule (3.8.7): 1 to 128
# characters from A-Z a-z 0-9 _ - . (MCP 2025-11-25, "Tool names"), which registration holds
# every definition to (`registry_check_tool_def`). Through 3.8.6 this also required an
# underscore (bote's project_tool convention) and refused - and ., so `dispatcher_register_tool`
# refused names the spec allows, and allowed up to 256 characters, which registration refused.
fn validate_tool_name(name) {
    if (_reg_name_ok(name) == 1) { return 0; }
    var shown = "";
    if (name != 0) { shown = name; }
    return bote_err_new(BOTE_ERR_INVALID_PARAMS, shown, "the tool name must be 1-128 characters from A-Z a-z 0-9 _ - .");
}

# ================================================================
# Dispatcher struct (216 bytes):
#   +0  registry            ptr
#   +8  handlers            hashmap: name_cstr -> fn ptr (sync handler)
#   +16 streaming_handlers  hashmap: name_cstr -> fn ptr (reserved for v1.3)
#   +24 audit_sink          AuditSink ptr or 0 (no-op when 0)
#   +32 event_sink          EventSink ptr or 0 (no-op when 0)
#   +40 prompt_registry     PromptRegistry ptr or 0 (prompts capability off
#                           when 0; created lazily by dispatcher_register_prompt)
#   +48 resource_registry   ResourceRegistry ptr or 0 (resources capability off
#                           when 0; created lazily by dispatcher_register_resource)
#   +56 completion_handler  fn ptr or 0 (completions capability off when 0;
#                           set via dispatcher_set_completion)
#   +64 notifications        0/1 — 1 when the server has a working server→client
#                           notification path (a transport that drains
#                           list_changed to clients). Gates the `listChanged`
#                           sub-capabilities. Set by the transport wiring, NOT
#                           in core: only a transport with a drain path
#                           (streamable) may advertise listChanged; stdio/http/
#                           ws must not promise notifications they can't deliver.
# ================================================================

#   +72 server_name           cstr — the `serverInfo.name` this dispatcher
#                           advertises at initialize, or 0 for bote's own.
#   +80 server_version        cstr — the matching `serverInfo.version`, or 0.
#                           Set together via dispatcher_set_server_info.
#   +88 scope_check           fn ptr (claims, scope, ctx) → 1 when held, or 0.
#   +96 scope_ctx             passed to it. Set via dispatcher_set_scope_check.
#   +104 listen               what carries `subscriptions/listen` streams (3.7.2): a
#                           ListenHub (src/listen.cyr), opaque here, or 0, when the
#                           method is not served. Set by the transport wiring.
#   +112 server_title        cstr or 0 \
#   +120 server_description  cstr or 0  | serverInfo's other fields (3.8.1), set
#   +128 server_website      cstr or 0  | together via dispatcher_set_server_details
#   +136 server_icons        vec of Icon or 0 /
#   +144 instructions        cstr or 0 (3.8.1, dispatcher_set_instructions)
#   +152 instructions_json   `,"instructions":"…"`, escaped when set, or 0
#   +160 server_info_full    serverInfo's JSON, every field, built when any is set, or 0
#   +168 server_info_short   the same with name, version and title only, or 0
#   +176 state_seal          (3.8.2) fn(ctx, a, binding, payload) → the sealed requestState
#   +184 state_open          fn(ctx, a, binding, state) → the payload, or 0 when it fails
#   +192 state_ctx           their context; dispatcher_set_state_sealer sets all three
#   +200 state_principal     (3.8.3) fn(ctx, a, claims) → who the claims name, or 0
#   +208 state_principal_ctx its context; dispatcher_set_state_principal sets both
fn dispatcher_new(reg) {
    var d = alloc(216);
    store64(d, reg);
    store64(d + 8, map_new());
    store64(d + 16, map_new());
    store64(d + 24, 0);
    store64(d + 32, 0);
    store64(d + 40, 0);
    store64(d + 48, 0);
    store64(d + 56, 0);
    store64(d + 64, 0);
    store64(d + 72, 0);
    store64(d + 80, 0);
    store64(d + 88, 0);
    store64(d + 96, 0);
    store64(d + 104, 0);
    var k = 112;
    while (k < 216) { store64(d + k, 0); k = k + 8; }
    return d;
}

# What seals and opens the `requestState` of an InputRequiredResult (3.8.2). The spec makes
# a client's requestState attacker-controlled input, and a server MUST protect its
# integrity where it can matter, so bote seals every state a handler gives it and opens
# every one a client brings back, binding each to the request it was made for and who made
# it (_dsp_state_binding_a). With no sealer, a handler's state is refused and so is a
# client's: none can be trusted. The full bundle has one, HMAC-SHA256 with an expiry
# (src/state_seal.cyr). Set before serving.
fn dispatcher_set_state_sealer(d, seal_fp, open_fp, ctx) {
    store64(d + 176, seal_fp);
    store64(d + 184, open_fp);
    store64(d + 192, ctx);
    return d;
}

# Who a request's claims name, for the binding of its requestState (3.8.3): the spec binds a
# state to the principal. `fp(ctx, a, claims)` gives a cstr naming them, on `a` or for
# good, or 0 when the claims name no one, and is asked only for claims that are not 0. With
# none set, or when it gives 0, a state is bound to the token the request presented, which
# a token refreshed between rounds does not match; and a request whose claims are not that
# token (a validator that returns a record, a transport that passes its own) can be bound to
# no one, so its handler's state is refused, and so is a state it brings. The full bundle's
# jwt_state_principal names a JWT's issuer and subject.
fn dispatcher_set_state_principal(d, fp, ctx) {
    store64(d + 200, fp);
    store64(d + 208, ctx);
    return d;
}

fn dispatcher_registry(d)   { return load64(d); }
fn dispatcher_handlers(d)   { return load64(d + 8); }
fn dispatcher_streaming(d)  { return load64(d + 16); }
fn dispatcher_audit_sink(d) { return load64(d + 24); }
fn dispatcher_event_sink(d) { return load64(d + 32); }
fn dispatcher_prompts(d)    { return load64(d + 40); }
fn dispatcher_resources(d)  { return load64(d + 48); }
fn dispatcher_completion(d) { return load64(d + 56); }
fn dispatcher_notifications(d) { return load64(d + 64); }

fn dispatcher_server_name(d)    { return load64(d + 72); }
fn dispatcher_server_version(d) { return load64(d + 80); }

# Set the `serverInfo` this dispatcher advertises at `initialize`.
#
# **A dispatcher embedded in another product must not introduce itself as
# "bote".** Before 3.3.0 `_build_initialize_result` hardcoded
# `"serverInfo":{"name":"bote"}`, so every consumer's MCP clients saw bote's
# identity and bote's version rather than the host application's — which is
# wrong for every downstream, and for a host whose own oracle emits its own name
# it is a wire divergence with no workaround short of hand-rolling the envelope.
#
# Both arguments are cstrs. Passing 0 for either keeps bote's own value for that
# field, so `dispatcher_set_server_info(d, "agnosai", 0)` renames the server and
# keeps bote's version. Unset (the default) is byte-identical to pre-3.3.0.
fn dispatcher_set_server_info(d, name, version) {
    store64(d + 72, name);
    store64(d + 80, version);
    _dsp_server_info_build(d);
    return d;
}

fn dispatcher_server_title(d)       { return load64(d + 112); }
fn dispatcher_server_description(d) { return load64(d + 120); }
fn dispatcher_server_website(d)     { return load64(d + 128); }
fn dispatcher_server_icons(d)       { return load64(d + 136); }
fn dispatcher_instructions(d)       { return load64(d + 144); }

# The rest of `serverInfo` (3.8.1, the spec's Implementation): a title for people, a
# description, the website's URL and icons, each 0 for none. Returns 0, or a BoteError,
# with nothing set, when the URL is no http:// or https:// URL, or an icon is not what the
# spec says (bote_icons_check). Set before serving: what is sent is
# built here, once.
#
# `initialize` and `server/discover` send every field. Every other 2026-07-28 result
# carries serverInfo in its `_meta` too, and sends the name, the version and the title
# only, so that an icon, which may be a data: URI of some kilobytes, is not in every reply.
fn dispatcher_set_server_details(d, title, description, website_url, icons) {
    var why = bote_display_check(title, icons);
    if (why == 0 && website_url != 0 && bote_web_url_ok(website_url) == 0) {
        why = "the website must be an http:// or https:// URL";
    }
    if (why != 0) { return bote_err_new(BOTE_ERR_INVALID_PARAMS, "", why); }
    store64(d + 112, title);
    store64(d + 120, description);
    store64(d + 128, website_url);
    store64(d + 136, icons);
    _dsp_server_info_build(d);
    return 0;
}

# What the server tells a client's model about using it (3.8.1), or 0 for nothing: in
# `initialize`'s result on 2025-11-25 and in `server/discover`'s on 2026-07-28. Set
# before serving. Returns `d`.
fn dispatcher_set_instructions(d, text) {
    store64(d + 144, text);
    store64(d + 152, 0);
    if (text != 0) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, ",\"instructions\":\"");
        bote_json_escape(sb, text);
        str_builder_add_cstr(sb, "\"");
        store64(d + 152, str_data(str_builder_build(sb)));
    }
    return d;
}

# serverInfo's two forms, built from what is set: every field, and name, version and title.
fn _dsp_server_info_build(d) {
    var sname = dispatcher_server_name(d);
    if (sname == 0) { sname = "bote"; }
    var sver = dispatcher_server_version(d);
    if (sver == 0) { sver = _bote_server_version(); }
    var title = dispatcher_server_title(d);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"name\":\"");
    bote_json_escape(sb, sname);
    str_builder_add_cstr(sb, "\"");
    if (title != 0) {
        str_builder_add_cstr(sb, ",\"title\":\"");
        bote_json_escape(sb, title);
        str_builder_add_cstr(sb, "\"");
    }
    str_builder_add_cstr(sb, ",\"version\":\"");
    bote_json_escape(sb, sver);
    str_builder_add_cstr(sb, "\"");
    var head = str_data(str_builder_build(sb));
    store64(d + 168, _dsp_named_msg(head, "}", 0));
    var fb = str_builder_new();
    str_builder_add_cstr(fb, head);
    var desc = dispatcher_server_description(d);
    if (desc != 0) {
        str_builder_add_cstr(fb, ",\"description\":\"");
        bote_json_escape(fb, desc);
        str_builder_add_cstr(fb, "\"");
    }
    var site = dispatcher_server_website(d);
    if (site != 0) {
        str_builder_add_cstr(fb, ",\"websiteUrl\":\"");
        bote_json_escape(fb, site);
        str_builder_add_cstr(fb, "\"");
    }
    var icons = _bote_display_json(0, dispatcher_server_icons(d));
    if (icons != 0) { str_builder_add_cstr(fb, icons); }
    str_builder_add_cstr(fb, "}");
    store64(d + 160, str_data(str_builder_build(fb)));
    return 0;
}

# How many bytes _dsp_emit_server_info writes, at most.
fn _dsp_server_info_room(d, full) {
    var c = load64(d + 168);
    if (full == 1) { c = load64(d + 160); }
    if (c != 0) { return strlen(c); }
    return 64 + 6 * strlen(_bote_server_version());
}

fn _dsp_instructions_room(d) {
    var c = load64(d + 152);
    if (c == 0) { return 0; }
    return strlen(c);
}

# Who can say what a token grants. Claims are opaque to bote, so what reads them is
# supplied: jwt_scope_check for a JWT, and for anything else the validator's author.
# A broader scope that implies a narrower one is this function's to account for.
fn dispatcher_set_scope_check(d, fp, ctx) {
    store64(d + 88, fp);
    store64(d + 96, ctx);
    return d;
}

# What carries this dispatcher's `subscriptions/listen` streams (3.7.2), or 0 for none,
# when the method is not found. A transport that can hold a stream open sets it.
fn dispatcher_set_listen(d, hub) { store64(d + 104, hub); return d; }
fn dispatcher_listen(d) { return load64(d + 104); }

fn dispatcher_set_audit(d, sink) { store64(d + 24, sink); return d; }
fn dispatcher_set_events(d, sink) { store64(d + 32, sink); return d; }
fn dispatcher_set_prompts(d, preg) { store64(d + 40, preg); return d; }
fn dispatcher_set_resources(d, rreg) { store64(d + 48, rreg); return d; }

# Set the completion handler. ABI: fn h(params_cstr, claims) → result_cstr,
# where params is the completion/complete params ({ref, argument, ...}) and
# the result is the full {"completion":{"values":[...]}} body. Setting it
# flips the `completions` capability on at initialize.
fn dispatcher_set_completion(d, handler_fp) { store64(d + 56, handler_fp); return d; }

# Declare that this dispatcher's transport can deliver server→client
# notifications (a list_changed drain path). Flips the `listChanged`
# sub-capabilities on at initialize. Set by the transport wiring only.
fn dispatcher_set_notifications(d, on) { store64(d + 64, on); return d; }

# Register a sync tool handler. **2.0 ABI**: handler signature is
#   fn h(args_cstr, claims) → result_cstr (claims always 0 today)
# The handler maps are under the registries' lock (3.7.1, src/protocol.cyr), as the
# registries are: a threaded server reads them for every call.
fn dispatcher_handle(d, name, handler_fp) {
    bote_reg_write();
    map_set(dispatcher_handlers(d), name, handler_fp);
    bote_reg_write_end();
    return 0;
}

# Register a streaming tool handler (placeholder — dispatch_streaming not yet ported).
fn dispatcher_handle_streaming(d, name, handler_fp) {
    bote_reg_write();
    map_set(dispatcher_streaming(d), name, handler_fp);
    bote_reg_write_end();
    return 0;
}

fn dispatcher_is_streaming_tool(d, name) {
    bote_reg_read();
    var h = map_has(dispatcher_streaming(d), name);
    bote_reg_read_end();
    return h;
}

# The tool `name`, or 0, from one look at the registries (3.7.2), with what serves it: its
# handler through *fp_out, *has_out 1 when one is set (a handler may be registered as 0),
# and with a `ver`, *ver_out 1 when that version is registered. A call is judged by this
# and served by it, so a tool registered or replaced while the call runs cannot lend it a
# definition its scopes were not checked against. (3.8.4) The tool is a copy, on `a`, made in
# the same look: a definition registered again is staged in place, and a call that read its
# outputSchema's compiled form and its 2025-11-25 form at different moments could lift a value
# by one and judge it by neither.
fn _dsp_tool_serving(a, d, name, ver, ver_out, has_out, fp_out) {
    bote_reg_read();
    var t = _registry_get_u(dispatcher_registry(d), name);
    if (t != 0) {
        # A word at a time: the stdlib's memcpy goes a byte at a time, 240 ns for 144 bytes,
        # which every call paid.
        var snap = alloc_via(a, 152);
        var w = 0;
        while (w < 152) { store64(snap + w, load64(t + w)); w = w + 8; }
        t = snap;
    }
    var has = map_has(dispatcher_handlers(d), name);
    var fp = 0;
    if (has == 1) { fp = map_get(dispatcher_handlers(d), name); }
    var vok = 1;
    if (ver != 0 && _registry_get_versioned_u(dispatcher_registry(d), name, ver) == 0) { vok = 0; }
    bote_reg_read_end();
    store64(ver_out, vok);
    store64(has_out, has);
    store64(fp_out, fp);
    return t;
}

# The handler registered for tool `name`, through *has_out 1 when there is one (a handler
# may be registered as 0), or 0.
fn _dsp_handler(d, name, has_out) {
    bote_reg_read();
    var fp = 0;
    var has = map_has(dispatcher_handlers(d), name);
    if (has == 1) { fp = map_get(dispatcher_handlers(d), name); }
    bote_reg_read_end();
    store64(has_out, has);
    return fp;
}

# Build {"tool_name":"<name>"} for a register/dereg/deprecate event payload.
fn _emit_tool_name_payload(name) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"tool_name\":\"");
    _json_emit_escaped(sb, name);
    str_builder_add_cstr(sb, "\"}");
    return str_data(str_builder_build(sb));
}

# Dynamic registration: validates the tool name, registers in registry,
# inserts handler. Returns 0 on success, BoteError ptr on failure.
# Emits TOPIC_TOOL_REGISTERED on success.
fn dispatcher_register_tool(d, tool_def, handler_fp) {
    if (tool_def == 0) { return bote_err_new(BOTE_ERR_INVALID_PARAMS, "", "tool definition is null"); }
    var name = tool_def_name(tool_def);
    # Registration's checks hold the name to the spec's rule (3.8.7), and log why it refuses one.
    var st[72];
    var rerr = _registry_prepare(tool_def, &st);
    if (rerr != 0) { return rerr; }
    # The tool and its handler in one write (3.7.1), so a call on another worker never
    # finds the one without the other; the event after, with nothing held.
    bote_reg_write();
    map_set(dispatcher_handlers(d), name, handler_fp);
    _registry_add_u(dispatcher_registry(d), tool_def, &st);
    bote_reg_write_end();
    event_sink_publish(dispatcher_event_sink(d), TOPIC_TOOL_REGISTERED(),
      _emit_tool_name_payload(name));
    return 0;
}

# Returns 0 on success, BoteError ptr on failure (tool not found).
# Emits TOPIC_TOOL_DEREGISTERED on success.
fn dispatcher_deregister_tool(d, name) {
    bote_reg_write();
    var removed = _registry_deregister_u(dispatcher_registry(d), name);
    map_delete(dispatcher_handlers(d), name);
    map_delete(dispatcher_streaming(d), name);
    bote_reg_write_end();
    if (removed == 0) {
        return bote_err_new(BOTE_ERR_TOOL_NOT_FOUND, name, 0);
    }
    event_sink_publish(dispatcher_event_sink(d), TOPIC_TOOL_DEREGISTERED(),
      _emit_tool_name_payload(name));
    return 0;
}

# Why a prompt, resource or template with a required scope that is no RFC 6749
# scope-token is not registered: the scope would go out in a 403's header (3.6.6).
var DSP_SCOPE_NOT_TOKEN = "a required scope must be a non-empty token with no space, quote or backslash";

# The registry at `d + off`, the one `fresh` becomes when there is none yet (3.7.2). Two
# threads registering the first prompt or resource at once each made one, and the first
# stored was lost with what was registered in it. The swap publishes `fresh` after its
# maps, so a reader that sees it sees them; a loser's `fresh` is left unused.
fn _dsp_made(d, off, fresh) {
    if (atomic_cas(d + off, 0, fresh) == 1) { return fresh; }
    return atomic_load(d + off);
}

# Register an MCP prompt + its generator handler. Lazily stands up the
# dispatcher's PromptRegistry on first call — which is also what flips the
# `prompts` capability on at initialize (see _build_capabilities). Prompt
# names are freeform (no project_tool underscore convention). Returns 0, or a
# BoteError with nothing registered.
fn dispatcher_register_prompt(d, prompt_def, handler_fp) {
    if (prompt_def == 0 || prompt_def_name(prompt_def) == 0) {
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, "", "prompt definition has no name");
    }
    if (bote_scope_list_ok(prompt_def_required_scopes(prompt_def)) == 0) {
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, prompt_def_name(prompt_def), DSP_SCOPE_NOT_TOKEN);
    }
    var pwhy = prompt_display_check(prompt_def);
    if (pwhy != 0) { return bote_err_new(BOTE_ERR_INVALID_PARAMS, prompt_def_name(prompt_def), pwhy); }
    var preg = dispatcher_prompts(d);
    if (preg == 0) { preg = _dsp_made(d, 40, prompt_registry_new()); }
    prompt_registry_register(preg, prompt_def, handler_fp);
    # Emit a prompt-set-changed event so a client-notification sink can push
    # notifications/prompts/list_changed (no-op when no sink is wired, e.g.
    # the startup registrations before the transport sets its sink).
    var pb = str_builder_new();
    str_builder_add_cstr(pb, "{\"prompt_name\":\"");
    _json_emit_escaped(pb, prompt_def_name(prompt_def));
    str_builder_add_cstr(pb, "\"}");
    event_sink_publish(dispatcher_event_sink(d), TOPIC_PROMPT_REGISTERED(),
      str_data(str_builder_build(pb)));
    return 0;
}

# Register an MCP resource + its read handler. Lazily stands up the
# dispatcher's ResourceRegistry on first call — which is also what flips the
# `resources` capability on at initialize (see _build_capabilities).
# Returns 0, or a BoteError with nothing registered.
fn dispatcher_register_resource(d, resource_def, handler_fp) {
    if (resource_def == 0 || resource_def_uri(resource_def) == 0) {
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, "", "resource definition has no uri");
    }
    if (bote_scope_list_ok(resource_def_required_scopes(resource_def)) == 0) {
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, resource_def_uri(resource_def), DSP_SCOPE_NOT_TOKEN);
    }
    var rwhy = bote_display_check(resource_def_title(resource_def), resource_def_icons(resource_def));
    if (rwhy != 0) { return bote_err_new(BOTE_ERR_INVALID_PARAMS, resource_def_uri(resource_def), rwhy); }
    var rreg = dispatcher_resources(d);
    if (rreg == 0) { rreg = _dsp_made(d, 48, resource_registry_new()); }
    resource_registry_register(rreg, resource_def, handler_fp);
    _dsp_resource_changed(d);
    return 0;
}

# A resource or a template registered (3.7.2): `notifications/resources/list_changed`
# for whoever listens for it.
fn _dsp_resource_changed(d) {
    event_sink_publish(dispatcher_event_sink(d), TOPIC_RESOURCE_REGISTERED(), "{}");
    return 0;
}

# Register a resource template + its read handler. Stands up the registry the way
# dispatcher_register_resource does. Returns 0, or a BoteError saying why not, with
# nothing registered.
fn dispatcher_register_resource_template(d, template, handler_fp) {
    if (template == 0 || resource_template_name(template) == 0) {
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, "", "a resource template needs a name");
    }
    var why = resource_template_check(resource_template_uri(template));
    if (why != 0) { return bote_err_new(BOTE_ERR_INVALID_PARAMS, resource_template_name(template), why); }
    if (bote_scope_list_ok(resource_template_required_scopes(template)) == 0) {
        return bote_err_new(BOTE_ERR_INVALID_PARAMS, resource_template_name(template), DSP_SCOPE_NOT_TOKEN);
    }
    var twhy = bote_display_check(resource_template_title(template), resource_template_icons(template));
    if (twhy != 0) { return bote_err_new(BOTE_ERR_INVALID_PARAMS, resource_template_name(template), twhy); }
    var rreg = dispatcher_resources(d);
    if (rreg == 0) { rreg = _dsp_made(d, 48, resource_registry_new()); }
    resource_registry_register_template(rreg, template, handler_fp);
    _dsp_resource_changed(d);
    return 0;
}

# ================================================================
# JSON helpers — escape, build literals
# ================================================================

# `_json_emit_escaped`, the escaper every module calls, lives in jsonx.cyr
# since 3.4.6 as `bote_json_escape`, with the old name kept as an alias.

# Append "key":"value" (value JSON-escaped). Caller responsible for commas.
fn _json_emit_str_field(sb, key, value) {
    str_builder_add_cstr(sb, "\"");
    str_builder_add_cstr(sb, key);
    str_builder_add_cstr(sb, "\":\"");
    _json_emit_escaped(sb, value);
    str_builder_add_cstr(sb, "\"");
    return 0;
}

# Append "key":raw  where raw is already JSON-formatted.
fn _json_emit_raw_field(sb, key, raw) {
    str_builder_add_cstr(sb, "\"");
    str_builder_add_cstr(sb, key);
    str_builder_add_cstr(sb, "\":");
    str_builder_add_cstr(sb, raw);
    return 0;
}

# Build a JSON object representation of a ToolSchema.
fn _emit_schema(sb, schema) {
    str_builder_add_cstr(sb, "{\"type\":\"");
    var t = schema_type(schema);
    if (t != 0) { _json_emit_escaped(sb, t); }
    str_builder_add_cstr(sb, "\"");

    var props = schema_properties(schema);
    if (props != 0 && vec_len(props) > 0) {
        str_builder_add_cstr(sb, ",\"properties\":{");
        var n = vec_len(props);
        var i = 0;
        while (i < n) {
            if (i > 0) { str_builder_add_cstr(sb, ","); }
            var p = vec_get(props, i);
            str_builder_add_cstr(sb, "\"");
            _json_emit_escaped(sb, schema_prop_key(p));
            str_builder_add_cstr(sb, "\":");
            str_builder_add_cstr(sb, schema_prop_value(p));
            i = i + 1;
        }
        str_builder_add_cstr(sb, "}");
    }

    var req = schema_required(schema);
    if (req != 0 && vec_len(req) > 0) {
        str_builder_add_cstr(sb, ",\"required\":[");
        var nr = vec_len(req);
        var ri = 0;
        while (ri < nr) {
            if (ri > 0) { str_builder_add_cstr(sb, ","); }
            str_builder_add_cstr(sb, "\"");
            _json_emit_escaped(sb, vec_get(req, ri));
            str_builder_add_cstr(sb, "\"");
            ri = ri + 1;
        }
        str_builder_add_cstr(sb, "]");
    }
    str_builder_add_cstr(sb, "}");
    return 0;
}

# A tool's inputSchema as registration kept it, on one line (3.8.3). A definition never
# registered, as an announcement may hold, has it made here, on the heap.
fn _emit_input_schema(sb, t) {
    var ij = tool_def_input_json(t);
    if (ij == 0) { ij = _reg_input_json(tool_def_input_schema(t)); }
    str_builder_add_cstr(sb, ij);
    return 0;
}

# Append a single tri-state annotation hint as "key":true/false.
# `first` is 1 when no hint has been emitted yet (suppresses the leading
# comma); returns the updated `first` flag. HINT_UNSET emits nothing.
fn _emit_hint_field(sb, first, key, hint) {
    if (hint == HINT_UNSET) { return first; }
    if (first == 0) { str_builder_add_cstr(sb, ","); }
    str_builder_add_cstr(sb, "\"");
    str_builder_add_cstr(sb, key);
    if (hint == HINT_TRUE) { str_builder_add_cstr(sb, "\":true"); }
    else { str_builder_add_cstr(sb, "\":false"); }
    return 0;
}

# Append ,"annotations":{...} for a ToolDef's ToolAnnotations ptr.
# Emits nothing when `ann` is 0 or every hint is unset (so the leading
# comma is only produced when at least one hint is serialized). MCP
# 2025-11-25 ToolAnnotations: readOnlyHint/destructiveHint/idempotentHint/
# openWorldHint, each an optional boolean (skip when unset).
fn _emit_annotations(sb, ann) {
    if (ann == 0) { return 0; }
    var r = ann_read_only_hint(ann);
    var dd = ann_destructive_hint(ann);
    var idem = ann_idempotent_hint(ann);
    var ow = ann_open_world_hint(ann);
    if (r == HINT_UNSET && dd == HINT_UNSET && idem == HINT_UNSET && ow == HINT_UNSET) {
        return 0;
    }
    str_builder_add_cstr(sb, ",\"annotations\":{");
    var first = 1;
    first = _emit_hint_field(sb, first, "readOnlyHint", r);
    first = _emit_hint_field(sb, first, "destructiveHint", dd);
    first = _emit_hint_field(sb, first, "idempotentHint", idem);
    first = _emit_hint_field(sb, first, "openWorldHint", ow);
    str_builder_add_cstr(sb, "}");
    return 0;
}

# ================================================================
# Method handlers
# ================================================================

# Append the MCP `capabilities` object advertised at initialize.
#
# Advertised keys are DERIVED from what bote actually implements, so we
# never advertise a capability we can't honor:
#   - `tools`: always — bote is a tool server (an empty registry is still
#     tool-capable).
#   - `prompts`: advertised iff the dispatcher has a PromptRegistry (i.e. at
#     least one prompt was registered — see dispatcher_register_prompt).
#   - `resources`: advertised iff the dispatcher has a ResourceRegistry (see
#     dispatcher_register_resource). `subscribe`/`listChanged` omitted — no
#     resource-mutation producer feeds them yet.
#   - `completions`: advertised iff a completion handler is set (see
#     dispatcher_set_completion).
#   - `listChanged` (tools + prompts): advertised ONLY when
#     dispatcher_notifications(d) == 1 — i.e. the transport wired a
#     server→client drain path (streamable's per-session buffers). The
#     register/dereg + prompt-register events already fire; the flag confirms
#     they actually reach a client. Kept OUT of core so stdio/http/ws (no
#     drain path) never promise notifications they can't deliver.
#   - logging: NOT YET — it exists only to gate `notifications/message`;
#     advertising it would promise log messages bote can't send.
#
# Version policy: every capability below exists across all supported
# protocol versions (2024-11-05 … 2025-11-25), so none is gated on the
# negotiated version. A version-exclusive capability would branch on the
# negotiated version passed in here.
fn _build_capabilities(sb, d) {
    return _build_capabilities_lc(sb, d, dispatcher_notifications(d));
}

# `lc` is whether listChanged may be promised, which needs a way to deliver it.
fn _build_capabilities_lc(sb, d, lc) { return _build_capabilities_sub(sb, d, lc, 0); }

# _build_capabilities_lc, and `resources.subscribe` when `sub` is 1 (3.7.4): only where a
# listen carries `resourceSubscriptions`. The legacy `initialize` never says it, having no
# `resources/subscribe`.
fn _build_capabilities_sub(sb, d, lc, sub) {
    str_builder_add_cstr(sb, "{\"tools\":{");
    if (lc == 1) { str_builder_add_cstr(sb, "\"listChanged\":true"); }
    str_builder_add_cstr(sb, "}");
    if (dispatcher_prompts(d) != 0) {
        str_builder_add_cstr(sb, ",\"prompts\":{");
        if (lc == 1) { str_builder_add_cstr(sb, "\"listChanged\":true"); }
        str_builder_add_cstr(sb, "}");
    }
    if (dispatcher_resources(d) != 0) {
        str_builder_add_cstr(sb, ",\"resources\":{");
        if (lc == 1) { str_builder_add_cstr(sb, "\"listChanged\":true"); }
        if (sub == 1) {
            if (lc == 1) { str_builder_add_cstr(sb, ","); }
            str_builder_add_cstr(sb, "\"subscribe\":true");
        }
        str_builder_add_cstr(sb, "}");
    }
    if (dispatcher_completion(d) != 0) {
        str_builder_add_cstr(sb, ",\"completions\":{}");
    }
    str_builder_add_cstr(sb, "}");
    return 0;
}

# Build the initialize response result body.
# {"name":...,"version":...}. Escaped since 3.4.6: both come from the embedder
# through dispatcher_set_server_info, and a quote in either broke the reply.
# serverInfo: `full` 1 for every field, as `initialize` and `server/discover` send it,
# and 0 for the name, the version and the title, as every other result's `_meta`.
fn _dsp_emit_server_info(sb, d, full) {
    var c = load64(d + 168);
    if (full == 1) { c = load64(d + 160); }
    if (c != 0) {
        str_builder_add_cstr(sb, c);
        return 0;
    }
    var sname = dispatcher_server_name(d);
    if (sname == 0) { sname = "bote"; }
    var sver = dispatcher_server_version(d);
    if (sver == 0) { sver = _bote_server_version(); }
    str_builder_add_cstr(sb, "{\"name\":\"");
    _json_emit_escaped(sb, sname);
    str_builder_add_cstr(sb, "\",\"version\":\"");
    _json_emit_escaped(sb, sver);
    str_builder_add_cstr(sb, "\"}");
    return 0;
}

fn _build_initialize_result_a(a, d, params_cstr) {
    var requested = jsonx_get_str_a(a, params_cstr, "protocolVersion");
    var negotiated = _mcp_latest_version();
    if (_mcp_is_supported(requested) == 1) { negotiated = requested; }

    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 512 + _dsp_server_info_room(d, 1) + _dsp_instructions_room(d));
    str_builder_add_cstr(sb, "{\"protocolVersion\":\"");
    str_builder_add_cstr(sb, negotiated);
    str_builder_add_cstr(sb, "\",\"capabilities\":");
    _build_capabilities(sb, d);
    str_builder_add_cstr(sb, ",\"serverInfo\":");
    _dsp_emit_server_info(sb, d, 1);
    var ins = load64(d + 152);
    if (ins != 0) { str_builder_add_cstr(sb, ins); }
    str_builder_add_cstr(sb, "}");
    return str_data(str_builder_build_a(a, sb));
}

# Build the prompts/list response result body.
fn _build_prompts_list_result(a, preg) {
    bote_reg_read();
    var names = prompt_registry_names(preg);
    var n = vec_len(names);
    var room = 32;
    var i = 0;
    while (i < n) {
        var c = _prompt_registry_get_u(preg, vec_get(names, i));
        room = room + 64 + _dsp_room(prompt_def_name(c)) + _dsp_room(prompt_def_description(c));
        room = room + _dsp_len(prompt_def_display(c));
        var cargs = prompt_def_arguments(c);
        if (cargs != 0) {
            var ci = 0;
            while (ci < vec_len(cargs)) {
                var carg = vec_get(cargs, ci);
                room = room + 64 + _dsp_room(prompt_arg_name(carg)) + _dsp_room(prompt_arg_description(carg));
                room = room + _dsp_len(prompt_arg_display(carg));
                ci = ci + 1;
            }
        }
        i = i + 1;
    }
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, room);
    str_builder_add_cstr(sb, "{\"prompts\":[");
    i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        var p = _prompt_registry_get_u(preg, vec_get(names, i));
        str_builder_add_cstr(sb, "{");
        _json_emit_str_field(sb, "name", prompt_def_name(p));
        var pdisp = prompt_def_display(p);
        if (pdisp != 0) { str_builder_add_cstr(sb, pdisp); }
        var pd = prompt_def_description(p);
        if (pd != 0) {
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "description", pd);
        }
        var pargs = prompt_def_arguments(p);
        if (pargs != 0 && vec_len(pargs) > 0) {
            str_builder_add_cstr(sb, ",\"arguments\":[");
            var na = vec_len(pargs);
            var ai = 0;
            while (ai < na) {
                if (ai > 0) { str_builder_add_cstr(sb, ","); }
                var parg = vec_get(pargs, ai);
                str_builder_add_cstr(sb, "{");
                _json_emit_str_field(sb, "name", prompt_arg_name(parg));
                var adisp = prompt_arg_display(parg);
                if (adisp != 0) { str_builder_add_cstr(sb, adisp); }
                var ad = prompt_arg_description(parg);
                if (ad != 0) {
                    str_builder_add_cstr(sb, ",");
                    _json_emit_str_field(sb, "description", ad);
                }
                if (prompt_arg_required(parg) == 1) {
                    str_builder_add_cstr(sb, ",\"required\":true");
                }
                str_builder_add_cstr(sb, "}");
                ai = ai + 1;
            }
            str_builder_add_cstr(sb, "]");
        }
        str_builder_add_cstr(sb, "}");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    bote_reg_read_end();
    return str_data(str_builder_build_a(a, sb));
}

# Does tool `t` belong in a `profile`-filtered listing? A null profile means
# no filter was requested, so every tool matches (full listing, unchanged).
fn _tool_matches_profile(t, profile) {
    if (profile == 0) { return 1; }
    return tool_def_has_profile(t, profile);
}

# Build the tools/list response result body.
#
# `profile` (cstr or 0) is an OPTIONAL bote extension: when a client passes
# {"profile":"<tag>"} in tools/list params, only tools tagged with that
# profile are returned (exact-match). When absent (0), the full tool list is
# returned — byte-identical to pre-extension behavior.
# Room for one tool's entry in tools/list. The helpers that write it grow a
# builder on the heap, so this sizes the arena builder up front. A short
# estimate costs one growth on the heap, nothing worse.
fn _dsp_room(cstr) {
    if (cstr == 0) { return 0; }
    return 6 * strlen(cstr);
}

# The room for what is sent as it is kept, already escaped (3.8.1).
fn _dsp_len(cstr) {
    if (cstr == 0) { return 0; }
    return strlen(cstr);
}

fn _dsp_tool_list_room(t) {
    var n = 256 + _dsp_room(tool_def_name(t)) + _dsp_room(tool_def_description(t));
    n = n + _dsp_len(tool_def_display(t));
    n = n + _dsp_room(tool_def_version(t)) + _dsp_room(tool_def_deprecated(t));
    # The inputSchema as registration kept it (3.8.3), and each form of an outputSchema.
    n = n + _dsp_len(tool_def_input_json(t));
    var os = tool_def_output_json(t);
    if (os != 0) { n = n + 32 + strlen(os); }
    var ol = tool_def_output_legacy(t);
    if (ol != 0) { n = n + strlen(ol); }
    return n;
}

# `modern` is 1 for MCP 2026-07-28, which is shown an outputSchema as it was
# written, and 0 for the revisions before it, which are shown its object form.
fn _build_tools_list_result_a(a, reg, profile, modern) {
    bote_reg_read();
    var sb = str_builder_new_a(a);
    var room = 64;
    var rnames = registry_names(reg);
    var ri = 0;
    while (ri < vec_len(rnames)) {
        room = room + _dsp_tool_list_room(_registry_get_u(reg, vec_get(rnames, ri)));
        ri = ri + 1;
    }
    _sb_grow_a(a, sb, room);
    str_builder_add_cstr(sb, "{\"tools\":[");
    var n = vec_len(rnames);
    var i = 0;
    var emitted = 0;
    while (i < n) {
        var t = _registry_get_u(reg, vec_get(rnames, i));
        if (_tool_matches_profile(t, profile) == 0) {
            i = i + 1;
            continue;
        }
        if (emitted > 0) { str_builder_add_cstr(sb, ","); }
        emitted = emitted + 1;
        str_builder_add_cstr(sb, "{");
        _json_emit_str_field(sb, "name", tool_def_name(t));
        var tdisp = tool_def_display(t);
        if (tdisp != 0) { str_builder_add_cstr(sb, tdisp); }
        str_builder_add_cstr(sb, ",");
        _json_emit_str_field(sb, "description", tool_def_description(t));
        str_builder_add_cstr(sb, ",\"inputSchema\":");
        _emit_input_schema(sb, t);
        var os = tool_def_output_json(t);
        if (os != 0) {
            if (modern == 0 && tool_def_output_legacy(t) != 0) { os = tool_def_output_legacy(t); }
            str_builder_add_cstr(sb, ",\"outputSchema\":");
            str_builder_add_cstr(sb, os);
        }
        var v = tool_def_version(t);
        if (v != 0) {
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "version", v);
        }
        var dep = tool_def_deprecated(t);
        if (dep != 0) {
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "deprecated", dep);
        }
        _emit_annotations(sb, tool_def_annotations(t));
        str_builder_add_cstr(sb, "}");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    bote_reg_read_end();
    return str_data(str_builder_build_a(a, sb));
}

# Extract and validate the tool name from a tools/call request's params.
# Returns cstr (name) or 0; sets *err_out (BoteError ptr) on failure.
fn _extract_tool_name(params_cstr, err_out) {
    var name = jsonx_get_str(params_cstr, "name");
    if (name == 0 || strlen(name) == 0) {
        store64(err_out, bote_err_new(BOTE_ERR_INVALID_PARAMS, "", "missing or empty 'name' field"));
        return 0;
    }
    store64(err_out, 0);
    return name;
}

# 1 when `sink` (an AuditSink or EventSink: +0 callback, +8 ctx) is installed
# with a callback, i.e. when audit_sink_log / event_sink_publish would call
# something. Both return early otherwise, so building what they would be
# handed is wasted work (3.4.1).
fn _dsp_sink_live(sink) {
    if (sink == 0) { return 0; }
    if (load64(sink) == 0) { return 0; }
    return 1;
}

# 1 when an event sink wants tool-call events: live, and not one that takes only
# tool-set changes (event_sink_set_list_only).
fn _dsp_sink_wants_calls(sink) {
    if (_dsp_sink_live(sink) == 0) { return 0; }
    if (load64(sink + 16) == 1) { return 0; }
    return 1;
}

# MCP's code for resources/read on a URI nothing serves (resources spec,
# "Error Handling"). It sits in JSON-RPC's server-defined range.
var BOTE_RPC_RESOURCE_NOT_FOUND = 0 - 32002;

# A failed tool call's result: {"content":[{"type":"text","text":"..."}],
# "isError":true}. Kept here rather than in content.cyr so the dispatcher
# needs no module it did not need before; content_text_error_response is
# the public name for it.
# A refused call is a call: the audit trail and the failed-call topic see it as
# they see one that failed in its handler. Copied to the heap, since a sink may
# keep what it is handed.
fn _dsp_record_refusal(d, name, params, plen, caller_pos, msg) {
    var audit_on = _dsp_sink_live(dispatcher_audit_sink(d));
    var events_on = _dsp_sink_wants_calls(dispatcher_event_sink(d));
    if (audit_on == 0 && events_on == 0) { return 0; }
    var h = default_alloc();
    var ev = tool_call_event_new(_slice_cstr(h, name, 0, strlen(name)), 0, 0,
      _slice_cstr(h, msg, 0, strlen(msg)), _jx_str_at_a(h, params, plen, caller_pos));
    if (audit_on == 1) { audit_sink_log(dispatcher_audit_sink(d), ev); }
    if (events_on == 1) {
        event_sink_publish(dispatcher_event_sink(d), TOPIC_TOOL_FAILED(), tool_call_event_to_json(ev));
    }
    return 0;
}

# `s` on one line. stdio and the Unix transport frame a message by its newline,
# and in valid JSON a raw LF or CR can only be whitespace between tokens, so a
# handler that pretty-prints cannot be allowed to split a response.
fn _dsp_one_line(a, s) {
    var n = strlen(s);
    var i = 0;
    while (i < n) {
        var c = load8(s + i);
        if (c == 10 || c == 13) { break; }
        i = i + 1;
    }
    if (i == n) { return s; }
    var out = alloc_via(a, n + 1);
    var o = 0;
    i = 0;
    while (i < n) {
        var ch = load8(s + i);
        if (ch != 10 && ch != 13) { store8(out + o, ch); o = o + 1; }
        i = i + 1;
    }
    store8(out + o, 0);
    return out;
}

# A prompt, resource or completion handler's result goes into the response as it
# stands, so it has to be JSON, on one line. Only tools/call checked this.
# A prompt's or a resource's result (3.8.2): valid JSON, and an InputRequiredResult judged.
fn _dsp_served_result(a, d, id, method, params, result, modern, claims) {
    if (jsonx_valid(result, strlen(result)) == 1 && _dsp_input_result(a, result) == 1) {
        return _dsp_input_out_a(a, d, id, method, params, _dsp_one_line(a, result), modern, claims);
    }
    return _dsp_checked_result(a, id, result);
}

fn _dsp_checked_result(a, id, result) {
    if (jsonx_valid(result, strlen(result)) == 0) {
        return resp_error_a(a, id, 0 - 32603, "internal error: the handler returned invalid JSON");
    }
    return resp_success_a(a, id, _dsp_one_line(a, result));
}

fn _dsp_tool_error_result(text) { return _dsp_tool_error_result_a(default_alloc(), text); }

fn _dsp_tool_error_result_a(a, text) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, strlen(text) * 6 + 64);
    str_builder_add_cstr(sb, "{\"content\":[{\"type\":\"text\",\"text\":\"");
    if (text != 0) { _json_emit_escaped(sb, text); }
    str_builder_add_cstr(sb, "\"}],\"isError\":true}");
    return str_data(str_builder_build_a(a, sb));
}

# A successful tool call's result carrying `text` as one text block (3.4.8), on `a`.
fn _dsp_tool_text_result_a(a, text) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, _dsp_room(text) + 64);
    str_builder_add_cstr(sb, "{\"content\":[{\"type\":\"text\",\"text\":\"");
    if (text != 0) { _json_emit_escaped(sb, text); }
    str_builder_add_cstr(sb, "\"}]}");
    return str_data(str_builder_build_a(a, sb));
}

# 1 when the n bytes at p equal cstr lit.
fn _dsp_bytes_eq(p, n, lit) {
    if (n != strlen(lit)) { return 0; }
    return memeq(p, lit, n);
}

# 1 when the n bytes at p name an MCP content block type (tools spec, "Tool
# Result").
fn _dsp_is_content_type(p, n) {
    if (_dsp_bytes_eq(p, n, "text") == 1 || _dsp_bytes_eq(p, n, "image") == 1) { return 1; }
    if (_dsp_bytes_eq(p, n, "audio") == 1 || _dsp_bytes_eq(p, n, "resource") == 1) { return 1; }
    if (_dsp_bytes_eq(p, n, "resource_link") == 1) { return 1; }
    return 0;
}

# 1 when the `n` bytes at `p`, a string's inside, decode to `lit` (3.8.2), compared as they
# decode, at any length (3.8.3): through 3.8.2 a value of 64 bytes or more was taken for
# none, and `input_required` written in escapes is 84, so such an InputRequiredResult went
# out unjudged and its state unsealed.
fn _dsp_str_dec_is(p, n, lit) {
    if (_jx_has_escape(p, n) == 0) { return _dsp_bytes_eq(p, n, lit); }
    return _jx_dec_eq(p, n, lit, strlen(lit));
}

# 1 when the `n` bytes at `p`, a string's inside, decode to an MCP content type (3.8.1):
# `"t\u0065xt"` is "text", to a client and so here. Through 3.8.0 the bytes were
# compared as written, so such a block went out as a text block holding its JSON; through
# 3.8.2 a value of 64 bytes or more was none, `resource_link` in escapes among them.
fn _dsp_type_is_content(p, n) {
    if (_jx_has_escape(p, n) == 0) { return _dsp_is_content_type(p, n); }
    if (_jx_dec_eq(p, n, "text", 4) == 1 || _jx_dec_eq(p, n, "image", 5) == 1) { return 1; }
    if (_jx_dec_eq(p, n, "audio", 5) == 1 || _jx_dec_eq(p, n, "resource", 8) == 1) { return 1; }
    if (_jx_dec_eq(p, n, "resource_link", 13) == 1) { return 1; }
    return 0;
}

# What a handler's result (valid JSON) is, from one pass over its top-level
# members, with nothing allocated: bit 1 when `content` is an array, bit 2
# when `isError` is true, bit 4 when `type` is an MCP content type. 0 for a
# result that is not an object. (3.8.0) Bit 8 when it has `structuredContent`,
# and bits 16, 32 and 64 when it names `content`, `structuredContent` or
# `isError` more than once. Its keys are read as the one key scanner reads them
# (_jx_scan): what they decode to, for a key under 256 bytes, where through 3.7.7
# `"is\u0045rror":true` was not an error here and was one to a client. `info`, a
# DspResult, gets where the first `content` and `structuredContent` values are.
var DSP_SHAPE_CONTENT = 1;
var DSP_SHAPE_ISERROR = 2;
var DSP_SHAPE_BLOCK = 4;
var DSP_SHAPE_SC = 8;
var DSP_SHAPE_TWICE_CONTENT = 16;
var DSP_SHAPE_TWICE_SC = 32;
var DSP_SHAPE_TWICE_ISERROR = 64;
var DSP_SHAPE_INPUT = 128;

# DspResult (24 bytes), what a tools/call result's handling knows of it: +0 the offset
# of its first `content` value, +8 of its first `structuredContent` value, each -1 for
# none, +16 its shape's bits. Filled by _dsp_coerce_result for the result it returns.
fn _dsp_info_set(info, cp, sp, flags) {
    store64(info, cp);
    store64(info + 8, sp);
    store64(info + 16, flags);
    return 0;
}

fn _dsp_result_shape(buf, info) {
    _dsp_info_set(info, 0 - 1, 0 - 1, 0);
    var len = strlen(buf);
    var i = _jx_skip_ws(buf, len, 0);
    if (i >= len || load8(buf + i) != 123) { return 0; }
    var flags = 0;
    var errs = 0;
    var dec[256];
    i = _jx_skip_ws(buf, len, i + 1);
    while (i < len && load8(buf + i) == 34) {
        var ks = i + 1;
        var ke = _jx_skip_string(buf, len, i);
        var klen = ke - ks - 1;
        var kp = buf + ks;
        if (klen > 0 && klen < 256 && _jx_has_escape(kp, klen) == 1) {
            klen = _jx_unescape_into(kp, klen, &dec);
            kp = &dec;
        }
        i = _jx_skip_ws(buf, len, ke);
        if (i >= len || load8(buf + i) != 58) { break; }
        var vs = _jx_skip_ws(buf, len, i + 1);
        var ve = _jx_skip_value(buf, len, vs);
        if (vs < len) {
            var vc = load8(buf + vs);
            if (_dsp_bytes_eq(kp, klen, "content") == 1) {
                if (load64(info) >= 0) { flags = flags | DSP_SHAPE_TWICE_CONTENT; } else { store64(info, vs); }
                if (vc == 91) { flags = flags | DSP_SHAPE_CONTENT; }
            } elif (_dsp_bytes_eq(kp, klen, "structuredContent") == 1) {
                if (load64(info + 8) >= 0) { flags = flags | DSP_SHAPE_TWICE_SC; } else { store64(info + 8, vs); }
                flags = flags | DSP_SHAPE_SC;
            } elif (_dsp_bytes_eq(kp, klen, "isError") == 1) {
                if (errs != 0) { flags = flags | DSP_SHAPE_TWICE_ISERROR; }
                errs = 1;
                if (vc == 116 && _dsp_bytes_eq(buf + vs, ve - vs, "true") == 1) { flags = flags | DSP_SHAPE_ISERROR; }
            } elif (vc == 34 && _dsp_bytes_eq(kp, klen, "type") == 1 && _dsp_type_is_content(buf + vs + 1, ve - vs - 2) == 1) {
                flags = flags | DSP_SHAPE_BLOCK;
            } elif (vc == 34 && _dsp_bytes_eq(kp, klen, "resultType") == 1 && _dsp_str_dec_is(buf + vs + 1, ve - vs - 2, "input_required") == 1) {
                # (3.8.2) An InputRequiredResult, which is no CallToolResult.
                flags = flags | DSP_SHAPE_INPUT;
            }
        }
        i = _jx_skip_ws(buf, len, ve);
        if (i < len && load8(buf + i) == 44) { i = _jx_skip_ws(buf, len, i + 1); }
    }
    store64(info + 16, flags);
    return flags;
}

# The CallToolResult the client gets for what tool `name`'s handler
# returned, and through *fail_out the failure message for the audit and the
# event (0 when the call succeeded). 3.4.8; through 3.4.7 a handler's return
# went out verbatim.
#   - nothing (0): a failed call, as since 3.4.5;
#   - not valid JSON: a failed call. The bytes are not sent, because they
#     would break the reply;
#   - an object whose `content` is an array: a CallToolResult already, sent
#     as it is. `"isError": true` in it makes the call a failure for the audit;
#   - one content block (an object whose `type` is an MCP content type):
#     lifted into a one-element `content` array;
#   - anything else (a bare record, an array, a number, a string): sent as a
#     text block holding the JSON text, so the model still sees the data.
# A domain object that happens to carry a `type` member ({"type":"person"})
# is not mistaken for a block: only the five content types lift. (3.8.0) For a
# tool `t` with an outputSchema, anything else is its structuredContent, with
# its JSON text in a text block (_dsp_tool_structured_result).
# What it builds is on `a` (3.8.0), and so is a failure's message, which goes
# to the heap as well when `keep` is 1, for a sink, which may keep it. Through 3.7.7
# all of it was on the heap, kept for good for each call.
fn _dsp_coerce_result(a, t, name, result, fail_out, keep, info) {
    store64(fail_out, 0);
    var why = 0;
    if (result == 0) {
        why = "the handler returned no result";
    } elif (jsonx_valid(result, strlen(result)) == 0) {
        why = "the handler returned a result that is not valid JSON";
    }
    # Each result built here starts {"content":[ and its content is at 11.
    if (why != 0) {
        var m = str_data(bote_err_format_a(a, bote_err_new_a(a, BOTE_ERR_EXEC_FAILED, name, why)));
        if (keep == 1) {
            store64(fail_out, _slice_cstr(default_alloc(), m, 0, strlen(m)));
        } else {
            store64(fail_out, m);
        }
        _dsp_info_set(info, 11, 0 - 1, DSP_SHAPE_CONTENT | DSP_SHAPE_ISERROR);
        return _dsp_tool_error_result_a(a, m);
    }
    result = _dsp_one_line(a, result);
    var shape = _dsp_result_shape(result, info);
    # (3.8.2) An InputRequiredResult goes on as it is, for the dispatcher to judge.
    if ((shape & DSP_SHAPE_INPUT) != 0) { return result; }
    if ((shape & DSP_SHAPE_CONTENT) != 0) {
        if ((shape & DSP_SHAPE_ISERROR) != 0) {
            store64(fail_out, "the tool reported an error (isError)");
        }
        return result;
    }
    if ((shape & DSP_SHAPE_BLOCK) != 0) {
        var sb = str_builder_new_a(a);
        _sb_grow_a(a, sb, strlen(result) + 16);
        str_builder_add_cstr(sb, "{\"content\":[");
        str_builder_add_cstr(sb, result);
        str_builder_add_cstr(sb, "]}");
        _dsp_info_set(info, 11, 0 - 1, DSP_SHAPE_CONTENT);
        return str_data(str_builder_build_a(a, sb));
    }
    if (t != 0 && tool_def_output_prop(t) != 0) {
        var st = _dsp_tool_structured_result_a(a, result);
        _dsp_info_set(info, 11, strlen(st) - strlen(result) - 1, DSP_SHAPE_CONTENT | DSP_SHAPE_SC);
        return st;
    }
    _dsp_info_set(info, 11, 0 - 1, DSP_SHAPE_CONTENT);
    return _dsp_tool_text_result_a(a, result);
}

# `v`, a bare value a handler returned, as the structured result of a tool with an
# outputSchema (3.8.0): structuredContent, and its JSON in a text block, which the
# tools spec says a tool returning structured content SHOULD also send.
fn _dsp_tool_structured_result_a(a, v) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 7 * strlen(v) + 64);
    str_builder_add_cstr(sb, "{\"content\":[{\"type\":\"text\",\"text\":\"");
    _json_emit_escaped(sb, v);
    str_builder_add_cstr(sb, "\"}],\"structuredContent\":");
    str_builder_add_cstr(sb, v);
    str_builder_add_cstr(sb, "}");
    return str_data(str_builder_build_a(a, sb));
}

# 1 when the content array at buf[cp] holds a text block, or is no array, which
# leaves nothing to add a block to.
fn _dsp_has_text_block(a, buf, n, cp) {
    if (cp < 0 || load8(buf + cp) != 91) { return 1; }
    var i = _jx_skip_ws(buf, n, cp + 1);
    while (i < n && load8(buf + i) != 93) {
        var e = _jx_skip_value(buf, n, i);
        var tp = _jx_find_value_pos(buf + i, e - i, "type");
        var ty = _jx_str_dec_at_a(a, buf + i, e - i, tp);
        if (ty != 0 && streq(ty, "text") == 1) { return 1; }
        i = _jx_array_next(buf, n, i);
    }
    return 0;
}

# `result` rebuilt with its structuredContent, the value at buf[sp], as
# {"result": value} when `wrap` is 1, and with a text block holding that value's
# JSON added to its content when `text` is 1. Its other members are as they were,
# each key written as it was, and a second structuredContent goes with the first.
fn _dsp_result_rebuild_a(a, result, n, sp, wrap, text) {
    var sc = _jx_raw_at_a(a, result, n, sp);
    var m = _jx_members_raw_a(a, result);
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 2 * n + 6 * strlen(sc) + 64);
    str_builder_add_cstr(sb, "{");
    var sep = 0;
    var did_text = 0;
    var i = 0;
    while (i < vec_len(m)) {
        var k = vec_get(m, i);
        var kr = vec_get(m, i + 1);
        var v = vec_get(m, i + 2);
        i = i + 3;
        # A key that decodes to hold a NUL names nothing bote reads.
        if (k == 0) { k = ""; }
        if (streq(k, "structuredContent") == 1) { continue; }
        if (sep == 1) { str_builder_add_cstr(sb, ","); }
        sep = 1;
        str_builder_add_cstr(sb, "\"");
        str_builder_add_cstr(sb, kr);
        str_builder_add_cstr(sb, "\":");
        if (text == 1 && did_text == 0 && streq(k, "content") == 1) {
            did_text = 1;
            var vn = strlen(v);
            var close = vn - 1;
            while (close > 0 && load8(v + close) != 93) { close = close - 1; }
            var inner = _jx_skip_ws(v, close, 1);
            store8(v + close, 0);
            str_builder_add_cstr(sb, v);
            if (inner < close) { str_builder_add_cstr(sb, ","); }
            str_builder_add_cstr(sb, "{\"type\":\"text\",\"text\":\"");
            bote_json_escape(sb, sc);
            str_builder_add_cstr(sb, "\"}]");
        } else {
            str_builder_add_cstr(sb, v);
        }
    }
    if (sep == 1) { str_builder_add_cstr(sb, ","); }
    str_builder_add_cstr(sb, "\"structuredContent\":");
    if (wrap == 1) { str_builder_add_cstr(sb, "{\"result\":"); }
    str_builder_add_cstr(sb, sc);
    if (wrap == 1) { str_builder_add_cstr(sb, "}"); }
    str_builder_add_cstr(sb, "}");
    return str_data(str_builder_build_a(a, sb));
}

# One WARN for a result refused by its tool's outputSchema: the handler's bug, for
# the operator. The reason is bote's own words; the violations, which may quote the
# result, go to the client and never to the log.
fn _dsp_log_output_refused(name, reason) {
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_WARN, "tool result refused");
    bote_log_str(&ln, "tool", name);
    bote_log_str(&ln, "reason", reason);
    bote_log_emit(&ln);
    return 0;
}

# What the client is sent for `result`, the CallToolResult of a call to tool `t`
# (3.8.0). *fail_out is the failure _dsp_coerce_result found, which a result its
# tool's outputSchema refuses replaces: on the heap when `keep` is 1, for a sink.
#   - A tool with an outputSchema: a result that is no error must carry
#     structuredContent, and it must match ("Servers MUST provide structured
#     results that conform to this schema", the tools spec). One that does not is
#     a tool execution error, as an argument failing the inputSchema is, and its
#     bytes are not sent. Nor is one naming content, structuredContent or isError
#     twice: bote judges the first, and a client may read the last.
#   - structuredContent that is no object gets a text block holding its JSON when
#     the result has none, on every revision (SEP-2106 §4.3, as the official SDK).
#   - Before 2026-07-28 structuredContent is an object: anything else, and all
#     structuredContent of a tool whose outputSchema has no object at its root,
#     goes as {"result": value}, which is what that tool's listed schema says.
# `info` is the DspResult _dsp_coerce_result filled for `result`: a result with no
# structuredContent, from a tool with no outputSchema, costs nothing more here.
fn _dsp_tool_result_out_a(a, t, name, result, fail_out, modern, keep, info) {
    var cp = load64(info);
    var sp = load64(info + 8);
    var flags = load64(info + 16);
    if ((flags & DSP_SHAPE_INPUT) != 0) { return result; }
    var prop = 0;
    if (t != 0) { prop = tool_def_output_prop(t); }
    # A result naming one of the three twice is refused from every tool (3.8.1), with an
    # outputSchema or not: bote shapes and audits the first, and a client reads the last.
    var twice = 0;
    if ((flags & DSP_SHAPE_TWICE_CONTENT) != 0) { twice = "content"; }
    elif ((flags & DSP_SHAPE_TWICE_SC) != 0) { twice = "structuredContent"; }
    elif ((flags & DSP_SHAPE_TWICE_ISERROR) != 0) { twice = "isError"; }
    if (prop == 0 && sp < 0 && twice == 0) { return result; }
    var n = strlen(result);
    var why = 0;
    var reason = 0;
    if (twice != 0) {
        reason = "the result names a member twice";
        why = _dsp_named_msg_a(a, "the result names ", twice, " more than once");
    } elif (prop != 0 && (flags & DSP_SHAPE_ISERROR) == 0 && sp < 0) {
        reason = "no structuredContent";
        why = "the tool has an outputSchema and the result has no structuredContent";
    } elif (prop != 0 && (flags & DSP_SHAPE_ISERROR) == 0) {
        var sc = _jx_raw_at_a(a, result, n, sp);
        # A key named twice in any object of it (3.8.1): the schema would judge the first.
        # Or one a client reads another way (3.8.2).
        if (_jx_repeats_a(a, sc, 0) == 1) {
            reason = "structuredContent names a member twice";
            why = "the result's structuredContent names a member twice in one object, or one a client would read another way";
        } else {
            var vs = _sch_check_value_a(a, prop, "structuredContent", sc);
            if (vs != 0) {
                reason = "structuredContent does not match the outputSchema";
                var vb = str_builder_new_a(a);
                str_builder_add_cstr_a(a, vb, "the result's structuredContent does not match the outputSchema: ");
                var vi = 0;
                while (vi < vec_len(vs)) {
                    if (vi > 0) { str_builder_add_cstr_a(a, vb, "; "); }
                    str_builder_add_cstr_a(a, vb, vec_get(vs, vi));
                    vi = vi + 1;
                }
                why = str_data(str_builder_build_a(a, vb));
            }
        }
    }
    if (why != 0) {
        _dsp_log_output_refused(name, reason);
        var msg = str_data(bote_err_format_a(a, bote_err_new_a(a, BOTE_ERR_EXEC_FAILED, name, why)));
        if (keep == 1) {
            store64(fail_out, _slice_cstr(default_alloc(), msg, 0, strlen(msg)));
        } else {
            store64(fail_out, msg);
        }
        return _dsp_tool_error_result_a(a, msg);
    }
    if (sp < 0) { return result; }
    var obj = 0;
    if (load8(result + sp) == 123) { obj = 1; }
    var wrap = 0;
    if (modern == 0 && (obj == 0 || (t != 0 && tool_def_output_legacy(t) != 0))) { wrap = 1; }
    var text = 0;
    if (obj == 0 && _dsp_has_text_block(a, result, n, cp) == 0) { text = 1; }
    if (wrap == 0 && text == 0) { return result; }
    return _dsp_result_rebuild_a(a, result, n, sp, wrap, text);
}

# 1 when a list request's params carry a non-null `cursor`. bote returns
# every item in one page and never issues a cursor, so any cursor a client
# sends is one it was never given. The pagination spec says an invalid
# cursor SHOULD be -32602 (3.4.5). Through 3.4.4 it was ignored and the
# first page went out again, which a client joining pages would take as
# duplicates. A null cursor is read as absent, like a null params.
fn _dsp_cursor_given(params) {
    if (params == 0) { return 0; }
    var c = jsonx_get_raw_a(bote_req_alloc(), params, "cursor");
    if (c == 0) { return 0; }
    if (load8(c) == 110) { return 0; }
    return 1;
}

fn _dsp_cursor_refusal_a(a, id) {
    return resp_error_a(a, id, 0 - 32602, "invalid cursor: this server returns every item in one page and issues no cursors");
}

# prefix + name + suffix as one message cstr; suffix may be 0.
fn _dsp_named_msg(prefix, name, suffix) { return _dsp_named_msg_a(default_alloc(), prefix, name, suffix); }

fn _dsp_named_msg_a(a, prefix, name, suffix) {
    var sb = str_builder_new_a(a);
    str_builder_add_cstr_a(a, sb, prefix);
    if (name != 0) { str_builder_add_cstr_a(a, sb, name); }
    if (suffix != 0) { str_builder_add_cstr_a(a, sb, suffix); }
    return str_data(str_builder_build_a(a, sb));
}

# The first argument `pdef` declares required that `args_obj` (a JSON
# object) lacks, or 0 when none is missing.
fn _prompt_missing_required(pdef, args_obj) {
    if (pdef == 0) { return 0; }
    var pa = prompt_def_arguments(pdef);
    if (pa == 0) { return 0; }
    var n = vec_len(pa);
    var i = 0;
    while (i < n) {
        var a = vec_get(pa, i);
        if (prompt_arg_required(a) == 1 && jsonx_has(args_obj, prompt_arg_name(a)) == 0) {
            return prompt_arg_name(a);
        }
        i = i + 1;
    }
    return 0;
}

# Build the resources/list response result body.
fn _build_resources_list_result(a, rreg) {
    bote_reg_read();
    var uris = resource_registry_uris(rreg);
    var n = vec_len(uris);
    var room = 32;
    var i = 0;
    while (i < n) {
        var c = _resource_registry_get_u(rreg, vec_get(uris, i));
        room = room + 64 + _dsp_room(resource_def_uri(c)) + _dsp_room(resource_def_name(c));
        room = room + _dsp_room(resource_def_description(c)) + _dsp_room(resource_def_mime_type(c));
        room = room + _dsp_len(resource_def_display(c));
        i = i + 1;
    }
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, room);
    str_builder_add_cstr(sb, "{\"resources\":[");
    i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        var r = _resource_registry_get_u(rreg, vec_get(uris, i));
        str_builder_add_cstr(sb, "{");
        _json_emit_str_field(sb, "uri", resource_def_uri(r));
        str_builder_add_cstr(sb, ",");
        _json_emit_str_field(sb, "name", resource_def_name(r));
        var rdisp = resource_def_display(r);
        if (rdisp != 0) { str_builder_add_cstr(sb, rdisp); }
        var rd = resource_def_description(r);
        if (rd != 0) {
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "description", rd);
        }
        var rm = resource_def_mime_type(r);
        if (rm != 0) {
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "mimeType", rm);
        }
        str_builder_add_cstr(sb, "}");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    bote_reg_read_end();
    return str_data(str_builder_build_a(a, sb));
}

# Build the resources/templates/list response result body.
fn _build_resource_templates_result(a, rreg) {
    bote_reg_read();
    var ts = resource_registry_templates(rreg);
    var n = vec_len(ts);
    var room = 32;
    var i = 0;
    while (i < n) {
        var c = vec_get(ts, i);
        room = room + 64 + _dsp_room(resource_template_uri(c)) + _dsp_room(resource_template_name(c));
        room = room + _dsp_room(resource_template_description(c)) + _dsp_room(resource_template_mime_type(c));
        room = room + _dsp_len(resource_template_display(c));
        i = i + 1;
    }
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, room);
    str_builder_add_cstr(sb, "{\"resourceTemplates\":[");
    i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        var t = vec_get(ts, i);
        str_builder_add_cstr(sb, "{");
        _json_emit_str_field(sb, "uriTemplate", resource_template_uri(t));
        str_builder_add_cstr(sb, ",");
        _json_emit_str_field(sb, "name", resource_template_name(t));
        var tdis = resource_template_display(t);
        if (tdis != 0) { str_builder_add_cstr(sb, tdis); }
        var td = resource_template_description(t);
        if (td != 0) {
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "description", td);
        }
        var tm = resource_template_mime_type(t);
        if (tm != 0) {
            str_builder_add_cstr(sb, ",");
            _json_emit_str_field(sb, "mimeType", tm);
        }
        str_builder_add_cstr(sb, "}");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    bote_reg_read_end();
    return str_data(str_builder_build_a(a, sb));
}

# ================================================================
# dispatch — main entry
# ================================================================
#
# Returns a JsonRpcResponse ptr, or 0 if the request is a notification.

fn dispatcher_dispatch(d, request, claims) {
    return dispatcher_dispatch_a(default_alloc(), d, request, claims);
}

# ================================================================
# MCP 2026-07-28 (3.5.0)
#
# bote serves this revision and the older ones from one process. Each request
# says which it is: `_meta` naming this revision is served statelessly, and
# anything else as it always was. A dual-era client probes with server/discover
# and falls back to `initialize` on any error it does not recognise, so a legacy
# client never sees this path.
#
# The methods are the same code on both paths. A modern result differs by what
# surrounds it: resultType on all of them, `ttlMs` and `cacheScope` on the list
# results and resources/read, and serverInfo in `_meta`.
#
# ttlMs is 0, which tells a client to re-fetch: a promise that a list stays fresh
# needs a way to say it changed, and that is subscriptions/listen (roadmap 3.7.x).
# For the same reason, this path advertises no listChanged. cacheScope is
# "private" because a tool list may differ per authorization context.
# ================================================================

var DSP_META_VERSION = "io.modelcontextprotocol/protocolVersion";
var DSP_META_CAPABILITIES = "io.modelcontextprotocol/clientCapabilities";

# `full` as _dsp_emit_server_info's: 1 on server/discover, 0 on every other result.
fn _dsp_emit_modern_meta(sb, d, full) {
    str_builder_add_cstr(sb, "\"_meta\":{\"io.modelcontextprotocol/serverInfo\":");
    _dsp_emit_server_info(sb, d, full);
    str_builder_add_cstr(sb, "}");
    return 0;
}

fn _build_discover_result_a(a, d) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 512 + _dsp_server_info_room(d, 1) + _dsp_instructions_room(d));
    str_builder_add_cstr(sb, "{\"resultType\":\"complete\",\"supportedVersions\":");
    _mcp_emit_versions(sb);
    str_builder_add_cstr(sb, ",\"capabilities\":");
    # The changes a listen stream carries, where this message's transport carries one
    # (3.7.2; 3.7.3).
    var lc = _dsp_listen_here(d);
    _build_capabilities_sub(sb, d, lc, lc);
    var ins = load64(d + 152);
    if (ins != 0) { str_builder_add_cstr(sb, ins); }
    str_builder_add_cstr(sb, ",");
    _dsp_emit_modern_meta(sb, d, 1);
    str_builder_add_cstr(sb, ",\"ttlMs\":0,\"cacheScope\":\"private\"}");
    return str_data(str_builder_build_a(a, sb));
}

# -32022, naming what bote does serve, so a client can pick from it.
fn _dsp_unsupported_version(a, id, requested) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 128 + strlen(requested) * 6);
    str_builder_add_cstr(sb, "{\"supported\":");
    _mcp_emit_versions(sb);
    str_builder_add_cstr(sb, ",\"requested\":\"");
    _json_emit_escaped(sb, requested);
    str_builder_add_cstr(sb, "\"}");
    return resp_error_data_a(a, id, 0 - 32022, "Unsupported protocol version", str_data(str_builder_build_a(a, sb)));
}

fn _dsp_cacheable(method) {
    if (streq(method, "tools/list") == 1) { return 1; }
    if (streq(method, "prompts/list") == 1) { return 1; }
    if (streq(method, "resources/list") == 1) { return 1; }
    if (streq(method, "resources/templates/list") == 1) { return 1; }
    if (streq(method, "resources/read") == 1) { return 1; }
    return 0;
}

# `result` with this revision's fields added. What a handler already set is left
# alone: a repeated key would make the object ambiguous.
fn _dsp_modern_result(a, d, method, result) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, strlen(result) + 256 + _dsp_server_info_room(d, 0));
    str_builder_add_cstr(sb, "{");
    var sep = "";
    if (jsonx_has(result, "resultType") == 0) {
        str_builder_add_cstr(sb, "\"resultType\":\"complete\"");
        sep = ",";
    }
    # (3.8.2) An InputRequiredResult is no answer to keep.
    if (_dsp_cacheable(method) == 1 && jsonx_has(result, "ttlMs") == 0 && _dsp_input_result(a, result) == 0) {
        str_builder_add_cstr(sb, sep);
        str_builder_add_cstr(sb, "\"ttlMs\":0,\"cacheScope\":\"private\"");
        sep = ",";
    }
    if (jsonx_has(result, "_meta") == 0) {
        str_builder_add_cstr(sb, sep);
        _dsp_emit_modern_meta(sb, d, 0);
        sep = ",";
    }
    var n = strlen(result);
    var i = _jx_skip_ws(result, n, 0) + 1;
    i = _jx_skip_ws(result, n, i);
    if (load8(result + i) != 125) { str_builder_add_cstr(sb, sep); }
    str_builder_add_cstr(sb, result + i);
    return str_data(str_builder_build_a(a, sb));
}

fn _dsp_modern_response(a, d, method, resp) {
    if (resp == 0) { return 0; }
    var err = resp_error_obj(resp);
    if (err != 0) {
        # -32002 is the older revisions' resource-not-found. This one uses
        # -32602, and must not emit -32002 at all.
        if (rpc_err_code(err) == BOTE_RPC_RESOURCE_NOT_FOUND) { store64(err, 0 - 32602); }
        return resp;
    }
    var result = resp_result(resp);
    if (jsonx_is_object(result) == 0) {
        return resp_error_a(a, resp_id(resp), 0 - 32603, "internal error: the handler's result is not an object");
    }
    return resp_success_a(a, resp_id(resp), _dsp_modern_result(a, d, method, result));
}

# What a call gets where HTTP's 403 is out of reach: a batch element, a WebSocket frame.
# Outside the JSON-RPC reserved range, as MCP asks of a code it does not define.
var BOTE_RPC_INSUFFICIENT_SCOPE = 0 - 31403;

# `req`, a vec of scopes, when `claims` does not hold them all, or 0. Each caller has
# returned for claims of 0 first: with no token in play there is nothing to compare, as
# on stdio, which takes its credentials from the environment, and with no validator set.
# A scope required with nothing to read it is refused, not waved through.
fn _dsp_scopes_lacking(d, req, claims) {
    if (req == 0 || vec_len(req) == 0) { return 0; }
    var fp = load64(d + 88);
    if (fp == 0) { return req; }
    var i = 0;
    while (i < vec_len(req)) {
        if (fncall3(fp, claims, vec_get(req, i), load64(d + 96)) != 1) { return req; }
        i = i + 1;
    }
    return 0;
}

# The scopes the tool `name` requires, when `claims` does not hold them all, or 0 when
# it may run, or no such tool is registered.
fn dispatcher_scopes_missing(d, name, claims) {
    if (claims == 0) { return 0; }
    return _dsp_def_scopes_missing(d, registry_get(dispatcher_registry(d), name), claims);
}

# The same for the tool definition `t` a call found, or 0 for none.
fn _dsp_def_scopes_missing(d, t, claims) {
    if (claims == 0 || t == 0) { return 0; }
    return _dsp_scopes_lacking(d, tool_def_required_scopes(t), claims);
}

# The same for the prompt `name` (3.6.6).
fn dispatcher_prompt_scopes_missing(d, name, claims) {
    if (claims == 0 || name == 0 || dispatcher_prompts(d) == 0) { return 0; }
    var p = prompt_registry_get(dispatcher_prompts(d), name);
    if (p == 0) { return 0; }
    return _dsp_scopes_lacking(d, prompt_def_required_scopes(p), claims);
}

# The same for reading `uri`, judged by what would serve it, as resources/read finds that:
# the handler of the resource registered at that URI, else the first template it matches
# (3.6.6). A resource registered with no handler is served by the template, and so is
# judged by it (3.7.0): it was judged by the resource, which may require nothing, and
# served by a template that required a scope.
fn dispatcher_resource_scopes_missing(d, uri, claims) {
    if (claims == 0 || uri == 0 || dispatcher_resources(d) == 0) { return 0; }
    var fp[8];
    return _dsp_scopes_lacking(d, resource_registry_serving(dispatcher_resources(d), uri, &fp), claims);
}

# The same for a completion/complete's `ref`, on `a` (3.6.6): a completion offers what a
# prompt's arguments or a template's variables may be, which is the prompt's or the
# template's to grant. ref/prompt names a prompt; ref/resource names a template by its
# uriTemplate, or a URI, judged as resources/read would.
fn dispatcher_completion_scopes_missing_a(a, d, params, claims) {
    if (claims == 0 || params == 0) { return 0; }
    var ref = jsonx_get_raw_a(a, params, "ref");
    if (ref == 0) { return 0; }
    var kind = jsonx_get_str_dec_a(a, ref, "type");
    if (kind == 0) { return 0; }
    if (streq(kind, "ref/prompt") == 1) {
        return dispatcher_prompt_scopes_missing(d, jsonx_get_str_dec_a(a, ref, "name"), claims);
    }
    if (streq(kind, "ref/resource") == 0) { return 0; }
    var uri = jsonx_get_str_dec_a(a, ref, "uri");
    if (uri == 0 || dispatcher_resources(d) == 0) { return 0; }
    var t = resource_registry_template_named(dispatcher_resources(d), uri);
    if (t != 0) { return _dsp_scopes_lacking(d, resource_template_required_scopes(t), claims); }
    return dispatcher_resource_scopes_missing(d, uri, claims);
}

# Named, because HTTP sends this one -32602 as a 400.
var DSP_CAPS_MISSING = "io.modelcontextprotocol/clientCapabilities is required and must be an object";

# ================================================================
# Multi round-trip requests (3.8.2, MCP 2026-07-28)
# ================================================================

# 1 when `method` may be answered with an InputRequiredResult.
fn _dsp_input_method(method) {
    if (streq(method, "tools/call") == 1) { return 1; }
    if (streq(method, "prompts/get") == 1) { return 1; }
    if (streq(method, "resources/read") == 1) { return 1; }
    return 0;
}

# `v`, a JSON value already checked, on `a` with the spacing between its tokens left out,
# so a client that sends the same value again, compact or pretty, sends the same bytes.
fn _dsp_compact_a(a, v) {
    var n = strlen(v);
    var out = alloc_via(a, n + 1);
    var o = 0;
    var i = 0;
    var instr = 0;
    while (i < n) {
        var c = load8(v + i);
        if (instr == 1) {
            store8(out + o, c);
            o = o + 1;
            if (c == 92 && i + 1 < n) {
                store8(out + o, load8(v + i + 1));
                o = o + 1;
                i = i + 1;
            } elif (c == 34) {
                instr = 0;
            }
        } elif (c != 32 && c != 9 && c != 10 && c != 13) {
            if (c == 34) { instr = 1; }
            store8(out + o, c);
            o = o + 1;
        }
        i = i + 1;
    }
    store8(out + o, 0);
    return out;
}

fn _dsp_bind_part(sb, p) {
    str_builder_add_int(sb, strlen(p));
    str_builder_add_cstr(sb, ":");
    str_builder_add_cstr(sb, p);
    return 0;
}

# What a requestState is bound to, on `a` (3.8.3): the request it was made for and who made
# it, as the spec asks, each part its length and then its bytes, so no part can borrow from
# the next. The request is its method, its target (the tool's or the prompt's name, the
# resource's URI) and its arguments, compact; a retry sends the request again with the
# answers and the state, which are not bound. Who made it is the principal the dispatcher's
# principal function names (dispatcher_set_state_principal), else the token the request
# presented, else no one when the request has no claims. 0 when it has claims and neither
# names anyone: a state bound to no one would open for anyone who holds it.
# Through 3.8.2 the binding was the method, the target and the token, one to a line, so a
# state opened with other arguments, and with claims that were not the token it opened for
# anyone.
fn _dsp_state_binding_a(a, d, method, params, claims) {
    var key = "name";
    if (streq(method, "resources/read") == 1) { key = "uri"; }
    var target = 0;
    if (params != 0) { target = jsonx_get_str_dec_a(a, params, key); }
    if (target == 0) { target = ""; }
    var kind = "n";
    var who = "";
    var p = 0;
    if (load64(d + 200) != 0 && claims != 0) { p = fncall3(load64(d + 200), load64(d + 208), a, claims); }
    if (p != 0) {
        kind = "p";
        who = p;
    } elif (bote_req_token() != 0) {
        kind = "t";
        who = bote_req_token();
    } elif (claims != 0) {
        return 0;
    }
    var args = "{}";
    if (params != 0 && streq(method, "resources/read") == 0) {
        var ar = jsonx_get_raw_a(a, params, "arguments");
        if (ar != 0) { args = _dsp_compact_a(a, ar); }
    }
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, strlen(method) + strlen(target) + strlen(who) + strlen(args) + 96);
    _dsp_bind_part(sb, method);
    _dsp_bind_part(sb, target);
    str_builder_add_cstr(sb, kind);
    _dsp_bind_part(sb, who);
    _dsp_bind_part(sb, args);
    return str_data(str_builder_build_a(a, sb));
}

# Before a 2026-07-28 request is served: what its handler may ask of it, and, on a retry,
# its answers and state judged. A response refusing it, or 0. `inputResponses` is an
# object of the client's results, each an object; `requestState` a string the sealer opens
# for this request and who makes it (_dsp_state_binding_a, with `claims`). The spec makes
# the state attacker-controlled, and a state that does not open is refused here, before any
# handler sees it.
fn _dsp_input_admit_a(a, d, id, method, params, caps, claims) {
    if (_dsp_input_method(method) == 0) {
        bote_req_set_input(caps, 0, 0, 0);
        return 0;
    }
    var payload = 0;
    var answers = 0;
    if (params != 0) {
        var ir = jsonx_get_raw_a(a, params, "inputResponses");
        if (ir != 0) {
            var bad = 0;
            if (jsonx_is_object(ir) == 0) { bad = 1; }
            else {
                # (3.8.4) Each member by its key as written: the walker's pairs leave out one
                # whose key decodes to hold a NUL, which passed unjudged.
                var m = _jx_members_raw_a(a, ir);
                var i = 0;
                while (i < vec_len(m)) {
                    if (vec_get(m, i) == 0 || jsonx_is_object(vec_get(m, i + 2)) == 0) { bad = 1; }
                    i = i + 3;
                }
            }
            if (bad == 1) {
                return resp_error_a(a, id, 0 - 32602, "inputResponses must be an object of the client's results, each an object");
            }
            answers = ir;
        }
        var rs = jsonx_get_raw_a(a, params, "requestState");
        if (rs != 0) {
            var st = jsonx_get_str_dec_a(a, params, "requestState");
            if (st == 0) { return resp_error_a(a, id, 0 - 32602, "requestState must be a string"); }
            var open_fp = load64(d + 184);
            if (open_fp == 0) {
                return resp_error_a(a, id, 0 - 32602, "requestState cannot be verified: this server issues none");
            }
            var obind = _dsp_state_binding_a(a, d, method, params, claims);
            if (obind == 0) {
                _dsp_log_input(method, "requestState bound to no one: the claims name no principal");
                return resp_error_a(a, id, 0 - 32602, "requestState cannot be verified: this request's claims name no one it could be bound to");
            }
            payload = fncall4(open_fp, load64(d + 192), a, obind, st);
            if (payload == 0) {
                _dsp_log_input(method, "requestState did not open");
                return resp_error_a(a, id, 0 - 32602, "requestState did not pass its integrity check, or has expired, or was made for another request");
            }
        }
    }
    bote_req_set_input(caps, 1, payload, answers);
    return 0;
}

fn _dsp_log_input(method, reason) {
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_WARN, "input required refused");
    bote_log_str(&ln, "method", method);
    bote_log_str(&ln, "reason", reason);
    bote_log_emit(&ln);
    return 0;
}

# 1 when the handler's result `r` (valid JSON) says it is an InputRequiredResult, in any of
# its `resultType` members (3.8.3): through 3.8.2 a prompt's, a resource's or a
# completion's result was read by its first, and a client reads its last, so
# `"resultType":"complete","resultType":"input_required"` went out unjudged, its state
# unsealed. One that names it twice is then refused by _dsp_input_out_a.
fn _dsp_input_result(a, r) {
    var info[24];
    if ((_dsp_result_shape(r, &info) & DSP_SHAPE_INPUT) != 0) { return 1; }
    return 0;
}

# What the client is sent for `result`, an InputRequiredResult a handler of `method`
# returned (3.8.2): a response, the result with its state sealed, or the error that refuses
# it. An older revision has no InputRequiredResult: a tool answers with a tool error there
# and anything else with -32603. A handler's mistake is -32603 and a WARN; an input request
# the client did not declare it can take is -32021, naming what it lacks, as the spec says a
# server MUST answer when it would need a capability the client did not declare.
fn _dsp_input_out_a(a, d, id, method, params, result, modern, claims) {
    if (modern == 0 || bote_input_possible() == 0) {
        _dsp_log_input(method, "no input can be asked on this revision or method");
        if (streq(method, "tools/call") == 1) {
            return resp_success_a(a, id, _dsp_tool_error_result_a(a, "the tool needs input, which this protocol revision cannot ask the client for"));
        }
        return resp_error_a(a, id, 0 - 32603, "internal error: the handler asked for input, which this request cannot carry");
    }
    if (_jx_repeats_a(a, result, 0) == 1) {
        _dsp_log_input(method, "a key named twice");
        return resp_error_a(a, id, 0 - 32603, "internal error: the InputRequiredResult names a key twice in one object, or one a client would read another way");
    }
    var reqs = jsonx_get_raw_a(a, result, "inputRequests");
    var st = jsonx_get_raw_a(a, result, "requestState");
    # (3.8.3) Every request, each by its key as written: the walker's pairs leave out a
    # member whose key decodes to hold a NUL, and such a request went out unjudged.
    var m = 0;
    if (reqs != 0 && jsonx_is_object(reqs) == 1) { m = _jx_members_raw_a(a, reqs); }
    var nreq = 0;
    if (m != 0) { nreq = vec_len(m) / 3; }
    if ((reqs != 0 && m == 0) || (st != 0 && load8(st) != 34) || (nreq == 0 && st == 0)) {
        _dsp_log_input(method, "no input requests and no state");
        return resp_error_a(a, id, 0 - 32603, "internal error: an InputRequiredResult holds inputRequests, an object of one or more, or requestState, a string, or both");
    }
    # Each request the spec allows, in the shape a client parses, and the capability it
    # needs, gathered.
    var need = 0;
    var i = 0;
    while (i < nreq * 3) {
        if (vec_get(m, i) == 0) {
            _dsp_log_input(method, "an input request keyed with a NUL");
            return resp_error_a(a, id, 0 - 32603, "internal error: an input request's key holds a NUL");
        }
        var rq = vec_get(m, i + 2);
        var rm = 0;
        if (jsonx_is_object(rq) == 1) { rm = jsonx_get_str_dec_a(a, rq, "method"); }
        if (rm == 0) {
            _dsp_log_input(method, "an input request with no method");
            return resp_error_a(a, id, 0 - 32603, "internal error: an input request is an object naming its method");
        }
        var rp = jsonx_get_raw_a(a, rq, "params");
        # (3.8.3) A client requires params, an object, of an elicitation and a sampling
        # request, and allows them on roots/list.
        var popt = streq(rm, "roots/list");
        if ((rp == 0 && popt == 0) || (rp != 0 && jsonx_is_object(rp) == 0)) {
            _dsp_log_input(method, "an input request without its params");
            return resp_error_a(a, id, 0 - 32603, "internal error: an input request's params are an object, and elicitation/create and sampling/createMessage need them");
        }
        if (streq(rm, "elicitation/create") == 1) {
            var mode = jsonx_get_str_dec_a(a, rp, "mode");
            if (jsonx_has(rp, "mode") == 1 && mode == 0) {
                _dsp_log_input(method, "an elicitation of an unknown mode");
                return resp_error_a(a, id, 0 - 32603, "internal error: an elicitation's mode is form or url");
            }
            if (mode == 0 || streq(mode, "form") == 1) {
                if (bote_client_has("elicitation.form") == 0) { need = need | 1; }
            } elif (streq(mode, "url") == 1) {
                if (bote_client_has("elicitation.url") == 0) { need = need | 2; }
            } else {
                _dsp_log_input(method, "an elicitation of an unknown mode");
                return resp_error_a(a, id, 0 - 32603, "internal error: an elicitation's mode is form or url");
            }
        } elif (streq(rm, "sampling/createMessage") == 1) {
            if (bote_client_has("sampling") == 0) { need = need | 4; }
            elif (jsonx_has(rp, "tools") == 1 && bote_client_has("sampling.tools") == 0) { need = need | 8; }
        } elif (popt == 1) {
            if (bote_client_has("roots") == 0) { need = need | 16; }
        } else {
            _dsp_log_input(method, "an input request the spec does not allow");
            return resp_error_a(a, id, 0 - 32603, "internal error: an input request is elicitation/create, sampling/createMessage or roots/list");
        }
        i = i + 3;
    }
    if (need != 0) { return _dsp_missing_caps_a(a, id, need); }
    if (st == 0) { return resp_success_a(a, id, result); }
    # The state, sealed, in place of the handler's.
    var seal_fp = load64(d + 176);
    if (seal_fp == 0) {
        _dsp_log_input(method, "requestState with no sealer");
        return resp_error_a(a, id, 0 - 32603, "internal error: requestState needs a sealer (dispatcher_set_state_sealer)");
    }
    var sbind = _dsp_state_binding_a(a, d, method, params, claims);
    if (sbind == 0) {
        _dsp_log_input(method, "requestState bound to no one: the claims name no principal");
        return resp_error_a(a, id, 0 - 32603, "internal error: requestState cannot be bound to who is asking: the claims name no principal (dispatcher_set_state_principal)");
    }
    var payload = jsonx_get_str_dec_a(a, result, "requestState");
    var sealed = fncall4(seal_fp, load64(d + 192), a, sbind, payload);
    if (sealed == 0) {
        _dsp_log_input(method, "the sealer refused the state");
        return resp_error_a(a, id, 0 - 32603, "internal error: requestState could not be sealed");
    }
    var mem = _jx_members_raw_a(a, result);
    var sb = str_builder_new_a(a);
    # Room for the sealed state as it is escaped: a sealer is the dispatcher's to choose, and
    # most write Base64url, which escaping leaves as it is. At 3.8.2 the room was six times
    # the state for every sealer.
    var sroom = strlen(sealed);
    if (_dsp_needs_escape(sealed) == 1) { sroom = 6 * sroom; }
    _sb_grow_a(a, sb, strlen(result) + sroom + 64);
    str_builder_add_cstr(sb, "{");
    var sep = 0;
    var k = 0;
    while (k < vec_len(mem)) {
        var mk = vec_get(mem, k);
        if (mk == 0 || streq(mk, "requestState") == 0) {
            if (sep == 1) { str_builder_add_cstr(sb, ","); }
            sep = 1;
            str_builder_add_cstr(sb, "\"");
            str_builder_add_cstr(sb, vec_get(mem, k + 1));
            str_builder_add_cstr(sb, "\":");
            str_builder_add_cstr(sb, vec_get(mem, k + 2));
        }
        k = k + 3;
    }
    if (sep == 1) { str_builder_add_cstr(sb, ","); }
    str_builder_add_cstr(sb, "\"requestState\":\"");
    bote_json_escape(sb, sealed);
    str_builder_add_cstr(sb, "\"}");
    return resp_success_a(a, id, str_data(str_builder_build_a(a, sb)));
}

# 1 when bote_json_escape may write `s` other than as it is: a quote, a backslash, a control
# byte, or any byte past ASCII, which it writes as U+FFFD where it is no UTF-8.
fn _dsp_needs_escape(s) {
    var i = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i);
        if (c < 32 || c == 34 || c == 92 || c >= 128) { return 1; }
        i = i + 1;
    }
    return 0;
}

# -32021, MissingRequiredClientCapability, with `data.requiredCapabilities` in the
# ClientCapabilities shape: `need`'s bits are elicitation form (1), url (2), sampling (4),
# sampling with tools (8) and roots (16).
fn _dsp_missing_caps_a(a, id, need) {
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 160);
    str_builder_add_cstr(sb, "{\"requiredCapabilities\":{");
    var sep = 0;
    if ((need & 3) != 0) {
        str_builder_add_cstr(sb, "\"elicitation\":{");
        if ((need & 1) != 0) { str_builder_add_cstr(sb, "\"form\":{}"); }
        if ((need & 3) == 3) { str_builder_add_cstr(sb, ","); }
        if ((need & 2) != 0) { str_builder_add_cstr(sb, "\"url\":{}"); }
        str_builder_add_cstr(sb, "}");
        sep = 1;
    }
    if ((need & 12) != 0) {
        if (sep == 1) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "\"sampling\":{");
        if ((need & 8) != 0) { str_builder_add_cstr(sb, "\"tools\":{}"); }
        str_builder_add_cstr(sb, "}");
        sep = 1;
    }
    if ((need & 16) != 0) {
        if (sep == 1) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "\"roots\":{}");
    }
    str_builder_add_cstr(sb, "}}");
    return resp_error_data_a(a, id, 0 - 32021, "the request needs client capabilities it did not declare", str_data(str_builder_build_a(a, sb)));
}

# ---- the handler's side: an InputRequiredResult, built (3.8.2) ----------------------
#
# A handler that needs input answers with one, made here on `a` (the request arena, the
# handler's thread's):
#     var ir = bote_input_required_new_a(bote_req_alloc());
#     bote_input_elicit(ir, "confirm", "Deploy?", "{\"type\":\"object\",...}");
#     bote_input_state(ir, "step=2");
#     return bote_input_required_json(ir);
# Each key names one input request; the client's answer to it comes back under that key
# (bote_input_response_a). The state is the handler's own words, which bote seals before it
# goes and opens when it comes back (bote_request_state). The dispatcher judges the result
# before it goes: only the three methods the spec allows, each the client declared it can
# take (-32021 otherwise), and at least one request or a state.
#
# InputRequired (40 bytes): +0 arena, +8 the builder of inputRequests' members, +16 how
# many, +24 the state or 0, +32 unused. A key used twice is refused as the result goes.
fn bote_input_required_new_a(a) {
    var ir = alloc_via(a, 40);
    store64(ir, a);
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 256);
    store64(ir + 8, sb);
    store64(ir + 16, 0);
    store64(ir + 24, 0);
    store64(ir + 32, 0);
    return ir;
}

fn _bote_ir_open(ir, key, method, room) {
    var a = load64(ir);
    var sb = load64(ir + 8);
    _sb_grow_a(a, sb, 6 * strlen(key) + room + 64);
    if (load64(ir + 16) > 0) { str_builder_add_cstr(sb, ","); }
    store64(ir + 16, load64(ir + 16) + 1);
    str_builder_add_cstr(sb, "\"");
    bote_json_escape(sb, key);
    str_builder_add_cstr(sb, "\":{\"method\":\"");
    str_builder_add_cstr(sb, method);
    str_builder_add_cstr(sb, "\",\"params\":");
    return sb;
}

# An elicitation in form mode: `message` for the user and `requested_schema`, a JSON Schema
# object of primitive properties, as raw JSON.
fn bote_input_elicit(ir, key, message, requested_schema) {
    var sb = _bote_ir_open(ir, key, "elicitation/create", 6 * strlen(message) + strlen(requested_schema));
    str_builder_add_cstr(sb, "{\"mode\":\"form\",\"message\":\"");
    bote_json_escape(sb, message);
    str_builder_add_cstr(sb, "\",\"requestedSchema\":");
    str_builder_add_cstr(sb, requested_schema);
    str_builder_add_cstr(sb, "}}");
    return ir;
}

# An elicitation in URL mode: the user is sent to `url`, out of band. The spec has a server
# use this, never a form, for anything sensitive: a password, a key, a token.
fn bote_input_elicit_url(ir, key, message, url) {
    var sb = _bote_ir_open(ir, key, "elicitation/create", 6 * strlen(message) + 6 * strlen(url));
    str_builder_add_cstr(sb, "{\"mode\":\"url\",\"message\":\"");
    bote_json_escape(sb, message);
    str_builder_add_cstr(sb, "\",\"url\":\"");
    bote_json_escape(sb, url);
    str_builder_add_cstr(sb, "\"}}");
    return ir;
}

# A sampling request, its CreateMessageRequestParams as raw JSON. Sampling is deprecated in
# 2026-07-28, and still served.
fn bote_input_sample(ir, key, params) {
    var sb = _bote_ir_open(ir, key, "sampling/createMessage", strlen(params));
    str_builder_add_cstr(sb, params);
    str_builder_add_cstr(sb, "}");
    return ir;
}

# The client's roots. Deprecated in 2026-07-28, and still served.
fn bote_input_roots(ir, key) {
    var sb = _bote_ir_open(ir, key, "roots/list", 0);
    str_builder_add_cstr(sb, "{}}");
    return ir;
}

# What the handler wants back on the retry, as it will read it from bote_request_state.
fn bote_input_state(ir, payload) { store64(ir + 24, payload); return ir; }

# The InputRequiredResult, for the handler to return.
fn bote_input_required_json(ir) {
    var a = load64(ir);
    var sb = str_builder_new_a(a);
    var reqs = str_data(str_builder_build_a(a, load64(ir + 8)));
    var st = load64(ir + 24);
    var room = strlen(reqs) + 96;
    if (st != 0) { room = room + 6 * strlen(st); }
    _sb_grow_a(a, sb, room);
    str_builder_add_cstr(sb, "{\"resultType\":\"input_required\"");
    if (load64(ir + 16) > 0) {
        str_builder_add_cstr(sb, ",\"inputRequests\":{");
        str_builder_add_cstr(sb, reqs);
        str_builder_add_cstr(sb, "}");
    }
    if (st != 0) {
        str_builder_add_cstr(sb, ",\"requestState\":\"");
        bote_json_escape(sb, st);
        str_builder_add_cstr(sb, "\"");
    }
    str_builder_add_cstr(sb, "}");
    return str_data(str_builder_build_a(a, sb));
}

# A request that names a key twice in any object, or a key that is no text (bytes that are
# no UTF-8, a surrogate escape that is not one of a pair), is refused before anything reads
# it (3.8.6). bote's one key scanner reads the first of a repeated key, a handler's parser may
# read the last, and a client decoding UTF-8 reads a key that is no text as U+FFFD, which
# another key may spell: either way the arguments the schema judged and the ones a handler
# acts on would differ. RFC 8259 asks for unique names (§4), I-JSON requires them (RFC 7493
# §2.3), and the stdlib's parser refuses a repeat. It is an invalid request, -32600, and not
# a parse error, which is answered with a null id that leaves a client waiting.
var BOTE_REQ_KEYS_MSG = "invalid request: a key named twice, or one that is no text";

# dispatcher_dispatch with bote's own bytes on `a`. `a` must outlive the response
# and nothing else. Stays on the global heap: what a handler is handed (it may
# keep it) and what a sink is handed (ditto). For a request a consumer built: its
# params are checked for a key named twice here, as the codec checks a whole message.
fn dispatcher_dispatch_a(a, d, request, claims) {
    if (req_is_notification(request) == 1) { return 0; }
    var params = req_params(request);
    if (params != 0 && _dsp_keys_twice(a, params) == 1) {
        return resp_error_a(a, req_id(request), 0 - 32600, BOTE_REQ_KEYS_MSG);
    }
    return _dsp_dispatch_admitted_a(a, d, request, claims);
}

# 1 when `params` name a key twice, or one that is no text (_jx_valid_keys_a). (3.8.13, from
# the 3.8.12 review) Handed an allocator that is no bote arena, the heap a plain form passes,
# it walks on the calling thread's request arena, and keeps nothing there either: the syntax
# walk allocates nothing and the exact walker (_jx_repeats_n_a) gives back what it takes.
# Through 3.8.12 the walk's table for 2,000 keys, 98 KB, stayed on the heap for each call. Not
# the heap forms' scratch, whose lock every plain dispatch would take: a dispatch reads and
# writes the calling thread's request state already.
fn _dsp_keys_twice(a, params) {
    var w = a;
    if (_bote_ar_is(a) == 0) { w = bote_req_alloc(); }
    if (_jx_valid_keys_a(w, params, strlen(params)) == 2) { return 1; }
    return 0;
}

# dispatcher_dispatch_a for a request the codec admitted (`_cdc_admit_l_a`), which has
# checked the whole message for a key named twice: the codec and the HTTP-family
# transports, so no message is walked for it twice.
fn _dsp_dispatch_admitted_a(a, d, request, claims) {
    if (req_is_notification(request) == 1) { return 0; }
    bote_req_set_input(0, 0, 0, 0);
    var params = req_params(request);
    var plen = 0;
    if (params != 0) { plen = strlen(params); }
    # One pass for `_meta` and what tools/call reads, so choosing the era costs that
    # method no second walk of its params, and legacy traffic compares no method here.
    var keys[80];
    store64(&keys, "name");            store64(&keys + 8, 4);
    store64(&keys + 16, "version");    store64(&keys + 24, 7);
    store64(&keys + 32, "arguments");  store64(&keys + 40, 9);
    store64(&keys + 48, "caller_id");  store64(&keys + 56, 9);
    store64(&keys + 64, "_meta");      store64(&keys + 72, 5);
    var pos[40];
    _jx_scan(params, plen, &keys, 5, &pos);

    var meta = _jx_raw_at_a(a, params, plen, load64(&pos + 32));
    if (meta == 0 || jsonx_has(meta, DSP_META_VERSION) == 0) {
        return _dsp_serve_a(a, d, request, claims, &pos, plen, 0);
    }
    var method = req_method(request);
    # `initialize` selects legacy semantics, whatever else it carries.
    if (streq(method, "initialize") == 1) {
        return _dsp_serve_a(a, d, request, claims, &pos, plen, 0);
    }

    # A required field missing or of the wrong type is malformed: -32602.
    var id = req_id(request);
    var pv = jsonx_get_str_dec_a(a, meta, DSP_META_VERSION);
    if (pv == 0) {
        return resp_error_a(a, id, 0 - 32602, "io.modelcontextprotocol/protocolVersion must be a string");
    }
    if (_mcp_is_modern(pv) == 0) {
        # An older revision named per request is that revision's behaviour.
        if (_mcp_is_supported(pv) == 1) {
            return _dsp_serve_a(a, d, request, claims, &pos, plen, 0);
        }
        return _dsp_unsupported_version(a, id, pv);
    }
    var caps = jsonx_get_raw_a(a, meta, DSP_META_CAPABILITIES);
    if (caps == 0 || jsonx_is_object(caps) == 0) {
        return resp_error_a(a, id, 0 - 32602, DSP_CAPS_MISSING);
    }
    # A retry of a request that asked for input brings the answers and the state (3.8.2).
    var refused = _dsp_input_admit_a(a, d, id, method, params, caps, claims);
    if (refused != 0) { return refused; }

    if (streq(method, "server/discover") == 1) {
        return resp_success_a(a, id, _build_discover_result_a(a, d));
    }
    if (streq(method, "subscriptions/listen") == 1) { return _dsp_listen_a(a, d, id, req_params(request), claims); }
    # Removed from this revision, with `initialize`.
    if (streq(method, "ping") == 1) {
        return resp_error_a(a, id, 0 - 32601, "method not found: ping");
    }
    return _dsp_modern_response(a, d, method, _dsp_serve_a(a, d, request, claims, &pos, plen, 1));
}

# ================================================================
# subscriptions/listen (3.7.2, MCP 2026-07-28)
# ================================================================
#
# A client opens a stream for the changes it opts in to: `params.notifications` names
# them, each opt-in, and the server MUST NOT send one it was not asked for. The dispatcher
# judges the request and the transport carries the stream (src/listen.cyr): what comes
# back here is the acknowledgement's `notifications`, the honored subset, which the
# transport sends as the stream's first message. The subset narrows what was asked to
# what this server delivers: a list's change when it has that list, and (3.7.4) a resource's
# update for the URIs of `resourceSubscriptions` it has room for, when it has resources.
#
# A URI is honored when it is a non-empty string with no NUL, at most BOTE_LISTEN_URI_MAX
# bytes decoded, and not a repeat, while there is room: BOTE_LISTEN_URIS of them in
# BOTE_LISTEN_URI_ROOM bytes, each with its NUL, which is what a stream keeps of them. The
# acknowledgement lists exactly those, so a client knows which it will hear of. An update
# names the URI that changed (dispatcher_resource_updated), and reaches every subscription
# to that URI or to one it falls under: the same URI, or one it begins with followed by `/`,
# `?` or `#`, or by anything when it ends in `/`. The spec allows the URI sent to be a
# sub-resource of the one subscribed.

var BOTE_LISTEN_TOOLS = 1;
var BOTE_LISTEN_PROMPTS = 2;
var BOTE_LISTEN_RESOURCES = 4;
var BOTE_LISTEN_UPDATES = 8;
var BOTE_LISTEN_URIS = 32;
var BOTE_LISTEN_URI_ROOM = 4096;
var BOTE_LISTEN_URI_MAX = 1024;
var DSP_LISTEN_FILTER = "Invalid params: 'notifications' is required and must be a valid SubscriptionFilter";

# 1 when `raw`, a field of the filter, is absent or a boolean, and *on_out says whether it
# is `true`.
fn _dsp_listen_flag(raw, on_out) {
    store64(on_out, 0);
    if (raw == 0) { return 1; }
    if (streq(raw, "true") == 1) {
        store64(on_out, 1);
        return 1;
    }
    return streq(raw, "false");
}

# 1 when `raw` is absent or an array of strings.
fn _dsp_listen_strings(raw) {
    if (raw == 0) { return 1; }
    var n = strlen(raw);
    if (n == 0 || load8(raw) != 91) { return 0; }
    var i = _jx_skip_ws(raw, n, 1);
    while (i < n && load8(raw + i) != 93) {
        if (load8(raw + i) != 34) { return 0; }
        i = _jx_array_next(raw, n, i);
    }
    return 1;
}

# The honored subset of a listen request's filter, as BOTE_LISTEN_* bits, or -1 when
# `notifications` is missing or not a SubscriptionFilter. With no claims: see
# _dsp_listen_mask_a.
fn dispatcher_listen_mask_a(a, d, params) { return _dsp_listen_mask_a(a, d, params, 0); }

# The same for a listen made with `claims` (3.7.5): a URI they may not read is not honored.
fn _dsp_listen_mask_a(a, d, params, claims) {
    if (params == 0) { return 0 - 1; }
    var f = jsonx_get_raw_a(a, params, "notifications");
    if (f == 0 || jsonx_is_object(f) == 0) { return 0 - 1; }
    var t[8];
    var p[8];
    var r[8];
    if (_dsp_listen_flag(jsonx_get_raw_a(a, f, "toolsListChanged"), &t) == 0) { return 0 - 1; }
    if (_dsp_listen_flag(jsonx_get_raw_a(a, f, "promptsListChanged"), &p) == 0) { return 0 - 1; }
    if (_dsp_listen_flag(jsonx_get_raw_a(a, f, "resourcesListChanged"), &r) == 0) { return 0 - 1; }
    if (_dsp_listen_strings(jsonx_get_raw_a(a, f, "resourceSubscriptions")) == 0) { return 0 - 1; }
    var mask = 0;
    if (load64(&t) == 1) { mask = mask | BOTE_LISTEN_TOOLS; }
    if (load64(&p) == 1 && dispatcher_prompts(d) != 0) { mask = mask | BOTE_LISTEN_PROMPTS; }
    if (load64(&r) == 1 && dispatcher_resources(d) != 0) { mask = mask | BOTE_LISTEN_RESOURCES; }
    if (dispatcher_resources(d) != 0 && _dsp_listen_uris_a(a, d, jsonx_get_raw_a(a, f, "resourceSubscriptions"), claims) != 0) {
        mask = mask | BOTE_LISTEN_UPDATES;
    }
    return mask;
}

# The string at `pos` of `raw`, decoded on `a`, when it can be a subscription's URI: not
# empty, no NUL. 0 otherwise.
fn _dsp_listen_uri_a(a, raw, n, pos) {
    var s = _jx_str_at_a(a, raw, n, pos);
    if (s == 0) { return 0; }
    var sl = strlen(s);
    var out = alloc_via(a, sl + 1);
    var dn = _jx_unescape_into(s, sl, out);
    if (dn == 0 || strlen(out) != dn) { return 0; }
    return out;
}

# The scopes what would serve `uri` requires, judged as resources/read is (3.7.6): the
# registration's own list, so another registration is another list, or 0 for none.
fn _dsp_uri_scopes(d, uri) {
    if (d == 0 || uri == 0 || dispatcher_resources(d) == 0) { return 0; }
    var fp[8];
    var sc = resource_registry_serving(dispatcher_resources(d), uri, &fp);
    if (sc == 0 || vec_len(sc) == 0) { return 0; }
    return sc;
}

# 1 when what would serve `uri` requires a scope (3.7.5).
fn _dsp_uri_scoped(d, uri) { return _dsp_uri_scopes(d, uri) != 0; }

# The URIs of `raw`, a `resourceSubscriptions` already found to be a list of strings, that
# a stream honors, decoded, on `a`, in the order sent (above). 0 when none is. One the
# `claims` may not read, judged by what would serve it as resources/read judges it, is not
# honored (3.7.5): through 3.7.4 a token without a resource's scope heard of every change
# to it, and learned the URIs behind a scoped template.
fn _dsp_listen_uris_a(a, d, raw, claims) {
    if (raw == 0) { return 0; }
    var n = strlen(raw);
    var out = vec_new_a(a);
    var used = 0;
    var i = _jx_skip_ws(raw, n, 1);
    while (i < n && load8(raw + i) != 93 && vec_len(out) < BOTE_LISTEN_URIS) {
        var u = _dsp_listen_uri_a(a, raw, n, i);
        if (u != 0 && dispatcher_resource_scopes_missing(d, u, claims) != 0) { u = 0; }
        if (u != 0) {
            var ul = strlen(u);
            if (ul <= BOTE_LISTEN_URI_MAX && used + ul + 1 <= BOTE_LISTEN_URI_ROOM && _dsp_listen_seen(out, u) == 0) {
                vec_push_a(a, out, u);
                used = used + ul + 1;
            }
        }
        i = _jx_array_next(raw, n, i);
    }
    if (vec_len(out) == 0) { return 0; }
    return out;
}

fn _dsp_listen_seen(v, u) {
    var i = 0;
    while (i < vec_len(v)) {
        if (streq(vec_get(v, i), u) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# The acknowledgement's params for the bits `mask`: {"notifications":{...}}.
fn bote_listen_ack_params_a(a, mask) { return bote_listen_ack_uris_a(a, mask, 0); }

# The same, with the honored URIs `uris` (a vec of decoded strings, or 0) as its
# `resourceSubscriptions` when `mask` has BOTE_LISTEN_UPDATES (3.7.4).
fn bote_listen_ack_uris_a(a, mask, uris) {
    var sb = str_builder_new_a(a);
    var room = 160;
    var k = 0;
    while (uris != 0 && k < vec_len(uris)) {
        room = room + strlen(vec_get(uris, k)) * 6 + 3;
        k = k + 1;
    }
    _sb_grow_a(a, sb, room);
    str_builder_add_cstr(sb, "{\"notifications\":{");
    var sep = "";
    if ((mask & BOTE_LISTEN_TOOLS) != 0) {
        str_builder_add_cstr(sb, "\"toolsListChanged\":true");
        sep = ",";
    }
    if ((mask & BOTE_LISTEN_PROMPTS) != 0) {
        str_builder_add_cstr(sb, sep);
        str_builder_add_cstr(sb, "\"promptsListChanged\":true");
        sep = ",";
    }
    if ((mask & BOTE_LISTEN_RESOURCES) != 0) {
        str_builder_add_cstr(sb, sep);
        str_builder_add_cstr(sb, "\"resourcesListChanged\":true");
        sep = ",";
    }
    if ((mask & BOTE_LISTEN_UPDATES) != 0 && uris != 0) {
        str_builder_add_cstr(sb, sep);
        str_builder_add_cstr(sb, "\"resourceSubscriptions\":[");
        k = 0;
        while (k < vec_len(uris)) {
            if (k > 0) { str_builder_add_cstr(sb, ","); }
            str_builder_add_cstr(sb, "\"");
            bote_json_escape(sb, vec_get(uris, k));
            str_builder_add_cstr(sb, "\"");
            k = k + 1;
        }
        str_builder_add_cstr(sb, "]");
    }
    str_builder_add_cstr(sb, "}}");
    return str_data(str_builder_build_a(a, sb));
}

# Say the resource at `uri` has changed (3.7.4): every listen subscribed to it, or to a
# resource it falls under, is sent `notifications/resources/updated` naming it. Any thread
# may call it; nothing keeps `uri`. 0, or -1 for no URI.
fn dispatcher_resource_updated(d, uri) {
    if (uri == 0 || load8(uri) == 0) { return 0 - 1; }
    return event_sink_updated(dispatcher_event_sink(d), uri);
}

# 1 when this message came on a transport that can carry a listen stream for `d`
# (bote_req_stream): an HTTP transport, when `d` has a hub (3.7.2), or a connection that
# is itself the stream (3.7.3).
fn _dsp_listen_here(d) {
    var st = bote_req_stream();
    if (st == 0) { return 0; }
    if (st == 1) { return dispatcher_listen(d) != 0; }
    return 1;
}

# A subscriptions/listen request: -32601 where this message's transport carries no stream
# (_dsp_listen_here), -32602 for a filter that is not one, else a response whose result is
# the acknowledgement's params, for the transport to open the stream with. It is no answer
# to send as it is.
fn _dsp_listen_a(a, d, id, params, claims) {
    if (_dsp_listen_here(d) == 0) { return resp_error_a(a, id, 0 - 32601, "method not found: subscriptions/listen"); }
    # MCP's ids are never null (3.7.4), and a subscription's id is how it is cancelled.
    if (streq(id, "null") == 1) { return resp_error_a(a, id, 0 - 32600, "invalid request: a subscriptions/listen id must not be null"); }
    var mask = _dsp_listen_mask_a(a, d, params, claims);
    if (mask < 0) { return resp_error_a(a, id, 0 - 32602, DSP_LISTEN_FILTER); }
    var uris = 0;
    if ((mask & BOTE_LISTEN_UPDATES) != 0) {
        uris = _dsp_listen_uris_a(a, d, jsonx_get_raw_a(a, jsonx_get_raw_a(a, params, "notifications"), "resourceSubscriptions"), claims);
    }
    bote_req_set_listen_claims(claims);
    return resp_success_a(a, id, bote_listen_ack_uris_a(a, mask, uris));
}

# The methods themselves, for both eras: what differs between them is around this,
# and what `modern` (1 for 2026-07-28) says inside it: the shapes of an outputSchema
# and a structuredContent (3.8.0). `pos` is the router's pass over the params: name,
# version, arguments, caller_id.
fn _dsp_serve_a(a, d, request, claims, pos, plen, modern) {
    var id = req_id(request);
    var method = req_method(request);
    var params = req_params(request);
    var reg = dispatcher_registry(d);

    if (streq(method, "tools/call") == 1) {
        var name = _jx_str_dec_at_a(a, params, plen, load64(pos));
        if (name == 0 || strlen(name) == 0) {
            var ne = bote_err_new_a(a, BOTE_ERR_INVALID_PARAMS, "", "missing or empty 'name' field");
            return resp_error_a(a, id, bote_err_rpc_code(bote_err_tag(ne)), str_data(bote_err_format_a(a, ne)));
        }

        # The tool, its handler and the version asked for, from one look (3.7.2): the
        # whole call is judged by and served by what this found.
        var ver = _jx_str_dec_at_a(a, params, plen, load64(pos + 8));
        var ver_ok[8];
        var has_fp[8];
        var fp_slot[8];
        var t = _dsp_tool_serving(a, d, name, ver, &ver_ok, &has_fp, &fp_slot);

        # Ahead of everything else about the call: a token that may not run this tool
        # learns nothing about its arguments. HTTP answers this with a 403 before it
        # gets here, and this is what a batch and a WebSocket reach.
        if (_dsp_def_scopes_missing(d, t, claims) != 0) {
            var smsg = _dsp_named_msg_a(a, "insufficient scope for tool: ", name, 0);
            _dsp_record_refusal(d, name, params, plen, load64(pos + 24), smsg);
            return resp_error_a(a, id, BOTE_RPC_INSUFFICIENT_SCOPE, smsg);
        }

        # Optional: version negotiation
        if (load64(&ver_ok) == 0) {
            var sb = str_builder_new_a(a);
            str_builder_add_cstr_a(a, sb, "version '");
            str_builder_add_cstr_a(a, sb, ver);
            str_builder_add_cstr_a(a, sb, "' not found");
            var verr = bote_err_new_a(a, BOTE_ERR_INVALID_PARAMS, name, str_data(str_builder_build_a(a, sb)));
            return resp_error_a(a, id, bote_err_rpc_code(bote_err_tag(verr)), str_data(bote_err_format_a(a, verr)));
        }

        # Extract arguments (default to "{}" if absent), caller_id (optional).
        # On the arena for now: every refusal below leaves nothing behind.
        var args = _jx_raw_at_a(a, params, plen, load64(pos + 16));
        if (args == 0) { args = "{}"; }
        var caller_id = 0;

        # A non-object `arguments` breaks CallToolRequest's own schema: the
        # request is malformed, which is a protocol error.
        if (jsonx_is_object(args) == 0) {
            return resp_error_a(a, id, 0 - 32602, _dsp_named_msg_a(a, "'arguments' must be an object for tool '", name, "'"));
        }

        # Validate. An unknown tool is a protocol error (-32602). Arguments
        # that fail the tool's inputSchema are a tool execution error: a
        # result with isError, so the model sees what it got wrong and can
        # retry (MCP 2025-11-25, SEP-1303). They were a -32602 protocol
        # error through 3.4.4.
        var verr2 = registry_validate_def_a(a, t, name, args);
        if (verr2 != 0) {
            var vmsg = str_data(bote_err_format_a(a, verr2));
            _dsp_record_refusal(d, name, params, plen, load64(pos + 24), vmsg);
            if (bote_err_tag(verr2) == BOTE_ERR_TOOL_NOT_FOUND) {
                return resp_error_a(a, id, bote_err_rpc_code(BOTE_ERR_TOOL_NOT_FOUND), vmsg);
            }
            return resp_success_a(a, id, _dsp_tool_error_result_a(a, vmsg));
        }

        # Deprecation event (best-effort; never blocks dispatch)
        if (t != 0) {
            var dep = tool_def_deprecated(t);
            if (dep != 0) {
                var ds = str_builder_new_a(a);
                _sb_grow_a(a, ds, (strlen(name) + strlen(dep)) * 6 + 64);
                str_builder_add_cstr_a(a, ds, "{\"tool_name\":\"");
                _json_emit_escaped(ds, name);
                str_builder_add_cstr_a(a, ds, "\",\"message\":\"");
                _json_emit_escaped(ds, dep);
                str_builder_add_cstr_a(a, ds, "\"}");
                event_sink_publish(dispatcher_event_sink(d), TOPIC_TOOL_DEPRECATED(),
                  str_data(str_builder_build_a(a, ds)));
            }
        }

        # Dispatch with timing + audit + event hooks.
        #
        # 3.4.1: the duration and the tool-call event exist only for an audit
        # or event sink. With neither installed nobody reads them, so skip the
        # two clock reads and the event build. Each clock read is a
        # clock_gettime syscall, measured at 1.35 µs on the reference host —
        # together over half of an unobserved tools/call.
        var audit_on = _dsp_sink_live(dispatcher_audit_sink(d));
        var events_on = _dsp_sink_wants_calls(dispatcher_event_sink(d));
        var t_start = 0;
        if (audit_on == 1 || events_on == 1) {
            t_start = clock_now_ns();
            # A sink may keep what it is handed.
            name = _jx_str_dec_at_a(default_alloc(), params, plen, load64(pos));
            caller_id = _jx_str_at_a(default_alloc(), params, plen, load64(pos + 24));
        }
        var fp = load64(&fp_slot);
        if (load64(&has_fp) == 0) {
            var nf = bote_err_new_a(a, BOTE_ERR_TOOL_NOT_FOUND, name, 0);
            var msg_nh = str_data(bote_err_format_a(a, nf));
            if (audit_on == 1 || events_on == 1) {
                var dur_nh = (clock_now_ns() - t_start) / 1000000;
                var ev_nh = tool_call_event_new(name, dur_nh, 0, msg_nh, caller_id);
                if (audit_on == 1) { audit_sink_log(dispatcher_audit_sink(d), ev_nh); }
                if (events_on == 1) {
                    event_sink_publish(dispatcher_event_sink(d), TOPIC_TOOL_FAILED(),
                      tool_call_event_to_json(ev_nh));
                }
            }
            return resp_error_a(a, id, bote_err_rpc_code(bote_err_tag(nf)), msg_nh);
        }
        # A handler may keep `args` (2.0 ABI), so it reaches the heap here,
        # past every refusal, and not before.
        args = _slice_cstr(default_alloc(), args, 0, strlen(args));
        # 2.0 ABI: fncall2 with claims (always 0 in 2.0; populated in 2.x)
        # Whatever the handler returned, the client gets a CallToolResult
        # (_dsp_coerce_result, 3.4.8). A failed call — no result, invalid
        # JSON, or a result carrying isError — is audited and published as
        # a failure.
        var fail_slot[8];
        var keep = 0;
        if (audit_on == 1 || events_on == 1) { keep = 1; }
        var rinfo[24];
        var result = _dsp_coerce_result(a, t, name, fncall2(fp, args, bote_req_claims_kept(claims)), &fail_slot, keep, &rinfo);
        # Judged by the tool's outputSchema, and shaped for this revision (3.8.0).
        result = _dsp_tool_result_out_a(a, t, name, result, &fail_slot, modern, keep, &rinfo);
        var no_result = load64(&fail_slot);
        var input = load64(&rinfo + 16) & DSP_SHAPE_INPUT;
        # A round that asks for input did not complete (3.8.2), as a cancelled call did not.
        if (input != 0) { no_result = "input required"; }
        # A call its handler found cancelled did not complete, whatever it returned (3.7.5).
        # Only the sinks read it.
        if ((audit_on == 1 || events_on == 1) && bote_req_was_cancelled() == 1) { no_result = "cancelled"; }
        if (audit_on == 1 || events_on == 1) {
            var dur_ms = (clock_now_ns() - t_start) / 1000000;
            if (no_result == 0) {
                var ev_ok = tool_call_event_new(name, dur_ms, 1, 0, caller_id);
                if (audit_on == 1) { audit_sink_log(dispatcher_audit_sink(d), ev_ok); }
                if (events_on == 1) {
                    event_sink_publish(dispatcher_event_sink(d), TOPIC_TOOL_COMPLETED(),
                      tool_call_event_to_json(ev_ok));
                }
            } else {
                var ev_nr = tool_call_event_new(name, dur_ms, 0, no_result, caller_id);
                if (audit_on == 1) { audit_sink_log(dispatcher_audit_sink(d), ev_nr); }
                if (events_on == 1) {
                    event_sink_publish(dispatcher_event_sink(d), TOPIC_TOOL_FAILED(),
                      tool_call_event_to_json(ev_nr));
                }
            }
        }
        if (input != 0) { return _dsp_input_out_a(a, d, id, method, params, result, modern, claims); }
        return resp_success_a(a, id, result);
    }

    if (streq(method, "initialize") == 1) {
        return resp_success_a(a, id, _build_initialize_result_a(a, d, params));
    }

    # ping — the MCP keepalive. The receiver MUST answer promptly with an
    # empty result; a client that gets an error back reads the server as
    # unhealthy and may tear the session down.
    #
    # Deliberately ahead of every capability gate and taking no params: a
    # ping has to work on a bare dispatcher with no registries wired, which
    # is the state a client probes during startup. Emits no audit or event
    # record — it is liveness, not activity, and a keepalive every few
    # seconds would swamp the chain.
    #
    # bote answers pings; it does not originate them. Server→client pings
    # need the push path that real-time streaming brings (roadmap 3.7.x).
    if (streq(method, "ping") == 1) {
        return resp_success_a(a, id, "{}");
    }

    if (streq(method, "tools/list") == 1) {
        if (_dsp_cursor_given(params) == 1) { return _dsp_cursor_refusal_a(a, id); }
        var lprofile = 0;
        if (params != 0) { lprofile = jsonx_get_str_a(a, params, "profile"); }
        return resp_success_a(a, id, _build_tools_list_result_a(a, reg, lprofile, modern));
    }

    # prompts/* only when the prompts capability is enabled (a PromptRegistry
    # is present). Otherwise fall through to method-not-found (-32601), which
    # matches the un-advertised capability.
    if (streq(method, "prompts/list") == 1 && dispatcher_prompts(d) != 0) {
        if (_dsp_cursor_given(params) == 1) { return _dsp_cursor_refusal_a(a, id); }
        return resp_success_a(a, id, _build_prompts_list_result(a, dispatcher_prompts(d)));
    }

    if (streq(method, "prompts/get") == 1 && dispatcher_prompts(d) != 0) {
        var pname = jsonx_get_str_dec_a(a, params, "name");
        if (pname == 0 || strlen(pname) == 0) {
            var pe = bote_err_new_a(a, BOTE_ERR_INVALID_PARAMS, "", "missing or empty 'name' field");
            return resp_error_a(a, id, bote_err_rpc_code(bote_err_tag(pe)), str_data(bote_err_format_a(a, pe)));
        }
        # The prompt and its handler from one look (3.7.2), as for a tool.
        var ph_slot[8];
        var pdef = prompt_registry_serving(dispatcher_prompts(d), pname, &ph_slot);
        var phandler = load64(&ph_slot);
        if (phandler == 0) {
            return resp_error_a(a, id, 0 - 32602, _dsp_named_msg_a(a, "prompt not found: ", pname, 0));
        }
        # As for a tool: a token that may not get this prompt learns nothing past its name.
        if (claims != 0 && pdef != 0 && _dsp_scopes_lacking(d, prompt_def_required_scopes(pdef), claims) != 0) {
            return resp_error_a(a, id, BOTE_RPC_INSUFFICIENT_SCOPE, _dsp_named_msg_a(a, "insufficient scope for prompt: ", pname, 0));
        }
        var pargs = jsonx_get_raw_a(a, params, "arguments");
        if (pargs == 0) { pargs = "{}"; }
        # The MCP prompts spec: invalid prompt name and missing required
        # arguments are both -32602 (3.4.5 added the second; the handler
        # used to be called without them).
        if (jsonx_is_object(pargs) == 0) {
            return resp_error_a(a, id, 0 - 32602, _dsp_named_msg_a(a, "'arguments' must be an object for prompt '", pname, "'"));
        }
        var pmissing = _prompt_missing_required(pdef, pargs);
        if (pmissing != 0) {
            var pmb = str_builder_new_a(a);
            str_builder_add_cstr_a(a, pmb, "missing required argument '");
            str_builder_add_cstr_a(a, pmb, pmissing);
            str_builder_add_cstr_a(a, pmb, "' for prompt '");
            str_builder_add_cstr_a(a, pmb, pname);
            str_builder_add_cstr_a(a, pmb, "'");
            return resp_error_a(a, id, 0 - 32602, str_data(str_builder_build_a(a, pmb)));
        }
        # Past every refusal: a handler may keep what it is handed.
        pargs = _slice_cstr(default_alloc(), pargs, 0, strlen(pargs));
        var presult = fncall2(phandler, pargs, bote_req_claims_kept(claims));
        if (presult == 0) { presult = "{\"messages\":[]}"; }
        return _dsp_served_result(a, d, id, method, params, presult, modern, claims);
    }

    # resources/* only when the resources capability is enabled (a
    # ResourceRegistry is present). Otherwise fall through to -32601.
    if (streq(method, "resources/list") == 1 && dispatcher_resources(d) != 0) {
        if (_dsp_cursor_given(params) == 1) { return _dsp_cursor_refusal_a(a, id); }
        return resp_success_a(a, id, _build_resources_list_result(a, dispatcher_resources(d)));
    }

    if (streq(method, "resources/read") == 1 && dispatcher_resources(d) != 0) {
        var ruri = jsonx_get_str_dec_a(a, params, "uri");
        if (ruri == 0 || strlen(ruri) == 0) {
            var re = bote_err_new_a(a, BOTE_ERR_INVALID_PARAMS, "", "missing or empty 'uri' field");
            return resp_error_a(a, id, bote_err_rpc_code(bote_err_tag(re)), str_data(bote_err_format_a(a, re)));
        }
        # What serves the URI and the scopes it requires, from one look (3.7.2).
        var rh_slot[8];
        var rscopes = resource_registry_serving(dispatcher_resources(d), ruri, &rh_slot);
        var rhandler = load64(&rh_slot);
        if (rhandler == 0) {
            # -32002 with the URI in `data`, as the MCP resources spec has
            # it. It was -32602 through 3.4.4.
            var rdb = str_builder_new_a(a);
            _sb_grow_a(a, rdb, strlen(ruri) * 6 + 16);
            str_builder_add_cstr_a(a, rdb, "{\"uri\":\"");
            _json_emit_escaped(rdb, ruri);
            str_builder_add_cstr_a(a, rdb, "\"}");
            return resp_error_data_a(a, id, BOTE_RPC_RESOURCE_NOT_FOUND,
              _dsp_named_msg_a(a, "resource not found: ", ruri, 0), str_data(str_builder_build_a(a, rdb)));
        }
        if (claims != 0 && _dsp_scopes_lacking(d, rscopes, claims) != 0) {
            return resp_error_a(a, id, BOTE_RPC_INSUFFICIENT_SCOPE, _dsp_named_msg_a(a, "insufficient scope for resource: ", ruri, 0));
        }
        # Past every refusal: a handler may keep what it is handed.
        ruri = _slice_cstr(default_alloc(), ruri, 0, strlen(ruri));
        var rresult = fncall2(rhandler, ruri, bote_req_claims_kept(claims));
        if (rresult != 0 && jsonx_valid(rresult, strlen(rresult)) == 1 && _dsp_input_result(a, rresult) == 1) {
            return _dsp_input_out_a(a, d, id, method, params, _dsp_one_line(a, rresult), modern, claims);
        }
        if (rresult == 0) { rresult = "{\"contents\":[]}"; }
        return _dsp_checked_result(a, id, rresult);
    }

    # resources/templates/list. An empty list when none is registered: this used to
    # be -32601, which some clients send whenever `resources` is advertised and read
    # as a server failure. Gated like the other resources/* methods, and refuses a
    # pagination `cursor` like the other list methods.
    if (streq(method, "resources/templates/list") == 1 && dispatcher_resources(d) != 0) {
        if (_dsp_cursor_given(params) == 1) { return _dsp_cursor_refusal_a(a, id); }
        return resp_success_a(a, id, _build_resource_templates_result(a, dispatcher_resources(d)));
    }

    # completion/complete only when a completion handler is set. The handler
    # receives the raw params ({ref, argument, ...}) and returns the full
    # {"completion":{"values":[...]}} body. Otherwise fall through to -32601.
    if (streq(method, "completion/complete") == 1 && dispatcher_completion(d) != 0) {
        if (jsonx_is_object(params) == 0) {
            return resp_error_a(a, id, 0 - 32602, "completion/complete params must be an object");
        }
        if (dispatcher_completion_scopes_missing_a(a, d, params, claims) != 0) {
            return resp_error_a(a, id, BOTE_RPC_INSUFFICIENT_SCOPE, "insufficient scope for completion: the prompt or resource it names");
        }
        var cparams = _slice_cstr(default_alloc(), params, 0, strlen(params));
        var cresult = fncall2(dispatcher_completion(d), cparams, bote_req_claims_kept(claims));
        if (cresult == 0) { cresult = "{\"completion\":{\"values\":[]}}"; }
        if (cresult != 0 && jsonx_valid(cresult, strlen(cresult)) == 1 && _dsp_input_result(a, cresult) == 1) {
            # (3.8.2) Only tools/call, prompts/get and resources/read may ask for input.
            _dsp_log_input(method, "completion/complete asked for input");
            return resp_error_a(a, id, 0 - 32603, "internal error: completion/complete may not ask for input");
        }
        return _dsp_checked_result(a, id, cresult);
    }

    # The router answers it for a request that named this revision.
    if (streq(method, "server/discover") == 1) {
        return resp_error_a(a, id, 0 - 32602, "server/discover needs _meta naming 2026-07-28 and clientCapabilities");
    }

    # Unknown method — JSON-RPC §5.1
    var sb = str_builder_new_a(a);
    _sb_grow_a(a, sb, 128);
    str_builder_add_cstr_a(a, sb, "method not found: ");
    str_builder_add_cstr_a(a, sb, method);
    return resp_error_a(a, id, 0 - 32601, str_data(str_builder_build_a(a, sb)));
}
