# bote — MCP Core Service (Cyrius port)
#
# 2.7.x — feature line. 2.7.0 closes carry-forward items from the
# 1.9.6 / 2.5.1 eras: annotations preservation through
# wrap_tool_result; schema_compile + auth_bearer_check benchmarks;
# CHANGELOG [Unreleased] flow.
#
# 2.6.x modernization arc:
#   - 2.6.0: cyrius 5.10.34 + libro 2.6.2 / majra 2.4.3 dist bundles
#   - 2.6.1: retired src/_sandhi_compat.cyr; all HTTP-server call
#     sites now use the direct sandhi_server_* names from lib/sandhi.cyr
#   - 2.6.2: src/libro_tools.cyr ported to libro 2.6.x (raw struct
#     offsets for the retired entry_*/error_*/merkle_* getters);
#     tests/bote_libro_tools.tcyr (38 assertions as of 3.3.4) re-enabled. At this
#     point libro_tools was still held out of main.cyr by default —
#     an opt-in module, kept out for fn_table headroom (89% util).
#   - 2.7.5: libro_tools folded back into the default binary and the
#     dist/bote.cyr bundle. The 6.1.x cap raise dropped fn_table util
#     to 58%/60%, so the headroom argument no longer holds. main()
#     now stands up a libro chain and registers all five audit tools.
#   - 2.6.3: ships dist/bote.cyr via `cyrius distlib` so downstream
#     consumers can `[deps.bote] modules = ["dist/bote.cyr"]`.
#     Mirrors the libro / majra distribution contract.
#   - 2.6.4: closes the modernization arc. CI capacity gate enforces
#     fn_table + identifier-buffer utilisation < 95% via
#     CYRIUS_STATS=1 + a parser step in ci.yml. The split / feature-gate
#     options stay on the shelf as documented response paths if the
#     gate ever fires.
# Live integration is unchanged at the API surface — audit_libro
# and events_majra both call into the same chain_*/pubsub_* names
# they always have. See src/audit_libro.cyr + src/events_majra.cyr.

# stdlib + libro + majra includes are auto-injected by cyrius from
# cyrius.cyml [deps] — no manual lib/ includes needed (2.7.2).
# log.cyr is first: every module below may log through it (3.4.0).
include "src/log.cyr"
include "src/error.cyr"
include "src/protocol.cyr"
include "src/jsonx.cyr"
include "src/registry.cyr"
include "src/prompts.cyr"
include "src/resources.cyr"
include "src/events.cyr"
include "src/audit.cyr"
include "src/audit_libro.cyr"
include "src/events_majra.cyr"
include "src/dispatch.cyr"
include "src/codec.cyr"
include "src/schema.cyr"
include "src/stream.cyr"
include "src/session.cyr"
include "src/discovery.cyr"
include "src/auth.cyr"
# jwt.cyr + pkce.cyr — 3.2.0. `[package].description` has advertised
# "JWT HS256 + RFC 7636 PKCE" since 2.2.0, but neither module was in
# any main entry or in `[lib]` / `[lib.core]`, so no consumer could
# reach either one: `grep -c '^fn jwt_verify_hs256' dist/bote.cyr
# dist/bote-core.cyr` returned 0 and 0. They ship now.
#
# Placed after auth.cyr because jwt implements auth's validator ABI
# (`fn validator(token, ctx) -> claims | 0`, src/auth.cyr) — though the
# coupling is one-way: auth.cyr names no jwt symbol, so only jsonx
# (for the claim readers) and chrono (for `exp`) are hard ordering
# constraints, and both sit far earlier in this list.
#
# NOT added to `[lib.core]`: that profile's documented stdlib footprint
# excludes sigil (see DEPS-PATTERN.md), and both modules need it —
# jwt for `hmac_sha256`, pkce for `sha256`. That is a decision, not an
# oversight; a core-bundle consumer wanting JWT would have to argue for
# pulling the whole sigil bundle into the transport-free profile.
include "src/jwt.cyr"
include "src/pkce.cyr"
# conn.cyr — per-connection send / idle deadlines every transport applies (3.4.3).
include "src/conn.cyr"
include "src/transport_stdio.cyr"
include "src/transport_http.cyr"
include "src/transport_unix.cyr"
include "src/bridge.cyr"
# 3.4.2: streamable HTTP and WebSocket are back in this entry. From 2.7.2
# they lived in their own binaries (src/main_streamable.cyr /
# src/main_ws.cyr), a workaround for the cyrius 5.10.x 2 MB compile-source
# cap that the 6.1.24 cap raise made unnecessary. Same order as [lib].
include "src/transport_streamable.cyr"
include "src/transport_ws.cyr"
# libro_tools.cyr — five built-in MCP audit tools (libro_query /
# verify / export / proof / retention) over a live libro chain.
# Folded back into the default binary at 2.7.5: the fn_table-headroom
# reason it was held out (89% util at 2.6.2) evaporated under the
# 6.1.x cap raise — src/main.cyr now sits at 58%/60%, far under the
# 95% gate. Ported to the libro 2.x API at 2.6.2 (raw struct offsets
# for the retired entry_*/error_*/merkle_* getters); covered by
# tests/bote_libro_tools.tcyr.
include "src/content.cyr"
include "src/host.cyr"
include "src/libro_tools.cyr"
include "src/fs_tools.cyr"
include "src/web_tools.cyr"
include "src/main_common.cyr"

fn main() {
    alloc_init();
    args_init();
    # BOTE_LOG / BOTE_LOG_FILE -> sakshi (3.4.0). Lines go to stderr, never
    # stdout, which is the JSON-RPC wire on the stdio transport.
    bote_main_log_init();
    # BOTE_SEND_TIMEOUT_MS / BOTE_UNIX_IDLE_MS -> src/conn.cyr (3.4.3).
    bote_main_conn_from_env();

    # Mode selection (src/main_common.cyr bote_main_mode):
    #   bote                       stdio (default)
    #   bote stdio                 stdio
    #   bote http [port]           HTTP (default 8390)
    #   bote unix <path>           Unix socket
    #   bote bridge [port]         TS bridge with CORS (default 8391)
    #   bote streamable [port]     Streamable HTTP / SSE (default 8392)
    #   bote ws [port]             WebSocket (default 8393)
    # `bote-streamable [port]` and `bote-ws [port]`, the two binaries folded
    # in here at 3.4.2, still work as argv[0] aliases (build-all.sh links them).
    var mode_slot[8]; var arg_slot[8];
    bote_main_mode(&mode_slot, &arg_slot);
    var mode = load64(&mode_slot);
    var arg = load64(&arg_slot);

    # Bearer-token auth wiring (opt-in via env var).
    # Set BOTE_BEARER_TOKENS=tok-a,tok-b,tok-c to require any of those
    # tokens on every HTTP-family transport (http / bridge / streamable
    # / ws). Stdio + unix sockets are local-only and don't get the check.
    var auth_fp_slot[8]; var auth_ctx_slot[8];
    store64(&auth_fp_slot, 0); store64(&auth_ctx_slot, 0);
    _bote_bearer_from_env(&auth_fp_slot, &auth_ctx_slot);
    var bearer_fp = load64(&auth_fp_slot);
    var bearer_ctx = load64(&auth_ctx_slot);

    # streamable and ws keep the tool set they had as separate binaries:
    # the echo / greeting / info references only. The libro, fs and web
    # tools below are registered for stdio / http / unix / bridge, as they
    # always were. (Whether the two should expose those tools as well is an
    # open roadmap decision, not something a consolidation changes.)
    if (streq(mode, "streamable") == 1) {
        var sdisp = bote_dispatcher_with_echo();
        # Server→client notification wiring. A SessionStore gives each
        # client a per-session outbound buffer; the client-notification
        # EventSink pushes notifications/tools/list_changed into those
        # buffers on a tool-set change, drained on the session's next SSE
        # GET. Enabling the store also activates MCP session lifecycle:
        # `initialize` mints an MCP-Session-Id and subsequent requests
        # (incl. the GET stream) must present it.
        var session_store = session_store_default();
        dispatcher_set_events(sdisp, strm_notify_sink(session_store));
        # This transport has a drain path, so it may honestly advertise
        # tools/prompts listChanged (no other mode sets this).
        dispatcher_set_notifications(sdisp, 1);
        var sport = 8392;
        if (arg != 0) { sport = bote_main_port(arg, 8392); }
        var scfg = streamable_config_new("/mcp", INADDR_LOOPBACK(), sport);
        streamable_config_with_session_store(scfg, session_store);
        if (bearer_fp != 0) { streamable_config_with_bearer_validator(scfg, bearer_fp, bearer_ctx); }
        bote_main_log_start("streamable", sport, 0, bearer_fp != 0);
        return bote_main_log_exit("streamable", transport_streamable_run(sdisp, scfg));
    }
    if (streq(mode, "ws") == 1) {
        var wdisp = bote_dispatcher_with_echo();
        var wport = 8393;
        if (arg != 0) { wport = bote_main_port(arg, 8393); }
        var wcfg = ws_config_new("/mcp", INADDR_LOOPBACK(), wport);
        if (bearer_fp != 0) { ws_config_with_bearer_validator(wcfg, bearer_fp, bearer_ctx); }
        bote_main_log_start("ws", wport, 0, bearer_fp != 0);
        return bote_main_log_exit("ws", transport_ws_run(wdisp, wcfg));
    }

    var dispatcher = bote_dispatcher_with_echo();

    # libro audit tools (2.7.5): stand up an in-memory libro chain and
    # register libro_query / verify / export / proof / retention on the
    # dispatcher.
    var libro_chain = chain_new();
    libro_tools_init(libro_chain);
    libro_tools_register(dispatcher);

    # Filesystem tools (fs_write / fs_read / fs_mkdir), confined to
    # BOTE_FS_ROOT (default "."). Additive; see src/fs_tools.cyr.
    fs_tools_register(dispatcher);

    # Web tools (web_fetch / web_search). Additive; see src/web_tools.cyr.
    # web_search targets the SearXNG instance at BOTE_SEARXNG_URL (unset -> reported, not faked).
    web_tools_register(dispatcher);

    if (streq(mode, "http") == 1) {
        var port = 8390;
        if (arg != 0) { port = bote_main_port(arg, 8390); }
        var cfg = http_config_new("/mcp", INADDR_LOOPBACK(), port);
        if (bearer_fp != 0) { http_config_with_bearer_validator(cfg, bearer_fp, bearer_ctx); }
        bote_main_log_start("http", port, 0, bearer_fp != 0);
        return bote_main_log_exit("http", transport_http_run(dispatcher, cfg));
    }
    if (streq(mode, "unix") == 1) {
        if (arg == 0) {
            bote_log_error("usage: bote unix <socket-path>");
            return 2;
        }
        bote_main_log_start("unix", 0, arg, 0);
        return bote_main_log_exit("unix", transport_unix_run(dispatcher, arg));
    }
    if (streq(mode, "bridge") == 1) {
        var bport = 8391;
        if (arg != 0) { bport = bote_main_port(arg, 8391); }
        var bcfg = bridge_config_new(INADDR_LOOPBACK(), bport);
        var origins = vec_new();
        vec_push(origins, "*");
        bridge_config_with_origins(bcfg, origins);
        if (bearer_fp != 0) { bridge_config_with_bearer_validator(bcfg, bearer_fp, bearer_ctx); }
        bote_main_log_start("bridge", bport, 0, bearer_fp != 0);
        return bote_main_log_exit("bridge", transport_bridge_run(dispatcher, bcfg));
    }
    if (streq(mode, "stdio") == 0) {
        # An unrecognised mode serves stdio, as it always has, and says so.
        var un[BOTE_LOG_LINE_BYTES];
        bote_log_line(&un, SK_WARN, "unknown mode; serving stdio");
        bote_log_str(&un, "mode", mode);
        bote_log_str(&un, "modes", "stdio http unix bridge streamable ws");
        bote_log_emit(&un);
    }
    bote_main_log_start("stdio", 0, 0, 0);
    return bote_main_log_exit("stdio", transport_stdio_run(dispatcher));
}

var r = main();
sys_exit(r);
