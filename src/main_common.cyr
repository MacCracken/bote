# Entry-side helpers for the bote binary (src/main.cyr): the reference
# dispatcher, env-driven bearer-token wiring, mode selection and the
# binary's log lines. Entry-only: in no [lib] profile, because a CLI's
# helpers do not belong in a consumer's bundle.
#
# Through 3.4.1 three binaries (bote / bote-streamable / bote-ws) shared
# this file, a split forced by the cyrius 5.10.x 2 MB compile-source cap.
# The cap was raised at 6.1.24, and 3.4.2 folded the two transport entries
# back into src/main.cyr; bote_main_mode keeps their names working as
# argv[0] aliases.

# Echo the arguments back as an MCP-conformant tool result. Prior to 3.0.1 this
# returned the raw `args` JSON verbatim (a bare object), which is NOT a valid MCP
# tools/call result — a strict client (e.g. thoth) that reads content[0].text found
# none and rendered "no text content". content_text_response wraps the echoed args
# in a text content block: {"content":[{"type":"text","text":"<args>"}]}.
fn bote_echo_handler(args, claims) {
    return content_text_response(args);
}

# Reference prompt generator: greets the optional `name` argument (default
# "world"). Returns a prompts/get result body — one user message whose
# content is a typed text block (content_text handles JSON-escaping).
fn bote_greeting_prompt_handler(args, claims) {
    var who = jsonx_get_str(args, "name");
    if (who == 0) { who = "world"; }
    var text = str_builder_new();
    str_builder_add_cstr(text, "Hello, ");
    str_builder_add_cstr(text, who);
    str_builder_add_cstr(text, "!");
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"description\":\"a friendly greeting\",\"messages\":[{\"role\":\"user\",\"content\":");
    str_builder_add_cstr(sb, content_text(str_data(str_builder_build(text))));
    str_builder_add_cstr(sb, "}]}");
    return str_data(str_builder_build(sb));
}

# Reference resource read handler: returns a single text ResourceContents
# for the bote://info URI (bare uri/mimeType/text, not a content block).
fn bote_info_resource_handler(uri, claims) {
    return "{\"contents\":[{\"uri\":\"bote://info\",\"mimeType\":\"text/plain\",\"text\":\"bote MCP core — reference resource.\"}]}";
}

# Reference completion handler: offers candidate values for the
# bote_greeting prompt's `name` argument. A real consumer would inspect
# params.ref / params.argument.value and filter; this returns a fixed set.
fn bote_completion_handler(params, claims) {
    return "{\"completion\":{\"values\":[\"world\",\"Ada\",\"Alan\"]}}";
}

# Parse a positive decimal integer from a cstr; returns 0 on bad input.
fn _parse_uint(s) {
    if (s == 0) { return 0; }
    var n = 0;
    var i = 0;
    while (load8(s + i) != 0) {
        var c = load8(s + i);
        if (c < 48) { return n; }
        if (c > 57) { return n; }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    return n;
}

# Build a bearer-token allowlist vec from a comma-separated env value.
# Returns a vec of cstr tokens (possibly empty), never null.
fn _split_csv_tokens(csv) {
    var out = vec_new();
    if (csv == 0) { return out; }
    var n = strlen(csv);
    var start = 0;
    var i = 0;
    while (i <= n) {
        var c = 0;
        if (i < n) { c = load8(csv + i); }
        if (i == n || c == 44) {
            var len = i - start;
            if (len > 0) {
                var tok = alloc(len + 1);
                memcpy(tok, csv + start, len);
                store8(tok + len, 0);
                vec_push(out, tok);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

# If BOTE_BEARER_TOKENS env var is set (comma-separated tokens), wire an
# allowlist validator. Returns the validator fp + ctx (vec of allowed
# tokens) via *out_fp / *out_ctx so the caller can apply them to
# whichever transport configs they construct. Stores 0/0 when the env
# var is unset/empty.
fn _bote_bearer_from_env(out_fp, out_ctx) {
    var csv = getenv("BOTE_BEARER_TOKENS");
    if (csv == 0) { store64(out_fp, 0); store64(out_ctx, 0); return 0; }
    var allowed = _split_csv_tokens(csv);
    if (vec_len(allowed) == 0) {
        # Set but empty (or only commas): the operator asked for auth, so
        # refuse to start rather than serve without it. The token values
        # themselves never reach a log.
        bote_log_error("BOTE_BEARER_TOKENS is set but holds no token");
        store64(out_fp, 0); store64(out_ctx, 0); return 0 - 1;
    }
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_INFO, "bearer auth enabled");
    bote_log_int(&ln, "tokens", vec_len(allowed));
    bote_log_emit(&ln);
    store64(out_fp, &auth_validator_allowlist);
    store64(out_ctx, allowed);
    return 1;
}

# The public keys in the JWK Set at `path`, as a JwtSecret, or 0 once it has said why not.
fn _bote_jwks_load(path) {
    var len[8];
    var json = file_read_whole_max(path, BOTE_JWKS_MAX, &len);
    if (json == 0) {
        bote_log_error("BOTE_JWKS_FILE cannot be read");
        return 0;
    }
    var why = jwt_jwks_check(json);
    if (why != 0) {
        var ln[BOTE_LOG_LINE_BYTES];
        bote_log_line(&ln, SK_ERROR, "BOTE_JWKS_FILE refused");
        bote_log_str(&ln, "reason", why);
        bote_log_emit(&ln);
        return 0;
    }
    return jwt_secret_from_jwks(json);
}

# The public keys at the jwks_uri `url`, through `ca` or the system's trust roots, as a
# JwtSecret that refreshes from it, or 0 once it has said why not. The first fetch must
# succeed: a server that starts with no keys would refuse every token and say less about
# why. BOTE_JWKS_REFRESH: the seconds between refreshes, 600 by default.
fn _bote_jwks_url_load(url, ca) {
    var why = bote_jwks_url_check(url, ca);
    if (why != 0) {
        var ln[BOTE_LOG_LINE_BYTES];
        bote_log_line(&ln, SK_ERROR, "BOTE_JWKS_URL refused");
        bote_log_str(&ln, "reason", why);
        bote_log_emit(&ln);
        return 0;
    }
    if (ca != 0) {
        var cl[8];
        if (file_read_whole_max(ca, BOTE_JWKS_MAX, &cl) == 0) {
            bote_log_error("BOTE_JWKS_CA cannot be read");
            return 0;
        }
    }
    var every = _bote_env_count("BOTE_JWKS_REFRESH", BOTE_JWKS_REFRESH_DEFAULT);
    if (every == 0) {
        bote_log_warn("BOTE_JWKS_REFRESH is 0; keeping the default");
        every = BOTE_JWKS_REFRESH_DEFAULT;
    }
    var s = jwt_secret_new(0);
    jwt_secret_with_key_source(s, &bote_jwks_fetch, bote_jwks_source_new(url, ca), every);
    var fail = jwt_secret_refresh(s);
    var host = sandhi_url_host(sandhi_url_parse_a(bote_req_alloc(), url));
    if (fail != 0) {
        var fl[BOTE_LOG_LINE_BYTES];
        bote_log_line(&fl, SK_ERROR, "BOTE_JWKS_URL: the first fetch failed");
        bote_log_str(&fl, "reason", fail);
        bote_log_str(&fl, "host", host);
        bote_log_emit(&fl);
        return 0;
    }
    var il[BOTE_LOG_LINE_BYTES];
    bote_log_line(&il, SK_INFO, "jwt keys from a jwks_uri");
    bote_log_str(&il, "host", host);
    bote_log_int(&il, "keys", vec_len(jwt_secret_keys(s)));
    bote_log_int(&il, "refresh_s", every);
    bote_log_emit(&il);
    return s;
}

# BOTE_JWT_SECRET: an HS256 key. BOTE_JWKS_FILE: the path of a JWK Set, for RS256 and ES256.
# BOTE_JWKS_URL: an authorization server's jwks_uri, fetched and refreshed (3.6.6). One of
# the three. A token must name BOTE_RESOURCE_URL in `aud`, and one of BOTE_AUTH_SERVERS in
# `iss`, so the first is required: a verifier with no audience of its own cannot do what MCP
# asks. Returns 1, 0 when none is set, or -1 when the server should not start. A key is
# never logged.
fn _bote_jwt_from_env(out_fp, out_ctx) {
    var key = getenv("BOTE_JWT_SECRET");
    var jwks = getenv("BOTE_JWKS_FILE");
    var jurl = getenv("BOTE_JWKS_URL");
    if (key == 0 && jwks == 0 && jurl == 0) { return 0; }
    var named = 0;
    if (key != 0) { named = named + 1; }
    if (jwks != 0) { named = named + 1; }
    if (jurl != 0) { named = named + 1; }
    if (named > 1) {
        bote_log_error("BOTE_JWT_SECRET, BOTE_JWKS_FILE and BOTE_JWKS_URL: a server verifies with one of them");
        return 0 - 1;
    }
    if (load64(out_fp) != 0) {
        bote_log_error("a JWT key and BOTE_BEARER_TOKENS are both set: a request has one validator");
        return 0 - 1;
    }
    var url = getenv("BOTE_RESOURCE_URL");
    if (url == 0) {
        bote_log_error("a JWT key needs BOTE_RESOURCE_URL: a token must be checked against this server's identity");
        return 0 - 1;
    }
    var s = 0;
    if (jurl != 0) {
        s = _bote_jwks_url_load(jurl, getenv("BOTE_JWKS_CA"));
        if (s == 0) { return 0 - 1; }
    } elif (jwks != 0) {
        s = _bote_jwks_load(jwks);
        if (s == 0) { return 0 - 1; }
    } else {
        if (strlen(key) < BOTE_JWT_MIN_KEY) {
            bote_log_error("BOTE_JWT_SECRET is under 32 bytes, which RFC 7518 3.2 does not allow for HS256");
            return 0 - 1;
        }
        s = jwt_secret_new(key);
    }
    jwt_secret_with_audience(s, url);
    jwt_secret_with_issuers(s, _split_csv_tokens(getenv("BOTE_AUTH_SERVERS")));
    var slots = _bote_env_count("BOTE_JWT_CACHE", BOTE_JWT_CACHE_DEFAULT);
    jwt_secret_with_cache(s, slots);
    if (slots != BOTE_JWT_CACHE_DEFAULT) {
        var cl[BOTE_LOG_LINE_BYTES];
        bote_log_line(&cl, SK_INFO, "verified tokens remembered");
        bote_log_int(&cl, "slots", jwt_secret_cache_slots(s));
        bote_log_emit(&cl);
    }
    store64(out_fp, &auth_validator_jwt);
    store64(out_ctx, s);
    bote_log_info("jwt auth enabled");
    return 1;
}

# `s` with the trailing space _reg_words wants.
fn _bote_with_space(s) {
    var n = strlen(s);
    var out = alloc(n + 2);
    memcpy(out, s, n);
    store8(out + n, 32);
    store8(out + n + 1, 0);
    return out;
}

# 1 for a mode that sees a token at all.
fn _bote_mode_has_token(mode) {
    if (streq(mode, "http") == 1 || streq(mode, "bridge") == 1) { return 1; }
    if (streq(mode, "streamable") == 1 || streq(mode, "ws") == 1) { return 1; }
    return 0;
}

# BOTE_TOOL_SCOPES: what a token must hold to call a tool, `tool=scope scope,tool=scope`.
# BOTE_SCOPE_IMPLIES: what a broader scope covers, `broad=narrow narrow,broad=narrow`. Both
# need a JWT verifier, because only a JWT says what it grants. A name no tool has stops
# the server: a typo must not leave a tool open that was meant to be closed. stdio and
# the Unix transport take no token, so there these change nothing, and that is said aloud.
# Returns 0, or -1 when the server should not start.
fn bote_main_scopes_from_env(d, mode, jwt_on) {
    var tools = getenv("BOTE_TOOL_SCOPES");
    var implies = getenv("BOTE_SCOPE_IMPLIES");
    if (tools == 0 && implies == 0) { return 0; }
    if (_bote_mode_has_token(mode) == 0) {
        bote_log_warn("BOTE_TOOL_SCOPES has no effect here: this transport takes no token");
        return 0;
    }
    if (jwt_on == 0) {
        bote_log_error("BOTE_TOOL_SCOPES needs BOTE_JWT_SECRET, BOTE_JWKS_FILE or BOTE_JWKS_URL: only a JWT says what it grants");
        return 0 - 1;
    }
    var rules = jwt_scope_rules_new();
    var imp = _split_csv_tokens(implies);
    var i = 0;
    while (i < vec_len(imp)) {
        var e = vec_get(imp, i);
        var eq = strchr(e, 61);
        if (eq <= 0) {
            bote_log_error("BOTE_SCOPE_IMPLIES entries are broad=narrow narrow");
            return 0 - 1;
        }
        store8(e + eq, 0);
        var narrow = _reg_words(_bote_with_space(e + eq + 1));
        var n = 0;
        while (n < vec_len(narrow)) {
            jwt_scope_rule(rules, e, vec_get(narrow, n));
            n = n + 1;
        }
        i = i + 1;
    }
    var ent = _split_csv_tokens(tools);
    var seen = vec_new();
    i = 0;
    while (i < vec_len(ent)) {
        var t = vec_get(ent, i);
        var teq = strchr(t, 61);
        if (teq <= 0) {
            bote_log_error("BOTE_TOOL_SCOPES entries are tool=scope scope");
            return 0 - 1;
        }
        store8(t + teq, 0);
        var def = registry_get(dispatcher_registry(d), t);
        var ln[BOTE_LOG_LINE_BYTES];
        # A second entry would replace the first, and which of the two an operator meant
        # is not bote's to guess: a lost scope is a tool left open.
        var si = 0;
        while (si < vec_len(seen)) {
            if (streq(vec_get(seen, si), t) == 1) {
                bote_log_line(&ln, SK_ERROR, "BOTE_TOOL_SCOPES names a tool twice");
                bote_log_str(&ln, "tool", t);
                bote_log_emit(&ln);
                return 0 - 1;
            }
            si = si + 1;
        }
        vec_push(seen, t);
        if (def == 0) {
            bote_log_line(&ln, SK_ERROR, "BOTE_TOOL_SCOPES names no tool this mode serves");
            bote_log_str(&ln, "tool", t);
            bote_log_emit(&ln);
            return 0 - 1;
        }
        tool_def_with_required_scopes(def, _reg_words(_bote_with_space(t + teq + 1)));
        var why = registry_check_tool_def(def);
        if (why != 0) {
            bote_log_line(&ln, SK_ERROR, "BOTE_TOOL_SCOPES refused");
            bote_log_str(&ln, "reason", why);
            bote_log_emit(&ln);
            return 0 - 1;
        }
        i = i + 1;
    }
    dispatcher_set_scope_check(d, &jwt_scope_check, rules);
    return 0;
}

# ================================================================
# Mode selection (3.4.2)
# ================================================================

# The last path component of `p` (the program name without its directory).
fn _bote_basename(p) {
    if (p == 0) { return ""; }
    var last = p;
    var i = 0;
    while (load8(p + i) != 0) {
        if (load8(p + i) == 47) { last = p + i + 1; }
        i = i + 1;
    }
    return last;
}

# Resolve the transport mode and its argument (a port, or the Unix socket
# path) into *out_mode / *out_arg:
#
#   bote                       stdio
#   bote <mode> [arg]          mode = stdio | http | unix | bridge | streamable | ws
#   bote-streamable [port]     streamable  (argv[0] alias for the pre-3.4.2 binary)
#   bote-ws [port]             ws          (argv[0] alias for the pre-3.4.2 binary)
#
# The aliases are matched on argv[0]'s basename, so a symlink named
# bote-streamable or bote-ws pointing at bote behaves like the old binary.
# An unrecognised mode is returned as given; main reports it and serves stdio.
fn bote_main_mode(out_mode, out_arg) {
    store64(out_arg, 0);
    var me = _bote_basename(argv(0));
    if (streq(me, "bote-streamable") == 1 || streq(me, "bote-ws") == 1) {
        if (streq(me, "bote-ws") == 1) { store64(out_mode, "ws"); }
        else { store64(out_mode, "streamable"); }
        if (argc() >= 2) { store64(out_arg, argv(1)); }
        return 0;
    }
    if (argc() < 2) { store64(out_mode, "stdio"); return 0; }
    store64(out_mode, argv(1));
    if (argc() >= 3) { store64(out_arg, argv(2)); }
    return 0;
}

# ================================================================
# Logging for the binaries (3.4.0)
# ================================================================

# Configure sakshi from BOTE_LOG / BOTE_LOG_FILE (src/log.cyr), and at
# `trace` also turn on sandhi's request spans, which sandhi keeps off unless
# asked. Call right after alloc_init() / args_init().
fn bote_main_log_init() {
    var lv = bote_log_init();
    if (lv >= SK_TRACE) { sandhi_trace_enable(1); }
    return lv;
}

# A port argument that does not parse falls back to the default; say so
# rather than listening somewhere the operator did not ask for.
fn bote_main_port(arg, default_port) {
    if (arg == 0) { return default_port; }
    var p = _parse_uint(arg);
    if (p > 0 && p < 65536) { return p; }
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_WARN, "port argument not usable; using the default");
    bote_log_str(&ln, "arg", arg);
    bote_log_int(&ln, "port", default_port);
    bote_log_emit(&ln);
    return default_port;
}

# BOTE_JWT_CACHE and the like: a count, or `cur` with a WARN when it is not one.
fn _bote_env_count(name, cur) {
    var v = getenv(name);
    if (v == 0) { return cur; }
    var n = 0;
    var i = 0;
    var ok = 1;
    if (load8(v) == 0) { ok = 0; }
    while (load8(v + i) != 0) {
        var c = load8(v + i);
        if (c < 48 || c > 57 || i >= 9) { ok = 0; }
        else { n = n * 10 + (c - 48); }
        i = i + 1;
    }
    if (ok == 1) { return n; }
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_WARN, "not a count; keeping the default");
    bote_log_str(&ln, "var", name);
    bote_log_str(&ln, "value", v);
    bote_log_int(&ln, "default", cur);
    bote_log_emit(&ln);
    return cur;
}

# A millisecond count from the environment variable `name`: the value when
# it is all digits (0 included, which disables the deadline), `cur` when the
# variable is unset, and `cur` with a WARN when it is anything else.
# _parse_uint is not used because it reads "0" and garbage alike as 0.
fn _bote_env_ms(name, cur) {
    var v = getenv(name);
    if (v == 0) { return cur; }
    var n = 0;
    var i = 0;
    var ok = 1;
    if (load8(v) == 0) { ok = 0; }
    while (load8(v + i) != 0) {
        var c = load8(v + i);
        if (c < 48 || c > 57 || i >= 9) { ok = 0; }
        else { n = n * 10 + (c - 48); }
        i = i + 1;
    }
    if (ok == 0) {
        var ln[BOTE_LOG_LINE_BYTES];
        bote_log_line(&ln, SK_WARN, "deadline variable not a millisecond count; keeping the default");
        bote_log_str(&ln, "var", name);
        bote_log_str(&ln, "value", v);
        bote_log_int(&ln, "ms", cur);
        bote_log_emit(&ln);
        return cur;
    }
    return n;
}

# Connection deadlines from the environment (src/conn.cyr): BOTE_SEND_TIMEOUT_MS
# (default 30000) and BOTE_UNIX_IDLE_MS (default 0, none). Logged at INFO when
# either differs from its default.
# BOTE_ALLOWED_ORIGINS: the Origins a browser may reach this server from, comma
# separated, or `*`. Unset, the list is 0 and every present Origin gets 403.
fn bote_main_origins_from_env() {
    var csv = getenv("BOTE_ALLOWED_ORIGINS");
    if (csv == 0) { return 0; }
    var origins = _split_csv_tokens(csv);
    var i = 0;
    while (i < vec_len(origins)) {
        if (streq(vec_get(origins, i), "*") == 1) {
            bote_log_warn("BOTE_ALLOWED_ORIGINS holds *: any website may call this server");
        }
        i = i + 1;
    }
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_INFO, "allowed origins");
    bote_log_int(&ln, "origins", vec_len(origins));
    bote_log_emit(&ln);
    return origins;
}

# BOTE_RESOURCE_URL: this server's public MCP endpoint, exactly as a client reaches it.
# With BOTE_AUTH_SERVERS, the comma-separated servers that issue its tokens, and
# BOTE_AUTH_SCOPES, its comma-separated scopes, it turns on Protected Resource Metadata.
# Returns the ProtectedResource, 0 when it is off, or -1 when what is set cannot be
# published: an operator who asked for this should not get a server without it.
fn bote_main_resource_from_env(bearer_set) {
    var url = getenv("BOTE_RESOURCE_URL");
    var csv = getenv("BOTE_AUTH_SERVERS");
    if (url == 0 && csv == 0) { return 0; }
    var servers = _split_csv_tokens(csv);
    var scopes = _split_csv_tokens(getenv("BOTE_AUTH_SCOPES"));
    var why = bote_prm_check(url, servers, scopes);
    var ln[BOTE_LOG_LINE_BYTES];
    if (why != 0) {
        bote_log_line(&ln, SK_ERROR, "resource metadata refused");
        bote_log_str(&ln, "reason", why);
        bote_log_emit(&ln);
        return 0 - 1;
    }
    var p = bote_prm_new(url, servers, scopes, "bote");
    bote_log_line(&ln, SK_INFO, "resource metadata enabled");
    bote_log_str(&ln, "path", bote_prm_path(p));
    bote_log_int(&ln, "servers", vec_len(servers));
    bote_log_emit(&ln);
    if (bearer_set == 0) { bote_log_warn("resource metadata is set and no bearer validator is: no token is required"); }
    return p;
}

fn bote_main_conn_from_env() {
    BOTE_SEND_TIMEOUT_MS = _bote_env_ms("BOTE_SEND_TIMEOUT_MS", BOTE_SEND_TIMEOUT_MS);
    BOTE_UNIX_IDLE_MS = _bote_env_ms("BOTE_UNIX_IDLE_MS", BOTE_UNIX_IDLE_MS);
    BOTE_WEB_TIMEOUT_MS = _bote_env_ms("BOTE_WEB_TIMEOUT_MS", BOTE_WEB_TIMEOUT_MS);
    if (BOTE_SEND_TIMEOUT_MS != 30000 || BOTE_UNIX_IDLE_MS != 0) {
        var ln[BOTE_LOG_LINE_BYTES];
        bote_log_line(&ln, SK_INFO, "connection deadlines");
        bote_log_int(&ln, "send_timeout_ms", BOTE_SEND_TIMEOUT_MS);
        bote_log_int(&ln, "unix_idle_ms", BOTE_UNIX_IDLE_MS);
        bote_log_emit(&ln);
    }
    return 0;
}

# The startup line. `port` 0 and `path` 0 are omitted.
fn bote_main_log_start(transport, port, path, auth_on) {
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_INFO, "bote starting");
    bote_log_str(&ln, "version", _bote_server_version());
    bote_log_str(&ln, "transport", transport);
    if (port != 0) {
        bote_log_str(&ln, "addr", "127.0.0.1");
        bote_log_int(&ln, "port", port);
    }
    if (path != 0) { bote_log_str(&ln, "path", path); }
    if (auth_on == 1) { bote_log_str(&ln, "auth", "bearer"); }
    else { bote_log_str(&ln, "auth", "none"); }
    bote_log_str(&ln, "log", bote_log_level_name(sakshi_get_level()));
    bote_log_emit(&ln);
    return 0;
}

# The exit line. A clean stop is INFO; a transport that returned non-zero is
# ERROR. Each transport has already logged the step and the errno.
fn bote_main_log_exit(transport, rc) {
    var ln[BOTE_LOG_LINE_BYTES];
    if (rc == 0) {
        bote_log_line(&ln, SK_INFO, "bote stopped");
        bote_log_str(&ln, "transport", transport);
    } else {
        bote_log_line(&ln, SK_ERROR, "transport failed");
        bote_log_str(&ln, "transport", transport);
        bote_log_int(&ln, "rc", rc);
    }
    bote_log_emit(&ln);
    return rc;
}

# Register the bote_echo demo tool on a fresh dispatcher.
fn bote_dispatcher_with_echo() {
    var reg = tool_registry_new();
    var ok_schema = schema_new("object", 0, vec_new());
    registry_register(reg, tool_def_new("bote_echo", "echo arguments back", ok_schema));
    var dispatcher = dispatcher_new(reg);
    dispatcher_handle(dispatcher, "bote_echo", &bote_echo_handler);
    # Reference prompt so the prompts capability is observable in the
    # reference binaries (mirrors bote_echo). Consumers register their own.
    var greet_args = vec_new();
    vec_push(greet_args, prompt_arg_new("name", "who to greet", 0));
    dispatcher_register_prompt(dispatcher,
      prompt_def_new("bote_greeting", "a friendly greeting", greet_args),
      &bote_greeting_prompt_handler);
    # Reference resource so the resources capability is observable in the
    # reference binaries (mirrors bote_echo / bote_greeting).
    dispatcher_register_resource(dispatcher,
      resource_def_new("bote://info", "bote-info", "reference server info", "text/plain"),
      &bote_info_resource_handler);
    # Reference completion handler (completes bote_greeting's `name` arg).
    dispatcher_set_completion(dispatcher, &bote_completion_handler);
    return dispatcher;
}
