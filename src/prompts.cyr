# bote::prompts — MCP prompts capability (prompts/list + prompts/get)
#
# Mirrors the tool registry (src/registry.cyr): a PromptRegistry holds
# prompt metadata (for prompts/list) plus a name→handler map (for
# prompts/get generation). The dispatcher owns an optional PromptRegistry;
# the `prompts` capability is advertised at initialize iff one is present
# (see src/dispatch.cyr _build_capabilities). JSON serialization lives in
# dispatch.cyr alongside the other MCP method builders.
#
# Prompt handler ABI (mirrors the 2.0 tool ABI):
#   fn h(arguments_cstr, claims) → result_cstr
# where `arguments_cstr` is the prompts/get `arguments` object (JSON) and
# the returned cstr is the full prompts/get result body, e.g.
#   {"description":"...","messages":[{"role":"user","content":{...}}]}
#
# Requires (entry point includes, before this module): hashmap (pulled by
# src/registry.cyr), vec, str, string. No local includes — matches dispatch.

# ================================================================
# PromptArgument — one declared argument (surfaced in prompts/list)
# ================================================================
#
# Layout (40 bytes):
#   +0  name        cstr
#   +8  description cstr or 0
#   +16 required    i64 (0 = optional, 1 = required)
#   +24 title       cstr or 0 (3.8.1)
#   +32 display     cstr or 0: the title as prompts/list sends it, built at registration

fn prompt_arg_new(name, description, required) {
    var a = alloc(40);
    store64(a, name);
    store64(a + 8, description);
    store64(a + 16, required);
    store64(a + 24, 0);
    store64(a + 32, 0);
    return a;
}

fn prompt_arg_name(a) { return load64(a); }
fn prompt_arg_description(a) { return load64(a + 8); }
fn prompt_arg_required(a) { return load64(a + 16); }
fn prompt_arg_title(a) { return load64(a + 24); }
fn prompt_arg_display(a) { return load64(a + 32); }

# A title for people (3.8.1). Checked at registration, and sent as it was then.
fn prompt_arg_with_title(a, title) { store64(a + 24, title); return a; }

# ================================================================
# PromptDef — prompt metadata
# ================================================================
#
# Layout (56 bytes):
#   +0  name            cstr
#   +8  description     cstr or 0
#   +16 arguments       vec of PromptArgument ptrs or 0
#   +24 required_scopes vec of cstr or 0: all of them, for a token to get this prompt
#   +32 title           cstr or 0 (3.8.1)
#   +40 icons           vec of Icon or 0 (3.8.1, src/jsonx.cyr)
#   +48 display         cstr or 0: the title and icons as prompts/list sends them

fn prompt_def_new(name, description, arguments) {
    var p = alloc(56);
    store64(p, name);
    store64(p + 8, description);
    store64(p + 16, arguments);
    store64(p + 24, 0);
    store64(p + 32, 0);
    store64(p + 40, 0);
    store64(p + 48, 0);
    return p;
}

# A title for people and icons (3.8.1). Both are checked at registration, and sent as
# they were then.
fn prompt_def_with_title(p, title) { store64(p + 32, title); return p; }
fn prompt_def_with_icons(p, icons) { store64(p + 40, icons); return p; }
fn prompt_def_title(p) { return load64(p + 32); }
fn prompt_def_icons(p) { return load64(p + 40); }
fn prompt_def_display(p) { return load64(p + 48); }

# Why the prompt's titles and icons, its own and its arguments', cannot be sent, or 0.
fn prompt_display_check(p) {
    var why = bote_display_check(prompt_def_title(p), prompt_def_icons(p));
    if (why != 0) { return why; }
    var args = prompt_def_arguments(p);
    if (args != 0) {
        var i = 0;
        while (i < vec_len(args)) {
            var t = prompt_arg_title(vec_get(args, i));
            if (t != 0 && strlen(t) == 0) { return "a title must not be empty"; }
            i = i + 1;
        }
    }
    return 0;
}

# The prompt's and its arguments' title and icons as prompts/list sends them, kept.
fn _prompt_display_build(p) {
    store64(p + 48, _bote_display_json(prompt_def_title(p), prompt_def_icons(p)));
    var args = prompt_def_arguments(p);
    if (args != 0) {
        var i = 0;
        while (i < vec_len(args)) {
            var a = vec_get(args, i);
            store64(a + 32, _bote_display_json(prompt_arg_title(a), 0));
            i = i + 1;
        }
    }
    return 0;
}

fn prompt_def_name(p) { return load64(p); }
fn prompt_def_description(p) { return load64(p + 8); }
fn prompt_def_arguments(p) { return load64(p + 16); }
fn prompt_def_required_scopes(p) { return load64(p + 24); }

# What a token must hold to get this prompt, or to complete its arguments: a vec of
# RFC 6749 scope-tokens, all of them. Returns `p`.
fn prompt_def_with_required_scopes(p, scopes) { store64(p + 24, scopes); return p; }

# ================================================================
# PromptRegistry
# ================================================================
#
# Layout (24 bytes):
#   +0  entries  hashmap: name_cstr -> PromptDef ptr
#   +8  names    vec of name_cstr (insertion order, for list())
#   +16 handlers hashmap: name_cstr -> handler fn ptr

fn prompt_registry_new() {
    var r = alloc(24);
    store64(r, map_new());
    store64(r + 8, vec_new());
    store64(r + 16, map_new());
    return r;
}

fn prompt_registry_entries(r) { return load64(r); }
fn prompt_registry_names(r) { return load64(r + 8); }
fn prompt_registry_handlers(r) { return load64(r + 16); }

# Register (or replace) a prompt + its generator handler. Returns 0, or -1 with nothing
# registered when a required scope is no scope-token: it would go out in a 403's header,
# or (3.8.1) a title or an icon is not what the spec says.
fn prompt_registry_register(r, prompt_def, handler_fp) {
    if (bote_scope_list_ok(prompt_def_required_scopes(prompt_def)) == 0) { return 0 - 1; }
    if (prompt_display_check(prompt_def) != 0) { return 0 - 1; }
    _prompt_display_build(prompt_def);
    var name = prompt_def_name(prompt_def);
    # Under the registries' lock (3.7.1, src/protocol.cyr), as every function below.
    bote_reg_write();
    var entries = prompt_registry_entries(r);
    if (map_has(entries, name) == 0) {
        vec_push(prompt_registry_names(r), name);
    }
    map_set(entries, name, prompt_def);
    map_set(prompt_registry_handlers(r), name, handler_fp);
    bote_reg_write_end();
    return 0;
}

fn _prompt_registry_get_u(r, name) { return map_get(prompt_registry_entries(r), name); }

fn prompt_registry_get(r, name) {
    bote_reg_read();
    var p = _prompt_registry_get_u(r, name);
    bote_reg_read_end();
    return p;
}

fn prompt_registry_contains(r, name) {
    bote_reg_read();
    var h = map_has(prompt_registry_entries(r), name);
    bote_reg_read_end();
    return h;
}

# The prompt `name`, or 0, and its handler through *fp_out, 0 when it has none, from one
# look at the registry (3.7.2): what prompts/get judges and what serves it are then the
# same registration, whatever replaces it meanwhile.
fn prompt_registry_serving(r, name, fp_out) {
    bote_reg_read();
    var p = _prompt_registry_get_u(r, name);
    var fp = 0;
    if (map_has(prompt_registry_handlers(r), name) == 1) { fp = map_get(prompt_registry_handlers(r), name); }
    bote_reg_read_end();
    store64(fp_out, fp);
    return p;
}

# Handler fn ptr for `name`, or 0 if the prompt is unknown.
fn prompt_registry_handler(r, name) {
    bote_reg_read();
    var fp = 0;
    if (map_has(prompt_registry_handlers(r), name) == 1) { fp = map_get(prompt_registry_handlers(r), name); }
    bote_reg_read_end();
    return fp;
}

fn prompt_registry_len(r) {
    bote_reg_read();
    var n = map_count(prompt_registry_entries(r));
    bote_reg_read_end();
    return n;
}

# Return a vec of PromptDef pointers in insertion order.
fn prompt_registry_list(r) {
    var out = vec_new();
    bote_reg_read();
    var names = prompt_registry_names(r);
    var entries = prompt_registry_entries(r);
    var n = vec_len(names);
    var i = 0;
    while (i < n) {
        var name = vec_get(names, i);
        if (map_has(entries, name) == 1) {
            vec_push(out, map_get(entries, name));
        }
        i = i + 1;
    }
    bote_reg_read_end();
    return out;
}
