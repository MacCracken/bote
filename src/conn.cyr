# bote::conn — per-connection socket deadlines for the transports (3.4.3),
# and the serve entry the HTTP-family ones share (3.4.12).
#
# Every bote transport serves one connection at a time: the Unix transport
# runs its own accept loop, and the HTTP-family ones run inside sandhi's
# single-threaded `sandhi_server_run_opts`. A connection that blocks the
# server therefore blocks every other client too.
#
# ## Send: on by default
#
# A blocking write parks once the kernel send buffer and the peer's receive
# window are both full, which happens only when the peer has stopped reading.
# Without a deadline, a client that floods requests and never reads the
# replies wedges the server for good. That was measured on 3.4.2 against both
# the Unix and the WebSocket transport: a healthy client's `ping` went
# unanswered. No healthy client leaves its receive window full for
# BOTE_SEND_TIMEOUT_MS, so a send deadline only ever drops a peer that is
# already broken. Each transport applies it to every connection it serves,
# and drops the connection when a write fails.
#
# ## Receive on Unix clients: off by default
#
# The Unix transport is line-oriented and persistent: an MCP client may keep
# its connection open and quiet between requests, exactly as a WebSocket
# client may. A default receive deadline would drop those healthy clients,
# which is the defect 3.3.7 fixed for WebSocket (`ws_config_with_idle_ms`,
# default off). So BOTE_UNIX_IDLE_MS defaults to 0, no deadline. An operator
# who prefers to reap quiet peers, so that one idle client cannot hold the
# single-threaded server, sets it. The HTTP-family transports keep sandhi's
# own read deadlines (a 30 s idle budget and a 60 s whole-request budget per
# connection), and WebSocket keeps `ws_config_with_idle_ms`.
#
# ## Configuration
#
# Both are plain globals. An embedder assigns them before starting a
# transport; the binaries read BOTE_SEND_TIMEOUT_MS / BOTE_UNIX_IDLE_MS from
# the environment (src/main_common.cyr). Milliseconds; 0 disables. On agnos
# the stdlib records the deadline in its syscall peer instead of a socket
# option, and a 0 there means the peer's 30 s default, not "never".
#
# ## Serving
#
# The HTTP-family transports start through bote_conn_serve. sandhi_server_run
# takes no options struct, so a failed start recorded nothing and bote could
# only say that socket, bind, listen or accept had failed. run_opts records
# the step and the errno in the struct it is given. A new struct reads the same
# defaults as none (tests/bote.tcyr pins that), so that record is the only
# difference. It needs sandhi 1.10.10, which is what sets the minimum cyrius
# at the top of src/log.cyr.

var BOTE_SEND_TIMEOUT_MS = 30000;
var BOTE_UNIX_IDLE_MS = 0;
var BOTE_ERRNO_EADDRINUSE = 98;

# Apply `ms` as fd's send (`send` = 1) or receive (`send` = 0) deadline.
# ms <= 0 leaves the socket as it is. Returns 0 or the stdlib's -errno.
fn _bote_conn_deadline(fd, ms, send) {
    if (ms <= 0) { return 0; }
    var secs = ms / 1000;
    var usecs = (ms - secs * 1000) * 1000;
    if (send == 1) { return sock_set_send_timeout(fd, secs, usecs); }
    return sock_set_recv_timeout(fd, secs, usecs);
}

# Give a connection the send deadline every transport applies.
fn bote_conn_send_deadline(fd) {
    return _bote_conn_deadline(fd, BOTE_SEND_TIMEOUT_MS, 1);
}

# Give a Unix-transport client its receive deadline, if one is configured.
fn bote_conn_unix_idle_deadline(fd) {
    return _bote_conn_deadline(fd, BOTE_UNIX_IDLE_MS, 0);
}

# ## A client gone (3.7.5)
#
# How a socket transport tells that the client of a request in flight has gone, which is
# its cancellation on Streamable HTTP. poll(2) with no wait: POLLHUP, POLLERR or POLLNVAL,
# and with `half` POLLRDHUP too, which is all TCP shows of a client that closed (a FIN),
# though a client that only shut its sending side shows the same. A Unix socket shows
# POLLHUP once the client has closed both, so it passes `half` 0 and a client that shuts
# its sending side and waits for its answers gets them. Input waiting is not a close.
var BOTE_POLL_IN = 1;
var BOTE_POLL_ERR = 8;
var BOTE_POLL_HUP = 16;
var BOTE_POLL_NVAL = 32;
var BOTE_POLL_RDHUP = 8192;

# 1 when the client at `fd` has gone; 0 while it is there, and on agnos, which has no poll.
fn bote_conn_gone(fd, half) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var pfd[8];
    store32(&pfd, fd);
    store16(&pfd + 4, BOTE_POLL_IN | BOTE_POLL_RDHUP);
    store16(&pfd + 6, 0);
    var ts[16];
    store64(&ts, 0);
    store64(&ts + 8, 0);
    if (sys_ppoll(&pfd, 1, &ts, 0, 8) <= 0) { return 0; }
    var ev = load16(&pfd + 6);
    if ((ev & (BOTE_POLL_HUP | BOTE_POLL_ERR | BOTE_POLL_NVAL)) != 0) { return 1; }
    if (half == 1 && (ev & BOTE_POLL_RDHUP) != 0) { return 1; }
    return 0;
    #endif
}

# 1 when the client at `fd` has input waiting, without waiting for any; 0 on agnos.
fn bote_conn_readable(fd) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var pfd[8];
    store32(&pfd, fd);
    store16(&pfd + 4, BOTE_POLL_IN);
    store16(&pfd + 6, 0);
    var ts[16];
    store64(&ts, 0);
    store64(&ts + 8, 0);
    if (sys_ppoll(&pfd, 1, &ts, 0, 8) <= 0) { return 0; }
    return (load16(&pfd + 6) & BOTE_POLL_IN) != 0;
    #endif
}

# One WARN line for a peer dropped because a write to it failed: with the
# send deadline in place, that means it stopped reading for
# BOTE_SEND_TIMEOUT_MS. `err` is the stdlib's negative errno.
fn bote_conn_log_send_drop(transport, err) {
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_WARN, "client dropped: a write to it failed (stopped reading?)");
    bote_log_str(&ln, "transport", transport);
    bote_log_int(&ln, "errno", 0 - err);
    bote_log_int(&ln, "send_timeout_ms", BOTE_SEND_TIMEOUT_MS);
    bote_log_emit(&ln);
    return 0;
}

# The log name of a SANDHI_SERVER_FAIL_* step. "unknown" is a failed serve with
# nothing recorded, which means its options struct could not be allocated.
fn bote_conn_serve_step_name(step) {
    if (step == SANDHI_SERVER_FAIL_CONFIG) { return "config"; }
    if (step == SANDHI_SERVER_FAIL_ALLOC) { return "alloc"; }
    if (step == SANDHI_SERVER_FAIL_SOCKET) { return "socket"; }
    if (step == SANDHI_SERVER_FAIL_BIND) { return "bind"; }
    if (step == SANDHI_SERVER_FAIL_LISTEN) { return "listen"; }
    if (step == SANDHI_SERVER_FAIL_ACCEPT) { return "accept"; }
    if (step == SANDHI_SERVER_FAIL_THREAD) { return "thread"; }
    return "unknown";
}

# One ERROR line for a serve that returned non-zero: the step that failed, and
# the errno when that step has one. `opts` is the struct the serve was given.
fn bote_conn_log_serve_failure(transport, port, opts) {
    var step_slot[8]; var err_slot[8];
    sandhi_server_last_failure(opts, &step_slot, &err_slot);
    var step = load64(&step_slot);
    var err = load64(&err_slot);
    var ln[BOTE_LOG_LINE_BYTES];
    bote_log_line(&ln, SK_ERROR, "serve failed");
    bote_log_str(&ln, "transport", transport);
    bote_log_str(&ln, "step", bote_conn_serve_step_name(step));
    bote_log_int(&ln, "port", port);
    if (err != 0) { bote_log_int(&ln, "errno", err); }
    if (step == SANDHI_SERVER_FAIL_BIND && err == BOTE_ERRNO_EADDRINUSE) {
        bote_log_str(&ln, "cause", "port in use");
    }
    bote_log_emit(&ln);
    return 0;
}

# Serve `handler_fp` on addr:port. Returns only on failure, having said why.
fn bote_conn_serve(transport, addr, port, handler_fp, ctx) {
    var opts = sandhi_server_options_new();
    var rc = sandhi_server_run_opts(addr, port, handler_fp, ctx, opts);
    if (rc != 0) { bote_conn_log_serve_failure(transport, port, opts); }
    return rc;
}

# ================================================================
# Serving on worker threads (3.7.0)
# ================================================================
#
# bote_conn_serve_pooled serves on `workers` threads, sandhi's pool: the calling thread
# only accepts, and hands each connection to the next free worker, so a client that is
# slow to send or to read, or a token that is slow to verify, holds one worker and not
# the server. With 0 workers it is bote_conn_serve. On agnos, whose threads run one at a
# time, sandhi serves the pool on the calling thread.
#
# Each thread then has a request state of its own (src/protocol.cyr): bote_conn_arm
# claims a thread-local slot for it before the first worker starts, and a thread's state
# is made the first time it asks. The thread that arms keeps the state it had. On Linux
# a thread_create'd thread is given a thread-local block when it starts, and only one
# that was not, the main thread, can lack one; sigil's crypto_tls_main_init gives the
# calling thread one if it has none. bote_conn_arm calls it, and when the arming thread
# is not the main one, so does every lookup, which a main thread with no block would
# otherwise fault on. That costs each lookup sigil's check, which on an x86 kernel without
# FSGSBASE (before Linux 5.9) is two system calls until the main thread has a block: arm
# from the main thread.

var _bote_conn_slot = 0 - 1;
var _bote_conn_main = 0;

fn _bote_conn_req_state() {
    if (_bote_conn_main == 0) { crypto_tls_main_init(); }
    var s = thread_local_get(_bote_conn_slot);
    if (s == 0) {
        # Zeroed: a cancellation check (3.7.5) is a function bote calls.
        s = alloc(BOTE_REQ_STATE_BYTES);
        memset(s, 0, BOTE_REQ_STATE_BYTES);
        thread_local_set(_bote_conn_slot, s);
    }
    return s;
}

# Give every thread a request state of its own: 0, or -1 when no thread-local slot is
# left. Once is enough; later calls do nothing.
fn bote_conn_arm() {
    if (_bote_conn_slot >= 0) { return 0; }
    crypto_tls_main_init();
    #ifdef CYRIUS_TARGET_LINUX
    if (sys_gettid() == sys_getpid()) { _bote_conn_main = 1; }
    #endif
    #ifndef CYRIUS_TARGET_LINUX
    _bote_conn_main = 1;
    #endif
    var slot = thread_local_alloc();
    if (slot < 0) { return 0 - 1; }
    thread_local_set(slot, bote_req_state());
    _bote_conn_slot = slot;
    _bote_req_state_fp = &_bote_conn_req_state;
    return 0;
}

# A sink the dispatcher calls from every worker, made to take its turn: the sink a
# threaded server is handed was written for one caller at a time (libro's chain, majra's
# hub). Wrap (16 B): +0 the sink, +8 a mutex.
fn _bote_conn_audit_serial(w, event) {
    mutex_lock(load64(w + 8));
    audit_sink_log(load64(w), event);
    mutex_unlock(load64(w + 8));
    return 0;
}

fn _bote_conn_events_serial(w, topic, payload) {
    mutex_lock(load64(w + 8));
    event_sink_publish(load64(w), topic, payload);
    mutex_unlock(load64(w + 8));
    return 0;
}

fn _bote_conn_updated_serial(w, uri) {
    mutex_lock(load64(w + 8));
    event_sink_updated(load64(w), uri);
    mutex_unlock(load64(w + 8));
    return 0;
}

fn _bote_conn_serial_wrap(sink) {
    var w = alloc(16);
    store64(w, sink);
    store64(w + 8, mutex_new());
    return w;
}

# Make `d`'s audit and event sinks take their turn, as a threaded server must before its
# first worker starts. A sink with no function is left alone; an event sink's list-only
# flag is kept. Returns d.
fn bote_conn_serial_sinks(d) {
    var au = dispatcher_audit_sink(d);
    if (au != 0 && audit_sink_log_fp(au) != 0 && audit_sink_log_fp(au) != &_bote_conn_audit_serial) {
        dispatcher_set_audit(d, audit_sink_new(&_bote_conn_audit_serial, _bote_conn_serial_wrap(au)));
    }
    var ev = dispatcher_event_sink(d);
    if (ev != 0 && event_sink_publish_fp(ev) != 0 && event_sink_publish_fp(ev) != &_bote_conn_events_serial) {
        var ns = event_sink_new(&_bote_conn_events_serial, _bote_conn_serial_wrap(ev));
        store64(ns + 16, load64(ev + 16));
        if (load64(ev + 24) != 0) { event_sink_with_updated(ns, &_bote_conn_updated_serial); }
        dispatcher_set_events(d, ns);
    }
    return d;
}

# Serve `handler_fp` on addr:port on `workers` threads, or as bote_conn_serve with 0.
# Returns only on failure, having said why.
fn bote_conn_serve_pooled(transport, addr, port, handler_fp, ctx, workers) {
    if (workers <= 0) { return bote_conn_serve(transport, addr, port, handler_fp, ctx); }
    if (bote_conn_arm() != 0) {
        var ln[BOTE_LOG_LINE_BYTES];
        bote_log_line(&ln, SK_ERROR, "serve failed");
        bote_log_str(&ln, "transport", transport);
        bote_log_str(&ln, "step", "thread_local");
        bote_log_int(&ln, "port", port);
        bote_log_emit(&ln);
        return 1;
    }
    var opts = sandhi_server_options_new();
    sandhi_server_options_max_conns(opts, workers);
    var rc = sandhi_server_run_pooled(addr, port, handler_fp, ctx, opts);
    if (rc != 0) { bote_conn_log_serve_failure(transport, port, opts); }
    return rc;
}
