include "src/transport_ws.cyr"



fn _cat(a, b) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    return str_data(str_builder_build(sb));
}
fn _cat3(a, b, c) { return _cat(_cat(a, b), c); }
fn _has(s, sub) { if (s != 0 && strstr(s, sub) >= 0) { return 1; } return 0; }
fn _ase(got, want, name) {
    if (got == 0 || want == 0) {
        if (got == want) { return assert(1 == 1, name); }
        return assert(0 == 1, name);
    }
    return assert_streq(got, want, name);
}

# A request on 2026-07-28 with client capabilities `caps` and params `p` (no braces).
fn _mreq(method, p, caps) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"");
    str_builder_add_cstr(sb, method);
    str_builder_add_cstr(sb, "\",\"params\":{");
    str_builder_add_cstr(sb, p);
    if (strlen(p) > 0) { str_builder_add_cstr(sb, ","); }
    str_builder_add_cstr(sb, "\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":");
    str_builder_add_cstr(sb, caps);
    str_builder_add_cstr(sb, "}}}");
    return str_data(str_builder_build(sb));
}
fn _lreq(method, p) { return _cat3(_cat3("{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"", method, "\",\"params\":{"), p, "}}"); }
fn _call(d, p, caps) { return codec_process_message(_mreq("tools/call", p, caps), d, 0); }
fn _code(r) {
    var e = jsonx_get_raw(r, "error");
    if (e == 0) { return 0; }
    return _sch_parse_int(jsonx_get_raw(e, "code"));
}
fn _result(r) { return jsonx_get_raw(r, "result"); }
fn _ends(s, suf) {
    if (s == 0) { return 0; }
    var n = strlen(s);
    var m = strlen(suf);
    if (m > n) { return 0; }
    return memeq(s + n - m, suf, m);
}

# The handlers: each answers as `_ir_mode` says, and t_seen records what it was asked.
var _ir_mode = 0;
var _ir_ret = 0;
var _seen_possible = 0 - 1;
var _seen_caps = 0;
var _seen_resp = 0;
var _seen_acc = 0;
var _seen_state = 0;
var _CAP_NAMES = 0;
var _ir_quiet = 0;
fn _record() {
    if (_ir_quiet == 1) { return 0; }
    _seen_possible = bote_input_possible();
    var v = 0;
    var i = 0;
    while (i < vec_len(_CAP_NAMES)) {
        if (bote_client_has(vec_get(_CAP_NAMES, i)) == 1) { v = v | (1 << i); }
        i = i + 1;
    }
    _seen_caps = v;
    var a = bote_req_alloc();
    var r = bote_input_response_a(a, "q");
    _seen_resp = 0;
    if (r != 0) { _seen_resp = _cat(r, ""); }
    var c = bote_input_accepted_a(a, "q");
    _seen_acc = 0;
    if (c != 0) { _seen_acc = _cat(c, ""); }
    _seen_state = 0;
    if (bote_request_state() != 0) { _seen_state = _cat(bote_request_state(), ""); }
    return 0;
}
fn h_ask(args, claims) {
    _record();
    if (_ir_ret != 0) { return _ir_ret; }
    var ir = bote_input_required_new_a(bote_req_alloc());
    if (_ir_mode == 1) { bote_input_elicit(ir, "q", "Name?", "{\"type\":\"object\",\"properties\":{\"n\":{\"type\":\"string\"}}}"); }
    if (_ir_mode == 2) { bote_input_elicit_url(ir, "q", "Sign in", "https://e.org/login"); }
    if (_ir_mode == 3) { bote_input_sample(ir, "q", "{\"messages\":[],\"maxTokens\":5}"); }
    if (_ir_mode == 4) { bote_input_sample(ir, "q", "{\"messages\":[],\"maxTokens\":5,\"tools\":[]}"); }
    if (_ir_mode == 5) { bote_input_roots(ir, "q"); }
    if (_ir_mode == 6) {
        bote_input_elicit(ir, "a", "A", "{}");
        bote_input_elicit_url(ir, "b", "B", "https://e.org/b");
        bote_input_sample(ir, "c", "{\"messages\":[],\"maxTokens\":5}");
        bote_input_roots(ir, "d");
    }
    if (_ir_mode == 7) { bote_input_elicit(ir, "q", "Name?", "{}"); bote_input_state(ir, "step=1;who=\"me\""); }
    if (_ir_mode == 8) { bote_input_state(ir, "only-state"); }
    return bote_input_required_json(ir);
}
fn h_plain(args, claims) { _record(); return "{\"content\":[{\"type\":\"text\",\"text\":\"ok\"}]}"; }
fn h_prompt(args, claims) { _record(); if (_ir_ret != 0) { return _ir_ret; } return "{\"messages\":[]}"; }
fn h_res(uri, claims) { _record(); if (_ir_ret != 0) { return _ir_ret; } return "{\"contents\":[]}"; }
fn h_complete(params, claims) { if (_ir_ret != 0) { return _ir_ret; } return "{\"completion\":{\"values\":[]}}"; }

var _aud = 0;
fn _aud_log(ctx, ev) { vec_push(_aud, ev); return 0; }

var _clock = 1000000;
fn _clock_fn() { return _clock; }

fn _mk_d(sealed) {
    var d = dispatcher_new(tool_registry_new());
    dispatcher_register_tool(d, tool_def_new("t_ask", "asks", schema_new("object", 0, vec_new())), &h_ask);
    dispatcher_register_tool(d, tool_def_new("t_other", "asks too", schema_new("object", 0, vec_new())), &h_ask);
    dispatcher_register_tool(d, tool_def_new("t_plain", "plain", schema_new("object", 0, vec_new())), &h_plain);
    dispatcher_register_tool(d, tool_def_with_output_schema(tool_def_new("t_out", "has an outputSchema", schema_new("object", 0, vec_new())), "{\"type\":\"object\"}"), &h_ask);
    dispatcher_register_prompt(d, prompt_def_new("p_ask", "asks", 0), &h_prompt);
    # A prompt named as a tool is, so a state's method is all that tells them apart.
    dispatcher_register_prompt(d, prompt_def_new("t_ask", "named as the tool", 0), &h_prompt);
    dispatcher_register_resource(d, resource_def_new("res://ask", "ask", "asks", "text/plain"), &h_res);
    dispatcher_set_completion(d, &h_complete);
    if (sealed == 1) {
        var key[32];
        var k = 0;
        while (k < 32) { store8(&key + k, k * 7 + 3); k = k + 1; }
        dispatcher_with_state_hmac(d, bote_state_hmac_new(&key, 32, 60));
    }
    return d;
}

var EL = "{\"elicitation\":{}}";
var Q_IR = "\"inputRequests\":{\"q\":{\"method\":\"elicitation/create\",\"params\":{\"mode\":\"form\",\"message\":\"Name?\",\"requestedSchema\":{\"type\":\"object\",\"properties\":{\"n\":{\"type\":\"string\"}}}}}}";

fn main() {
    sakshi_set_level(SK_ERROR);
    _bote_state_clock = &_clock_fn;
    _CAP_NAMES = vec_new();
    vec_push(_CAP_NAMES, "elicitation"); vec_push(_CAP_NAMES, "elicitation.form"); vec_push(_CAP_NAMES, "elicitation.url");
    vec_push(_CAP_NAMES, "sampling"); vec_push(_CAP_NAMES, "sampling.tools"); vec_push(_CAP_NAMES, "roots");
    var d = _mk_d(1);

    # ---- What a handler asks of the request ----
    _ir_mode = 0;
    codec_process_message(_mreq("tools/call", "\"name\":\"t_plain\",\"arguments\":{}", EL), d, 0);
    assert_eq(_seen_possible, 1, "possible: a 2026-07-28 tools/call may ask for input");
    assert_eq(_seen_caps, 3, "caps: a bare elicitation is elicitation and its form mode, not url");
    codec_process_message(_mreq("tools/call", "\"name\":\"t_plain\",\"arguments\":{}", "{\"elicitation\":{\"url\":{}},\"sampling\":{\"tools\":{}},\"roots\":{}}"), d, 0);
    assert_eq(_seen_caps, 1 + 4 + 8 + 16 + 32, "caps: url only is not form; sampling with tools; roots");
    codec_process_message(_mreq("tools/call", "\"name\":\"t_plain\",\"arguments\":{}", "{\"elicitation\":{\"form\":{},\"url\":{}},\"sampling\":true,\"roots\":[]}"), d, 0);
    assert_eq(_seen_caps, 7, "caps: a capability that is no object is not declared");
    codec_process_message(_lreq("tools/call", "\"name\":\"t_plain\",\"arguments\":{}"), d, 0);
    assert_eq(_seen_possible, 0, "possible: an older revision cannot ask");
    assert_eq(_seen_caps, 0, "caps: ...and declares nothing per request");
    codec_process_message(_mreq("prompts/get", "\"name\":\"p_ask\"", EL), d, 0);
    assert_eq(_seen_possible, 1, "possible: prompts/get may ask");
    codec_process_message(_mreq("resources/read", "\"uri\":\"res://ask\"", EL), d, 0);
    assert_eq(_seen_possible, 1, "possible: resources/read may ask");
    codec_process_message(_mreq("tools/call", "\"name\":\"t_plain\",\"arguments\":{},\"inputResponses\":{\"q\":{\"action\":\"accept\",\"content\":{\"n\":\"Ann\"}},\"x\":{\"a\":1}}", EL), d, 0);
    _ase(_seen_resp, "{\"action\":\"accept\",\"content\":{\"n\":\"Ann\"}}", "responses: the answer under its key");
    _ase(_seen_acc, "{\"n\":\"Ann\"}", "responses: an accepted elicitation's content");
    codec_process_message(_mreq("tools/call", "\"name\":\"t_plain\",\"arguments\":{},\"inputResponses\":{\"q\":{\"action\":\"decline\"}}", EL), d, 0);
    assert(_seen_resp != 0 && _seen_acc == 0, "responses: a declined one is there, and not accepted");
    codec_process_message(_mreq("tools/call", "\"name\":\"t_plain\",\"arguments\":{},\"inputResponses\":{\"q\":{\"action\":\"accept\"}}", EL), d, 0);
    _ase(_seen_acc, "{}", "responses: accepted with no content is an empty object");
    codec_process_message(_lreq("tools/call", "\"name\":\"t_plain\",\"arguments\":{},\"inputResponses\":{\"q\":{\"action\":\"accept\"}}"), d, 0);
    assert_eq(_seen_resp, 0, "responses: none on an older revision, whatever the params say");
    # Read by a handler whose message the codec never saw: a consumer serving its own
    # transport through dispatcher_dispatch.
    var dreq = req_with_params(req_new("9", "tools/call"), "{\"name\":\"t_plain\",\"arguments\":{},\"inputResponses\":{\"q\":{\"action\":\"accept\",\"content\":{\"n\":\"Bo\"}}},\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{\"elicitation\":{}}}}");
    var dra = bote_req_begin();
    dispatcher_dispatch_a(dra, d, dreq, 0);
    _ase(_seen_acc, "{\"n\":\"Bo\"}", "responses: read through dispatcher_dispatch, with no codec to note the params");
    codec_process_message(_mreq("tools/call", "\"name\":\"t_plain\",\"arguments\":{}", "{\"roots\":{}}"), d, 0);
    bote_req_begin();
    assert(bote_client_has("roots") == 0 && bote_input_possible() == 0 && bote_request_state() == 0, "a begun message carries no capabilities, no input and no state of the last");

    assert_eq(bote_caps_have("{ \"elicitation\" : { } }", "elicitation.form"), 1, "caps: a bare elicitation, spaced, is form");
    assert_eq(bote_caps_have("{\"elicitation\":{\"url\":{}}}", "elicitation.form"), 0, "caps: ...and one naming url only is not");
    assert_eq(bote_caps_have("{\"elicitationx\":{}}", "elicitation"), 0, "caps: a longer name is another");
    assert_eq(bote_caps_have("{\"elic\":{}}", "elicitation"), 0, "caps: ...and a shorter one");
    assert_eq(bote_caps_have("{\"sampl\\u0069ng\":{\"tools\":{}}}", "sampling.tools"), 1, "caps: names read as they decode");
    assert_eq(bote_caps_have("{\"sampling\":{\"tools\":true}}", "sampling.tools"), 0, "caps: a sub-capability that is no object");
    assert_eq(bote_caps_have("{\"roots\":{},\"x\":{\"roots\":{}}}", "x.roots"), 1, "caps: a sub-capability inside its own object");
    assert_eq(bote_caps_have("{\"x\":{},\"roots\":{}}", "x.roots"), 0, "caps: ...and not one beside it");
    var cm0[16];
    var cm1[16];
    bote_req_mark(&cm0);
    var ch0 = alloc_used();
    var cv = bote_caps_have("{\"elicitation\":{\"form\":{}},\"sampling\":{}}", "elicitation.form") + bote_caps_have("{\"roots\":{}}", "roots");
    bote_req_mark(&cm1);
    assert(cv == 2 && load64(&cm0) == load64(&cm1) && load64(&cm0 + 8) == load64(&cm1 + 8) && alloc_used() == ch0, "caps: asking allocates nothing, so a handler's own thread may ask");

    # ---- The builder's bytes, and what goes out ----
    _ir_mode = 1;
    var r1 = _call(d, "\"name\":\"t_ask\",\"arguments\":{}", EL);
    var res1 = _result(r1);
    assert(_has(res1, "{\"_meta\":{\"io.modelcontextprotocol/serverInfo\":{") == 1 && _ends(res1, _cat3("},\"resultType\":\"input_required\",", Q_IR, "}")) == 1, "elicitation: the InputRequiredResult as built, serverInfo added");
    assert_eq(strstr(res1 + strstr(res1, "resultType") + 1, "resultType"), 0 - 1, "elicitation: ...resultType once");
    assert(_has(res1, "isError") == 0 && _has(res1, "ttlMs") == 0, "elicitation: no isError and no cache hints");
    _ir_mode = 2;
    assert(_has(_result(_call(d, "\"name\":\"t_ask\",\"arguments\":{}", "{\"elicitation\":{\"url\":{}}}")), "\"q\":{\"method\":\"elicitation/create\",\"params\":{\"mode\":\"url\",\"message\":\"Sign in\",\"url\":\"https://e.org/login\"}}") == 1, "url elicitation: as built, for a client that takes url");
    _ir_mode = 3;
    assert(_has(_result(_call(d, "\"name\":\"t_ask\",\"arguments\":{}", "{\"sampling\":{}}")), "\"q\":{\"method\":\"sampling/createMessage\",\"params\":{\"messages\":[],\"maxTokens\":5}}") == 1, "sampling: as built");
    _ir_mode = 5;
    assert(_has(_result(_call(d, "\"name\":\"t_ask\",\"arguments\":{}", "{\"roots\":{}}")), "\"q\":{\"method\":\"roots/list\",\"params\":{}}") == 1, "roots: as built");
    var ir = bote_input_required_new_a(bote_req_alloc());
    bote_input_elicit(ir, "k\"1", "line\nbreak \"q\"", "{}");
    _ase(bote_input_required_json(ir), "{\"resultType\":\"input_required\",\"inputRequests\":{\"k\\\"1\":{\"method\":\"elicitation/create\",\"params\":{\"mode\":\"form\",\"message\":\"line\\nbreak \\\"q\\\"\",\"requestedSchema\":{}}}}}", "builder: a key and a message escaped");

    # ---- -32021: what the client did not declare ----
    _ir_mode = 1;
    var m1 = _call(d, "\"name\":\"t_ask\",\"arguments\":{}", "{}");
    assert_eq(_code(m1), 0 - 32021, "-32021: a form elicitation for a client that declared none");
    assert(_has(m1, "\"data\":{\"requiredCapabilities\":{\"elicitation\":{\"form\":{}}}}") == 1, "-32021: ...naming elicitation's form mode");
    _ase(_call(d, "\"name\":\"t_ask\",\"arguments\":{}", "{\"elicitation\":{\"url\":{}}}"), "{\"jsonrpc\":\"2.0\",\"id\":7,\"error\":{\"code\":-32021,\"message\":\"the request needs client capabilities it did not declare\",\"data\":{\"requiredCapabilities\":{\"elicitation\":{\"form\":{}}}}}}", "-32021: form for a client that takes url only, the whole error");
    _ir_mode = 2;
    assert(_has(_call(d, "\"name\":\"t_ask\",\"arguments\":{}", EL), "{\"requiredCapabilities\":{\"elicitation\":{\"url\":{}}}}") == 1, "-32021: url for a client whose elicitation is bare");
    _ir_mode = 3;
    assert(_has(_call(d, "\"name\":\"t_ask\",\"arguments\":{}", EL), "{\"requiredCapabilities\":{\"sampling\":{}}}") == 1, "-32021: sampling");
    _ir_mode = 4;
    assert(_has(_call(d, "\"name\":\"t_ask\",\"arguments\":{}", "{\"sampling\":{}}"), "{\"requiredCapabilities\":{\"sampling\":{\"tools\":{}}}}") == 1, "-32021: sampling with tools");
    assert_eq(_code(_call(d, "\"name\":\"t_ask\",\"arguments\":{}", "{\"sampling\":{\"tools\":{}}}")), 0, "...served where it is declared");
    _ir_mode = 5;
    assert(_has(_call(d, "\"name\":\"t_ask\",\"arguments\":{}", "{}"), "{\"requiredCapabilities\":{\"roots\":{}}}") == 1, "-32021: roots");
    _ir_mode = 6;
    assert(_has(_call(d, "\"name\":\"t_ask\",\"arguments\":{}", "{}"), "{\"requiredCapabilities\":{\"elicitation\":{\"form\":{},\"url\":{}},\"sampling\":{},\"roots\":{}}}") == 1, "-32021: four at once, merged");
    assert_eq(_code(_call(d, "\"name\":\"t_ask\",\"arguments\":{}", "{\"elicitation\":{\"form\":{},\"url\":{}},\"sampling\":{},\"roots\":{}}")), 0, "...all served where all are declared");

    # ---- A handler's mistakes: -32603 ----
    _ir_mode = 0;
    var bads = vec_new();
    vec_push(bads, "{\"resultType\":\"input_required\"}");
    vec_push(bads, "{\"resultType\":\"input_required\",\"inputRequests\":[]}");
    vec_push(bads, "{\"resultType\":\"input_required\",\"requestState\":5}");
    vec_push(bads, "{\"resultType\":\"input_required\",\"inputRequests\":{\"q\":{\"method\":\"tools/call\",\"params\":{}}}}");
    vec_push(bads, "{\"resultType\":\"input_required\",\"inputRequests\":{\"q\":{\"params\":{}}}}");
    vec_push(bads, "{\"resultType\":\"input_required\",\"inputRequests\":{\"q\":{\"method\":\"elicitation/create\",\"params\":{\"mode\":\"voice\"}}}}");
    vec_push(bads, "{\"resultType\":\"input_required\",\"inputRequests\":{\"q\":{\"method\":\"roots/list\"},\"q\":{\"method\":\"roots/list\"}}}");
    vec_push(bads, "{\"resultType\":\"input_required\",\"requestState\":\"a\",\"requestState\":\"b\"}");
    var bi = 0;
    var b603 = 0;
    while (bi < vec_len(bads)) {
        _ir_ret = vec_get(bads, bi);
        if (_code(_call(d, "\"name\":\"t_ask\",\"arguments\":{}", "{\"elicitation\":{},\"roots\":{}}")) == 0 - 32603) { b603 = b603 + 1; }
        bi = bi + 1;
    }
    assert_eq(b603, 8, "-32603: no request and no state, a list, a state that is no string, a method not allowed, none, a mode not known, a key twice, a state twice");
    _ir_ret = vec_get(bads, 2);
    assert(_has(_call(d, "\"name\":\"t_ask\",\"arguments\":{}", "{}"), "holds inputRequests, an object, or requestState, a string, or both") == 1, "-32603: ...a state that is no string, and why");
    _ir_ret = vec_get(bads, 3);
    assert(_has(_call(d, "\"name\":\"t_ask\",\"arguments\":{}", "{}"), "an input request is elicitation/create, sampling/createMessage or roots/list") == 1, "-32603: ...a method not allowed, and why");
    _ir_ret = "{\"resultType\":\"input\\u005frequired\",\"inputRequests\":{\"q\":{\"method\":\"roots/list\"}}}";
    assert(_has(_call(d, "\"name\":\"t_ask\",\"arguments\":{}", "{}"), "{\"requiredCapabilities\":{\"roots\":{}}}") == 1, "an escaped resultType is read as it decodes");
    _ir_ret = 0;

    # ---- The state: sealed, opened, refused ----
    _ir_mode = 7;
    var s1 = _result(_call(d, "\"name\":\"t_ask\",\"arguments\":{}", EL));
    var st = jsonx_get_str_dec_a(default_alloc(), s1, "requestState");
    assert(st != 0 && _has(st, "step=1") == 0, "state: sealed, the payload not in plain sight");
    assert(_has(s1, Q_IR) == 0 && _has(s1, "\"inputRequests\":{\"q\":") == 1, "state: ...beside the requests");
    _ir_mode = 0;
    var retry = _cat3("\"name\":\"t_ask\",\"arguments\":{},\"inputResponses\":{\"q\":{\"action\":\"accept\",\"content\":{}}},\"requestState\":\"", st, "\"");
    _ir_ret = "{\"content\":[{\"type\":\"text\",\"text\":\"done\"}]}";
    var rr = _call(d, retry, EL);
    assert(_has(rr, "\"text\":\"done\"") == 1, "state: the retry is served");
    _ase(_seen_state, "step=1;who=\"me\"", "state: ...and its handler reads the payload as it gave it");
    var tampered = _cat(st, "x");
    var bad_retry = _cat3("\"name\":\"t_ask\",\"arguments\":{},\"requestState\":\"", tampered, "\"");
    _seen_possible = 9;
    assert_eq(_code(_call(d, bad_retry, EL)), 0 - 32602, "state: tampered, -32602");
    assert_eq(_seen_possible, 9, "state: ...refused before the handler runs");
    var flipped = _cat(st, "");
    store8(flipped + 3, load8(flipped + 3) ^ 1);
    assert_eq(_code(_call(d, _cat3("\"name\":\"t_ask\",\"arguments\":{},\"requestState\":\"", flipped, "\""), EL)), 0 - 32602, "state: a byte changed, -32602");
    assert_eq(_code(_call(d, _cat3("\"name\":\"t_other\",\"arguments\":{},\"requestState\":\"", st, "\""), EL)), 0 - 32602, "state: spent on another tool, -32602");
    assert_eq(_code(codec_process_message(_mreq("prompts/get", _cat3("\"name\":\"t_ask\",\"requestState\":\"", st, "\""), EL), d, 0)), 0 - 32602, "state: spent on another method, -32602");
    _clock = _clock + 61;
    assert_eq(_code(_call(d, retry, EL)), 0 - 32602, "state: expired, -32602");
    _clock = _clock - 61;
    assert_eq(_code(_call(d, retry, EL)), 0, "state: ...and opens again before its expiry (the clock seam)");
    bote_req_begin();
    assert(bote_request_state() == 0 && bote_input_possible() == 0, "state: a begun message holds none of the last one's");
    var nsr = _call(d, "\"name\":\"t_ask\",\"arguments\":{},\"requestState\":7", EL);
    assert(_code(nsr) == 0 - 32602 && _has(nsr, "requestState must be a string") == 1, "state: a state that is no string, -32602, and why");
    assert_eq(_code(_call(d, "\"name\":\"t_ask\",\"arguments\":{},\"requestState\":\"not.a-state\"", EL)), 0 - 32602, "state: one that is no state, -32602");
    assert_eq(_code(_call(d, "\"name\":\"t_ask\",\"arguments\":{},\"inputResponses\":[]", EL)), 0 - 32602, "responses: a list, -32602");
    assert_eq(_code(_call(d, "\"name\":\"t_ask\",\"arguments\":{},\"inputResponses\":{\"q\":\"yes\"}", EL)), 0 - 32602, "responses: an answer that is no object, -32602");
    _ir_mode = 8;
    _ir_ret = 0;
    var so = _result(_call(d, "\"name\":\"t_ask\",\"arguments\":{}", "{}"));
    assert(_has(so, "\"requestState\":\"") == 1 && _has(so, "inputRequests") == 0, "state: a state alone, for a client that declared nothing");
    var nd = _mk_d(0);
    _ir_mode = 7;
    assert_eq(_code(_call(nd, "\"name\":\"t_ask\",\"arguments\":{}", EL)), 0 - 32603, "no sealer: a handler's state is refused");
    _ir_mode = 1;
    assert_eq(_code(_call(nd, "\"name\":\"t_ask\",\"arguments\":{}", EL)), 0, "no sealer: ...and a request without one goes");
    assert_eq(_code(_call(nd, retry, EL)), 0 - 32602, "no sealer: a client's state is refused");

    # Bound to the token the request presented.
    _ir_mode = 7;
    _ir_ret = 0;
    var ta = bote_req_begin();
    bote_req_note_token("token-A");
    var tst = _cat(jsonx_get_str_dec_a(default_alloc(), _result(codec_process_message_a(ta, _mreq("tools/call", "\"name\":\"t_ask\",\"arguments\":{}", EL), d, "token-A")), "requestState"), "");
    var tretry = _mreq("tools/call", _cat3("\"name\":\"t_ask\",\"arguments\":{},\"requestState\":\"", tst, "\""), EL);
    _ir_mode = 0;
    _ir_ret = "{\"content\":[]}";
    var tb = bote_req_begin();
    bote_req_note_token("token-B");
    assert_eq(_code(codec_process_message_a(tb, tretry, d, "token-B")), 0 - 32602, "state: made for one token, refused under another");
    assert_eq(_code(codec_process_message_a(bote_req_begin(), tretry, d, 0)), 0 - 32602, "state: ...and with none");
    var tc = bote_req_begin();
    bote_req_note_token("token-A");
    assert_eq(_code(codec_process_message_a(tc, tretry, d, "token-A")), 0, "state: ...and opens under its own");
    _ir_ret = 0;
    # A prompt's state is bound to its name.
    _ir_ret = "{\"resultType\":\"input_required\",\"requestState\":\"p1\"}";
    var pst = _cat(jsonx_get_str_dec_a(default_alloc(), _result(codec_process_message(_mreq("prompts/get", "\"name\":\"p_ask\"", "{}"), d, 0)), "requestState"), "");
    _ir_ret = 0;
    assert_eq(_code(codec_process_message(_mreq("prompts/get", _cat3("\"name\":\"p_ask\",\"requestState\":\"", pst, "\""), "{}"), d, 0)), 0, "state: a prompt's opens for that prompt");
    _ase(_seen_state, "p1", "state: ...and its handler reads it");
    _ir_ret = "{\"resultType\":\"input_required\",\"requestState\":\"r1\"}";
    var rst = _cat(jsonx_get_str_dec_a(default_alloc(), _result(codec_process_message(_mreq("resources/read", "\"uri\":\"res://ask\"", "{}"), d, 0)), "requestState"), "");
    _ir_ret = 0;
    assert_eq(_code(codec_process_message(_mreq("resources/read", _cat3("\"uri\":\"res://ask\",\"requestState\":\"", rst, "\""), "{}"), d, 0)), 0, "state: a resource's opens for that URI");
    _ase(_seen_state, "r1", "state: ...and its handler reads it");
    assert_eq(_code(codec_process_message(_mreq("prompts/get", _cat3("\"name\":\"p_ask\",\"requestState\":\"", rst, "\""), "{}"), d, 0)), 0 - 32602, "state: a resource's refused on a prompt");

    # ---- Each method and revision ----
    _ir_mode = 1;
    _ir_ret = 0;
    var lt = codec_process_message(_lreq("tools/call", "\"name\":\"t_ask\",\"arguments\":{}"), d, 0);
    assert(_has(lt, "\"isError\":true") == 1 && _has(lt, "input_required") == 0, "legacy: a tool asking is a tool error");
    _ir_ret = "{\"resultType\":\"input_required\",\"inputRequests\":{\"q\":{\"method\":\"roots/list\"}}}";
    assert_eq(_code(codec_process_message(_lreq("prompts/get", "\"name\":\"p_ask\""), d, 0)), 0 - 32603, "legacy: a prompt asking is -32603");
    assert_eq(_code(codec_process_message(_lreq("resources/read", "\"uri\":\"res://ask\""), d, 0)), 0 - 32603, "legacy: a resource asking is -32603");
    var mp = codec_process_message(_mreq("prompts/get", "\"name\":\"p_ask\"", "{\"roots\":{}}"), d, 0);
    assert(_has(mp, "\"resultType\":\"input_required\"") == 1 && _code(mp) == 0, "prompts/get: asks on 2026-07-28");
    var mr = codec_process_message(_mreq("resources/read", "\"uri\":\"res://ask\"", "{\"roots\":{}}"), d, 0);
    assert(_has(mr, "\"resultType\":\"input_required\"") == 1 && _has(mr, "ttlMs") == 0, "resources/read: asks, with no cache hints");
    assert_eq(_code(codec_process_message(_mreq("prompts/get", "\"name\":\"p_ask\"", "{}"), d, 0)), 0 - 32021, "prompts/get: -32021 too");
    assert_eq(_code(codec_process_message(_mreq("completion/complete", "\"ref\":{\"type\":\"ref/prompt\",\"name\":\"p_ask\"},\"argument\":{\"name\":\"x\",\"value\":\"y\"}", "{\"roots\":{}}"), d, 0)), 0 - 32603, "completion/complete may not ask");
    _ir_ret = 0;
    assert_eq(_code(codec_process_message(_mreq("tools/list", "\"inputResponses\":7,\"requestState\":[]", EL), d, 0)), 0, "tools/list: the fields mean nothing there");
    _ir_mode = 1;
    var oo = _call(d, "\"name\":\"t_out\",\"arguments\":{}", EL);
    assert(_has(oo, "\"resultType\":\"input_required\"") == 1, "an outputSchema does not judge an InputRequiredResult");

    # ---- The audit ----
    var ad = _mk_d(1);
    _aud = vec_new();
    dispatcher_set_audit(ad, audit_sink_new(&_aud_log, 0));
    _ir_mode = 1;
    codec_process_message_a(bote_req_begin(), _mreq("tools/call", "\"name\":\"t_ask\",\"arguments\":{}", EL), ad, 0);
    codec_process_message_a(bote_req_begin(), _mreq("tools/call", "\"name\":\"t_plain\",\"arguments\":{}", EL), ad, 0);
    assert(vec_len(_aud) == 2 && tool_call_event_success(vec_get(_aud, 0)) == 0, "audit: a round that asks did not complete");
    _ase(tool_call_event_error(vec_get(_aud, 0)), "input required", "audit: ...and says so");
    assert_eq(tool_call_event_success(vec_get(_aud, 1)), 1, "audit: the next call succeeded");

    # ---- The sealer ----
    var key[40];
    var ki = 0;
    while (ki < 40) { store8(&key + ki, 200 - ki); ki = ki + 1; }
    assert_eq(bote_state_hmac_new(&key, 31, 60), 0, "sealer: a key under 32 bytes is refused");
    var h = bote_state_hmac_new(&key, 40, 60);
    var sa = bote_req_alloc();
    var sealed = bote_state_hmac_seal(h, sa, "tools/call\nt\n", "payload \x01\xff");
    _ase(bote_state_hmac_open(h, sa, "tools/call\nt\n", sealed), "payload \x01\xff", "sealer: what is sealed opens");
    assert_eq(bote_state_hmac_open(h, sa, "tools/call\nu\n", sealed), 0, "sealer: not for another binding");
    assert_eq(bote_state_hmac_open(bote_state_hmac_random(60), sa, "tools/call\nt\n", sealed), 0, "sealer: not under another key");
    var n = strlen(sealed);
    var each = 0;
    var bi2 = 0;
    while (bi2 < n) {
        var cp = _cat(sealed, "");
        var c0 = load8(cp + bi2);
        var sub = 65;
        if (c0 == 65) { sub = 66; }
        store8(cp + bi2, sub);
        if (bote_state_hmac_open(h, sa, "tools/call\nt\n", cp) == 0) { each = each + 1; }
        bi2 = bi2 + 1;
    }
    assert_eq(each, n, "sealer: every byte changed is refused");
    var shapes = vec_new();
    vec_push(shapes, ""); vec_push(shapes, "."); vec_push(shapes, "abc"); vec_push(shapes, "a.b.c"); vec_push(shapes, ".abc"); vec_push(shapes, "abc."); vec_push(shapes, "AAAA.AAAA");
    var sh = 0;
    var shok = 0;
    while (sh < vec_len(shapes)) {
        if (bote_state_hmac_open(h, sa, "b", vec_get(shapes, sh)) == 0) { shok = shok + 1; }
        sh = sh + 1;
    }
    assert_eq(shok, 7, "sealer: seven shapes that are no state, each refused");
    # States made with the key, that a sealer would never make: a body under 8 bytes, and a
    # payload holding a NUL.
    var cmac[32];
    var cb = alloc(16);
    store8(cb, 1); store8(cb + 1, 2); store8(cb + 2, 3);
    _bss_mac(h, sa, "b", cb, 3, &cmac);
    var short_st = _cat3(_bss_b64u_a(sa, cb, 3), ".", _bss_b64u_a(sa, &cmac, 32));
    assert_eq(bote_state_hmac_open(h, sa, "b", short_st), 0, "sealer: a body too short for its expiry, MACed, refused");
    var nb = alloc(16);
    var nexp = _clock + 100;
    var nk = 0;
    while (nk < 8) { store8(nb + nk, (nexp >> (56 - 8 * nk)) & 255); nk = nk + 1; }
    store8(nb + 8, 97); store8(nb + 9, 0); store8(nb + 10, 98);
    _bss_mac(h, sa, "b", nb, 11, &cmac);
    var nul_st = _cat3(_bss_b64u_a(sa, nb, 11), ".", _bss_b64u_a(sa, &cmac, 32));
    assert_eq(bote_state_hmac_open(h, sa, "b", nul_st), 0, "sealer: a payload holding a NUL, MACed, refused");
    store8(nb + 9, 120);
    _bss_mac(h, sa, "b", nb, 11, &cmac);
    _ase(bote_state_hmac_open(h, sa, "b", _cat3(_bss_b64u_a(sa, nb, 11), ".", _bss_b64u_a(sa, &cmac, 32))), "axb", "sealer: ...where the same made without one opens");
    _clock = _clock + 61;
    assert_eq(bote_state_hmac_open(h, sa, "tools/call\nt\n", sealed), 0, "sealer: expired");
    _clock = _clock - 61;
    # The encoder against bayan's, every length to 70.
    var el = 0;
    var eq = 0;
    while (el <= 70) {
        var bytes = alloc(el + 1);
        var bj = 0;
        var lcg = el * 7919 + 1;
        while (bj < el) {
            lcg = (lcg * 1103515245 + 12345) & 2147483647;
            store8(bytes + bj, (lcg >> 16) & 255);
            bj = bj + 1;
        }
        var mine = _bss_b64u_a(sa, bytes, el);
        var theirs = base64url_encode(bytes, el);
        # bayan pads; the sealer does not.
        var tl = strlen(theirs);
        while (tl > 0 && load8(theirs + tl - 1) == 61) { tl = tl - 1; }
        if (strlen(mine) == tl && memeq(mine, theirs, tl) == 1) { eq = eq + 1; }
        el = el + 1;
    }
    assert_eq(eq, 71, "sealer: its Base64url is bayan's, unpadded, for every length to 70");

    # ---- The heap ----
    # A round that asks and its retry, every field long, keep only what a call keeps, `args`.
    var hd = _mk_d(1);
    _ir_quiet = 1;
    var long_msg = _cat(_cat("x", ""), "");
    var lb = str_builder_new();
    var li = 0;
    while (li < 60000) { str_builder_add_cstr(lb, "\\u0007"); li = li + 6; }
    var long_s = str_data(str_builder_build(lb));
    var plain_m = _mreq("tools/call", "\"name\":\"t_plain\",\"arguments\":{}", EL);
    codec_process_message_a(bote_req_begin(), plain_m, hd, 0);
    var hb0 = alloc_used();
    codec_process_message_a(bote_req_begin(), plain_m, hd, 0);
    var base = alloc_used() - hb0;
    _ir_ret = _cat3("{\"resultType\":\"input_required\",\"inputRequests\":{\"q\":{\"method\":\"elicitation/create\",\"params\":{\"message\":\"", long_s, "\"}}},\"requestState\":\"long\"}");
    var ask_m = _mreq("tools/call", "\"name\":\"t_ask\",\"arguments\":{}", EL);
    var ask_r = codec_process_message_a(bote_req_begin(), ask_m, hd, 0);
    var hst = _cat(jsonx_get_str_dec_a(default_alloc(), _result(ask_r), "requestState"), "");
    var rmsgs = vec_new();
    vec_push(rmsgs, ask_m);
    vec_push(rmsgs, _mreq("tools/call", _cat3(_cat3("\"name\":\"t_ask\",\"arguments\":{},\"inputResponses\":{\"q\":{\"action\":\"accept\",\"content\":{\"v\":\"", long_s, "\"}}},\"requestState\":\""), hst, "\""), EL));
    vec_push(rmsgs, _mreq("tools/call", _cat3("\"name\":\"t_ask\",\"arguments\":{},\"requestState\":\"", _cat(hst, long_s), "\""), EL));
    vec_push(rmsgs, _mreq("tools/call", _cat3("\"name\":\"t_ask\",\"arguments\":{},\"inputResponses\":{\"q\":\"", long_s, "\"}"), EL));
    vec_push(rmsgs, _mreq("tools/call", "\"name\":\"t_ask\",\"arguments\":{}", "{}"));
    var rnames = vec_new();
    vec_push(rnames, "a round asking, 60 KB in its message"); vec_push(rnames, "its retry, 60 KB in an answer, the state opened");
    vec_push(rnames, "a state 60 KB too long, refused"); vec_push(rnames, "an answer of 60 KB that is no object, refused");
    vec_push(rnames, "-32021 for the round");
    # What each keeps: args, `{}`, where its handler runs; nothing where it is refused first.
    var rkeep = vec_new();
    vec_push(rkeep, 1); vec_push(rkeep, 1); vec_push(rkeep, 0); vec_push(rkeep, 0); vec_push(rkeep, 1);
    var hm = 0;
    while (hm < vec_len(rmsgs)) {
        codec_process_message_a(bote_req_begin(), vec_get(rmsgs, hm), hd, 0);
        var h0 = alloc_used();
        var k = 0;
        while (k < 10) { codec_process_message_a(bote_req_begin(), vec_get(rmsgs, hm), hd, 0); k = k + 1; }
        assert_eq(alloc_used() - h0, base * 10 * vec_get(rkeep, hm), _cat("heap: ten, each keeping only args: ", vec_get(rnames, hm)));
        hm = hm + 1;
    }
    _ir_ret = 0;
    _ir_quiet = 0;
    assert(base > 0 && base <= 16, "heap: a call keeps its args and nothing more");

    return assert_summary();
}

var rc = main();
sys_exit_group(rc);
