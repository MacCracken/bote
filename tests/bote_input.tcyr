# bote_input.tcyr — multi round-trip requests (3.8.2): the request state's accessors, the
# builder's bytes, what the dispatcher makes of a handler's InputRequiredResult on each
# method and revision (-32021 and each refusal), a retry's answers and state judged before
# any handler, the HMAC sealer, and the heap.
#
# Run: cyrius test tests/bote_input.tcyr

include "lib/string.cyr"
include "lib/fmt.cyr"
