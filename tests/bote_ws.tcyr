# bote_ws.tcyr — WebSocket transport (RFC 6455) config + handler wire-up
#
# Run: cyrius test tests/bote_ws.tcyr
#
# 2.7.2: extracted from tests/bote.tcyr to fit under the cyrius 5.10.x
# 2 MB compile-source cap. Reconsolidates on cyrius 5.11.x migration.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"
include "lib/fnptr.cyr"
include "lib/chrono.cyr"
include "lib/tagged.cyr"
include "lib/net.cyr"
include "lib/async.cyr"
include "lib/fdlopen.cyr"
include "lib/tls.cyr"
include "lib/sandhi.cyr"
include "lib/freelist.cyr"
include "lib/thread.cyr"
include "lib/thread_local.cyr"  # sigil 3.7.14 TLS crypto_scratch — SIGILL guard
include "lib/sakshi.cyr"
include "lib/sigil.cyr"
include "lib/patra.cyr"
include "lib/libro.cyr"
include "lib/majra.cyr"
include "lib/assert.cyr"

include "src/error.cyr"
include "src/protocol.cyr"
include "src/jsonx.cyr"
include "src/registry.cyr"
include "src/prompts.cyr"
include "src/resources.cyr"
include "src/events.cyr"
include "src/audit.cyr"
include "src/audit_libro.cyr"
include "src/events_majra.cyr"
include "src/dispatch.cyr"
include "src/codec.cyr"
include "src/schema.cyr"
include "src/stream.cyr"
include "src/session.cyr"
include "src/auth.cyr"
include "src/transport_ws.cyr"

fn main() {
    alloc_init();
    fl_init();

    # ---------------- WebSocket transport — config + handler wire-up ----------------
    var wcfg = ws_config_new("/mcp", 0x0100007F, 8393);
    assert(streq(ws_config_path(wcfg), "/mcp") == 1, "wcfg path");
    assert_eq(ws_config_addr(wcfg), 0x0100007F, "wcfg addr");
    assert_eq(ws_config_port(wcfg), 8393, "wcfg port");
    assert_eq(ws_config_allowed_origins(wcfg), 0, "wcfg no default origins");
    assert_eq(ws_config_require_protocol(wcfg), 0, "wcfg protocol not required");
    assert_eq(ws_config_dispatcher(wcfg), 0, "wcfg dispatcher unset pre-run");

    var worigins = vec_new();
    vec_push(worigins, "http://localhost");
    ws_config_with_allowed_origins(wcfg, worigins);
    assert_eq(ws_config_allowed_origins(wcfg), worigins, "wcfg origins wired");

    ws_config_with_require_protocol(wcfg, 1);
    assert_eq(ws_config_require_protocol(wcfg), 1, "wcfg require_protocol");

    # --- idle_ms, appended at 3.3.7 ---
    #
    # Default MUST be 0 = "no receive deadline". This is the fix for the
    # 30 s idle drop: sandhi sets a 30 s SO_RCVTIMEO on every accepted
    # connection (right for HTTP), it followed cfd into the WebSocket frame
    # loop, and ws_server_recv_frame maps the resulting EAGAIN to "peer
    # closed" — so a healthy but quiet client was dropped at 30 s with no
    # close frame. _bote_ws_handler now overwrites it from this field.
    #
    # ⚠ These assertions pin the CONTRACT, not the behaviour: the drop is a
    # wall-clock effect and cannot be unit-tested in-process. The runtime
    # proof is scripts/ws-idle-probe.py (3 s survives, 33 s got EOF before
    # the fix, 33 s survives after). If you change the default here, re-run
    # that probe — this assertion alone will not catch a regression.
    assert_eq(ws_config_idle_ms(wcfg), 0, "wcfg idle_ms defaults to 0 (no deadline)");
    ws_config_with_idle_ms(wcfg, 45000);
    assert_eq(ws_config_idle_ms(wcfg), 45000, "wcfg idle_ms settable");
    # The append must not disturb the fields below it — that is the whole
    # reason it was appended rather than inserted (libro 2.8.11 lesson).
    ws_config_with_idle_ms(wcfg, 0);
    assert_eq(ws_config_require_protocol(wcfg), 1, "idle_ms append did not clobber require_protocol");
    assert(streq(ws_config_path(wcfg), "/mcp") == 1, "idle_ms append did not clobber path");

    assert(&_bote_ws_handler != 0, "_bote_ws_handler fp");
    var wdisp = dispatcher_new(tool_registry_new());
    store64(wcfg + 40, wdisp);
    assert_eq(ws_config_dispatcher(wcfg), wdisp, "wcfg dispatcher wired");

    return assert_summary();
}

var rc = main();
syscall(SYS_EXIT, rc);
