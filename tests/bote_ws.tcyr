include "src/conn.cyr"
include "src/http_era.cyr"
include "src/listen.cyr"
include "src/transport_ws.cyr"

# ---- 3.4.3 send-deadline helpers --------------------------------------------
var _wx_log = 0;
var _wx_level = 0 - 1;
fn _wx_hook(ts, level, category, msg, msg_len, sixth) {
    var n = msg_len;
    if (n > 511) { n = 511; }
    memcpy(_wx_log, msg, n);
    store8(_wx_log + n, 0);
    _wx_level = level;
    return 0;
}
fn _wx_has(hay, needle) {
    var i = 0;
    while (load8(hay + i) != 0) {
        var j = 0;
        while (load8(needle + j) != 0 && load8(hay + i + j) == load8(needle + j)) { j = j + 1; }
        if (load8(needle + j) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}
# A masked client TEXT frame (RFC 6455 §5.2; payload under 126 bytes) at
# `dst`. Returns its length.
fn _wx_client_frame(dst, payload) {
    var n = strlen(payload);
    store8(dst, 0x81);
    store8(dst + 1, 0x80 | n);
    store8(dst + 2, 0x11); store8(dst + 3, 0x22); store8(dst + 4, 0x33); store8(dst + 5, 0x44);
    var i = 0;
    while (i < n) {
        store8(dst + 6 + i, load8(payload + i) ^ load8(dst + 2 + (i & 3)));
        i = i + 1;
    }
    return 6 + n;
}

# 3.6.3: the token is the list of what it holds.
fn _wx_tok(token, ctx) { return token; }
fn _wx_holds(claims, scope, ctx) { return strstr(claims, scope) >= 0; }
var _wx_runs = 0;
var _wx_kept = 0;
fn _wx_tool(args, claims) {
    _wx_runs = _wx_runs + 1;
    if (_wx_kept == 0) { _wx_kept = claims; }
    return "{\"content\":[]}";
}

# What a client sending `frames` copies of `msg`, with the upgrade request `req`, reads back.
fn _wx_conn(cfg, req, msg, frames) { return _wx_conn_n(cfg, req, strlen(req), msg, frames); }

# _wx_conn with the request's length given, for one that holds a NUL.
fn _wx_conn_n(cfg, req, rn, msg, frames) {
    var p[16];
    sys_socketpair(1, 1, 0, &p);
    var sa = load32(&p);
    var sb = load32(&p + 4);
    if (_wx_frame == 0) { _wx_frame = alloc(256); }
    var fl = _wx_client_frame(_wx_frame, msg);
    var i = 0;
    while (i < frames) {
        sock_send_all(sb, _wx_frame, fl);
        i = i + 1;
    }
    sock_shutdown(sb, 1);
    bote_req_begin();
    _bote_ws_handler(cfg, sa, req, rn);
    sys_close(sa);
    var n = sys_read(sb, _wx_got, 65535);
    var got = 0;
    while (n > 0) {
        got = got + n;
        n = sys_read(sb, _wx_got + got, 65535 - got);
    }
    sys_close(sb);
    store8(_wx_got + got, 0);
    return _wx_got;
}

fn _wx_upgrade(tok, extra) {
    var rq = str_builder_new();
    str_builder_add_cstr(rq, "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nAuthorization: Bearer ");
    str_builder_add_cstr(rq, tok);
    str_builder_add_cstr(rq, "\r\n");
    str_builder_add_cstr(rq, extra);
    str_builder_add_cstr(rq, "\r\n");
    return str_data(str_builder_build(rq));
}

var _wx_got = 0;
var _wx_frame = 0;

fn _cat_ws(head, pad) {
    var n = strlen(head);
    var out = alloc(n + pad + 3);
    memcpy(out, head, n);
    memset(out + n, 120, pad);
    memcpy(out + n + pad, "\r\n", 3);
    return out;
}

# Heap per connection, over 10 connections after one to warm up.
fn _wx_heap(cfg, req, msg, frames) { return _wx_heap_n(cfg, req, strlen(req), msg, frames); }

fn _wx_heap_n(cfg, req, rn, msg, frames) {
    _wx_conn_n(cfg, req, rn, msg, frames);
    var before = alloc_used();
    var i = 0;
    while (i < 10) {
        _wx_conn_n(cfg, req, rn, msg, frames);
        i = i + 1;
    }
    return (alloc_used() - before) / 10;
}

# `head`, then a NUL, then `pad` bytes of x, then CRLF: a header line whose value a
# strlen ends at the NUL. Its length is in _wx_nul_len.
var _wx_nul_len = 0;
fn _wx_nul_line(head, pad) {
    var n = strlen(head);
    var out = alloc(n + pad + 4);
    memcpy(out, head, n);
    store8(out + n, 0);
    memset(out + n + 1, 120, pad);
    memcpy(out + n + 1 + pad, "\r\n", 3);
    _wx_nul_len = n + 1 + pad + 2;
    return out;
}

# An upgrade request of `before`, the NUL line, and `after`, by length; its length is in
# _wx_nul_len.
fn _wx_nul_req(before, nul_head, pad, after) {
    var line = _wx_nul_line(nul_head, pad);
    var ll = _wx_nul_len;
    var bl = strlen(before);
    var al = strlen(after);
    var out = alloc(bl + ll + al + 1);
    memcpy(out, before, bl);
    memcpy(out + bl, line, ll);
    memcpy(out + bl + ll, after, al + 1);
    _wx_nul_len = bl + ll + al;
    return out;
}

# What a client sending `frames` calls of the tool, with the token `tok`, reads back.
fn _wx_session(cfg, tok, frames) {
    var p[16];
    sys_socketpair(1, 1, 0, &p);
    var sa = load32(&p);
    var sb = load32(&p + 4);
    var f = alloc(256);
    var fl = _wx_client_frame(f, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"t_s\"}}");
    var i = 0;
    while (i < frames) {
        sock_send_all(sb, f, fl);
        i = i + 1;
    }
    sock_shutdown(sb, 1);
    var rq = str_builder_new();
    str_builder_add_cstr(rq, "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nAuthorization: Bearer ");
    str_builder_add_cstr(rq, tok);
    str_builder_add_cstr(rq, "\r\n\r\n");
    var req = str_data(str_builder_build(rq));
    bote_req_begin();
    _bote_ws_handler(cfg, sa, req, strlen(req));
    sys_close(sa);
    var got = alloc(4096);
    var n = 0;
    var r = sys_read(sb, got, 4095);
    while (r > 0) {
        n = n + r;
        r = sys_read(sb, got + n, 4095 - n);
    }
    sys_close(sb);
    store8(got + n, 0);
    return got;
}


# ---- 3.6.6: the token judged again while connected -------------------------
# A validator that takes `_wx_left` more tokens and then none, and records each one.
var _wx_left = 0;
var _wx_calls = 0;
var _wx_seen = 0;
fn _wx_count(token, ctx) {
    _wx_calls = _wx_calls + 1;
    _wx_seen = token;
    if (_wx_left <= 0) { return 0; }
    _wx_left = _wx_left - 1;
    return "other-claims";
}

# A tool that takes 100 ms.
fn _wx_slow(args, claims) {
    sleep_ms(100);
    return "{\"content\":[]}";
}

# A clock that moves one second on every read, from `_wx_t`.
var _wx_t = 0;
fn _wx_clock() {
    _wx_t = _wx_t + 1;
    return _wx_t;
}

# An HS256 JWT for `payload` under `key`.
fn _wx_mint(payload, key) {
    var hdr = "{\"alg\":\"HS256\",\"typ\":\"JWT\"}";
    var sb = str_builder_new();
    str_builder_add_cstr(sb, base64url_encode(hdr, strlen(hdr)));
    str_builder_add_cstr(sb, ".");
    str_builder_add_cstr(sb, base64url_encode(payload, strlen(payload)));
    var si = str_cstr(str_builder_build(sb));
    var mac = alloc(32);
    hmac_sha256(key, strlen(key), si, strlen(si), mac);
    var sb2 = str_builder_new();
    str_builder_add_cstr(sb2, si);
    str_builder_add_cstr(sb2, ".");
    str_builder_add_cstr(sb2, base64url_encode(mac, 32));
    return str_cstr(str_builder_build(sb2));
}

fn main() {
    alloc_init();
    fl_init();

    # ---------------- WebSocket transport — config + handler wire-up ----------------
    var wcfg = ws_config_new("/mcp", 0x0100007F, 8393);
    assert(streq(ws_config_path(wcfg), "/mcp") == 1, "wcfg path");
    assert_eq(ws_config_addr(wcfg), 0x0100007F, "wcfg addr");
    assert_eq(ws_config_port(wcfg), 8393, "wcfg port");
    assert_eq(ws_config_allowed_origins(wcfg), 0, "wcfg no default origins");
    assert_eq(ws_config_require_protocol(wcfg), 0, "wcfg protocol not required");
    assert_eq(ws_config_dispatcher(wcfg), 0, "wcfg dispatcher unset pre-run");

    var worigins = vec_new();
    vec_push(worigins, "http://localhost");
    ws_config_with_allowed_origins(wcfg, worigins);
    assert_eq(ws_config_allowed_origins(wcfg), worigins, "wcfg origins wired");

    ws_config_with_require_protocol(wcfg, 1);
    assert_eq(ws_config_require_protocol(wcfg), 1, "wcfg require_protocol");

    # The revision no `initialize` negotiates is still one bote speaks (3.5.1).
    var pv_ok = "GET /mcp HTTP/1.1\r\nHost: x\r\nMCP-Protocol-Version: 2026-07-28\r\n\r\n";
    assert_eq(_ws_check_protocol(0 - 1, pv_ok, strlen(pv_ok), wcfg), 0, "ws: the modern revision is known");
    var pv_bad = "GET /mcp HTTP/1.1\r\nHost: x\r\nMCP-Protocol-Version: 1900-01-01\r\n\r\n";
    assert_eq(_ws_check_protocol(0 - 1, pv_bad, strlen(pv_bad), wcfg), HTTP_BAD_REQUEST, "ws: an unknown version is refused");
    bote_req_begin();
    var pv_used = alloc_used();
    bote_req_begin();
    _ws_check_protocol(0 - 1, pv_bad, strlen(pv_bad), wcfg);
    assert_eq(alloc_used() - pv_used, 0, "ws: refusing a version leaves no heap");

    # --- idle_ms, appended at 3.3.7 ---
    #
    # Default MUST be 0 = "no receive deadline". This is the fix for the
    # 30 s idle drop: sandhi sets a 30 s SO_RCVTIMEO on every accepted
    # connection (right for HTTP), it followed cfd into the WebSocket frame
    # loop, and ws_server_recv_frame maps the resulting EAGAIN to "peer
    # closed" — so a healthy but quiet client was dropped at 30 s with no
    # close frame. _bote_ws_handler now overwrites it from this field.
    #
    # ⚠ These assertions pin the CONTRACT, not the behaviour: the drop is a
    # wall-clock effect and cannot be unit-tested in-process. The runtime
    # proof is scripts/ws-idle-probe.py (3 s survives, 33 s got EOF before
    # the fix, 33 s survives after). If you change the default here, re-run
    # that probe — this assertion alone will not catch a regression.
    assert_eq(ws_config_idle_ms(wcfg), 0, "wcfg idle_ms defaults to 0 (no deadline)");
    ws_config_with_idle_ms(wcfg, 45000);
    assert_eq(ws_config_idle_ms(wcfg), 45000, "wcfg idle_ms settable");
    # The append must not disturb the fields below it — that is the whole
    # reason it was appended rather than inserted (libro 2.8.11 lesson).
    ws_config_with_idle_ms(wcfg, 0);
    assert_eq(ws_config_require_protocol(wcfg), 1, "idle_ms append did not clobber require_protocol");
    assert(streq(ws_config_path(wcfg), "/mcp") == 1, "idle_ms append did not clobber path");

    assert(&_bote_ws_handler != 0, "_bote_ws_handler fp");
    var wdisp = dispatcher_new(tool_registry_new());
    store64(wcfg + 40, wdisp);
    assert_eq(ws_config_dispatcher(wcfg), wdisp, "wcfg dispatcher wired");


    # ---------------- 3.4.3: a peer that never reads is dropped ----------------
    # Reproduced live on 3.4.2: a WebSocket client that floods requests and
    # reads nothing parked the single-threaded server in write(2) for good,
    # and a second client's request went unanswered. The handler now applies
    # the send deadline (src/conn.cyr) and returns when a frame write fails.
    # If that regresses, this call blocks and the unit fails at the runner's
    # timeout. AF_UNIX charges in-flight bytes to the sender, so the server
    # end's SO_SNDBUF (SOL_SOCKET 1, SO_SNDBUF 7, Linux) is shrunk.
    #ifndef CYRIUS_TARGET_AGNOS
    var xp[16];
    assert_eq(sys_socketpair(1, 1, 0, &xp), 0, "ws flood: socketpair");
    var xa = load32(&xp);
    var xb = load32(&xp + 4);
    var xsmall[8];
    store32(&xsmall, 4096);
    sys_setsockopt(xa, 1, 7, &xsmall, 4);
    var xcfg = ws_config_new("/mcp", 0x0100007F, 8393);
    store64(xcfg + 40, dispatcher_new(tool_registry_new()));
    var xframe = alloc(128);
    var xfl = _wx_client_frame(xframe, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}");
    var xflood = alloc(xfl * 1500);
    var xi = 0;
    while (xi < 1500) { memcpy(xflood + xi * xfl, xframe, xfl); xi = xi + 1; }
    assert_eq(sock_send_all(xb, xflood, xfl * 1500), xfl * 1500, "ws flood: 1,500 frames queued");
    var xreq = "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n";
    _wx_log = alloc(512);
    sakshi_set_emit_hook(&_wx_hook);
    sakshi_set_level(SK_DEBUG);
    BOTE_SEND_TIMEOUT_MS = 200;
    var xs0 = clock_now_ms();
    _bote_ws_handler(xcfg, xa, xreq, strlen(xreq));
    var xsel = clock_now_ms() - xs0;
    BOTE_SEND_TIMEOUT_MS = 30000;
    sakshi_clear_emit_hook();
    sakshi_set_level(SK_INFO);
    assert(xsel < 10000, "_bote_ws_handler returns on a peer that never reads (it used to block for good)");
    assert(_wx_has(_wx_log, "client dropped") == 1, "the ws drop is logged");
    assert(_wx_has(_wx_log, "transport=ws errno=11") == 1, "the ws drop line names the transport and EAGAIN");
    assert_eq(_wx_level, SK_WARN, "the ws drop is a WARN");
    var xgot = alloc(4096);
    var xgt, xgv = sock_recv(xb, xgot, 4096);
    assert(xgv > 0 && _wx_has(xgot, "101 Switching Protocols") == 1, "the handshake completed before the flood was dropped");
    sys_close(xa);
    sys_close(xb);

    # ---------------- 3.6.3: a frame has no status of its own ----------------
    # The check is the dispatcher's here, on the claims of the upgrade, and those must
    # outlive the arena each later frame rewinds: the second call below is what shows it.
    var sc = vec_new();
    vec_push(sc, "files:read");
    var sreg = tool_registry_new();
    registry_register(sreg, tool_def_with_required_scopes(tool_def_new("t_s", "S", schema_new("object", 0, vec_new())), sc));
    var sdisp = dispatcher_new(sreg);
    dispatcher_handle(sdisp, "t_s", &_wx_tool);
    dispatcher_set_scope_check(sdisp, &_wx_holds, 0);
    var scfg = ws_config_new("/mcp", 0x0100007F, 8393);
    store64(scfg + 40, sdisp);
    ws_config_with_bearer_validator(scfg, &_wx_tok, 0);
    var spoor = _wx_session(scfg, "nothing", 1);
    assert(_wx_has(spoor, "101 Switching Protocols") == 1, "ws scope: the upgrade is accepted");
    assert(_wx_has(spoor, "\"code\":-31403") == 1, "ws scope: the call is refused in the frame");
    assert_eq(_wx_runs, 0, "ws scope: and no handler ran");
    var srich = _wx_session(scfg, "files:read", 3);
    assert_eq(_wx_runs, 3, "ws scope: every frame of a token with the scope runs");
    assert(_wx_has(srich, "-31403") == 0, "ws scope: and none is refused");
    _wx_session(scfg, "files:read-other-token", 1);
    assert(_wx_kept != 0 && streq(_wx_kept, "files:read") == 1, "ws: claims a handler kept are its own, after the next connection reuses the buffer");

    # 3.6.4: a connection keeps its token where the next one reuses it, not on the heap.
    _wx_got = alloc(65536);
    var big = alloc(20001);
    memset(big, 120, 20000);
    store8(big + 20000, 0);
    var list = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}";
    var refused = _wx_conn(scfg, _wx_upgrade(big, "MCP-Protocol-Version: 1900-01-01\r\n"), list, 1);
    assert(_wx_has(refused, "HTTP/1.1 400") == 1, "ws heap: a version it does not speak is refused");
    assert_eq(_wx_heap(scfg, _wx_upgrade(big, "MCP-Protocol-Version: 1900-01-01\r\n"), list, 1), 0, "ws heap: ...and keeps none of a 20 KB token it took");
    var listed = _wx_conn(scfg, _wx_upgrade(big, ""), list, 3);
    assert(_wx_has(listed, "\"tools\"") == 1, "ws heap: a connection of three frames is served");
    # What ws_server's own handshake keeps, which is not bote's to free (a cyrius issue).
    var hs_req = _wx_upgrade(big, "");
    var hsp[16];
    sys_socketpair(1, 1, 0, &hsp);
    ws_server_handshake(load32(&hsp), hs_req, strlen(hs_req));
    var hs0 = alloc_used();
    ws_server_handshake(load32(&hsp), hs_req, strlen(hs_req));
    var hs_keep = alloc_used() - hs0;
    sys_close(load32(&hsp));
    sys_close(load32(&hsp + 4));
    var conn_keep = _wx_heap(scfg, _wx_upgrade(big, ""), list, 3);
    assert(hs_keep > 0 && conn_keep == hs_keep, "ws heap: a connection keeps what ws_server's handshake keeps, and nothing of bote's");
    # The headers that handshake copies to the heap are bounded first, so a long one is
    # refused on the arena, where it was kept for good before.
    var lc = str_builder_new();
    str_builder_add_cstr(lc, "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\n");
    str_builder_add_cstr(lc, _cat_ws("Connection: Upgrade, ", 60000));
    str_builder_add_cstr(lc, "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nAuthorization: Bearer t\r\n\r\n");
    var lreq = str_data(str_builder_build(lc));
    assert(_wx_has(_wx_conn(scfg, lreq, list, 1), "HTTP/1.1 400") == 1, "ws: a 60 KB Connection header is refused");
    assert_eq(_wx_heap(scfg, lreq, list, 1), 0, "ws heap: ...and keeps nothing");
    var lu = str_builder_new();
    str_builder_add_cstr(lu, "GET /mcp HTTP/1.1\r\nHost: x\r\n");
    str_builder_add_cstr(lu, _cat_ws("Upgrade: websocket", 60000));
    str_builder_add_cstr(lu, "Connection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nAuthorization: Bearer t\r\n\r\n");
    var ureq = str_data(str_builder_build(lu));
    assert(_wx_has(_wx_conn(scfg, ureq, list, 1), "HTTP/1.1 400") == 1, "ws: a 60 KB Upgrade header is refused");
    assert_eq(_wx_heap(scfg, ureq, list, 1), 0, "ws heap: ...and keeps nothing");
    var lv = str_builder_new();
    str_builder_add_cstr(lv, "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n");
    str_builder_add_cstr(lv, _cat_ws("Sec-WebSocket-Version: 13", 60000));
    str_builder_add_cstr(lv, "Authorization: Bearer t\r\n\r\n");
    var vreq = str_data(str_builder_build(lv));
    assert(_wx_has(_wx_conn(scfg, vreq, list, 1), "HTTP/1.1 400") == 1, "ws: a 60 KB version header is refused");
    assert_eq(_wx_heap(scfg, vreq, list, 1), 0, "ws heap: ...and keeps nothing");
    var lk = str_builder_new();
    str_builder_add_cstr(lk, "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n");
    str_builder_add_cstr(lk, _cat_ws("Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==", 60000));
    str_builder_add_cstr(lk, "Sec-WebSocket-Version: 13\r\nAuthorization: Bearer t\r\n\r\n");
    var kreq = str_data(str_builder_build(lk));
    assert(_wx_has(_wx_conn(scfg, kreq, list, 1), "HTTP/1.1 400") == 1, "ws: a 60 KB key is refused");
    assert_eq(_wx_heap(scfg, kreq, list, 1), 0, "ws heap: ...and keeps nothing");
    var c256 = _cat_ws("Connection: Upgrade", 256 - 7);
    var c257 = _cat_ws("Connection: Upgrade", 257 - 7);
    var r256 = str_builder_new();
    str_builder_add_cstr(r256, "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\n");
    str_builder_add_cstr(r256, c256);
    str_builder_add_cstr(r256, "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nAuthorization: Bearer t\r\n\r\n");
    assert(_wx_has(_wx_conn(scfg, str_data(str_builder_build(r256)), list, 1), "101 Switching") == 1, "ws: a Connection header of 256 bytes upgrades");
    var r257 = str_builder_new();
    str_builder_add_cstr(r257, "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\n");
    str_builder_add_cstr(r257, c257);
    str_builder_add_cstr(r257, "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nAuthorization: Bearer t\r\n\r\n");
    assert(_wx_has(_wx_conn(scfg, str_data(str_builder_build(r257)), list, 1), "HTTP/1.1 400") == 1, "ws: ...and 257 does not");
    var nokey = "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nAuthorization: Bearer t\r\n\r\n";
    assert(_wx_has(_wx_conn(scfg, nokey, list, 1), "HTTP/1.1 400") == 1, "ws: no key, refused here as the handshake would");
    var v12 = "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 12\r\nAuthorization: Bearer t\r\n\r\n";
    assert(_wx_has(_wx_conn(scfg, v12, list, 1), "HTTP/1.1 400") == 1, "ws: another version, refused");
    var short_key = "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ=\r\nSec-WebSocket-Version: 13\r\nAuthorization: Bearer t\r\n\r\n";
    assert(_wx_has(_wx_conn(scfg, short_key, list, 1), "HTTP/1.1 400") == 1, "ws: a short key, refused");
    var wsup = "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: WebSocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nAuthorization: Bearer t\r\n\r\n";
    assert(_wx_has(_wx_conn(scfg, wsup, list, 1), "101 Switching") == 1, "ws: Upgrade: WebSocket, as the handshake takes it");
    var hup = "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: h2c\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nAuthorization: Bearer t\r\n\r\n";
    assert(_wx_has(_wx_conn(scfg, hup, list, 1), "HTTP/1.1 400") == 1, "ws: another protocol, refused");
    var huge = alloc(70001);
    memset(huge, 120, 70000);
    store8(huge + 70000, 0);
    var toolong = _wx_conn(scfg, _wx_upgrade(huge, ""), list, 1);
    assert(_wx_has(toolong, "HTTP/1.1 400") == 1 && _wx_has(toolong, "101 Switching") == 0, "ws: a token too long to keep is refused before the upgrade");

    # 3.6.5: a NUL in a header. bote read each value up to its NUL, and ws_server's
    # handshake copies it to the end of its line, so 60 KB behind a NUL passed the bound
    # and was kept. RFC 9110 5.5 lets a recipient refuse any field value holding one.
    var up_line = "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\n";
    var rest = "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nAuthorization: Bearer t\r\n\r\n";
    var ncr = _wx_nul_req(up_line, "Connection: Upgrade", 60000, rest);
    var ncn = _wx_nul_len;
    var ncg = _wx_conn_n(scfg, ncr, ncn, list, 1);
    assert(_wx_has(ncg, "HTTP/1.1 400") == 1 && _wx_has(ncg, "101 Switching") == 0, "ws: 60 KB behind a NUL in Connection is refused");
    assert_eq(_wx_heap_n(scfg, ncr, ncn, list, 1), 0, "ws heap: ...and keeps nothing");
    var nur = _wx_nul_req("GET /mcp HTTP/1.1\r\nHost: x\r\n", "Upgrade: websocket", 60000,
      "Connection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nAuthorization: Bearer t\r\n\r\n");
    var nun = _wx_nul_len;
    assert(_wx_has(_wx_conn_n(scfg, nur, nun, list, 1), "HTTP/1.1 400") == 1, "ws: 60 KB behind a NUL in Upgrade is refused");
    assert_eq(_wx_heap_n(scfg, nur, nun, list, 1), 0, "ws heap: ...and keeps nothing (a completed upgrade kept 61,600 B)");
    var nkr = _wx_nul_req("GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n",
      "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==", 60000, "Sec-WebSocket-Version: 13\r\nAuthorization: Bearer t\r\n\r\n");
    var nkn = _wx_nul_len;
    assert(_wx_has(_wx_conn_n(scfg, nkr, nkn, list, 1), "HTTP/1.1 400") == 1, "ws: 60 KB behind a NUL in the key is refused");
    assert_eq(_wx_heap_n(scfg, nkr, nkn, list, 1), 0, "ws heap: ...and keeps nothing");
    var nor = _wx_nul_req("GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n", "X-Note: a", 1, rest);
    assert(_wx_has(_wx_conn_n(scfg, nor, _wx_nul_len, list, 1), "HTTP/1.1 400") == 1, "ws: a NUL in any header is refused");

    # The key is the base64 of 16 bytes, which the handshake checks after it has copied
    # every header; it is checked here first.
    var bang = "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: !!!!!!!!!!!!!!!!!!!!!!==\r\nSec-WebSocket-Version: 13\r\nAuthorization: Bearer t\r\n\r\n";
    assert(_wx_has(_wx_conn(scfg, bang, list, 1), "HTTP/1.1 400") == 1, "ws: a key outside base64 is refused");
    assert_eq(_wx_heap(scfg, bang, list, 1), 0, "ws heap: ...and keeps nothing (64 B before)");
    var bang256 = str_builder_new();
    str_builder_add_cstr(bang256, "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\n");
    str_builder_add_cstr(bang256, c256);
    str_builder_add_cstr(bang256, "Sec-WebSocket-Key: !!!!!!!!!!!!!!!!!!!!!!==\r\nSec-WebSocket-Version: 13\r\nAuthorization: Bearer t\r\n\r\n");
    assert_eq(_wx_heap(scfg, str_data(str_builder_build(bang256)), list, 1), 0, "ws heap: ...with a 256-byte Connection too (320 B before)");
    var nopad = "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ=x\r\nSec-WebSocket-Version: 13\r\nAuthorization: Bearer t\r\n\r\n";
    assert(_wx_has(_wx_conn(scfg, nopad, list, 1), "HTTP/1.1 400") == 1, "ws: a key not ending == is refused");
    var b64sym = "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: ab+/ab+/ab+/ab+/ab+/aA==\r\nSec-WebSocket-Version: 13\r\nAuthorization: Bearer t\r\n\r\n";
    assert(_wx_has(_wx_conn(scfg, b64sym, list, 1), "101 Switching") == 1, "ws: a key using + and / upgrades");
    var key_z = "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: zZ09zZ09zZ09zZ09zZ09zZ==\r\nSec-WebSocket-Version: 13\r\nAuthorization: Bearer t\r\n\r\n";
    assert(_wx_has(_wx_conn(scfg, key_z, list, 1), "101 Switching") == 1, "ws: a key at the ends of each range upgrades");
    # Every byte, first and last of the 22, against RFC 4648's alphabet.
    var kb = alloc(25);
    var kwrong = 0;
    var kc = 1;
    while (kc < 256) {
        var want = 0;
        if ((kc >= 65 && kc <= 90) || (kc >= 97 && kc <= 122) || (kc >= 48 && kc <= 57) || kc == 43 || kc == 47) { want = 1; }
        memcpy(kb, "AAAAAAAAAAAAAAAAAAAAAA==", 25);
        store8(kb, kc);
        if (_ws_key_ok(kb) != want) { kwrong = kwrong + 1; }
        memcpy(kb, "AAAAAAAAAAAAAAAAAAAAAA==", 25);
        store8(kb + 21, kc);
        if (_ws_key_ok(kb) != want) { kwrong = kwrong + 1; }
        kc = kc + 1;
    }
    assert_eq(kwrong, 0, "ws key: each of 255 bytes, first and last, judged as base64 is");
    assert_eq(_ws_key_ok("AAAAAAAAAAAAAAAAAAAAAA=A"), 0, "ws key: the last byte must be =");
    assert_eq(_ws_key_ok("AAAAAAAAAAAAAAAAAAAAAAA="), 0, "ws key: ...and the one before it");
    assert_eq(_ws_key_ok("AAAAAAAAAAAAAAAAAAAAAA=="), 1, "ws key: 22 and ==");
    assert_eq(_ws_key_ok("AAAAAAAAAAAAAAAAAAAAAA==A"), 0, "ws key: 25 bytes");

    # A connection keeps one copy of its token, made the first time a handler is handed
    # it, however many frames call one. 3.6.4 made a copy per frame: 2 MB for 100 calls
    # of a 20 KB token.
    var freg = tool_registry_new();
    registry_register(freg, tool_def_new("t_free", "F", schema_new("object", 0, vec_new())));
    var fdisp = dispatcher_new(freg);
    dispatcher_handle(fdisp, "t_free", &_wx_tool);
    var fcfg = ws_config_new("/mcp", 0x0100007F, 8393);
    store64(fcfg + 40, fdisp);
    ws_config_with_bearer_validator(fcfg, &_wx_tok, 0);
    var call = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"t_free\"}}";
    _wx_runs = 0;
    var called = _wx_conn(fcfg, _wx_upgrade(big, ""), call, 3);
    assert(_wx_has(called, "\"content\":[]") == 1 && _wx_runs == 3, "ws: three calls on one connection are served");
    var h1 = _wx_heap(fcfg, _wx_upgrade(big, ""), call, 1);
    var h10 = _wx_heap(fcfg, _wx_upgrade(big, ""), call, 10);
    var h100 = _wx_heap(fcfg, _wx_upgrade(big, ""), call, 100);
    assert(h1 > hs_keep + 20000 && h1 < hs_keep + 20100, "ws heap: one call keeps the handshake's bytes and one copy of the token");
    # What each later call keeps is its `args`, which a handler may keep (roadmap 3.8.x).
    assert(h10 > h1 && h10 - h1 <= 9 * 16, "ws heap: nine more calls keep their args and no token");
    assert_eq(h100 - h1, 11 * (h10 - h1), "ws heap: ...and a hundred keep eleven times that");
    _wx_kept = 0;
    _wx_conn(fcfg, _wx_upgrade("token-a", ""), call, 2);
    var kept_a = _wx_kept;
    _wx_kept = 0;
    _wx_conn(fcfg, _wx_upgrade("token-b", ""), call, 1);
    assert(kept_a != 0 && streq(kept_a, "token-a") == 1 && streq(_wx_kept, "token-b") == 1, "ws: each connection's handlers get its own token, and a kept one outlives it");

    # 3.6.6: the token is judged again while the connection lasts, by the validator that
    # took it, and one that no longer passes ends the connection with 1008.
    assert_eq(_ws_recheck_due(5000, 4000), 1, "recheck: a second after the last");
    assert_eq(_ws_recheck_due(4999, 4000), 0, "recheck: ...and not before it");
    assert_eq(_ws_recheck_due(3000, 4000), 1, "recheck: a clock that went back");
    var creg = tool_registry_new();
    registry_register(creg, tool_def_new("t_free", "F", schema_new("object", 0, vec_new())));
    var cdisp = dispatcher_new(creg);
    dispatcher_handle(cdisp, "t_free", &_wx_tool);
    var ccfg = ws_config_new("/mcp", 0x0100007F, 8393);
    store64(ccfg + 40, cdisp);
    ws_config_with_bearer_validator(ccfg, &_wx_count, 0);
    BOTE_WS_RECHECK_MS = 0;
    _wx_left = 3;
    _wx_calls = 0;
    _wx_runs = 0;
    _wx_kept = 0;
    var cut = _wx_conn(ccfg, _wx_upgrade("tok-short", ""), call, 5);
    assert(_wx_has(cut, "101 Switching") == 1, "recheck: the upgrade passes");
    assert_eq(_wx_runs, 2, "recheck: two frames pass, and the third is not served");
    assert_eq(_wx_calls, 4, "recheck: the upgrade and each frame up to the refusal are judged");
    assert(_wx_has(cut, "token no longer valid") == 1, "recheck: a close frame names why");
    assert(strstr(cut, "\x03\xF0token no longer valid") >= 0, "recheck: ...with 1008");
    assert(_wx_seen != 0 && streq(_wx_seen, "tok-short") == 1, "recheck: the presented token is judged, not the claims");
    assert(_wx_kept != 0 && streq(_wx_kept, "other-claims") == 1, "recheck: a handler is handed the claims");
    BOTE_WS_RECHECK_MS = 1000;
    _wx_left = 100;
    _wx_calls = 0;
    _wx_runs = 0;
    _wx_conn(ccfg, _wx_upgrade("tok-many", ""), call, 50);
    assert_eq(_wx_runs, 50, "recheck: fifty frames inside a second are served");
    assert_eq(_wx_calls, 1, "recheck: ...and judged once, at the upgrade");
    BOTE_WS_RECHECK_MS = 0;
    _wx_left = 100;
    _wx_calls = 0;
    _wx_runs = 0;
    _wx_conn(ccfg, _wx_upgrade("tok-each", ""), call, 4);
    assert(_wx_runs == 4 && _wx_calls == 5, "recheck: 0 judges every frame");
    # The interval runs from the last judgement: frames 100 ms apart against 150 ms are
    # judged at the third and the fifth, not at every one after the first is due.
    var slreg = tool_registry_new();
    registry_register(slreg, tool_def_new("t_slow", "S", schema_new("object", 0, vec_new())));
    var sdsp = dispatcher_new(slreg);
    dispatcher_handle(sdsp, "t_slow", &_wx_slow);
    var slcfg = ws_config_new("/mcp", 0x0100007F, 8393);
    store64(slcfg + 40, sdsp);
    ws_config_with_bearer_validator(slcfg, &_wx_count, 0);
    BOTE_WS_RECHECK_MS = 150;
    _wx_left = 100;
    _wx_calls = 0;
    _wx_conn(slcfg, _wx_upgrade("tok-slow", ""), "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"t_slow\"}}", 5);
    assert_eq(_wx_calls, 3, "recheck: from the last judgement, the upgrade and two of five frames 100 ms apart");
    # No validator: nothing to judge.
    _wx_runs = 0;
    var ncfg = ws_config_new("/mcp", 0x0100007F, 8393);
    store64(ncfg + 40, cdisp);
    _wx_conn(ncfg, "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n", call, 3);
    assert_eq(_wx_runs, 3, "recheck: with no validator every frame is served");
    # A token over the bound is refused whatever the validator returns.
    _wx_left = 10;
    var hugec = _wx_conn(ccfg, _wx_upgrade(huge, ""), list, 1);
    assert(_wx_has(hugec, "HTTP/1.1 400") == 1, "recheck: a 70 KB token is refused before the upgrade, claims or no");

    # A real JWT that expires mid-connection, on a clock that moves a second each read.
    var jkey = "0123456789abcdef0123456789abcdef";
    var js = jwt_secret_new(jkey);
    jwt_secret_with_audience(js, "https://mcp.example.com/mcp");
    var jtok = _wx_mint("{\"aud\":\"https://mcp.example.com/mcp\",\"exp\":1003}", jkey);
    var jcfg = ws_config_new("/mcp", 0x0100007F, 8393);
    store64(jcfg + 40, cdisp);
    ws_config_with_bearer_validator(jcfg, &auth_validator_jwt, js);
    _bote_jwt_clock = &_wx_clock;
    BOTE_WS_RECHECK_MS = 0;
    _wx_t = 999;
    _wx_runs = 0;
    var jcut = _wx_conn(jcfg, _wx_upgrade(jtok, ""), call, 6);
    assert(_wx_has(jcut, "101 Switching") == 1, "recheck jwt: the upgrade passes at 1000");
    assert_eq(_wx_runs, 2, "recheck jwt: frames at 1001 and 1002 pass, and at 1003 the token has expired");
    assert(_wx_has(jcut, "token no longer valid") == 1, "recheck jwt: the connection is closed");
    assert(jwt_secret_cache_hits(js) >= 2, "recheck jwt: the frames were judged from the cache");
    # Judging again keeps nothing: ten frames cost what one does.
    _wx_t = 0;
    var jlong = _wx_mint("{\"aud\":\"https://mcp.example.com/mcp\",\"exp\":9000000000}", jkey);
    var jh1 = _wx_heap(jcfg, _wx_upgrade(jlong, ""), list, 1);
    var jh10 = _wx_heap(jcfg, _wx_upgrade(jlong, ""), list, 10);
    assert_eq(jh10, jh1, "recheck heap: judging ten frames keeps what one does");
    _bote_jwt_clock = 0;
    BOTE_WS_RECHECK_MS = 1000;
    #endif

    return assert_summary();
}

var rc = main();
sys_exit(rc);
