# bote_ws.tcyr — WebSocket transport (RFC 6455) config + handler wire-up
#
# Run: cyrius test tests/bote_ws.tcyr
#
# 2.7.2: extracted from tests/bote.tcyr to fit under the cyrius 5.10.x
# 2 MB compile-source cap. Reconsolidates on cyrius 5.11.x migration.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"
include "lib/fnptr.cyr"
include "lib/chrono.cyr"
include "lib/tagged.cyr"
include "lib/net.cyr"
include "lib/async.cyr"
include "lib/fdlopen.cyr"
include "lib/tls.cyr"
include "lib/sandhi.cyr"
include "lib/freelist.cyr"
include "lib/thread.cyr"
include "lib/thread_local.cyr"  # sigil 3.7.14 TLS crypto_scratch — SIGILL guard
include "lib/sakshi.cyr"
include "lib/sigil.cyr"
include "lib/patra.cyr"
include "lib/libro.cyr"
include "lib/majra.cyr"
include "lib/assert.cyr"

include "src/log.cyr"
include "src/error.cyr"
include "src/protocol.cyr"
include "src/jsonx.cyr"
include "src/registry.cyr"
include "src/prompts.cyr"
include "src/resources.cyr"
include "src/events.cyr"
include "src/audit.cyr"
include "src/audit_libro.cyr"
include "src/events_majra.cyr"
include "src/dispatch.cyr"
include "src/codec.cyr"
include "src/schema.cyr"
include "src/stream.cyr"
include "src/session.cyr"
include "src/auth.cyr"
include "src/conn.cyr"
include "src/transport_ws.cyr"

# ---- 3.4.3 send-deadline helpers --------------------------------------------
var _wx_log = 0;
var _wx_level = 0 - 1;
fn _wx_hook(ts, level, category, msg, msg_len, sixth) {
    var n = msg_len;
    if (n > 511) { n = 511; }
    memcpy(_wx_log, msg, n);
    store8(_wx_log + n, 0);
    _wx_level = level;
    return 0;
}
fn _wx_has(hay, needle) {
    var i = 0;
    while (load8(hay + i) != 0) {
        var j = 0;
        while (load8(needle + j) != 0 && load8(hay + i + j) == load8(needle + j)) { j = j + 1; }
        if (load8(needle + j) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}
# A masked client TEXT frame (RFC 6455 §5.2; payload under 126 bytes) at
# `dst`. Returns its length.
fn _wx_client_frame(dst, payload) {
    var n = strlen(payload);
    store8(dst, 0x81);
    store8(dst + 1, 0x80 | n);
    store8(dst + 2, 0x11); store8(dst + 3, 0x22); store8(dst + 4, 0x33); store8(dst + 5, 0x44);
    var i = 0;
    while (i < n) {
        store8(dst + 6 + i, load8(payload + i) ^ load8(dst + 2 + (i & 3)));
        i = i + 1;
    }
    return 6 + n;
}

# 3.6.3: the token is the list of what it holds.
fn _wx_tok(token, ctx) { return token; }
fn _wx_holds(claims, scope, ctx) { return strstr(claims, scope) >= 0; }
var _wx_runs = 0;
fn _wx_tool(args, claims) {
    _wx_runs = _wx_runs + 1;
    return "{\"content\":[]}";
}

# What a client sending `frames` calls of the tool, with the token `tok`, reads back.
fn _wx_session(cfg, tok, frames) {
    var p[16];
    sys_socketpair(1, 1, 0, &p);
    var sa = load32(&p);
    var sb = load32(&p + 4);
    var f = alloc(256);
    var fl = _wx_client_frame(f, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"t_s\"}}");
    var i = 0;
    while (i < frames) {
        sock_send_all(sb, f, fl);
        i = i + 1;
    }
    sock_shutdown(sb, 1);
    var rq = str_builder_new();
    str_builder_add_cstr(rq, "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nAuthorization: Bearer ");
    str_builder_add_cstr(rq, tok);
    str_builder_add_cstr(rq, "\r\n\r\n");
    var req = str_data(str_builder_build(rq));
    bote_req_begin();
    _bote_ws_handler(cfg, sa, req, strlen(req));
    sys_close(sa);
    var got = alloc(4096);
    var n = 0;
    var r = sys_read(sb, got, 4095);
    while (r > 0) {
        n = n + r;
        r = sys_read(sb, got + n, 4095 - n);
    }
    sys_close(sb);
    store8(got + n, 0);
    return got;
}

fn main() {
    alloc_init();
    fl_init();

    # ---------------- WebSocket transport — config + handler wire-up ----------------
    var wcfg = ws_config_new("/mcp", 0x0100007F, 8393);
    assert(streq(ws_config_path(wcfg), "/mcp") == 1, "wcfg path");
    assert_eq(ws_config_addr(wcfg), 0x0100007F, "wcfg addr");
    assert_eq(ws_config_port(wcfg), 8393, "wcfg port");
    assert_eq(ws_config_allowed_origins(wcfg), 0, "wcfg no default origins");
    assert_eq(ws_config_require_protocol(wcfg), 0, "wcfg protocol not required");
    assert_eq(ws_config_dispatcher(wcfg), 0, "wcfg dispatcher unset pre-run");

    var worigins = vec_new();
    vec_push(worigins, "http://localhost");
    ws_config_with_allowed_origins(wcfg, worigins);
    assert_eq(ws_config_allowed_origins(wcfg), worigins, "wcfg origins wired");

    ws_config_with_require_protocol(wcfg, 1);
    assert_eq(ws_config_require_protocol(wcfg), 1, "wcfg require_protocol");

    # The revision no `initialize` negotiates is still one bote speaks (3.5.1).
    var pv_ok = "GET /mcp HTTP/1.1\r\nHost: x\r\nMCP-Protocol-Version: 2026-07-28\r\n\r\n";
    assert_eq(_ws_check_protocol(0 - 1, pv_ok, strlen(pv_ok), wcfg), 0, "ws: the modern revision is known");
    var pv_bad = "GET /mcp HTTP/1.1\r\nHost: x\r\nMCP-Protocol-Version: 1900-01-01\r\n\r\n";
    assert_eq(_ws_check_protocol(0 - 1, pv_bad, strlen(pv_bad), wcfg), HTTP_BAD_REQUEST, "ws: an unknown version is refused");
    bote_req_begin();
    var pv_used = alloc_used();
    bote_req_begin();
    _ws_check_protocol(0 - 1, pv_bad, strlen(pv_bad), wcfg);
    assert_eq(alloc_used() - pv_used, 0, "ws: refusing a version leaves no heap");

    # --- idle_ms, appended at 3.3.7 ---
    #
    # Default MUST be 0 = "no receive deadline". This is the fix for the
    # 30 s idle drop: sandhi sets a 30 s SO_RCVTIMEO on every accepted
    # connection (right for HTTP), it followed cfd into the WebSocket frame
    # loop, and ws_server_recv_frame maps the resulting EAGAIN to "peer
    # closed" — so a healthy but quiet client was dropped at 30 s with no
    # close frame. _bote_ws_handler now overwrites it from this field.
    #
    # ⚠ These assertions pin the CONTRACT, not the behaviour: the drop is a
    # wall-clock effect and cannot be unit-tested in-process. The runtime
    # proof is scripts/ws-idle-probe.py (3 s survives, 33 s got EOF before
    # the fix, 33 s survives after). If you change the default here, re-run
    # that probe — this assertion alone will not catch a regression.
    assert_eq(ws_config_idle_ms(wcfg), 0, "wcfg idle_ms defaults to 0 (no deadline)");
    ws_config_with_idle_ms(wcfg, 45000);
    assert_eq(ws_config_idle_ms(wcfg), 45000, "wcfg idle_ms settable");
    # The append must not disturb the fields below it — that is the whole
    # reason it was appended rather than inserted (libro 2.8.11 lesson).
    ws_config_with_idle_ms(wcfg, 0);
    assert_eq(ws_config_require_protocol(wcfg), 1, "idle_ms append did not clobber require_protocol");
    assert(streq(ws_config_path(wcfg), "/mcp") == 1, "idle_ms append did not clobber path");

    assert(&_bote_ws_handler != 0, "_bote_ws_handler fp");
    var wdisp = dispatcher_new(tool_registry_new());
    store64(wcfg + 40, wdisp);
    assert_eq(ws_config_dispatcher(wcfg), wdisp, "wcfg dispatcher wired");


    # ---------------- 3.4.3: a peer that never reads is dropped ----------------
    # Reproduced live on 3.4.2: a WebSocket client that floods requests and
    # reads nothing parked the single-threaded server in write(2) for good,
    # and a second client's request went unanswered. The handler now applies
    # the send deadline (src/conn.cyr) and returns when a frame write fails.
    # If that regresses, this call blocks and the unit fails at the runner's
    # timeout. AF_UNIX charges in-flight bytes to the sender, so the server
    # end's SO_SNDBUF (SOL_SOCKET 1, SO_SNDBUF 7, Linux) is shrunk.
    #ifndef CYRIUS_TARGET_AGNOS
    var xp[16];
    assert_eq(sys_socketpair(1, 1, 0, &xp), 0, "ws flood: socketpair");
    var xa = load32(&xp);
    var xb = load32(&xp + 4);
    var xsmall[8];
    store32(&xsmall, 4096);
    sys_setsockopt(xa, 1, 7, &xsmall, 4);
    var xcfg = ws_config_new("/mcp", 0x0100007F, 8393);
    store64(xcfg + 40, dispatcher_new(tool_registry_new()));
    var xframe = alloc(128);
    var xfl = _wx_client_frame(xframe, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}");
    var xflood = alloc(xfl * 1500);
    var xi = 0;
    while (xi < 1500) { memcpy(xflood + xi * xfl, xframe, xfl); xi = xi + 1; }
    assert_eq(sock_send_all(xb, xflood, xfl * 1500), xfl * 1500, "ws flood: 1,500 frames queued");
    var xreq = "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n";
    _wx_log = alloc(512);
    sakshi_set_emit_hook(&_wx_hook);
    sakshi_set_level(SK_DEBUG);
    BOTE_SEND_TIMEOUT_MS = 200;
    var xs0 = clock_now_ms();
    _bote_ws_handler(xcfg, xa, xreq, strlen(xreq));
    var xsel = clock_now_ms() - xs0;
    BOTE_SEND_TIMEOUT_MS = 30000;
    sakshi_clear_emit_hook();
    sakshi_set_level(SK_INFO);
    assert(xsel < 10000, "_bote_ws_handler returns on a peer that never reads (it used to block for good)");
    assert(_wx_has(_wx_log, "client dropped") == 1, "the ws drop is logged");
    assert(_wx_has(_wx_log, "transport=ws errno=11") == 1, "the ws drop line names the transport and EAGAIN");
    assert_eq(_wx_level, SK_WARN, "the ws drop is a WARN");
    var xgot = alloc(4096);
    var xgt, xgv = sock_recv(xb, xgot, 4096);
    assert(xgv > 0 && _wx_has(xgot, "101 Switching Protocols") == 1, "the handshake completed before the flood was dropped");
    sys_close(xa);
    sys_close(xb);

    # ---------------- 3.6.3: a frame has no status of its own ----------------
    # The check is the dispatcher's here, on the claims of the upgrade, and those must
    # outlive the arena each later frame rewinds: the second call below is what shows it.
    var sc = vec_new();
    vec_push(sc, "files:read");
    var sreg = tool_registry_new();
    registry_register(sreg, tool_def_with_required_scopes(tool_def_new("t_s", "S", schema_new("object", 0, vec_new())), sc));
    var sdisp = dispatcher_new(sreg);
    dispatcher_handle(sdisp, "t_s", &_wx_tool);
    dispatcher_set_scope_check(sdisp, &_wx_holds, 0);
    var scfg = ws_config_new("/mcp", 0x0100007F, 8393);
    store64(scfg + 40, sdisp);
    ws_config_with_bearer_validator(scfg, &_wx_tok, 0);
    var spoor = _wx_session(scfg, "nothing", 1);
    assert(_wx_has(spoor, "101 Switching Protocols") == 1, "ws scope: the upgrade is accepted");
    assert(_wx_has(spoor, "\"code\":-31403") == 1, "ws scope: the call is refused in the frame");
    assert_eq(_wx_runs, 0, "ws scope: and no handler ran");
    var srich = _wx_session(scfg, "files:read", 3);
    assert_eq(_wx_runs, 3, "ws scope: every frame of a token with the scope runs");
    assert(_wx_has(srich, "-31403") == 0, "ws scope: and none is refused");
    #endif

    return assert_summary();
}

var rc = main();
sys_exit(rc);
