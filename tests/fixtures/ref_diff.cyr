# ref_diff.cyr — bote's reading of which `$ref`s are in their document (src/schema.cyr,
# _sch_refs_why, through registration's own resolver) against the official client's own validator,
# from what tests/fixtures/ref_diff_gen.cjs wrote to build/ref-diff/cases.txt
# (scripts/ref-diff.sh runs both). It exits 1 on any schema bote takes and the client
# cannot compile, the reading that leaves a tool's results unjudgeable by the client; one
# bote refuses and the client takes is counted, not failed: registration says why. Every
# schema of the first kind is written to build/ref-diff/taken.txt, of the second to
# build/ref-diff/refused.txt.
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"
include "lib/fnptr.cyr"
include "lib/chrono.cyr"
include "lib/tagged.cyr"
include "lib/net.cyr"
include "lib/async.cyr"
include "lib/fdlopen.cyr"
include "lib/tls.cyr"
include "lib/sandhi.cyr"
include "lib/freelist.cyr"
include "lib/thread.cyr"
include "lib/thread_local.cyr"  # sigil 3.7.14 TLS crypto_scratch — SIGILL guard
include "lib/sakshi.cyr"
include "lib/sigil.cyr"
include "lib/patra.cyr"
include "lib/libro.cyr"
include "lib/majra.cyr"
include "lib/assert.cyr"
include "src/log.cyr"
include "src/error.cyr"
include "src/protocol.cyr"
include "src/jsonx.cyr"
include "src/regex.cyr"
include "src/registry.cyr"
include "src/prompts.cyr"
include "src/resources.cyr"
include "src/events.cyr"
include "src/audit.cyr"
include "src/audit_libro.cyr"
include "src/events_majra.cyr"
include "src/dispatch.cyr"
include "src/codec.cyr"
include "src/schema.cyr"
include "src/stream.cyr"
include "src/session.cyr"
include "src/discovery.cyr"
include "src/auth.cyr"
include "src/conn.cyr"
include "src/fetch.cyr"
include "src/http_era.cyr"
include "src/oauth_metadata.cyr"
include "src/listen.cyr"
include "src/transport_stdio.cyr"
include "src/transport_http.cyr"
include "src/transport_unix.cyr"
include "src/bridge.cyr"
include "src/transport_streamable.cyr"
include "src/transport_ws.cyr"


fn _cat(a, b) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    return str_data(str_builder_build(sb));
}
fn _line(txt, i, len) { var j = i; while (j < len && load8(txt + j) != 10) { j = j + 1; } return j; }
fn _tab(txt, i, e) { var j = i; while (j < e && load8(txt + j) != 9) { j = j + 1; } return j; }
fn main() {
    alloc_init();
    var lo[8];
    var txt = file_read_whole("build/ref-diff/cases.txt", &lo);
    var len = load64(&lo);
    if (txt == 0 || len == 0) { println("ref_diff: no build/ref-diff/cases.txt"); return 2; }
    var i = 0;
    var n = 0; var both = 0; var neither = 0; var danger = 0; var strict = 0;
    var all = str_builder_new();
    var rall = str_builder_new();
    while (i < len) {
        var e = _line(txt, i, len);
        var t1 = _tab(txt, i + 2, e);
        var raw = _slice_cstr(default_alloc(), txt, i + 2, t1 - i - 2);
        var flag = load8(txt + e - 1) - 48;
        var doc = _sch_str_dec_a(default_alloc(), raw);
        if (doc != 0) {
            n = n + 1;
            var w = _sch_refs_why(doc);
            if (w == 0 && flag == 1) { both = both + 1; }
            elif (w != 0 && flag == 0) { neither = neither + 1; }
            elif (w == 0) {
                danger = danger + 1;
                if (danger < 25) { println(_cat("TAKEN, CLIENT REFUSES ", doc)); }
                str_builder_add_cstr(all, doc);
                str_builder_add_cstr(all, "\n");
            }
            else {
                strict = strict + 1;
                if (strict < 15) { println(_cat(_cat("REFUSED, CLIENT TAKES ", doc), _cat(" : ", w))); }
                str_builder_add_cstr(rall, doc);
                str_builder_add_cstr(rall, "\n");
            }
        }
        i = e + 1;
    }
    # Every schema bote takes and the client refuses, one a line, for a closer look.
    var ab = str_builder_build(all);
    file_write_all("build/ref-diff/taken.txt", str_data(ab), strlen(str_data(ab)));
    var rb = str_builder_build(rall);
    file_write_all("build/ref-diff/refused.txt", str_data(rb), strlen(str_data(rb)));
    println(_cat("schemas ", _sch_itoa(n)));
    println(_cat("both take ", _sch_itoa(both)));
    println(_cat("both refuse ", _sch_itoa(neither)));
    println(_cat("bote takes, the client refuses ", _sch_itoa(danger)));
    println(_cat("bote refuses, the client takes ", _sch_itoa(strict)));
    if (danger != 0) { return 1; }
    return 0;
}
var rc = main();
sys_exit_group(rc);
