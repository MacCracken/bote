# A server for `@modelcontextprotocol/conformance`, whose scenarios call tools,
# prompts and resources by name. It adds those names to a plain dispatcher and
# nothing else: every byte of the protocol is the library's, so what the suite
# measures here is what an embedder gets. Run it through scripts/conformance.sh.
#
#   conformance-server http [port]        HTTP, with sessions, default 8395
#   conformance-server streamable [port]  Streamable HTTP, with sessions, default 8396
#   conformance-server bridge [port]      the bridge, default 8397
#   conformance-server auth <port> <as> [jwks]
#                                         HTTP that wants a token, naming the authorization
#                                         server on port <as>: HS256, or the keys in a JWK Set
#   conformance-server                    stdio
#
# A scenario that needs what bote lacks stays failing here on purpose, and
# tests/fixtures/conformance-expected.yaml says which and why. A name that would
# only make a check pass, with no feature behind it, does not belong in this file.

include "src/log.cyr"
include "src/error.cyr"
include "src/protocol.cyr"
include "src/jsonx.cyr"
include "src/registry.cyr"
include "src/prompts.cyr"
include "src/resources.cyr"
include "src/events.cyr"
include "src/audit.cyr"
include "src/audit_libro.cyr"
include "src/events_majra.cyr"
include "src/dispatch.cyr"
include "src/codec.cyr"
include "src/schema.cyr"
include "src/stream.cyr"
include "src/session.cyr"
include "src/discovery.cyr"
include "src/auth.cyr"
include "src/jwt.cyr"
include "src/pkce.cyr"
include "src/conn.cyr"
include "src/fetch.cyr"
include "src/jwks.cyr"
include "src/http_era.cyr"
include "src/oauth_metadata.cyr"
include "src/listen.cyr"
include "src/transport_stdio.cyr"
include "src/transport_http.cyr"
include "src/transport_unix.cyr"
include "src/bridge.cyr"
include "src/transport_streamable.cyr"
include "src/transport_ws.cyr"
include "src/content.cyr"

var _PNG = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8DwHwAFBQIAX8jx0gAAAABJRU5ErkJggg==";
var _WAV = "UklGRiQAAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQAAAAA=";

fn _cat(a, b, c) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    str_builder_add_cstr(sb, c);
    return str_data(str_builder_build(sb));
}

fn _image_block() { return _cat("{\"type\":\"image\",\"data\":\"", _PNG, "\",\"mimeType\":\"image/png\"}"); }

# ---- tools ----

fn t_simple(args, claims) { return content_text_response("This is a simple text response for testing."); }

fn t_image(args, claims) { return _cat("{\"content\":[", _image_block(), "]}"); }

fn t_audio(args, claims) {
    return _cat("{\"content\":[{\"type\":\"audio\",\"data\":\"", _WAV, "\",\"mimeType\":\"audio/wav\"}]}");
}

fn t_embedded(args, claims) {
    return "{\"content\":[{\"type\":\"resource\",\"resource\":{\"uri\":\"test://embedded-resource\",\"mimeType\":\"text/plain\",\"text\":\"This is an embedded resource content.\"}}]}";
}

fn t_mixed(args, claims) {
    return _cat("{\"content\":[{\"type\":\"text\",\"text\":\"Multiple content types test:\"},", _image_block(),
      ",{\"type\":\"resource\",\"resource\":{\"uri\":\"test://mixed-content-resource\",\"mimeType\":\"application/json\",\"text\":\"{\\\"test\\\":\\\"data\\\",\\\"value\\\":123}\"}}]}");
}

fn t_error(args, claims) {
    return "{\"isError\":true,\"content\":[{\"type\":\"text\",\"text\":\"This tool intentionally returns an error for testing\"}]}";
}

# Reports 0, 50 and 100 of 100, about 50 ms apart, on the request's own stream (3.7.6),
# where the request carried a progressToken; with none, works the same and reports nothing.
fn t_progress(args, claims) {
    bote_progress(0, 100, 0);
    sleep_ms(50);
    bote_progress(50, 100, 0);
    sleep_ms(50);
    bote_progress(100, 100, 0);
    return content_text_response("done");
}

# bote emits no notifications/message, which is what the scenario asks of a request
# that set no log level.
fn t_logging(args, claims) { return content_text_response("logged nothing"); }

fn t_headers(args, claims) { return content_text_response("headers checked"); }

# ---- prompts ----

fn _user_text(text) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"role\":\"user\",\"content\":{\"type\":\"text\",\"text\":\"");
    bote_json_escape(sb, text);
    str_builder_add_cstr(sb, "\"}}");
    return str_data(str_builder_build(sb));
}

fn p_simple(args, claims) { return _cat("{\"messages\":[", _user_text("This is a simple prompt for testing."), "]}"); }

fn p_args(args, claims) {
    var a = jsonx_get_str_dec_a(default_alloc(), args, "arg1");
    var b = jsonx_get_str_dec_a(default_alloc(), args, "arg2");
    if (a == 0) { a = ""; }
    if (b == 0) { b = ""; }
    var text = _cat(_cat("Prompt with arguments: arg1='", a, "', "), _cat("arg2='", b, "'"), "");
    return _cat("{\"messages\":[", _user_text(text), "]}");
}

fn p_embedded(args, claims) {
    var uri = jsonx_get_str_dec_a(default_alloc(), args, "resourceUri");
    if (uri == 0) { uri = "test://embedded-resource"; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"messages\":[{\"role\":\"user\",\"content\":{\"type\":\"resource\",\"resource\":{\"uri\":\"");
    bote_json_escape(sb, uri);
    str_builder_add_cstr(sb, "\",\"mimeType\":\"text/plain\",\"text\":\"Embedded resource content for testing.\"}}},");
    str_builder_add_cstr(sb, _user_text("Please process the embedded resource above."));
    str_builder_add_cstr(sb, "]}");
    return str_data(str_builder_build(sb));
}

fn p_image(args, claims) {
    return _cat(_cat("{\"messages\":[{\"role\":\"user\",\"content\":", _image_block(), "},"),
      _user_text("Please analyze the image above."), "]}");
}

# ---- resources ----

fn r_text(uri, claims) {
    return "{\"contents\":[{\"uri\":\"test://static-text\",\"mimeType\":\"text/plain\",\"text\":\"This is the content of the static text resource.\"}]}";
}

fn r_binary(uri, claims) {
    return _cat("{\"contents\":[{\"uri\":\"test://static-binary\",\"mimeType\":\"image/png\",\"blob\":\"", _PNG, "\"}]}");
}

var _TEMPLATE = "test://template/{id}/data";

fn r_template(uri, claims) {
    var id = resource_template_var_a(default_alloc(), _TEMPLATE, uri, "id");
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"contents\":[{\"uri\":\"");
    bote_json_escape(sb, uri);
    str_builder_add_cstr(sb, "\",\"mimeType\":\"application/json\",\"text\":\"{\\\"id\\\":\\\"");
    bote_json_escape(sb, id);
    str_builder_add_cstr(sb, "\\\",\\\"templateTest\\\":true,\\\"data\\\":\\\"Data for ID: ");
    bote_json_escape(sb, id);
    str_builder_add_cstr(sb, "\\\"}\"}]}");
    return str_data(str_builder_build(sb));
}

fn complete(params, claims) {
    return "{\"completion\":{\"values\":[\"paris\",\"park\",\"party\"],\"total\":150,\"hasMore\":false}}";
}

# (3.8.0) Tools with an outputSchema, whose results the official client checks against
# what tools/list said: a record, an array, which 2025-11-25 is shown wrapped, and a result
# its schema refuses, which bote answers with a tool error. Not called by the suite.
var _FX_WEATHER = "{\"type\":\"object\",\"properties\":{\"temperature\":{\"type\":\"number\"},\"conditions\":{\"type\":\"string\"},\"humidity\":{\"type\":\"number\"}},\"required\":[\"temperature\",\"conditions\",\"humidity\"]}";
var _FX_USERS = "{\"type\":\"array\",\"items\":{\"$ref\":\"#/$defs/user\"},\"$defs\":{\"user\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"}},\"required\":[\"id\",\"name\"]}}}";
fn t_structured(args, claims) { return "{\"temperature\":22.5,\"conditions\":\"Partly cloudy\",\"humidity\":65}"; }
fn t_structured_list(args, claims) { return "[{\"id\":\"1\",\"name\":\"Alice\"},{\"id\":\"2\",\"name\":\"Bob\"}]"; }
fn t_structured_bad(args, claims) { return "{\"temperature\":\"warm\",\"conditions\":\"c\",\"humidity\":1}"; }

fn _otool(d, name, desc, os, fp) {
    return dispatcher_register_tool(d, tool_def_with_output_schema(tool_def_new(name, desc, schema_new("object", 0, vec_new())), os), fp);
}

# (3.8.1) Titles, icons, the rest of serverInfo and instructions, which the official client
# reads back. Not read by the suite.
fn _fx_icons() {
    var i = bote_icon_new("https://example.com/bote.png");
    bote_icon_with_mime_type(i, "image/png");
    var sz = vec_new();
    vec_push(sz, "48x48");
    bote_icon_with_sizes(i, sz);
    bote_icon_with_theme(i, "dark");
    var v = vec_new();
    vec_push(v, i);
    vec_push(v, bote_icon_new("data:image/svg+xml;base64,PHN2Zz4="));
    return v;
}
fn p_titled(args, claims) { return "{\"messages\":[{\"role\":\"user\",\"content\":{\"type\":\"text\",\"text\":\"titled\"}}]}"; }
fn r_titled(uri, claims) { return "{\"contents\":[{\"uri\":\"test://bote-titled\",\"mimeType\":\"text/plain\",\"text\":\"titled\"}]}"; }

# ---- the server ----

fn _tool(d, name, desc, fp) {
    return dispatcher_register_tool(d, tool_def_new(name, desc, schema_new("object", 0, vec_new())), fp);
}

fn _arg(name, desc) { return prompt_arg_new(name, desc, 1); }

# The suite's hooks for a list change on a subscriptions/listen stream (3.7.3): each call
# registers a tool, or a prompt, of its own, a change a listening client is then told of.
var _fx_d = 0;
var _fx_added = 0;
fn _fx_name(prefix) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, prefix);
    str_builder_add_int(sb, _fx_added);
    _fx_added = _fx_added + 1;
    return str_data(str_builder_build(sb));
}

fn t_trigger_tool(args, claims) {
    dispatcher_register_tool(_fx_d, tool_def_new(_fx_name("test_added_tool_"), "Added by test_trigger_tool_change", schema_new("object", 0, vec_new())), &t_simple);
    return content_text_response("tool list changed");
}

# bote_update_resource (3.7.4): says the resource at `uri` changed, which a client listening
# with `resourceSubscriptions` covering it is told of. The suite does not call it; the
# official client does.
fn t_update_resource(args, claims) {
    var uri = jsonx_get_str_dec_a(bote_req_alloc(), args, "uri");
    if (uri == 0 || dispatcher_resource_updated(_fx_d, uri) != 0) { return content_text_error_response("no uri"); }
    return content_text_response("resource updated");
}

fn t_trigger_prompt(args, claims) {
    dispatcher_register_prompt(_fx_d, prompt_def_new(_fx_name("test_added_prompt_"), "Added by test_trigger_prompt_change", vec_new()), &p_simple);
    return content_text_response("prompt list changed");
}

fn fixture_dispatcher() {
    var d = dispatcher_new(tool_registry_new());
    dispatcher_set_server_info(d, "bote-conformance-fixture", _bote_server_version());
    _tool(d, "test_simple_text", "Returns text", &t_simple);
    _tool(d, "test_image_content", "Returns an image", &t_image);
    _tool(d, "test_audio_content", "Returns audio", &t_audio);
    _tool(d, "test_embedded_resource", "Returns a resource", &t_embedded);
    _tool(d, "test_multiple_content_types", "Returns three kinds of content", &t_mixed);
    _tool(d, "test_error_handling", "Always fails", &t_error);
    _tool(d, "test_tool_with_progress", "Reports its progress", &t_progress);
    _tool(d, "test_logging_tool", "Would log", &t_logging);
    var hp = vec_new();
    vec_push(hp, schema_prop_new("region", "{\"type\":\"string\",\"description\":\"Where to run\",\"x-mcp-header\":\"Region\"}"));
    vec_push(hp, schema_prop_new("query", "{\"type\":\"string\"}"));
    dispatcher_register_tool(d, tool_def_new("test_custom_headers", "Mirrors region in a header", schema_new("object", hp, vec_new())), &t_headers);

    dispatcher_register_prompt(d, prompt_def_new("test_simple_prompt", "No arguments", vec_new()), &p_simple);
    var pa = vec_new();
    vec_push(pa, _arg("arg1", "First test argument"));
    vec_push(pa, _arg("arg2", "Second test argument"));
    dispatcher_register_prompt(d, prompt_def_new("test_prompt_with_arguments", "Two arguments", pa), &p_args);
    var pe = vec_new();
    vec_push(pe, _arg("resourceUri", "URI of the resource to embed"));
    dispatcher_register_prompt(d, prompt_def_new("test_prompt_with_embedded_resource", "Embeds a resource", pe), &p_embedded);
    dispatcher_register_prompt(d, prompt_def_new("test_prompt_with_image", "Holds an image", vec_new()), &p_image);

    dispatcher_register_resource(d, resource_def_new("test://static-text", "static-text", "A text resource", "text/plain"), &r_text);
    dispatcher_register_resource(d, resource_def_new("test://static-binary", "static-binary", "A binary resource", "image/png"), &r_binary);
    dispatcher_register_resource_template(d, resource_template_new(_TEMPLATE, "template", "A template", "application/json"), &r_template);
    dispatcher_set_completion(d, &complete);
    _tool(d, "test_trigger_tool_change", "Registers a tool", &t_trigger_tool);
    _tool(d, "test_trigger_prompt_change", "Registers a prompt", &t_trigger_prompt);
    var up = vec_new();
    vec_push(up, schema_prop_new("uri", "{\"type\":\"string\"}"));
    var ur = vec_new();
    vec_push(ur, "uri");
    dispatcher_register_tool(d, tool_def_new("bote_update_resource", "Says a resource changed", schema_new("object", up, ur)), &t_update_resource);
    dispatcher_register_tool(d, tool_def_with_icons(tool_def_with_title(tool_def_with_output_schema(tool_def_new("bote_structured", "Weather, as structured content", schema_new("object", 0, vec_new())), _FX_WEATHER), "Weather now"), _fx_icons()), &t_structured);
    var ta = vec_new();
    vec_push(ta, prompt_arg_with_title(prompt_arg_new("topic", "What to write about", 0), "Topic"));
    dispatcher_register_prompt(d, prompt_def_with_icons(prompt_def_with_title(prompt_def_new("bote_titled_prompt", "A prompt with a title", ta), "Titled prompt"), _fx_icons()), &p_titled);
    dispatcher_register_resource(d, resource_def_with_icons(resource_def_with_title(resource_def_new("test://bote-titled", "bote-titled", "A resource with a title", "text/plain"), "Titled resource"), _fx_icons()), &r_titled);
    dispatcher_register_resource_template(d, resource_template_with_icons(resource_template_with_title(resource_template_new("test://bote-titled/{id}", "bote-titled-template", "A template with a title", "text/plain"), "Titled template"), _fx_icons()), &r_titled);
    dispatcher_set_server_details(d, "bote conformance fixture", "The servers the official suite and client are run against", "https://github.com/MacCracken/bote", _fx_icons());
    dispatcher_set_instructions(d, "Call bote_structured for the weather.\nIt has an outputSchema.");
    _otool(d, "bote_structured_list", "Users, an array", _FX_USERS, &t_structured_list);
    _otool(d, "bote_structured_bad", "A result its schema refuses", _FX_WEATHER, &t_structured_bad);
    _fx_d = d;
    return d;
}

# subscriptions/listen on every mode, as the binary has it (3.7.3).
fn _fx_hub(d) {
    var h = bote_listen_hub_new(64);
    dispatcher_set_listen(d, h);
    dispatcher_set_events(d, bote_listen_sink(h, dispatcher_event_sink(d)));
    return h;
}

fn _port(arg, dflt) {
    if (arg == 0) { return dflt; }
    var n = 0;
    var i = 0;
    while (load8(arg + i) != 0) {
        n = n * 10 + load8(arg + i) - 48;
        i = i + 1;
    }
    return n;
}

fn main() {
    alloc_init();
    args_init();
    var d = fixture_dispatcher();
    var mode = "stdio";
    if (argc() > 1) { mode = argv(1); }
    var arg = 0;
    if (argc() > 2) { arg = argv(2); }
    if (streq(mode, "http") == 1) {
        _fx_hub(d);
        var hcfg = http_config_new("/mcp", INADDR_LOOPBACK(), _port(arg, 8395));
        http_config_with_session_store(hcfg, session_store_default());
        return transport_http_run(d, hcfg);
    }
    if (streq(mode, "auth") == 1) {
        var port = _port(arg, 8398);
        var servers = vec_new();
        vec_push(servers, _cat("http://127.0.0.1:", argv(3), ""));
        var scopes = vec_new();
        vec_push(scopes, "mcp:read");
        var resource = _cat("http://127.0.0.1:", arg, "/mcp");
        var jwt = jwt_secret_new("conformance-fixture-secret-32-bytes!");
        if (argc() > 4 && strlen(argv(4)) > 4 && memeq(argv(4), "http", 4) == 1) {
            # A jwks_uri: the authorization server's keys, fetched (3.6.6).
            jwt = jwt_secret_new(0);
            jwt_secret_with_key_source(jwt, &bote_jwks_fetch, bote_jwks_source_new(argv(4), 0), 600);
            if (jwt_secret_refresh(jwt) != 0) { return 1; }
        } elif (argc() > 4) {
            var jl[8];
            jwt = jwt_secret_from_jwks(file_read_whole_max(argv(4), BOTE_JWKS_MAX, &jl));
        }
        jwt_secret_with_audience(jwt, resource);
        jwt_secret_with_issuers(jwt, servers);
        var write = vec_new();
        vec_push(write, "mcp:write");
        dispatcher_register_tool(d, tool_def_with_required_scopes(tool_def_new("test_needs_scope", "Needs mcp:write", schema_new("object", 0, vec_new())), write), &t_simple);
        dispatcher_set_scope_check(d, &jwt_scope_check, jwt_scope_rule(jwt_scope_rules_new(), "mcp:admin", "mcp:write"));
        var acfg = http_config_new("/mcp", INADDR_LOOPBACK(), port);
        http_config_with_bearer_validator(acfg, &auth_validator_jwt, jwt);
        http_config_with_resource_metadata(acfg, bote_prm_new(resource, servers, scopes, "fixture"));
        return transport_http_run(d, acfg);
    }
    if (streq(mode, "bridge") == 1) {
        _fx_hub(d);
        return transport_bridge_run(d, bridge_config_new(INADDR_LOOPBACK(), _port(arg, 8397)));
    }
    if (streq(mode, "streamable") == 1) {
        _fx_hub(d);
        var st = session_store_default();
        var cfg = streamable_config_new("/mcp", INADDR_LOOPBACK(), _port(arg, 8396));
        streamable_config_with_session_store(cfg, st);
        return transport_streamable_run(d, cfg);
    }
    var line = bote_listen_line_new(64);
    dispatcher_set_events(d, bote_listen_sink(line, dispatcher_event_sink(d)));
    transport_stdio_with_listen(line);
    return transport_stdio_run(d);
}

var r = main();
sys_exit(r);
