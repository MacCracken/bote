}

# _ra_heap_per_msg through the bridge's own tools/call wrapping.
fn _ra_bridge_heap_per_msg(msg, d, n) {
    bridge_process_message_a(bote_req_begin(), msg, d, 0);
    var before = alloc_used();
    var i = 0;
    while (i < n) {
        bridge_process_message_a(bote_req_begin(), msg, d, 0);
        i = i + 1;
    }
    return (alloc_used() - before) / n;
}

