fn h_badjson_t(args, claims) { return "{oops"; }

# ---- sakshi capture (3.4.0 logging assertions) -----------------------------
var _lc_buf = 0;
var _lc_level = 0 - 1;
var _lc_count = 0;
fn _lc_hook(ts, level, category, msg, msg_len, sixth) {
    var n = msg_len;
    if (n > 1023) { n = 1023; }
    memcpy(_lc_buf, msg, n);
    store8(_lc_buf + n, 0);
    _lc_level = level;
    _lc_count = _lc_count + 1;
    return 0;
}
fn _lc_begin() {
    if (_lc_buf == 0) { _lc_buf = alloc(1024); }
    store8(_lc_buf, 0);
    _lc_level = 0 - 1;
    _lc_count = 0;
    sakshi_set_emit_hook(&_lc_hook);
    sakshi_set_level(SK_TRACE);
    return 0;
}
fn _lc_end() { sakshi_clear_emit_hook(); return 0; }
# bote_json_escape of cstr `s`, as a new cstr (3.4.6).
fn _esc(s) {
    var sb = str_builder_new();
    bote_json_escape(sb, s);
    return str_data(str_builder_build(sb));
}
# 1 when cstr `hay` contains cstr `needle`.
fn _lc_has(hay, needle) {
    if (hay == 0 || needle == 0) { return 0; }
    var i = 0;
    while (load8(hay + i) != 0) {
        var j = 0;
        while (load8(needle + j) != 0 && load8(hay + i + j) == load8(needle + j)) { j = j + 1; }
        if (load8(needle + j) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# ---- the request arena (3.4.15) --------------------------------------------
# Heap bytes `msg` leaves behind per message, over `n` messages through the
# arena, after one warm-up so that lazy one-time state does not count.
fn _ra_heap_per_msg(msg, d, n) {
    codec_process_message_a(bote_req_begin(), msg, d, 0);
    var before = alloc_used();
    var i = 0;
    while (i < n) {
        codec_process_message_a(bote_req_begin(), msg, d, 0);
        i = i + 1;
    }
    return (alloc_used() - before) / n;
}

# A request for `method`, whose params are `prefix`, `fill` n times, `suffix`.
fn _ra_fill_of(method, prefix, fill, n, suffix) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"");
    str_builder_add_cstr(sb, method);
    str_builder_add_cstr(sb, "\",\"params\":");
    str_builder_add_cstr(sb, prefix);
    var i = 0;
    while (i < n) {
        str_builder_add_cstr(sb, fill);
        i = i + 1;
    }
    str_builder_add_cstr(sb, suffix);
    str_builder_add_cstr(sb, "}");
    return str_data(str_builder_build(sb));
}
fn _ra_fill(method, prefix, n, suffix) { return _ra_fill_of(method, prefix, "x", n, suffix); }

# `{"jsonrpc":"2.0","id":<id>,"method":"<method>"}`, each as given.
fn _ra_msg(id, method) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":");
    str_builder_add_cstr(sb, id);
    str_builder_add_cstr(sb, ",\"method\":\"");
    str_builder_add_cstr(sb, method);
    str_builder_add_cstr(sb, "\"}");
    return str_data(str_builder_build(sb));
}

# `n` copies of `fill`.
fn _ra_rep(fill, n) {
    var sb = str_builder_new();
    var i = 0;
    while (i < n) {
        str_builder_add_cstr(sb, fill);
        i = i + 1;
    }
    return str_data(str_builder_build(sb));
}

