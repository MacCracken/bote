# EventSink test backend: pushes (topic, payload) pairs into a global vec.
# Used by discovery, audit, and events tests below.
var _ev_topics = 0;
var _ev_payloads = 0;
fn test_event_publish(ctx, topic, payload) {
    if (_ev_topics == 0) { _ev_topics = vec_new(); _ev_payloads = vec_new(); }
    vec_push(_ev_topics, topic);
    vec_push(_ev_payloads, payload);
    return 0;
}
fn _ev_reset() {
    _ev_topics = vec_new();
    _ev_payloads = vec_new();
    return 0;
}

# AuditSink test backend: pushes ToolCallEvent ptrs into a global vec.
var _audit_events = 0;
fn test_audit_log(ctx, event) {
    if (_audit_events == 0) { _audit_events = vec_new(); }
    vec_push(_audit_events, event);
    return 0;
}
fn _audit_reset() { _audit_events = vec_new(); return 0; }
# 3.6.3: every kind of handler, recording the claims it was handed.
var _kc_seen = 0;
fn h_kc_tool(args, claims) { _kc_seen = claims; return "{\"content\":[]}"; }
fn h_kc_prompt(args, claims) { _kc_seen = claims; return "{\"messages\":[]}"; }
fn h_kc_res(uri, claims) { _kc_seen = claims; return "{\"contents\":[]}"; }
fn h_kc_complete(params, claims) { _kc_seen = claims; return "{\"completion\":{\"values\":[]}}"; }

# 1 when a handler reached by `method` with `params` gets a copy of a token on the arena.
fn _kc_copied(d, method, params) {
    var al = bote_req_begin();
    var tok = alloc_via(al, 8);
    memcpy(tok, "tok-abc", 8);
    bote_req_note_token(tok);
    _kc_seen = 0;
    dispatcher_dispatch_a(al, d, req_with_params(req_new("1", method), params), tok);
    if (_kc_seen == 0 || _kc_seen == tok) { return 0; }
    return streq(_kc_seen, "tok-abc");
}

# 3.6.3: a scope check that counts its calls through `ctx`, and one that says 2.
var _scope_calls = 0;
fn _sc_has(claims, scope, ctx) {
    if (ctx != 0) { store64(ctx, load64(ctx) + 1); }
    return strstr(claims, scope) >= 0;
}
fn _sc_two(claims, scope, ctx) { return 2; }
var _sc_runs = 0;
fn h_sc(args, claims) {
    _sc_runs = _sc_runs + 1;
    return "{\"content\":[]}";
}
# 3.6.6: a prompt, a resource and a completion that count their runs.
var _sp_runs = 0;
fn h_sp_prompt(args, claims) { _sp_runs = _sp_runs + 1; return "{\"messages\":[]}"; }
fn h_sp_res(uri, claims) { _sp_runs = _sp_runs + 1; return "{\"contents\":[]}"; }
fn h_sp_complete(params, claims) { _sp_runs = _sp_runs + 1; return "{\"completion\":{\"values\":[]}}"; }

# `prefix` and `i`, a name for a filler entry.
fn _sp_zname(prefix, i) {
    var zb = str_builder_new();
    str_builder_add_cstr(zb, prefix);
    str_builder_add_int(zb, i);
    return str_data(str_builder_build(zb));
}

# `{"jsonrpc":"2.0","id":1,"method":<method>,"params":<params>}`.
fn _sp_msg(method, params) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"");
    str_builder_add_cstr(sb, method);
    str_builder_add_cstr(sb, "\",\"params\":");
    str_builder_add_cstr(sb, params);
    str_builder_add_cstr(sb, "}");
    return str_data(str_builder_build(sb));
}

# Heap bytes `msg` leaves per message, through the arena, with `claims`.
fn _sp_heap(msg, d, claims, n) {
    codec_process_message_a(bote_req_begin(), msg, d, claims);
    var before = alloc_used();
    var i = 0;
    while (i < n) {
        codec_process_message_a(bote_req_begin(), msg, d, claims);
        i = i + 1;
    }
    return (alloc_used() - before) / n;
}

fn _sc_call(d, tool, extra, claims) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"");
    str_builder_add_cstr(sb, tool);
    str_builder_add_cstr(sb, "\"");
    str_builder_add_cstr(sb, extra);
    str_builder_add_cstr(sb, "}}");
    return codec_process_message(str_data(str_builder_build(sb)), d, claims);
}
