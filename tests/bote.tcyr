# Up to four bytes as a cstr.
fn _u8(b0, b1, b2, b3) {
    var p = alloc(5);
    store8(p, b0);
    store8(p + 1, b1);
    store8(p + 2, b2);
    store8(p + 3, b3);
    store8(p + 4, 0);
    return p;
}

fn _h_bad_json(args, claims) { return "{oops"; }
fn _h_pretty(args, claims) { return "{\n  \"completion\": {\"values\": []}\r\n}"; }
fn _h_pretty_call(args, claims) { return "{\n  \"content\": [],\n  \"isError\": false\n}"; }
fn _h_uri(uri, claims) { return "{\"contents\":[]}"; }
