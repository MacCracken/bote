}

# A JSON string of `n` x's, as the value of "a" in an object.
fn _ra_big_args(n) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"a\":\"");
    var i = 0;
    while (i < n) { str_builder_add_cstr(sb, "x"); i = i + 1; }
    str_builder_add_cstr(sb, "\"}");
    return str_data(str_builder_build(sb));
}

fn _ra_call(name, args_json) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"");
    str_builder_add_cstr(sb, name);
    str_builder_add_cstr(sb, "\",\"caller_id\":\"kept-caller\",\"arguments\":");
    str_builder_add_cstr(sb, args_json);
    str_builder_add_cstr(sb, "}}");
    return str_data(str_builder_build(sb));
}

# Hold a listening socket on the first free port of 18400-18499, so that a
# serve on that port fails at bind. Stores the fd through `out_fd` and returns
# the port, or 0 when none could be held.
fn _held_port(out_fd) {
    var p = 18400;
    while (p < 18500) {
        var st, sfd = tcp_socket();
        if (is_err_result(st) == 1) { return 0; }
        var bt, bv = sock_bind(sfd, 0x0100007F, p);
        if (is_err_result(bt) == 0) {
            sock_listen(sfd, 4);
            store64(out_fd, sfd);
            return p;
        }
        sock_close(sfd);
        p = p + 1;
    }
    return 0;
}

fn _rt_h(uri, claims) { return "{\"contents\":[{\"uri\":\"x\",\"text\":\"from the template\"}]}"; }
fn _rt_h2(uri, claims) { return "{\"contents\":[{\"uri\":\"x\",\"text\":\"from the second\"}]}"; }
fn _rt_exact(uri, claims) { return "{\"contents\":[{\"uri\":\"x\",\"text\":\"from the resource\"}]}"; }
fn _rt_prompt(args, claims) { return "{\"messages\":[]}"; }

fn _rt_ok(t, u) { return resource_template_matches(t, u); }

fn _rt_var(t, u, n) { return resource_template_var_a(default_alloc(), t, u, n); }

fn _cat3(a, b, c) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    str_builder_add_cstr(sb, c);
    return str_data(str_builder_build(sb));
}

fn _ra_int(n) {
    var sb = str_builder_new();
    str_builder_add_int(sb, n);
    return str_data(str_builder_build(sb));
}

fn _ra_long_uri(prefix, n) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"resources/read\",\"params\":{\"uri\":\"");
    str_builder_add_cstr(sb, prefix);
    var i = 0;
    while (i < n) {
        str_builder_add_cstr(sb, "x");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "\"}}");
    return str_data(str_builder_build(sb));
}

# Why a tool with the one property schema `raw` cannot register, or 0.
fn _hdr_why(raw) {
    var p = vec_new();
    vec_push(p, schema_prop_new("a", raw));
    return registry_check_tool_def(tool_def_new("t", "x", schema_new("object", p, vec_new())));
}

fn main() {
    alloc_init();
    fl_init();

    # ---------------- error: rpc_code mapping ----------------
    assert_eq(bote_err_rpc_code(BOTE_ERR_PARSE), 0 - 32700, "rpc_code parse");
    assert_eq(bote_err_rpc_code(BOTE_ERR_PROTOCOL), 0 - 32600, "rpc_code protocol");
    assert_eq(bote_err_rpc_code(BOTE_ERR_TOOL_NOT_FOUND), 0 - 32602, "rpc_code tool_not_found (-32602 since 3.4.5, the MCP tools spec)");
    assert_eq(bote_err_rpc_code(BOTE_ERR_INVALID_PARAMS), 0 - 32602, "rpc_code invalid_params");
    assert_eq(bote_err_rpc_code(BOTE_ERR_SCHEMA_VIOLATION), 0 - 32602, "rpc_code schema_violation");
    assert_eq(bote_err_rpc_code(BOTE_ERR_EXEC_FAILED), 0 - 32000, "rpc_code exec_failed");
    assert_eq(bote_err_rpc_code(BOTE_ERR_SANDBOX), 0 - 32000, "rpc_code sandbox");
    assert_eq(bote_err_rpc_code(BOTE_ERR_TRANSPORT_CLOSED), 0 - 32003, "rpc_code transport_closed");
    assert_eq(bote_err_rpc_code(BOTE_ERR_BIND_FAILED), 0 - 32003, "rpc_code bind_failed");
    assert_eq(bote_err_rpc_code(BOTE_ERR_REQUEST_CANCELLED), 0 - 32800, "rpc_code cancelled");
    assert_eq(bote_err_rpc_code(BOTE_ERR_JSON), 0 - 32700, "rpc_code json");
    assert_eq(bote_err_rpc_code(BOTE_ERR_IO), 0 - 32603, "rpc_code io");

    # ---------------- error: accessors ----------------
    var e = bote_err_new(BOTE_ERR_INVALID_PARAMS, "echo", "missing 'name'");
    assert_eq(bote_err_tag(e), BOTE_ERR_INVALID_PARAMS, "tag stored");
    assert(streq(bote_err_tool(e), "echo") == 1, "tool stored");
    assert(streq(bote_err_reason(e), "missing 'name'") == 1, "reason stored");
    assert_eq(bote_err_violations(e), 0, "no violations on plain err");

    # ---------------- error: format ----------------
    var s1 = bote_err_format(bote_err_new(BOTE_ERR_TOOL_NOT_FOUND, "foo", 0));
    assert(str_eq(s1, str_from("tool not found: foo")) == 1, "fmt tool_not_found");

    var s2 = bote_err_format(bote_err_new(BOTE_ERR_INVALID_PARAMS, "t", "r"));
    assert(str_eq(s2, str_from("invalid params for tool 't': r")) == 1, "fmt invalid_params");

    var s3 = bote_err_format(bote_err_new(BOTE_ERR_EXEC_FAILED, "t", "r"));
    assert(str_eq(s3, str_from("tool execution failed: t - r")) == 1, "fmt exec_failed");

    var s4 = bote_err_format(bote_err_new(BOTE_ERR_TRANSPORT_CLOSED, 0, 0));
    assert(str_eq(s4, str_from("transport closed")) == 1, "fmt transport_closed");

    var s5 = bote_err_format(bote_err_new(BOTE_ERR_BIND_FAILED, 0, "port in use"));
    assert(str_eq(s5, str_from("transport bind failed: port in use")) == 1, "fmt bind_failed");

    # ---------------- error: schema violations join ----------------
    var vs = vec_new();
    vec_push(vs, "name required");
    vec_push(vs, "id must be int");
    var sv = bote_err_with_violations(BOTE_ERR_SCHEMA_VIOLATION, "tool_x", vs);
    var s6 = bote_err_format(sv);
    assert(str_eq(s6, str_from("schema violation for tool 'tool_x': name required; id must be int")) == 1, "fmt schema joins");

    # ---------------- protocol: request creation ----------------
    var req = req_new("1", "tools/list");
    assert(streq(req_jsonrpc(req), "2.0") == 1, "req jsonrpc 2.0");
    assert(streq(req_id(req), "1") == 1, "req id stored");
    assert(streq(req_method(req), "tools/list") == 1, "req method stored");
    assert_eq(req_is_notification(req), 0, "req not notification");

    # ---------------- protocol: notification ----------------
    var n = req_notification("notifications/initialized");
    assert_eq(req_id(n), 0, "notif id is 0");
    assert_eq(req_is_notification(n), 1, "notif flagged");
    assert(streq(req_method(n), "notifications/initialized") == 1, "notif method");

    # ---------------- protocol: with_params ----------------
    var rp = req_with_params(req_new("42", "tools/call"), "{\"name\":\"echo\"}");
    assert(streq(req_params(rp), "{\"name\":\"echo\"}") == 1, "params overridden");

    # default params when not set
    var rd = req_new("1", "initialize");
    assert(streq(req_params(rd), "null") == 1, "default params null");

    # ---------------- protocol: response success ----------------
    var ok = resp_success("1", "{\"tools\":[]}");
    assert(streq(resp_jsonrpc(ok), "2.0") == 1, "resp jsonrpc 2.0");
    assert(streq(resp_id(ok), "1") == 1, "resp id");
    assert(streq(resp_result(ok), "{\"tools\":[]}") == 1, "resp result");
    assert_eq(resp_error_obj(ok), 0, "resp success no error obj");

    # ---------------- protocol: response error ----------------
    var er = resp_error("1", 0 - 32601, "tool not found");
    assert_eq(resp_result(er), 0, "resp error no result");
    var eobj = resp_error_obj(er);
    assert(eobj != 0, "resp error has error obj");
    assert_eq(rpc_err_code(eobj), 0 - 32601, "rpc err code");
    assert(streq(rpc_err_message(eobj), "tool not found") == 1, "rpc err message");
    assert_eq(rpc_err_data(eobj), 0, "rpc err data null");

    # ---------------- protocol: response preserves arbitrary id ----------------
    var rid = resp_success("\"abc-123\"", "{}");
    assert(streq(resp_id(rid), "\"abc-123\"") == 1, "string id preserved");

    # ---------------- registry: empty ----------------
    var reg = tool_registry_new();
    assert_eq(registry_is_empty(reg), 1, "new reg empty");
    assert_eq(registry_len(reg), 0, "new reg len 0");
    assert_eq(registry_get(reg, "anything"), 0, "get on empty returns 0");
    assert_eq(vec_len(registry_list(reg)), 0, "list on empty returns empty vec");

    # ---------------- registry: register + get + contains ----------------
    var req_path = vec_new();
    vec_push(req_path, "path");
    var schema_a = schema_new("object", 0, req_path);
    var tool_a = tool_def_new("scan", "scan tool", schema_a);
    registry_register(reg, tool_a);
    assert_eq(registry_contains(reg, "scan"), 1, "contains registered");
    assert_eq(registry_contains(reg, "nope"), 0, "contains absent");
    assert_eq(registry_len(reg), 1, "len after register");
    var got = registry_get(reg, "scan");
    assert(got != 0, "get returns def");
    assert(streq(tool_def_name(got), "scan") == 1, "got correct name");
    assert(streq(tool_def_description(got), "scan tool") == 1, "got description");

    # ---------------- registry: list returns insertion order ----------------
    var schema_b = schema_new("object", 0, vec_new());
    registry_register(reg, tool_def_new("alpha", "a tool", schema_b));
    registry_register(reg, tool_def_new("beta", "b tool", schema_b));
    var lst = registry_list(reg);
    assert_eq(vec_len(lst), 3, "list has 3");
    assert(streq(tool_def_name(vec_get(lst, 0)), "scan") == 1, "list[0] = scan");
    assert(streq(tool_def_name(vec_get(lst, 1)), "alpha") == 1, "list[1] = alpha");
    assert(streq(tool_def_name(vec_get(lst, 2)), "beta") == 1, "list[2] = beta");

    # ---------------- registry: register overwrites ----------------
    var schema_dup = schema_new("object", 0, vec_new());
    registry_register(reg, tool_def_new("scan", "updated", schema_dup));
    assert_eq(registry_len(reg), 3, "len unchanged on overwrite");
    assert(streq(tool_def_description(registry_get(reg, "scan")), "updated") == 1, "description updated");

    # ---------------- registry: validate_params ok with required field ----------------
    var reg2 = tool_registry_new();
    var rp2 = vec_new();
    vec_push(rp2, "path");
    var schema_p = schema_new("object", 0, rp2);
    registry_register(reg2, tool_def_new("scan", "scan tool", schema_p));
    var ok_err = registry_validate_params(reg2, "scan", "{\"path\":\"/tmp\"}");
    assert_eq(ok_err, 0, "validate ok with field");

    # ---------------- registry: validate_params missing field ----------------
    var miss_err = registry_validate_params(reg2, "scan", "{}");
    assert(miss_err != 0, "validate err on missing");
    # 3.4.8: registration compiles the schema, so a missing required field is
    # the compiled validator's SCHEMA_VIOLATION (it was the required-only
    # fallback's INVALID_PARAMS).
    assert_eq(bote_err_tag(miss_err), BOTE_ERR_SCHEMA_VIOLATION, "missing -> SCHEMA_VIOLATION (compiled at registration)");

    # ---------------- registry: the required-only fallback (3.4.11) ----------------
    # Registration always compiles a schema, so a definition reaches the
    # fallback only with the compiled one taken away. A repeated key is valid
    # to jsonx_valid, so it can arrive here from the wire.
    var fbreg = tool_registry_new();
    registry_register(fbreg, tool_def_new("scan", "scan tool", schema_p));
    tool_def_with_compiled(registry_get(fbreg, "scan"), 0);
    var fb_miss = registry_validate_params(fbreg, "scan", "{}");
    assert(fb_miss != 0 && bote_err_tag(fb_miss) == BOTE_ERR_INVALID_PARAMS, "fallback: a missing required field -> INVALID_PARAMS");
    assert(fb_miss != 0 && streq(bote_err_reason(fb_miss), "missing required field: path") == 1, "fallback: ...naming the field");
    var rp_two = vec_new();
    vec_push(rp_two, "path");
    vec_push(rp_two, "mode");
    registry_register(fbreg, tool_def_new("scan_two", "scan tool", schema_new("object", 0, rp_two)));
    tool_def_with_compiled(registry_get(fbreg, "scan_two"), 0);
    var fb_second = registry_validate_params(fbreg, "scan_two", "{\"path\":\"/tmp\"}");
    assert(fb_second != 0 && streq(bote_err_reason(fb_second), "missing required field: mode") == 1, "fallback: every required field is checked, not only the first");
    assert_eq(registry_validate_params(fbreg, "scan", "{\"path\":\"/tmp\"}"), 0, "fallback: the field present passes");
    assert_eq(registry_validate_params(fbreg, "scan", "{\"path\":null}"), 0, "fallback: present means present, whatever the value");
    assert(registry_validate_params(fbreg, "scan", "{\"x\":{\"path\":1}}") != 0, "fallback: a nested key is not the field");
    assert(registry_validate_params(fbreg, "scan", "{\"x\":\"\\\"path\\\":1\"}") != 0, "fallback: a key spelled inside a string is not the field");
    assert_eq(registry_validate_params(fbreg, "scan", "{\"path\":\"/a\",\"path\":\"/b\"}"), 0, "fallback: a repeated key is still present");
    assert_eq(registry_validate_params(reg2, "scan", "{\"path\":\"/a\",\"path\":\"/b\"}"), 0, "compiled path: the same repeated key passes, so the two paths agree");

    # ---------------- resources: templates ----------------
    assert_eq(resource_template_check("test://template/{id}/data"), 0, "template: one expression");
    assert_eq(resource_template_check("repo://{owner}/{repo}/issues/{n}"), 0, "template: one a segment");
    assert_eq(resource_template_check("file:///{path}"), 0, "template: the spec's example");
    assert_eq(resource_template_check("a://{x_1}.json"), 0, "template: text beside an expression");
    assert_eq(resource_template_check("a://b?q={q}#{f}"), 0, "template: a query and a fragment are segments");
    assert(resource_template_check(0) != 0, "template refused: none");
    assert(resource_template_check("a://b") != 0, "template refused: no expression");
    assert(resource_template_check("a://{x") != 0, "template refused: unclosed");
    assert(resource_template_check("a://x}") != 0, "template refused: a stray close");
    assert(resource_template_check("a://{x}/y}") != 0, "template refused: a stray close beside a good expression");
    assert(resource_template_check("a://{}") != 0, "template refused: no name");
    assert(resource_template_check("a://{+x}") != 0, "template refused: a level 2 operator");
    assert(resource_template_check("a://{#x}") != 0, "template refused: the fragment operator");
    assert(resource_template_check("a://{?x}") != 0, "template refused: a query operator");
    assert(resource_template_check("a://{x,y}") != 0, "template refused: two names");
    assert(resource_template_check("a://{x*}") != 0, "template refused: explode");
    assert(resource_template_check("a://{x:3}") != 0, "template refused: a prefix");
    assert(resource_template_check("a://{x}{y}") != 0, "template refused: two in a segment");
    assert(resource_template_check("a://{x}-{y}") != 0, "template refused: two in a segment, text between");
    assert(resource_template_check("a://{x}/{x}") != 0, "template refused: a name twice");
    assert_eq(resource_template_check("a://{x}/{xy}/{yx}"), 0, "template: names that share letters are not repeats");
    assert_eq(resource_template_check("a://{xy}/{x}"), 0, "template: nor is a name that starts a longer one");

    assert_eq(_rt_ok("t://a/{id}/b", "t://a/123/b"), 1, "match: the value");
    assert_eq(_rt_ok("t://a/{id}/b", "t://a/x.y-z%2F/b"), 1, "match: dots and percent-encoding are a value");
    assert_eq(_rt_ok("t://a/{id}/b", "t://a//b"), 0, "match: an empty value is none");
    assert_eq(_rt_ok("t://a/{id}/b", "t://a/1/2/b"), 0, "match: a value holds no slash");
    assert_eq(_rt_ok("t://a/{id}/b", "t://a/1?x/b"), 0, "match: nor a question mark");
    assert_eq(_rt_ok("t://a/{id}/b", "t://a/1#x/b"), 0, "match: nor a hash");
    assert_eq(_rt_ok("t://a/{id}/b", "t://a/1/b/c"), 0, "match: text past the end");
    assert_eq(_rt_ok("t://a/{id}/b", "t://a/1/"), 0, "match: the end missing");
    assert_eq(_rt_ok("t://a/{id}/b", "t://a/1"), 0, "match: more of the end missing");
    assert_eq(_rt_ok("t://a/{id}/b", "t://x/1/b"), 0, "match: other text");
    assert_eq(_rt_ok("t://a/{id}/b", ""), 0, "match: nothing");
    assert_eq(_rt_ok("t://{id}", "t://1"), 1, "match: an expression last");
    assert_eq(_rt_ok("t://{id}", "t://"), 0, "match: ...with no value");
    assert_eq(_rt_ok("t://{id}.json", "t://a.b.json"), 1, "match: the value keeps its dots ahead of a suffix");
    assert_eq(_rt_ok("t://{id}.json", "t://.json"), 0, "match: a suffix with no value");
    assert_eq(_rt_ok("t://{id}.json", "t://a.jso"), 0, "match: a suffix cut short");
    assert_eq(_rt_ok("t://{a}/{b}", "t://1/2"), 1, "match: two");
    assert_eq(_rt_ok("t://{a}/{b}", "t://1"), 0, "match: one of two");
    assert_eq(_rt_ok("t://{a}/{b}", "t://1/"), 0, "match: the second empty");
    assert_eq(resource_template_matches(0, "t://1"), 0, "match: no template");
    assert_eq(resource_template_matches("t://{a}", 0), 0, "match: no URI");

    assert(streq(_rt_var("t://a/{id}/b", "t://a/123/b", "id"), "123") == 1, "var: the value");
    assert(streq(_rt_var("t://{a}/{b}", "t://1/2", "a"), "1") == 1, "var: the first");
    assert(streq(_rt_var("t://{a}/{b}", "t://1/2", "b"), "2") == 1, "var: the second");
    assert(streq(_rt_var("t://{id}.json", "t://a.b.json", "id"), "a.b") == 1, "var: ahead of a suffix");
    assert(streq(_rt_var("t://{id}/x", "t://a%2Fb/x", "id"), "a%2Fb") == 1, "var: as sent, not decoded");
    assert_eq(_rt_var("t://a/{id}/b", "t://a/123/b", "nope"), 0, "var: no such expression");
    assert_eq(_rt_var("t://a/{idx}/b", "t://a/123/b", "id"), 0, "var: a name that only starts the same");
    assert_eq(_rt_var("t://a/{id}/b", "t://a/123/b", "idx"), 0, "var: a name longer than the expression");
    assert_eq(_rt_var("t://a/{id}/b", "t://a/1/2/b", "id"), 0, "var: no match");
    assert_eq(_rt_var(0, "t://1", "id"), 0, "var: no template");
    assert_eq(_rt_var("t://{id}", 0, "id"), 0, "var: no URI");
    assert_eq(_rt_var("t://{id}", "t://1", 0), 0, "var: no name");

    var rtd = dispatcher_new(tool_registry_new());
    assert(dispatcher_register_resource_template(rtd, resource_template_new("t://{x}{y}", "bad", 0, 0), &_rt_h) != 0, "template: a bad one is refused");
    assert_eq(dispatcher_resources(rtd), 0, "template: ...and nothing stood up");
    assert(dispatcher_register_resource_template(rtd, resource_template_new("t://{x}", 0, 0, 0), &_rt_h) != 0, "template: a name is required");
    assert(dispatcher_register_resource_template(rtd, 0, &_rt_h) != 0, "template: none at all");
    assert_eq(dispatcher_register_resource_template(rtd, resource_template_new("t://a/{id}", "first", "The first", "text/plain"), &_rt_h), 0, "template: registered");
    assert(dispatcher_resources(rtd) != 0, "template: that alone stands up the registry");
    dispatcher_register_resource_template(rtd, resource_template_new("t://{any}/1", "second", 0, 0), &_rt_h2);
    dispatcher_register_resource(rtd, resource_def_new("t://a/exact", "exact", 0, "text/plain"), &_rt_exact);
    var rtreg = dispatcher_resources(rtd);
    assert_eq(vec_len(resource_registry_templates(rtreg)), 2, "template: two kept");
    assert_eq(resource_registry_template_handler(rtreg, "t://a/1"), &_rt_h, "template: the handler for a URI");
    assert_eq(resource_registry_template_handler(rtreg, "t://b/1"), &_rt_h2, "template: another");
    assert_eq(resource_registry_template_handler(rtreg, "x://nope"), 0, "template: none");
    dispatcher_register_resource_template(rtd, resource_template_new("t://z/{id}/q", "third", 0, 0), &_rt_h);
    dispatcher_register_resource_template(rtd, resource_template_new("t://z/{id}/q", "third again", 0, 0), &_rt_h2);
    assert_eq(vec_len(resource_registry_templates(rtreg)), 3, "template: the same uriTemplate replaces");
    assert_eq(resource_registry_template_handler(rtreg, "t://z/1/q"), &_rt_h2, "template: ...with its handler");
    var rtl = codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"resources/templates/list\"}", rtd, 0);
    assert(strstr(rtl, "\"uriTemplate\":\"t://a/{id}\",\"name\":\"first\",\"description\":\"The first\",\"mimeType\":\"text/plain\"") >= 0, "template: listed");
    assert(strstr(rtl, "\"uriTemplate\":\"t://{any}/1\",\"name\":\"second\"}") >= 0, "template: optional fields left out");
    assert(strstr(rtl, "t://a/exact") < 0, "template: a resource is not one");
    var rtr = codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"resources/list\"}", rtd, 0);
    assert(strstr(rtr, "t://a/exact") >= 0 && strstr(rtr, "{id}") < 0, "template: resources/list holds no template");
    var rtx = codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"resources/read\",\"params\":{\"uri\":\"t://a/exact\"}}", rtd, 0);
    assert(strstr(rtx, "from the resource") >= 0, "template: an exact resource wins");
    var rtv = codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"resources/read\",\"params\":{\"uri\":\"t://a/9\"}}", rtd, 0);
    assert(strstr(rtv, "from the template") >= 0, "template: a URI it matches goes to its handler");

    # A list leaves nothing behind, whatever its length (3.5.3). The rows before this one
    # held short lists, which fit a fixed 4 KB, and missed that a longer one did not.
    var bigd = dispatcher_new(tool_registry_new());
    var bi = 0;
    while (bi < 200) {
        var bsb = str_builder_new();
        str_builder_add_cstr(bsb, "res://a-rather-long-resource-uri-for-a-list-of-them/");
        str_builder_add_int(bsb, bi);
        var bu = str_data(str_builder_build(bsb));
        var bargs = vec_new();
        vec_push(bargs, prompt_arg_new(bu, bu, 1));
        dispatcher_register_resource(bigd, resource_def_new(bu, bu, bu, "text/plain"), &_rt_h);
        dispatcher_register_prompt(bigd, prompt_def_new(bu, bu, bargs), &_rt_prompt);
        var bt = _cat3(bu, "/{id}", "");
        dispatcher_register_resource_template(bigd, resource_template_new(bt, bu, bu, "text/plain"), &_rt_h);
        bi = bi + 1;
    }
    assert_eq(_ra_heap_per_msg("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"resources/list\"}", bigd, 20), 0, "heap: 200 resources");
    assert_eq(_ra_heap_per_msg("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"prompts/list\"}", bigd, 20), 0, "heap: 200 prompts");
    assert_eq(_ra_heap_per_msg("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"resources/templates/list\"}", bigd, 20), 0, "heap: 200 templates");
    var ctld = dispatcher_new(tool_registry_new());
    var ctl = "\x01\x02\x03\x04\x05\x06\x07\x08\x01\x02\x03\x04\x05\x06\x07\x08\x01\x02\x03\x04\x05\x06\x07\x08\x01\x02\x03\x04\x05\x06\x07\x08";
    var cti = 0;
    while (cti < 200) {
        dispatcher_register_resource(ctld, resource_def_new(_cat3("res://", _ra_int(cti), ctl), ctl, ctl, ctl), &_rt_h);
        cti = cti + 1;
    }
    assert_eq(_ra_heap_per_msg("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"resources/list\"}", ctld, 20), 0, "heap: a list that escapes to six times its size");
    var argd = dispatcher_new(tool_registry_new());
    var pctl = vec_new();
    var pi = 0;
    while (pi < 200) {
        vec_push(pctl, prompt_arg_new(_cat3("a", _ra_int(pi), ""), ctl, 0));
        pi = pi + 1;
    }
    dispatcher_register_prompt(argd, prompt_def_new("one_prompt", 0, pctl), &_rt_prompt);
    assert_eq(_ra_heap_per_msg("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"prompts/list\"}", argd, 20), 0, "heap: a prompt whose size is all in its arguments");
    var miss = _ra_long_uri("t://no/", 60000);
    assert_eq(_ra_heap_per_msg(miss, rtd, 20), 0, "heap: a 60 KB URI no template matches");

    # ---------------- _jx_members and x-mcp-header at registration ----------------
    var jm = _jx_members(" { \"a\" : 1 , \"b\\u0063\" : {\"x\":[1,{\"y\":2}]} , \"\":null } ");
    assert_eq(vec_len(jm), 6, "members: a key and a value each");
    assert(streq(vec_get(jm, 0), "a") == 1 && streq(vec_get(jm, 1), "1") == 1, "members: in order, the value raw");
    assert(streq(vec_get(jm, 2), "bc") == 1, "members: a key as it decodes");
    assert(streq(vec_get(jm, 3), "{\"x\":[1,{\"y\":2}]}") == 1, "members: a nested value whole");
    assert(strlen(vec_get(jm, 4)) == 0 && streq(vec_get(jm, 5), "null") == 1, "members: an empty key");
    assert_eq(vec_len(_jx_members("{}")), 0, "members: none");
    assert_eq(vec_len(_jx_members("[1,2]")), 0, "members: an array has none");
    assert_eq(vec_len(_jx_members(0)), 0, "members: nothing");
    # A key is the same key in a schema as in a message.
    var escp = vec_new();
    vec_push(escp, schema_prop_new("o", "{\"type\":\"object\",\"properties\":{\"c\\u006et\":{\"type\":\"integer\"}}}"));
    var esccomp = compiled_compile(schema_new("object", escp, vec_new()));
    assert(vec_len(compiled_validate(esccomp, "{\"o\":{\"cnt\":\"x\"}}")) > 0, "compile: a nested property named with an escape is enforced");

    assert_eq(_hdr_why("{\"type\":\"string\",\"x-mcp-header\":\"Region\"}"), 0, "x-mcp-header: on a string");
    assert_eq(_hdr_why("{\"type\":\"integer\",\"x-mcp-header\":\"Region\"}"), 0, "x-mcp-header: on an integer");
    assert_eq(_hdr_why("{\"type\":\"boolean\",\"x-mcp-header\":\"Region\"}"), 0, "x-mcp-header: on a boolean");
    assert_eq(_hdr_why("{\"type\":\"string\",\"x-mcp-header\":\"!#$%&'*+-.^_`|~09azAZ\"}"), 0, "x-mcp-header: every tchar");
    assert_eq(_hdr_why("{\"type\":\"object\",\"properties\":{\"b\":{\"type\":\"object\",\"properties\":{\"c\":{\"type\":\"string\",\"x-mcp-header\":\"Deep\"}}}}}"), 0, "x-mcp-header: nested through properties");
    assert(_hdr_why("{\"type\":\"string\",\"x-mcp-header\":\"\"}") != 0, "x-mcp-header refused: empty");
    assert(_hdr_why("{\"type\":\"string\",\"x-mcp-header\":5}") != 0, "x-mcp-header refused: not a string");
    assert(_hdr_why("{\"type\":\"string\",\"x-mcp-header\":\"A B\"}") != 0, "x-mcp-header refused: a space");
    assert(_hdr_why("{\"type\":\"string\",\"x-mcp-header\":\"A:B\"}") != 0, "x-mcp-header refused: a delimiter");
    assert(_hdr_why("{\"type\":\"string\",\"x-mcp-header\":\"A\\r\\nB: c\"}") != 0, "x-mcp-header refused: CR and LF");
    assert(_hdr_why("{\"type\":\"string\",\"x-mcp-header\":\"\\u00e9\"}") != 0, "x-mcp-header refused: non-ASCII");
    assert(_hdr_why("{\"type\":\"number\",\"x-mcp-header\":\"N\"}") != 0, "x-mcp-header refused: type number");
    assert(_hdr_why("{\"type\":\"object\",\"x-mcp-header\":\"N\"}") != 0, "x-mcp-header refused: an object");
    assert(_hdr_why("{\"type\":\"array\",\"x-mcp-header\":\"N\"}") != 0, "x-mcp-header refused: an array");
    assert(_hdr_why("{\"x-mcp-header\":\"N\"}") != 0, "x-mcp-header refused: no type");
    assert(_hdr_why("{\"type\":[\"string\",\"null\"],\"x-mcp-header\":\"N\"}") != 0, "x-mcp-header refused: a type array");
    var hp_u = _hdr_why("{\"type\":\"object\",\"properties\":{\"b\":{\"type\":\"string\",\"x-mcp-header\":\"Dup\"},\"c\":{\"type\":\"string\",\"x-mcp-header\":\"dUP\"}}}");
    assert(hp_u != 0, "x-mcp-header refused: the same name in another case");
    assert(_hdr_why("{\"type\":\"array\",\"items\":{\"type\":\"string\",\"x-mcp-header\":\"N\"}}") != 0, "x-mcp-header refused: under items");
    assert(_hdr_why("{\"type\":\"array\",\"prefixItems\":[{\"type\":\"string\",\"x-mcp-header\":\"N\"}]}") != 0, "x-mcp-header refused: under prefixItems");
    assert(_hdr_why("{\"type\":\"object\",\"additionalProperties\":{\"type\":\"string\",\"x-mcp-header\":\"N\"}}") != 0, "x-mcp-header refused: under additionalProperties");
    assert(_hdr_why("{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"string\",\"x-mcp-header\":\"N\"}]}") != 0, "x-mcp-header refused: under anyOf");
    assert(_hdr_why("{\"oneOf\":[{\"type\":\"string\",\"x-mcp-header\":\"N\"}]}") != 0, "x-mcp-header refused: under oneOf");
    assert(_hdr_why("{\"allOf\":[{\"type\":\"string\",\"x-mcp-header\":\"N\"}]}") != 0, "x-mcp-header refused: under allOf");
    assert(_hdr_why("{\"not\":{\"type\":\"string\",\"x-mcp-header\":\"N\"}}") != 0, "x-mcp-header refused: under not");
    assert(_hdr_why("{\"if\":{\"type\":\"string\",\"x-mcp-header\":\"N\"}}") != 0, "x-mcp-header refused: under if");
    assert(_hdr_why("{\"then\":{\"type\":\"string\",\"x-mcp-header\":\"N\"}}") != 0, "x-mcp-header refused: under then");
    assert(_hdr_why("{\"else\":{\"type\":\"string\",\"x-mcp-header\":\"N\"}}") != 0, "x-mcp-header refused: under else");
    assert(_hdr_why("{\"$defs\":{\"s\":{\"type\":\"string\",\"x-mcp-header\":\"N\"}}}") != 0, "x-mcp-header refused: under $defs");
    assert(_hdr_why("{\"definitions\":{\"s\":{\"type\":\"string\",\"x-mcp-header\":\"N\"}}}") != 0, "x-mcp-header refused: under definitions");
    assert(_hdr_why("{\"patternProperties\":{\"^a\":{\"type\":\"string\",\"x-mcp-header\":\"N\"}}}") != 0, "x-mcp-header refused: under patternProperties");
    assert(_hdr_why("{\"dependentSchemas\":{\"a\":{\"type\":\"string\",\"x-mcp-header\":\"N\"}}}") != 0, "x-mcp-header refused: under dependentSchemas");
    assert(_hdr_why("{\"type\":\"object\",\"properties\":{\"b\":{\"anyOf\":[{\"properties\":{\"c\":{\"type\":\"string\",\"x-mcp-header\":\"N\"}}}]}}}") != 0, "x-mcp-header refused: properties below a composition");
    assert_eq(_hdr_why("{\"type\":\"object\",\"properties\":{\"x-mcp-header\":{\"type\":\"array\"}}}"), 0, "x-mcp-header: a property with that name is no annotation");
    assert_eq(_hdr_why("{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"x-mcp-header\":{\"type\":\"array\"}}}}"), 0, "x-mcp-header: ...nor under items");
    assert_eq(_hdr_why("{\"type\":\"string\",\"default\":{\"x-mcp-header\":\"N\"},\"examples\":[{\"x-mcp-header\":\"N\"}]}"), 0, "x-mcp-header: data holding the word is no annotation");
    assert(_hdr_why("{\"type\":\"string\",\"x-mcp\\u002dheader\":\"A B\"}") != 0, "x-mcp-header refused: the key spelled with an escape is the same key");
    var hreg = tool_registry_new();
    var hbadp = vec_new();
    vec_push(hbadp, schema_prop_new("n", "{\"type\":\"number\",\"x-mcp-header\":\"N\"}"));
    assert(registry_register(hreg, tool_def_new("h_bad", "x", schema_new("object", hbadp, vec_new()))) != 0, "x-mcp-header: register refuses what the check refuses");
    assert_eq(registry_contains(hreg, "h_bad"), 0, "x-mcp-header: ...and registers nothing");
    var hgp = vec_new();
    vec_push(hgp, schema_prop_new("o", "{\"type\":\"object\",\"properties\":{\"r\":{\"type\":\"string\",\"x-mcp-header\":\"Reg\"}}}"));
    vec_push(hgp, schema_prop_new("s", "{\"type\":\"integer\",\"x-mcp-header\":\"Num\"}"));
    var hgt = tool_def_new("h_good", "x", schema_new("object", hgp, vec_new()));
    assert_eq(tool_def_param_headers(hgt), 0, "x-mcp-header: nothing read before registration");
    assert_eq(registry_register(hreg, hgt), 0, "x-mcp-header: registered");
    var hgd = tool_def_param_headers(hgt);
    assert_eq(vec_len(hgd), 2, "x-mcp-header: both read");
    assert(streq(param_header_field(vec_get(hgd, 0)), "Mcp-Param-Reg") == 1, "x-mcp-header: the header name");
    assert_eq(vec_len(param_header_path(vec_get(hgd, 0))), 2, "x-mcp-header: the path, for a nested property");
    assert(streq(vec_get(param_header_path(vec_get(hgd, 0)), 1), "r") == 1, "x-mcp-header: ...ending at the leaf");
    assert(streq(param_header_field(vec_get(hgd, 1)), "Mcp-Param-Num") == 1, "x-mcp-header: the second");
    registry_register(hreg, tool_def_new("h_none", "x", schema_new("object", 0, vec_new())));
    assert_eq(tool_def_param_headers(registry_get(hreg, "h_none")), 0, "x-mcp-header: a tool with none has no list");

    # ---------------- registry: registration checks and compile (3.4.8) ----------------
    var rreg = tool_registry_new();
    var good = tool_def_new("svc.tools-list_v2", "ok", schema_new("object", 0, vec_new()));
    assert_eq(registry_check_tool_def(good), 0, "check: a SEP-986 name using . - _ passes");
    assert_eq(registry_register(rreg, good), 0, "register: accepted");
    assert(tool_def_compiled(good) != 0, "register: the input schema is compiled at registration");
    var preset = tool_def_new("svc_preset", "ok", schema_new("object", 0, vec_new()));
    var pcomp = compiled_new();
    tool_def_with_compiled(preset, pcomp);
    registry_register(rreg, preset);
    assert_eq(tool_def_compiled(preset), pcomp, "register: a compiled schema the caller attached is kept");
    _lc_begin();
    var rsp = registry_register(rreg, tool_def_new("has space", "x", schema_new("object", 0, vec_new())));
    assert(rsp != 0 && registry_contains(rreg, "has space") == 0, "refused: a name with a space, and nothing registered");
    assert_eq(_lc_level, SK_ERROR, "refused: ...logged at ERROR");
    assert(_lc_has(_lc_buf, "tool registration refused") == 1 && _lc_has(_lc_buf, "reason=") == 1, "refused: ...with the reason");
    var n128 = alloc(130);
    memset(n128, 97, 128);
    store8(n128 + 128, 0);
    assert_eq(registry_register(rreg, tool_def_new(n128, "x", schema_new("object", 0, vec_new()))), 0, "accepted: a 128-character name");
    var n129 = alloc(131);
    memset(n129, 98, 129);
    store8(n129 + 129, 0);
    assert(registry_register(rreg, tool_def_new(n129, "x", schema_new("object", 0, vec_new()))) != 0, "refused: a 129-character name");
    assert(registry_register(rreg, tool_def_new("", "x", schema_new("object", 0, vec_new()))) != 0, "refused: an empty name");
    assert(registry_register(rreg, 0) != 0, "refused: no definition at all");
    assert(registry_register(rreg, tool_def_new("svc_noschema", "x", 0)) != 0, "refused: no inputSchema");
    assert(registry_register(rreg, tool_def_new("svc_str", "x", schema_new("string", 0, vec_new()))) != 0, "refused: an inputSchema of type string");
    assert(registry_register(rreg, tool_def_new("svc_tron", "x", schema_new(str_from("object"), vec_new(), vec_new()))) != 0,
      "refused: a Str where the schema type belongs (t-ron's shape)");
    assert(registry_register(rreg, tool_def_new(str_from("phylax_scan"), "x", schema_new("object", 0, vec_new()))) != 0,
      "refused: a Str where the name belongs (phylax's shape)");
    var pbad = vec_new();
    vec_push(pbad, schema_prop_new("p", "string"));
    assert(registry_register(rreg, tool_def_new("svc_pbad", "x", schema_new("object", pbad, vec_new()))) != 0, "refused: a property schema that is not JSON");
    var pstr = vec_new();
    vec_push(pstr, schema_prop_new("p", "\"string\""));
    assert(registry_register(rreg, tool_def_new("svc_pstr", "x", schema_new("object", pstr, vec_new()))) != 0, "refused: a property schema that is JSON but not a schema");
    var ptrue = vec_new();
    vec_push(ptrue, schema_prop_new("p", "true"));
    assert_eq(registry_register(rreg, tool_def_new("svc_ptrue", "x", schema_new("object", ptrue, vec_new()))), 0, "accepted: a boolean subschema (2020-12)");
    var rq_empty = vec_new();
    vec_push(rq_empty, "");
    assert(registry_register(rreg, tool_def_new("svc_rq", "x", schema_new("object", 0, rq_empty))) != 0, "refused: an empty required entry");
    var drr = dispatcher_new(tool_registry_new());
    var drr_err = dispatcher_register_tool(drr, tool_def_new("svc_badschema", "x", schema_new("string", 0, vec_new())), &h_echo);
    assert(drr_err != 0 && map_has(dispatcher_handlers(drr), "svc_badschema") == 0,
      "dispatcher_register_tool: a refused definition returns the error and gets no handler");
    _lc_end();

    # ---------------- registry: required fields around a nested object ----------------
    # The fallback reads the top-level keys of bayan's flat `json_parse`. Before bayan 1.5.10 a
    # nested object threw the key/value pairing off for the rest of the object, so `path` AFTER
    # `cfg` was reported missing and valid params were refused as INVALID_PARAMS. 1.5.10 (folded
    # from cyrius 6.6.13) returns a nested object as one value. Fails on 3.3.15.
    var after_nested = registry_validate_params(reg2, "scan", "{\"cfg\":{\"x\":1},\"path\":\"/tmp\"}");
    assert_eq(after_nested, 0, "a required field after a nested object is present");
    # A key INSIDE the nested object still does not satisfy a top-level requirement.
    var only_nested = registry_validate_params(reg2, "scan", "{\"cfg\":{\"path\":\"/tmp\"}}");
    assert(only_nested != 0, "a required field nested in another object is missing");

    # ---------------- registry: validate_params unknown tool ----------------
    var unk_err = registry_validate_params(reg2, "nope", "{}");
    assert(unk_err != 0, "validate err on unknown");
    assert_eq(bote_err_tag(unk_err), BOTE_ERR_TOOL_NOT_FOUND, "unknown -> TOOL_NOT_FOUND");

    # ---------------- registry: validate rejects non-object params ----------------
    var nob1 = registry_validate_params(reg2, "scan", "null");
    assert(nob1 != 0, "null rejected");
    assert_eq(bote_err_tag(nob1), BOTE_ERR_INVALID_PARAMS, "null -> INVALID_PARAMS");
    var nob2 = registry_validate_params(reg2, "scan", "[1,2]");
    assert(nob2 != 0, "array rejected");
    var nob3 = registry_validate_params(reg2, "scan", "42");
    assert(nob3 != 0, "number rejected");
    var nob4 = registry_validate_params(reg2, "scan", "true");
    assert(nob4 != 0, "bool rejected");
    var nob5 = registry_validate_params(reg2, "scan", "\"string\"");
    assert(nob5 != 0, "string rejected");

    # ---------------- registry: validate passes with no required ----------------
    var reg3 = tool_registry_new();
    registry_register(reg3, tool_def_new("open", "no required", schema_new("object", 0, vec_new())));
    assert_eq(registry_validate_params(reg3, "open", "{}"), 0, "empty ok no required");

    # ---------------- registry: deregister ----------------
    var removed = registry_deregister(reg2, "scan");
    assert(removed != 0, "deregister returns def");
    assert_eq(registry_contains(reg2, "scan"), 0, "after dereg not contains");
    assert_eq(registry_len(reg2), 0, "after dereg len 0");
    assert_eq(registry_deregister(reg2, "scan"), 0, "dereg twice returns 0");

    # ---------------- registry: versioned ----------------
    var regv = tool_registry_new();
    var ts = schema_new("object", 0, vec_new());
    registry_register(regv, tool_def_with_version(tool_def_new("calc", "v1", ts), "1.0"));
    registry_register(regv, tool_def_with_version(tool_def_new("calc", "v2", ts), "2.0"));
    var v1 = registry_get_versioned(regv, "calc", "1.0");
    var v2 = registry_get_versioned(regv, "calc", "2.0");
    assert(v1 != 0, "got v1");
    assert(v2 != 0, "got v2");
    assert(streq(tool_def_description(v1), "v1") == 1, "v1 description");
    assert(streq(tool_def_description(v2), "v2") == 1, "v2 description");
    assert_eq(registry_get_versioned(regv, "calc", "9.9"), 0, "missing version");
    assert_eq(vec_len(registry_list_versions(regv, "calc")), 2, "two versions tracked");

    # ---------------- registry: deprecate ----------------
    registry_deprecate(regv, "calc", "use calc2");
    var dep_t = registry_get(regv, "calc");
    assert(streq(tool_def_deprecated(dep_t), "use calc2") == 1, "deprecated set");

    # ---------------- annotations: presets ----------------
    var ro = ann_read_only();
    assert_eq(ann_read_only_hint(ro), HINT_TRUE, "ro hint true");
    assert_eq(ann_destructive_hint(ro), HINT_FALSE, "ro destructive false");
    assert_eq(ann_idempotent_hint(ro), HINT_TRUE, "ro idempotent true");
    assert_eq(ann_open_world_hint(ro), HINT_FALSE, "ro open_world false");

    var de = ann_destructive();
    assert_eq(ann_read_only_hint(de), HINT_FALSE, "de read_only false");
    assert_eq(ann_destructive_hint(de), HINT_TRUE, "de destructive true");

    var blank = ann_new();
    assert_eq(ann_read_only_hint(blank), HINT_UNSET, "blank unset");

    # ---------------- jsonx: flat get_str ----------------
    var jx1 = jsonx_get_str("{\"name\":\"echo\"}", "name");
    assert(jx1 != 0, "jx flat name found");
    assert(streq(jx1, "echo") == 1, "jx flat name value");
    assert_eq(jsonx_get_str("{\"name\":\"echo\"}", "missing"), 0, "jx missing key");

    # ---------------- jsonx: nested raw extraction ----------------
    var nested = "{\"name\":\"calc\",\"arguments\":{\"a\":1,\"b\":2}}";
    var jx_name = jsonx_get_str(nested, "name");
    assert(streq(jx_name, "calc") == 1, "jx nested skip-past name");
    var jx_args = jsonx_get_raw(nested, "arguments");
    assert(jx_args != 0, "jx nested args found");
    assert(streq(jx_args, "{\"a\":1,\"b\":2}") == 1, "jx nested args raw bytes");

    # ---------------- jsonx: deeply nested ----------------
    var deep = "{\"a\":{\"b\":{\"c\":[1,2,3]}},\"after\":7}";
    var jx_a = jsonx_get_raw(deep, "a");
    assert(streq(jx_a, "{\"b\":{\"c\":[1,2,3]}}") == 1, "jx deep nested");
    var jx_after = jsonx_get_raw(deep, "after");
    assert(streq(jx_after, "7") == 1, "jx after deep");

    # ---------------- jsonx: array values ----------------
    var arr = "{\"xs\":[1,{\"k\":\"v\"},3],\"y\":2}";
    var jx_xs = jsonx_get_raw(arr, "xs");
    assert(jx_xs != 0, "jx xs found");
    assert(streq(jx_xs, "[1,{\"k\":\"v\"},3]") == 1, "jx array with nested obj");

    # ---------------- jsonx: bote_json_escape (3.4.6) ----------------
    # Every byte below 0x20 has an escape (RFC 8259 §7). Through 3.4.5 all
    # but LF, CR and TAB went out raw, so the reply was not JSON.
    assert(streq(_esc("a\"b\\c"), "a\\\"b\\\\c") == 1, "escape: quote and backslash");
    assert(streq(_esc("l\nr\rt\t"), "l\\nr\\rt\\t") == 1, "escape: LF CR TAB keep their short forms");
    var eb = alloc(8);
    store8(eb, 8); store8(eb + 1, 12); store8(eb + 2, 0);
    assert(streq(_esc(eb), "\\b\\f") == 1, "escape: BS and FF use \\b \\f");
    store8(eb, 1); store8(eb + 1, 0);
    assert(streq(_esc(eb), "\\u0001") == 1, "escape: 0x01 -> \\u0001");
    store8(eb, 27); store8(eb + 1, 0);
    assert(streq(_esc(eb), "\\u001b") == 1, "escape: ESC -> \\u001b (lower-case hex)");
    store8(eb, 31); store8(eb + 1, 0);
    assert(streq(_esc(eb), "\\u001f") == 1, "escape: 0x1f -> \\u001f");
    store8(eb, 97); store8(eb + 1, 98); store8(eb + 2, 1); store8(eb + 3, 99); store8(eb + 4, 100); store8(eb + 5, 0);
    assert(streq(_esc(eb), "ab\\u0001cd") == 1, "escape: plain runs on either side of an escape survive");
    store8(eb, 195); store8(eb + 1, 169); store8(eb + 2, 127); store8(eb + 3, 0);
    assert(memeq(_esc(eb), eb, 4) == 1, "escape: UTF-8 bytes and DEL pass through");
    assert(streq(_esc(""), "") == 1, "escape: empty string appends nothing");
    var esb0 = str_builder_new();
    bote_json_escape(esb0, 0);
    assert_eq(str_len(str_builder_build(esb0)), 0, "escape: a null cstr appends nothing");
    # Every ASCII byte in one string: quoted, the result is valid JSON, and bayan
    # decodes it back to the same 127 bytes.
    var all = alloc(257);
    var ai = 0;
    while (ai < 127) { store8(all + ai, ai + 1); ai = ai + 1; }
    store8(all + 127, 0);
    var aq = str_builder_new();
    str_builder_add_cstr(aq, "\"");
    bote_json_escape(aq, all);
    str_builder_add_cstr(aq, "\"");
    var aqs = str_data(str_builder_build(aq));
    assert_eq(jsonx_valid(aqs, strlen(aqs)), 1, "escape: all 127 ASCII bytes, quoted, are one valid JSON string");
    var adec = bayan_json_v_str(bayan_json_v_parse_buf(aqs, strlen(aqs)));
    assert(adec != 0 && str_len(adec) == 127 && memeq(str_data(adec), all, 127) == 1,
      "escape: ...that decodes back to the same 127 bytes");
    # RFC 8259 §8.1 (3.4.15): UTF-8 passes, anything else becomes U+FFFD.
    assert(streq(_esc(_u8(195, 169, 0, 0)), _u8(195, 169, 0, 0)) == 1, "utf-8: a 2-byte character passes");
    assert(streq(_esc(_u8(226, 130, 172, 0)), _u8(226, 130, 172, 0)) == 1, "utf-8: a 3-byte character passes");
    assert(streq(_esc(_u8(240, 159, 152, 128)), _u8(240, 159, 152, 128)) == 1, "utf-8: a 4-byte character passes");
    assert(streq(_esc(_u8(255, 0, 0, 0)), "\\ufffd") == 1, "utf-8: a byte that starts nothing is replaced");
    assert(streq(_esc(_u8(233, 0, 0, 0)), "\\ufffd") == 1, "utf-8: a Latin-1 byte is replaced");
    assert(streq(_esc(_u8(192, 128, 0, 0)), "\\ufffd\\ufffd") == 1, "utf-8: an overlong form is replaced");
    assert(streq(_esc(_u8(224, 128, 128, 0)), "\\ufffd\\ufffd\\ufffd") == 1, "utf-8: ...in 3 bytes");
    assert(streq(_esc(_u8(240, 128, 128, 128)), "\\ufffd\\ufffd\\ufffd\\ufffd") == 1, "utf-8: ...and in 4");
    assert(streq(_esc(_u8(237, 160, 128, 0)), "\\ufffd\\ufffd\\ufffd") == 1, "utf-8: a surrogate is replaced");
    assert(streq(_esc(_u8(244, 144, 128, 128)), "\\ufffd\\ufffd\\ufffd\\ufffd") == 1, "utf-8: past U+10FFFF is replaced");
    assert(streq(_esc(_u8(226, 130, 0, 0)), "\\ufffd\\ufffd") == 1, "utf-8: a sequence cut by the end of the string stops there");
    var esb = str_builder_new();
    _json_emit_escaped(esb, eb);
    assert(memeq(str_data(str_builder_build(esb)), eb, 3) == 1, "escape: the old private name is an alias");

    # ---------------- jsonx: truncated string regression (jsonx_get_str must clamp) ----------------
    # Input has opening quote but no closing — _jx_skip_string returns end == len,
    # so end - pos - 2 was negative → memcpy(out, src, -1) → segfault.
    # Now clamped to 0 (returns empty string).
    var trunc1 = jsonx_get_str("{\"k\":\"", "k");
    assert(trunc1 != 0, "trunc string returns non-null");
    assert_eq(strlen(trunc1), 0, "trunc string is empty");
    var trunc2 = jsonx_get_str("{\"k\":\"v", "k");
    assert(trunc2 != 0, "trunc-with-data returns non-null");
    # NB: behavior is to drop the unfinished 'v' since there's no closing quote.

    # ---------------- jsonx: predicates ----------------
    assert_eq(jsonx_has("{\"k\":1}", "k"), 1, "jsonx_has yes");
    assert_eq(jsonx_has("{\"k\":1}", "x"), 0, "jsonx_has no");
    assert_eq(jsonx_is_object("{\"k\":1}"), 1, "is_object yes");
    assert_eq(jsonx_is_object("[1,2]"), 0, "array not object");
    assert_eq(jsonx_is_object("  {} "), 1, "is_object skips ws");
    assert_eq(jsonx_is_object("null"), 0, "null not object");

    # ---------------- validate_tool_name ----------------
    assert_eq(validate_tool_name("good_name"), 0, "valid name");
    assert_eq(validate_tool_name("a_b_c_1_2"), 0, "valid name with digits");
    assert(validate_tool_name(0) != 0, "null name fails");
    assert(validate_tool_name("") != 0, "empty fails");
    assert(validate_tool_name("noundercore") != 0, "no underscore fails");
    assert(validate_tool_name("bad-name") != 0, "hyphen fails");
    assert(validate_tool_name("bad name") != 0, "space fails");
    assert(validate_tool_name("bad/name") != 0, "slash fails");

    # ---------------- dispatch: initialize ----------------
    var dreg = tool_registry_new();
    var d = dispatcher_new(dreg);

    var init_req = req_with_params(req_new("1", "initialize"), "{\"protocolVersion\":\"2024-11-05\"}");
    var init_resp = dispatcher_dispatch(d, init_req, 0);
    assert(init_resp != 0, "init not notification");
    assert(streq(resp_id(init_resp), "1") == 1, "init id");
    var init_result = resp_result(init_resp);
    assert(init_result != 0, "init result present");
    # Body should mention the negotiated version + serverInfo
    assert_eq(jsonx_has(init_result, "protocolVersion"), 1, "init body has protocolVersion");
    assert_eq(jsonx_has(init_result, "serverInfo"), 1, "init body has serverInfo");
    var negotiated = jsonx_get_str(init_result, "protocolVersion");
    assert(streq(negotiated, "2024-11-05") == 1, "init negotiates supported version");

    # [3.3.0] serverInfo is configurable — a dispatcher embedded in another
    # product must not introduce itself as "bote". Default first, so the
    # pre-3.3.0 wire is pinned as unchanged.
    var si_default = jsonx_get_raw(init_result, "serverInfo");
    assert_eq(jsonx_has(si_default, "name"), 1, "serverInfo carries a name");
    assert(streq(jsonx_get_str(si_default, "name"), "bote") == 1,
    "an unconfigured dispatcher still says \"bote\" — 3.3.0 is additive, the default wire is unchanged");
    assert(streq(jsonx_get_str(si_default, "version"), _bote_server_version()) == 1,
    "and still reports bote's own version");

    # Now override both.
    var si_d2 = dispatcher_new(dreg);
    dispatcher_set_server_info(si_d2, "agnosai", "2.0.0");
    var si_i2 = resp_result(dispatcher_dispatch(si_d2,
    req_with_params(req_new("2", "initialize"), "{\"protocolVersion\":\"2024-11-05\"}"), 0));
    var si2 = jsonx_get_raw(si_i2, "serverInfo");
    assert(streq(jsonx_get_str(si2, "name"), "agnosai") == 1,
    "a configured dispatcher advertises the HOST's name, which is what makes dispatcher_dispatch \
    usable by a consumer whose own wire says something other than bote");
    assert(streq(jsonx_get_str(si2, "version"), "2.0.0") == 1, "and the host's version");

    # Either field alone falls back independently.
    var si_d3 = dispatcher_new(dreg);
    dispatcher_set_server_info(si_d3, "agnosai", 0);
    var si_i3 = resp_result(dispatcher_dispatch(si_d3,
    req_with_params(req_new("3", "initialize"), "{\"protocolVersion\":\"2024-11-05\"}"), 0));
    var si3 = jsonx_get_raw(si_i3, "serverInfo");
    assert(streq(jsonx_get_str(si3, "name"), "agnosai") == 1, "name overridden alone");
    assert(streq(jsonx_get_str(si3, "version"), _bote_server_version()) == 1,
    "with version falling back to bote's — 0 means \"keep bote's value for this field\"");

    assert_eq(dispatcher_server_name(si_d2) != 0, 1, "server_name accessor reads back");
    assert_eq(dispatcher_server_version(si_d3), 0, "an unset field reads back as 0");

    # capabilities: derived from the surface bote actually implements. `tools`
    # always; `listChanged` deliberately NOT advertised (no server→client push
    # path yet) — pin the decision so flipping it is a conscious change.
    var init_caps = jsonx_get_raw(init_result, "capabilities");
    assert(init_caps != 0, "init body has capabilities");
    assert(streq(init_caps, "{\"tools\":{}}") == 1, "capabilities: tools only, no listChanged");

    # Init with unsupported version → fall back to latest
    var bad_init = req_with_params(req_new("1", "initialize"), "{\"protocolVersion\":\"1999-01-01\"}");
    var bi_resp = dispatcher_dispatch(d, bad_init, 0);
    var bi_neg = jsonx_get_str(resp_result(bi_resp), "protocolVersion");
    assert(streq(bi_neg, "2025-11-25") == 1, "init falls back to latest");

    # 2025-06-18 negotiates as itself, not as the default. Through 3.3.12
    # this row would have passed for the WRONG reason — an unsupported
    # version falls back to latest, which is also what a supported one
    # returns when the client asks for latest. Asking for 2025-06-18 and
    # getting 2025-06-18 back is the only shape that distinguishes them.
    var v0618 = req_with_params(req_new("1", "initialize"), "{\"protocolVersion\":\"2025-06-18\"}");
    var n0618 = jsonx_get_str(resp_result(dispatcher_dispatch(d, v0618, 0)), "protocolVersion");
    assert(streq(n0618, "2025-06-18") == 1,
    "initialize negotiates 2025-06-18 as itself (3.3.13) — not silently upgraded to latest");

    # ---------------- dispatch: ping (3.3.13) ----------------
    # The spec requires an empty result, promptly. Through 3.3.12 bote
    # answered -32601, which an SDK client reads as an unhealthy server.
    # ⚠ The body reads are guarded rather than chained into streq. On a
    # -32601 response `resp_result` is 0, and `streq(0, "{}")` SIGSEGVs —
    # which would take the ~500 assertions BELOW this point down with it
    # and report a crash instead of a diagnosis. Measured: that is exactly
    # what the mutant with the ping route deleted did before this guard.
    var ping_resp = dispatcher_dispatch(d, req_new("9", "ping"), 0);
    assert(ping_resp != 0, "ping is answered");
    assert(streq(resp_id(ping_resp), "9") == 1, "ping echoes the request id");
    assert_eq(resp_error_obj(ping_resp), 0, "ping is not an error response");
    var ping_body = resp_result(ping_resp);
    assert(ping_body != 0, "ping carries a result body");
    if (ping_body != 0) {
        assert(streq(ping_body, "{}") == 1, "ping result is an empty object");
    }

    # A ping must not depend on any capability being wired: `d` here has a
    # registry but no prompts / resources / completion registry, which is
    # the state a client probes at startup. A bare dispatcher answers too.
    var ping_bare = dispatcher_new(tool_registry_new());
    var pb_body = resp_result(dispatcher_dispatch(ping_bare, req_new("10", "ping"), 0));
    assert(pb_body != 0, "a bare dispatcher answers ping with a body");
    if (pb_body != 0) {
        assert(streq(pb_body, "{}") == 1,
        "ping answers on a dispatcher with no registries wired");
    }

    # A ping NOTIFICATION (no id) draws no response, like every other
    # notification — the empty-result rule is for the request form.
    assert_eq(dispatcher_dispatch(d, req_notification("ping"), 0), 0,
    "a ping notification draws no response");

    # ---------------- dispatch: tools/list empty ----------------
    var ll_resp = dispatcher_dispatch(d, req_new("2", "tools/list"), 0);
    var ll_body = resp_result(ll_resp);
    assert(streq(ll_body, "{\"tools\":[]}") == 1, "tools/list empty");

    # ---------------- dispatch: tools/list with one tool ----------------
    var sa = schema_new("object", 0, vec_new());
    registry_register(dreg, tool_def_new("svc_echo", "echo it", sa));
    var ll2 = dispatcher_dispatch(d, req_new("2", "tools/list"), 0);
    var ll2_body = resp_result(ll2);
    assert_eq(jsonx_has(ll2_body, "tools"), 1, "list has tools");
    # The tools array is "[{...}]" — get_raw returns the array verbatim
    var tools_raw = jsonx_get_raw(ll2_body, "tools");
    assert(tools_raw != 0, "tools array present");

    # ---------------- dispatch: tools/list serializes annotations ----------------
    # Fresh registry so the whole body is deterministic. read-only preset →
    # all four hints emitted (true/false per the tri-state contract).
    var ann_reg = tool_registry_new();
    var ann_d = dispatcher_new(ann_reg);
    var ann_schema = schema_new("object", 0, vec_new());
    registry_register(ann_reg,
    tool_def_with_annotations(tool_def_new("svc_ro", "read only", ann_schema), ann_read_only()));
    var ann_body = resp_result(dispatcher_dispatch(ann_d, req_new("2", "tools/list"), 0));
    assert(streq(ann_body,
    "{\"tools\":[{\"name\":\"svc_ro\",\"description\":\"read only\",\"inputSchema\":{\"type\":\"object\"},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}]}") == 1,
    "tools/list emits full annotations object");

    # Only one hint set → only that key is emitted (no leading comma bug).
    var ann_reg2 = tool_registry_new();
    var ann_d2 = dispatcher_new(ann_reg2);
    var de_ann = ann_set_destructive(ann_new(), HINT_TRUE);
    registry_register(ann_reg2,
    tool_def_with_annotations(tool_def_new("svc_rm", "remove", ann_schema), de_ann));
    var ann_body2 = resp_result(dispatcher_dispatch(ann_d2, req_new("2", "tools/list"), 0));
    assert(streq(ann_body2,
    "{\"tools\":[{\"name\":\"svc_rm\",\"description\":\"remove\",\"inputSchema\":{\"type\":\"object\"},\"annotations\":{\"destructiveHint\":true}}]}") == 1,
    "tools/list emits single-hint annotations");

    # No annotations ptr → no "annotations" key at all (additive: unchanged shape).
    var plain_reg = tool_registry_new();
    var plain_d = dispatcher_new(plain_reg);
    registry_register(plain_reg, tool_def_new("svc_plain", "plain", ann_schema));
    var plain_body = resp_result(dispatcher_dispatch(plain_d, req_new("2", "tools/list"), 0));
    assert(streq(plain_body,
    "{\"tools\":[{\"name\":\"svc_plain\",\"description\":\"plain\",\"inputSchema\":{\"type\":\"object\"}}]}") == 1,
    "tools/list omits annotations when unset");

    # All-unset annotations ptr → treated as absent (no empty object emitted).
    var blank_reg = tool_registry_new();
    var blank_d = dispatcher_new(blank_reg);
    registry_register(blank_reg,
    tool_def_with_annotations(tool_def_new("svc_blank", "blank", ann_schema), ann_new()));
    var blank_body = resp_result(dispatcher_dispatch(blank_d, req_new("2", "tools/list"), 0));
    assert(streq(blank_body,
    "{\"tools\":[{\"name\":\"svc_blank\",\"description\":\"blank\",\"inputSchema\":{\"type\":\"object\"}}]}") == 1,
    "tools/list omits empty annotations object");

    # ---------------- registry/dispatch: tool profiles + tools/list filter ----------------
    var pf_reg = tool_registry_new();
    var pf_d = dispatcher_new(pf_reg);
    var pf_schema = schema_new("object", 0, vec_new());
    # svc_scan ∈ {security, full}; svc_web ∈ {web, full}; svc_bare untagged.
    var sec_profs = vec_new();
    vec_push(sec_profs, "security");
    vec_push(sec_profs, "full");
    registry_register(pf_reg,
    tool_def_with_profiles(tool_def_new("svc_scan", "scan", pf_schema), sec_profs));
    var web_profs = vec_new();
    vec_push(web_profs, "web");
    vec_push(web_profs, "full");
    registry_register(pf_reg,
    tool_def_with_profiles(tool_def_new("svc_web", "web", pf_schema), web_profs));
    registry_register(pf_reg, tool_def_new("svc_bare", "bare", pf_schema));

    # tool_def_has_profile: exact membership; untagged/null → 0.
    assert_eq(tool_def_has_profile(registry_get(pf_reg, "svc_scan"), "security"), 1, "scan in security");
    assert_eq(tool_def_has_profile(registry_get(pf_reg, "svc_scan"), "web"), 0, "scan not in web");
    assert_eq(tool_def_has_profile(registry_get(pf_reg, "svc_bare"), "security"), 0, "bare in no profile");
    assert_eq(tool_def_has_profile(registry_get(pf_reg, "svc_scan"), 0), 0, "null profile never matches");

    # profile=security → only svc_scan.
    var pf_sec = resp_result(dispatcher_dispatch(pf_d,
    req_with_params(req_new("2", "tools/list"), "{\"profile\":\"security\"}"), 0));
    assert(streq(pf_sec,
    "{\"tools\":[{\"name\":\"svc_scan\",\"description\":\"scan\",\"inputSchema\":{\"type\":\"object\"}}]}") == 1,
    "tools/list filters to profile=security");

    # profile=full → svc_scan + svc_web (insertion order), never svc_bare.
    var pf_full = resp_result(dispatcher_dispatch(pf_d,
    req_with_params(req_new("2", "tools/list"), "{\"profile\":\"full\"}"), 0));
    assert(streq(pf_full,
    "{\"tools\":[{\"name\":\"svc_scan\",\"description\":\"scan\",\"inputSchema\":{\"type\":\"object\"}},{\"name\":\"svc_web\",\"description\":\"web\",\"inputSchema\":{\"type\":\"object\"}}]}") == 1,
    "tools/list profile=full returns tagged tools in order");

    # unknown profile → empty array (no leading-comma corruption).
    var pf_none = resp_result(dispatcher_dispatch(pf_d,
    req_with_params(req_new("2", "tools/list"), "{\"profile\":\"nope\"}"), 0));
    assert(streq(pf_none, "{\"tools\":[]}") == 1, "tools/list unknown profile → empty");

    # no profile param → full list, byte-identical to pre-extension behavior.
    var pf_all = resp_result(dispatcher_dispatch(pf_d, req_new("2", "tools/list"), 0));
    assert(streq(pf_all,
    "{\"tools\":[{\"name\":\"svc_scan\",\"description\":\"scan\",\"inputSchema\":{\"type\":\"object\"}},{\"name\":\"svc_web\",\"description\":\"web\",\"inputSchema\":{\"type\":\"object\"}},{\"name\":\"svc_bare\",\"description\":\"bare\",\"inputSchema\":{\"type\":\"object\"}}]}") == 1,
    "tools/list without profile returns all tools");

    # ---------------- prompts: registry + capability + list + get ----------------
    var pr_reg = tool_registry_new();
    var pr_d = dispatcher_new(pr_reg);

    # Before any prompt: capability is tools-only (prompts not advertised),
    # and prompts/list is method-not-found.
    var pr_init0 = resp_result(dispatcher_dispatch(pr_d,
    req_with_params(req_new("1", "initialize"), "{\"protocolVersion\":\"2025-11-25\"}"), 0));
    assert(streq(jsonx_get_raw(pr_init0, "capabilities"), "{\"tools\":{}}") == 1,
    "no prompts → capabilities tools-only");
    var pr_ll0 = dispatcher_dispatch(pr_d, req_new("2", "prompts/list"), 0);
    assert(resp_error_obj(pr_ll0) != 0, "prompts/list without registry → error");

    # Register a prompt: one required + one optional argument.
    var pr_args = vec_new();
    vec_push(pr_args, prompt_arg_new("name", "who to greet", 1));
    vec_push(pr_args, prompt_arg_new("style", 0, 0));
    dispatcher_register_prompt(pr_d,
    prompt_def_new("greet", "compose a greeting", pr_args), &h_prompt);

    # Registering flips the prompts capability on.
    var pr_init1 = resp_result(dispatcher_dispatch(pr_d,
    req_with_params(req_new("1", "initialize"), "{\"protocolVersion\":\"2025-11-25\"}"), 0));
    assert(streq(jsonx_get_raw(pr_init1, "capabilities"), "{\"tools\":{},\"prompts\":{}}") == 1,
    "registered prompt → capabilities include prompts");

    # prompts/list: required emitted only for the required arg; optional omits it.
    var pr_ll = resp_result(dispatcher_dispatch(pr_d, req_new("2", "prompts/list"), 0));
    assert(streq(pr_ll,
    "{\"prompts\":[{\"name\":\"greet\",\"description\":\"compose a greeting\",\"arguments\":[{\"name\":\"name\",\"description\":\"who to greet\",\"required\":true},{\"name\":\"style\"}]}]}") == 1,
    "prompts/list serializes prompt + arguments");

    # prompts/get invokes the handler and returns its body verbatim.
    var pr_get = resp_result(dispatcher_dispatch(pr_d,
    req_with_params(req_new("3", "prompts/get"), "{\"name\":\"greet\",\"arguments\":{\"name\":\"Ada\"}}"), 0));
    assert(streq(pr_get,
    "{\"description\":\"greeting\",\"messages\":[{\"role\":\"user\",\"content\":{\"type\":\"text\",\"text\":\"hi\"}}]}") == 1,
    "prompts/get returns handler body");

    var pr_unk = dispatcher_dispatch(pr_d,
    req_with_params(req_new("3", "prompts/get"), "{\"name\":\"nope\"}"), 0);
    assert(resp_error_obj(pr_unk) != 0, "prompts/get unknown name → error");

    var pr_noname = dispatcher_dispatch(pr_d,
    req_with_params(req_new("3", "prompts/get"), "{}"), 0);
    assert(resp_error_obj(pr_noname) != 0, "prompts/get missing name → error");

    # prompt registry unit surface.
    assert_eq(prompt_registry_len(dispatcher_prompts(pr_d)), 1, "one prompt registered");
    assert_eq(prompt_registry_contains(dispatcher_prompts(pr_d), "greet"), 1, "registry contains greet");
    assert_eq(prompt_registry_contains(dispatcher_prompts(pr_d), "missing"), 0, "registry absent for missing");

    # ---------------- resources: registry + capability + list + read ----------------
    var rs_reg = tool_registry_new();
    var rs_d = dispatcher_new(rs_reg);

    # Before any resource: capability tools-only, resources/list not found.
    var rs_init0 = resp_result(dispatcher_dispatch(rs_d,
    req_with_params(req_new("1", "initialize"), "{\"protocolVersion\":\"2025-11-25\"}"), 0));
    assert(streq(jsonx_get_raw(rs_init0, "capabilities"), "{\"tools\":{}}") == 1,
    "no resources → capabilities tools-only");
    var rs_ll0 = dispatcher_dispatch(rs_d, req_new("2", "resources/list"), 0);
    assert(resp_error_obj(rs_ll0) != 0, "resources/list without registry → error");
    # 3.4.1: resources/templates/list is gated like its siblings — no registry, -32601.
    var rs_tl0 = dispatcher_dispatch(rs_d, req_new("4", "resources/templates/list"), 0);
    assert(resp_error_obj(rs_tl0) != 0, "resources/templates/list without registry → error");
    assert_eq(rpc_err_code(resp_error_obj(rs_tl0)), 0 - 32601, "resources/templates/list without registry → -32601");

    # Register a resource with description + mimeType.
    dispatcher_register_resource(rs_d,
    resource_def_new("test://doc", "doc", "a test doc", "text/plain"), &h_resource);

    # Registering flips the resources capability on.
    var rs_init1 = resp_result(dispatcher_dispatch(rs_d,
    req_with_params(req_new("1", "initialize"), "{\"protocolVersion\":\"2025-11-25\"}"), 0));
    assert(streq(jsonx_get_raw(rs_init1, "capabilities"), "{\"tools\":{},\"resources\":{}}") == 1,
    "registered resource → capabilities include resources");

    # resources/list serializes uri / name / description / mimeType.
    var rs_ll = resp_result(dispatcher_dispatch(rs_d, req_new("2", "resources/list"), 0));
    assert(streq(rs_ll,
    "{\"resources\":[{\"uri\":\"test://doc\",\"name\":\"doc\",\"description\":\"a test doc\",\"mimeType\":\"text/plain\"}]}") == 1,
    "resources/list serializes resource metadata");

    # resources/read invokes the handler and returns its body verbatim.
    var rs_read = resp_result(dispatcher_dispatch(rs_d,
    req_with_params(req_new("3", "resources/read"), "{\"uri\":\"test://doc\"}"), 0));
    assert(streq(rs_read,
    "{\"contents\":[{\"uri\":\"test://doc\",\"mimeType\":\"text/plain\",\"text\":\"body\"}]}") == 1,
    "resources/read returns handler body");

    var rs_unk = dispatcher_dispatch(rs_d,
    req_with_params(req_new("3", "resources/read"), "{\"uri\":\"nope://x\"}"), 0);
    assert(resp_error_obj(rs_unk) != 0, "resources/read unknown uri → error");

    var rs_nouri = dispatcher_dispatch(rs_d,
    req_with_params(req_new("3", "resources/read"), "{}"), 0);
    assert(resp_error_obj(rs_nouri) != 0, "resources/read missing uri → error");

    # 3.4.1: resources/templates/list answers an empty list once resources are
    # advertised (it was -32601, which clients read as a server failure).
    var rs_tl = dispatcher_dispatch(rs_d, req_new("4", "resources/templates/list"), 0);
    assert_eq(resp_error_obj(rs_tl), 0, "resources/templates/list with registry → success");
    # A null result (the method missing) compares as "" so a failure reports
    # instead of crashing streq.
    var rs_tl_r = resp_result(rs_tl);
    if (rs_tl_r == 0) { rs_tl_r = ""; }
    assert(streq(rs_tl_r, "{\"resourceTemplates\":[]}") == 1,
    "resources/templates/list → {\"resourceTemplates\":[]}");
    # 3.4.5: bote issues no cursors, so a cursor is invalid: -32602, per the
    # pagination spec (it was ignored through 3.4.4).
    var rs_tlc = dispatcher_dispatch(rs_d,
    req_with_params(req_new("5", "resources/templates/list"), "{\"cursor\":\"abc\"}"), 0);
    # Guarded: a regression to a success must report, not dereference 0.
    var rs_tlc_code = 0;
    if (resp_error_obj(rs_tlc) != 0) { rs_tlc_code = rpc_err_code(resp_error_obj(rs_tlc)); }
    assert_eq(rs_tlc_code, 0 - 32602,
    "resources/templates/list refuses a cursor it never issued (-32602)");
    var rs_tlw = codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"resources/templates/list\"}", rs_d, 0);
    assert(streq(rs_tlw, "{\"jsonrpc\":\"2.0\",\"id\":6,\"result\":{\"resourceTemplates\":[]}}") == 1,
    "resources/templates/list on the wire");

    assert_eq(resource_registry_len(dispatcher_resources(rs_d)), 1, "one resource registered");
    assert_eq(resource_registry_contains(dispatcher_resources(rs_d), "test://doc"), 1, "registry contains doc");
    assert_eq(resource_registry_contains(dispatcher_resources(rs_d), "missing://x"), 0, "registry absent for missing");

    # prompts + resources together → both advertised, tools/prompts/resources order.
    dispatcher_register_resource(pr_d,
    resource_def_new("test://p", "p", 0, 0), &h_resource);
    var rs_both = resp_result(dispatcher_dispatch(pr_d,
    req_with_params(req_new("1", "initialize"), "{\"protocolVersion\":\"2025-11-25\"}"), 0));
    assert(streq(jsonx_get_raw(rs_both, "capabilities"),
    "{\"tools\":{},\"prompts\":{},\"resources\":{}}") == 1,
    "prompts + resources both advertised in order");

    # ---------------- completion: capability + complete ----------------
    var cp_reg = tool_registry_new();
    var cp_d = dispatcher_new(cp_reg);

    # No handler → capability tools-only, completion/complete not found.
    var cp_init0 = resp_result(dispatcher_dispatch(cp_d,
    req_with_params(req_new("1", "initialize"), "{\"protocolVersion\":\"2025-11-25\"}"), 0));
    assert(streq(jsonx_get_raw(cp_init0, "capabilities"), "{\"tools\":{}}") == 1,
    "no completion → capabilities tools-only");
    var cp_c0 = dispatcher_dispatch(cp_d,
    req_with_params(req_new("2", "completion/complete"),
    "{\"ref\":{\"type\":\"ref/prompt\",\"name\":\"x\"},\"argument\":{\"name\":\"a\",\"value\":\"\"}}"), 0);
    assert(resp_error_obj(cp_c0) != 0, "completion/complete without handler → error");

    # Set the handler: flips the completions capability on.
    dispatcher_set_completion(cp_d, &h_complete);
    var cp_init1 = resp_result(dispatcher_dispatch(cp_d,
    req_with_params(req_new("1", "initialize"), "{\"protocolVersion\":\"2025-11-25\"}"), 0));
    assert(streq(jsonx_get_raw(cp_init1, "capabilities"), "{\"tools\":{},\"completions\":{}}") == 1,
    "completion handler → capabilities include completions");

    var cp_c = resp_result(dispatcher_dispatch(cp_d,
    req_with_params(req_new("2", "completion/complete"),
    "{\"ref\":{\"type\":\"ref/prompt\",\"name\":\"x\"},\"argument\":{\"name\":\"a\",\"value\":\"al\"}}"), 0));
    assert(streq(cp_c, "{\"completion\":{\"values\":[\"alpha\",\"beta\"]}}") == 1,
    "completion/complete returns handler body");
    assert(dispatcher_completion(cp_d) != 0, "completion handler set");

    # All four capabilities together, canonical order (pr_d has prompts + resources).
    dispatcher_set_completion(pr_d, &h_complete);
    var cp_all = resp_result(dispatcher_dispatch(pr_d,
    req_with_params(req_new("1", "initialize"), "{\"protocolVersion\":\"2025-11-25\"}"), 0));
    assert(streq(jsonx_get_raw(cp_all, "capabilities"),
    "{\"tools\":{},\"prompts\":{},\"resources\":{},\"completions\":{}}") == 1,
    "all four capabilities advertised in canonical order");

    # listChanged is gated on the notifications flag (set only by a transport
    # with a server→client drain path). Flipping it advertises listChanged for
    # tools, prompts and, since a registration publishes one (3.7.2), resources.
    dispatcher_set_notifications(pr_d, 1);
    var cap_lc = resp_result(dispatcher_dispatch(pr_d,
    req_with_params(req_new("1", "initialize"), "{\"protocolVersion\":\"2025-11-25\"}"), 0));
    assert(streq(jsonx_get_raw(cap_lc, "capabilities"),
    "{\"tools\":{\"listChanged\":true},\"prompts\":{\"listChanged\":true},\"resources\":{\"listChanged\":true},\"completions\":{}}") == 1,
    "notifications flag → tools, prompts and resources listChanged advertised");

    # ---------------- dispatch: tools/call success ----------------
    dispatcher_handle(d, "svc_echo", &h_echo);
    var call_req = req_with_params(req_new("3", "tools/call"),
    "{\"name\":\"svc_echo\",\"arguments\":{\"msg\":\"hi\"}}");
    var call_resp = dispatcher_dispatch(d, call_req, 0);
    var call_result = resp_result(call_resp);
    assert(call_result != 0, "call has result");
    # 3.4.8: a bare JSON result goes out as a text block holding the JSON,
    # so the reply is a CallToolResult (it went out verbatim through 3.4.7).
    assert(streq(call_result, "{\"content\":[{\"type\":\"text\",\"text\":\"{\\\"msg\\\":\\\"hi\\\"}\"}]}") == 1, "echo handler's bare args arrive as a text block");
    assert_eq(resp_error_obj(call_resp), 0, "call success no error");

    # ---------------- dispatch: tools/call with const handler ----------------
    registry_register(dreg, tool_def_new("svc_const", "constant", sa));
    dispatcher_handle(d, "svc_const", &h_const);
    var cc = dispatcher_dispatch(d, req_with_params(req_new("4", "tools/call"),
    "{\"name\":\"svc_const\",\"arguments\":{}}"), 0);
    assert(streq(resp_result(cc), "{\"content\":[{\"type\":\"text\",\"text\":\"{\\\"answer\\\":42}\"}]}") == 1, "const handler's bare object arrives as a text block");

    # ---------------- dispatch: tools/call missing name ----------------
    var bad_call = dispatcher_dispatch(d, req_with_params(req_new("5", "tools/call"), "{}"), 0);
    var bc_err = resp_error_obj(bad_call);
    assert(bc_err != 0, "missing name -> err");
    assert_eq(rpc_err_code(bc_err), 0 - 32602, "missing name -32602");

    # ---------------- dispatch: tools/call unknown tool ----------------
    var unk_call = dispatcher_dispatch(d, req_with_params(req_new("6", "tools/call"),
    "{\"name\":\"nope_x\",\"arguments\":{}}"), 0);
    var uc_err = resp_error_obj(unk_call);
    assert(uc_err != 0, "unknown tool -> err");
    assert_eq(rpc_err_code(uc_err), 0 - 32602, "unknown tool -32602");

    # ---------------- dispatch: unknown method ----------------
    var um_resp = dispatcher_dispatch(d, req_new("7", "garbage/method"), 0);
    var um_err = resp_error_obj(um_resp);
    assert(um_err != 0, "unknown method -> err");
    assert_eq(rpc_err_code(um_err), 0 - 32601, "unknown method -32601");

    # ---------------- dispatch: notification returns 0 ----------------
    var notif = req_notification("notifications/initialized");
    assert_eq(dispatcher_dispatch(d, notif, 0), 0, "notification dispatch returns 0");

    # ---------------- dispatch: dynamic register_tool with bad name ----------------
    var bad_reg = dispatcher_register_tool(d, tool_def_new("badname", "x", sa), &h_echo);
    assert(bad_reg != 0, "bad name register fails");
    assert_eq(bote_err_tag(bad_reg), BOTE_ERR_INVALID_PARAMS, "bad name -> INVALID_PARAMS");

    # ---------------- dispatch: dynamic register + dispatch ----------------
    var ok_reg = dispatcher_register_tool(d, tool_def_new("dyn_tool", "dyn", sa), &h_echo);
    assert_eq(ok_reg, 0, "valid register succeeds");
    var dyn_call = dispatcher_dispatch(d, req_with_params(req_new("8", "tools/call"),
    "{\"name\":\"dyn_tool\",\"arguments\":{\"q\":1}}"), 0);
    assert(_lc_has(resp_result(dyn_call), "{\\\"q\\\":1}") == 1, "dyn handler dispatched (its args, as text)");

    # ---------------- dispatch: deregister ----------------
    var dereg_ok = dispatcher_deregister_tool(d, "dyn_tool");
    assert_eq(dereg_ok, 0, "deregister ok");
    var dyn_after = dispatcher_dispatch(d, req_with_params(req_new("9", "tools/call"),
    "{\"name\":\"dyn_tool\",\"arguments\":{}}"), 0);
    var da_err = resp_error_obj(dyn_after);
    assert(da_err != 0, "after dereg unknown tool");
    assert_eq(rpc_err_code(da_err), 0 - 32602, "after dereg -32602");

    # Deregister missing
    var dereg_miss = dispatcher_deregister_tool(d, "never_existed");
    assert(dereg_miss != 0, "dereg missing returns err");
    assert_eq(bote_err_tag(dereg_miss), BOTE_ERR_TOOL_NOT_FOUND, "dereg missing -> TOOL_NOT_FOUND");

    # ---------------- codec: parse_request happy path ----------------
    var pr = codec_parse_request("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{}}");
    assert(pr != 0, "parse_request ok");
    assert(streq(req_jsonrpc(pr), "2.0") == 1, "pr jsonrpc");
    assert(streq(req_method(pr), "tools/list") == 1, "pr method");
    assert(streq(req_id(pr), "1") == 1, "pr id raw");
    assert(streq(req_params(pr), "{}") == 1, "pr params raw");

    # parse_request missing params → defaults to "null"
    var pr2 = codec_parse_request("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"initialize\"}");
    assert(streq(req_params(pr2), "null") == 1, "params defaults null");

    # parse_request notification (no id)
    var pr3 = codec_parse_request("{\"jsonrpc\":\"2.0\",\"method\":\"notify\"}");
    assert_eq(req_is_notification(pr3), 1, "parse notification flagged");

    # parse_request malformed → 0
    assert_eq(codec_parse_request("not json"), 0, "parse non-json -> 0");
    assert_eq(codec_parse_request("[1,2]"), 0, "parse array -> 0 (not object)");
    assert_eq(codec_parse_request("{\"id\":1}"), 0, "parse no method -> 0");

    # ---------------- codec: serialize_response ----------------
    var sok = codec_serialize_response(resp_success("1", "{\"x\":1}"));
    assert(streq(sok, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"x\":1}}") == 1, "serialize success");

    var serr = codec_serialize_response(resp_error("1", 0 - 32601, "tool not found"));
    assert(streq(serr, "{\"jsonrpc\":\"2.0\",\"id\":1,\"error\":{\"code\":-32601,\"message\":\"tool not found\"}}") == 1, "serialize error");

    # serialize with null result
    var sn = codec_serialize_response(resp_success("1", 0));
    assert(streq(sn, "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":null}") == 1, "serialize null result");

    # serialize with string id
    var sid = codec_serialize_response(resp_success("\"abc\"", "true"));
    assert(streq(sid, "{\"jsonrpc\":\"2.0\",\"id\":\"abc\",\"result\":true}") == 1, "serialize string id");

    # serialize escapes message quote/backslash/newline
    var sesc = codec_serialize_response(resp_error("1", 0 - 32000, "a \"b\" \\ c\nd"));
    assert(streq(sesc, "{\"jsonrpc\":\"2.0\",\"id\":1,\"error\":{\"code\":-32000,\"message\":\"a \\\"b\\\" \\\\ c\\nd\"}}") == 1, "serialize escapes");

    # ---------------- codec: process_message single ----------------
    var dreg2 = tool_registry_new();
    var d2 = dispatcher_new(dreg2);
    var sa2 = schema_new("object", 0, vec_new());
    registry_register(dreg2, tool_def_new("svc_echo", "echo", sa2));
    dispatcher_handle(d2, "svc_echo", &h_echo);

    var pm1 = codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"}", d2, 0);
    assert(pm1 != 0, "single ok");
    assert_eq(jsonx_has(pm1, "result"), 1, "single has result");

    # process_message notification → 0
    assert_eq(codec_process_message("{\"jsonrpc\":\"2.0\",\"method\":\"notify\"}", d2, 0), 0, "single notif -> 0");

    # process_message non-json → parse error
    var pmpe = codec_process_message("not json", d2, 0);
    assert(pmpe != 0, "non-json returns err");
    assert_eq(jsonx_has(pmpe, "error"), 1, "non-json -> error obj");

    # process_message non-object/non-array → invalid request
    var pmni = codec_process_message("42", d2, 0);
    assert(pmni != 0, "scalar returns err");
    assert_eq(jsonx_has(pmni, "error"), 1, "scalar -> error obj");

    # process_message wrong jsonrpc version
    var pmwv = codec_process_message("{\"jsonrpc\":\"1.0\",\"id\":1,\"method\":\"x\"}", d2, 0);
    assert_eq(jsonx_has(pmwv, "error"), 1, "wrong version -> err");

    # ---------------- codec: process_message batch ----------------
    var pmb = codec_process_message(
    "[{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"},{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\"}]",
    d2, 0);
    assert(pmb != 0, "batch returns array");
    # Should be an array
    assert_eq(load8(pmb), 91, "batch starts with [");

    # batch with notification (only one response back)
    var pmbn = codec_process_message(
    "[{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"},{\"jsonrpc\":\"2.0\",\"method\":\"notify\"}]",
    d2, 0);
    assert(pmbn != 0, "mixed batch returns");

    # all-notifications batch → 0
    var pmbz = codec_process_message(
    "[{\"jsonrpc\":\"2.0\",\"method\":\"a\"},{\"jsonrpc\":\"2.0\",\"method\":\"b\"}]",
    d2, 0);
    assert_eq(pmbz, 0, "all-notif batch -> 0");

    # empty batch → invalid request
    var pmbe = codec_process_message("[]", d2, 0);
    assert(pmbe != 0, "empty batch returns err");
    assert_eq(jsonx_has(pmbe, "error"), 1, "empty batch -> error");

    # ---------------- schema: type checking ----------------
    var ps = vec_new();
    vec_push(ps, schema_prop_new("name", "{\"type\":\"string\"}"));
    var s_str = schema_new("object", ps, vec_new());
    var c_str = compiled_compile(s_str);

    assert_eq(vec_len(compiled_validate(c_str, "{\"name\":\"alice\"}")), 0, "string ok");
    assert_eq(vec_len(compiled_validate(c_str, "{\"name\":42}")), 1, "string rejects int");

    var ps_n = vec_new();
    vec_push(ps_n, schema_prop_new("score", "{\"type\":\"number\"}"));
    var c_num = compiled_compile(schema_new("object", ps_n, vec_new()));
    assert_eq(vec_len(compiled_validate(c_num, "{\"score\":42}")), 0, "number ok int");
    assert_eq(vec_len(compiled_validate(c_num, "{\"score\":\"abc\"}")), 1, "number rejects string");

    var ps_i = vec_new();
    vec_push(ps_i, schema_prop_new("count", "{\"type\":\"integer\"}"));
    var c_int = compiled_compile(schema_new("object", ps_i, vec_new()));
    assert_eq(vec_len(compiled_validate(c_int, "{\"count\":42}")), 0, "integer ok");
    assert_eq(vec_len(compiled_validate(c_int, "{\"count\":3.14}")), 1, "integer rejects float");

    var ps_b = vec_new();
    vec_push(ps_b, schema_prop_new("flag", "{\"type\":\"boolean\"}"));
    var c_bool = compiled_compile(schema_new("object", ps_b, vec_new()));
    assert_eq(vec_len(compiled_validate(c_bool, "{\"flag\":true}")), 0, "bool ok true");
    assert_eq(vec_len(compiled_validate(c_bool, "{\"flag\":false}")), 0, "bool ok false");
    assert_eq(vec_len(compiled_validate(c_bool, "{\"flag\":\"yes\"}")), 1, "bool rejects string");

    # ---------------- schema: array of strings ----------------
    var ps_a = vec_new();
    vec_push(ps_a, schema_prop_new("tags", "{\"type\":\"array\",\"items\":{\"type\":\"string\"}}"));
    var c_arr = compiled_compile(schema_new("object", ps_a, vec_new()));
    assert_eq(vec_len(compiled_validate(c_arr, "{\"tags\":[\"a\",\"b\"]}")), 0, "array of strings ok");
    assert_eq(vec_len(compiled_validate(c_arr, "{\"tags\":[1,2]}")), 2, "array of strings rejects ints");
    assert_eq(vec_len(compiled_validate(c_arr, "{\"tags\":\"not array\"}")), 1, "array rejects scalar");

    # ---------------- schema: nested object ----------------
    var ps_o = vec_new();
    vec_push(ps_o, schema_prop_new("config",
    "{\"type\":\"object\",\"properties\":{\"host\":{\"type\":\"string\"},\"port\":{\"type\":\"integer\"}},\"required\":[\"host\"]}"));
    var c_obj = compiled_compile(schema_new("object", ps_o, vec_new()));
    assert_eq(vec_len(compiled_validate(c_obj, "{\"config\":{\"host\":\"localhost\",\"port\":8080}}")), 0, "nested ok");
    assert_eq(vec_len(compiled_validate(c_obj, "{\"config\":{\"port\":8080}}")), 1, "nested missing required");
    assert_eq(vec_len(compiled_validate(c_obj, "{\"config\":{\"host\":42}}")), 1, "nested wrong type");

    # ---------------- schema: enum ----------------
    var ps_e = vec_new();
    vec_push(ps_e, schema_prop_new("mode", "{\"type\":\"string\",\"enum\":[\"read\",\"write\",\"append\"]}"));
    var c_en = compiled_compile(schema_new("object", ps_e, vec_new()));
    assert_eq(vec_len(compiled_validate(c_en, "{\"mode\":\"read\"}")), 0, "enum ok");
    assert_eq(vec_len(compiled_validate(c_en, "{\"mode\":\"delete\"}")), 1, "enum rejects unknown");

    # ---------------- schema: number bounds ----------------
    var ps_nb = vec_new();
    vec_push(ps_nb, schema_prop_new("age", "{\"type\":\"number\",\"minimum\":0,\"maximum\":150}"));
    var c_nb = compiled_compile(schema_new("object", ps_nb, vec_new()));
    assert_eq(vec_len(compiled_validate(c_nb, "{\"age\":25}")), 0, "in bounds");
    assert_eq(vec_len(compiled_validate(c_nb, "{\"age\":-1}")), 1, "below min");
    assert_eq(vec_len(compiled_validate(c_nb, "{\"age\":200}")), 1, "above max");

    # ---------------- schema: integer bounds ----------------
    var ps_ib = vec_new();
    vec_push(ps_ib, schema_prop_new("retries", "{\"type\":\"integer\",\"minimum\":0,\"maximum\":5}"));
    var c_ib = compiled_compile(schema_new("object", ps_ib, vec_new()));
    assert_eq(vec_len(compiled_validate(c_ib, "{\"retries\":3}")), 0, "int in bounds");
    assert_eq(vec_len(compiled_validate(c_ib, "{\"retries\":-1}")), 1, "int below");
    assert_eq(vec_len(compiled_validate(c_ib, "{\"retries\":10}")), 1, "int above");

    # ---------------- schema: numbers as JSON Schema 2020-12 reads them (3.4.8) ----------------
    # Exponents and fractions are read; an integer is any number whose
    # fractional part is zero. Through 3.4.7 `5e2` was read as 5 and `3.0`
    # was not an integer.
    assert_eq(vec_len(compiled_validate(c_ib, "{\"retries\":3.0}")), 0, "integer: 3.0 is an integer (2020-12)");
    assert_eq(vec_len(compiled_validate(c_ib, "{\"retries\":3.5}")), 1, "integer: 3.5 is not");
    assert_eq(vec_len(compiled_validate(c_ib, "{\"retries\":4e0}")), 0, "integer: 4e0 is an integer, in bounds");
    assert_eq(vec_len(compiled_validate(c_ib, "{\"retries\":5e1}")), 1, "integer: 5e1 is 50, above 5 (3.4.7 read it as 5)");
    var ps_ne = vec_new();
    vec_push(ps_ne, schema_prop_new("n", "{\"type\":\"number\",\"minimum\":100,\"maximum\":1e3}"));
    var c_ne = compiled_compile(schema_new("object", ps_ne, vec_new()));
    assert_eq(vec_len(compiled_validate(c_ne, "{\"n\":5e2}")), 0, "number: 5e2 is 500, inside [100, 1e3] (3.4.7 refused it as 5)");
    assert_eq(vec_len(compiled_validate(c_ne, "{\"n\":1.5e2}")), 0, "number: 1.5e2 is 150");
    assert_eq(vec_len(compiled_validate(c_ne, "{\"n\":2e3}")), 1, "number: 2e3 is above a maximum written 1e3");
    assert_eq(vec_len(compiled_validate(c_ne, "{\"n\":1e999}")), 1, "number: a huge exponent saturates and stays above the maximum");
    assert_eq(vec_len(compiled_validate(c_ne, "{\"n\":99.9}")), 1, "number: 99.9 is below 100");
    var nv[8];
    assert_eq(_sch_num_parse("-0", &nv), 2, "parse: -0 is integral");
    assert_eq(_sch_num_parse("1e-1", &nv), 1, "parse: 1e-1 has a fractional part");
    assert_eq(load64(&nv), 0, "parse: ...and truncates to 0");
    assert_eq(_sch_num_parse("-12.75", &nv), 1, "parse: -12.75 has a fractional part");
    assert_eq(load64(&nv), 0 - 12, "parse: ...and truncates toward zero, to -12");
    assert_eq(_sch_num_parse("abc", &nv), 0, "parse: a word is not a number");
    assert_eq(_sch_num_parse("1.", &nv), 0, "parse: a trailing dot is not a number");

    # ---------------- schema: required ----------------
    var ps_r = vec_new();
    vec_push(ps_r, schema_prop_new("name", "{\"type\":\"string\"}"));
    vec_push(ps_r, schema_prop_new("age", "{\"type\":\"integer\"}"));
    var req_one = vec_new();
    vec_push(req_one, "name");
    var c_req = compiled_compile(schema_new("object", ps_r, req_one));
    assert_eq(vec_len(compiled_validate(c_req, "{\"name\":\"alice\"}")), 0, "required present");
    assert_eq(vec_len(compiled_validate(c_req, "{\"age\":25}")), 1, "missing required");

    # ---------------- schema: multiple violations reported ----------------
    var req2 = vec_new();
    vec_push(req2, "name");
    vec_push(req2, "age");
    var c_multi = compiled_compile(schema_new("object", ps_r, req2));
    assert_eq(vec_len(compiled_validate(c_multi, "{}")), 2, "two missing required");

    # ---------------- schema: unknown type → ANY ----------------
    var ps_any = vec_new();
    vec_push(ps_any, schema_prop_new("data", "{\"type\":\"custom_type\"}"));
    var c_any = compiled_compile(schema_new("object", ps_any, vec_new()));
    assert_eq(vec_len(compiled_validate(c_any, "{\"data\":42}")), 0, "any accepts int");
    assert_eq(vec_len(compiled_validate(c_any, "{\"data\":\"hi\"}")), 0, "any accepts string");

    # ---------------- schema: extra fields allowed ----------------
    assert_eq(vec_len(compiled_validate(c_str, "{\"name\":\"a\",\"extra\":42}")), 0, "extra allowed");

    # ---------------- schema: non-object rejected ----------------
    assert_eq(vec_len(compiled_validate(c_str, "\"not object\"")), 1, "non-object rejected");

    # ---------------- registry: validate uses compiled when attached ----------------
    var rcompiled = tool_registry_new();
    var p_compiled = vec_new();
    vec_push(p_compiled, schema_prop_new("count", "{\"type\":\"integer\",\"minimum\":1,\"maximum\":10}"));
    var s_compiled = schema_new("object", p_compiled, vec_new());
    var t_compiled = tool_def_with_compiled(tool_def_new("svc_count", "compiled", s_compiled),
    compiled_compile(s_compiled));
    registry_register(rcompiled, t_compiled);
    assert_eq(registry_validate_params(rcompiled, "svc_count", "{\"count\":5}"), 0, "compiled validate ok");
    var bv = registry_validate_params(rcompiled, "svc_count", "{\"count\":99}");
    assert(bv != 0, "compiled validate err on bound");
    assert_eq(bote_err_tag(bv), BOTE_ERR_SCHEMA_VIOLATION, "bound err -> SCHEMA_VIOLATION");
    var tv = registry_validate_params(rcompiled, "svc_count", "{\"count\":\"x\"}");
    assert(tv != 0, "compiled validate err on type");
    assert_eq(bote_err_tag(tv), BOTE_ERR_SCHEMA_VIOLATION, "type err -> SCHEMA_VIOLATION");

    # ---------------- stream: cancellation token ----------------
    var tok = bote_cancel_token_new();
    assert_eq(bote_cancel_token_is_cancelled(tok), 0, "fresh token not cancelled");
    bote_cancel_token_cancel(tok);
    assert_eq(bote_cancel_token_is_cancelled(tok), 1, "after cancel set");

    # ---------------- stream: progress sender + updates ----------------
    var ps_send = progress_sender_new();
    progress_sender_report(ps_send, 3, 10);
    progress_sender_report_msg(ps_send, 5, 10, "halfway");
    var updates = progress_sender_updates(ps_send);
    assert_eq(vec_len(updates), 2, "two updates");
    var u1 = vec_get(updates, 0);
    assert_eq(progress_update_progress(u1), 3, "u1 progress");
    assert_eq(progress_update_total(u1), 10, "u1 total");
    var u2 = vec_get(updates, 1);
    assert_eq(progress_update_progress(u2), 5, "u2 progress");
    assert(streq(progress_update_message(u2), "halfway") == 1, "u2 message");

    # send-after-close is silently dropped
    progress_sender_close(ps_send);
    progress_sender_report(ps_send, 9, 10);
    assert_eq(vec_len(updates), 2, "post-close drop");

    # ---------------- stream: progress_notification JSON ----------------
    var u_notif = progress_update_new(3, 10, "working");
    var prog_notif = progress_notification("42", u_notif);
    assert(streq(prog_notif, "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/progress\",\"params\":{\"progressToken\":42,\"progress\":3,\"total\":10,\"message\":\"working\"}}") == 1, "progress notif json");

    var u_min = progress_update_new(7, 0 - 1, 0);
    var notif_min = progress_notification("\"abc\"", u_min);
    assert(streq(notif_min, "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/progress\",\"params\":{\"progressToken\":\"abc\",\"progress\":7}}") == 1, "progress notif minimal");

    # ---------------- stream: notification_wire + list_changed builders ----------------
    assert(streq(notification_wire("notifications/x", "{\"a\":1}"),
    "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/x\",\"params\":{\"a\":1}}") == 1,
    "notification_wire with raw params");
    assert(streq(notification_wire("notifications/y", 0),
    "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/y\",\"params\":{}}") == 1,
    "notification_wire null params → {}");
    assert(streq(tools_list_changed_notification(),
    "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/tools/list_changed\",\"params\":{}}") == 1,
    "tools/list_changed notification");
    assert(streq(prompts_list_changed_notification(),
    "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/prompts/list_changed\",\"params\":{}}") == 1,
    "prompts/list_changed notification");
    assert(streq(resources_list_changed_notification(),
    "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/resources/list_changed\",\"params\":{}}") == 1,
    "resources/list_changed notification");
    assert(streq(resource_updated_notification("bote://info"),
    "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/resources/updated\",\"params\":{\"uri\":\"bote://info\"}}") == 1,
    "resources/updated notification");

    # ---------------- session: validate_protocol_version ----------------
    assert_eq(validate_protocol_version("2025-11-25"), 0, "proto 2025-11-25 ok");
    assert_eq(validate_protocol_version("2025-03-26"), 0, "proto 2025-03-26 ok");
    assert_eq(validate_protocol_version("2024-11-05"), 0, "proto 2024-11-05 ok");
    assert_eq(validate_protocol_version("2025-06-18"), 0, "proto 2025-06-18 ok (3.3.13)");
    assert(validate_protocol_version("1999-01-01") != 0, "proto 1999 rejected");
    assert(validate_protocol_version(0) != 0, "null proto rejected");

    # The header validator and the negotiator must agree on every version.
    # They carried SEPARATE lists through 3.3.12; validate_protocol_version
    # now defers to _mcp_is_supported, and this pins that they cannot drift
    # again. The asymmetry the split produced was invisible from either side
    # alone: a version in one but not the other negotiates over stdio and
    # 400s on the MCP-Protocol-Version header of every HTTP-family transport.
    assert_eq(validate_protocol_version("2024-11-05"), _mcp_is_supported("2024-11-05") - 1,
    "header validator agrees with the negotiator: 2024-11-05");
    assert_eq(validate_protocol_version("2025-03-26"), _mcp_is_supported("2025-03-26") - 1,
    "header validator agrees with the negotiator: 2025-03-26");
    assert_eq(validate_protocol_version("2025-06-18"), _mcp_is_supported("2025-06-18") - 1,
    "header validator agrees with the negotiator: 2025-06-18");
    assert_eq(validate_protocol_version("2025-11-25"), _mcp_is_supported("2025-11-25") - 1,
    "header validator agrees with the negotiator: 2025-11-25");
    assert_eq(_mcp_is_supported("1999-01-01"), 0,
    "and both reject the same unknown version");

    # ---------------- session: validate_origin ----------------
    assert_eq(validate_origin("", 0), 0, "empty origin allowed");
    assert_eq(validate_origin(0, 0), 0, "null origin allowed");

    var allowed_star = vec_new();
    vec_push(allowed_star, "*");
    assert_eq(validate_origin("http://evil.com", allowed_star), 0, "wildcard allows");

    var allowed_loop = vec_new();
    vec_push(allowed_loop, "http://localhost:8090");
    assert_eq(validate_origin("http://localhost:8090", allowed_loop), 0, "matched origin");
    assert(validate_origin("http://evil.com", allowed_loop) != 0, "unmatched origin");

    var allowed_empty = vec_new();
    assert(validate_origin("http://localhost", allowed_empty) != 0, "empty list strict mode");

    # ---------------- session: SessionStore lifecycle ----------------
    var store = session_store_default();
    assert_eq(session_store_active_count(store), 0, "fresh store empty");
    var sid_a = session_store_create(store, "2025-11-25");
    assert(sid_a != 0, "sid created");
    assert_eq(strlen(sid_a), 32, "sid is 32 hex chars");
    assert_eq(session_store_active_count(store), 1, "one session");
    var s = session_store_validate(store, sid_a);
    assert(s != 0, "validate returns session");
    assert(streq(mcp_session_protocol_version(s), "2025-11-25") == 1, "session proto");
    assert_eq(session_store_validate(store, "nonexistent_id"), 0, "unknown sid -> 0");

    var sid_b = session_store_create(store, "2024-11-05");
    assert_eq(session_store_active_count(store), 2, "two sessions");
    assert(streq(sid_a, sid_b) == 0, "session ids unique");

    assert_eq(session_store_remove(store, sid_a), 1, "remove returns 1");
    assert_eq(session_store_active_count(store), 1, "one left");
    assert_eq(session_store_remove(store, sid_a), 0, "remove again returns 0");
    assert_eq(session_store_remove(store, sid_b), 1, "remove last");
    assert_eq(session_store_active_count(store), 0, "store empty");

    # ---------------- session: opaque outbound slot ----------------
    # McpSession carries a type-agnostic +32 slot for a per-session push
    # bundle; session.cyr never dereferences it. Defaults to 0; round-trips.
    var sess_ob = mcp_session_new("sid0", "2025-11-25", 1000);
    assert_eq(mcp_session_outbound(sess_ob), 0, "outbound defaults to 0");
    mcp_session_set_outbound(sess_ob, 4242);
    assert_eq(mcp_session_outbound(sess_ob), 4242, "outbound set/get round-trips");
    # Other fields unshifted by the widen.
    assert(streq(mcp_session_id(sess_ob), "sid0") == 1, "id intact after widen");
    assert_eq(mcp_session_created_at(sess_ob), 1000, "created_at intact after widen");

    # ---------------- session: prune_expired ----------------
    var short_store = session_store_new(1);
    session_store_create(short_store, "2025-11-25");
    session_store_create(short_store, "2025-11-25");
    sleep_ms(10);
    var pruned = session_store_prune_expired(short_store);
    assert_eq(pruned, 2, "pruned 2");
    assert_eq(session_store_active_count(short_store), 0, "after prune empty");

    # ---------------- HTTP: header parsing helpers ----------------
    var fake = alloc(512);
    var fake_n = 0;
    memcpy(fake, "POST /mcp HTTP/1.1", 18); fake_n = 18;
    store8(fake + fake_n, 13); store8(fake + fake_n + 1, 10); fake_n = fake_n + 2;
    memcpy(fake + fake_n, "Host: localhost:9999", 20); fake_n = fake_n + 20;
    store8(fake + fake_n, 13); store8(fake + fake_n + 1, 10); fake_n = fake_n + 2;
    memcpy(fake + fake_n, "Content-Length: 5", 17); fake_n = fake_n + 17;
    store8(fake + fake_n, 13); store8(fake + fake_n + 1, 10); fake_n = fake_n + 2;
    memcpy(fake + fake_n, "Origin: http://x", 16); fake_n = fake_n + 16;
    store8(fake + fake_n, 13); store8(fake + fake_n + 1, 10); fake_n = fake_n + 2;
    store8(fake + fake_n, 13); store8(fake + fake_n + 1, 10); fake_n = fake_n + 2;
    memcpy(fake + fake_n, "hello", 5); fake_n = fake_n + 5;
    store8(fake + fake_n, 0);

    assert(streq(sandhi_server_get_method(fake, fake_n), "POST") == 1, "http method");
    assert(streq(sandhi_server_get_path(fake, fake_n), "/mcp") == 1, "http path");
    assert_eq(sandhi_server_content_length(fake, fake_n), 5, "content-length 5");
    assert(streq(sandhi_server_find_header(fake, fake_n, "Origin"), "http://x") == 1, "origin parsed");
    assert(streq(sandhi_server_find_header(fake, fake_n, "Host"), "localhost:9999") == 1, "host parsed");
    assert(streq(sandhi_server_find_header(fake, fake_n, "content-length"), "5") == 1, "case-insensitive");
    assert_eq(sandhi_server_find_header(fake, fake_n, "Missing"), 0, "missing header -> 0");
    var bo = sandhi_server_body_offset(fake, fake_n);
    assert(bo > 0, "body offset > 0");
    assert(memeq(fake + bo, "hello", 5) == 1, "body bytes match");

    # ---------------- discovery: announcement JSON ----------------
    var disc_tools = vec_new();
    var disc_sa = schema_new("object", 0, vec_new());
    vec_push(disc_tools, tool_def_new("svc_alpha", "alpha tool", disc_sa));
    vec_push(disc_tools, tool_def_with_version(tool_def_new("svc_beta", "beta tool", disc_sa), "2.0"));
    var ann = announcement_new("node-1", disc_tools);
    assert(streq(announcement_node_id(ann), "node-1") == 1, "ann node id");
    assert_eq(vec_len(announcement_tools(ann)), 2, "ann two tools");

    var ann_json = announcement_to_json(ann);
    assert_eq(jsonx_has(ann_json, "node_id"), 1, "ann json has node_id");
    assert_eq(jsonx_has(ann_json, "tools"), 1, "ann json has tools");
    assert(streq(jsonx_get_str(ann_json, "node_id"), "node-1") == 1, "ann json node-1");

    # ---------------- discovery: service publish (via EventSink) ----------------
    _ev_reset();
    var disc_sink = event_sink_new(&test_event_publish, 0);
    var disc = discovery_new("node-x", disc_sink);
    assert(streq(discovery_node_id(disc), "node-x") == 1, "disc node id");
    assert(streq(discovery_topic(disc), "bote/tool/announce") == 1, "disc topic");

    var emitted = discovery_announce(disc, disc_tools);
    assert(emitted != 0, "announce returns json");
    assert_eq(vec_len(_ev_topics), 1, "sink got 1");
    assert(streq(vec_get(_ev_topics, 0), "bote/tool/announce") == 1, "topic right");
    assert(streq(jsonx_get_str(vec_get(_ev_payloads, 0), "node_id"), "node-x") == 1, "payload node-x");

    var disc_quiet = discovery_new("node-q", 0);
    var quiet_json = discovery_announce(disc_quiet, disc_tools);
    assert(quiet_json != 0, "quiet still builds json");
    assert_eq(vec_len(_ev_topics), 1, "quiet didn't publish");

    # ---------------- discovery: receiver queue ----------------
    var rx = discovery_receiver_new();
    assert_eq(discovery_receiver_len(rx), 0, "empty receiver");
    assert_eq(discovery_receiver_try_recv(rx), 0, "empty try_recv -> 0");

    discovery_receiver_push(rx, "ann1");
    discovery_receiver_push(rx, "ann2");
    assert_eq(discovery_receiver_len(rx), 2, "two queued");
    assert(streq(discovery_receiver_try_recv(rx), "ann1") == 1, "fifo head ann1");
    assert(streq(discovery_receiver_try_recv(rx), "ann2") == 1, "fifo head ann2");
    assert_eq(discovery_receiver_try_recv(rx), 0, "drained -> 0");

    # ---------------- bridge: wrap_tool_result ----------------
    var wr_raw = wrap_tool_result("{\"answer\":42}");
    assert_eq(jsonx_has(wr_raw, "content"), 1, "raw wrapped has content");
    var wr_content = jsonx_get_raw(wr_raw, "content");
    assert(wr_content != 0, "content present");
    assert_eq(load8(wr_content), 91, "content is array");

    var wr_str = wrap_tool_result("\"just a string\"");
    assert_eq(jsonx_has(wr_str, "content"), 1, "string wrapped");

    var wr_null = wrap_tool_result(0);
    assert_eq(jsonx_has(wr_null, "content"), 1, "null wrapped to envelope");

    # Already-shaped result with content array → pass through verbatim
    var formatted = "{\"content\":[{\"type\":\"text\",\"text\":\"hello\"}]}";
    var wr_pt = wrap_tool_result(formatted);
    assert(streq(wr_pt, formatted) == 1, "passthrough preserves bytes");

    # 2.7.0: single content block (object with "type") lifts into a
    # 1-element content array, preserving annotations. Pre-2.7.0 this
    # path JSON-escaped the whole block into a `text` payload, losing
    # the annotations.
    var wr_block = wrap_tool_result("{\"type\":\"text\",\"text\":\"hi\"}");
    assert(streq(wr_block, "{\"content\":[{\"type\":\"text\",\"text\":\"hi\"}]}") == 1,
    "single block lifts into 1-element content");

    var wr_ann = wrap_tool_result(
    "{\"type\":\"text\",\"text\":\"hi\",\"annotations\":{\"priority\":50}}");
    assert(streq(wr_ann,
    "{\"content\":[{\"type\":\"text\",\"text\":\"hi\",\"annotations\":{\"priority\":50}}]}") == 1,
    "annotations survive the lift");

    var wr_img = wrap_tool_result(
    "{\"type\":\"image\",\"data\":\"AA==\",\"mimeType\":\"image/png\",\"annotations\":{\"audience\":[\"user\"]}}");
    assert(streq(wr_img,
    "{\"content\":[{\"type\":\"image\",\"data\":\"AA==\",\"mimeType\":\"image/png\",\"annotations\":{\"audience\":[\"user\"]}}]}") == 1,
    "image-block annotations survive");

    # Non-block object (no "type" field) still falls through to the
    # synthesised text wrap — the block detection is type-tagged.
    var wr_obj = wrap_tool_result("{\"answer\":42}");
    assert_eq(jsonx_has(wr_obj, "content"), 1, "non-block object wraps to envelope");

    # ---------------- bridge: wrap_error_result ----------------
    var werr = wrap_error_result("something failed");
    assert_eq(jsonx_has(werr, "content"), 1, "err has content");
    assert_eq(jsonx_has(werr, "isError"), 1, "err has isError");
    var is_err_v = jsonx_get_raw(werr, "isError");
    assert(streq(is_err_v, "true") == 1, "isError true");

    # ---------------- bridge: process_message wraps tools/call ----------------
    var bdreg = tool_registry_new();
    var bs = schema_new("object", 0, vec_new());
    registry_register(bdreg, tool_def_new("svc_echo", "echo", bs));
    var bd = dispatcher_new(bdreg);
    dispatcher_handle(bd, "svc_echo", &h_echo);

    var bp_call = bridge_process_message(
    "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"svc_echo\",\"arguments\":{\"k\":\"v\"}}}",
    bd, 0);
    assert(bp_call != 0, "bridge tools/call returns json");
    var bp_result = jsonx_get_raw(bp_call, "result");
    assert(bp_result != 0, "result present");
    assert_eq(jsonx_has(bp_result, "content"), 1, "result wrapped in MCP envelope");

    # Non-tools-call methods pass through unchanged.
    var bp_init = bridge_process_message(
    "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"}", bd, 0);
    assert(bp_init != 0, "init returns json");
    var bp_init_result = jsonx_get_raw(bp_init, "result");
    assert_eq(jsonx_has(bp_init_result, "protocolVersion"), 1, "init has protocolVersion (not wrapped)");
    assert_eq(jsonx_has(bp_init_result, "content"), 0, "init not wrapped");

    # Tool-call error → wrapped as success + isError.
    var bp_unknown = bridge_process_message(
    "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"missing_tool\",\"arguments\":{}}}",
    bd, 0);
    assert(bp_unknown != 0, "unknown returns json");
    var bp_un_result = jsonx_get_raw(bp_unknown, "result");
    assert(bp_un_result != 0, "error mapped to result");
    assert_eq(jsonx_has(bp_un_result, "isError"), 1, "isError flag");
    assert_eq(jsonx_has(bp_unknown, "error"), 0, "no top-level error obj");

    # Notification still produces no response.
    assert_eq(bridge_process_message("{\"jsonrpc\":\"2.0\",\"method\":\"notify\"}", bd, 0), 0,
    "bridge notif -> 0");

    # 3.4.5: the bridge runs the codec's own checks (_cdc_admit + jsonx_valid),
    # so what the codec refuses, the bridge refuses the same way.
    var bp_bad = bridge_process_message("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\",}", bd, 0);
    assert(_lc_has(bp_bad, "\"code\":-32700") == 1, "bridge: invalid JSON is -32700, as in the codec");
    var bp_bid = bridge_process_message("{\"jsonrpc\":\"2.0\",\"id\":{},\"method\":\"ping\"}", bd, 0);
    assert(_lc_has(bp_bid, "\"code\":-32600") == 1, "bridge: an object id is -32600, as in the codec");
    # A schema violation is already a tool result with isError (SEP-1303); the
    # bridge passes it through once rather than wrapping it a second time.
    var bsp = vec_new();
    vec_push(bsp, schema_prop_new("path", "{\"type\":\"string\"}"));
    var bsr = vec_new();
    vec_push(bsr, "path");
    var bss = schema_new("object", bsp, bsr);
    registry_register(bdreg, tool_def_with_compiled(tool_def_new("svc_strict", "strict", bss), compiled_compile(bss)));
    dispatcher_handle(bd, "svc_strict", &h_echo);
    var bp_sv = bridge_process_message(
    "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"svc_strict\",\"arguments\":{}}}",
    bd, 0);
    assert(_lc_has(bp_sv, "\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"schema violation for tool 'svc_strict'") == 1,
      "bridge: a schema violation arrives as the dispatcher's own isError result");
    assert(_lc_has(bp_sv, "\"isError\":true}}") == 1 && _lc_has(bp_sv, "\\\"isError") == 0,
      "bridge: ...not wrapped a second time");

    # ---------------- bridge: cors origin selection ----------------
    var cors_a = vec_new();
    vec_push(cors_a, "*");
    assert(streq(_bridge_cors_origin(cors_a, "http://anything"), "*") == 1, "cors wildcard");

    var cors_b = vec_new();
    vec_push(cors_b, "http://localhost:3000");
    vec_push(cors_b, "http://localhost:8080");
    assert(streq(_bridge_cors_origin(cors_b, "http://localhost:8080"), "http://localhost:8080") == 1, "cors exact match returned");
    # Unmatched origin → fall back to first allowed origin
    assert_eq(_bridge_cors_origin(cors_b, "http://evil.com"), 0, "cors unmatched -> none (3.4.15; `null` matched a sandboxed iframe audit M3)");
    assert_eq(_bridge_cors_origin(0, "http://x"), 0, "cors no list -> none (3.4.15; it was a wildcard)");
    assert_eq(_bridge_cors_origin(vec_new(), "http://x"), 0, "cors empty list -> none (3.4.15; it was a wildcard)");
    assert_eq(_bridge_cors_origin(cors_a, 0), 0, "cors no Origin -> none");
    assert_eq(strlen(_bridge_cors_headers(0, "http://evil.com")), 0, "cors refused -> no header at all");
    assert(_lc_has(_bridge_cors_headers(cors_b, "http://localhost:8080"), "Vary: Origin") == 1, "cors allowed -> Vary: Origin");
    assert(_lc_has(_bridge_cors_headers(cors_b, "http://localhost:8080"), "authorization") == 1, "cors allowed -> a bearer client can pass preflight");

    # ---------------- origin: the check every HTTP-family transport makes (3.4.15) ----------------
    assert_eq(bote_origin_ok(0, 0), 1, "origin: none, no list -> passes (a CLI client)");
    assert_eq(bote_origin_ok("", 0), 1, "origin: empty, no list -> passes");
    assert_eq(bote_origin_ok("http://evil.example", 0), 0, "origin: present, no list -> refused");
    assert_eq(bote_origin_ok("http://evil.example", vec_new()), 0, "origin: present, empty list -> refused");
    assert_eq(bote_origin_ok("http://evil.example", cors_b), 0, "origin: not on the list -> refused");
    assert_eq(bote_origin_ok("null", cors_b), 0, "origin: a sandboxed iframe's `null` -> refused");
    assert_eq(bote_origin_ok("http://localhost:8080", cors_b), 1, "origin: on the list -> passes");
    assert_eq(bote_origin_ok("http://anything", cors_a), 1, "origin: `*` -> passes");
    assert_eq(bote_origin_self("http://localhost:8390", "localhost:8390", 0), 1, "origin self: localhost, its own Host");
    assert_eq(bote_origin_self("http://127.0.0.1:8390", "127.0.0.1:8390", 0), 1, "origin self: 127.0.0.1");
    assert_eq(bote_origin_self("http://[::1]:8390", "[::1]:8390", 0), 1, "origin self: [::1]");
    assert_eq(bote_origin_self("http://localhost", "localhost", 0), 1, "origin self: no port");
    assert_eq(bote_origin_self("https://localhost:8390", "localhost:8390", 0), 1, "origin self: https");
    assert_eq(bote_origin_self("http://localhost:8390", "localhost:8390", vec_new()), 1, "origin self: an empty list is no list");
    assert_eq(bote_origin_self("http://localhost:3000", "localhost:8390", 0), 0, "origin self: another port on this machine");
    assert_eq(bote_origin_self("http://evil.example:8390", "evil.example:8390", 0), 0, "origin self: a rebinding page, whose Host is its own name");
    assert_eq(bote_origin_self("http://evil.example", "localhost:8390", 0), 0, "origin self: another name");
    assert_eq(bote_origin_self("http://localhost.evil.example", "localhost.evil.example", 0), 0, "origin self: a name that starts like localhost");
    assert_eq(bote_origin_self("http://127.0.0.10", "127.0.0.10", 0), 0, "origin self: an address that starts like loopback");
    assert_eq(bote_origin_self("http://localhost:8390", "localhost:8390", cors_b), 0, "origin self: a list is the whole policy");
    assert_eq(bote_origin_self("http://localhost:8390", 0, 0), 0, "origin self: no Host");
    assert_eq(bote_origin_self(0, "localhost:8390", 0), 0, "origin self: no Origin");
    assert_eq(bote_origin_self("ftp://localhost:8390", "localhost:8390", 0), 0, "origin self: another scheme");
    assert_eq(bote_origin_self("localhost:8390", "localhost:8390", 0), 0, "origin self: no scheme");
    assert_eq(bote_origin_self("http://", "localhost:8390", 0), 0, "origin self: a scheme alone");
    assert_eq(bote_origin_ok(0, cors_b), 1, "origin: none, a list -> passes");
    var oh_before = alloc_used();
    bote_origin_ok("http://evil.example", cors_b);
    assert_eq(alloc_used() - oh_before, 0, "origin: a refusal allocates nothing");

    # ---------------- review punch: schema bounds at exact min/max ----------------
    var ps_b1 = vec_new();
    vec_push(ps_b1, schema_prop_new("age", "{\"type\":\"integer\",\"minimum\":0,\"maximum\":150}"));
    var c_b1 = compiled_compile(schema_new("object", ps_b1, vec_new()));
    assert_eq(vec_len(compiled_validate(c_b1, "{\"age\":0}")), 0, "exact min ok");
    assert_eq(vec_len(compiled_validate(c_b1, "{\"age\":150}")), 0, "exact max ok");
    assert_eq(vec_len(compiled_validate(c_b1, "{\"age\":-1}")), 1, "min - 1 fails");
    assert_eq(vec_len(compiled_validate(c_b1, "{\"age\":151}")), 1, "max + 1 fails");

    # ---------------- review punch: codec pure-notification batch -> 0 ----------------
    var pure_notifs = codec_process_message(
    "[{\"jsonrpc\":\"2.0\",\"method\":\"a\"},{\"jsonrpc\":\"2.0\",\"method\":\"b\"},{\"jsonrpc\":\"2.0\",\"method\":\"c\"}]",
    bd, 0);
    assert_eq(pure_notifs, 0, "pure-notification batch returns 0");

    # ================================================================
    # v1.1.0: audit + events + dispatcher wire-up
    # ================================================================

    # ---------------- events: topic constants ----------------
    assert(streq(TOPIC_TOOL_COMPLETED(), "bote/tool/completed") == 1, "topic completed");
    assert(streq(TOPIC_TOOL_FAILED(), "bote/tool/failed") == 1, "topic failed");
    assert(streq(TOPIC_TOOL_REGISTERED(), "bote/tool/registered") == 1, "topic registered");
    assert(streq(TOPIC_TOOL_DEREGISTERED(), "bote/tool/deregistered") == 1, "topic deregistered");
    assert(streq(TOPIC_TOOL_DEPRECATED(), "bote/tool/deprecated") == 1, "topic deprecated");
    assert(streq(TOPIC_TOOL_ANNOUNCE(), "bote/tool/announce") == 1, "topic announce");

    # ---------------- events: noop sink is safe ----------------
    var noop_ev = event_sink_noop();
    event_sink_publish(noop_ev, "any/topic", "{}");
    event_sink_publish(0, "any/topic", "{}");
    assert(noop_ev != 0, "noop sink is allocated");
    assert_eq(event_sink_publish_fp(noop_ev), 0, "noop fp is 0");

    # ---------------- events: real sink invocation ----------------
    _ev_reset();
    var live_ev = event_sink_new(&test_event_publish, 0);
    event_sink_publish(live_ev, "topic.a", "{\"k\":1}");
    event_sink_publish(live_ev, "topic.b", "[1,2]");
    assert_eq(vec_len(_ev_topics), 2, "two events");
    assert(streq(vec_get(_ev_topics, 0), "topic.a") == 1, "first topic");
    assert(streq(vec_get(_ev_payloads, 1), "[1,2]") == 1, "second payload");

    # ---------------- audit: ToolCallEvent + JSON ----------------
    var ev_ok = tool_call_event_new("echo", 42, 1, 0, "agent-1");
    assert(streq(tool_call_event_tool_name(ev_ok), "echo") == 1, "ev tool_name");
    assert_eq(tool_call_event_duration_ms(ev_ok), 42, "ev duration");
    assert_eq(tool_call_event_success(ev_ok), 1, "ev success");
    var json_ok = tool_call_event_to_json(ev_ok);
    assert(streq(json_ok, "{\"tool_name\":\"echo\",\"duration_ms\":42,\"success\":true,\"caller_id\":\"agent-1\"}") == 1, "ev json ok");

    var ev_fail = tool_call_event_new("broken", 5, 0, "handler crashed", 0);
    var json_fail = tool_call_event_to_json(ev_fail);
    assert(streq(json_fail, "{\"tool_name\":\"broken\",\"duration_ms\":5,\"success\":false,\"error\":\"handler crashed\"}") == 1, "ev json fail");
    # error and caller_id both omitted when 0
    var ev_min = tool_call_event_new("plain", 1, 1, 0, 0);
    var json_min = tool_call_event_to_json(ev_min);
    assert(streq(json_min, "{\"tool_name\":\"plain\",\"duration_ms\":1,\"success\":true}") == 1, "ev json min");

    # ---------------- audit: noop sink is safe ----------------
    audit_sink_log(0, ev_ok);
    audit_sink_log(audit_sink_noop(), ev_ok);

    # ---------------- audit: real sink invocation ----------------
    _audit_reset();
    var alive = audit_sink_new(&test_audit_log, 0);
    audit_sink_log(alive, ev_ok);
    audit_sink_log(alive, ev_fail);
    assert_eq(vec_len(_audit_events), 2, "audit got 2");
    assert(streq(tool_call_event_tool_name(vec_get(_audit_events, 0)), "echo") == 1, "audit[0] echo");
    assert(streq(tool_call_event_tool_name(vec_get(_audit_events, 1)), "broken") == 1, "audit[1] broken");

    # ---------------- dispatcher: wire-up audit + events ----------------
    _ev_reset();
    _audit_reset();
    var wreg = tool_registry_new();
    registry_register(wreg, tool_def_new("svc_echo", "echo", schema_new("object", 0, vec_new())));
    var wd = dispatcher_new(wreg);
    dispatcher_handle(wd, "svc_echo", &h_echo);
    dispatcher_set_audit(wd, audit_sink_new(&test_audit_log, 0));
    dispatcher_set_events(wd, event_sink_new(&test_event_publish, 0));

    # tools/call success → audit + bote/tool/completed
    var w_call = req_with_params(req_new("1", "tools/call"),
    "{\"name\":\"svc_echo\",\"arguments\":{\"k\":\"v\"},\"caller_id\":\"agent-x\"}");
    var w_resp = dispatcher_dispatch(wd, w_call, 0);
    assert(w_resp != 0, "wire call returns response");
    assert_eq(vec_len(_audit_events), 1, "1 audit event");
    var w_ev = vec_get(_audit_events, 0);
    assert(streq(tool_call_event_tool_name(w_ev), "svc_echo") == 1, "wire audit name");
    assert_eq(tool_call_event_success(w_ev), 1, "wire audit success");
    assert(streq(tool_call_event_caller_id(w_ev), "agent-x") == 1, "wire caller_id");
    assert_eq(vec_len(_ev_topics), 1, "1 event topic");
    assert(streq(vec_get(_ev_topics, 0), "bote/tool/completed") == 1, "completed topic");

    # tools/call where the tool is registered but its handler isn't
    # → audit + bote/tool/failed (validate_params catches truly-unknown names
    #   earlier without emitting; that path mirrors the Rust behavior).
    _ev_reset();
    _audit_reset();
    registry_register(wreg, tool_def_new("svc_unhandled", "no handler",
    schema_new("object", 0, vec_new())));
    var w_unk = dispatcher_dispatch(wd, req_with_params(req_new("2", "tools/call"),
    "{\"name\":\"svc_unhandled\",\"arguments\":{}}"), 0);
    assert(resp_error_obj(w_unk) != 0, "unhandled tool returns error");
    assert_eq(vec_len(_audit_events), 1, "fail logged");
    assert_eq(tool_call_event_success(vec_get(_audit_events, 0)), 0, "fail success=0");
    assert_eq(vec_len(_ev_topics), 1, "fail emitted");
    assert(streq(vec_get(_ev_topics, 0), "bote/tool/failed") == 1, "failed topic");

    # And: truly-unknown tool name (caught by validate_params) does NOT emit
    # — matches Rust which only audits at the handler-lookup boundary.
    _ev_reset();
    _audit_reset();
    var w_miss = dispatcher_dispatch(wd, req_with_params(req_new("2b", "tools/call"),
    "{\"name\":\"never_existed\",\"arguments\":{}}"), 0);
    assert(resp_error_obj(w_miss) != 0, "missing tool returns error");
    assert_eq(vec_len(_audit_events), 1, "validate-stage err: audited (3.4.15; a refused call left no trace)");
    assert_eq(vec_len(_ev_topics), 1, "validate-stage err: published as failed");

    # 3.4.5: a handler that returns nothing is a failed call. It answers a
    # result with isError (not "result":null), and is audited and published
    # as a failure, not a success.
    _ev_reset();
    _audit_reset();
    registry_register(wreg, tool_def_new("svc_none", "returns nothing", schema_new("object", 0, vec_new())));
    dispatcher_handle(wd, "svc_none", &h_none_t);
    var w_none = dispatcher_dispatch(wd, req_with_params(req_new("2c", "tools/call"),
    "{\"name\":\"svc_none\",\"arguments\":{}}"), 0);
    var w_none_r = resp_result(w_none);
    if (w_none_r == 0) { w_none_r = ""; }
    assert(_lc_has(w_none_r, "\"isError\":true") == 1, "a handler returning 0 answers isError, not null");
    assert_eq(vec_len(_audit_events), 1, "...audited once");
    assert_eq(tool_call_event_success(vec_get(_audit_events, 0)), 0, "...as a failure");
    assert(_lc_has(vec_get(_ev_topics, 0), "bote/tool/failed") == 1, "...published on bote/tool/failed");

    # 3.4.8: a result carrying isError, and a result that is not JSON, are
    # failed calls for the audit and the event too.
    _ev_reset();
    _audit_reset();
    registry_register(wreg, tool_def_new("svc_iserr", "reports failure", schema_new("object", 0, vec_new())));
    dispatcher_handle(wd, "svc_iserr", &h_iserr_t);
    dispatcher_dispatch(wd, req_with_params(req_new("2d", "tools/call"), "{\"name\":\"svc_iserr\",\"arguments\":{}}"), 0);
    assert_eq(tool_call_event_success(vec_get(_audit_events, 0)), 0, "an isError result is audited as a failure");
    assert(_lc_has(vec_get(_ev_topics, 0), "bote/tool/failed") == 1, "...and published on bote/tool/failed");
    _ev_reset();
    _audit_reset();
    registry_register(wreg, tool_def_new("svc_badjson", "broken output", schema_new("object", 0, vec_new())));
    dispatcher_handle(wd, "svc_badjson", &h_badjson_t);
    var w_bj = dispatcher_dispatch(wd, req_with_params(req_new("2e", "tools/call"), "{\"name\":\"svc_badjson\",\"arguments\":{}}"), 0);
    var w_bj_r = resp_result(w_bj);
    if (w_bj_r == 0) { w_bj_r = ""; }
    assert(_lc_has(w_bj_r, "not valid JSON") == 1 && _lc_has(w_bj_r, "\"isError\":true") == 1 && _lc_has(w_bj_r, "oops") == 0,
      "a result that is not JSON becomes an isError result, and its bytes are not sent");
    assert_eq(tool_call_event_success(vec_get(_audit_events, 0)), 0, "...audited as a failure");

    # initialize + tools/list do NOT emit tool-call events
    _ev_reset();
    _audit_reset();
    dispatcher_dispatch(wd, req_new("3", "initialize"), 0);
    dispatcher_dispatch(wd, req_new("4", "tools/list"), 0);
    assert_eq(vec_len(_audit_events), 0, "init/list no audit");
    assert_eq(vec_len(_ev_topics), 0, "init/list no events");

    # ---------------- dispatcher: register/deregister emit topics ----------------
    _ev_reset();
    var ok_reg2 = dispatcher_register_tool(wd,
    tool_def_new("svc_dyn", "dyn", schema_new("object", 0, vec_new())), &h_echo);
    assert_eq(ok_reg2, 0, "dyn register ok");
    assert_eq(vec_len(_ev_topics), 1, "register emitted");
    assert(streq(vec_get(_ev_topics, 0), "bote/tool/registered") == 1, "registered topic");
    assert(streq(jsonx_get_str(vec_get(_ev_payloads, 0), "tool_name"), "svc_dyn") == 1, "register payload");

    _ev_reset();
    dispatcher_deregister_tool(wd, "svc_dyn");
    assert_eq(vec_len(_ev_topics), 1, "dereg emitted");
    assert(streq(vec_get(_ev_topics, 0), "bote/tool/deregistered") == 1, "deregistered topic");

    # ---------------- dispatcher: deprecated tool emits TOPIC_TOOL_DEPRECATED on call ----------------
    _ev_reset();
    _audit_reset();
    registry_register(wreg, tool_def_with_deprecated(
    tool_def_new("svc_old", "old", schema_new("object", 0, vec_new())),
    "use svc_new instead"));
    dispatcher_handle(wd, "svc_old", &h_echo);
    dispatcher_dispatch(wd, req_with_params(req_new("5", "tools/call"),
    "{\"name\":\"svc_old\",\"arguments\":{}}"), 0);
    # Expect: bote/tool/deprecated then bote/tool/completed
    assert_eq(vec_len(_ev_topics), 2, "two events on deprecated call");
    assert(streq(vec_get(_ev_topics, 0), "bote/tool/deprecated") == 1, "deprecated first");
    assert(streq(vec_get(_ev_topics, 1), "bote/tool/completed") == 1, "completed second");
    assert(streq(jsonx_get_str(vec_get(_ev_payloads, 0), "message"), "use svc_new instead") == 1, "deprecation message");

    # ---------------- dispatcher: noop sinks (default) don't break anything ----------------
    var bare = dispatcher_new(tool_registry_new());
    registry_register(dispatcher_registry(bare),
    tool_def_new("svc_bare", "bare", schema_new("object", 0, vec_new())));
    dispatcher_handle(bare, "svc_bare", &h_echo);
    var bare_resp = dispatcher_dispatch(bare, req_with_params(req_new("9", "tools/call"),
    "{\"name\":\"svc_bare\",\"arguments\":{\"x\":1}}"), 0);
    assert(bare_resp != 0, "bare dispatch still works");
    assert_eq(resp_error_obj(bare_resp), 0, "bare success no error");

    # ================================================================
    # v1.2.x: LibroAudit + MajraEvents adapter SHAPES
    # ================================================================
    # Live chain growth + pubsub deliver paths are exercised in the
    # standalone examples/audit_demo.cyr program (runs as a separate
    # binary because libro+majra+full-test cross-product trips a heap
    # heisenbug — see programs/README in v1.2.1).

    # ---------------- audit_libro: struct + accessors ----------------
    var la = libro_audit_new(99);
    assert_eq(libro_audit_chain(la), 99, "la chain stored");
    assert(streq(libro_audit_source(la), "bote") == 1, "la default source");
    assert_eq(libro_audit_agent_id(la), 0, "la default agent_id");
    libro_audit_with_source(la, "my-server");
    libro_audit_with_agent_id(la, "default-agent");
    assert(streq(libro_audit_source(la), "my-server") == 1, "custom source");
    assert(streq(libro_audit_agent_id(la), "default-agent") == 1, "configured agent_id");

    # ---------------- audit_libro: AuditSink wire-up shape ----------------
    var libro_sink = audit_sink_new(&libro_audit_log, la);
    assert(audit_sink_log_fp(libro_sink) != 0, "libro audit fp wired");
    assert_eq(audit_sink_ctx(libro_sink), la, "libro audit ctx is LibroAudit");
    # NB: live chain growth still triggers the v1.2.1 heap heisenbug here
    # despite the freed function-count budget — see CHANGELOG. Adapter
    # itself is correct (proved in isolated probes).

    # ---------------- events_majra: EventSink wire-up shape ----------------
    # (Streamable + WS tests moved to tests/bote_streamable.tcyr and
    # tests/bote_ws.tcyr in 2.7.2 — cyrius 5.10.x 2 MB cap fix.)
    var majra_fp = &majra_events_publish;
    assert(majra_fp != 0, "majra events fp addressable");
    var majra_sink = event_sink_new(majra_fp, 0);     # ctx=0 → adapter no-ops
    event_sink_publish(majra_sink, "any/topic", "{}");  # safe with ctx=0

    # v1.6.0: libro_tools tests live in tests/bote_libro_tools.tcyr
    # (splitting to stay under the cyrius 4.5.1 parser identifier-buffer cap).

    # v1.7.0: content-block tests live in tests/bote_content.tcyr
    # (splitting for the same cyrius 4.5.1 parser-cap reason).


    # ================================================================
    # 3.4.1 — tools/call builds the duration + event only for a live sink
    # ================================================================
    # Each sink is gated on its own: audit-only must still audit, events-only
    # must still publish, and a sink whose callback is null counts as absent.
    var sreg = tool_registry_new();
    registry_register(sreg, tool_def_new("svc_echo", "echo", schema_new("object", 0, vec_new())));
    registry_register(sreg, tool_def_new("svc_unhandled", "no handler", schema_new("object", 0, vec_new())));
    var s_call = req_with_params(req_new("1", "tools/call"), "{\"name\":\"svc_echo\",\"arguments\":{}}");
    var s_unh = req_with_params(req_new("2", "tools/call"), "{\"name\":\"svc_unhandled\",\"arguments\":{}}");

    var sd_a = dispatcher_new(sreg);
    dispatcher_handle(sd_a, "svc_echo", &h_echo);
    dispatcher_set_audit(sd_a, audit_sink_new(&test_audit_log, 0));
    _ev_reset(); _audit_reset();
    assert_eq(resp_error_obj(dispatcher_dispatch(sd_a, s_call, 0)), 0, "audit-only: call succeeds");
    assert_eq(vec_len(_audit_events), 1, "audit-only: success audited");
    assert_eq(vec_len(_ev_topics), 0, "audit-only: nothing published");
    dispatcher_dispatch(sd_a, s_unh, 0);
    assert_eq(vec_len(_audit_events), 2, "audit-only: unhandled tool audited");
    assert_eq(tool_call_event_success(vec_get(_audit_events, 1)), 0, "audit-only: unhandled success=0");

    var sd_e = dispatcher_new(sreg);
    dispatcher_handle(sd_e, "svc_echo", &h_echo);
    dispatcher_set_events(sd_e, event_sink_new(&test_event_publish, 0));
    _ev_reset(); _audit_reset();
    dispatcher_dispatch(sd_e, s_call, 0);
    dispatcher_dispatch(sd_e, s_unh, 0);
    assert_eq(vec_len(_ev_topics), 2, "events-only: success and failure published");
    assert(streq(vec_get(_ev_topics, 0), "bote/tool/completed") == 1, "events-only: completed topic");
    assert(streq(vec_get(_ev_topics, 1), "bote/tool/failed") == 1, "events-only: failed topic");
    assert_eq(vec_len(_audit_events), 0, "events-only: nothing audited");

    var sd_n = dispatcher_new(sreg);
    dispatcher_handle(sd_n, "svc_echo", &h_echo);
    dispatcher_set_audit(sd_n, audit_sink_new(0, 0));
    dispatcher_set_events(sd_n, event_sink_new(0, 0));
    _ev_reset(); _audit_reset();
    var sn_r = dispatcher_dispatch(sd_n, s_call, 0);
    assert_eq(resp_error_obj(sn_r), 0, "null-callback sinks: call succeeds");
    assert_eq(vec_len(_audit_events) + vec_len(_ev_topics), 0, "null-callback sinks: nothing called");
    assert(resp_error_obj(dispatcher_dispatch(sd_n, s_unh, 0)) != 0, "null-callback sinks: unhandled tool still errors");

    var sd_0 = dispatcher_new(sreg);
    dispatcher_handle(sd_0, "svc_echo", &h_echo);
    var s0_r = dispatcher_dispatch(sd_0, s_call, 0);
    assert_eq(resp_error_obj(s0_r), 0, "no sinks: call succeeds");
    assert(resp_result(s0_r) != 0, "no sinks: result present");
    var s0_u = dispatcher_dispatch(sd_0, s_unh, 0);
    assert_eq(rpc_err_code(resp_error_obj(s0_u)), 0 - 32602, "no sinks: unhandled tool → tool-not-found code");

    # ================================================================
    # 3.4.0 — one DEBUG line per request, from codec_process_message
    # ================================================================
    var ld = dispatcher_new(tool_registry_new());
    _lc_begin();
    sakshi_set_level(SK_INFO);
    codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"ping\"}", ld, 0);
    assert_eq(_lc_count, 0, "at INFO a request logs nothing");
    sakshi_set_level(SK_DEBUG);
    codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"ping\"}", ld, 0);
    assert_eq(_lc_count, 1, "at DEBUG a request logs one line");
    assert_eq(_lc_level, SK_DEBUG, "the request line is DEBUG");
    assert(_lc_has(_lc_buf, "request method=ping id=7 status=ok us=") == 1, "the line names method, id, status and time");
    codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"no/such\"}", ld, 0);
    assert(_lc_has(_lc_buf, "method=no/such id=8 status=error code=-32601") == 1, "an unknown method logs status=error code=-32601");
    codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"tools/call\",\"params\":{\"name\":\"nope\",\"arguments\":{\"secret\":\"zzTOPzz\"}}}", ld, 0);
    assert(_lc_has(_lc_buf, "method=tools/call id=9 tool=nope status=error") == 1, "tools/call names the tool");
    assert_eq(_lc_has(_lc_buf, "zzTOPzz"), 0, "tool arguments never reach the request line");
    # A method is decoded (3.4.15), so a JSON-escaped \n is a real LF by the time
    # it is logged, and logfmt escapes that as it does a raw one.
    codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":10,\"method\":\"x\\n[0] [ERROR] forged\"}", ld, 0);
    assert(_lc_has(_lc_buf, "method=\"x\\n[0] [ERROR] forged\"") == 1, "a JSON-escaped newline stays on one line");
    # The raw vector: a RAW LF inside a string. Through 3.4.4 bote's parser
    # accepted it and the byte reached the logger. Since 3.4.5 the message
    # is syntax-checked first, so it is a parse error and never dispatched.
    var rawreq = alloc(96);
    var rq1 = "{\"jsonrpc\":\"2.0\",\"id\":11,\"method\":\"y";
    var rq1n = strlen(rq1);
    memcpy(rawreq, rq1, rq1n);
    store8(rawreq + rq1n, 10);
    var rq2 = "[0] [ERROR] forged\"}";
    memcpy(rawreq + rq1n + 1, rq2, strlen(rq2));
    store8(rawreq + rq1n + 1 + strlen(rq2), 0);
    store8(_lc_buf, 0);
    var rawresp = codec_process_message(rawreq, ld, 0);
    assert(_lc_has(rawresp, "\"code\":-32700") == 1, "a raw LF inside a JSON string is a parse error (3.4.5)");
    assert_eq(_lc_has(_lc_buf, "forged"), 0, "...and logs no request line");
    # The logger's own escaping still holds for a method that carries the
    # byte: it must come out as the two characters \n, leaving one line.
    var rawm = alloc(32);
    store8(rawm, 121);
    store8(rawm + 1, 10);
    memcpy(rawm + 2, "[0] [ERROR] forged", 18);
    store8(rawm + 20, 0);
    _cdc_log_request(req_new("11", rawm), 0, clock_now_ns());
    assert(_lc_has(_lc_buf, "method=\"y\\n[0] [ERROR] forged\"") == 1, "a raw LF in a method name is logged as \\n");
    var lfs = 0;
    var li = 0;
    while (load8(_lc_buf + li) != 0) { if (load8(_lc_buf + li) == 10) { lfs = lfs + 1; } li = li + 1; }
    assert_eq(lfs, 0, "the request line holds no raw LF");
    _lc_begin();
    sakshi_set_level(SK_DEBUG);
    codec_process_message("{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}", ld, 0);
    assert(_lc_has(_lc_buf, "status=notification") == 1, "a notification logs status=notification");
    _lc_end();
    sakshi_set_level(SK_INFO);

    # ---------------- conn: a failed serve says why (3.4.12) ----------------
    assert(streq(bote_conn_serve_step_name(SANDHI_SERVER_FAIL_CONFIG), "config") == 1, "serve: step name config");
    assert(streq(bote_conn_serve_step_name(SANDHI_SERVER_FAIL_ALLOC), "alloc") == 1, "serve: step name alloc");
    assert(streq(bote_conn_serve_step_name(SANDHI_SERVER_FAIL_SOCKET), "socket") == 1, "serve: step name socket");
    assert(streq(bote_conn_serve_step_name(SANDHI_SERVER_FAIL_BIND), "bind") == 1, "serve: step name bind");
    assert(streq(bote_conn_serve_step_name(SANDHI_SERVER_FAIL_LISTEN), "listen") == 1, "serve: step name listen");
    assert(streq(bote_conn_serve_step_name(SANDHI_SERVER_FAIL_ACCEPT), "accept") == 1, "serve: step name accept");
    assert(streq(bote_conn_serve_step_name(SANDHI_SERVER_FAIL_THREAD), "thread") == 1, "serve: step name thread");
    assert(streq(bote_conn_serve_step_name(SANDHI_SERVER_FAIL_NONE), "unknown") == 1, "serve: nothing recorded is unknown");

    # bote_conn_serve moved the transports from no options struct to a new one.
    # sandhi's serve loop reads these four, so a new struct must read as none.
    var so = sandhi_server_options_new();
    assert_eq(sandhi_server_options_get_idle_ms(so), sandhi_server_options_get_idle_ms(0), "serve: a new options struct has the idle budget of none");
    assert_eq(sandhi_server_options_get_request_ms(so), sandhi_server_options_get_request_ms(0), "serve: ...the request budget of none");
    assert_eq(sandhi_server_options_get_max_request(so), sandhi_server_options_get_max_request(0), "serve: ...the request cap of none");
    assert_eq(sandhi_server_options_get_stop_flag(so), 0, "serve: ...and no stop flag");

    # What each recorded failure logs. sandhi's record is set directly: socket
    # and listen failures cannot be provoked on demand.
    _lc_begin();
    _sandhi_server_set_failure(so, SANDHI_SERVER_FAIL_SOCKET, 24);
    bote_conn_log_serve_failure("http", 8390, so);
    assert(_lc_has(_lc_buf, "step=socket") == 1 && _lc_has(_lc_buf, "errno=24") == 1, "serve: a socket failure logs the step and errno");
    assert_eq(_lc_has(_lc_buf, "cause="), 0, "serve: ...and no cause, which is for a port in use");
    _sandhi_server_set_failure(so, SANDHI_SERVER_FAIL_BIND, 13);
    bote_conn_log_serve_failure("http", 80, so);
    assert(_lc_has(_lc_buf, "step=bind") == 1 && _lc_has(_lc_buf, "errno=13") == 1, "serve: another bind errno is logged");
    assert_eq(_lc_has(_lc_buf, "cause="), 0, "serve: ...and is not called a port in use");
    _sandhi_server_set_failure(so, SANDHI_SERVER_FAIL_LISTEN, BOTE_ERRNO_EADDRINUSE);
    bote_conn_log_serve_failure("http", 8390, so);
    assert_eq(_lc_has(_lc_buf, "cause="), 0, "serve: the same errno at another step is not a port in use");
    _sandhi_server_set_failure(so, SANDHI_SERVER_FAIL_ALLOC, 0);
    bote_conn_log_serve_failure("http", 8390, so);
    assert(_lc_has(_lc_buf, "step=alloc") == 1, "serve: an alloc failure logs its step");
    assert_eq(_lc_has(_lc_buf, "errno="), 0, "serve: ...with no errno, since it has none");
    bote_conn_log_serve_failure("http", 8390, 0);
    assert(_lc_has(_lc_buf, "step=unknown") == 1, "serve: no options struct logs step=unknown");
    _lc_end();

    # ---------------- the request arena (3.4.15) ----------------
    var ra_reg = tool_registry_new();
    var ra_d = dispatcher_new(ra_reg);
    var ra_req = vec_new();
    vec_push(ra_req, "a");
    var ra_props = vec_new();
    vec_push(ra_props, schema_prop_new("a", "{\"type\":\"integer\"}"));
    registry_register(ra_reg, tool_def_new("ra_int", "a", schema_new("object", ra_props, ra_req)));
    registry_register(ra_reg, tool_def_new("ra_keep", "a", schema_new("object", 0, vec_new())));
    dispatcher_handle(ra_d, "ra_int", &_ra_keep_h);
    dispatcher_handle(ra_d, "ra_keep", &_ra_keep_h);
    var ra_big = _ra_big_args(60000);
    var ra_n = 200;
    assert_eq(_ra_heap_per_msg("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"}", ra_d, ra_n), 0, "arena: ping leaves no heap");
    assert_eq(_ra_heap_per_msg("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}", ra_d, ra_n), 0, "arena: initialize leaves no heap");
    assert_eq(_ra_heap_per_msg("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}", ra_d, ra_n), 0, "arena: tools/list leaves no heap");
    assert_eq(_ra_heap_per_msg("not json", ra_d, ra_n), 0, "arena: a parse error leaves no heap");
    assert_eq(_ra_heap_per_msg("[{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"},{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"ping\"}]", ra_d, ra_n), 0, "arena: a batch leaves no heap");
    assert_eq(_ra_heap_per_msg("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"no/such\"}", ra_d, ra_n), 0, "arena: an unknown method leaves no heap");
    # The refusals that used to retain a whole message, each with 60 KB of arguments.
    assert_eq(_ra_heap_per_msg(_ra_call("no_such_tool", ra_big), ra_d, 50), 0, "arena: 60 KB of arguments to an unknown tool leaves no heap");
    assert_eq(_ra_heap_per_msg(_ra_call("ra_int", ra_big), ra_d, 50), 0, "arena: 60 KB failing validation leaves no heap");
    assert_eq(_ra_heap_per_msg(_ra_call("ra_int", "[1]"), ra_d, ra_n), 0, "arena: non-object arguments leave no heap");

    # What a client names and bote refuses, on the paths the binary serves.
    var ra_pargs = vec_new();
    vec_push(ra_pargs, prompt_arg_new("must", "required", 1));
    dispatcher_register_prompt(ra_d, prompt_def_new("ra_prompt", "p", ra_pargs), &_ra_keep_prompt);
    dispatcher_register_resource(ra_d, resource_def_new("ra://doc", "doc", 0, 0), &_ra_keep_uri);
    assert_eq(_ra_heap_per_msg(_ra_fill("tools/list", "{\"cursor\":\"", 100, "\"}"), ra_d, ra_n), 0, "arena: an invalid cursor leaves no heap");
    assert_eq(_ra_heap_per_msg(_ra_fill("prompts/get", "{\"name\":\"", 60000, "\"}"), ra_d, 50), 0, "arena: 60 KB naming no prompt leaves no heap");
    assert_eq(_ra_heap_per_msg(_ra_fill("prompts/get", "{\"name\":\"ra_prompt\",\"arguments\":[\"", 60000, "\"]}"), ra_d, 50), 0, "arena: a prompt's non-object arguments leave no heap");
    assert_eq(_ra_heap_per_msg(_ra_fill("prompts/get", "{\"name\":\"ra_prompt\",\"arguments\":{\"other\":\"", 60000, "\"}}"), ra_d, 50), 0, "arena: a prompt missing an argument leaves no heap");
    assert_eq(_ra_heap_per_msg(_ra_fill("resources/read", "{\"uri\":\"", 60000, "\"}"), ra_d, 50), 0, "arena: 60 KB naming no resource leaves no heap");
    assert_eq(_ra_heap_per_msg(_ra_fill_of("resources/read", "{\"uri\":\"", "\\u0001", 10000, "\"}"), ra_d, 50), 0, "arena: a uri of control bytes, six times as long escaped, leaves no heap");
    # 3.7.0: messages that each need a little more of the arena than the one before.
    # lib/alloc.cyr's growable arena kept a chunk for every one of them: 300 refused
    # resources/read calls, the URI growing from 12 KB to 42 KB, kept 105 MB. The rows
    # above have grown this arena already, so these start past the largest of them: a
    # 62 KB URI, whose error reserves six times that for escaping, and on to 92 KB.
    var ra_ramp = vec_new();
    var ra_ri = 0;
    while (ra_ri < 150) {
        vec_push(ra_ramp, _ra_fill("resources/read", "{\"uri\":\"", 62000 + ra_ri * 200, "\"}"));
        ra_ri = ra_ri + 1;
    }
    var ra_ramp_at = alloc_used();
    ra_ri = 0;
    while (ra_ri < 150) {
        codec_process_message_a(bote_req_begin(), vec_get(ra_ramp, ra_ri), ra_d, 0);
        ra_ri = ra_ri + 1;
    }
    # bote's arena keeps 2.9 MB here, a chunk for each size the largest needs; the stdlib's
    # kept a chunk a message, about 2 MB each.
    assert(alloc_used() - ra_ramp_at < 8388608, "arena: 150 messages, each needing a little more, keep under 8 MB");
    ra_ramp_at = alloc_used();
    ra_ri = 0;
    while (ra_ri < 150) {
        codec_process_message_a(bote_req_begin(), vec_get(ra_ramp, ra_ri), ra_d, 0);
        ra_ri = ra_ri + 1;
    }
    assert_eq(alloc_used() - ra_ramp_at, 0, "arena: ...and the same 150 again keep nothing");

    # The arena itself (3.7.0).
    var ba = bote_req_arena_new();
    assert_eq(bote_req_arena_bytes(ba), 65536, "arena: one chunk to start");
    var ba1 = alloc_via(ba, 10);
    var ba2 = alloc_via(ba, 8);
    assert_eq(ba2 - ba1, 16, "arena: 8-byte aligned, one after another");
    assert_eq(alloc_via(ba, 0), 0, "arena: 0 bytes is none");
    assert_eq(alloc_via(ba, 0 - 8), 0, "arena: a negative size is none");
    assert_eq(alloc_via(ba, BOTE_REQ_ALLOC_MAX + 1), 0, "arena: past its bound is none");
    assert_eq(alloc_via(ba, 4611686018427387905), 0, "arena: ...and one whose doubling would overflow");
    memcpy(ba1, "abcdefghi", 10);
    var ba_re = realloc_via(ba, ba1, 10, 100);
    assert(ba_re != ba1 && memeq(ba_re, "abcdefghi", 10) == 1, "arena: a realloc copies what there was");
    assert(memeq(realloc_via(ba, ba1, 10, 4), "abcd", 4) == 1, "arena: ...and no more than it asked for");
    # A shrinking realloc at the very end of a chunk: copying more than it asked for
    # would run past the chunk, into the arena's own allocator, made right after it.
    var bc = bote_req_arena_new();
    alloc_via(bc, 65536 - 8);
    var bc_src = alloc(64);
    memset(bc_src, 65, 64);
    assert(memeq(realloc_via(bc, bc_src, 64, 8), "AAAAAAAA", 8) == 1, "arena: a realloc into a chunk's last bytes");
    assert(alloc_via(bc, 8) != 0, "arena: ...leaves the arena whole");
    alloc_via(ba, 60000);
    var ba_a = alloc_via(ba, 60000);
    assert_eq(bote_req_arena_bytes(ba), 131072, "arena: a full chunk adds one of the chunk size");
    var ba_big = alloc_via(ba, 200000);
    assert(ba_big != 0, "arena: a request past the chunk size");
    memset(ba_big, 7, 200000);
    assert_eq(bote_req_arena_bytes(ba), 131072 + 262144, "arena: ...gets a chunk of the size doubled until it fits");
    reset_via(ba);
    assert(alloc_via(ba, 10) == ba1, "arena: a reset starts over at the first chunk");
    alloc_via(ba, 65000);
    assert(alloc_via(ba, 100000) == ba_big, "arena: a request the next chunk cannot hold passes it, for the first one that can");
    assert(alloc_via(ba, 60000) != 0 && bote_req_arena_bytes(ba) == 393216, "arena: ...and adds nothing");
    reset_via(ba);
    alloc_via(ba, 65000);
    assert(alloc_via(ba, 60000) == ba_a, "arena: the chunks are taken in order");
    var bb = bote_req_arena_new();
    reset_via(bb);
    alloc_via(bb, 60000);
    alloc_via(bb, 70000);
    var bb_at = alloc_used();
    var bb_i = 0;
    while (bb_i < 200) {
        reset_via(bb);
        alloc_via(bb, 60000);
        alloc_via(bb, 70000 + bb_i * 512);
        bb_i = bb_i + 1;
    }
    assert(alloc_used() - bb_at <= 262160, "arena: 200 rounds each a little larger keep one chunk, not one a round");

    # The error serializer: what a client wrote is in the id and in the message.
    var ra_x = _ra_rep("x", 60000);
    var ra_qx = str_data(str_builder_build(_ra_quoted(ra_x)));
    assert_eq(_ra_heap_per_msg(_ra_msg("1", ra_x), ra_d, 50), 0, "arena: a 60 KB unknown method leaves no heap");
    assert_eq(_ra_heap_per_msg(_ra_msg(ra_qx, "no/such"), ra_d, 50), 0, "arena: a 60 KB string id on a refusal leaves no heap");
    assert_eq(_ra_heap_per_msg(_ra_fill("tools/call", "{\"name\":\"", 60000, "\"}"), ra_d, 50), 0, "arena: a 60 KB unknown tool name leaves no heap");
    assert_eq(_ra_heap_per_msg(_ra_fill("tools/call", "{\"name\":\"ra_keep\",\"version\":\"", 60000, "\"}"), ra_d, 50), 0, "arena: a 60 KB tool version leaves no heap");
    assert_eq(_ra_heap_per_msg(_ra_fill_of("tools/list", "{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"", "\\u0001", 10000, "\"}}"), ra_d, 50), 0, "arena: an unsupported version of control bytes leaves no heap");
    assert_eq(_ra_bridge_heap_per_msg(_ra_fill("tools/call", "{\"name\":\"", 60000, "\"}"), ra_d, 50), 0, "arena: a 60 KB unknown tool name through the bridge leaves no heap");
    assert_eq(_ra_bridge_heap_per_msg(_ra_fill_of("tools/call", "{\"name\":\"", "\\u0001", 10000, "\"}"), ra_d, 50), 0, "arena: a tool name of control bytes through the bridge leaves no heap");

    # A validator message quotes the client's value, and a tool error result escapes it.
    var ra_enum_props = vec_new();
    vec_push(ra_enum_props, schema_prop_new("mode", "{\"type\":\"string\",\"enum\":[\"a\",\"b\"]}"));
    registry_register(ra_reg, tool_def_new("ra_enum", "a", schema_new("object", ra_enum_props, vec_new())));
    dispatcher_handle(ra_d, "ra_enum", &_ra_keep_h);
    assert_eq(_ra_heap_per_msg(_ra_fill_of("tools/call", "{\"name\":\"ra_enum\",\"arguments\":{\"mode\":\"", "\\u0001", 10000, "\"}}"), ra_d, 50), 0, "arena: an enum value of control bytes leaves no heap");

    # A deprecated tool costs no more than a plain one, however long its notice.
    registry_register(ra_reg, tool_def_with_deprecated(tool_def_new("ra_oldd", "a", schema_new("object", 0, vec_new())), _ra_rep("d", 4000)));
    dispatcher_handle(ra_d, "ra_oldd", &_ra_keep_h);
    assert_eq(_ra_heap_per_msg(_ra_call("ra_oldd", "{}"), ra_d, ra_n) - _ra_heap_per_msg(_ra_call("ra_keep", "{}"), ra_d, ra_n), 0, "arena: a long deprecation notice leaves no heap");

    # What a prompt or resource handler keeps must survive the next message too.
    codec_process_message_a(bote_req_begin(), _ra_fill("prompts/get", "{\"name\":\"ra_prompt\",\"arguments\":{\"must\":\"", 4, "\"}}"), ra_d, 0);
    codec_process_message_a(bote_req_begin(), _ra_fill("resources/read", "{\"uri\":\"ra://doc", 0, "\"}"), ra_d, 0);
    codec_process_message_a(bote_req_begin(), _ra_fill("resources/read", "{\"uri\":\"", 200, "\"}"), ra_d, 0);
    assert(_ra_kept_prompt_args != 0 && streq(_ra_kept_prompt_args, "{\"must\":\"xxxx\"}") == 1, "arena: a prompt handler's kept args survive the next message");
    assert(_ra_kept_uri != 0 && streq(_ra_kept_uri, "ra://doc") == 1, "arena: a resource handler's kept uri survives the next message");

    # What a handler and a sink keep must survive the next message.
    var ra_call = _ra_call("ra_keep", "{\"mark\":\"kept-args\"}");
    dispatcher_set_audit(ra_d, audit_sink_new(&_ra_audit_keep, 0));
    codec_process_message_a(bote_req_begin(), ra_call, ra_d, 0);
    var ra_other = _ra_call("no_such_tool_with_a_long_name_that_overwrites", "{\"mark\":\"overwrite-the-arena-bytes\"}");
    codec_process_message_a(bote_req_begin(), ra_other, ra_d, 0);
    assert(_ra_kept_args != 0 && streq(_ra_kept_args, "{\"mark\":\"kept-args\"}") == 1, "arena: a handler's kept args survive the next message");
    assert(_ra_kept_event != 0 && streq(tool_call_event_tool_name(_ra_kept_event), "ra_keep") == 1, "arena: a sink's kept name survives the next message");
    assert(_ra_kept_event != 0 && streq(tool_call_event_caller_id(_ra_kept_event), "kept-caller") == 1, "arena: a sink's kept caller survives the next message");

    # Violations stop at the cap, on any message size.
    var ra_int_props = vec_new();
    vec_push(ra_int_props, schema_prop_new("xs", "{\"type\":\"array\",\"items\":{\"type\":\"integer\"}}"));
    var ra_ints = schema_new("object", ra_int_props, vec_new());
    var ra_cap_sb = str_builder_new();
    str_builder_add_cstr(ra_cap_sb, "{\"xs\":[\"a\"");
    var ra_ci = 0;
    while (ra_ci < 500) { str_builder_add_cstr(ra_cap_sb, ",\"a\""); ra_ci = ra_ci + 1; }
    str_builder_add_cstr(ra_cap_sb, "]}");
    var ra_v = compiled_validate(compiled_compile(ra_ints), str_data(str_builder_build(ra_cap_sb)));
    assert_eq(vec_len(ra_v), BOTE_SCH_MAX_VIOLATIONS, "arena: violations stop at the cap");

    # ---------------- keys and names mean what they decode to (3.4.15) ----------------
    assert_eq(jsonx_has("{\"c\\u006et\":1}", "cnt"), 1, "keys: an escaped key is the key it decodes to");
    assert(streq(jsonx_get_raw("{\"c\\u006et\":1}", "cnt"), "1") == 1, "keys: ...for a handler as for the validator");
    assert_eq(jsonx_has("{\"cnt\\u0000x\":1}", "cnt"), 0, "keys: a NUL does not end a key early");
    var kprops = vec_new();
    vec_push(kprops, schema_prop_new("cnt", "{\"type\":\"integer\"}"));
    var kcomp = compiled_compile(schema_new("object", kprops, vec_new()));
    assert_eq(vec_len(compiled_validate(kcomp, "{\"c\\u006et\":\"notanint\"}")), 1, "keys: an escaped key cannot skip the type check");
    var kd = dispatcher_new(tool_registry_new());
    assert(_lc_has(codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools\\/list\"}", kd, 0), "\"tools\":[") == 1, "method: `tools\\/list` is tools/list");
    assert(_lc_has(codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":2,\"m\\u0065thod\":\"p\\u0069ng\"}", kd, 0), "\"result\":{}") == 1, "method: an escaped key and value still answer");
    assert(_lc_has(codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"ping\\u0000x\"}", kd, 0), "-32601") == 1, "method: a NUL does not make it ping");
    assert(_lc_has(codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":7}", kd, 0), "\"id\":7") == 1, "id: read on a request with no method (JSON-RPC 5)");

    # ---------------- numbers: a bound means the value, not its truncation (3.4.15) ----------------
    var nprops = vec_new();
    vec_push(nprops, schema_prop_new("n", "{\"type\":\"number\",\"minimum\":0,\"maximum\":10}"));
    vec_push(nprops, schema_prop_new("i", "{\"type\":\"integer\"}"));
    var ncomp = compiled_compile(schema_new("object", nprops, vec_new()));
    assert_eq(vec_len(compiled_validate(ncomp, "{\"n\":-0.9}")), 1, "number: -0.9 is under a minimum of 0");
    assert_eq(vec_len(compiled_validate(ncomp, "{\"n\":10.9}")), 1, "number: 10.9 is over a maximum of 10");
    assert_eq(vec_len(compiled_validate(ncomp, "{\"n\":0.5}")), 0, "number: 0.5 is inside");
    assert_eq(vec_len(compiled_validate(ncomp, "{\"n\":10.0}")), 0, "number: 10.0 is the maximum");
    assert_eq(vec_len(compiled_validate(ncomp, "{\"i\":18446744073709551616}")), 1, "integer: past what can be held is refused");
    assert_eq(vec_len(compiled_validate(ncomp, "{\"i\":1e3}")), 0, "integer: 1e3 is an integer");

    # ---------------- what a schema says it refuses, it refuses (3.4.15) ----------------
    var fprops = vec_new();
    vec_push(fprops, schema_prop_new("forbid", "false"));
    var fcomp = compiled_compile(schema_new("object", fprops, vec_new()));
    assert_eq(vec_len(compiled_validate(fcomp, "{\"forbid\":1}")), 1, "schema: `false` allows nothing");
    assert_eq(vec_len(compiled_validate(fcomp, "{\"other\":1}")), 0, "schema: ...and is only about its own key");
    var wprops = vec_new();
    # (3.8.5) maxLength is judged now; pattern is not.
    vec_push(wprops, schema_prop_new("p", "{\"type\":\"string\",\"pattern\":\"^a\"}"));
    vec_push(wprops, schema_prop_new("q", "{\"type\":[\"string\",\"null\"]}"));
    var loose_reg = tool_registry_new();
    _lc_begin();
    registry_register(loose_reg, tool_def_new("loose", "l", schema_new("object", wprops, vec_new())));
    assert_eq(_lc_count, 2, "schema: one WARN per keyword it cannot enforce");
    assert_eq(_lc_level, SK_WARN, "schema: ...at WARN");
    assert(_lc_has(_lc_buf, "keyword=\"type array\"") == 1, "schema: ...naming the keyword");
    _lc_begin();
    registry_register(loose_reg, tool_def_new("tight", "t", schema_new("object", _strict_props(), vec_new())));
    assert_eq(_lc_count, 0, "schema: a schema it can enforce logs nothing");
    _lc_end();
    sakshi_set_level(SK_INFO);
    assert(dispatcher_register_tool(dispatcher_new(tool_registry_new()), 0, &_h_bad_json) != 0, "register: a null tool is refused, not a crash");
    var nd = dispatcher_new(tool_registry_new());
    assert(dispatcher_register_prompt(nd, prompt_def_new(0, 0, 0), &_h_bad_json) != 0, "register: a nameless prompt is refused");
    assert(dispatcher_register_resource(nd, 0, &_h_bad_json) != 0, "register: a null resource is refused");
    assert(_lc_has(codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"prompts/list\"}", nd, 0), "\"id\":1") == 1, "register: ...and prompts/list still answers");

    # ---------------- every handler's result is one line of JSON (3.4.15) ----------------
    var od = dispatcher_new(tool_registry_new());
    dispatcher_set_completion(od, &_h_bad_json);
    assert(_lc_has(codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"completion/complete\",\"params\":{}}", od, 0), "-32603") == 1, "output: invalid JSON from completion is -32603");
    assert(_lc_has(codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"completion/complete\",\"params\":[]}", od, 0), "-32602") == 1, "completion: non-object params are -32602");
    dispatcher_set_completion(od, &_h_pretty);
    var pretty = codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"completion/complete\",\"params\":{}}", od, 0);
    assert_eq(_lc_has(pretty, "\n"), 0, "output: a pretty-printing handler cannot split a response line");
    assert_eq(_lc_has(pretty, "\r"), 0, "output: ...with a CR either");
    registry_register(dispatcher_registry(od), tool_def_new("pretty", "p", schema_new("object", 0, vec_new())));
    dispatcher_handle(od, "pretty", &_h_pretty_call);
    assert_eq(_lc_has(codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"tools/call\",\"params\":{\"name\":\"pretty\"}}", od, 0), "\n"), 0, "output: ...nor a tool's");
    assert_eq(_dsp_one_line(default_alloc(), "{\"a\":1}"), "{\"a\":1}", "output: one line already is left alone");

    # ---------------- sessions expire, and a store has a size (3.4.15) ----------------
    var ex_store = session_store_new(1);
    var ex_sid = session_store_create(ex_store, "2025-11-25");
    sleep_ms(10);
    assert_eq(session_store_validate(ex_store, ex_sid), 0, "session: an expired one no longer validates");
    assert_eq(session_store_active_count(ex_store), 0, "session: ...and is gone");
    var cap_was = BOTE_SESSION_MAX;
    BOTE_SESSION_MAX = 2;
    var cap_store = session_store_new(1000000000000);
    assert(session_store_create(cap_store, "2025-11-25") != 0, "session: the first fits");
    assert(session_store_create(cap_store, "2025-11-25") != 0, "session: the second fits");
    assert_eq(session_store_create(cap_store, "2025-11-25"), 0, "session: a full store refuses");
    var cap2 = session_store_new(1);
    session_store_create(cap2, "2025-11-25");
    session_store_create(cap2, "2025-11-25");
    sleep_ms(10);
    assert(session_store_create(cap2, "2025-11-25") != 0, "session: a store full of expired ones makes room");
    BOTE_SESSION_MAX = cap_was;

    # The real path: a transport started on a port this test holds.
    var hfd_slot[8];
    var hport = _held_port(&hfd_slot);
    assert(hport != 0, "serve: a port to hold in 18400-18499");
    if (hport != 0) {
        var hport_txt = str_data(str_from_int(hport));
        var want_port = str_builder_new();
        str_builder_add_cstr(want_port, "port=");
        str_builder_add_cstr(want_port, hport_txt);
        var want_port_c = str_data(str_builder_build(want_port));

        _lc_begin();
        var hrc = transport_http_run(dispatcher_new(tool_registry_new()), http_config_new("/mcp", 0x0100007F, hport));
        assert_eq(hrc, 1, "serve: http on a held port returns 1");
        assert_eq(_lc_count, 1, "serve: ...logging one line");
        assert_eq(_lc_level, SK_ERROR, "serve: ...at ERROR");
        assert(_lc_has(_lc_buf, "serve failed") == 1 && _lc_has(_lc_buf, "transport=http") == 1, "serve: ...naming the transport");
        assert(_lc_has(_lc_buf, "step=bind") == 1, "serve: ...the step");
        assert(_lc_has(_lc_buf, want_port_c) == 1, "serve: ...the port");
        assert(_lc_has(_lc_buf, "errno=98") == 1, "serve: ...the errno");
        assert(_lc_has(_lc_buf, "cause=\"port in use\"") == 1, "serve: ...and what it means");

        _lc_begin();
        var brc = transport_bridge_run(dispatcher_new(tool_registry_new()), bridge_config_new(0x0100007F, hport));
        assert_eq(brc, 1, "serve: bridge on a held port returns 1");
        assert(_lc_has(_lc_buf, "transport=bridge") == 1 && _lc_has(_lc_buf, "step=bind") == 1, "serve: ...and says why");
        _lc_end();
        sock_close(load64(&hfd_slot));
    }
    sakshi_set_level(SK_INFO);

    # ---- 3.6.3: required scopes ----
    assert_eq(bote_scope_token_ok("a"), 1, "scope token: one byte");
    assert_eq(bote_scope_token_ok("files:read"), 1, "scope token: a usual one");
    assert_eq(bote_scope_token_ok("!#[]~"), 1, "scope token: both ends of what RFC 6749 allows");
    assert_eq(bote_scope_token_ok(0), 0, "scope token: none");
    assert_eq(bote_scope_token_ok(""), 0, "scope token: empty");
    assert_eq(bote_scope_token_ok("a b"), 0, "scope token: a space");
    assert_eq(bote_scope_token_ok("a\"b"), 0, "scope token: a quote");
    assert_eq(bote_scope_token_ok("a\\b"), 0, "scope token: a backslash");
    assert_eq(bote_scope_token_ok("a\tb"), 0, "scope token: a control byte");
    assert_eq(bote_scope_token_ok("\x7F"), 0, "scope token: DEL");
    assert_eq(bote_scope_token_ok("\xC3\xA9"), 0, "scope token: non-ASCII");
    var sc_bare = tool_def_new("sc_bare", "x", schema_new("object", 0, vec_new()));
    assert_eq(tool_def_required_scopes(sc_bare), 0, "scopes: none by default");
    var sc_bad = vec_new();
    vec_push(sc_bad, "good");
    vec_push(sc_bad, "not good");
    var sc_reg = tool_registry_new();
    var sc_badt = tool_def_with_required_scopes(tool_def_new("sc_badt", "x", schema_new("object", 0, vec_new())), sc_bad);
    assert(registry_check_tool_def(sc_badt) != 0, "scopes: a bad one is refused");
    assert(strstr(registry_check_tool_def(sc_badt), "required scope") >= 0, "scopes: ...and says why");
    assert(registry_register(sc_reg, sc_badt) != 0, "scopes: registration refuses it");
    assert_eq(registry_get(sc_reg, "sc_badt"), 0, "scopes: ...and holds nothing");
    var sc_two = vec_new();
    vec_push(sc_two, "s:a");
    vec_push(sc_two, "s:b");
    assert_eq(registry_register(sc_reg, tool_def_with_required_scopes(tool_def_new("sc_t", "x", schema_new("object", 0, vec_new())), sc_two)), 0, "scopes: good ones register");
    assert_eq(registry_register(sc_reg, tool_def_with_required_scopes(tool_def_new("sc_e", "x", schema_new("object", 0, vec_new())), vec_new())), 0, "scopes: an empty list registers");
    assert_eq(registry_register(sc_reg, sc_bare), 0, "scopes: so does none");
    assert_eq(vec_len(tool_def_required_scopes(registry_get(sc_reg, "sc_t"))), 2, "scopes: kept");
    var sc_d = dispatcher_new(sc_reg);
    dispatcher_handle(sc_d, "sc_t", &h_sc);
    dispatcher_handle(sc_d, "sc_e", &h_sc);
    dispatcher_handle(sc_d, "sc_bare", &h_sc);
    assert_eq(dispatcher_scopes_missing(sc_d, "sc_t", 0), 0, "missing: no claims, no check");
    assert_eq(dispatcher_scopes_missing(sc_d, "sc_nope", "s:a s:b"), 0, "missing: no such tool");
    assert_eq(dispatcher_scopes_missing(sc_d, "sc_bare", "x"), 0, "missing: a tool that asks for none");
    assert_eq(dispatcher_scopes_missing(sc_d, "sc_e", "x"), 0, "missing: an empty list asks for none");
    assert_eq(dispatcher_scopes_missing(sc_d, "sc_t", "s:a s:b"), sc_two, "missing: no checker is closed");
    var sc_n[8];
    store64(&sc_n, 0);
    dispatcher_set_scope_check(sc_d, &_sc_has, &sc_n);
    assert_eq(dispatcher_scopes_missing(sc_d, "sc_t", "s:a s:b"), 0, "missing: both held");
    assert_eq(load64(&sc_n), 2, "missing: each asked of the checker, with its ctx");
    assert_eq(dispatcher_scopes_missing(sc_d, "sc_t", "s:a"), sc_two, "missing: the first alone");
    assert_eq(dispatcher_scopes_missing(sc_d, "sc_t", "s:b"), sc_two, "missing: the second alone");
    dispatcher_set_scope_check(sc_d, &_sc_two, 0);
    assert_eq(dispatcher_scopes_missing(sc_d, "sc_t", "s:a s:b"), sc_two, "missing: only a 1 is held");
    dispatcher_set_scope_check(sc_d, &_sc_has, 0);

    _sc_runs = 0;
    var sc_r = _sc_call(sc_d, "sc_t", "", "s:a");
    assert(strstr(sc_r, "\"code\":-31403") >= 0, "refused: -31403");
    assert(strstr(sc_r, "insufficient scope for tool: sc_t") >= 0, "refused: names the tool");
    assert_eq(_sc_runs, 0, "refused: no handler");
    sc_r = _sc_call(sc_d, "sc_t", ",\"version\":\"9\",\"arguments\":5", "s:a");
    assert(strstr(sc_r, "\"code\":-31403") >= 0, "refused: ahead of the version and the arguments");
    sc_r = _sc_call(sc_d, "sc_t", "", "s:a s:b");
    assert(strstr(sc_r, "\"result\"") >= 0, "held: runs");
    assert_eq(_sc_runs, 1, "held: once");
    sc_r = _sc_call(sc_d, "sc_t", "", 0);
    assert(strstr(sc_r, "\"result\"") >= 0, "no claims: stdio runs it");
    sc_r = _sc_call(sc_d, "sc_nope", "", "x");
    assert(strstr(sc_r, "\"code\":-32602") >= 0, "refused: an unknown tool is still that");
    _ev_reset(); _audit_reset();
    dispatcher_set_audit(sc_d, audit_sink_new(&test_audit_log, 0));
    dispatcher_set_events(sc_d, event_sink_new(&test_event_publish, 0));
    _sc_call(sc_d, "sc_t", ",\"caller_id\":\"c1\"", "s:a");
    assert_eq(vec_len(_audit_events), 1, "refused: audited");
    assert(streq(tool_call_event_caller_id(vec_get(_audit_events, 0)), "c1") == 1, "refused: with its caller");
    assert_eq(tool_call_event_success(vec_get(_audit_events, 0)), 0, "refused: a failure");
    assert_eq(vec_len(_ev_topics), 1, "refused: published");
    assert(streq(vec_get(_ev_topics, 0), "bote/tool/failed") == 1, "refused: on the failed topic");
    dispatcher_set_audit(sc_d, 0);
    dispatcher_set_events(sc_d, 0);

    # A token the arena holds reaches the heap only for a handler, once for a message.
    var sc_al = bote_req_begin();
    var sc_tok = alloc_via(sc_al, 8);
    memcpy(sc_tok, "tok-abc", 8);
    assert_eq(bote_req_claims_kept(0), 0, "kept: no claims");
    assert_eq(bote_req_claims_kept("other"), "other", "kept: claims that are no token pass through");
    assert_eq(bote_req_claims_kept(sc_tok), sc_tok, "kept: nothing noted, nothing copied");
    bote_req_note_token(sc_tok);
    var sc_used = alloc_used();
    var sc_k1 = bote_req_claims_kept(sc_tok);
    assert(sc_k1 != sc_tok, "kept: a copy");
    assert(streq(sc_k1, "tok-abc") == 1, "kept: the same bytes");
    var sc_grew = alloc_used() - sc_used;
    assert_eq(bote_req_claims_kept(sc_tok), sc_k1, "kept: one copy a message");
    assert_eq(alloc_used() - sc_used, sc_grew, "kept: ...and no second allocation");
    bote_req_begin();
    assert(streq(sc_k1, "tok-abc") == 1, "kept: outlives the message");
    assert_eq(bote_req_claims_kept(sc_tok), sc_tok, "kept: forgotten when the next message starts");
    var sc_al2 = bote_req_begin();
    var sc_t1 = alloc_via(sc_al2, 8);
    memcpy(sc_t1, "tok-one", 8);
    var sc_t2 = alloc_via(sc_al2, 8);
    memcpy(sc_t2, "tok-two", 8);
    bote_req_note_token(sc_t1);
    bote_req_claims_kept(sc_t1);
    bote_req_note_token(sc_t2);
    assert(streq(bote_req_claims_kept(sc_t2), "tok-two") == 1, "kept: a second token is never handed the first one's copy");
    var kc_reg = tool_registry_new();
    registry_register(kc_reg, tool_def_new("kc_t", "x", schema_new("object", 0, vec_new())));
    var kc_d = dispatcher_new(kc_reg);
    dispatcher_handle(kc_d, "kc_t", &h_kc_tool);
    dispatcher_register_prompt(kc_d, prompt_def_new("kc_p", "x", vec_new()), &h_kc_prompt);
    dispatcher_register_resource(kc_d, resource_def_new("kc://r", "r", "R", "text/plain"), &h_kc_res);
    dispatcher_set_completion(kc_d, &h_kc_complete);
    assert_eq(_kc_copied(kc_d, "tools/call", "{\"name\":\"kc_t\"}"), 1, "kept: a tool gets a copy");
    assert_eq(_kc_copied(kc_d, "prompts/get", "{\"name\":\"kc_p\"}"), 1, "kept: a prompt gets a copy");
    assert_eq(_kc_copied(kc_d, "resources/read", "{\"uri\":\"kc://r\"}"), 1, "kept: a resource gets a copy");
    assert_eq(_kc_copied(kc_d, "completion/complete", "{\"ref\":{\"type\":\"ref/prompt\",\"name\":\"kc_p\"},\"argument\":{\"name\":\"a\",\"value\":\"b\"}}"), 1, "kept: a completion gets a copy");

    # ---------------- 3.6.6: scopes on prompts, resources and completions ----------------
    var sp_two = vec_new();
    vec_push(sp_two, "p:a");
    vec_push(sp_two, "p:b");
    var sp_bad = vec_new();
    vec_push(sp_bad, "not good");
    assert_eq(prompt_def_required_scopes(prompt_def_new("sp_x", "x", vec_new())), 0, "prompt scopes: none by default");
    assert_eq(resource_def_required_scopes(resource_def_new("sp://x", "x", "x", 0)), 0, "resource scopes: none by default");
    assert_eq(resource_template_required_scopes(resource_template_new("sp://x/{a}", "x", "x", 0)), 0, "template scopes: none by default");
    var sp_d = dispatcher_new(tool_registry_new());
    assert(dispatcher_register_prompt(sp_d, prompt_def_with_required_scopes(prompt_def_new("sp_bad", "x", vec_new()), sp_bad), &h_sp_prompt) != 0, "prompt scopes: a bad one is refused");
    assert_eq(dispatcher_prompts(sp_d), 0, "prompt scopes: ...and nothing is stood up");
    assert(dispatcher_register_resource(sp_d, resource_def_with_required_scopes(resource_def_new("sp://bad", "b", "B", 0), sp_bad), &h_sp_res) != 0, "resource scopes: a bad one is refused");
    assert(dispatcher_register_resource_template(sp_d, resource_template_with_required_scopes(resource_template_new("sp://bad/{a}", "b", "B", 0), sp_bad), &h_sp_res) != 0, "template scopes: a bad one is refused");
    assert_eq(dispatcher_resources(sp_d), 0, "resource scopes: ...and nothing is stood up");
    var sp_preg = prompt_registry_new();
    assert_eq(prompt_registry_register(sp_preg, prompt_def_with_required_scopes(prompt_def_new("sp_bad", "x", vec_new()), sp_bad), &h_sp_prompt), 0 - 1, "prompt registry: refuses a bad scope");
    assert_eq(prompt_registry_contains(sp_preg, "sp_bad"), 0, "prompt registry: ...and holds nothing");
    var sp_rreg = resource_registry_new();
    assert_eq(resource_registry_register(sp_rreg, resource_def_with_required_scopes(resource_def_new("sp://bad", "b", "B", 0), sp_bad), &h_sp_res), 0 - 1, "resource registry: refuses a bad scope");
    assert_eq(resource_registry_register_template(sp_rreg, resource_template_with_required_scopes(resource_template_new("sp://bad/{a}", "b", "B", 0), sp_bad), &h_sp_res), 0 - 1, "resource registry: ...a template's too");
    assert_eq(resource_registry_contains(sp_rreg, "sp://bad") + vec_len(resource_registry_templates(sp_rreg)), 0, "resource registry: ...and holds neither");
    var sp_args = vec_new();
    vec_push(sp_args, prompt_arg_new("who", "w", 1));
    assert_eq(dispatcher_register_prompt(sp_d, prompt_def_with_required_scopes(prompt_def_new("sp_p", "x", sp_args), sp_two), &h_sp_prompt), 0, "prompt scopes: good ones register");
    dispatcher_register_prompt(sp_d, prompt_def_new("sp_open", "x", vec_new()), &h_sp_prompt);
    assert_eq(dispatcher_register_resource(sp_d, resource_def_with_required_scopes(resource_def_new("sp://secret", "s", "S", 0), sp_two), &h_sp_res), 0, "resource scopes: good ones register");
    dispatcher_register_resource(sp_d, resource_def_new("sp://open", "o", "O", 0), &h_sp_res);
    dispatcher_register_resource(sp_d, resource_def_new("sp://t/exact", "e", "E", 0), &h_sp_res);
    # 3.7.0: listed, with no handler of its own, so the template serves it.
    dispatcher_register_resource(sp_d, resource_def_new("sp://t/nohandler", "n", "N", 0), 0);
    assert_eq(dispatcher_register_resource_template(sp_d, resource_template_with_required_scopes(resource_template_new("sp://t/{id}", "t", "T", 0), sp_two), &h_sp_res), 0, "template scopes: good ones register");
    dispatcher_register_resource_template(sp_d, resource_template_new("sp://o/{id}", "o", "O", 0), &h_sp_res);
    dispatcher_set_completion(sp_d, &h_sp_complete);

    # A null name or URI must never reach a map, whose hash puts it in slot 0: fill that
    # slot in both registries, so a missing guard crashes on every run, not one in four.
    var sp_zi = 0;
    while (sp_zi < 5000 && load64(load64(prompt_registry_entries(dispatcher_prompts(sp_d))) + 16) == 0) {
        dispatcher_register_prompt(sp_d, prompt_def_new(_sp_zname("zp", sp_zi), "Z", vec_new()), &h_sp_prompt);
        sp_zi = sp_zi + 1;
    }
    sp_zi = 0;
    while (sp_zi < 5000 && load64(load64(resource_registry_entries(dispatcher_resources(sp_d))) + 16) == 0) {
        dispatcher_register_resource(sp_d, resource_def_new(_sp_zname("zr://", sp_zi), "Z", "Z", 0), &h_sp_res);
        sp_zi = sp_zi + 1;
    }
    assert(load64(load64(prompt_registry_entries(dispatcher_prompts(sp_d))) + 16) != 0, "slot 0: filled in the prompts");
    assert(load64(load64(resource_registry_entries(dispatcher_resources(sp_d))) + 16) != 0, "slot 0: ...and the resources");
    assert_eq(dispatcher_prompt_scopes_missing(sp_d, "sp_p", "p:a"), sp_two, "prompt missing: no checker is closed");
    dispatcher_set_scope_check(sp_d, &_sc_has, 0);
    assert_eq(dispatcher_prompt_scopes_missing(sp_d, "sp_p", 0), 0, "prompt missing: no claims, no check");
    assert_eq(dispatcher_prompt_scopes_missing(sp_d, 0, "p:a"), 0, "prompt missing: no name");
    assert_eq(dispatcher_prompt_scopes_missing(sp_d, "sp_nope", "p:a"), 0, "prompt missing: no such prompt");
    assert_eq(dispatcher_prompt_scopes_missing(sp_d, "sp_open", "x"), 0, "prompt missing: one that asks for none");
    assert_eq(dispatcher_prompt_scopes_missing(sp_d, "sp_p", "p:a"), sp_two, "prompt missing: one of two");
    assert_eq(dispatcher_prompt_scopes_missing(sp_d, "sp_p", "p:a p:b"), 0, "prompt missing: both held");
    assert_eq(dispatcher_resource_scopes_missing(sp_d, "sp://secret", "x"), sp_two, "resource missing: an exact resource");
    assert_eq(dispatcher_resource_scopes_missing(sp_d, "sp://secret", "p:a p:b"), 0, "resource missing: ...held");
    assert_eq(dispatcher_resource_scopes_missing(sp_d, "sp://open", "x"), 0, "resource missing: one that asks for none");
    assert_eq(dispatcher_resource_scopes_missing(sp_d, "sp://t/9", "x"), sp_two, "resource missing: a URI its template serves");
    assert_eq(dispatcher_resource_scopes_missing(sp_d, "sp://t/exact", "x"), 0, "resource missing: an exact resource is judged, not the template it also matches");
    assert_eq(dispatcher_resource_scopes_missing(sp_d, "sp://t/nohandler", "x"), sp_two, "resource missing: a resource with no handler is judged by the template that serves it");
    assert(strstr(codec_process_message_a(bote_req_begin(), "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"resources/read\",\"params\":{\"uri\":\"sp://t/nohandler\"}}", sp_d, "x"), "-31403") >= 0, "resource missing: ...and its read refused");
    assert_eq(dispatcher_resource_scopes_missing(sp_d, "sp://o/9", "x"), 0, "resource missing: an open template");
    assert_eq(dispatcher_resource_scopes_missing(sp_d, "sp://none", "x"), 0, "resource missing: nothing serves it");
    assert_eq(dispatcher_resource_scopes_missing(sp_d, 0, "x"), 0, "resource missing: no URI");
    assert_eq(dispatcher_resource_scopes_missing(sp_d, "sp://secret", 0), 0, "resource missing: no claims");
    assert_eq(dispatcher_resource_scopes_missing(dispatcher_new(tool_registry_new()), "sp://secret", "x"), 0, "resource missing: no registry");
    var sp_bare = dispatcher_new(tool_registry_new());
    dispatcher_set_scope_check(sp_bare, &_sc_has, 0);
    assert_eq(dispatcher_prompt_scopes_missing(sp_bare, "sp_p", "x"), 0, "prompt missing: no registry");
    var sp_cba = bote_req_begin();
    assert_eq(dispatcher_completion_scopes_missing_a(sp_cba, sp_bare, "{\"ref\":{\"type\":\"ref/prompt\",\"name\":\"sp_p\"}}", "x"), 0, "completion missing: no prompts at all");
    assert_eq(dispatcher_completion_scopes_missing_a(sp_cba, sp_bare, "{\"ref\":{\"type\":\"ref/resource\",\"uri\":\"sp://t/{id}\"}}", "x"), 0, "completion missing: no resources at all");
    var sp_late = vec_new();
    vec_push(sp_late, "good");
    vec_push(sp_late, "not good");
    assert_eq(bote_scope_list_ok(sp_late), 0, "scope list: a bad one after a good one");
    assert_eq(bote_scope_list_ok(sp_two), 1, "scope list: two good ones");
    assert_eq(bote_scope_list_ok(0), 1, "scope list: none");
    assert_eq(bote_scope_list_ok(vec_new()), 1, "scope list: an empty one");
    assert(dispatcher_register_prompt(sp_bare, prompt_def_with_required_scopes(prompt_def_new("sp_late", "x", vec_new()), sp_late), &h_sp_prompt) != 0, "prompt scopes: a bad one after a good one is refused");

    _sp_runs = 0;
    var sp_r = codec_process_message(_sp_msg("prompts/get", "{\"name\":\"sp_p\",\"arguments\":{\"who\":\"me\"}}"), sp_d, "p:a");
    assert(strstr(sp_r, "\"code\":-31403") >= 0 && strstr(sp_r, "insufficient scope for prompt: sp_p") >= 0, "prompts/get: refused, named");
    assert_eq(_sp_runs, 0, "prompts/get: no handler");
    sp_r = codec_process_message(_sp_msg("prompts/get", "{\"name\":\"sp_p\"}"), sp_d, "p:a");
    assert(strstr(sp_r, "\"code\":-31403") >= 0, "prompts/get: refused ahead of a missing argument");
    sp_r = codec_process_message(_sp_msg("prompts/get", "{\"name\":\"sp_p\",\"arguments\":5}"), sp_d, "p:a");
    assert(strstr(sp_r, "\"code\":-31403") >= 0, "prompts/get: ...and of arguments that are no object");
    sp_r = codec_process_message(_sp_msg("prompts/get", "{\"name\":\"sp_p\",\"arguments\":{\"who\":\"me\"}}"), sp_d, "p:a p:b");
    assert(strstr(sp_r, "\"result\"") >= 0 && _sp_runs == 1, "prompts/get: held, served");
    sp_r = codec_process_message(_sp_msg("prompts/get", "{\"name\":\"sp_nope\"}"), sp_d, "p:a");
    assert(strstr(sp_r, "prompt not found") >= 0, "prompts/get: an unknown prompt is still that");
    sp_r = codec_process_message(_sp_msg("prompts/get", "{\"name\":\"sp_p\",\"arguments\":{\"who\":\"me\"}}"), sp_d, 0);
    assert(strstr(sp_r, "\"result\"") >= 0, "prompts/get: no claims, stdio, served");
    _sp_runs = 0;
    sp_r = codec_process_message(_sp_msg("resources/read", "{\"uri\":\"sp://secret\"}"), sp_d, "p:b");
    assert(strstr(sp_r, "\"code\":-31403") >= 0 && strstr(sp_r, "insufficient scope for resource: sp://secret") >= 0, "resources/read: refused, named");
    sp_r = codec_process_message(_sp_msg("resources/read", "{\"uri\":\"sp://t/42\"}"), sp_d, "p:b");
    assert(strstr(sp_r, "\"code\":-31403") >= 0, "resources/read: a template's URI refused");
    assert_eq(_sp_runs, 0, "resources/read: no handler");
    sp_r = codec_process_message(_sp_msg("resources/read", "{\"uri\":\"sp://t/exact\"}"), sp_d, "x");
    assert(strstr(sp_r, "\"result\"") >= 0, "resources/read: the exact resource that also matches is served");
    sp_r = codec_process_message(_sp_msg("resources/read", "{\"uri\":\"sp://t/42\"}"), sp_d, "p:a p:b");
    assert(strstr(sp_r, "\"result\"") >= 0, "resources/read: held, served");
    sp_r = codec_process_message(_sp_msg("resources/read", "{\"uri\":\"sp://none\"}"), sp_d, "x");
    assert(strstr(sp_r, "-32002") >= 0, "resources/read: nothing serves it, -32002 still");
    _sp_runs = 0;
    sp_r = codec_process_message(_sp_msg("completion/complete", "{\"ref\":{\"type\":\"ref/prompt\",\"name\":\"sp_p\"},\"argument\":{\"name\":\"who\",\"value\":\"m\"}}"), sp_d, "p:a");
    assert(strstr(sp_r, "\"code\":-31403") >= 0, "completion: a gated prompt's arguments refused");
    sp_r = codec_process_message(_sp_msg("completion/complete", "{\"ref\":{\"type\":\"ref/resource\",\"uri\":\"sp://t/{id}\"},\"argument\":{\"name\":\"id\",\"value\":\"4\"}}"), sp_d, "p:a");
    assert(strstr(sp_r, "\"code\":-31403") >= 0, "completion: a gated template, by its uriTemplate, refused");
    sp_r = codec_process_message(_sp_msg("completion/complete", "{\"ref\":{\"type\":\"ref/resource\",\"uri\":\"sp://t/4\"},\"argument\":{\"name\":\"id\",\"value\":\"4\"}}"), sp_d, "p:a");
    assert(strstr(sp_r, "\"code\":-31403") >= 0, "completion: ...or a URI it serves");
    sp_r = codec_process_message(_sp_msg("completion/complete", "{\"ref\":{\"type\":\"ref/resource\",\"uri\":\"sp://secret\"},\"argument\":{\"name\":\"a\",\"value\":\"b\"}}"), sp_d, "p:a");
    assert(strstr(sp_r, "\"code\":-31403") >= 0, "completion: ...or a gated resource");
    assert_eq(_sp_runs, 0, "completion: no handler for any of them");
    codec_process_message(_sp_msg("completion/complete", "{\"ref\":{\"type\":\"ref/prompt\",\"name\":\"sp_open\"},\"argument\":{\"name\":\"a\",\"value\":\"b\"}}"), sp_d, "x");
    codec_process_message(_sp_msg("completion/complete", "{\"ref\":{\"type\":\"ref/resource\",\"uri\":\"sp://o/{id}\"},\"argument\":{\"name\":\"id\",\"value\":\"b\"}}"), sp_d, "x");
    codec_process_message(_sp_msg("completion/complete", "{\"ref\":{\"type\":\"ref/prompt\",\"name\":\"sp_p\"},\"argument\":{\"name\":\"who\",\"value\":\"m\"}}"), sp_d, "p:a p:b");
    codec_process_message(_sp_msg("completion/complete", "{\"argument\":{\"name\":\"a\",\"value\":\"b\"}}"), sp_d, "x");
    codec_process_message(_sp_msg("completion/complete", "{\"ref\":{\"type\":\"ref/other\",\"name\":\"sp_p\"},\"argument\":{\"name\":\"a\",\"value\":\"b\"}}"), sp_d, "x");
    codec_process_message(_sp_msg("completion/complete", "{\"ref\":{\"name\":\"sp_p\"},\"argument\":{\"name\":\"a\",\"value\":\"b\"}}"), sp_d, "x");
    codec_process_message(_sp_msg("completion/complete", "{\"ref\":{\"type\":\"ref/prompt\",\"name\":\"sp_p\"},\"argument\":{\"name\":\"who\",\"value\":\"m\"}}"), sp_d, 0);
    codec_process_message(_sp_msg("completion/complete", "{\"ref\":{\"type\":\"ref/resource\",\"uri\":\"sp://t/{id}\"},\"argument\":{\"name\":\"id\",\"value\":\"m\"}}"), sp_d, 0);
    codec_process_message(_sp_msg("completion/complete", "{\"ref\":{\"type\":\"ref/other\",\"uri\":\"sp://t/{id}\"},\"argument\":{\"name\":\"id\",\"value\":\"m\"}}"), sp_d, "x");
    assert_eq(_sp_runs, 9, "completion: open ones, held ones, no ref, another kind of ref even with a gated uri, no kind, and stdio for a prompt and a template are served");
    # A uriTemplate names its own template, though an earlier one also matches the text.
    dispatcher_register_resource_template(sp_d, resource_template_new("sp://u/{a}", "ua", "UA", 0), &h_sp_res);
    dispatcher_register_resource_template(sp_d, resource_template_with_required_scopes(resource_template_new("sp://u/x{b}", "ub", "UB", 0), sp_two), &h_sp_res);
    sp_r = codec_process_message(_sp_msg("completion/complete", "{\"ref\":{\"type\":\"ref/resource\",\"uri\":\"sp://u/x{b}\"},\"argument\":{\"name\":\"b\",\"value\":\"v\"}}"), sp_d, "p:a");
    assert(strstr(sp_r, "\"code\":-31403") >= 0, "completion: the template a uriTemplate names, not the first that matches it");
    sp_r = codec_process_message(_sp_msg("resources/read", "{\"uri\":\"sp://u/xy\"}"), sp_d, "p:a");
    assert(strstr(sp_r, "\"result\"") >= 0, "resources/read: ...while a URI is the first template's to serve");
    sp_r = codec_process_message(_sp_msg("completion/complete", "{\"ref\":{\"type\":\"ref/prompt\"},\"argument\":{\"name\":\"a\",\"value\":\"b\"}}"), sp_d, "p:a");
    assert(strstr(sp_r, "\"result\"") >= 0, "completion: a prompt ref with no name names nothing gated");
    sp_r = codec_process_message(_sp_msg("completion/complete", "{\"ref\":{\"type\":\"ref/resource\"},\"argument\":{\"name\":\"a\",\"value\":\"b\"}}"), sp_d, "p:a");
    assert(strstr(sp_r, "\"result\"") >= 0, "completion: ...nor a resource ref with no URI");
    # A refusal keeps nothing, with a long value in each field a client writes.
    var sp_long = _ra_rep("x", 60000);
    var sp_lid = _cat3("{\"jsonrpc\":\"2.0\",\"id\":\"", sp_long, "\",\"method\":\"prompts/get\",\"params\":{\"name\":\"sp_p\",\"arguments\":{\"who\":\"");
    assert_eq(_sp_heap(_cat3(sp_lid, sp_long, "\"}}}"), sp_d, "p:a", 20), 0, "prompt refused heap: a long id and argument keep nothing");
    assert_eq(_sp_heap(_cat3("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"resources/read\",\"params\":{\"uri\":\"sp://t/", sp_long, "\"}}"), sp_d, "p:a", 20), 0, "resource refused heap: a long URI its template serves keeps nothing");
    assert_eq(_sp_heap(_cat3("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"resources/read\",\"params\":{\"uri\":\"sp://secret\",\"pad\":\"", sp_long, "\"}}"), sp_d, "p:a", 20), 0, "resource refused heap: long params keep nothing");
    assert_eq(_sp_heap(_cat3("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"completion/complete\",\"params\":{\"ref\":{\"type\":\"ref/resource\",\"uri\":\"sp://t/", sp_long, "\"},\"argument\":{\"name\":\"id\",\"value\":\"v\"}}}"), sp_d, "p:a", 20), 0, "completion refused heap: a long ref keeps nothing");
    assert_eq(_sp_heap(_cat3("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"completion/complete\",\"params\":{\"ref\":{\"type\":\"ref/prompt\",\"name\":\"sp_p\"},\"argument\":{\"name\":\"who\",\"value\":\"", sp_long, "\"}}}"), sp_d, "p:a", 20), 0, "completion refused heap: a long argument keeps nothing");

    return assert_summary();
}

var rc = main();
sys_exit(rc);
