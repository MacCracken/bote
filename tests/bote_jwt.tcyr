# bote_jwt.tcyr — unit tests for src/jwt.cyr (HS256 verifier).
#
# Same per-module pattern as bote_sandbox / bote_libro_tools / etc.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fnptr.cyr"
include "lib/freelist.cyr"
include "lib/thread.cyr"
include "lib/thread_local.cyr"  # sigil 3.7.14 TLS crypto_scratch — SIGILL guard
include "lib/sakshi.cyr"
include "lib/bayan.cyr"
include "lib/sigil.cyr"
include "lib/chrono.cyr"
include "lib/assert.cyr"

# 3.2.0: jwt.cyr reads `alg` and `exp` through jsonx's (buf, len)
# internals rather than a strlen-based cstr API, so jsonx must be
# included first — cyrius is single-pass.
include "src/jsonx.cyr"
include "src/jwt.cyr"

# ================================================================
# HS256 token minting — 3.2.0
# ================================================================
# Every token in this file used to be a hardcoded literal, which meant
# the `exp` cases (whose value has to move with the wall clock) and the
# alg-confusion case (which needs a VALID signature over a hostile
# header) could not be expressed at all. This mints them for real:
# base64url(header) . base64url(payload) . base64url(HMAC-SHA256(...)).
fn _mint_hs256(hdr_json, payload_json, key) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, base64url_encode(hdr_json, strlen(hdr_json)));
    str_builder_add_cstr(sb, ".");
    str_builder_add_cstr(sb, base64url_encode(payload_json, strlen(payload_json)));
    var signing_input = str_cstr(str_builder_build(sb));

    var mac = alloc(32);
    hmac_sha256(key, strlen(key), signing_input, strlen(signing_input), mac);

    var sb2 = str_builder_new();
    str_builder_add_cstr(sb2, signing_input);
    str_builder_add_cstr(sb2, ".");
    str_builder_add_cstr(sb2, base64url_encode(mac, 32));
    return str_cstr(str_builder_build(sb2));
}

# Build `{"sub":"a","exp":<secs>}` for a computed expiry.
fn _payload_with_exp(secs) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"sub\":\"a\",\"exp\":");
    str_builder_add_int(sb, secs);
    str_builder_add_cstr(sb, "}");
    return str_cstr(str_builder_build(sb));
}

fn main() {
    alloc_init();

    # ================================================================
    # base64url decode — RFC 4648 §10 vectors + URL-safety check
    # ================================================================
    var len_slot[8]; store64(&len_slot, 0);

    var d_foo = jwt_b64u_decode("Zm9v", 4, &len_slot);
    assert(d_foo != 0, "decode 'Zm9v' returns non-null");
    assert_eq(load64(&len_slot), 3, "decode 'Zm9v' length 3");
    assert(streq(d_foo, "foo") == 1, "decode 'Zm9v' = 'foo'");

    var d_fb = jwt_b64u_decode("Zm9vYmFy", 8, &len_slot);
    assert_eq(load64(&len_slot), 6, "decode 'Zm9vYmFy' length 6");
    assert(streq(d_fb, "foobar") == 1, "decode 'Zm9vYmFy' = 'foobar'");

    # JWT header from RFC 7515 §3.5 (URL-safe alphabet, no padding)
    var d_hdr = jwt_b64u_decode("eyJ0eXAiOiJKV1QiLA0KICJhbGciOiJIUzI1NiJ9", 40, &len_slot);
    assert(d_hdr != 0, "RFC 7515 header decodes");
    assert_eq(load64(&len_slot), 30, "RFC 7515 header length 30");

    # URL-safe characters: '-' (62) and '_' (63) accepted, '+' / '/' would
    # be rejected as 'invalid' by the table (they're not in _b64u_enc).
    var d_url = jwt_b64u_decode("-_4", 3, &len_slot);
    assert(d_url != 0, "URL-safe '-_4' decodes");

    # ================================================================
    # JWT verify — known-good token from a hand-computed HS256 sign
    # ================================================================
    # Header = {"alg":"HS256","typ":"JWT"} → eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9
    # Payload = {"sub":"1234567890","name":"John Doe","iat":1516239022}
    #         → eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ
    # Secret = "your-256-bit-secret"
    # Sig (HS256) → SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c
    # This is the canonical jwt.io example — should verify.
    var token = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c";
    var jwt_key = "your-256-bit-secret";
    assert_eq(jwt_verify_hs256(token, jwt_key, strlen(jwt_key)), 1, "jwt.io canonical token verifies");

    # Wrong secret rejects
    assert_eq(jwt_verify_hs256(token, "wrong-secret", 12), 0, "wrong secret rejects");

    # Tampered signature rejects — flip the FIRST sig char (S→T).
    # NB: tampering only the trailing chars can be a no-op after b64u
    # decode because the low bits drop in a 3-rem tail; flipping a high
    # byte produces a guaranteed-different decoded signature.
    var tampered = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.TflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c";
    assert_eq(jwt_verify_hs256(tampered, jwt_key, strlen(jwt_key)), 0, "tampered sig rejects");

    # Tampered payload (last char of payload changed) rejects — sig won't match
    var tamp_pl = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIzfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c";
    assert_eq(jwt_verify_hs256(tamp_pl, jwt_key, strlen(jwt_key)), 0, "tampered payload rejects");

    # Malformed: not enough segments
    assert_eq(jwt_verify_hs256("a.b", jwt_key, strlen(jwt_key)), 0, "two segments rejects");
    assert_eq(jwt_verify_hs256("just-a-string", jwt_key, strlen(jwt_key)), 0, "no dots rejects");

    # Null/empty inputs
    assert_eq(jwt_verify_hs256(0, jwt_key, strlen(jwt_key)), 0, "null token rejects");
    assert_eq(jwt_verify_hs256(token, 0, 0), 0, "null secret rejects");
    assert_eq(jwt_verify_hs256(token, jwt_key, 0), 0, "zero-len secret rejects");

    # Non-HS256 alg downgrade rejected — header with "alg":"none"
    # Header = {"alg":"none"} → eyJhbGciOiJub25lIn0
    #
    # NB (3.2.0): this literal has an EMPTY third segment, so it is
    # rejected structurally at the `dot2 >= tlen - 1` guard, several
    # checks before the header is ever decoded. It therefore does NOT
    # exercise the alg gate — it never did. Kept as a malformed-input
    # case; the real alg coverage is the minted token below.
    var none_token = "eyJhbGciOiJub25lIn0.eyJzdWIiOiIxIn0.";
    assert_eq(jwt_verify_hs256(none_token, jwt_key, strlen(jwt_key)), 0,
    "alg=none (empty sig segment) rejected structurally");

    # ================================================================
    # 3.2.0 — `alg` is an exact JSON field read, not a substring scan
    # ================================================================
    # Regression test for finding (2) of the 2026-07-30 issue. Through
    # 3.1.4 the alg check scanned the decoded header for the five bytes
    # "HS256" ANYWHERE, so this header satisfied it — the literal sits
    # inside the `kid` VALUE while `alg` actually says "none". Minted
    # with a correct HMAC so nothing else can reject it: this token
    # reaches the alg gate, and only the alg gate can turn it away.
    var confusion = _mint_hs256("{\"alg\":\"none\",\"kid\":\"HS256-2024\"}",
    "{\"sub\":\"a\"}", jwt_key);
    assert_eq(jwt_verify_hs256(confusion, jwt_key, strlen(jwt_key)), 0,
    "alg confusion: HS256 inside kid does not satisfy alg");

    # Control: the same mint with a real HS256 header verifies — proves
    # the assertion above fails on `alg`, not on a broken minter.
    var minted_ok = _mint_hs256("{\"alg\":\"HS256\",\"typ\":\"JWT\"}",
    "{\"sub\":\"a\"}", jwt_key);
    assert_eq(jwt_verify_hs256(minted_ok, jwt_key, strlen(jwt_key)), 1,
    "minted HS256 token verifies (minter control)");

    # `alg` must be a JSON string, and byte-exact. RFC 7515 §4.1.1 alg
    # values are case-sensitive.
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"hs256\"}", "{\"sub\":\"a\"}", jwt_key),
    jwt_key, strlen(jwt_key)), 0, "lowercase alg rejected (case-sensitive)");
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS2560\"}", "{\"sub\":\"a\"}", jwt_key),
    jwt_key, strlen(jwt_key)), 0, "alg longer than HS256 rejected");
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS25\"}", "{\"sub\":\"a\"}", jwt_key),
    jwt_key, strlen(jwt_key)), 0, "alg shorter than HS256 rejected");
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"typ\":\"JWT\"}", "{\"sub\":\"a\"}", jwt_key),
    jwt_key, strlen(jwt_key)), 0, "missing alg rejected");
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":256}", "{\"sub\":\"a\"}", jwt_key),
    jwt_key, strlen(jwt_key)), 0, "non-string alg rejected");

    # ================================================================
    # 3.2.0 — `exp` is enforced (RFC 7519 §4.1.4)
    # ================================================================
    # Finding (2) of the issue: the module header documented this check
    # since 2.2.0 and no such check existed, so a correctly signed but
    # arbitrarily expired token was accepted. All tokens below are
    # correctly signed — expiry is the ONLY thing that can reject them.
    var now = clock_epoch_secs();

    # Absent exp is legal (the claim is optional) — the canonical
    # jwt.io token above has only `iat`, and still verifies.
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS256\"}", "{\"sub\":\"a\"}", jwt_key),
    jwt_key, strlen(jwt_key)), 1, "absent exp accepted");

    # Future exp accepted.
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS256\"}", _payload_with_exp(now + 3600), jwt_key),
    jwt_key, strlen(jwt_key)), 1, "exp one hour in the future accepted");

    # Past exp rejected — the whole point.
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS256\"}", _payload_with_exp(now - 3600), jwt_key),
    jwt_key, strlen(jwt_key)), 0, "exp one hour in the past rejected");

    # Fixed historical exp (2018-01-18) — clock-independent.
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS256\"}", _payload_with_exp(1516239022), jwt_key),
    jwt_key, strlen(jwt_key)), 0, "long-expired token rejected");

    # exp == now is a reject: RFC 7519 requires now to be strictly
    # BEFORE exp. No leeway is granted.
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS256\"}", _payload_with_exp(now), jwt_key),
    jwt_key, strlen(jwt_key)), 0, "exp == now rejected (no leeway)");

    # Malformed exp must REJECT, not read as absent — folding
    # "unparseable" into "no expiry" would be the fail-open direction.
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS256\"}",
    "{\"sub\":\"a\",\"exp\":\"1785461260\"}", jwt_key), jwt_key, strlen(jwt_key)), 0,
    "string-typed exp rejected (NumericDate is a JSON number)");
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS256\"}",
    "{\"sub\":\"a\",\"exp\":null}", jwt_key), jwt_key, strlen(jwt_key)), 0,
    "null exp rejected");
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS256\"}",
    "{\"sub\":\"a\",\"exp\":true}", jwt_key), jwt_key, strlen(jwt_key)), 0,
    "boolean exp rejected");
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS256\"}",
    "{\"sub\":\"a\",\"exp\":1e9}", jwt_key), jwt_key, strlen(jwt_key)), 0,
    "exponent-notation exp rejected (str_to_int would read this as 19)");
    # 25 digits — would overflow i64 and wrap negative. Rejected on
    # purpose by the digit cap, not by accident via the wrap.
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS256\"}",
    "{\"sub\":\"a\",\"exp\":9999999999999999999999999}", jwt_key), jwt_key, strlen(jwt_key)), 0,
    "absurd 25-digit exp rejected (no i64 wrap)");

    # ---- claim readers, direct ----
    assert_eq(_jwt_parse_uint("1785461260", 0, 10), 1785461260, "parse_uint plain");
    assert_eq(_jwt_parse_uint("x", 0, 1), 0 - 1, "parse_uint non-digit -> -1");
    assert_eq(_jwt_parse_uint("", 0, 0), 0 - 1, "parse_uint empty span -> -1");
    assert_eq(_jwt_parse_uint("0", 0, 1), 0, "parse_uint zero is a real 0, not -1");
    assert_eq(_jwt_parse_uint("1234567890123456789", 0, 19), 0 - 1,
    "parse_uint 19 digits -> -1 (over the 18-digit cap)");
    assert_eq(_jwt_str_field_eq("{\"alg\":\"HS256\"}", 15, "alg", "HS256"), 1,
    "str_field_eq exact match");
    assert_eq(_jwt_str_field_eq("{\"alg\":\"none\",\"kid\":\"HS256\"}", 27, "alg", "HS256"), 0,
    "str_field_eq ignores a match in another field's value");
    # Unterminated string must not masquerade as a closed one.
    assert_eq(_jwt_str_field_eq("{\"alg\":\"HS256", 13, "alg", "HS256"), 0,
    "str_field_eq rejects unterminated string");

    # ================================================================
    # JwtSecret handle + validator adapter
    # ================================================================
    var sh = jwt_secret_new(jwt_key);
    assert(sh != 0, "secret handle allocates");
    assert(streq(jwt_secret_data(sh), jwt_key) == 1, "secret data accessor");
    assert_eq(jwt_secret_len(sh), 19, "secret len accessor");

    # Validator with the bearer-middleware signature returns the token
    # cstr (truthy "claims") on success.
    var claims_ok = auth_validator_jwt_hs256(token, sh);
    assert(claims_ok != 0, "validator returns claims on valid token");
    assert(streq(claims_ok, token) == 1, "claims = original token");

    # Wrong-secret handle → 0
    var bad_sh = jwt_secret_new("wrong-secret");
    assert_eq(auth_validator_jwt_hs256(token, bad_sh), 0, "validator rejects wrong-secret");

    # Null handle → 0 (no segfault)
    assert_eq(auth_validator_jwt_hs256(token, 0), 0, "validator null-handle safe");

    # ================================================================
    # Fn-pointer addressability (for plugging into auth_bearer_check)
    # ================================================================
    assert(&jwt_verify_hs256 != 0, "verify fp addressable");
    assert(&auth_validator_jwt_hs256 != 0, "validator fp addressable");
    assert(&jwt_secret_new != 0, "secret_new fp addressable");

    return assert_summary();
}

var rc = main();
syscall(SYS_EXIT, rc);
