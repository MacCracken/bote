# bote_jwt.tcyr — unit tests for src/jwt.cyr (HS256 verifier).
#
# Same per-module pattern as bote_sandbox / bote_libro_tools / etc.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fnptr.cyr"
include "lib/freelist.cyr"
include "lib/thread.cyr"
include "lib/thread_local.cyr"  # sigil 3.7.14 TLS crypto_scratch — SIGILL guard
include "lib/sakshi.cyr"
include "lib/bayan.cyr"
include "lib/sigil.cyr"
include "lib/chrono.cyr"
include "lib/assert.cyr"

# 3.2.0: jwt.cyr reads `alg` and `exp` through jsonx's (buf, len)
# internals rather than a strlen-based cstr API, so jsonx must be
# included first — cyrius is single-pass.
include "src/log.cyr"
include "src/error.cyr"
include "src/protocol.cyr"
include "src/jsonx.cyr"
include "src/jwt.cyr"
include "tests/fixtures/jwt_vectors.cyr"

# ================================================================
# HS256 token minting — 3.2.0
# ================================================================
# Every token in this file used to be a hardcoded literal, which meant
# the `exp` cases (whose value has to move with the wall clock) and the
# alg-confusion case (which needs a VALID signature over a hostile
# header) could not be expressed at all. This mints them for real:
# base64url(header) . base64url(payload) . base64url(HMAC-SHA256(...)).
fn _mint_hs256(hdr_json, payload_json, key) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, base64url_encode(hdr_json, strlen(hdr_json)));
    str_builder_add_cstr(sb, ".");
    str_builder_add_cstr(sb, base64url_encode(payload_json, strlen(payload_json)));
    var signing_input = str_cstr(str_builder_build(sb));

    var mac = alloc(32);
    hmac_sha256(key, strlen(key), signing_input, strlen(signing_input), mac);

    var sb2 = str_builder_new();
    str_builder_add_cstr(sb2, signing_input);
    str_builder_add_cstr(sb2, ".");
    str_builder_add_cstr(sb2, base64url_encode(mac, 32));
    return str_cstr(str_builder_build(sb2));
}

# A JwtSecret on the full vector set, for this audience and issuer.
fn _jwks_secret() {
    var s = jwt_secret_from_jwks(JV_JWKS);
    jwt_secret_with_audience(s, JV_AUD);
    var iss = vec_new();
    vec_push(iss, JV_ISS);
    jwt_secret_with_issuers(s, iss);
    return s;
}

fn _taken(token, s) {
    bote_req_begin();
    if (auth_validator_jwt(token, s) != 0) { return 1; }
    return 0;
}

# A JWK Set holding the one key `jwk`.
fn _set_of(jwk) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"keys\":[");
    str_builder_add_cstr(sb, jwk);
    str_builder_add_cstr(sb, "]}");
    return str_data(str_builder_build(sb));
}

# A set of `jwk` beside a good key, so that only a refusal, and not a skip, is an error.
fn _set_with_good(jwk) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"keys\":[");
    str_builder_add_cstr(sb, JV_JWK_RSA);
    str_builder_add_cstr(sb, ",");
    str_builder_add_cstr(sb, jwk);
    str_builder_add_cstr(sb, "]}");
    return str_data(str_builder_build(sb));
}

# How many keys a set loads.
fn _loaded(jwk) {
    var s = jwt_secret_from_jwks(_set_with_good(jwk));
    if (s == 0) { return 0 - 1; }
    return vec_len(jwt_secret_keys(s));
}

# 1 when the published JWS verifies under the published key: A.2 and A.3 are expired, so
# this stops at the signature.
fn _rfc_sig(jwks, jws, alg) {
    var s = jwt_secret_from_jwks(jwks);
    var keys = jwt_secret_keys(s);
    var k = vec_get(keys, 0);
    var tlen = strlen(jws);
    var dot2 = tlen - 1;
    while (load8(jws + dot2) != 46) { dot2 = dot2 - 1; }
    assert_eq(_jwt_key_alg(k), alg, "rfc: the key's algorithm");
    return _jwt_pk_ok(bote_req_alloc(), jws, dot2, tlen, k);
}

# Build `{"sub":"a","exp":<secs>}` for a computed expiry.
fn _cat(a, b) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    return str_data(str_builder_build(sb));
}

var _AUD = "https://mcp.example.com/mcp";
var _ISS = "https://as.example.com";
var _KEY = "0123456789abcdef0123456789abcdef";
var _HDR = "{\"alg\":\"HS256\",\"typ\":\"JWT\"}";

# Claims with a live `exp`, and `extra` (`"aud":...,`) ahead of it.
fn _claims(extra) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    str_builder_add_cstr(sb, extra);
    str_builder_add_cstr(sb, "\"exp\":");
    str_builder_add_int(sb, clock_epoch_secs() + 3600);
    str_builder_add_cstr(sb, "}");
    return str_data(str_builder_build(sb));
}

fn _for_audience() {
    var s = jwt_secret_new(_KEY);
    jwt_secret_with_audience(s, _AUD);
    return s;
}

# 1 when a validator on `s` takes a token with claims `payload`.
fn _ok_on(s, payload) {
    if (auth_validator_jwt_hs256(_mint_hs256(_HDR, payload, _KEY), s) != 0) { return 1; }
    return 0;
}

fn _aud_ok(extra) { return _ok_on(_for_audience(), _claims(extra)); }

fn _heap_per(tok, s) {
    bote_req_begin();
    auth_validator_jwt_hs256(tok, s);
    var before = alloc_used();
    var i = 0;
    while (i < 20) {
        bote_req_begin();
        auth_validator_jwt_hs256(tok, s);
        i = i + 1;
    }
    return (alloc_used() - before) / 20;
}

fn _payload_with_exp(secs) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"sub\":\"a\",\"exp\":");
    str_builder_add_int(sb, secs);
    str_builder_add_cstr(sb, "}");
    return str_cstr(str_builder_build(sb));
}

# `text` + `suffix`, as a new cstr.
fn _with_suffix(text, suffix) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, text);
    str_builder_add_cstr(sb, suffix);
    return str_cstr(str_builder_build(sb));
}

fn main() {
    alloc_init();

    # ================================================================
    # base64url decode — RFC 4648 §10 vectors + URL-safety check
    # ================================================================
    var len_slot[8]; store64(&len_slot, 0);

    var d_foo = jwt_b64u_decode("Zm9v", 4, &len_slot);
    assert(d_foo != 0, "decode 'Zm9v' returns non-null");
    assert_eq(load64(&len_slot), 3, "decode 'Zm9v' length 3");
    assert(streq(d_foo, "foo") == 1, "decode 'Zm9v' = 'foo'");

    var d_fb = jwt_b64u_decode("Zm9vYmFy", 8, &len_slot);
    assert_eq(load64(&len_slot), 6, "decode 'Zm9vYmFy' length 6");
    assert(streq(d_fb, "foobar") == 1, "decode 'Zm9vYmFy' = 'foobar'");

    # JWT header from RFC 7515 §3.5 (URL-safe alphabet, no padding)
    var d_hdr = jwt_b64u_decode("eyJ0eXAiOiJKV1QiLA0KICJhbGciOiJIUzI1NiJ9", 40, &len_slot);
    assert(d_hdr != 0, "RFC 7515 header decodes");
    assert_eq(load64(&len_slot), 30, "RFC 7515 header length 30");

    # URL-safe characters: '-' (62) and '_' (63) accepted, '+' / '/' would
    # be rejected as 'invalid' by the table (they're not in _b64u_enc).
    var d_url = jwt_b64u_decode("-_4", 3, &len_slot);
    assert(d_url != 0, "URL-safe '-_4' decodes");

    # ================================================================
    # JWT verify — known-good token from a hand-computed HS256 sign
    # ================================================================
    # Header = {"alg":"HS256","typ":"JWT"} → eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9
    # Payload = {"sub":"1234567890","name":"John Doe","iat":1516239022}
    #         → eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ
    # Secret = "your-256-bit-secret"
    # Sig (HS256) → SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c
    # This is the canonical jwt.io example — should verify.
    var token = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c";
    var jwt_key = "your-256-bit-secret";
    assert_eq(jwt_verify_hs256(token, jwt_key, strlen(jwt_key)), 1, "jwt.io canonical token verifies");

    # Wrong secret rejects
    assert_eq(jwt_verify_hs256(token, "wrong-secret", 12), 0, "wrong secret rejects");

    # Tampered signature rejects — flip the FIRST sig char (S→T), which
    # changes the decoded signature on any decoder.
    var tampered = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.TflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c";
    assert_eq(jwt_verify_hs256(tampered, jwt_key, strlen(jwt_key)), 0, "tampered sig rejects");

    # One signature, one token string. A 32-byte MAC leaves 2 spare bits in its
    # last character, so `d`, `e` and `f` spell the same bytes as `c` to a
    # decoder that ignores them, and padding spells them again. A revocation
    # list or replay cache keyed on the token's text could be walked around.
    # bayan's decoder refuses some of these, and which depends on the toolchain,
    # so jwt_verify_hs256 refuses them itself. These pass from cyrius 6.7.13 up.
    var spare_d = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5d";
    var spare_e = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5e";
    var spare_f = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5f";
    assert_eq(jwt_verify_hs256(spare_d, jwt_key, strlen(jwt_key)), 0, "a re-spelled signature rejects (spare bits 01)");
    assert_eq(jwt_verify_hs256(spare_e, jwt_key, strlen(jwt_key)), 0, "a re-spelled signature rejects (spare bits 10)");
    assert_eq(jwt_verify_hs256(spare_f, jwt_key, strlen(jwt_key)), 0, "a re-spelled signature rejects (spare bits 11)");
    assert_eq(jwt_verify_hs256(_with_suffix(token, "="), jwt_key, strlen(jwt_key)), 0, "a padded signature rejects (=)");
    assert_eq(jwt_verify_hs256(_with_suffix(token, "=="), jwt_key, strlen(jwt_key)), 0, "a padded signature rejects (==)");
    assert_eq(jwt_verify_hs256(_with_suffix(token, "===="), jwt_key, strlen(jwt_key)), 0, "a padded signature rejects (====)");

    # Tampered payload (last char of payload changed) rejects — sig won't match
    var tamp_pl = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIzfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c";
    assert_eq(jwt_verify_hs256(tamp_pl, jwt_key, strlen(jwt_key)), 0, "tampered payload rejects");

    # Malformed: not enough segments
    assert_eq(jwt_verify_hs256("a.b", jwt_key, strlen(jwt_key)), 0, "two segments rejects");
    assert_eq(jwt_verify_hs256("just-a-string", jwt_key, strlen(jwt_key)), 0, "no dots rejects");

    # Null/empty inputs
    assert_eq(jwt_verify_hs256(0, jwt_key, strlen(jwt_key)), 0, "null token rejects");
    assert_eq(jwt_verify_hs256(token, 0, 0), 0, "null secret rejects");
    assert_eq(jwt_verify_hs256(token, jwt_key, 0), 0, "zero-len secret rejects");

    # Non-HS256 alg downgrade rejected — header with "alg":"none"
    # Header = {"alg":"none"} → eyJhbGciOiJub25lIn0
    #
    # NB (3.2.0): this literal has an EMPTY third segment, so it is
    # rejected structurally at the `dot2 >= tlen - 1` guard, several
    # checks before the header is ever decoded. It therefore does NOT
    # exercise the alg gate — it never did. Kept as a malformed-input
    # case; the real alg coverage is the minted token below.
    var none_token = "eyJhbGciOiJub25lIn0.eyJzdWIiOiIxIn0.";
    assert_eq(jwt_verify_hs256(none_token, jwt_key, strlen(jwt_key)), 0,
    "alg=none (empty sig segment) rejected structurally");

    # ================================================================
    # 3.2.0 — `alg` is an exact JSON field read, not a substring scan
    # ================================================================
    # Regression test for finding (2) of the 2026-07-30 issue. Through
    # 3.1.4 the alg check scanned the decoded header for the five bytes
    # "HS256" ANYWHERE, so this header satisfied it — the literal sits
    # inside the `kid` VALUE while `alg` actually says "none". Minted
    # with a correct HMAC so nothing else can reject it: this token
    # reaches the alg gate, and only the alg gate can turn it away.
    var confusion = _mint_hs256("{\"alg\":\"none\",\"kid\":\"HS256-2024\"}",
    "{\"sub\":\"a\"}", jwt_key);
    assert_eq(jwt_verify_hs256(confusion, jwt_key, strlen(jwt_key)), 0,
    "alg confusion: HS256 inside kid does not satisfy alg");

    # Control: the same mint with a real HS256 header verifies — proves
    # the assertion above fails on `alg`, not on a broken minter.
    var minted_ok = _mint_hs256("{\"alg\":\"HS256\",\"typ\":\"JWT\"}",
    "{\"sub\":\"a\"}", jwt_key);
    assert_eq(jwt_verify_hs256(minted_ok, jwt_key, strlen(jwt_key)), 1,
    "minted HS256 token verifies (minter control)");

    # `alg` must be a JSON string, and byte-exact. RFC 7515 §4.1.1 alg
    # values are case-sensitive.
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"hs256\"}", "{\"sub\":\"a\"}", jwt_key),
    jwt_key, strlen(jwt_key)), 0, "lowercase alg rejected (case-sensitive)");
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS2560\"}", "{\"sub\":\"a\"}", jwt_key),
    jwt_key, strlen(jwt_key)), 0, "alg longer than HS256 rejected");
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS25\"}", "{\"sub\":\"a\"}", jwt_key),
    jwt_key, strlen(jwt_key)), 0, "alg shorter than HS256 rejected");
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"typ\":\"JWT\"}", "{\"sub\":\"a\"}", jwt_key),
    jwt_key, strlen(jwt_key)), 0, "missing alg rejected");
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":256}", "{\"sub\":\"a\"}", jwt_key),
    jwt_key, strlen(jwt_key)), 0, "non-string alg rejected");

    # ================================================================
    # 3.2.0 — `exp` is enforced (RFC 7519 §4.1.4)
    # ================================================================
    # Finding (2) of the issue: the module header documented this check
    # since 2.2.0 and no such check existed, so a correctly signed but
    # arbitrarily expired token was accepted. All tokens below are
    # correctly signed — expiry is the ONLY thing that can reject them.
    var now = clock_epoch_secs();

    # Absent exp is legal (the claim is optional) — the canonical
    # jwt.io token above has only `iat`, and still verifies.
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS256\"}", "{\"sub\":\"a\"}", jwt_key),
    jwt_key, strlen(jwt_key)), 1, "absent exp accepted");

    # Future exp accepted.
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS256\"}", _payload_with_exp(now + 3600), jwt_key),
    jwt_key, strlen(jwt_key)), 1, "exp one hour in the future accepted");

    # Past exp rejected — the whole point.
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS256\"}", _payload_with_exp(now - 3600), jwt_key),
    jwt_key, strlen(jwt_key)), 0, "exp one hour in the past rejected");

    # Fixed historical exp (2018-01-18) — clock-independent.
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS256\"}", _payload_with_exp(1516239022), jwt_key),
    jwt_key, strlen(jwt_key)), 0, "long-expired token rejected");

    # exp == now is a reject: RFC 7519 requires now to be strictly
    # BEFORE exp. No leeway is granted.
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS256\"}", _payload_with_exp(now), jwt_key),
    jwt_key, strlen(jwt_key)), 0, "exp == now rejected (no leeway)");

    # Malformed exp must REJECT, not read as absent — folding
    # "unparseable" into "no expiry" would be the fail-open direction.
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS256\"}",
    "{\"sub\":\"a\",\"exp\":\"1785461260\"}", jwt_key), jwt_key, strlen(jwt_key)), 0,
    "string-typed exp rejected (NumericDate is a JSON number)");
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS256\"}",
    "{\"sub\":\"a\",\"exp\":null}", jwt_key), jwt_key, strlen(jwt_key)), 0,
    "null exp rejected");
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS256\"}",
    "{\"sub\":\"a\",\"exp\":true}", jwt_key), jwt_key, strlen(jwt_key)), 0,
    "boolean exp rejected");
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS256\"}",
    "{\"sub\":\"a\",\"exp\":1e9}", jwt_key), jwt_key, strlen(jwt_key)), 0,
    "exponent-notation exp rejected (str_to_int would read this as 19)");
    # 25 digits — would overflow i64 and wrap negative. Rejected on
    # purpose by the digit cap, not by accident via the wrap.
    assert_eq(jwt_verify_hs256(_mint_hs256("{\"alg\":\"HS256\"}",
    "{\"sub\":\"a\",\"exp\":9999999999999999999999999}", jwt_key), jwt_key, strlen(jwt_key)), 0,
    "absurd 25-digit exp rejected (no i64 wrap)");

    # ---- claim readers, direct ----
    assert_eq(_jwt_parse_uint("1785461260", 0, 10), 1785461260, "parse_uint plain");
    assert_eq(_jwt_parse_uint("x", 0, 1), 0 - 1, "parse_uint non-digit -> -1");
    assert_eq(_jwt_parse_uint("", 0, 0), 0 - 1, "parse_uint empty span -> -1");
    assert_eq(_jwt_parse_uint("0", 0, 1), 0, "parse_uint zero is a real 0, not -1");
    assert_eq(_jwt_parse_uint("1234567890123456789", 0, 19), 0 - 1,
    "parse_uint 19 digits -> -1 (over the 18-digit cap)");
    assert_eq(_jwt_str_field_eq("{\"alg\":\"HS256\"}", 15, "alg", "HS256"), 1,
    "str_field_eq exact match");
    assert_eq(_jwt_str_field_eq("{\"alg\":\"none\",\"kid\":\"HS256\"}", 27, "alg", "HS256"), 0,
    "str_field_eq ignores a match in another field's value");
    # Unterminated string must not masquerade as a closed one.
    assert_eq(_jwt_str_field_eq("{\"alg\":\"HS256", 13, "alg", "HS256"), 0,
    "str_field_eq rejects unterminated string");

    # ================================================================
    # JwtSecret handle + validator adapter
    # ================================================================
    var sh = jwt_secret_new(jwt_key);
    assert(sh != 0, "secret handle allocates");
    assert(streq(jwt_secret_data(sh), jwt_key) == 1, "secret data accessor");
    assert_eq(jwt_secret_len(sh), 19, "secret len accessor");

    # Validator with the bearer-middleware signature returns the token
    # cstr (truthy "claims") on success.
    var claims_ok = auth_validator_jwt_hs256(token, sh);
    assert(claims_ok != 0, "validator returns claims on valid token");
    assert(streq(claims_ok, token) == 1, "claims = original token");

    # Wrong-secret handle → 0
    var bad_sh = jwt_secret_new("wrong-secret");
    assert_eq(auth_validator_jwt_hs256(token, bad_sh), 0, "validator rejects wrong-secret");

    # Null handle → 0 (no segfault)
    assert_eq(auth_validator_jwt_hs256(token, 0), 0, "validator null-handle safe");

    # ================================================================
    # ---- the decoder: one spelling, and no heap ----
    var bl[8];
    assert(jwt_b64u_decode("Zm9vYg", 6, &bl) != 0 && load64(&bl) == 4, "decode: no padding needed");
    assert_eq(jwt_b64u_decode("Zm9vYg==", 8, &bl), 0, "decode: padding is refused");
    assert_eq(jwt_b64u_decode("Zm9vYh", 6, &bl), 0, "decode: spare bits are refused");
    assert_eq(jwt_b64u_decode("Zm9v+g", 6, &bl), 0, "decode: the standard alphabet's + is refused");
    assert_eq(jwt_b64u_decode("Zm9v/g", 6, &bl), 0, "decode: its / too");
    assert_eq(jwt_b64u_decode("Zm9vY", 5, &bl), 0, "decode: a length no encoder writes");
    assert_eq(jwt_b64u_decode("Zm9vA", 5, &bl), 0, "decode: ...even with no spare bit set");
    assert_eq(jwt_b64u_decode("Zm9v Yg", 7, &bl), 0, "decode: a space");
    assert_eq(jwt_b64u_decode("", 0, &bl), 0, "decode: nothing");
    var nul = jwt_b64u_decode("QQBC", 4, &bl);
    assert(nul != 0 && load64(&bl) == 3 && load8(nul + 1) == 0 && load8(nul + 2) == 66, "decode: a NUL inside is a byte");

    # ---- RS256 and ES256 ----
    # RFC 7515's own examples, as published.
    assert_eq(_rfc_sig(JV_RFC_RS_JWKS, JV_RFC_RS_JWS, BOTE_JWT_RS256), 1, "rfc: A.2 RS256 verifies");
    assert_eq(_rfc_sig(JV_RFC_ES_JWKS, JV_RFC_ES_JWS, BOTE_JWT_ES256), 1, "rfc: A.3 ES256 verifies");
    assert_eq(auth_validator_jwt(JV_RFC_RS_JWS, jwt_secret_from_jwks(JV_RFC_RS_JWKS)), 0, "rfc: A.2 expired in 2011, which the whole path sees");

    var js = _jwks_secret();
    assert_eq(vec_len(jwt_secret_keys(js)), 6, "jwks: six keys");
    assert_eq(jwt_secret_data(js), 0, "jwks: no shared secret in the same handle");
    assert_eq(_taken(JV_RS_GOOD, js), 1, "RS256: a token signed by Node");
    assert_eq(_taken(JV_ES_GOOD, js), 1, "ES256: a token signed by Node");
    assert_eq(_taken(JV_RS3072, js), 1, "RS256: 3072 bits");
    assert_eq(_taken(JV_RS4096, js), 1, "RS256: 4096 bits");
    assert_eq(_taken(JV_RS_UNKNOWN_KID, js), 0, "RS256: a kid nobody has");
    assert_eq(_taken(JV_ES_UNKNOWN_KID, js), 0, "ES256: a kid nobody has");
    assert_eq(_taken(JV_RS_NUMBER_KID, js), 0, "RS256: a kid that is no string");
    assert_eq(_taken(JV_ES_NUMBER_KID, js), 0, "ES256: a kid that is no string");
    assert_eq(_taken(JV_RS_OTHER_KEY, js), 0, "RS256: signed by another key");
    assert_eq(_taken(JV_ES_OTHER_KEY, js), 0, "ES256: signed by another key");
    assert_eq(_taken(JV_RS_OTHER_AUD, js), 0, "RS256: a good signature for another server");
    assert_eq(_taken(JV_ES_OTHER_AUD, js), 0, "ES256: a good signature for another server");
    assert_eq(_taken(JV_RS_OTHER_ISS, js), 0, "RS256: another issuer");
    assert_eq(_taken(JV_ES_OTHER_ISS, js), 0, "ES256: another issuer");
    assert_eq(_taken(JV_RS_EXPIRED, js), 0, "RS256: expired");
    assert_eq(_taken(JV_ES_EXPIRED, js), 0, "ES256: expired");
    assert_eq(_taken(JV_RS_FUTURE, js), 0, "RS256: not yet valid");
    assert_eq(_taken(JV_ES_FUTURE, js), 0, "ES256: not yet valid");
    assert_eq(_taken(JV_RS_CRIT, js), 0, "RS256: crit is refused, RFC 7515 4.1.11");
    assert_eq(_taken(JV_ES_CRIT, js), 0, "ES256: crit is refused");
    assert_eq(_taken(JV_RS_LOWER_ALG, js), 0, "RS256: alg is case-sensitive");
    assert_eq(_taken(JV_ES_LOWER_ALG, js), 0, "ES256: alg is case-sensitive");

    # No kid: one key of that alg picks itself, and two never get a try each.
    assert_eq(_taken(JV_RS_NO_KID, js), 0, "kid: none, with several RSA keys");
    assert_eq(_taken(JV_ES_NO_KID, js), 0, "kid: none, with several EC keys");
    assert_eq(_taken(JV_RS_NO_KID_LAST, js), 0, "kid: none, signed by the last RSA key, which no try-each may reach");
    assert_eq(_taken(JV_ES_NO_KID_LAST, js), 0, "kid: none, signed by the last EC key");
    var one_r = jwt_secret_from_jwks(JV_JWKS_ONE_RSA);
    jwt_secret_with_audience(one_r, JV_AUD);
    assert_eq(_taken(JV_RS_NO_KID, one_r), 1, "kid: none, with one RSA key");
    assert_eq(_taken(JV_ES_NO_KID, one_r), 0, "kid: none, and no key of that alg");
    assert_eq(_taken(JV_RS_GOOD, one_r), 0, "kid: named, and the key has none to match");
    var one_e = jwt_secret_from_jwks(JV_JWKS_ONE_EC);
    jwt_secret_with_audience(one_e, JV_AUD);
    assert_eq(_taken(JV_ES_NO_KID, one_e), 1, "kid: none, with one EC key");

    # Algorithm confusion. A key has one algorithm, and a public key never reaches the HMAC.
    assert_eq(_taken(JV_RS_AS_ES, js), 0, "confusion: an RSA key under alg ES256");
    assert_eq(_taken(JV_ES_AS_RS, js), 0, "confusion: an EC key under alg RS256");
    assert_eq(_taken(JV_HS_WITH_N, js), 0, "confusion: HS256 keyed with the RSA modulus");
    assert_eq(_taken(JV_HS_WITH_PEM, js), 0, "confusion: HS256 keyed with the public key's PEM");
    assert_eq(_taken(JV_RS_GOOD, _for_audience()), 0, "confusion: a shared-secret verifier takes no RS256");
    assert_eq(_taken(JV_ES_GOOD, _for_audience()), 0, "confusion: nor ES256");
    assert_eq(_taken(_mint_hs256(_HDR, _claims("\"aud\":\"https://mcp.example.com/mcp\",\"iss\":\"https://as.example.com\","), _KEY), js), 0, "confusion: a public-key verifier takes no HS256");
    var none_t = _cat("eyJhbGciOiJub25lIn0.", _cat(base64url_encode("{}", 2), "."));
    assert_eq(_taken(none_t, js), 0, "confusion: alg none");

    # ES256's edges. All-zero is the forgery of CVE-2022-21449.
    assert_eq(_taken(JV_ES_ZERO_SIG, js), 0, "ES256: r = s = 0");
    assert_eq(_taken(JV_ES_R_IS_N, js), 0, "ES256: r = n");
    assert_eq(_taken(JV_ES_S_IS_N, js), 0, "ES256: s = n");
    assert_eq(_taken(JV_ES_SHORT_SIG, js), 0, "ES256: 63 bytes");
    assert_eq(_taken(JV_ES_LONG_SIG, js), 0, "ES256: 65 bytes");
    assert_eq(_taken(JV_ES_DER_SIG, js), 0, "ES256: DER, which is not JWS");
    assert_eq(_taken(JV_RS_LONG_SIG, js), 0, "RS256: a correct signature with a byte after it");
    assert_eq(_taken(JV_RS_SHORT_SIG, js), 0, "RS256: cut short");
    var bang_rs = _with_suffix(JV_RS_GOOD, "");
    store8(bang_rs + strlen(bang_rs) - 1, 33);
    assert_eq(_taken(bang_rs, js), 0, "RS256: a signature that is no base64url");
    var bang_es = _with_suffix(JV_ES_GOOD, "");
    store8(bang_es + strlen(bang_es) - 1, 33);
    assert_eq(_taken(bang_es, js), 0, "ES256: a signature that is no base64url");
    # No key at all is not an empty key: HMAC under "" is something anyone can compute.
    var empty_t = _mint_hs256(_HDR, "{}", "");
    assert_eq(_taken(empty_t, jwt_secret_new(0)), 0, "keyless: a handle with no key verifies nothing");
    assert_eq(_taken(empty_t, jwt_secret_new("")), 0, "keyless: nor one with an empty key");
    assert_eq(jwt_verify_hs256(empty_t, "", 0), 0, "keyless: verify, an empty key");
    # Not a bug and not a choice: (r, n - s) is a valid signature, and JWS has no rule
    # against it. It is why a token's text cannot key a revocation list under ES256.
    assert_eq(_taken(JV_ES_OTHER_S, js), 1, "ES256: the second spelling verifies, as the math says");

    # What a key set may hold.
    assert_eq(jwt_jwks_check(JV_JWKS), 0, "jwks: the good set");
    assert(jwt_jwks_check(0) != 0, "jwks refused: nothing");
    assert(jwt_jwks_check("nope") != 0, "jwks refused: not JSON");
    assert(jwt_jwks_check("[]") != 0, "jwks refused: not an object");
    assert(jwt_jwks_check("{}") != 0, "jwks refused: no keys");
    assert(jwt_jwks_check("{\"keys\":{}}") != 0, "jwks refused: keys is no array");
    assert(jwt_jwks_check(_cat(_cat("{\"keys\":{\"a\":", JV_JWK_RSA), "}}")) != 0, "jwks refused: a usable key, in an object");
    assert(jwt_jwks_check(_cat(_cat("{\"keys\":[", JV_JWK_RSA), "],}")) != 0, "jwks refused: a usable key, in JSON that is not valid");
    assert(jwt_jwks_check("{\"keys\":[]}") != 0, "jwks refused: an empty set");
    assert(jwt_jwks_check(_set_of(JV_JWK_RSA_1024)) != 0, "jwks refused: nothing usable, 1024 bits");
    assert(jwt_jwks_check(_set_of(JV_JWK_PRIVATE_RSA)) != 0, "jwks refused: an RSA private key");
    assert(jwt_jwks_check(_set_of(JV_JWK_PRIVATE_EC)) != 0, "jwks refused: an EC private key");
    assert(jwt_jwks_check(_set_of(JV_JWK_PRIVATE_P)) != 0, "jwks refused: a private prime");
    assert(jwt_jwks_check(_set_of(JV_JWK_OCT)) != 0, "jwks refused: a shared secret");
    assert(jwt_jwks_check(_set_with_good(JV_JWK_PRIVATE_RSA)) != 0, "jwks refused: a private key beside a good one");
    assert(jwt_jwks_check(_set_with_good(JV_JWK_OCT)) != 0, "jwks refused: a shared secret beside a good key");
    assert(jwt_jwks_check(_set_with_good(JV_JWK_PRIVATE_EC)) != 0, "jwks refused: an EC private key beside a good key");
    assert(jwt_jwks_check(_set_with_good(JV_JWK_PRIVATE_P)) != 0, "jwks refused: a private prime beside a good key");
    assert_eq(jwt_secret_from_jwks(_set_of(JV_JWK_PRIVATE_EC)), 0, "jwks: from_jwks refuses what the check refuses");
    var dup = "{\"kty\":\"EC\",\"crv\":\"P-256\",\"kid\":\"same\",\"x\":\"f83OJ3D2xF1Bg8vub9tLe1gHMzV76e8Tus9uPHvRVEU\",\"y\":\"x_FEzRu9m36HLN_tue659LNpXW6pCyStikYjKIWI5a0\"}";
    var dup2 = _cat(_cat("{\"keys\":[", dup), _cat(",", _cat(dup, "]}")));
    assert(jwt_jwks_check(dup2) != 0, "jwks refused: two keys with one kid");
    assert_eq(_loaded(JV_JWK_RSA_1024), 1, "jwks skips: 1024 bits");
    assert_eq(_loaded(JV_JWK_RSA_2047), 1, "jwks skips: 2047 bits");
    assert_eq(_loaded(JV_JWK_RSA_HUGE), 1, "jwks skips: past what sigil holds");
    assert_eq(_loaded(JV_JWK_RSA_E3), 1, "jwks skips: e = 3");
    assert_eq(_loaded(JV_JWK_RSA_EVEN), 1, "jwks skips: an even modulus");
    assert_eq(_loaded(JV_JWK_RSA_LEADING_ZERO), 1, "jwks skips: a modulus with a leading zero");
    assert_eq(_loaded(JV_JWK_EC_OFF_CURVE), 1, "jwks skips: a point off the curve");
    assert_eq(_loaded(JV_JWK_EC_SHORT), 1, "jwks skips: a short coordinate");
    assert_eq(_loaded(JV_JWK_EC_LONG), 1, "jwks skips: a coordinate with a byte after it");
    assert_eq(_loaded(JV_JWK_EC_CURVE_NAME), 1, "jwks skips: 32-byte coordinates on another curve");
    assert_eq(_loaded(JV_JWK_RSA_PS256), 1, "jwks skips: a good RSA key for another algorithm");
    assert_eq(_loaded(JV_JWK_EC_P384), 1, "jwks skips: P-384");
    assert_eq(_loaded(JV_JWK_ED25519), 1, "jwks skips: Ed25519");
    assert_eq(_loaded("{\"kty\":\"EC\",\"crv\":\"P-256\",\"use\":\"enc\",\"x\":\"f83OJ3D2xF1Bg8vub9tLe1gHMzV76e8Tus9uPHvRVEU\",\"y\":\"x_FEzRu9m36HLN_tue659LNpXW6pCyStikYjKIWI5a0\"}"), 1, "jwks skips: an encryption key");
    assert_eq(_loaded("{\"kty\":\"EC\",\"crv\":\"P-256\",\"alg\":\"ES384\",\"x\":\"f83OJ3D2xF1Bg8vub9tLe1gHMzV76e8Tus9uPHvRVEU\",\"y\":\"x_FEzRu9m36HLN_tue659LNpXW6pCyStikYjKIWI5a0\"}"), 1, "jwks skips: another algorithm on an EC key");
    assert_eq(_loaded("{\"kty\":\"RSA\",\"alg\":\"PS256\",\"n\":\"AQAB\",\"e\":\"AQAB\"}"), 1, "jwks skips: another algorithm on an RSA key");
    assert_eq(_loaded("{\"crv\":\"P-256\"}"), 1, "jwks skips: no kty");
    assert_eq(_loaded("5"), 1, "jwks skips: what is no object");

    # A public-key refusal keeps nothing either, and a good token keeps nothing here.
    var bad_rs = _with_suffix(JV_RS_GOOD, "");
    store8(bad_rs + strlen(bad_rs) - 10, 65);
    assert_eq(_heap_per(bad_rs, js), 0, "heap: a forged RS256 token");
    var bad_es = _with_suffix(JV_ES_GOOD, "");
    store8(bad_es + strlen(bad_es) - 10, 65);
    assert_eq(_heap_per(bad_es, js), 0, "heap: a forged ES256 token");
    assert_eq(_heap_per(JV_RS_GOOD, js), 0, "heap: a good RS256 token");
    assert_eq(_heap_per(JV_ES_GOOD, js), 0, "heap: a good ES256 token");
    assert_eq(_heap_per(JV_RS_UNKNOWN_KID, js), 0, "heap: an unknown kid");

    # ---- what a signature covers ----
    # The right MAC with more after it: a compare of 32 bytes alone would take this.
    var lhdr = base64url_encode(_HDR, strlen(_HDR));
    var lbody = base64url_encode("{}", 2);
    var lsb = str_builder_new();
    str_builder_add_cstr(lsb, lhdr);
    str_builder_add_cstr(lsb, ".");
    str_builder_add_cstr(lsb, lbody);
    var linput = str_data(str_builder_build(lsb));
    var lmac = alloc(36);
    hmac_sha256(_KEY, strlen(_KEY), linput, strlen(linput), lmac);
    assert_eq(jwt_verify_hs256(_with_suffix(_with_suffix(linput, "."), base64url_encode(lmac, 32)), _KEY, strlen(_KEY)), 1, "signature: the MAC alone");
    store8(lmac + 32, 65);
    store8(lmac + 33, 66);
    store8(lmac + 34, 67);
    assert_eq(jwt_verify_hs256(_with_suffix(_with_suffix(linput, "."), base64url_encode(lmac, 35)), _KEY, strlen(_KEY)), 0, "signature: the MAC with bytes after it");
    assert_eq(jwt_verify_hs256(_with_suffix(_with_suffix(linput, "."), base64url_encode(lmac, 31)), _KEY, strlen(_KEY)), 0, "signature: the MAC cut short");
    # A good signature over a payload that does not decode.
    var bsb = str_builder_new();
    str_builder_add_cstr(bsb, lhdr);
    str_builder_add_cstr(bsb, ".!!!!");
    var binput = str_data(str_builder_build(bsb));
    var bmac = alloc(32);
    hmac_sha256(_KEY, strlen(_KEY), binput, strlen(binput), bmac);
    assert_eq(jwt_verify_hs256(_with_suffix(_with_suffix(binput, "."), base64url_encode(bmac, 32)), _KEY, strlen(_KEY)), 0, "signature: over a payload that is no base64url");

    # ---- nbf ----
    var hour = clock_epoch_secs() + 3600;
    var past = _mint_hs256(_HDR, "{\"nbf\":1000}", _KEY);
    assert_eq(jwt_verify_hs256(past, _KEY, strlen(_KEY)), 1, "nbf: in the past");
    var fsb = str_builder_new();
    str_builder_add_cstr(fsb, "{\"nbf\":");
    str_builder_add_int(fsb, hour);
    str_builder_add_cstr(fsb, "}");
    assert_eq(jwt_verify_hs256(_mint_hs256(_HDR, str_data(str_builder_build(fsb)), _KEY), _KEY, strlen(_KEY)), 0, "nbf: in the future");
    var nsb = str_builder_new();
    str_builder_add_cstr(nsb, "{\"nbf\":");
    str_builder_add_int(nsb, clock_epoch_secs());
    str_builder_add_cstr(nsb, "}");
    assert_eq(jwt_verify_hs256(_mint_hs256(_HDR, str_data(str_builder_build(nsb)), _KEY), _KEY, strlen(_KEY)), 1, "nbf: now is allowed, RFC 7519 4.1.5");
    assert_eq(jwt_verify_hs256(_mint_hs256(_HDR, "{\"nbf\":\"1000\"}", _KEY), _KEY, strlen(_KEY)), 0, "nbf: a string");
    assert_eq(jwt_verify_hs256(_mint_hs256(_HDR, "{\"nbf\":null}", _KEY), _KEY, strlen(_KEY)), 0, "nbf: null");
    assert_eq(_jwt_nbf_ok("{}", 2), 1, "nbf: absent");

    # ---- the audience: a token for this server, and no other ----
    assert_eq(_aud_ok("\"aud\":\"https://mcp.example.com/mcp\","), 1, "aud: a string");
    assert_eq(_aud_ok("\"aud\":[\"https://mcp.example.com/mcp\"],"), 1, "aud: an array of one");
    assert_eq(_aud_ok("\"aud\":[\"a\",\"https://mcp.example.com/mcp\"],"), 1, "aud: the last of several");
    assert_eq(_aud_ok("\"aud\":[\"https://mcp.example.com/mcp\",\"b\"],"), 1, "aud: the first of several");
    assert_eq(_aud_ok("\"aud\": [ \"a\" , \"https://mcp.example.com/mcp\" ] ,"), 1, "aud: whitespace in the array");
    assert_eq(_aud_ok("\"aud\":[ \"https://mcp.example.com/mcp\" ],"), 1, "aud: whitespace ahead of the first");
    assert_eq(_aud_ok("\"aud\":[1,{\"x\":\"y\"},[2],\"https://mcp.example.com/mcp\"],"), 1, "aud: past what is no string");
    assert_eq(_aud_ok("\"aud\":\"https:\\/\\/mcp.example.com\\/mcp\","), 1, "aud: as an encoder escapes it");
    assert_eq(_aud_ok("\"aud\":\"\\u0068ttps://mcp.example.com/mcp\","), 1, "aud: unicode-escaped");
    assert_eq(_aud_ok("\"aud\":\"https://other.example.com/mcp\","), 0, "aud: another server");
    assert_eq(_aud_ok("\"aud\":\"https://mcp.example.com\","), 0, "aud: a prefix of this one");
    assert_eq(_aud_ok("\"aud\":\"https://mcp.example.com/mcp2\","), 0, "aud: this one and more");
    assert_eq(_aud_ok("\"aud\":\"https://mcp.example.com/mcp/\","), 0, "aud: a trailing slash");
    assert_eq(_aud_ok("\"aud\":\"HTTPS://MCP.EXAMPLE.COM/MCP\","), 0, "aud: values are case-sensitive");
    assert_eq(_aud_ok("\"aud\":\"\","), 0, "aud: empty");
    assert_eq(_aud_ok("\"aud\":[],"), 0, "aud: an empty array");
    assert_eq(_aud_ok("\"aud\":[\"a\",\"b\"],"), 0, "aud: an array without it");
    assert_eq(_aud_ok("\"aud\":[[\"https://mcp.example.com/mcp\"]],"), 0, "aud: nested in an array");
    assert_eq(_aud_ok("\"aud\":{\"aud\":\"https://mcp.example.com/mcp\"},"), 0, "aud: nested in an object");
    assert_eq(_aud_ok("\"x\":{\"aud\":\"https://mcp.example.com/mcp\"},"), 0, "aud: in another claim");
    assert_eq(_aud_ok("\"aud\":5,"), 0, "aud: a number");
    assert_eq(_aud_ok("\"aud\":null,"), 0, "aud: null");
    assert_eq(_aud_ok("\"aud\":true,"), 0, "aud: a boolean");
    assert_eq(_aud_ok(""), 0, "aud: missing, with an audience set");
    assert_eq(_aud_ok("\"aud\":\"https://mcp.example.com/mcp\\u0000x\","), 0, "aud: a NUL does not end the comparison");
    assert_eq(_aud_ok("\"aud\":\"other\",\"aud\":\"https://mcp.example.com/mcp\","), 0, "aud: a repeated key, the first as everything here reads it");
    assert_eq(_ok_on(_for_audience(), "{\"aud\":\"https://mcp.example.com/mcp\"}"), 0, "aud: with an audience, a token needs an exp");
    assert_eq(_ok_on(_for_audience(), "{\"aud\":\"https://mcp.example.com/mcp\",\"exp\":1000}"), 0, "aud: an expired token is still refused");
    var plain = jwt_secret_new(_KEY);
    assert_eq(_ok_on(plain, _claims("")), 1, "aud: none set, none in the token");
    assert_eq(_ok_on(plain, "{\"sub\":\"x\"}"), 1, "aud: none set, exp stays optional");
    assert_eq(_ok_on(plain, _claims("\"aud\":\"anything\",")), 0, "aud: none set, a token that names one is refused (RFC 7519 4.1.3)");
    assert_eq(_jwt_aud_has(default_alloc(), "{\"aud\":[\"a\"", 12, "b"), 0, "aud: an array never closed");

    # ---- the issuer ----
    var iss_s = _for_audience();
    var isses = vec_new();
    vec_push(isses, "https://other.example.com");
    vec_push(isses, _ISS);
    jwt_secret_with_issuers(iss_s, isses);
    var aud_c = "\"aud\":\"https://mcp.example.com/mcp\",";
    assert_eq(_ok_on(iss_s, _claims(_cat(aud_c, "\"iss\":\"https://as.example.com\","))), 1, "iss: one of the issuers");
    assert_eq(_ok_on(iss_s, _claims(_cat(aud_c, "\"iss\":\"https://other.example.com\","))), 1, "iss: the other");
    assert_eq(_ok_on(iss_s, _claims(_cat(aud_c, "\"iss\":\"https:\\/\\/as.example.com\","))), 1, "iss: escaped");
    assert_eq(_ok_on(iss_s, _claims(_cat(aud_c, "\"iss\":\"https://evil.example.com\","))), 0, "iss: another");
    assert_eq(_ok_on(iss_s, _claims(_cat(aud_c, "\"iss\":\"https://as.example.com/\","))), 0, "iss: a trailing slash");
    assert_eq(_ok_on(iss_s, _claims(aud_c)), 0, "iss: missing, with issuers set");
    assert_eq(_ok_on(iss_s, _claims(_cat(aud_c, "\"iss\":5,"))), 0, "iss: a number");
    assert_eq(_ok_on(_for_audience(), _claims(_cat(aud_c, "\"iss\":\"anyone\","))), 1, "iss: none set, not read");
    var empty_iss = jwt_secret_with_issuers(_for_audience(), vec_new());
    assert_eq(_ok_on(empty_iss, _claims(aud_c)), 1, "iss: an empty list is none");
    assert(jwt_secret_audience(_for_audience()) != 0 && jwt_secret_issuers(jwt_secret_new(_KEY)) == 0, "secret: the accessors");

    # ---- nothing a request sends stays ----
    var big_hdr = str_builder_new();
    var bi = 0;
    while (bi < 60000) {
        str_builder_add_cstr(big_hdr, "A");
        bi = bi + 1;
    }
    str_builder_add_cstr(big_hdr, ".e30.AAAA");
    var hs = _for_audience();
    assert_eq(_heap_per(str_data(str_builder_build(big_hdr)), hs), 0, "heap: a forged token with a 60 KB header");
    assert_eq(_heap_per("eyJhbGciOiJIUzI1NiJ9.e30.AAAA", hs), 0, "heap: a forged token");
    assert_eq(_heap_per(_mint_hs256(_HDR, _claims("\"aud\":\"https://other.example.com/mcp\","), _KEY), hs), 0, "heap: a good token for another server");
    assert_eq(_heap_per(_mint_hs256(_HDR, _claims(aud_c), _KEY), hs), 0, "heap: a good token");
    assert_eq(_heap_per(_mint_hs256(_HDR, _claims(aud_c), "the-wrong-key-the-wrong-key-the-wrong"), hs), 0, "heap: the wrong key");

    # Fn-pointer addressability (for plugging into auth_bearer_check)
    # ================================================================
    assert(&jwt_verify_hs256 != 0, "verify fp addressable");
    assert(&auth_validator_jwt_hs256 != 0, "validator fp addressable");
    assert(&jwt_secret_new != 0, "secret_new fp addressable");

    return assert_summary();
}

var rc = main();
sys_exit(rc);
