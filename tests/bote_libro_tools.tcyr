# bote_libro_tools.tcyr — unit tests for src/libro_tools.cyr.
#
# Split out of bote.tcyr because the full bote test surface + libro
# 2.6.x dist bundle exceeds the cyrius identifier-buffer cap when
# compiled as one unit. 2.6.2: re-enabled after the libro_tools
# port from libro 1.0.3 → 2.6.2 (raw struct-offset accessors
# replace the retired entry_*/merkle_*/error_* getters; see
# src/libro_tools.cyr:38).

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fs.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"
include "lib/fnptr.cyr"
include "lib/chrono.cyr"
include "lib/tagged.cyr"
include "lib/freelist.cyr"
include "lib/thread.cyr"
include "lib/thread_local.cyr"  # sigil 3.7.14 TLS crypto_scratch — SIGILL guard
include "lib/sakshi.cyr"
include "lib/ct.cyr"
include "lib/keccak.cyr"
include "lib/process.cyr"
include "lib/random.cyr"
include "lib/sigil.cyr"
include "lib/patra.cyr"
include "lib/libro.cyr"
include "lib/assert.cyr"

include "src/log.cyr"
include "src/error.cyr"
include "src/protocol.cyr"
include "src/jsonx.cyr"
include "src/registry.cyr"
include "src/prompts.cyr"
include "src/resources.cyr"
include "src/events.cyr"
include "src/audit.cyr"
include "src/dispatch.cyr"
include "src/codec.cyr"
include "src/schema.cyr"
include "src/audit_libro.cyr"
include "src/libro_tools.cyr"

# 1 when cstr `hay` contains cstr `needle`.
fn _lc_has(hay, needle) {
    if (hay == 0 || needle == 0) { return 0; }
    var i = 0;
    while (load8(hay + i) != 0) {
        var j = 0;
        while (load8(needle + j) != 0 && load8(hay + i + j) == load8(needle + j)) { j = j + 1; }
        if (load8(needle + j) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# The structuredContent object of a libro tool's CallToolResult (3.4.10),
# or "" so that a regression reports instead of dereferencing 0.
fn _sc(r) {
    if (r == 0) { return ""; }
    var sc = jsonx_get_raw(r, "structuredContent");
    if (sc == 0) { return ""; }
    return sc;
}
# The raw value of `key` in r's structuredContent, or "".
fn _scf(r, key) {
    var v = jsonx_get_raw(_sc(r), key);
    if (v == 0) { return ""; }
    return v;
}
# 1 when r is a CallToolResult whose isError is `want_err` (1: true, 0: absent): a content
# array, and structuredContent when it is no error. (3.8.5) An error result has none, but
# libro_verify's on a broken chain, which its schema allows.
fn _lt_shape_ok(r, want_err) {
    if (r == 0) { return 0; }
    var c = jsonx_get_raw(r, "content");
    if (c == 0 || load8(c) != 91) { return 0; }
    if (want_err == 0 && jsonx_get_raw(r, "structuredContent") == 0) { return 0; }
    var ie = jsonx_get_raw(r, "isError");
    if (want_err == 1) {
        if (ie == 0 || streq(ie, "true") == 0) { return 0; }
    } else {
        if (ie != 0) { return 0; }
    }
    return 1;
}

# (3.8.4) A JSON-RPC message, on 2026-07-28 when `modern` is 1.
fn _lt_cat3(a, b, c) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    str_builder_add_cstr(sb, c);
    return str_data(str_builder_build(sb));
}
fn _lt_msg(method, params, modern) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"");
    str_builder_add_cstr(sb, method);
    str_builder_add_cstr(sb, "\",\"params\":{");
    str_builder_add_cstr(sb, params);
    if (modern == 1) {
        if (strlen(params) > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}}");
    }
    str_builder_add_cstr(sb, "}}");
    return str_data(str_builder_build(sb));
}
fn _lt_call_params(name, args) { return _lt_cat3(_lt_cat3("\"name\":\"", name, "\",\"arguments\":"), args, ""); }
fn _lt_occurs(hay, needle) {
    var n = 0;
    var i = 0;
    var nl = strlen(needle);
    while (load8(hay + i) != 0) {
        if (memeq(hay + i, needle, nl) == 1) { n = n + 1; }
        i = i + 1;
    }
    return n;
}
# The WARN lines registration logs, counted through sakshi's emit hook.
var _lt_lc_n = 0;
fn _lt_lc_hook(ts, level, category, msg, msg_len, sixth) {
    if (_lc_has(msg, "schema keyword not enforced") == 1) { _lt_lc_n = _lt_lc_n + 1; }
    return 0;
}
fn _lt_lc_begin() { _lt_lc_n = 0; sakshi_set_emit_hook(&_lt_lc_hook); sakshi_set_level(SK_TRACE); return 0; }
fn _lt_lc_end() { sakshi_clear_emit_hook(); sakshi_set_level(SK_ERROR); return 0; }

fn main() {
    alloc_init();

    # ---------------- Registration ----------------
    libro_tools_init(chain_new());
    var reg = tool_registry_new();
    var d = dispatcher_new(reg);
    libro_tools_register(d);

    assert_eq(map_has(dispatcher_handlers(d), "libro_query"), 1, "libro_query registered");
    assert_eq(map_has(dispatcher_handlers(d), "libro_verify"), 1, "libro_verify registered");
    assert_eq(map_has(dispatcher_handlers(d), "libro_export"), 1, "libro_export registered");
    assert_eq(map_has(dispatcher_handlers(d), "libro_proof"), 1, "libro_proof registered");
    assert_eq(map_has(dispatcher_handlers(d), "libro_retention"), 1, "libro_retention registered");

    # ---------------- Handler shape on empty chain ----------------
    # Each tool must return a JSON cstr (not 0, starts with '{').

    var qr = libro_tool_query("{}", 0);
    assert(qr != 0, "query returns non-null");
    assert_eq(load8(qr), 123, "query returns '{'");

    var vr = libro_tool_verify("{}", 0);
    assert(vr != 0, "verify returns non-null");
    assert_eq(load8(vr), 123, "verify returns '{'");

    var er = libro_tool_export("{}", 0);
    assert(er != 0, "export returns non-null");
    assert_eq(load8(er), 123, "export returns '{'");

    # libro_proof requires {"index": N}
    var pr_missing = libro_tool_proof("{}", 0);
    assert(pr_missing != 0, "proof missing index returns non-null");

    var pr_oor = libro_tool_proof("{\"index\":99}", 0);
    assert(pr_oor != 0, "proof OOR returns non-null");

    # libro_retention requires {"policy": "..."}
    var rr_missing = libro_tool_retention("{}", 0);
    assert(rr_missing != 0, "retention missing policy returns non-null");

    var rr_bad = libro_tool_retention("{\"policy\":\"not_a_policy\"}", 0);
    assert(rr_bad != 0, "retention bad policy returns non-null");

    # Each preset policy is addressable (empty chain → 0 archived, 0 retained)
    var rr_pci = libro_tool_retention("{\"policy\":\"pci_dss\"}", 0);
    assert(rr_pci != 0, "retention pci_dss returns non-null");
    var rr_kc = libro_tool_retention("{\"policy\":\"keep_count\",\"value\":10}", 0);
    assert(rr_kc != 0, "retention keep_count returns non-null");

    # ---------------- struct error offsets (3.3.4 regression) ----------------
    #
    # These pin _lt_err_code / _lt_err_msg / _lt_err_index to libro's
    # `struct error` layout. libro 2.8.11 PREPENDED `magic` and grew the
    # record 48 -> 56 bytes, shifting every field +8; bote kept the old
    # offsets through the 2.8.12 bump and read magic-as-code,
    # code-as-msg and field_name-as-index. Because `msg` is handed to
    # `_json_emit_escaped` (which does `load8(cstr + i)`), decoding a
    # tampered chain dereferenced the small integer error CODE as a
    # pointer — SIGSEGV, exit 139.
    #
    # Nothing caught it because every pre-existing assertion above runs
    # the HAPPY path, and `libro_tool_verify` only touches `_lt_err_*`
    # when `chain_verify` returns non-zero — i.e. only on a TAMPERED
    # chain. Mutation check: revert any offset to its pre-2.8.11 value
    # and the matching assertion below turns red.
    var terr = error_integrity(7, str_from("aaa"), str_from("bbb"));
    assert(libro_is_error(terr) == 1, "error_integrity carries the libro magic");
    assert_eq(_lt_err_code(terr), LIBRO_ERR_INTEGRITY, "_lt_err_code reads code, not magic");
    assert_eq(_lt_err_index(terr), 7, "_lt_err_index reads index, not field_name");
    assert_streq(_lt_err_msg(terr), "integrity violation", "_lt_err_msg reads msg cstr, not code");

    # A non-libro pointer must NOT be decoded. This is the guard that
    # turns a future layout move into a defined failure rather than
    # another silent dereference.
    var notanerr = alloc(56);
    store64(notanerr, 0);
    assert_eq(libro_is_error(notanerr), 0, "libro_is_error rejects a foreign record");

    # ---------------- libro_verify on a TAMPERED chain (end-to-end) ----------------
    #
    # The path that crashed. Build a chain, corrupt entry 0's `source`
    # so its recomputed hash no longer matches the stored one, and
    # decode the violation through the real handler.
    var tchain = chain_new();
    chain_append(tchain, SEV_INFO, str_from("bote"), str_from("tool.completed"), str_from("{}"));
    chain_append(tchain, SEV_INFO, str_from("bote"), str_from("tool.failed"), str_from("{}"));
    libro_tools_init(tchain);
    var vclean = libro_tool_verify("{}", 0);
    assert(_lt_shape_ok(vclean, 0) == 1 && streq(_sc(vclean), "{\"ok\":true}") == 1, "verify clean chain reports ok (a CallToolResult, no isError)");

    var e0 = vec_get(load64(tchain), 0);      # struct chain +0 = entries vec
    store64(e0 + 32, str_from("tampered"));   # struct entry +32 = source
    var vres = libro_tool_verify("{}", 0);
    assert(vres != 0, "verify tampered chain returns a result (no SIGSEGV)");
    assert(_lt_shape_ok(vres, 1) == 1, "tampered verify is a CallToolResult with isError (3.4.10)");
    assert_streq(_scf(vres, "ok"), "false", "tampered chain reports ok:false");
    assert_streq(_scf(vres, "message"), "\"integrity violation\"",
      "tampered chain decodes libro's message, not a garbage pointer");

    # ---------------- libro_proof on a POPULATED chain (3.3.4) ----------------
    #
    # Every pre-existing proof assertion above runs against an EMPTY
    # chain, so `libro_tool_proof` always bailed at the range check and
    # merkle_build / merkle_inclusion_proof / merkle_tree_root were never
    # invoked by any test. That matters for this release specifically:
    # libro 2.8.11/2.8.12 changed the Merkle construction (RFC 9162 leaf
    # and internal-node domain tags, and an odd trailing node is now
    # PROMOTED rather than paired with itself), so the emitted root
    # differs from 3.3.3 for identical input. Exercise the real path so a
    # future construction change cannot pass unnoticed.
    var pchain = chain_new();
    chain_append(pchain, SEV_INFO, str_from("bote"), str_from("a"), str_from("{}"));
    chain_append(pchain, SEV_INFO, str_from("bote"), str_from("b"), str_from("{}"));
    chain_append(pchain, SEV_INFO, str_from("bote"), str_from("c"), str_from("{}"));
    libro_tools_init(pchain);

    var pres = libro_tool_proof("{\"index\":1}", 0);
    assert(pres != 0, "proof on populated chain returns a result");
    assert_streq(_scf(pres, "ok"), "true", "proof on populated chain reports ok:true");
    assert_streq(_scf(pres, "leaf_count"), "3", "proof reports the leaf count");
    var proot = jsonx_get_str(_sc(pres), "root");
    assert(proot != 0, "proof emits a root");
    if (proot == 0) { proot = ""; }
    assert_eq(strlen(proot), 64, "proof root is a 64-char sha256 hex digest");

    # An odd leaf count is the case libro's promote-vs-duplicate change
    # touches; index 2 is that trailing node.
    var pres2 = libro_tool_proof("{\"index\":2}", 0);
    assert_streq(_scf(pres2, "ok"), "true", "proof for the odd trailing leaf succeeds");

    # ---------------- 3.4.10: entries carry their real timestamp ----------------
    # libro's entry timestamp is RFC 3339 text. Through 3.4.9 it was printed
    # with str_builder_add_int, so the wire carried the Str's heap address.
    var xr = libro_tool_export("{}", 0);
    var xts = jsonx_get_raw(_sc(xr), "entries");
    if (xts == 0) { xts = ""; }
    assert(_lc_has(xts, "\"timestamp\":\"20") == 1 && _lc_has(xts, "Z\",\"severity\"") == 1,
      "export: each entry's timestamp is its RFC 3339 string, not a number");
    var qts = _scf(libro_tool_query("{\"limit\":1}", 0), "entries");
    assert(_lc_has(qts, "\"timestamp\":\"20") == 1, "query: the same for libro_query");

    # ---------------- 3.4.10: results are CallToolResults; ok:false is isError ----------------
    assert(_lt_shape_ok(libro_tool_query("{}", 0), 0) == 1, "query: a CallToolResult with structuredContent");
    assert(_lt_shape_ok(libro_tool_export("{}", 0), 0) == 1, "export: a CallToolResult with structuredContent");
    assert(_lt_shape_ok(libro_tool_proof("{\"index\":0}", 0), 0) == 1, "proof: a CallToolResult with structuredContent");
    assert(_lt_shape_ok(libro_tool_proof("{}", 0), 1) == 1, "proof without index: isError");
    assert(_lt_shape_ok(libro_tool_proof("{\"index\":99}", 0), 1) == 1, "proof out of range: isError");
    assert(_lt_shape_ok(libro_tool_retention("{\"policy\":\"not_a_policy\"}", 0), 1) == 1, "retention with an unknown policy: isError");

    # ---------------- 3.4.10: retention never runs a keep_* policy without its value ----------------
    # Through 3.4.9 a missing value read as 0: keep_count kept zero entries.
    var before_n = vec_len(load64(pchain));
    var rkc = libro_tool_retention("{\"policy\":\"keep_count\"}", 0);
    assert(_lt_shape_ok(rkc, 1) == 1 && _lc_has(rkc, "missing 'value'") == 1, "retention keep_count without value: refused (isError)");
    assert_eq(vec_len(load64(pchain)), before_n, "...and the chain is untouched (it used to be emptied)");
    assert(_lt_shape_ok(libro_tool_retention("{\"policy\":\"keep_duration\"}", 0), 1) == 1, "retention keep_duration without value: refused");
    assert(_lt_shape_ok(libro_tool_retention("{\"policy\":\"keep_after\"}", 0), 1) == 1, "retention keep_after without value: refused");
    assert(_lt_shape_ok(libro_tool_retention("{\"policy\":\"keep_count\",\"value\":-1}", 0), 1) == 1, "retention with a negative value: refused");
    assert_eq(vec_len(load64(pchain)), before_n, "...and still untouched");
    var rk2 = libro_tool_retention("{\"policy\":\"keep_count\",\"value\":2}", 0);
    assert(_lt_shape_ok(rk2, 0) == 1 && streq(_scf(rk2, "retained"), "2") == 1, "retention keep_count 2 keeps two entries");

    # ---------------- 3.4.15: the integer a handler reads is the one validated ----------------
    assert_eq(_lt_get_int("{\"v\":1e3}", "v"), 1000, "int: 1e3 is 1000, not 13");
    assert_eq(_lt_get_int("{\"v\":1.0}", "v"), 1, "int: 1.0 is 1, not 10");
    assert_eq(_lt_get_int("{\"v\":0.5e1}", "v"), 5, "int: 0.5e1 is 5, not 51");
    assert_eq(_lt_get_int("{\"v\":-0e5}", "v"), 0, "int: -0e5 is 0, not -5");
    assert(_lt_get_int("{\"v\":18446744073709551616}", "v") > 0, "int: 2^64 does not wrap to 0");
    assert(registry_validate_params(reg, "libro_retention", "{\"policy\":\"keep_count\",\"value\":18446744073709551616}") != 0, "int: 2^64 is refused before retention runs");
    assert_eq(registry_validate_params(reg, "libro_retention", "{\"policy\":\"keep_count\",\"value\":1e3}"), 0, "int: 1e3 passes validation as an integer");
    # The audit trail names the configured identity, whatever the client says.
    var aud_chain = chain_new();
    var aud = libro_audit_with_agent_id(libro_audit_new(aud_chain), "service-account");
    libro_audit_log(aud, tool_call_event_new("t", 0, 1, 0, "root@victim"));
    var aud_e = vec_get(_lt_chain_entries(aud_chain), 0);
    assert(streq(str_data(_lt_entry_agent_id(aud_e)), "service-account") == 1, "audit: caller_id cannot choose agent_id");
    assert(_lc_has(str_data(load64(aud_e + 48)), "root@victim") == 1, "audit: ...it stays in the details as a claim");

    # ---------------- 3.4.10: real input schemas, enforced by the dispatcher ----------------
    assert(registry_validate_params(reg, "libro_proof", "{}") != 0, "schema: libro_proof requires index");
    assert(registry_validate_params(reg, "libro_proof", "{\"index\":-1}") != 0, "schema: libro_proof index has minimum 0");
    assert_eq(registry_validate_params(reg, "libro_proof", "{\"index\":2}"), 0, "schema: libro_proof index 2 passes");
    assert(registry_validate_params(reg, "libro_retention", "{}") != 0, "schema: libro_retention requires policy");
    assert(registry_validate_params(reg, "libro_retention", "{\"policy\":\"keep_some\"}") != 0, "schema: libro_retention policy is an enum");
    assert(registry_validate_params(reg, "libro_query", "{\"severity\":9}") != 0, "schema: libro_query severity is at most 5");
    assert(registry_validate_params(reg, "libro_query", "{\"limit\":\"5\"}") != 0, "schema: libro_query limit is an integer");
    assert_eq(registry_validate_params(reg, "libro_query", "{\"source\":\"bote\",\"limit\":5}"), 0, "schema: a well-typed query passes");
    var lst = dispatcher_dispatch(d, req_new("1", "tools/list"), 0);
    var lsr = resp_result(lst);
    if (lsr == 0) { lsr = ""; }
    assert(_lc_has(lsr, "\"required\":[\"index\"]") == 1 && _lc_has(lsr, "\"enum\":[\"keep_count\"") == 1,
      "tools/list publishes the properties and required fields");
    assert(_lc_has(lsr, "\"name\":\"libro_query\",\"description\"") == 1 && _lc_has(lsr, "\"readOnlyHint\":true") == 1,
      "tools/list marks the readers read-only");
    assert(_lc_has(lsr, "\"destructiveHint\":true,\"idempotentHint\":false,\"openWorldHint\":false") == 1,
      "libro_retention is destructive and not open-world");

    # ---------------- 3.8.4: output schemas ----------------
    # Each tool lists what its structuredContent holds, and the dispatcher judges each
    # success by it, on both revisions; an error result is judged by nothing.
    var ols = codec_process_message(_lt_msg("tools/list", "", 0), d, 0);
    var olm = codec_process_message(_lt_msg("tools/list", "", 1), d, 0);
    assert_eq(_lt_occurs(ols, "\"outputSchema\":{\"type\":\"object\",\"properties\":{\"ok\":"), 5, "outputSchema: all five listed (2025-11-25)");
    assert_eq(_lt_occurs(olm, "\"outputSchema\":{\"type\":\"object\",\"properties\":{\"ok\":"), 5, "outputSchema: all five listed (2026-07-28)");
    assert(jsonx_valid(ols, strlen(ols)) == 1 && jsonx_valid(olm, strlen(olm)) == 1, "outputSchema: the list is valid JSON");
    assert(_lc_has(ols, "\"required\":[\"ok\",\"total\",\"entries\"]") == 1, "outputSchema: libro_query requires ok, total and entries");
    assert(_lc_has(ols, "\"required\":[\"ok\",\"index\",\"leaf_count\",\"root\"]") == 1, "outputSchema: libro_proof requires its fields");
    assert(_lc_has(ols, "\"required\":[\"ok\",\"archived\",\"retained\"]") == 1, "outputSchema: libro_retention requires its fields");
    var oc = chain_new();
    chain_append(oc, SEV_INFO, str_from("bote"), str_from("tool.completed"), str_from("{}"));
    chain_append(oc, SEV_WARNING, str_from("bote"), str_from("tool.failed"), str_from("{}"));
    chain_append(oc, SEV_INFO, str_from("other"), str_from("a\"b"), str_from("{}"));
    libro_tools_init(oc);
    var oks = vec_new();
    vec_push(oks, "libro_query"); vec_push(oks, "{}"); vec_push(oks, "\"structuredContent\":{\"ok\":true,\"total\":3,\"entries\":[{");
    vec_push(oks, "libro_query"); vec_push(oks, "{\"source\":\"other\"}"); vec_push(oks, "\"structuredContent\":{\"ok\":true,\"total\":1,");
    vec_push(oks, "libro_export"); vec_push(oks, "{}"); vec_push(oks, "\"structuredContent\":{\"ok\":true,\"count\":3,\"entries\":[{");
    vec_push(oks, "libro_verify"); vec_push(oks, "{}"); vec_push(oks, "\"structuredContent\":{\"ok\":true}");
    vec_push(oks, "libro_proof"); vec_push(oks, "{\"index\":1}"); vec_push(oks, "\"structuredContent\":{\"ok\":true,\"index\":1,\"leaf_count\":3,\"root\":\"");
    vec_push(oks, "libro_retention"); vec_push(oks, "{\"policy\":\"keep_count\",\"value\":10}"); vec_push(oks, "\"structuredContent\":{\"ok\":true,\"archived\":0,\"retained\":3}");
    var oi = 0;
    while (oi < vec_len(oks)) {
        var oname = vec_get(oks, oi);
        var om = 0;
        while (om < 2) {
            var ores = codec_process_message(_lt_msg("tools/call", _lt_call_params(oname, vec_get(oks, oi + 1)), om), d, 0);
            var olabel = _lt_cat3("outputSchema: ", oname, " ");
            olabel = _lt_cat3(olabel, vec_get(oks, oi + 1), " passes its schema");
            if (om == 1) { olabel = _lt_cat3(olabel, " (2026-07-28)", ""); }
            assert(_lc_has(ores, vec_get(oks, oi + 2)) == 1 && _lc_has(ores, "\"isError\":true") == 0, olabel);
            om = om + 1;
        }
        oi = oi + 3;
    }
    # A failure is an error result, sent as the tool made it.
    var ofail = codec_process_message(_lt_msg("tools/call", _lt_call_params("libro_proof", "{\"index\":99}"), 1), d, 0);
    assert(_lc_has(ofail, "\"isError\":true") == 1 && _lc_has(ofail, "index out of range") == 1 && _lc_has(ofail, "structuredContent") == 0,
      "outputSchema: a failure is an error result with no structuredContent (3.8.5: it carried one its schema refuses)");
    # Every error result a libro tool sends holds no structuredContent, or one its schema takes:
    # a client that judges an error result's (the v1 TypeScript SDK's) refused them through 3.8.4.
    libro_tools_init(chain_new());
    var errs = vec_new();
    vec_push(errs, "libro_proof"); vec_push(errs, libro_tool_proof("{\"index\":0}", 0));
    vec_push(errs, "libro_proof"); vec_push(errs, libro_tool_proof("{}", 0));
    vec_push(errs, "libro_retention"); vec_push(errs, libro_tool_retention("{\"policy\":\"keep_count\"}", 0));
    vec_push(errs, "libro_retention"); vec_push(errs, libro_tool_retention("{\"policy\":\"nope\"}", 0));
    var ebc = chain_new();
    chain_append(ebc, SEV_INFO, str_from("bote"), str_from("x"), str_from("{}"));
    chain_append(ebc, SEV_INFO, str_from("bote"), str_from("y"), str_from("{}"));
    store64(vec_get(load64(ebc), 0) + 32, str_from("tampered"));
    libro_tools_init(ebc);
    vec_push(errs, "libro_verify"); vec_push(errs, libro_tool_verify("{}", 0));
    libro_tools_init(0);
    vec_push(errs, "libro_query"); vec_push(errs, libro_tool_query("{}", 0));
    vec_push(errs, "libro_export"); vec_push(errs, libro_tool_export("{}", 0));
    var eok = 0;
    var ei = 0;
    while (ei < vec_len(errs)) {
        var er = vec_get(errs, ei + 1);
        var esc = jsonx_get_raw(er, "structuredContent");
        var eprop = tool_def_output_prop(registry_get(reg, vec_get(errs, ei)));
        if (_lc_has(er, "\"isError\":true") == 1 && (esc == 0 || _sch_check_value_a(bote_req_begin(), eprop, "structuredContent", esc) == 0)) { eok = eok + 1; }
        ei = ei + 2;
    }
    assert_eq(eok, 7, "outputSchema: seven error results, each holding none or one its schema takes");
    assert(jsonx_get_raw(vec_get(errs, 9), "structuredContent") != 0, "outputSchema: ...a broken chain's verify keeping the index it names");
    var ovf = chain_new();
    chain_append(ovf, SEV_INFO, str_from("bote"), str_from("x"), str_from("{}"));
    chain_append(ovf, SEV_INFO, str_from("bote"), str_from("y"), str_from("{}"));
    store64(vec_get(load64(ovf), 0) + 32, str_from("tampered"));
    libro_tools_init(ovf);
    var obroke = codec_process_message(_lt_msg("tools/call", _lt_call_params("libro_verify", "{}"), 0), d, 0);
    assert(_lc_has(obroke, "\"isError\":true") == 1 && _lc_has(obroke, "\"ok\":false,\"code\":") == 1, "outputSchema: a broken chain's verify goes as its error result");
    # An entry with no time is null, which the schema allows.
    var onull = chain_new();
    chain_append(onull, SEV_INFO, str_from("bote"), str_from("x"), str_from("{}"));
    store64(vec_get(load64(onull), 0) + 16, 0);
    libro_tools_init(onull);
    var onr = codec_process_message(_lt_msg("tools/call", _lt_call_params("libro_export", "{}"), 1), d, 0);
    assert(_lc_has(onr, "\"timestamp\":null") == 1 && _lc_has(onr, "\"isError\":true") == 0, "outputSchema: an entry with no time, null, passes");
    # The schemas have teeth: what drift in libro's layout would send is refused. (A
    # timestamp's type array, string or null, is the client's to judge: bote does not
    # enforce a type array yet.)
    var oa = bote_req_begin();
    var oqp = tool_def_output_prop(registry_get(reg, "libro_query"));
    var oent = "{\"timestamp\":\"2026-01-01T00:00:00Z\",\"severity\":1,\"source\":\"s\",\"action\":\"a\",\"agent_id\":\"\",\"hash\":\"h\"}";
    assert(_sch_check_value_a(oa, oqp, "structuredContent", _lt_cat3("{\"ok\":true,\"total\":1,\"entries\":[", oent, "]}")) == 0, "outputSchema: a good query result has no violation");
    var obad = vec_new();
    vec_push(obad, "{\"ok\":true,\"total\":1}");
    vec_push(obad, "{\"ok\":true,\"total\":-1,\"entries\":[]}");
    vec_push(obad, "{\"ok\":true,\"total\":1,\"entries\":[{\"timestamp\":null,\"severity\":\"1\",\"source\":\"s\",\"action\":\"a\",\"agent_id\":\"\",\"hash\":\"h\"}]}");
    vec_push(obad, "{\"ok\":true,\"total\":1,\"entries\":[{\"timestamp\":null,\"severity\":1,\"source\":\"s\",\"action\":\"a\",\"agent_id\":\"\"}]}");
    vec_push(obad, "{\"ok\":\"true\",\"total\":1,\"entries\":[]}");
    var obi = 0;
    while (obi < vec_len(obad)) {
        assert(_sch_check_value_a(oa, oqp, "structuredContent", vec_get(obad, obi)) != 0, _lt_cat3("outputSchema: refused: ", vec_get(obad, obi), ""));
        obi = obi + 1;
    }
    # Registration warns of nothing: each schema holds only keywords bote judges where it warns.
    _lt_lc_begin();
    libro_tools_register(dispatcher_new(tool_registry_new()));
    _lt_lc_end();
    assert_eq(_lt_lc_n, 0, "outputSchema: registration warns of no keyword");

    # Restore the shared chain the earlier assertions installed.
    libro_tools_init(chain_new());

    # ---------------- Handler fn pointers are addressable ----------------
    assert(&libro_tool_query != 0, "query fp addressable");
    assert(&libro_tool_verify != 0, "verify fp addressable");
    assert(&libro_tool_export != 0, "export fp addressable");
    assert(&libro_tool_proof != 0, "proof fp addressable");
    assert(&libro_tool_retention != 0, "retention fp addressable");

    return assert_summary();
}

var rc = main();
sys_exit(rc);
