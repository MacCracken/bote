fn h_tool(args, claims) { return "{\"content\":[{\"type\":\"text\",\"text\":\"ok\"}]}"; }
var _ret = 0;
fn h_ret(args, claims) { return _ret; }

fn _cat(a, b) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    return str_data(str_builder_build(sb));
}
fn _cat3(a, b, c) { return _cat(_cat(a, b), c); }
fn _has(s, sub) { if (s != 0 && strstr(s, sub) >= 0) { return 1; } return 0; }
fn _vs(schema, value) { return _sch_check_value_a(bote_req_begin(), parse_property(schema), "v", value); }
fn _ok(schema, value) { if (_vs(schema, value) == 0) { return 1; } return 0; }
fn _n(schema, value) {
    var v = _vs(schema, value);
    if (v == 0) { return 0; }
    return vec_len(v);
}
fn _v0(schema, value) {
    var v = _vs(schema, value);
    if (v == 0) { return "(none)"; }
    return _cat(vec_get(v, 0), "");
}
fn _ase(got, want, name) {
    if (got == 0 || want == 0) { return assert(got == want, name); }
    return assert_streq(got, want, name);
}
fn _msg(method, params) {
    return _cat3(_cat3("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"", method, "\",\"params\":{"), params, "}}");
}
fn _call(d, tool, args) {
    return codec_process_message(_msg("tools/call", _cat3(_cat3("\"name\":\"", tool, "\",\"arguments\":"), args, "")), d, 0);
}
# An array of n items, each `item`.
fn _many(n, item) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "[");
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, item);
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]");
    return str_data(str_builder_build(sb));
}

var _lc_all = 0;
fn _rep_s(x, n) {
    var sb = str_builder_new();
    var i = 0;
    while (i < n) { str_builder_add_cstr(sb, x); i = i + 1; }
    return str_data(str_builder_build(sb));
}
fn _lc_hook(ts, level, category, msg, msg_len, sixth) {
    var n = msg_len;
    if (n > 1023) { n = 1023; }
    var b = alloc(n + 1);
    memcpy(b, msg, n);
    store8(b + n, 0);
    vec_push(_lc_all, b);
    return 0;
}
fn _lc_begin() { _lc_all = vec_new(); sakshi_set_emit_hook(&_lc_hook); sakshi_set_level(SK_TRACE); return 0; }
fn _lc_end() { sakshi_clear_emit_hook(); sakshi_set_level(SK_ERROR); return 0; }
fn _lc_find(sub) {
    var i = 0;
    while (i < vec_len(_lc_all)) {
        if (_has(vec_get(_lc_all, i), sub) == 1) { return vec_get(_lc_all, i); }
        i = i + 1;
    }
    return 0;
}

# (3.8.10) The fewest nanoseconds of three judgements of `value` by `prop`, and of three calls
# of `tool`: a bound on a judgement's time is a multiple of one of these, measured in the same
# process, so it holds under emulation as on the host.
fn _ns3(prop, value) {
    var best = 0;
    var i = 0;
    while (i < 3) {
        var t = clock_now_ns();
        _sch_check_value_a(bote_req_begin(), prop, "v", value);
        var dt = clock_now_ns() - t;
        if (i == 0 || dt < best) { best = dt; }
        i = i + 1;
    }
    return best;
}
fn _call_ns3(d, msg) {
    var best = 0;
    var i = 0;
    while (i < 3) {
        var t = clock_now_ns();
        codec_process_message_a(bote_req_begin(), msg, d, 0);
        var dt = clock_now_ns() - t;
        if (i == 0 || dt < best) { best = dt; }
        i = i + 1;
    }
    return best;
}


# A string format's verdict on the JSON string `json` (its quotes included), against the client's.
fn _fs(f, json, want) {
    var id = bote_format_id(f);
    var got = bote_format_test_a(bote_req_begin(), id, json, 1, strlen(json) - 1, 0);
    return assert_eq(got, want, _cat3(_cat3("format ", f, ": "), json, ""));
}
# A number format's verdict on the JSON number `t`.
fn _fn(f, t, want) {
    return assert_eq(bote_format_number(bote_format_id(f), t), want, _cat3(_cat3("format ", f, ": "), t, ""));
}
# One the client's double takes and bote, exact, refuses.
fn _fnx(f, t) {
    return assert_eq(bote_format_number(bote_format_id(f), t), 0, _cat3(_cat3("format ", f, ": "), t, " refused exactly, which the client's double takes"));
}
fn _bfm_ns3(id, json) {
    var best = 0;
    var i = 0;
    while (i < 3) {
        var t = clock_now_ns();
        bote_format_test_a(bote_req_begin(), id, json, 1, strlen(json) - 1, 0);
        var dt = clock_now_ns() - t;
        if (i == 0 || dt < best) { best = dt; }
        i = i + 1;
    }
    return best;
}
fn _qrep(x, n) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "\"");
    var i = 0;
    while (i < n) { str_builder_add_cstr(sb, x); i = i + 1; }
    return sb;
}
fn _qend(sb, tail) {
    str_builder_add_cstr(sb, tail);
    str_builder_add_cstr(sb, "\"");
    return str_data(str_builder_build(sb));
}
var _th_rx = 0;
fn _th_ready(arg) {
    store64(arg, _bfm_rx(BOTE_FMT_IPV6));
    return 0;
}

fn main() {
    alloc_init();

    # ---- names and kinds ----
    var id = 1;
    var named = 1;
    while (id <= BOTE_FMT_COUNT) {
        if (bote_format_id(bote_format_name(id)) != id) { named = 0; }
        id = id + 1;
    }
    assert(named == 1, "names: each of the 26 formats by its name");
    assert(bote_format_id("idn-email") == 0 && bote_format_id("iri") == 0 && bote_format_id("Email") == 0 && bote_format_id("") == 0 && bote_format_id(0) == 0, "names: one the client does not know, or a name in another case, is none");
    assert(bote_format_kind(BOTE_FMT_REGEX) == 0 && bote_format_kind(0) == 0, "kinds: regex judges nothing here");
    assert(bote_format_kind(BOTE_FMT_INT32) == 2 && bote_format_kind(BOTE_FMT_DOUBLE) == 2 && bote_format_kind(BOTE_FMT_EMAIL) == 1 && bote_format_kind(BOTE_FMT_BINARY) == 1, "kinds: numbers and strings");
    assert(bote_format_ordered(BOTE_FMT_DATE) == 1 && bote_format_ordered(BOTE_FMT_ISO_DATE_TIME) == 1 && bote_format_ordered(BOTE_FMT_DURATION) == 0 && bote_format_ordered(BOTE_FMT_EMAIL) == 0, "kinds: the dates and times have an order");

    # ---- each format, as the client judges it ----
    _fs("date", "\"2020-01-31\"", 1);
    _fs("date", "\"2020-02-29\"", 1);
    _fs("date", "\"2019-02-29\"", 0);
