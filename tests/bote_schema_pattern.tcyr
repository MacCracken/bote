# bote_schema_pattern.tcyr — `pattern` and `multipleOf` judged (3.8.11): a pattern on a
# string, decoded as JSON decodes it, one bote's engine declines judging nothing, under
# composition and `propertyNames`, through the dispatcher and a result; `multipleOf` exactly,
# as decimals, past 2^64 and a double's range, zero, negative, too many digits; the budget,
# each step a match takes and each digit read charged; the WARNs; the heap and the arena.
#
# Run: cyrius test tests/bote_schema_pattern.tcyr

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"
include "lib/fnptr.cyr"
include "lib/chrono.cyr"
include "lib/tagged.cyr"
include "lib/net.cyr"
include "lib/async.cyr"
include "lib/fdlopen.cyr"
include "lib/tls.cyr"
include "lib/sandhi.cyr"
include "lib/freelist.cyr"
include "lib/thread.cyr"
include "lib/thread_local.cyr"  # sigil 3.7.14 TLS crypto_scratch — SIGILL guard
include "lib/sakshi.cyr"
include "lib/sigil.cyr"
include "lib/patra.cyr"
include "lib/libro.cyr"
include "lib/majra.cyr"
include "lib/assert.cyr"
include "src/log.cyr"
include "src/error.cyr"
include "src/protocol.cyr"
include "src/jsonx.cyr"
include "src/regex.cyr"
include "src/format.cyr"
include "src/registry.cyr"
include "src/prompts.cyr"
include "src/resources.cyr"
include "src/events.cyr"
include "src/audit.cyr"
include "src/audit_libro.cyr"
include "src/events_majra.cyr"
include "src/dispatch.cyr"
include "src/codec.cyr"
include "src/schema.cyr"
include "src/stream.cyr"
include "src/session.cyr"
include "src/discovery.cyr"
include "src/auth.cyr"
include "src/conn.cyr"
include "src/fetch.cyr"
include "src/http_era.cyr"
include "src/oauth_metadata.cyr"
include "src/listen.cyr"
include "src/transport_stdio.cyr"
include "src/transport_http.cyr"
include "src/transport_unix.cyr"
include "src/bridge.cyr"
include "src/transport_streamable.cyr"
include "src/transport_ws.cyr"

fn h_tool(args, claims) { return "{\"content\":[{\"type\":\"text\",\"text\":\"ok\"}]}"; }
var _ret = 0;
fn h_ret(args, claims) { return _ret; }

fn _cat(a, b) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    return str_data(str_builder_build(sb));
}
fn _cat3(a, b, c) { return _cat(_cat(a, b), c); }
fn _has(s, sub) { if (s != 0 && strstr(s, sub) >= 0) { return 1; } return 0; }
fn _why(os) {
    var w = registry_check_tool_def(tool_def_with_output_schema(tool_def_new("t_why", "d", schema_new("object", 0, vec_new())), os));
    if (w == 0) { return "(none)"; }
    return w;
}
fn _vs(schema, value) { return _sch_check_value_a(bote_req_begin(), parse_property(schema), "v", value); }
fn _ok(schema, value) { if (_vs(schema, value) == 0) { return 1; } return 0; }
fn _n(schema, value) {
    var v = _vs(schema, value);
    if (v == 0) { return 0; }
    return vec_len(v);
}
fn _v0(schema, value) {
    var v = _vs(schema, value);
    if (v == 0) { return "(none)"; }
    return _cat(vec_get(v, 0), "");
}
fn _ase(got, want, name) {
    if (got == 0 || want == 0) { return assert(got == want, name); }
    return assert_streq(got, want, name);
}
fn _msg(method, params) {
    return _cat3(_cat3("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"", method, "\",\"params\":{"), params, "}}");
}
fn _call(d, tool, args) {
    return codec_process_message(_msg("tools/call", _cat3(_cat3("\"name\":\"", tool, "\",\"arguments\":"), args, "")), d, 0);
}
# An array of n items, each `item`.
fn _many(n, item) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "[");
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, item);
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]");
    return str_data(str_builder_build(sb));
}

var _lc_all = 0;
fn _rep_s(x, n) {
    var sb = str_builder_new();
    var i = 0;
    while (i < n) { str_builder_add_cstr(sb, x); i = i + 1; }
    return str_data(str_builder_build(sb));
}
fn _lc_hook(ts, level, category, msg, msg_len, sixth) {
    var n = msg_len;
    if (n > 1023) { n = 1023; }
    var b = alloc(n + 1);
    memcpy(b, msg, n);
    store8(b + n, 0);
    vec_push(_lc_all, b);
    return 0;
}
fn _lc_begin() { _lc_all = vec_new(); sakshi_set_emit_hook(&_lc_hook); sakshi_set_level(SK_TRACE); return 0; }
fn _lc_end() { sakshi_clear_emit_hook(); sakshi_set_level(SK_ERROR); return 0; }
fn _lc_find(sub) {
    var i = 0;
    while (i < vec_len(_lc_all)) {
        if (_has(vec_get(_lc_all, i), sub) == 1) { return vec_get(_lc_all, i); }
        i = i + 1;
    }
    return 0;
}

# (3.8.10) The fewest nanoseconds of three judgements of `value` by `prop`, and of three calls
# of `tool`: a bound on a judgement's time is a multiple of one of these, measured in the same
# process, so it holds under emulation as on the host.
fn _ns3(prop, value) {
    var best = 0;
    var i = 0;
    while (i < 3) {
        var t = clock_now_ns();
        _sch_check_value_a(bote_req_begin(), prop, "v", value);
        var dt = clock_now_ns() - t;
        if (i == 0 || dt < best) { best = dt; }
        i = i + 1;
    }
    return best;
}
fn _call_ns3(d, msg) {
    var best = 0;
    var i = 0;
    while (i < 3) {
        var t = clock_now_ns();
        codec_process_message_a(bote_req_begin(), msg, d, 0);
        var dt = clock_now_ns() - t;
        if (i == 0 || dt < best) { best = dt; }
        i = i + 1;
    }
    return best;
}


fn main() {
    alloc_init();

    # ---- pattern ----
    var pa = "{\"pattern\":\"^a\"}";
    assert(_ok(pa, "\"ab\"") == 1, "pattern: a string it matches");
    _ase(_v0(pa, "\"ba\""), "v: does not match the pattern", "pattern: one it does not");
    assert(_ok(pa, "5") == 1 && _ok(pa, "{}") == 1 && _ok(pa, "null") == 1, "pattern: judges strings only");
    assert(_ok("{\"pattern\":\"^\\\\d+$\"}", "\"123\"") == 1 && _ok("{\"pattern\":\"^\\\\d+$\"}", "\"12a\"") == 0, "pattern: its escapes decoded as JSON first");
    assert(_ok("{\"pattern\":\"^\\u00e9$\"}", "\"\\u00e9\"") == 1, "pattern: ...a \\u in the JSON, and in the value");
    assert(_ok("{\"pattern\":\"b\"}", "\"abc\"") == 1 && _ok("{\"pattern\":\"^b$\"}", "\"abc\"") == 0, "pattern: anywhere, as JSON Schema has it");
    assert(_ok("{\"pattern\":\"^.{3}$\"}", "\"\xc3\xa9t\xc3\xa9\"") == 1, "pattern: code points, as the client's u flag reads them");
    assert(_ok("{\"pattern\":\"(?=a)\"}", "\"b\"") == 1, "pattern: one bote's engine declines judges nothing");
    assert(_ok("{\"pattern\":\"[\"}", "\"b\"") == 1, "pattern: ...nor one no client can compile");
    assert(_ok("{\"pattern\":5}", "\"b\"") == 1, "pattern: ...nor one that is no string");
    assert(_ok("{\"type\":\"string\",\"pattern\":\"^x\",\"maxLength\":2}", "\"yyy\"") == 0, "pattern: beside the lengths");
    assert_eq(_n("{\"type\":\"string\",\"pattern\":\"^x\",\"maxLength\":2}", "\"yyy\""), 2, "pattern: ...each its own violation");
    var an = "{\"anyOf\":[{\"pattern\":\"^[0-9]+$\"},{\"pattern\":\"^[a-z]+$\"}]}";
    assert(_ok(an, "\"123\"") == 1 && _ok(an, "\"abc\"") == 1 && _ok(an, "\"a1\"") == 0, "pattern: under anyOf, quietly");
    assert(_ok("{\"not\":{\"pattern\":\"x\"}}", "\"axb\"") == 0 && _ok("{\"not\":{\"pattern\":\"x\"}}", "\"ab\"") == 1, "pattern: under not");
    var pn = "{\"propertyNames\":{\"pattern\":\"^[a-z_]+$\"}}";
    assert(_ok(pn, "{\"ab_c\":1}") == 1 && _ok(pn, "{\"Ab\":1}") == 0, "pattern: on propertyNames, each key");
    assert(_ok(pn, "{\"a\\u0062\":1}") == 1, "pattern: ...a key as it decodes");
    var d = dispatcher_new(tool_registry_new());
    dispatcher_register_tool(d, tool_def_new("t_pat", "d", tool_schema_from_json("{\"type\":\"object\",\"properties\":{\"slug\":{\"type\":\"string\",\"pattern\":\"^[a-z0-9]+(?:-[a-z0-9]+)*$\"}},\"required\":[\"slug\"]}")), &h_tool);
    assert(_has(_call(d, "t_pat", "{\"slug\":\"a-b-1\"}"), "\"text\":\"ok\"") == 1, "pattern: an argument met, through the dispatcher");
    assert(_has(_call(d, "t_pat", "{\"slug\":\"a--b\"}"), "slug: does not match the pattern") == 1, "pattern: ...and refused");
    dispatcher_register_tool(d, tool_def_with_output_schema(tool_def_new("t_pout", "d", schema_new("object", 0, vec_new())), "{\"type\":\"object\",\"properties\":{\"id\":{\"pattern\":\"^id-\\\\d+$\"}}}"), &h_ret);
    _ret = "{\"content\":[],\"structuredContent\":{\"id\":\"id-7\"}}";
    assert(_has(_call(d, "t_pout", "{}"), "isError") == 0, "pattern: a result met");
    _ret = "{\"content\":[],\"structuredContent\":{\"id\":\"id-x\"}}";
    assert(_has(_call(d, "t_pout", "{}"), "structuredContent.id: does not match the pattern") == 1, "pattern: ...and refused");

    # ---- multipleOf, exactly ----
    var mv = vec_new();
    vec_push(mv, "19.99"); vec_push(mv, "0.01"); vec_push(mv, "1");
    vec_push(mv, "0.3"); vec_push(mv, "0.1"); vec_push(mv, "1");
    vec_push(mv, "7"); vec_push(mv, "2"); vec_push(mv, "0");
    vec_push(mv, "10"); vec_push(mv, "4"); vec_push(mv, "0");
    vec_push(mv, "20"); vec_push(mv, "4"); vec_push(mv, "1");
    vec_push(mv, "123456789012345678901234567890"); vec_push(mv, "10"); vec_push(mv, "1");
    vec_push(mv, "123456789012345678901234567890"); vec_push(mv, "9"); vec_push(mv, "1");
    vec_push(mv, "123456789012345678901234567891"); vec_push(mv, "9"); vec_push(mv, "0");
    vec_push(mv, "1e-5"); vec_push(mv, "1e-6"); vec_push(mv, "1");
    vec_push(mv, "1e-6"); vec_push(mv, "1e-5"); vec_push(mv, "0");
    vec_push(mv, "-6"); vec_push(mv, "3"); vec_push(mv, "1");
    vec_push(mv, "2.5"); vec_push(mv, "0.5"); vec_push(mv, "1");
    vec_push(mv, "2.5"); vec_push(mv, "2"); vec_push(mv, "0");
    vec_push(mv, "0.0075"); vec_push(mv, "0.0025"); vec_push(mv, "1");
    vec_push(mv, "1.0000000000000000001"); vec_push(mv, "0.0000000000000000001"); vec_push(mv, "1");
    vec_push(mv, "99999999999999999"); vec_push(mv, "99999999999999999"); vec_push(mv, "1");
    vec_push(mv, "3e30"); vec_push(mv, "1.5"); vec_push(mv, "1");
    vec_push(mv, "1e400"); vec_push(mv, "2"); vec_push(mv, "1");
    vec_push(mv, "1e400"); vec_push(mv, "3"); vec_push(mv, "0");
    vec_push(mv, "0"); vec_push(mv, "7"); vec_push(mv, "1");
    vec_push(mv, "-0.0"); vec_push(mv, "7"); vec_push(mv, "1");
    vec_push(mv, "5"); vec_push(mv, "2.5e0"); vec_push(mv, "1");
    vec_push(mv, "6"); vec_push(mv, "1e1"); vec_push(mv, "0");
    vec_push(mv, "60"); vec_push(mv, "1E1"); vec_push(mv, "1");
    vec_push(mv, "1e-400"); vec_push(mv, "1"); vec_push(mv, "0");
    vec_push(mv, "1e30"); vec_push(mv, "1048576"); vec_push(mv, "1");
    vec_push(mv, "1e70"); vec_push(mv, "72057594037927936"); vec_push(mv, "1");
    vec_push(mv, "1e55"); vec_push(mv, "72057594037927936"); vec_push(mv, "0");
    vec_push(mv, "1"); vec_push(mv, "99999999999999999"); vec_push(mv, "0");
    var mi = 0;
    while (mi < vec_len(mv)) {
        var ms = _cat3("{\"multipleOf\":", vec_get(mv, mi + 1), "}");
        var want = 0;
        if (streq(vec_get(mv, mi + 2), "1") == 1) { want = 1; }
        assert_eq(_ok(ms, vec_get(mv, mi)), want, _cat3(_cat3("multipleOf: ", vec_get(mv, mi), " of "), vec_get(mv, mi + 1), ""));
        mi = mi + 3;
    }
    _ase(_v0("{\"multipleOf\":2}", "7"), "v: not a multiple of multipleOf", "multipleOf: the violation");
    assert(_ok("{\"multipleOf\":0}", "0") == 0 && _ok("{\"multipleOf\":0}", "5") == 0, "multipleOf: 0, which no number meets, as the official client has it");
    assert(_ok("{\"multipleOf\":-3}", "6") == 1 && _ok("{\"multipleOf\":-3}", "7") == 0, "multipleOf: below 0, judged by its size, as the client judges it");
    assert(_ok("{\"multipleOf\":123456789012345678}", "1") == 1, "multipleOf: past 17 significant digits judges nothing");
    assert(_ok("{\"multipleOf\":\"2\"}", "1") == 1, "multipleOf: one that is no number judges nothing");
    assert(_ok("{\"multipleOf\":2}", "\"3\"") == 1 && _ok("{\"multipleOf\":2}", "true") == 1, "multipleOf: numbers only");
    assert(_ok("{\"type\":\"integer\",\"multipleOf\":5,\"maximum\":20}", "25") == 0 && _ok("{\"type\":\"integer\",\"multipleOf\":5,\"maximum\":20}", "15") == 1, "multipleOf: beside the bounds");
    dispatcher_register_tool(d, tool_def_new("t_mul", "d", tool_schema_from_json("{\"type\":\"object\",\"properties\":{\"price\":{\"type\":\"number\",\"multipleOf\":0.01}}}")), &h_tool);
    assert(_has(_call(d, "t_mul", "{\"price\":19.99}"), "\"text\":\"ok\"") == 1, "multipleOf: 19.99 for 0.01 met, which the official client's doubles refuse");
    assert(_has(_call(d, "t_mul", "{\"price\":19.995}"), "price: not a multiple of multipleOf") == 1, "multipleOf: ...19.995 refused");

    # ---- the budget ----
    var big = str_builder_new();
    str_builder_add_cstr(big, "\"");
    var bi = 0;
    while (bi < 60000) { str_builder_add_cstr(big, "a"); bi = bi + 1; }
    str_builder_add_cstr(big, "!\"");
    var bigs = str_data(str_builder_build(big));
    assert(_ok("{\"pattern\":\"^(a|b)*!$\"}", bigs) == 1, "budget: one pattern over 60 KB, judged");
    var alt = str_builder_new();
    str_builder_add_cstr(alt, "{\"anyOf\":[");
    bi = 0;
    while (bi < 256) { if (bi > 0) { str_builder_add_cstr(alt, ","); } str_builder_add_cstr(alt, "{\"pattern\":\"^(a|aa)*c\"}"); bi = bi + 1; }
    str_builder_add_cstr(alt, "]}");
    var ap = parse_property(str_data(str_builder_build(alt)));
    var av = _sch_check_value_a(bote_req_begin(), ap, "v", bigs);
    assert(av != 0 && streq(vec_get(av, vec_len(av) - 1), "v: more work to judge than its size allows") == 1, "budget: 256 patterns over 60 KB refused as too much to judge");
    assert(_ns3(ap, bigs) < 64 * _ns3(parse_property("{\"anyOf\":[{\"pattern\":\"^(a|aa)*c\"}]}"), bigs), "budget: ...in under 64 times one pattern's time");
    var dg = str_builder_new();
    str_builder_add_cstr(dg, "1");
    bi = 0;
    while (bi < 200000) { str_builder_add_cstr(dg, "0000000000"); bi = bi + 10; }
    var digs = str_data(str_builder_build(dg));
    var ma = str_builder_new();
    str_builder_add_cstr(ma, "{\"anyOf\":[");
    bi = 0;
    while (bi < 256) { if (bi > 0) { str_builder_add_cstr(ma, ","); } str_builder_add_cstr(ma, "{\"multipleOf\":7}"); bi = bi + 1; }
    str_builder_add_cstr(ma, "]}");
    var mp = parse_property(str_data(str_builder_build(ma)));
    var mvv = _sch_check_value_a(bote_req_begin(), mp, "v", digs);
    assert(mvv != 0 && streq(vec_get(mvv, vec_len(mvv) - 1), "v: more work to judge than its size allows") == 1, "budget: a 200,000-digit number under 256 multipleOf alternatives refused");
    assert(_ns3(mp, digs) < 64 * _ns3(parse_property("{\"anyOf\":[{\"multipleOf\":7}]}"), digs), "budget: ...in under 64 times one alternative's time");

    # ---- the WARNs ----
    _lc_begin();
    var wd = dispatcher_new(tool_registry_new());
    dispatcher_register_tool(wd, tool_def_with_output_schema(tool_def_new("w_p", "d", schema_new("object", 0, vec_new())), "{\"type\":\"object\",\"properties\":{\"a\":{\"pattern\":\"(?<=x)y\"},\"e\":{\"multipleOf\":0},\"f\":{\"multipleOf\":-2},\"g\":{\"multipleOf\":0.01},\"h\":{\"multipleOf\":123456789012345678}}}"), &h_ret);
    dispatcher_register_tool(wd, tool_def_with_output_schema(tool_def_new("w_ok", "d", schema_new("object", 0, vec_new())), "{\"type\":\"object\",\"properties\":{\"a\":{\"pattern\":\"^[a-z]+$\"},\"b\":{\"multipleOf\":5},\"c\":{\"multipleOf\":2.5e1}}}"), &h_ret);
    dispatcher_register_tool(wd, tool_def_with_output_schema(tool_def_new("w_pp", "d", schema_new("object", 0, vec_new())), "{\"type\":\"object\",\"properties\":{\"a\":{\"patternProperties\":{\"(?<=x)y\":{}},\"additionalProperties\":false}}}"), &h_ret);
    dispatcher_register_tool(wd, tool_def_with_output_schema(tool_def_new("w_ppok", "d", schema_new("object", 0, vec_new())), "{\"type\":\"object\",\"patternProperties\":{\"^x\":{}},\"additionalProperties\":false}"), &h_ret);
    _lc_end();
    assert(_lc_find("pattern bote's engine does not take, for a lookbehind") != 0, "warn: a pattern the engine declines, and why");
    # (3.8.14, from the 3.8.13 review) What the official client cannot compile registration
    # refuses, where through 3.8.13 it warned: a pattern JavaScript refuses with the u flag,
    # and a pattern, a multipleOf or a patternProperties of the wrong kind.
    assert(_has(_why("{\"type\":\"object\",\"properties\":{\"b\":{\"pattern\":\"[\"}}}"), "names a pattern JavaScript refuses with the u flag, which the official client cannot compile: an unterminated character class") == 1, "register: a pattern no client compiles refused, where 3.8.13 warned");
    assert(_has(_why("{\"type\":\"object\",\"properties\":{\"c\":{\"pattern\":5}}}"), "names pattern with a value of a kind the official client refuses (it takes a string)") == 1, "register: a pattern that is no string refused");
    assert(_has(_why("{\"type\":\"object\",\"properties\":{\"d\":{\"multipleOf\":\"2\"}}}"), "names multipleOf with a value of a kind the official client refuses (it takes a number)") == 1, "register: a multipleOf that is no number refused");
    assert(_has(_why("{\"type\":\"object\",\"properties\":{\"b\":{\"patternProperties\":[1]}}}"), "names patternProperties with a value of a kind the official client refuses (it takes an object)") == 1, "register: patternProperties that is no object refused");
    assert(_lc_find("multipleOf 0, which no number meets") != 0, "warn: 0");
    assert(_lc_find("multipleOf below 0") != 0, "warn: below 0");
    assert(_lc_find("multipleOf that is no integer") != 0, "warn: a fraction, which a client's doubles may judge otherwise");
    assert(_lc_find("multipleOf of more than 17 significant digits") != 0, "warn: too many digits");
    assert(_lc_find("tool=w_ok") == 0, "warn: none for a pattern taken, an integer multipleOf, 2.5e1");
    assert(_lc_find("keyword=pattern") == 0 && _lc_find("keyword=multipleOf") == 0, "warn: neither as unenforced");
    assert(_lc_find("a patternProperties pattern bote's engine does not take, for a lookbehind") != 0, "warn: patternProperties declining a pattern, and why (3.8.12)");
    assert(_lc_find("additionalProperties beside a pattern bote's engine does not take, which judges nothing") != 0, "warn: ...and additionalProperties beside it");
    assert(_lc_find("tool=w_ppok") == 0, "warn: none for patternProperties and additionalProperties both judged");
    # (3.8.13, from the 3.8.12 review) Two groups of one name, which Node before 23 refuses.
    _lc_begin();
    dispatcher_register_tool(wd, tool_def_with_output_schema(tool_def_new("w_dn", "d", schema_new("object", 0, vec_new())), "{\"type\":\"object\",\"properties\":{\"a\":{\"pattern\":\"(?<y>\\\\d{4})|(?<y>\\\\d{2})\"},\"b\":{\"patternProperties\":{\"(?<k>x)|(?<k>y)\":{}}},\"c\":{\"pattern\":\"(?<y>a)(?<z>b)\"}}}"), &h_ret);
    _lc_end();
    assert(_has(_lc_find("property=outputSchema.a"), "pattern naming two groups alike, which Node before 23 refuses whole") == 1, "warn: a pattern naming two groups alike");
    assert(_has(_lc_find("property=outputSchema.b"), "patternProperties pattern naming two groups alike") == 1, "warn: ...as a patternProperties pattern");
    assert(_lc_find("property=outputSchema.c") == 0, "warn: none for two names");
    # Registration keeps a pattern's program once: 100 of 4,005 steps.
    var rhb = str_builder_new();
    str_builder_add_cstr(rhb, "{\"type\":\"object\",\"patternProperties\":{");
    var rhi = 0;
    while (rhi < 100) { if (rhi > 0) { str_builder_add_cstr(rhb, ","); } str_builder_add_cstr(rhb, "\"^p"); str_builder_add_int(rhb, rhi); str_builder_add_cstr(rhb, ".{0,2000}$\":{}"); rhi = rhi + 1; }
    str_builder_add_cstr(rhb, "}}");
    var rhs = str_data(str_builder_build(rhb));
    var rh0 = alloc_used();
    dispatcher_register_tool(wd, tool_def_with_output_schema(tool_def_new("w_big", "d", schema_new("object", 0, vec_new())), rhs), &h_ret);
    assert(alloc_used() - rh0 < 12000000, "register: 100 patterns of 4,005 steps keep about their programs, under 12 MB (74 MB through 3.8.12)");
    # (3.8.12, from the 3.8.11 review) An integer multipleOf a double holds inexactly, or not at all.
    _lc_begin();
    dispatcher_register_tool(wd, tool_def_with_output_schema(tool_def_new("w_m53", "d", schema_new("object", 0, vec_new())), "{\"type\":\"object\",\"properties\":{\"a\":{\"multipleOf\":1e20}}}"), &h_ret);
    dispatcher_register_tool(wd, tool_def_with_output_schema(tool_def_new("w_minf", "d", schema_new("object", 0, vec_new())), "{\"type\":\"object\",\"properties\":{\"a\":{\"multipleOf\":1e400}}}"), &h_ret);
    dispatcher_register_tool(wd, tool_def_with_output_schema(tool_def_new("w_mfit", "d", schema_new("object", 0, vec_new())), "{\"type\":\"object\",\"properties\":{\"a\":{\"multipleOf\":9007199254740992}}}"), &h_ret);
    _lc_end();
    var l53 = _lc_find("tool=w_m53");
    assert(l53 != 0 && _has(l53, "multipleOf past 2^53") == 1, "warn: multipleOf 1e20, past 2^53");
    var linf = _lc_find("tool=w_minf");
    assert(linf != 0 && _has(linf, "multipleOf past a double's range") == 1, "warn: multipleOf 1e400, past a double's range");
    assert(_lc_find("tool=w_mfit") == 0, "warn: none for 2^53 itself");
    var msz = vec_new();
    vec_push(msz, "9007199254740992"); vec_push(msz, 0);
    vec_push(msz, "9007199254740993"); vec_push(msz, 1);
    vec_push(msz, "900719925474099e1"); vec_push(msz, 0);
    vec_push(msz, "900719925474100e1"); vec_push(msz, 1);
    vec_push(msz, "999999999999999"); vec_push(msz, 0);
    vec_push(msz, "1e16"); vec_push(msz, 1);
    vec_push(msz, "1e15"); vec_push(msz, 0);
    vec_push(msz, "1e308"); vec_push(msz, 1);
    vec_push(msz, "1.7976931348623157e308"); vec_push(msz, 1);
    vec_push(msz, "1.7976931348623158e308"); vec_push(msz, 1);
    vec_push(msz, "1.7976931348623159e308"); vec_push(msz, 2);
    vec_push(msz, "17976931348623158e292"); vec_push(msz, 1);
    vec_push(msz, "1e309"); vec_push(msz, 2);
    vec_push(msz, "17"); vec_push(msz, 0);
    vec_push(msz, "0.5"); vec_push(msz, 0);
    var mzi = 0;
    while (mzi < vec_len(msz)) {
        assert_eq(_reg_multiple_size(_sch_multiple_of(vec_get(msz, mzi))), vec_get(msz, mzi + 1), _cat("warn: the size of multipleOf ", vec_get(msz, mzi)));
        mzi = mzi + 2;
    }
    # (3.8.12, from the 3.8.11 review) Exponents of seven digits and more: each was read as its
    # first six, so 1e1000000 equalled 1e100000.
    assert_eq(_sch_num_cmp("1e1000000", "1e100000"), 1, "exponents: 1e1000000 above 1e100000 (they were equal)");
    assert_eq(_sch_num_cmp("1e-1000000", "1e-100000"), 0 - 1, "exponents: 1e-1000000 below 1e-100000");
    assert_eq(_sch_num_cmp("1e1500000", "1e150000"), 1, "exponents: 1e1500000 above 1e150000");
    assert_eq(_sch_num_cmp("2e999999999999999", "1e999999999999999"), 1, "exponents: 15 digits of them");
    assert_eq(_sch_num_cmp("1e200000", "1e150000"), 1, "exponents: six digits, as before");
    assert(_ok("{\"maximum\":1e100000}", "1e1000000") == 0, "exponents: 1e1000000 past maximum 1e100000, refused (it met it)");
    assert(_ok("{\"multipleOf\":1e100000}", "1e1000000") == 1 && _ok("{\"multipleOf\":1e1000000}", "1e100000") == 0, "exponents: multipleOf across them (1e100000 was a multiple of 1e1000000)");

    # ---- (3.8.12) patternProperties ----
    var ppx = "{\"patternProperties\":{\"^s_\":{\"type\":\"string\"},\"^n_\":{\"type\":\"integer\"}}}";
    assert(_ok(ppx, "{\"s_a\":\"x\",\"n_b\":1,\"other\":true}") == 1, "patternProperties: each member by the pattern its key matches, the rest free");
    _ase(_v0(ppx, "{\"s_a\":1}"), "v.s_a: expected string", "patternProperties: ...a value refused, at its key");
    _ase(_v0(ppx, "{\"n_b\":\"x\"}"), "v.n_b: expected integer", "patternProperties: ...by the other pattern");
    var p2 = "{\"patternProperties\":{\"^a\":{\"maxLength\":3},\"b$\":{\"minLength\":2}}}";
    assert(_ok(p2, "{\"ab\":\"abc\"}") == 1, "patternProperties: two patterns matching one key, both met");
    assert(_ok(p2, "{\"ab\":\"abcd\"}") == 0 && _ok(p2, "{\"ab\":\"a\"}") == 0, "patternProperties: ...each judging it");
    var p3 = "{\"properties\":{\"ax\":{\"type\":\"string\"}},\"patternProperties\":{\"^a\":{\"maxLength\":1}}}";
    assert(_ok(p3, "{\"ax\":\"long\"}") == 0 && _ok(p3, "{\"ax\":1}") == 0 && _ok(p3, "{\"ax\":\"l\"}") == 1, "patternProperties: beside properties, a member judged by both");
    var p4 = "{\"properties\":{\"id\":{}},\"patternProperties\":{\"^x-\":{}},\"additionalProperties\":false}";
    assert(_ok(p4, "{\"id\":1,\"x-a\":2}") == 1, "patternProperties: additionalProperties false takes what properties and the patterns name");
    _ase(_v0(p4, "{\"id\":1,\"y\":2}"), "v.y: additional property not allowed", "patternProperties: ...and refuses the rest");
    var p5 = "{\"patternProperties\":{\"^n\":{\"type\":\"integer\"}},\"additionalProperties\":{\"type\":\"string\"}}";
    assert(_ok(p5, "{\"n1\":1,\"s\":\"x\"}") == 1 && _ok(p5, "{\"n1\":\"x\"}") == 0 && _ok(p5, "{\"s\":1}") == 0, "patternProperties: an additionalProperties schema judges only the unmatched");
    assert(_ok("{\"patternProperties\":{\"^ab$\":{\"type\":\"string\"}}}", "{\"\\u0061b\":1}") == 0, "patternProperties: a key as it decodes");
    assert(_ok("{\"patternProperties\":{\"^.{2}$\":{\"type\":\"string\"}}}", "{\"\xc3\xa9\xf0\x9f\x98\x80\":1}") == 0, "patternProperties: ...by code points");
    assert(_ok("{\"patternProperties\":{\"b\":{\"type\":\"string\"}}}", "{\"abc\":1}") == 0 && _ok("{\"patternProperties\":{\"^b\":{\"type\":\"string\"}}}", "{\"abc\":1}") == 1, "patternProperties: anywhere in the key, unless anchored");
    var lk = str_builder_new();
    str_builder_add_cstr(lk, "{\"properties\":{\"a1\":{},\"a2\":{},\"a3\":{},\"a4\":{},\"a5\":{},\"a6\":{},\"a7\":{},\"a8\":{},\"a9\":{}},\"patternProperties\":{\"^k+$\":{\"type\":\"string\"}},\"additionalProperties\":false}");
    var lv = str_builder_new();
    str_builder_add_cstr(lv, "{\"");
    var li = 0;
    while (li < 300) { str_builder_add_cstr(lv, "k"); li = li + 1; }
    str_builder_add_cstr(lv, "\":1}");
    assert(_ok(str_data(str_builder_build(lk)), str_data(str_builder_build(lv))) == 0, "patternProperties: a 300-byte key past eight names, matched");
    assert(_ok("{\"patternProperties\":{\"(?=a)\":{\"type\":\"string\"}}}", "{\"ab\":1}") == 1, "patternProperties: a pattern the engine declines judges nothing");
    assert(_ok("{\"patternProperties\":{\"(?=a)\":{},\"^z\":{\"type\":\"string\"}}}", "{\"z\":1}") == 0, "patternProperties: ...the others judge");
    var ppa = "{\"anyOf\":[{\"patternProperties\":{\"^a\":{\"type\":\"string\"}},\"required\":[\"a\"]},{\"patternProperties\":{\"^b\":{\"type\":\"integer\"}},\"required\":[\"b\"]}]}";
    assert(_ok(ppa, "{\"a\":\"x\"}") == 1 && _ok(ppa, "{\"b\":1}") == 1 && _ok(ppa, "{\"a\":1}") == 0, "patternProperties: under anyOf, quietly");
    dispatcher_register_tool(d, tool_def_new("t_pp", "d", tool_schema_from_json("{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"}},\"patternProperties\":{\"^tag_[a-z]+$\":{\"type\":\"string\",\"maxLength\":8}},\"additionalProperties\":false}")), &h_tool);
    assert(_has(_call(d, "t_pp", "{\"name\":\"n\",\"tag_env\":\"prod\"}"), "\"text\":\"ok\"") == 1, "patternProperties: arguments met, through the dispatcher");
    assert(_has(_call(d, "t_pp", "{\"tag_env\":\"production-eu\"}"), "tag_env: longer than maxLength") == 1, "patternProperties: ...a pattern's schema refusing one");
    assert(_has(_call(d, "t_pp", "{\"tag_1\":\"x\"}"), "tag_1: additional property not allowed") == 1, "patternProperties: ...a key no pattern matches");
    dispatcher_register_tool(d, tool_def_with_output_schema(tool_def_new("t_ppo", "d", schema_new("object", 0, vec_new())), "{\"type\":\"object\",\"patternProperties\":{\"^m_\":{\"type\":\"number\"}}}"), &h_ret);
    _ret = "{\"content\":[],\"structuredContent\":{\"m_a\":1.5}}";
    assert(_has(_call(d, "t_ppo", "{}"), "isError") == 0, "patternProperties: a result met");
    _ret = "{\"content\":[],\"structuredContent\":{\"m_a\":\"x\"}}";
    assert(_has(_call(d, "t_ppo", "{}"), "structuredContent.m_a: expected number") == 1, "patternProperties: ...and refused");
    # The budget: every key against every pattern, each step of each match charged.
    var bpp = str_builder_new();
    str_builder_add_cstr(bpp, "{\"patternProperties\":{");
    li = 0;
    while (li < 64) { if (li > 0) { str_builder_add_cstr(bpp, ","); } str_builder_add_cstr(bpp, "\"^(a|aa)*c"); str_builder_add_int(bpp, li); str_builder_add_cstr(bpp, "\":{}"); li = li + 1; }
    str_builder_add_cstr(bpp, "}}");
    var bkv = str_builder_new();
    str_builder_add_cstr(bkv, "{");
    li = 0;
    while (li < 100) {
        if (li > 0) { str_builder_add_cstr(bkv, ","); }
        str_builder_add_cstr(bkv, "\"");
        var lj = 0;
        while (lj < 500) { str_builder_add_cstr(bkv, "a"); lj = lj + 1; }
        str_builder_add_int(bkv, li);
        str_builder_add_cstr(bkv, "\":0");
        li = li + 1;
    }
    str_builder_add_cstr(bkv, "}");
    var bpv = str_data(str_builder_build(bkv));
    var bpp1 = parse_property(str_data(str_builder_build(bpp)));
    var bvv = _sch_check_value_a(bote_req_begin(), bpp1, "v", bpv);
    assert(bvv != 0 && streq(vec_get(bvv, vec_len(bvv) - 1), "v: more work to judge than its size allows") == 1, "patternProperties: 100 long keys against 64 patterns refused as too much to judge");
    assert(_ns3(bpp1, bpv) < 64 * _ns3(parse_property("{\"patternProperties\":{\"^(a|aa)*c\":{}}}"), bpv), "patternProperties: ...in under 64 times one pattern's time");
    # (3.8.13, from the 3.8.12 review) 64 patterns of 4,005 steps each, `^p<i>.{0,2000}$`, over
    # 4,000 short keys none matches: each made its steps' array ready for each key, 4,005 words,
    # uncharged, 1.8 s for 49 KB. The steps seen are a sparse set now, so it costs what 64
    # patterns of four steps do.
    var bigp = str_builder_new();
    var smlp = str_builder_new();
    str_builder_add_cstr(bigp, "{\"patternProperties\":{");
    str_builder_add_cstr(smlp, "{\"patternProperties\":{");
    var gi = 0;
    while (gi < 64) {
        if (gi > 0) { str_builder_add_cstr(bigp, ","); str_builder_add_cstr(smlp, ","); }
        str_builder_add_cstr(bigp, "\"^p");
        str_builder_add_int(bigp, gi);
        str_builder_add_cstr(bigp, ".{0,2000}$\":{}");
        str_builder_add_cstr(smlp, "\"^p");
        str_builder_add_int(smlp, gi);
        str_builder_add_cstr(smlp, "x$\":{}");
        gi = gi + 1;
    }
    str_builder_add_cstr(bigp, "}}");
    str_builder_add_cstr(smlp, "}}");
    var bigpp = parse_property(str_data(str_builder_build(bigp)));
    var smlpp = parse_property(str_data(str_builder_build(smlp)));
    var kk = str_builder_new();
    str_builder_add_cstr(kk, "{");
    gi = 0;
    while (gi < 4000) { if (gi > 0) { str_builder_add_cstr(kk, ","); } str_builder_add_cstr(kk, "\"k"); str_builder_add_int(kk, gi); str_builder_add_cstr(kk, "\":0"); gi = gi + 1; }
    str_builder_add_cstr(kk, "}");
    var kkv = str_data(str_builder_build(kk));
    assert(_sch_check_value_a(bote_req_begin(), bigpp, "v", kkv) == 0, "patternProperties: 4,000 keys against 64 patterns of 4,005 steps, none matched");
    assert(_ns3(bigpp, kkv) < 8 * _ns3(smlpp, kkv) + 2000000, "patternProperties: ...in a few times what 64 patterns of four steps take (36 times through 3.8.12)");
    # And a budget spent stops the patterns, each with a first turn of 2,000 steps (1,000
    # alternatives): past the budget each was still made ready and its first turn taken, a
    # thousand million steps uncharged for these 8,000 keys.
    var alts = _rep_s("x|", 1000);
    var allp = str_builder_new();
    str_builder_add_cstr(allp, "{\"patternProperties\":{");
    gi = 0;
    while (gi < 64) { if (gi > 0) { str_builder_add_cstr(allp, ","); } str_builder_add_cstr(allp, "\"^(?:"); str_builder_add_cstr(allp, alts); str_builder_add_cstr(allp, "k)"); str_builder_add_int(allp, gi); str_builder_add_cstr(allp, "?\":{\"type\":\"integer\"}"); gi = gi + 1; }
    str_builder_add_cstr(allp, "}}");
    var allpp = parse_property(str_data(str_builder_build(allp)));
    var kk2 = str_builder_new();
    str_builder_add_cstr(kk2, "{");
    gi = 0;
    while (gi < 8000) { if (gi > 0) { str_builder_add_cstr(kk2, ","); } str_builder_add_cstr(kk2, "\"k"); str_builder_add_int(kk2, gi); str_builder_add_cstr(kk2, "\":0"); gi = gi + 1; }
    str_builder_add_cstr(kk2, "}");
    var kkv2 = str_data(str_builder_build(kk2));
    var kr = _sch_check_value_a(bote_req_begin(), allpp, "v", kkv2);
    assert(kr != 0 && streq(vec_get(kr, vec_len(kr) - 1), "v: more work to judge than its size allows") == 1, "patternProperties: 8,000 keys each matched by 64 patterns, refused as too much to judge");
    assert(_ns3(allpp, kkv2) < 3 * _ns3(allpp, kkv) + 2000000, "patternProperties: ...in about the time 4,000 of them take: no pattern tried past the budget");

    # ---- the heap and the arena ----
    var hm = _msg("tools/call", "\"name\":\"t_pat\",\"arguments\":{\"slug\":\"A--b\"}");
    codec_process_message_a(bote_req_begin(), hm, d, 0);
    var h0 = alloc_used();
    var wi = 0;
    while (wi < 50) { codec_process_message_a(bote_req_begin(), hm, d, 0); wi = wi + 1; }
    assert_eq(alloc_used() - h0, 0, "heap: fifty calls refused by a pattern keep nothing");
    var hm2 = _msg("tools/call", "\"name\":\"t_mul\",\"arguments\":{\"price\":19.995}");
    codec_process_message_a(bote_req_begin(), hm2, d, 0);
    var h1 = alloc_used();
    wi = 0;
    while (wi < 50) { codec_process_message_a(bote_req_begin(), hm2, d, 0); wi = wi + 1; }
    assert_eq(alloc_used() - h1, 0, "heap: ...and fifty by multipleOf");
    var hm3 = _msg("tools/call", "\"name\":\"t_pp\",\"arguments\":{\"tag_env\":\"production-eu\",\"tag_1\":1}");
    codec_process_message_a(bote_req_begin(), hm3, d, 0);
    var h3 = alloc_used();
    wi = 0;
    while (wi < 50) { codec_process_message_a(bote_req_begin(), hm3, d, 0); wi = wi + 1; }
    assert_eq(alloc_used() - h3, 0, "heap: ...and fifty by patternProperties (3.8.12)");
    var fa = bote_req_arena_new();
    var fb = bote_req_arena_bytes(fa);
    assert(_sch_check_value_a(fa, parse_property("{\"type\":\"array\",\"items\":{\"anyOf\":[{\"pattern\":\"^x\"},{\"pattern\":\"^[0-9]+$\"}]}}"), "v", _many(5000, "\"12\"")) == 0, "arena: 5,000 items meeting the second of two patterns");
    assert_eq(bote_req_arena_bytes(fa), fb, "arena: ...each match's arrays given back, the first chunk");
    var pkv = str_builder_new();
    str_builder_add_cstr(pkv, "{");
    wi = 0;
    while (wi < 2000) { if (wi > 0) { str_builder_add_cstr(pkv, ","); } str_builder_add_cstr(pkv, "\"k"); str_builder_add_int(pkv, wi); str_builder_add_cstr(pkv, "\":\"x\""); wi = wi + 1; }
    str_builder_add_cstr(pkv, "}");
    assert(_sch_check_value_a(fa, parse_property("{\"patternProperties\":{\"^k[0-9]+$\":{\"type\":\"string\"},\"^z\":{}}}"), "v", str_data(str_builder_build(pkv))) == 0, "arena: 2,000 keys against two patterns (3.8.12)");
    assert_eq(bote_req_arena_bytes(fa), fb, "arena: ...each match's arrays given back");
    var cc = _compile_object_body("{\"type\":\"object\",\"properties\":{\"l\":{\"type\":\"array\",\"items\":{\"pattern\":\"^[0-9]+$\",\"multipleOf\":3}}}}");
    var cv = _cat3("{\"l\":", _many(2000, "\"9\""), "}");
    assert_eq(vec_len(compiled_validate(cc, cv)), 0, "heap form: 2,000 strings through a pattern");
    var hh = alloc_used();
    wi = 0;
    while (wi < 5) { compiled_validate(cc, cv); wi = wi + 1; }
    assert((alloc_used() - hh) / 5 < 256, "heap form: ...keeping only its answer");

    # ---- (3.8.12, from the 3.8.11 review) a root handed the heap ----
    # A dispatcher's plain form judges on the heap allocator: what the walk makes went there
    # and stayed, 128 KB a string for `^.{0,2000}$`. It is judged on the scratch now, and only
    # the answer copied out.
    var lp = parse_property("{\"type\":\"array\",\"items\":{\"type\":\"string\",\"pattern\":\"^.{0,2000}$\"}}");
    var lsv = _many(100, "\"x\"");
    assert(_sch_check_value_a(default_alloc(), lp, "v", lsv) == 0, "heap root: 100 strings through a 4,003-step pattern, met");
    var hr = alloc_used();
    wi = 0;
    while (wi < 5) { _sch_check_value_a(default_alloc(), lp, "v", lsv); wi = wi + 1; }
    assert_eq(alloc_used() - hr, 0, "heap root: ...keeping nothing (12.8 MB a call through 3.8.11)");
    var lbad = _cat3("[\"x\",\"", _rep_s("y", 2001), "\"]");
    var lr = _sch_check_value_a(default_alloc(), lp, "v", lbad);
    assert(lr != 0 && vec_len(lr) == 1 && streq(vec_get(lr, 0), "v[1]: does not match the pattern") == 1, "heap root: a violation copied out whole");
    hr = alloc_used();
    _sch_check_value_a(default_alloc(), lp, "v", lbad);
    assert(alloc_used() - hr < 256, "heap root: ...and only it kept");
    var lc = _compile_object_body("{\"type\":\"object\",\"properties\":{\"l\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"pattern\":\"^.{0,2000}$\"}}}}");
    var largs = _cat3("{\"l\":", lsv, "}");
    assert(compiled_check_a(default_alloc(), lc, largs) == 0, "heap root: compiled_check_a, met");
    hr = alloc_used();
    wi = 0;
    while (wi < 5) { compiled_check_a(default_alloc(), lc, largs); wi = wi + 1; }
    assert_eq(alloc_used() - hr, 0, "heap root: ...keeping nothing");
    # A walk that makes a table, uniqueItems over 1,000 integers: on the heap it was kept.
    var uc = _compile_object_body("{\"type\":\"object\",\"properties\":{\"u\":{\"type\":\"array\",\"uniqueItems\":true}}}");
    var usb = str_builder_new();
    str_builder_add_cstr(usb, "[");
    wi = 0;
    while (wi < 1000) { if (wi > 0) { str_builder_add_cstr(usb, ","); } str_builder_add_int(usb, wi); wi = wi + 1; }
    str_builder_add_cstr(usb, "]");
    var uval = str_data(str_builder_build(usb));
    var uargs = _cat3("{\"u\":", uval, "}");
    assert(compiled_check_a(default_alloc(), uc, uargs) == 0, "heap root: compiled_check_a, 1,000 integers judged unique");
    hr = alloc_used();
    wi = 0;
    while (wi < 5) { compiled_check_a(default_alloc(), uc, uargs); wi = wi + 1; }
    assert_eq(alloc_used() - hr, 0, "heap root: ...keeping none of the walk's table");
    var up = parse_property("{\"type\":\"array\",\"uniqueItems\":true}");
    assert(_sch_check_value_a(default_alloc(), up, "v", uval) == 0, "heap root: _sch_check_value_a, the same array");
    hr = alloc_used();
    wi = 0;
    while (wi < 5) { _sch_check_value_a(default_alloc(), up, "v", uval); wi = wi + 1; }
    assert_eq(alloc_used() - hr, 0, "heap root: ...keeping none of it either");
    var lcr = compiled_check_a(default_alloc(), lc, _cat3("{\"l\":", lbad, "}"));
    assert(lcr != 0 && vec_len(lcr) == 1 && streq(vec_get(lcr, 0), "l[1]: does not match the pattern") == 1, "heap root: compiled_check_a's violation copied out");
    var ld = dispatcher_new(tool_registry_new());
    dispatcher_register_tool(ld, tool_def_new("t_long", "d", tool_schema_from_json("{\"type\":\"object\",\"properties\":{\"l\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"pattern\":\"^.{0,2000}$\"}}}}")), &h_tool);
    var lreq = codec_parse_request(_msg("tools/call", _cat3("\"name\":\"t_long\",\"arguments\":", largs, "")));
    var lresp = dispatcher_dispatch(ld, lreq, 0);
    assert(lresp != 0, "heap root: dispatcher_dispatch, the plain form, answers");
    hr = alloc_used();
    wi = 0;
    while (wi < 5) { dispatcher_dispatch(ld, lreq, 0); wi = wi + 1; }
    assert((alloc_used() - hr) / 5 < 8192, "heap root: ...keeping its reply and not the walk's arrays");

    # ---- (3.8.12, from the 3.8.11 review) making ready, charged through a schema ----
    var ep = parse_property(_cat3("{\"type\":\"array\",\"items\":{\"type\":\"string\",\"pattern\":\"", _rep_s("a|", 1000), "\"}}"));
    var ev = _many(20000, "\"\"");
    var er = _sch_check_value_a(bote_req_begin(), ep, "v", ev);
    assert(er != 0 && streq(vec_get(er, vec_len(er) - 1), "v: more work to judge than its size allows") == 1, "budget: 20,000 empty strings asked of 3,000 steps each, refused as too much to judge");
    assert(_ns3(ep, ev) < 16 * _ns3(parse_property("{\"type\":\"array\",\"items\":{\"type\":\"string\",\"pattern\":\"^$\"}}"), ev) + 2000000, "budget: ...in a few times a one-step pattern's time over them");
    return assert_summary();
}

var rc = main();
sys_exit_group(rc);
