    _ase(_why("{\"$ref\":\"#/$defs/a\",\"$defs\":{\"a\":{\"$id\":\"other.json\",\"$defs\":{\"x\":{}},\"$ref\":\"#/$defs/x\"}}}"), "the outputSchema holds a $ref, and a schema below its root that names a resource of its own with $id, which bote does not resolve against", "refuse: a resource of its own below the root");
