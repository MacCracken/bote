fn h_tool(args, claims) { return "{\"content\":[{\"type\":\"text\",\"text\":\"ok\"}]}"; }
var _ret = 0;
fn h_ret(args, claims) { return _ret; }

fn _cat(a, b) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    return str_data(str_builder_build(sb));
}
fn _cat3(a, b, c) { return _cat(_cat(a, b), c); }
fn _has(s, sub) { if (s != 0 && strstr(s, sub) >= 0) { return 1; } return 0; }
fn _vs(schema, value) { return _sch_check_value_a(bote_req_begin(), parse_property(schema), "v", value); }
fn _ok(schema, value) { if (_vs(schema, value) == 0) { return 1; } return 0; }
fn _n(schema, value) {
    var v = _vs(schema, value);
    if (v == 0) { return 0; }
    return vec_len(v);
}
fn _v0(schema, value) {
    var v = _vs(schema, value);
    if (v == 0) { return "(none)"; }
    return _cat(vec_get(v, 0), "");
}
fn _ase(got, want, name) {
    if (got == 0 || want == 0) { return assert(got == want, name); }
    return assert_streq(got, want, name);
}
fn _msg(method, params) {
    return _cat3(_cat3("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"", method, "\",\"params\":{"), params, "}}");
}
fn _call(d, tool, args) {
    return codec_process_message(_msg("tools/call", _cat3(_cat3("\"name\":\"", tool, "\",\"arguments\":"), args, "")), d, 0);
}
# An array of n items, each `item`.
fn _many(n, item) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "[");
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, item);
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]");
    return str_data(str_builder_build(sb));
}

var _lc_all = 0;
fn _lc_hook(ts, level, category, msg, msg_len, sixth) {
    var n = msg_len;
    if (n > 1023) { n = 1023; }
    var b = alloc(n + 1);
    memcpy(b, msg, n);
    store8(b + n, 0);
    vec_push(_lc_all, b);
    return 0;
}
fn _lc_begin() { _lc_all = vec_new(); sakshi_set_emit_hook(&_lc_hook); sakshi_set_level(SK_TRACE); return 0; }
fn _lc_end() { sakshi_clear_emit_hook(); sakshi_set_level(SK_ERROR); return 0; }
fn _lc_find(sub) {
    var i = 0;
    while (i < vec_len(_lc_all)) {
        if (_has(vec_get(_lc_all, i), sub) == 1) { return vec_get(_lc_all, i); }
        i = i + 1;
    }
    return 0;
}

var SUITE = "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"$defs\":{\"address\":{\"$anchor\":\"addressDef\",\"type\":\"object\",\"properties\":{\"street\":{\"type\":\"string\"},\"city\":{\"type\":\"string\"}}}},\"properties\":{\"name\":{\"type\":\"string\"},\"address\":{\"$ref\":\"#/$defs/address\"},\"contactMethod\":{\"type\":\"string\",\"enum\":[\"phone\",\"email\"]},\"phone\":{\"type\":\"string\"},\"email\":{\"type\":\"string\"}},\"allOf\":[{\"anyOf\":[{\"required\":[\"phone\"]},{\"required\":[\"email\"]}]}],\"if\":{\"properties\":{\"contactMethod\":{\"const\":\"phone\"}},\"required\":[\"contactMethod\"]},\"then\":{\"required\":[\"phone\"]},\"else\":{\"required\":[\"email\"]},\"additionalProperties\":false}";


# A chain of n definitions, d0 to d(n-1), each a `$ref` to the next and the last `last`,
# behind a root `$ref` to d0; each step wrapped as `wrap` says: 0 bare, 1 inside an anyOf.
fn _chain(n, last, wrap) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"$ref\":\"#/$defs/d0\",\"$defs\":{");
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "\"d");
        str_builder_add_cstr(sb, _sch_itoa(i));
        str_builder_add_cstr(sb, "\":");
        if (i == n - 1) { str_builder_add_cstr(sb, last); }
        else {
            if (wrap == 1) { str_builder_add_cstr(sb, "{\"anyOf\":[{\"$ref\":\"#/$defs/d"); }
            else { str_builder_add_cstr(sb, "{\"$ref\":\"#/$defs/d"); }
            str_builder_add_cstr(sb, _sch_itoa(i + 1));
            if (wrap == 1) { str_builder_add_cstr(sb, "\"}]}"); } else { str_builder_add_cstr(sb, "\"}"); }
        }
        i = i + 1;
    }
    str_builder_add_cstr(sb, "}}");
    return str_data(str_builder_build(sb));
}
# A value of n objects, each {"c": the next}, the innermost `inner`.
fn _nest(n, inner) {
    var sb = str_builder_new();
    var i = 0;
    while (i < n) { str_builder_add_cstr(sb, "{\"c\":"); i = i + 1; }
    str_builder_add_cstr(sb, inner);
    i = 0;
    while (i < n) { str_builder_add_cstr(sb, "}"); i = i + 1; }
    return str_data(str_builder_build(sb));
}
fn _why(os) {
    var w = registry_check_tool_def(tool_def_with_output_schema(tool_def_new("t_why", "d", schema_new("object", 0, vec_new())), os));
    if (w == 0) { return "(none)"; }
    return w;
}
fn _iwhy(js) {
    var w = registry_check_tool_def(tool_def_new("t_iwhy", "d", tool_schema_from_json(js)));
    if (w == 0) { return "(none)"; }
    return w;
}

# A tools/call of t_zod: an expression `levels` deep, its innermost number padded with `pad`
# spaces, each level's op last, so each alternative judges its left side before it fails.
fn _zod_msg(levels, pad) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"t_zod\",\"arguments\":{\"expr\":");
    var i = 0;
    while (i < levels) { str_builder_add_cstr(sb, "{\"left\":"); i = i + 1; }
    str_builder_add_cstr(sb, "1");
    i = 0;
    while (i < pad) { str_builder_add_cstr(sb, " "); i = i + 1; }
    i = 0;
    while (i < levels) { str_builder_add_cstr(sb, ",\"right\":2,\"op\":\"mul\"}"); i = i + 1; }
    str_builder_add_cstr(sb, "}}}");
    return str_data(str_builder_build(sb));
}
# A tools/call of t_arr: arrays `levels` deep, the innermost number padded with `pad` spaces,
# each array's "mul" last, so each alternative judges the items before it finds none it needs.
fn _arr_msg(levels, pad) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"t_arr\",\"arguments\":{\"e\":");
    var i = 0;
    while (i < levels) { str_builder_add_cstr(sb, "["); i = i + 1; }
    str_builder_add_cstr(sb, "1");
    i = 0;
    while (i < pad) { str_builder_add_cstr(sb, " "); i = i + 1; }
    i = 0;
    while (i < levels) { str_builder_add_cstr(sb, ",\"x\"]"); i = i + 1; }
    str_builder_add_cstr(sb, "}}}");
    return str_data(str_builder_build(sb));
}
# A tools/call of t_inh: a chain `levels` deep, each node a key of `klen` k's and its children.
fn _inh_msg(levels, klen) {
    var key = str_builder_new();
    var j = 0;
    while (j < klen) { str_builder_add_cstr(key, "k"); j = j + 1; }
    var ks = str_data(str_builder_build(key));
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"t_inh\",\"arguments\":");
    var i = 0;
    while (i < levels) { str_builder_add_cstr(sb, "{\""); str_builder_add_cstr(sb, ks); str_builder_add_cstr(sb, "\":0,\"size\":\"x\",\"children\":["); i = i + 1; }
    str_builder_add_cstr(sb, "{}");
    i = 0;
    while (i < levels) { str_builder_add_cstr(sb, "]}"); i = i + 1; }
    str_builder_add_cstr(sb, "}}");
    return str_data(str_builder_build(sb));
}
# The fewest nanoseconds of three runs of the message `m` through the codec.
fn _msg_ns(d, m) {
    var best = 0;
    var i = 0;
    while (i < 3) {
        var t = clock_now_ns();
        codec_process_message_a(bote_req_begin(), m, d, 0);
        var dt = clock_now_ns() - t;
        if (i == 0 || dt < best) { best = dt; }
        i = i + 1;
    }
    return best;
}

var _th_schema = 0;
var _th_value = 0;
var _th_out = 0;
fn _th_judge(arg) {
    var a = bote_req_arena_new();
    var v = _sch_check_value_a(a, parse_property(_th_schema), "v", _th_value);
    if (v == 0) { _th_out = "(none)"; } else { _th_out = _cat(vec_get(v, vec_len(v) - 1), ""); }
    return 0;
}
# The last violation of `value` against `schema`, judged on a thread of the stack a worker has.
fn _on_thread(schema, value) {
    _th_schema = schema;
    _th_value = value;
    _th_out = 0;
    thread_join(thread_create(&_th_judge, 0));
    return _th_out;
}

fn main() {
    alloc_init();

    # ---- a pointer into $defs ----
    var pd = "{\"$defs\":{\"pos\":{\"type\":\"integer\",\"minimum\":0}},\"type\":\"object\",\"properties\":{\"a\":{\"$ref\":\"#/$defs/pos\"}}}";
    assert(_ok(pd, "{\"a\":1}") == 1, "defs: a value the definition takes");
    _ase(_v0(pd, "{\"a\":-1}"), "v.a: less than minimum", "defs: one it refuses, at its path");
    _ase(_v0(pd, "{\"a\":\"x\"}"), "v.a: expected integer", "defs: ...its type");
    assert(_ok("{\"definitions\":{\"s\":{\"type\":\"string\"}},\"$ref\":\"#/definitions/s\"}", "1") == 0, "defs: draft-07's definitions, by pointer");
    var p1 = parse_property("{\"$defs\":{\"s\":{\"type\":\"string\"}},\"properties\":{\"a\":{\"$ref\":\"#/$defs/s\"},\"b\":{\"$ref\":\"#/%24defs/s\"}}}");
    var pa = compiled_get_property(prop_nested(p1), "a");
    var pb = compiled_get_property(prop_nested(p1), "b");
    assert(prop_ref(pa) != 0 && prop_ref(pa) == prop_ref(pb), "defs: one definition compiled once, whatever the spelling");
    assert(prop_composes(pa) == 1, "defs: a reference composes");

    # ---- the root, and recursion ----
    var tree = "{\"type\":\"object\",\"properties\":{\"v\":{\"type\":\"integer\"},\"kids\":{\"type\":\"array\",\"items\":{\"$ref\":\"#\"}}}}";
    assert(_ok(tree, "{\"v\":1,\"kids\":[{\"v\":2,\"kids\":[{\"v\":3}]}]}") == 1, "root: a tree");
    _ase(_v0(tree, "{\"v\":1,\"kids\":[{\"v\":2,\"kids\":[{\"v\":\"x\"}]}]}"), "v.kids[0].kids[0].v: expected integer", "root: a leaf refused, at its path");
    var tp = parse_property(tree);
    assert(prop_ref(prop_items(compiled_get_property(prop_nested(tp), "kids"))) == tp, "root: # is the root's own PropertyDef, a cycle");
    assert(_ok("{\"type\":\"object\",\"properties\":{\"k\":{\"$ref\":\"#/\"}},\"required\":[\"a\"]}", "{\"a\":1,\"k\":{}}") == 0, "root: #/ is the root, as Ajv reads it");
    var mut = "{\"$defs\":{\"a\":{\"type\":\"object\",\"properties\":{\"b\":{\"$ref\":\"#/$defs/b\"}}},\"b\":{\"type\":\"object\",\"required\":[\"z\"],\"properties\":{\"a\":{\"$ref\":\"#/$defs/a\"}}}},\"$ref\":\"#/$defs/a\"}";
    assert(_ok(mut, "{\"b\":{\"z\":1,\"a\":{\"b\":{\"z\":2}}}}") == 1, "recursion: two definitions in turn");
    _ase(_v0(mut, "{\"b\":{\"z\":1,\"a\":{\"b\":{}}}}"), "v.b.a.b: missing required field: z", "recursion: ...a level down refused");
    assert(_ok(_nest(60, "{}"), "{}") == 1, "recursion: (control)");
    var deep = "{\"type\":\"object\",\"properties\":{\"c\":{\"$ref\":\"#\"},\"n\":{\"type\":\"integer\"}}}";
    assert(_ok(deep, _nest(60, "{\"n\":1}")) == 1, "recursion: sixty levels");
    assert(_has(_v0(deep, _nest(60, "{\"n\":\"x\"}")), ".n: expected integer") == 1, "recursion: ...the sixtieth's violation");

    # ---- pointers: escapes, arrays, anywhere ----
    var esc = "{\"$defs\":{\"a/b\":{\"type\":\"string\"},\"c~d\":{\"type\":\"integer\"},\"e%f\":{\"type\":\"null\"}},\"properties\":{\"x\":{\"$ref\":\"#/$defs/a~1b\"},\"y\":{\"$ref\":\"#/$defs/c~0d\"},\"z\":{\"$ref\":\"#/$defs/a%2Fb\"},\"w\":{\"$ref\":\"#/$defs/e%25f\"}}}";
    assert(_ok(esc, "{\"x\":\"s\",\"y\":1,\"z\":\"s\",\"w\":null}") == 1, "pointer: ~1, ~0, %2F within a name, %25");
    assert(_ok(esc, "{\"x\":1}") == 0 && _ok(esc, "{\"y\":\"s\"}") == 0 && _ok(esc, "{\"z\":1}") == 0 && _ok(esc, "{\"w\":1}") == 0, "pointer: ...each judging");
    assert(_ok("{\"$defs\":{\"l\":[{\"type\":\"string\"},{\"type\":\"integer\"}]},\"$ref\":\"#/$defs/l/1\"}", "\"s\"") == 0, "pointer: an array's item");
    assert(_ok("{\"$defs\":{\"l\":[{\"type\":\"string\"},{\"type\":\"integer\"}]},\"$ref\":\"#/$defs/l/1\"}", "5") == 1, "pointer: ...which takes its own");
    assert(_ok("{\"properties\":{\"a\":{\"type\":\"integer\"},\"b\":{\"$ref\":\"#/properties/a\"}}}", "{\"b\":\"s\"}") == 0, "pointer: another property's schema");
    assert(_ok("{\"allOf\":[{\"maximum\":3}],\"properties\":{\"b\":{\"$ref\":\"#/allOf/0\"}}}", "{\"b\":4}") == 0, "pointer: into allOf");
    assert(_ok("{\"$defs\":{\"x\":{\"type\":\"string\"}},\"properties\":{\"a\":{\"$ref\":\"#\\/$defs\\/x\"}}}", "{\"a\":1}") == 0, "pointer: a reference written with JSON escapes");
    assert(_ok("{\"$defs\":{\"x\":{\"type\":\"string\"}},\"properties\":{\"a\":{\"\\u0024ref\":\"#/$defs/x\"}}}", "{\"a\":1}") == 0, "pointer: $ref as a key written with an escape");
    assert(_ok("{\"$defs\":{\"n\":false},\"$ref\":\"#/$defs/n\"}", "1") == 0, "pointer: to false, nothing");
    assert(_ok("{\"$defs\":{\"y\":true},\"$ref\":\"#/$defs/y\"}", "1") == 1, "pointer: to true, anything");
    assert(_ok("{\"$ref\":\"#/$defs/missing\"}", "1") == 1, "pointer: to nothing, judging nothing, outside registration");
    assert(_ok("{\"$defs\":{\"l\":[{\"type\":\"string\"},{\"type\":\"integer\"}]},\"$ref\":\"#/$defs/l/01\"}", "\"s\"") == 1, "pointer: an index with a leading zero names nothing, not the second item");
    _ase(_why("{\"$defs\":{\"l\":[{},{}]},\"$ref\":\"#/$defs/l/01\"}"), "the outputSchema holds a $ref that names nothing in its document: #/$defs/l/01", "pointer: ...refused at registration");

    # ---- anchors and the base ----
    var an = "{\"$defs\":{\"p\":{\"$anchor\":\"posInt\",\"type\":\"integer\",\"minimum\":0}},\"properties\":{\"a\":{\"$ref\":\"#posInt\"}}}";
    assert(_ok(an, "{\"a\":1}") == 1 && _ok(an, "{\"a\":-1}") == 0, "anchor: $anchor");
    assert(_ok("{\"$defs\":{\"p\":{\"$dynamicAnchor\":\"node\",\"type\":\"string\"}},\"$ref\":\"#node\"}", "1") == 0, "anchor: $dynamicAnchor, as Ajv reads one");
    assert(_ok("{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"definitions\":{\"p\":{\"$id\":\"#pos\",\"minimum\":0}},\"$ref\":\"#pos\"}", "-1") == 0, "anchor: draft-07's $id fragment");
    var p2 = parse_property("{\"$defs\":{\"p\":{\"$anchor\":\"P\",\"type\":\"string\"}},\"properties\":{\"a\":{\"$ref\":\"#P\"},\"b\":{\"$ref\":\"#/$defs/p\"}}}");
    assert(prop_ref(compiled_get_property(prop_nested(p2), "a")) == prop_ref(compiled_get_property(prop_nested(p2), "b")), "anchor: one schema by its anchor and its pointer");
    var bs = "{\"$id\":\"https://example.com/s.json\",\"$defs\":{\"p\":{\"type\":\"integer\"}},\"properties\":{\"a\":{\"$ref\":\"https://example.com/s.json#/$defs/p\"},\"b\":{\"$ref\":\"https://example.com/s.json\"}},\"required\":[\"r\"]}";
    assert(_ok(bs, "{\"r\":1,\"a\":\"x\"}") == 0, "base: the root's $id with a pointer");
    assert(_ok(bs, "{\"r\":1,\"b\":{}}") == 0 && _ok(bs, "{\"r\":1,\"b\":{\"r\":2}}") == 1, "base: the root's $id alone, the root");
    assert(_ok("{\"$id\":\"https://example.com/s.json#\",\"$defs\":{\"p\":{\"type\":\"integer\"}},\"$ref\":\"https://example.com/s.json#/$defs/p\"}", "\"x\"") == 0, "base: an $id ending in an empty fragment");

    # ---- beside its siblings, in every dialect ----
    var sib = "{\"$defs\":{\"pos\":{\"minimum\":0}},\"$ref\":\"#/$defs/pos\",\"maximum\":5}";
    assert(_ok(sib, "3") == 1 && _ok(sib, "-1") == 0 && _ok(sib, "7") == 0, "siblings: the reference and the keyword beside it");
    var s07 = "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"definitions\":{\"pos\":{\"minimum\":0}},\"$ref\":\"#/definitions/pos\",\"maximum\":5}";
    assert(_ok(s07, "7") == 0 && _ok(s07, "-1") == 0, "siblings: judged in draft-07 too, as the official client's engine judges them");

    # ---- under composition, quietly ----
    var cmp = "{\"$defs\":{\"s\":{\"type\":\"string\"},\"i\":{\"type\":\"integer\"}},\"anyOf\":[{\"$ref\":\"#/$defs/s\"},{\"$ref\":\"#/$defs/i\"}]}";
    assert(_ok(cmp, "\"a\"") == 1 && _ok(cmp, "1") == 1 && _ok(cmp, "true") == 0, "composition: anyOf of references");
    assert(_ok("{\"$defs\":{\"s\":{\"type\":\"string\"}},\"not\":{\"$ref\":\"#/$defs/s\"}}", "\"a\"") == 0, "composition: not of a reference");
    assert(_ok("{\"$defs\":{\"s\":{\"type\":\"string\"}},\"type\":\"array\",\"contains\":{\"$ref\":\"#/$defs/s\"}}", "[1,\"a\"]") == 1, "composition: contains a reference");

    # ---- the conformance suite's schema: its $ref judged ----
    var d = dispatcher_new(tool_registry_new());
    assert(dispatcher_register_tool(d, tool_def_new("t_suite", "d", tool_schema_from_json(SUITE)), &h_tool) == 0, "suite: registered");
    assert(_has(_call(d, "t_suite", "{\"name\":\"x\",\"email\":\"e\",\"address\":{\"street\":\"s\",\"city\":\"c\"}}"), "\"text\":\"ok\"") == 1, "suite: an address it takes");
    assert(_has(_call(d, "t_suite", "{\"name\":\"x\",\"email\":\"e\",\"address\":{\"street\":1}}"), "address.street: expected string") == 1, "suite: one it refuses, by #/$defs/address");

    # ---- registration's refusals ----
    var rd = dispatcher_new(tool_registry_new());
    _ase(_why("{\"type\":\"object\",\"properties\":{\"a\":{\"$ref\":\"#/$defs/nope\"}}}"), "the outputSchema holds a $ref that names nothing in its document: #/$defs/nope", "refuse: a pointer to nothing");
    _ase(_why("{\"$ref\":\"other.json#/x\"}"), "the outputSchema holds a $ref that does not resolve within its document: other.json#/x", "refuse: another document");
    _ase(_why("{\"$id\":\"https://example.com/s.json\",\"$ref\":\"https://example.com/t.json\"}"), "the outputSchema holds a $ref that does not resolve within its document: https://example.com/t.json", "refuse: another document behind a base");
    _ase(_why("{\"$defs\":{\"n\":\"x\"},\"$ref\":\"#/$defs/n\"}"), "the outputSchema holds a $ref that names no schema: #/$defs/n", "refuse: a pointer to no schema");
    _ase(_why("{\"$ref\":5}"), "the outputSchema holds a $ref that is not a string", "refuse: a $ref that is no string");
    _ase(_why("{\"$ref\":\"#/%zz\"}"), "the outputSchema holds a $ref that does not resolve within its document: #/%zz", "refuse: a bad percent sign");
    _ase(_why("{\"$ref\":\"#/%2z\"}"), "the outputSchema holds a $ref that does not resolve within its document: #/%2z", "refuse: a percent sign with one hex digit");
    _ase(_why("{\"$ref\":\"#/%2\"}"), "the outputSchema holds a $ref that does not resolve within its document: #/%2", "refuse: ...and one cut short");
    _ase(_why("{\"$ref\":\"#nope\"}"), "the outputSchema holds a $ref that does not resolve within its document: #nope", "refuse: an anchor no schema has");
