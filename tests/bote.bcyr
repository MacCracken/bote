# ================================================================
# Globals — preallocated state shared by benchmark callbacks
# ================================================================

var _b_dispatcher = 0;
var _b_init_req = 0;
var _b_list_req = 0;
var _b_call_req = 0;
var _b_call_resp = 0;
var _b_flat_obj = "{\"name\":\"echo\",\"id\":42,\"flag\":true}";
var _b_nested_obj = "{\"name\":\"calc\",\"arguments\":{\"a\":1,\"b\":2,\"deep\":{\"x\":[1,2,3]}}}";
var _b_call_line = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"svc_echo\",\"arguments\":{\"msg\":\"hi\"}}}";
var _b_compiled_simple = 0;
var _b_compiled_nested = 0;
var _b_compiled_simple_params = "{\"count\":5}";
var _b_compiled_nested_params = "{\"config\":{\"host\":\"localhost\",\"port\":8080}}";

# 2.7.0 — schema_compile bench. The bench callback calls
# compiled_compile() on a pre-built schema, measuring the
# compilation step itself (the validate benches measure the
# resulting compiled artifact's runtime cost).
var _b_schema_simple = 0;
var _b_schema_nested = 0;

# 2.7.0 — auth_bearer_check bench. Measures the no-validator
# fast-path (validator fp == 0 → middleware returns 0 immediately)
# versus the with-validator path (parse Authorization header +
# call validator + check return). The buffer is a synthesised
# HTTP request with a Bearer token.
var _b_auth_req = "GET /mcp HTTP/1.1\r\nHost: x\r\nAuthorization: Bearer tok-A\r\n\r\n";
var _b_auth_req_len = 0;
var _b_auth_allowed = 0;

fn h_echo_b(args) { return args; }

# 3.4.8: a handler returning a CallToolResult, the shape real tools return,
# so the passthrough path is measured beside the bare-result one
# (dispatch_tools_call, whose handler returns its args as bare JSON).
fn h_result_b(args, claims) { return "{\"content\":[{\"type\":\"text\",\"text\":\"hi\"}]}"; }
var _b_call_result_req = 0;
var _b_era_legacy = "POST /mcp HTTP/1.1\r\nHost: x\r\nContent-Type: application/json\r\nMCP-Protocol-Version: 2025-11-25\r\nMCP-Session-Id: abc\r\n\r\n{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"svc_echo\",\"arguments\":{\"msg\":\"hi\"}}}";
var _b_era_legacy_at = 0;
var _b_era_modern = "POST /mcp HTTP/1.1\r\nHost: x\r\nContent-Type: application/json\r\nMCP-Protocol-Version: 2026-07-28\r\nMcp-Method: tools/call\r\nMcp-Name: svc_echo\r\n\r\n{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}},\"name\":\"svc_echo\",\"arguments\":{\"msg\":\"hi\"}}}";
var _b_era_modern_at = 0;
var _b_era_params = "POST /mcp HTTP/1.1\r\nHost: x\r\nContent-Type: application/json\r\nMCP-Protocol-Version: 2026-07-28\r\nMcp-Method: tools/call\r\nMcp-Name: svc_route\r\nMcp-Param-Region: us-west1\r\nMcp-Param-Count: 42\r\n\r\n{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}},\"name\":\"svc_route\",\"arguments\":{\"region\":\"us-west1\",\"n\":42}}}";
var _b_era_params_at = 0;
var _b_result_dispatcher = 0;
var _b_param_dispatcher = 0;
var _b_jwt_token = 0;
var _b_jwt_secret = 0;
var _b_jwks_secret = 0;

# ================================================================
# Benchmark callbacks (no-arg functions, called by bench_run)
# ================================================================

# What an HTTP POST pays to learn its era: a legacy request with a version header,
# a modern tools/call with every header checked, and one with two `Mcp-Param` headers.
fn _b_era(d, raw, body) {
    bote_req_begin();
    var hc[40];
    var out[8];
    bote_http_ctx(&hc, 0 - 1, "bench", raw, strlen(raw), 0);
    return bote_http_era(&hc, body, 0, d, &out);
}
fn b_http_era_legacy() { return _b_era(_b_dispatcher, _b_era_legacy, _b_era_legacy + _b_era_legacy_at); }
fn b_http_era_modern() { return _b_era(_b_dispatcher, _b_era_modern, _b_era_modern + _b_era_modern_at); }
fn b_resource_template_match() {
    return resource_template_matches("repo://{owner}/{name}/issues/{n}", "repo://agnos/bote/issues/42");
}
fn b_jwt_validate_audience() {
    bote_req_begin();
    return auth_validator_jwt(_b_jwt_token, _b_jwt_secret);
}
fn b_jwt_rs256() {
    bote_req_begin();
    return auth_validator_jwt(JV_RS_GOOD, _b_jwks_secret);
}
fn b_jwt_es256() {
    bote_req_begin();
    return auth_validator_jwt(JV_ES_GOOD, _b_jwks_secret);
}
fn b_http_era_params() { return _b_era(_b_param_dispatcher, _b_era_params, _b_era_params + _b_era_params_at); }

# What every HTTP-family request pays to be judged for a NUL in its head (3.6.5).
fn b_http_head_nul() { return bote_http_head_nul(_b_era_modern, _b_era_modern_at); }

# A request made in a child, less the request: the fork, the pipe and the reap (3.6.5).
# 3.7.0: a session looked up under the store's lock, and a message on the request arena,
# before and after a threaded server arms its per-thread state (the last row, so that no
# other row runs armed).
var _b_sess_store = 0;
var _b_sess_id = 0;
fn b_session_validate() { return session_store_validate(_b_sess_store, _b_sess_id); }
fn b_codec_process_message_arena() { return codec_process_message_a(bote_req_begin(), _b_call_line, _b_dispatcher, 0); }
# 3.7.1: a thread started and joined, so that the row after it runs as a worker does, with
# every lock that waits for threads taken: the allocator's, the registries'.
fn _b_thread_nop(arg) { return 0; }

fn _b_child_nop(ctx, rec) { return 0; }
fn b_fetch_in_child_empty() {
    bote_req_begin();
    var cur[24];
    return bote_fetch_in_child(&_b_child_nop, 0, 64, 5000, &cur);
}

fn b_dispatch_initialize() {
    return dispatcher_dispatch(_b_dispatcher, _b_init_req, 0);
}

fn b_dispatch_tools_list() {
    return dispatcher_dispatch(_b_dispatcher, _b_list_req, 0);
}

fn b_dispatch_tools_call() {
    return dispatcher_dispatch(_b_dispatcher, _b_call_req, 0);
}

fn b_dispatch_tools_call_result() {
    return dispatcher_dispatch(_b_result_dispatcher, _b_call_result_req, 0);
}

fn b_jsonx_get_str_flat() {
    return jsonx_get_str(_b_flat_obj, "name");
}

fn b_jsonx_get_raw_nested() {
    return jsonx_get_raw(_b_nested_obj, "arguments");
}

fn b_codec_parse_request() {
    return codec_parse_request(_b_call_line);
}

fn b_codec_serialize_response() {
    return codec_serialize_response(_b_call_resp);
}

fn b_codec_process_message() {
    return codec_process_message(_b_call_line, _b_dispatcher, 0);
}

# 3.4.5: the syntax check codec_process_message now runs first, on the same
# tools/call line, so its share of the codec_process_message figure is
# visible on its own.
fn b_jsonx_valid_request() {
    return jsonx_valid(_b_call_line, strlen(_b_call_line));
}

fn b_validate_compiled_simple() {
    return vec_len(compiled_validate(_b_compiled_simple, _b_compiled_simple_params));
}

fn b_validate_compiled_nested() {
    return vec_len(compiled_validate(_b_compiled_nested, _b_compiled_nested_params));
}

fn b_schema_compile_simple() {
    return compiled_compile(_b_schema_simple);
}

fn b_schema_compile_nested() {
    return compiled_compile(_b_schema_nested);
}

# Validator unset → middleware returns 0 immediately. Validates
# the no-overhead claim from 1.9.0 (the bearer middleware should
# vanish when not configured).
fn b_auth_bearer_check_unset() {
    return auth_bearer_check(0, _b_auth_req, _b_auth_req_len, 0, 0, 0);
}

# Validator configured → full path: parse Authorization header,
# call validator (allowlist), accept/reject.
fn b_auth_bearer_check_set() {
    return auth_bearer_check(0, _b_auth_req, _b_auth_req_len,
    &auth_validator_allowlist, _b_auth_allowed, 0);
}

# ================================================================
# Setup
# ================================================================

var _b_scope_token = 0;
var _b_jwt_cached = 0;
var _b_jwks_cached = 0;
var _b_jwt_forged = 0;

# A token seen before, judged from the cache.
fn b_jwt_cached_hs256() {
    bote_req_begin();
    return auth_validator_jwt(_b_jwt_token, _b_jwt_cached);
}

fn b_jwt_cached_es256() {
    bote_req_begin();
    return auth_validator_jwt(JV_ES_GOOD, _b_jwks_cached);
}

# The same token on a handle with a key source (3.6.6): the refresh's gate and the window
# share one clock read, and the source is not asked.
var _b_jwks_sourced = 0;
fn _b_src(ctx, why_out) { return JV_JWKS; }
fn b_jwt_cached_es256_sourced() {
    bote_req_begin();
    return auth_validator_jwt(JV_ES_GOOD, _b_jwks_sourced);
}

# A forged HS256 token with the cache on: a verify, plus the hash and the lookup.
fn b_jwt_forged_cache_on() {
    bote_req_begin();
    return auth_validator_jwt(_b_jwt_forged, _b_jwt_cached);
}

fn b_jwt_forged_cache_off() {
    bote_req_begin();
    return auth_validator_jwt(_b_jwt_forged, _b_jwt_secret);
}
var _b_scope_rules = 0;
var _b_scoped_dispatcher = 0;
var _b_scoped_req = 0;
var _b_gate_body = "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"svc_echo\",\"arguments\":{\"msg\":\"hello\"}}}";

# What the gate costs a request with a token, for a tool that asks for no scope.
fn b_scope_gate_open() {
    bote_req_begin();
    var hc[40];
    bote_http_ctx(&hc, 0 - 1, "bench", _b_gate_body, 0, 0);
    bote_http_scope_gate(&hc, _b_dispatcher, _b_gate_body, "claims", 0);
    return 0;
}

# One scope, read from a token, reached through a rule.
fn b_scope_check_jwt() {
    bote_req_begin();
    jwt_scope_check(_b_scope_token, "files:write", _b_scope_rules);
    return 0;
}

fn b_dispatch_tools_call_scoped() {
    dispatcher_dispatch_a(bote_req_begin(), _b_scoped_dispatcher, _b_scoped_req, _b_scope_token);
    return 0;
}

fn _bench_setup() {
    var reg = tool_registry_new();
    var s = schema_new("object", 0, vec_new());
    registry_register(reg, tool_def_new("svc_echo", "echo", s));
    _b_dispatcher = dispatcher_new(reg);
    dispatcher_handle(_b_dispatcher, "svc_echo", &h_echo_b);
    # Its own registry and dispatcher, so dispatch_tools_list still lists one
    # tool and stays comparable with earlier rows.
    var rreg = tool_registry_new();
    registry_register(rreg, tool_def_new("svc_result", "returns a CallToolResult", schema_new("object", 0, vec_new())));
    _b_result_dispatcher = dispatcher_new(rreg);
    dispatcher_handle(_b_result_dispatcher, "svc_result", &h_result_b);
    _b_call_result_req = req_with_params(req_new("3", "tools/call"), "{\"name\":\"svc_result\",\"arguments\":{\"msg\":\"hi\"}}");

    _b_era_legacy_at = strstr(_b_era_legacy, "\r\n\r\n") + 4;
    _b_era_modern_at = strstr(_b_era_modern, "\r\n\r\n") + 4;
    _b_era_params_at = strstr(_b_era_params, "\r\n\r\n") + 4;
    # On its own dispatcher: one more tool would move `dispatch_tools_list`.
    var rp = vec_new();
    vec_push(rp, schema_prop_new("region", "{\"type\":\"string\",\"x-mcp-header\":\"Region\"}"));
    vec_push(rp, schema_prop_new("n", "{\"type\":\"integer\",\"x-mcp-header\":\"Count\"}"));
    var prg = tool_registry_new();
    registry_register(prg, tool_def_new("svc_route", "route", schema_new("object", rp, vec_new())));
    _b_param_dispatcher = dispatcher_new(prg);
    _b_init_req = req_with_params(req_new("1", "initialize"), "{\"protocolVersion\":\"2025-11-25\"}");
    _b_list_req = req_new("2", "tools/list");
    _b_call_req = req_with_params(req_new("3", "tools/call"),
    "{\"name\":\"svc_echo\",\"arguments\":{\"msg\":\"hi\"}}");
    _b_call_resp = resp_success("3", "{\"msg\":\"hi\"}");

    # Compiled schemas
    var ps = vec_new();
    vec_push(ps, schema_prop_new("count", "{\"type\":\"integer\",\"minimum\":1,\"maximum\":10}"));
    _b_compiled_simple = compiled_compile(schema_new("object", ps, vec_new()));

    var pn = vec_new();
    vec_push(pn, schema_prop_new("config",
    "{\"type\":\"object\",\"properties\":{\"host\":{\"type\":\"string\"},\"port\":{\"type\":\"integer\"}},\"required\":[\"host\"]}"));
    _b_compiled_nested = compiled_compile(schema_new("object", pn, vec_new()));

    # Fresh (uncompiled) schemas for the schema_compile bench. Built
    # once at setup so the bench callback measures pure compile cost
    # against the same schema input each iter (no schema_new overhead).
    var ps2 = vec_new();
    vec_push(ps2, schema_prop_new("count", "{\"type\":\"integer\",\"minimum\":1,\"maximum\":10}"));
    _b_schema_simple = schema_new("object", ps2, vec_new());

    var pn2 = vec_new();
    vec_push(pn2, schema_prop_new("config",
    "{\"type\":\"object\",\"properties\":{\"host\":{\"type\":\"string\"},\"port\":{\"type\":\"integer\"}},\"required\":[\"host\"]}"));
    _b_schema_nested = schema_new("object", pn2, vec_new());

    # Auth bearer bench setup.
    _b_auth_req_len = strlen(_b_auth_req);

    # A token that passes every check: signed, unexpired, and for this audience.
    var jh = "{\"alg\":\"HS256\"}";
    var jp = "{\"aud\":[\"https://other.example.com\",\"https://mcp.example.com/mcp\"],\"iss\":\"https://as.example.com\",\"exp\":4102444800}";
    var jsb = str_builder_new();
    str_builder_add_cstr(jsb, base64url_encode(jh, strlen(jh)));
    str_builder_add_cstr(jsb, ".");
    str_builder_add_cstr(jsb, base64url_encode(jp, strlen(jp)));
    var jin = str_data(str_builder_build(jsb));
    var jkey = "0123456789abcdef0123456789abcdef";
    var jmac = alloc(32);
    hmac_sha256(jkey, strlen(jkey), jin, strlen(jin), jmac);
    var jtb = str_builder_new();
    str_builder_add_cstr(jtb, jin);
    str_builder_add_cstr(jtb, ".");
    str_builder_add_cstr(jtb, base64url_encode(jmac, 32));
    _b_jwt_token = str_data(str_builder_build(jtb));
    # These two keep measuring a verify, as they did before tokens were remembered.
    _b_jwt_secret = jwt_secret_with_cache(jwt_secret_with_audience(jwt_secret_new(jkey), "https://mcp.example.com/mcp"), 0);
    var jis = vec_new();
    vec_push(jis, "https://as.example.com");
    jwt_secret_with_issuers(_b_jwt_secret, jis);
    _b_jwks_secret = jwt_secret_with_cache(jwt_secret_with_audience(jwt_secret_from_jwks(JV_JWKS), JV_AUD), 0);
    _b_jwt_cached = jwt_secret_with_audience(jwt_secret_new(jkey), "https://mcp.example.com/mcp");
    jwt_secret_with_issuers(_b_jwt_cached, jis);
    _b_jwks_cached = jwt_secret_with_audience(jwt_secret_from_jwks(JV_JWKS), JV_AUD);
    auth_validator_jwt(_b_jwt_token, _b_jwt_cached);
    auth_validator_jwt(JV_ES_GOOD, _b_jwks_cached);
    _b_jwks_sourced = jwt_secret_with_audience(jwt_secret_new(0), JV_AUD);
    jwt_secret_with_key_source(_b_jwks_sourced, &_b_src, 0, 1000000000);
    jwt_secret_refresh(_b_jwks_sourced);
    bote_req_begin();
    auth_validator_jwt(JV_ES_GOOD, _b_jwks_sourced);
    var fl = strlen(_b_jwt_token);
    _b_jwt_forged = alloc(fl + 1);
    memcpy(_b_jwt_forged, _b_jwt_token, fl + 1);
    store8(_b_jwt_forged + fl - 2, 65 + (load8(_b_jwt_forged + fl - 2) == 65));
    _b_auth_allowed = vec_new();
    vec_push(_b_auth_allowed, "tok-A");
    vec_push(_b_auth_allowed, "tok-B");

    # A token holding five scopes, a broader one among them, and a tool that needs two.
    var sp = "{\"scope\":\"openid profile mcp:read files:read admin\"}";
    var ssb = str_builder_new();
    str_builder_add_cstr(ssb, base64url_encode(jh, strlen(jh)));
    str_builder_add_cstr(ssb, ".");
    str_builder_add_cstr(ssb, base64url_encode(sp, strlen(sp)));
    str_builder_add_cstr(ssb, ".c2ln");
    _b_scope_token = str_data(str_builder_build(ssb));
    _b_scope_rules = jwt_scope_rules_new();
    jwt_scope_rule(_b_scope_rules, "admin", "files:write");
    jwt_scope_rule(_b_scope_rules, "files:write", "files:read");
    var two = vec_new();
    vec_push(two, "mcp:read");
    vec_push(two, "files:write");
    var sreg = tool_registry_new();
    registry_register(sreg, tool_def_with_required_scopes(tool_def_new("svc_scoped", "needs two scopes", schema_new("object", 0, vec_new())), two));
    _b_scoped_dispatcher = dispatcher_new(sreg);
    dispatcher_handle(_b_scoped_dispatcher, "svc_scoped", &h_echo_b);
    dispatcher_set_scope_check(_b_scoped_dispatcher, &jwt_scope_check, _b_scope_rules);
    _b_scoped_req = req_with_params(req_new("3", "tools/call"), "{\"name\":\"svc_scoped\",\"arguments\":{\"msg\":\"hello\"}}");
    return 0;
}

# ================================================================
# Main
# ================================================================

fn main() {
    alloc_init();
    _bench_setup();

    var benches = vec_new();

    var b1 = bench_new("dispatch_initialize");
    bench_run(b1, &b_dispatch_initialize, 10000);
    vec_push(benches, b1);

    var b2 = bench_new("dispatch_tools_list");
    bench_run(b2, &b_dispatch_tools_list, 10000);
    vec_push(benches, b2);

    var b3 = bench_new("dispatch_tools_call");
    bench_run(b3, &b_dispatch_tools_call, 10000);
    vec_push(benches, b3);

    var b4 = bench_new("jsonx_get_str_flat");
    bench_run(b4, &b_jsonx_get_str_flat, 100000);
    vec_push(benches, b4);

    var b5 = bench_new("jsonx_get_raw_nested");
    bench_run(b5, &b_jsonx_get_raw_nested, 100000);
    vec_push(benches, b5);

    var b6 = bench_new("codec_parse_request");
    bench_run(b6, &b_codec_parse_request, 10000);
    vec_push(benches, b6);

    var b7 = bench_new("codec_serialize_response");
    bench_run(b7, &b_codec_serialize_response, 10000);
    vec_push(benches, b7);

    var b8 = bench_new("codec_process_message");
    bench_run(b8, &b_codec_process_message, 10000);
    vec_push(benches, b8);

    var b9 = bench_new("validate_compiled_simple");
    bench_run(b9, &b_validate_compiled_simple, 10000);
    vec_push(benches, b9);

    var b10 = bench_new("validate_compiled_nested");
    bench_run(b10, &b_validate_compiled_nested, 10000);
    vec_push(benches, b10);

    var b11 = bench_new("schema_compile_simple");
    bench_run(b11, &b_schema_compile_simple, 10000);
    vec_push(benches, b11);

    var b12 = bench_new("schema_compile_nested");
    bench_run(b12, &b_schema_compile_nested, 10000);
    vec_push(benches, b12);

    var b13 = bench_new("auth_bearer_check_unset");
    bench_run(b13, &b_auth_bearer_check_unset, 100000);
    vec_push(benches, b13);

    var b14 = bench_new("auth_bearer_check_set");
    bench_run(b14, &b_auth_bearer_check_set, 100000);
    vec_push(benches, b14);

    var b15 = bench_new("jsonx_valid_request");
    bench_run(b15, &b_jsonx_valid_request, 100000);
    vec_push(benches, b15);

    var b16 = bench_new("dispatch_tools_call_result");
    bench_run(b16, &b_dispatch_tools_call_result, 10000);
    vec_push(benches, b16);

    var b17 = bench_new("http_era_legacy");
    bench_run(b17, &b_http_era_legacy, 10000);
    vec_push(benches, b17);

    var b18 = bench_new("http_era_modern");
    bench_run(b18, &b_http_era_modern, 10000);
    vec_push(benches, b18);
    var b19 = bench_new("http_era_params");
    bench_run(b19, &b_http_era_params, 10000);
    vec_push(benches, b19);
    var b20 = bench_new("resource_template_match");
    bench_run(b20, &b_resource_template_match, 10000);
    vec_push(benches, b20);
    var b21 = bench_new("jwt_validate_audience");
    bench_run(b21, &b_jwt_validate_audience, 10000);
    vec_push(benches, b21);
    var b22 = bench_new("jwt_rs256");
    bench_run(b22, &b_jwt_rs256, 200);
    vec_push(benches, b22);
    var b23 = bench_new("jwt_es256");
    bench_run(b23, &b_jwt_es256, 50);
    vec_push(benches, b23);
    var b24 = bench_new("scope_gate_open");
    bench_run(b24, &b_scope_gate_open, 10000);
    vec_push(benches, b24);
    var b25 = bench_new("scope_check_jwt");
    bench_run(b25, &b_scope_check_jwt, 10000);
    vec_push(benches, b25);
    var b26 = bench_new("dispatch_tools_call_scoped");
    bench_run(b26, &b_dispatch_tools_call_scoped, 10000);
    vec_push(benches, b26);
    var b27 = bench_new("jwt_cached_hs256");
    bench_run(b27, &b_jwt_cached_hs256, 10000);
    vec_push(benches, b27);
    var b28 = bench_new("jwt_cached_es256");
    bench_run(b28, &b_jwt_cached_es256, 10000);
    vec_push(benches, b28);
    var b29 = bench_new("jwt_forged_hs256_cache_on");
    bench_run(b29, &b_jwt_forged_cache_on, 10000);
    vec_push(benches, b29);
    var b30 = bench_new("jwt_forged_hs256_cache_off");
    bench_run(b30, &b_jwt_forged_cache_off, 10000);
    vec_push(benches, b30);
    var b31 = bench_new("http_head_nul");
    bench_run(b31, &b_http_head_nul, 100000);
    vec_push(benches, b31);
    var b32 = bench_new("fetch_in_child_empty");
    bench_run(b32, &b_fetch_in_child_empty, 500);
    vec_push(benches, b32);
    var b33 = bench_new("jwt_cached_es256_sourced");
    bench_run(b33, &b_jwt_cached_es256_sourced, 10000);
    vec_push(benches, b33);
    _b_sess_store = session_store_default();
    _b_sess_id = session_store_create(_b_sess_store, "2025-11-25");
    var b34 = bench_new("session_validate");
    bench_run(b34, &b_session_validate, 100000);
    vec_push(benches, b34);
    var b35 = bench_new("codec_process_message_arena");
    bench_run(b35, &b_codec_process_message_arena, 10000);
    vec_push(benches, b35);
    bote_conn_arm();
    thread_join(thread_create(&_b_thread_nop, 0));
    var b36 = bench_new("codec_process_message_threaded");
    bench_run(b36, &b_codec_process_message_arena, 10000);
    vec_push(benches, b36);

    bench_report_all(benches);
    return 0;
}

var r = main();
sys_exit(r);
