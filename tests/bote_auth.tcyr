# bote_auth.tcyr — unit tests for src/auth.cyr (bearer-token middleware).
#
# Split out of bote.tcyr for the cyrius 4.6.2 function-table cap —
# same pattern as bote_content / bote_libro_tools / bote_host.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"
include "lib/fnptr.cyr"
include "lib/tagged.cyr"
include "lib/net.cyr"
include "lib/async.cyr"
include "lib/fdlopen.cyr"
include "lib/tls.cyr"
include "lib/sandhi.cyr"
include "lib/assert.cyr"

include "src/log.cyr"
include "src/protocol.cyr"
include "src/auth.cyr"

# Mock validator that only accepts a single hardcoded token.
fn mock_validator(token, ctx) {
    if (streq(token, "secret123") == 1) { return 1; }
    return 0;
}

# A request holding `Content-Length: <v>`, or none when v is 0.
fn _make_clen(v) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "POST /mcp HTTP/1.1\r\nHost: x.x\r\n");
    if (v != 0) {
        str_builder_add_cstr(sb, "Content-Length: ");
        str_builder_add_cstr(sb, v);
        str_builder_add_cstr(sb, "\r\n");
    }
    str_builder_add_cstr(sb, "\r\n");
    return str_data(str_builder_build(sb));
}

fn _clen_bad(v) {
    var r = _make_clen(v);
    return bote_http_clen_bad(r, strlen(r));
}

# Helper to build a fake HTTP request as a cstr (NUL-terminated buffer
# we can pass to sandhi_server_find_header). Caller specifies the Authorization
# header value (or 0 to omit the header entirely).
fn _make_req(auth_value) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "GET /mcp HTTP/1.1\r\nHost: x.x\r\n");
    if (auth_value != 0) {
        str_builder_add_cstr(sb, "Authorization: ");
        str_builder_add_cstr(sb, auth_value);
        str_builder_add_cstr(sb, "\r\n");
    }
    str_builder_add_cstr(sb, "\r\n");
    return str_data(str_builder_build(sb));
}

# ---- sakshi capture (3.4.0 logging assertions) -----------------------------
var _lc_buf = 0;
var _lc_level = 0 - 1;
var _lc_count = 0;
fn _lc_hook(ts, level, category, msg, msg_len, sixth) {
    var n = msg_len;
    if (n > 1023) { n = 1023; }
    memcpy(_lc_buf, msg, n);
    store8(_lc_buf + n, 0);
    _lc_level = level;
    _lc_count = _lc_count + 1;
    return 0;
}
fn _lc_begin() {
    if (_lc_buf == 0) { _lc_buf = alloc(1024); }
    store8(_lc_buf, 0);
    _lc_level = 0 - 1;
    _lc_count = 0;
    sakshi_set_emit_hook(&_lc_hook);
    sakshi_set_level(SK_TRACE);
    return 0;
}
fn _lc_end() { sakshi_clear_emit_hook(); return 0; }
# 1 when cstr `hay` contains cstr `needle`.
fn _lc_has(hay, needle) {
    if (hay == 0 || needle == 0) { return 0; }
    var i = 0;
    while (load8(hay + i) != 0) {
        var j = 0;
        while (load8(needle + j) != 0 && load8(hay + i + j) == load8(needle + j)) { j = j + 1; }
        if (load8(needle + j) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn _one_scope(s) {
    var v = vec_new();
    vec_push(v, s);
    return v;
}

fn main() {
    alloc_init();

    # ================================================================
    # auth_bearer_extract — header parsing
    # ================================================================
    var r1 = _make_req("Bearer secret123");
    var t1 = auth_bearer_extract(r1, strlen(r1));
    assert(t1 != 0, "extract returns token");
    assert(streq(t1, "secret123") == 1, "extracted token correct");

    # Case-insensitive scheme name
    var r2 = _make_req("bearer secret123");
    assert(streq(auth_bearer_extract(r2, strlen(r2)), "secret123") == 1, "lowercase bearer");
    var r3 = _make_req("BEARER secret123");
    assert(streq(auth_bearer_extract(r3, strlen(r3)), "secret123") == 1, "uppercase BEARER");
    var r4 = _make_req("BeArEr secret123");
    assert(streq(auth_bearer_extract(r4, strlen(r4)), "secret123") == 1, "mixed-case scheme");

    # Extra leading whitespace after "Bearer "
    var r5 = _make_req("Bearer    spaced");
    assert(streq(auth_bearer_extract(r5, strlen(r5)), "spaced") == 1, "leading WS skipped");

    # Trailing whitespace trimmed (CR is already stripped by sandhi_server_find_header)
    var r6 = _make_req("Bearer trim   ");
    assert(streq(auth_bearer_extract(r6, strlen(r6)), "trim") == 1, "trailing WS trimmed");

    # ---------------- rejections ----------------
    var no_hdr = _make_req(0);
    assert_eq(auth_bearer_extract(no_hdr, strlen(no_hdr)), 0, "no Authorization → 0");

    var basic = _make_req("Basic dXNlcjpwYXNz");
    assert_eq(auth_bearer_extract(basic, strlen(basic)), 0, "Basic scheme → 0");

    var truncated = _make_req("Bearer");
    assert_eq(auth_bearer_extract(truncated, strlen(truncated)), 0, "no space after Bearer → 0");

    var empty_token = _make_req("Bearer ");
    assert_eq(auth_bearer_extract(empty_token, strlen(empty_token)), 0, "empty token → 0");

    var only_ws = _make_req("Bearer    ");
    assert_eq(auth_bearer_extract(only_ws, strlen(only_ws)), 0, "all-whitespace token → 0");

    # ================================================================
    # auth_validator_allow_all — permissive validator
    # ================================================================
    assert(auth_validator_allow_all("anything", 0) != 0, "allow_all passes any token");
    assert_eq(auth_validator_allow_all(0, 0), 0, "allow_all rejects null");
    assert_eq(auth_validator_allow_all("", 0), 0, "allow_all rejects empty");

    # ================================================================
    # auth_validator_allowlist — vec membership
    # ================================================================
    var allowed = vec_new();
    vec_push(allowed, "tok-A");
    vec_push(allowed, "tok-B");
    assert(auth_validator_allowlist("tok-A", allowed) != 0, "allowlist accepts tok-A");
    assert(auth_validator_allowlist("tok-B", allowed) != 0, "allowlist accepts tok-B");
    assert_eq(auth_validator_allowlist("tok-C", allowed), 0, "allowlist rejects tok-C");
    assert_eq(auth_validator_allowlist(0, allowed), 0, "allowlist rejects null token");
    assert_eq(auth_validator_allowlist("tok-A", 0), 0, "allowlist rejects null vec");

    # ================================================================
    # auth_bearer_check — middleware shape (cfd=0 since we don't read
    # the response on this path; check returns the status code only)
    # ================================================================
    # No validator configured → pass through (returns 0)
    assert_eq(auth_bearer_check(0, r1, strlen(r1), 0, 0, 0), 0,
    "no validator → middleware no-op");

    # Validator configured, valid token → pass
    var fp = &mock_validator;
    assert_eq(auth_bearer_check(2, r1, strlen(r1), fp, 0, 0), 0,
    "valid token passes");

    # Validator configured, missing header → 401 (and a 401 byte stream
    # was written to fd=2; we just check the return code here)
    assert_eq(auth_bearer_check(2, no_hdr, strlen(no_hdr), fp, 0, 0), HTTP_UNAUTHORIZED,
    "missing header → 401");

    # Validator configured, wrong token → 401
    var wrong = _make_req("Bearer nope");
    assert_eq(auth_bearer_check(2, wrong, strlen(wrong), fp, 0, 0), HTTP_UNAUTHORIZED,
    "wrong token → 401");

    # ================================================================
    # Fn-pointer addressability (sanity)
    # ================================================================
    assert(&auth_bearer_extract != 0, "extract fp addressable");
    assert(&auth_bearer_check != 0, "check fp addressable");
    assert(&auth_validator_allow_all != 0, "allow_all fp addressable");
    assert(&auth_validator_allowlist != 0, "allowlist fp addressable");
    assert(&auth_send_unauthorized != 0, "401 builder fp addressable");

    # ================================================================
    # 1.9.4: constant-time allowlist comparison
    # ================================================================
    # Per-byte mismatch shouldn't short-circuit. Verify via behaviour:
    # a candidate that differs only in the last byte still gets rejected
    # exactly like one that differs in the first.
    var ct = vec_new();
    vec_push(ct, "abcdefghij");
    assert(auth_validator_allowlist("abcdefghij", ct) != 0, "ct: exact match");
    assert_eq(auth_validator_allowlist("Xbcdefghij", ct), 0, "ct: first-byte differ");
    assert_eq(auth_validator_allowlist("abcdefghiX", ct), 0, "ct: last-byte differ");
    assert_eq(auth_validator_allowlist("abcdefghi", ct), 0, "ct: shorter");
    assert_eq(auth_validator_allowlist("abcdefghijK", ct), 0, "ct: longer");
    # Multi-entry allowlist: position-independent (no early-exit on first
    # match — tested by behavior, not timing)
    var multi = vec_new();
    vec_push(multi, "first");
    vec_push(multi, "second");
    vec_push(multi, "third");
    assert(auth_validator_allowlist("first", multi) != 0, "ct: position 0");
    assert(auth_validator_allowlist("second", multi) != 0, "ct: position 1");
    assert(auth_validator_allowlist("third", multi) != 0, "ct: position 2");
    assert_eq(auth_validator_allowlist("fourth", multi), 0, "ct: not in list");


    # ================================================================
    # 3.4.0 — a 401 is a WARN line naming why, never the token
    # ================================================================
    _lc_begin();
    auth_bearer_check(2, no_hdr, strlen(no_hdr), fp, 0, 0);
    assert_eq(_lc_count, 1, "missing header: one log event");
    assert_eq(_lc_level, SK_WARN, "missing header: logged at WARN");
    assert(_lc_has(_lc_buf, "status=401") == 1, "missing header: line carries status=401");
    assert(_lc_has(_lc_buf, "reason=missing_token") == 1, "missing header: reason=missing_token");
    var secret_req = _make_req("Bearer sk-live-SECRETVALUE");
    _lc_begin();
    auth_bearer_check(2, secret_req, strlen(secret_req), fp, 0, 0);
    assert(_lc_has(_lc_buf, "reason=invalid_token") == 1, "wrong token: reason=invalid_token");
    assert_eq(_lc_has(_lc_buf, "SECRETVALUE"), 0, "a rejected token never reaches the log line");
    _lc_begin();
    auth_bearer_check(2, r1, strlen(r1), fp, 0, 0);
    assert_eq(_lc_count, 0, "an accepted token logs nothing");
    _lc_end();

    # ---------------- 3.4.15: a Content-Length is a number or a 400 ----------------
    assert_eq(_clen_bad(0), 0, "clen: absent is fine");
    assert_eq(_clen_bad("42"), 0, "clen: digits are fine");
    assert_eq(_clen_bad("0"), 0, "clen: zero is fine");
    assert_eq(_clen_bad("abc"), 1, "clen: letters are refused");
    assert_eq(_clen_bad("-1"), 1, "clen: a sign is refused");
    assert_eq(_clen_bad("+40"), 1, "clen: a plus is refused");
    assert_eq(_clen_bad("1, 1"), 1, "clen: a list is refused");

    # ---------------- 3.4.15: a refused token leaves nothing, kept claims survive ----------------
    var big_tok = str_builder_new();
    str_builder_add_cstr(big_tok, "Bearer ");
    var bti = 0;
    while (bti < 6000) { str_builder_add_cstr(big_tok, "0123456789"); bti = bti + 1; }
    var big_req = _make_req(str_data(str_builder_build(big_tok)));
    var big_n = strlen(big_req);
    bote_req_begin();
    auth_bearer_extract(big_req, big_n);
    var before = alloc_used();
    var bri = 0;
    while (bri < 50) {
        bote_req_begin();
        auth_bearer_extract(big_req, big_n);
        bri = bri + 1;
    }
    assert_eq(alloc_used() - before, 0, "arena: reading a 60 KB token leaves no heap");
    var keep_req = _make_req("Bearer kept-token");
    var keep_slot[8];
    bote_req_begin();
    assert_eq(auth_bearer_check(0, keep_req, strlen(keep_req), &auth_validator_allow_all, 0, &keep_slot), 0, "arena: a valid token passes");
    bote_req_begin();
    auth_bearer_extract(big_req, big_n);
    assert(streq(load64(&keep_slot), "kept-token") == 1, "arena: claims a handler may keep survive the next message");

    # ---- 3.6.3: the 403, and how long a token lasts ----
    #ifndef CYRIUS_TARGET_AGNOS
    var fs = vec_new();
    vec_push(fs, "files:read");
    vec_push(fs, "files:write");
    var fsp[16];
    sys_socketpair(1, 1, 0, &fsp);
    bote_req_begin();
    assert_eq(auth_send_insufficient_scope(load32(&fsp), fs, "resource_metadata=\"https://x/.wk\"", "X-A: b\r\n"), 0, "403: sent");
    var fsb = alloc(1024);
    var fsn = sys_read(load32(&fsp + 4), fsb, 1023);
    store8(fsb + fsn, 0);
    assert(strstr(fsb, "HTTP/1.1 403 Forbidden\r\n") == 0, "403: the status");
    assert(strstr(fsb, "\r\nWWW-Authenticate: Bearer error=\"insufficient_scope\", scope=\"files:read files:write\", resource_metadata=\"https://x/.wk\"\r\nX-A: b\r\n") > 0, "403: the challenge, then what else was asked");
    assert(strstr(fsb, "Content-Length: 0\r\n") > 0, "403: no body");
    bote_req_begin();
    auth_send_insufficient_scope(load32(&fsp), _one_scope("s"), 0, 0);
    fsn = sys_read(load32(&fsp + 4), fsb, 1023);
    store8(fsb + fsn, 0);
    assert(strstr(fsb, "WWW-Authenticate: Bearer error=\"insufficient_scope\", scope=\"s\"\r\n") > 0, "403: no metadata, no extra");
    sys_close(load32(&fsp));
    sys_close(load32(&fsp + 4));
    #endif

    var c_req = _make_req("Bearer on-the-arena");
    var c_slot[8];
    bote_req_begin();
    var c_used = alloc_used();
    assert_eq(auth_bearer_check_c(0, c_req, strlen(c_req), &auth_validator_allow_all, 0, &c_slot, 0), 0, "one message: accepted");
    assert_eq(alloc_used(), c_used, "one message: the token stays on the arena");
    var c_kept = bote_req_claims_kept(load64(&c_slot));
    assert(c_kept != load64(&c_slot), "one message: a handler gets a copy");
    assert(streq(c_kept, "on-the-arena") == 1, "one message: ...of the token");

    return assert_summary();
}

var rc = main();
sys_exit(rc);
