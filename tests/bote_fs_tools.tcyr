# bote_fs_tools.tcyr — unit tests for src/fs_tools.cyr.
#
# Covers the pure, tricky logic without touching the filesystem:
#   - _fs_path_unsafe  (traversal / absolute / empty guard)
#   - _fs_unescape     (JSON string escapes incl. \uXXXX -> UTF-8)
#   - fs_tools_register (handlers land on the dispatcher)
#   - fs_write_handler refuses an unsafe path (guard runs before any I/O)
# Run: cyrius test tests/bote_fs_tools.tcyr

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fs.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"
include "lib/fnptr.cyr"
include "lib/chrono.cyr"
include "lib/tagged.cyr"
include "lib/freelist.cyr"
include "lib/thread.cyr"
include "lib/thread_local.cyr"
include "lib/sakshi.cyr"
include "lib/assert.cyr"

include "src/log.cyr"
include "src/error.cyr"
include "src/protocol.cyr"
include "src/jsonx.cyr"
include "src/regex.cyr"
include "src/registry.cyr"
include "src/prompts.cyr"
include "src/resources.cyr"
include "src/events.cyr"
include "src/audit.cyr"
include "src/dispatch.cyr"
include "src/codec.cyr"
include "src/schema.cyr"
include "src/fs_tools.cyr"

# ---- sakshi capture (3.4.0 logging assertions) -----------------------------
var _lc_buf = 0;
var _lc_level = 0 - 1;
var _lc_count = 0;
fn _lc_hook(ts, level, category, msg, msg_len, sixth) {
    var n = msg_len;
    if (n > 1023) { n = 1023; }
    memcpy(_lc_buf, msg, n);
    store8(_lc_buf + n, 0);
    _lc_level = level;
    _lc_count = _lc_count + 1;
    return 0;
}
fn _lc_begin() {
    if (_lc_buf == 0) { _lc_buf = alloc(1024); }
    store8(_lc_buf, 0);
    _lc_level = 0 - 1;
    _lc_count = 0;
    sakshi_set_emit_hook(&_lc_hook);
    sakshi_set_level(SK_TRACE);
    return 0;
}
fn _lc_end() { sakshi_clear_emit_hook(); return 0; }
# How many times `needle` occurs in `hay`.
fn _occurs(hay, needle) {
    var n = 0;
    var at = strstr(hay, needle);
    while (at >= 0) {
        n = n + 1;
        hay = hay + at + strlen(needle);
        at = strstr(hay, needle);
    }
    return n;
}

# 1 when cstr `hay` contains cstr `needle`.
fn _lc_has(hay, needle) {
    if (hay == 0 || needle == 0) { return 0; }
    var i = 0;
    while (load8(hay + i) != 0) {
        var j = 0;
        while (load8(needle + j) != 0 && load8(hay + i + j) == load8(needle + j)) { j = j + 1; }
        if (load8(needle + j) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn main() {
    alloc_init();

    # ---------------- path safety ----------------
    assert_eq(_fs_path_unsafe("src/main.py"), 0, "relative path is safe");
    assert_eq(_fs_path_unsafe("a/b/c.txt"),   0, "nested relative path is safe");
    assert_eq(_fs_path_unsafe(""),            1, "empty path refused");
    assert_eq(_fs_path_unsafe("/etc/passwd"), 1, "absolute path refused");
    assert_eq(_fs_path_unsafe(".."),          1, "bare .. refused");
    assert_eq(_fs_path_unsafe("../escape"),   1, "leading .. refused");
    assert_eq(_fs_path_unsafe("a/../b"),      1, "embedded .. refused");
    assert_eq(_fs_path_unsafe(0),             1, "null path refused");

    # ---------------- JSON unescape ----------------
    var ls[8];

    store64(&ls, 0);
    var d1 = _fs_unescape("hello", &ls);
    assert_eq(load64(&ls), 5, "plain string length");
    assert_eq(load8(d1), 104, "plain string first byte 'h'");

    store64(&ls, 0);
    var d2 = _fs_unescape("a\\nb", &ls);           # a \ n b -> a <LF> b
    assert_eq(load64(&ls), 3, "\\n decodes to one byte");
    assert_eq(load8(d2 + 1), 10, "\\n -> newline (0x0a)");

    store64(&ls, 0);
    var d3 = _fs_unescape("x\\ty", &ls);           # x \ t y -> x <TAB> y
    assert_eq(load8(d3 + 1), 9, "\\t -> tab (0x09)");

    store64(&ls, 0);
    var d4 = _fs_unescape("a\\\\b", &ls);          # a \ \ b -> a \ b
    assert_eq(load64(&ls), 3, "\\\\ decodes to one backslash");
    assert_eq(load8(d4 + 1), 92, "\\\\ -> backslash (0x5c)");

    store64(&ls, 0);
    var d5 = _fs_unescape("a\\\"b", &ls);          # a \ " b -> a " b
    assert_eq(load8(d5 + 1), 34, "\\\" -> double-quote (0x22)");

    store64(&ls, 0);
    var d6 = _fs_unescape("\\u0041", &ls);         # A -> 'A'
    assert_eq(load64(&ls), 1, "\\u0041 decodes to one byte");
    assert_eq(load8(d6), 65, "\\u0041 -> 'A' (0x41)");

    store64(&ls, 0);
    var d7 = _fs_unescape("\\u00e9", &ls);         # é -> 0xC3 0xA9 (2-byte UTF-8)
    assert_eq(load64(&ls), 2, "\\u00e9 -> 2 UTF-8 bytes");
    assert_eq(load8(d7),     195, "\\u00e9 lead byte 0xC3");
    assert_eq(load8(d7 + 1), 169, "\\u00e9 cont byte 0xA9");

    # ---------------- registration ----------------
    var reg = tool_registry_new();
    var disp = dispatcher_new(reg);
    fs_tools_register(disp);
    assert_eq(map_has(dispatcher_handlers(disp), "fs_write"), 1, "fs_write registered");
    assert_eq(map_has(dispatcher_handlers(disp), "fs_read"),  1, "fs_read registered");
    assert_eq(map_has(dispatcher_handlers(disp), "fs_mkdir"), 1, "fs_mkdir registered");

    # ---------------- handler guard (no I/O on refusal) ----------------
    var refused = fs_write_handler("{\"path\":\"../evil\",\"content\":\"x\"}", 0);
    assert(refused != 0, "unsafe write returns a result");
    assert_eq(load8(refused), 123, "result is a JSON object (starts with '{')");


    # ================================================================
    # 3.4.0 — a refused path is a WARN line naming the tool and the path
    # ================================================================
    _lc_begin();
    var rr = fs_read_handler("{\"path\":\"../../etc/shadow\"}", 0);
    assert(_lc_has(rr, "refused unsafe path") == 1, "fs_read still refuses ..");
    assert_eq(_lc_level, SK_WARN, "the refusal is logged at WARN");
    assert(_lc_has(_lc_buf, "tool=fs_read") == 1, "the line names the tool");
    assert(_lc_has(_lc_buf, "path=../../etc/shadow") == 1, "the line names the refused path");
    fs_write_handler("{\"path\":\"/etc/x\",\"content\":\"y\"}", 0);
    assert(_lc_has(_lc_buf, "tool=fs_write") == 1, "fs_write refusal is logged");
    _lc_end();

    # ================================================================
    # 3.4.6 — fs_read of a file holding control bytes is valid JSON
    # ================================================================
    # tests/fixtures/control-bytes.txt holds two ANSI colour sequences (ESC),
    # a BEL, a 0x1f and a TAB, read through the default root ("." = the repo
    # root the runner starts in). Through 3.4.5 the ESC and BEL went out raw
    # and the reply was not JSON: the audit's measured case.
    var cb = fs_read_handler("{\"path\":\"tests/fixtures/control-bytes.txt\"}", 0);
    assert(_lc_has(cb, "isError\":false") == 1, "fs_read reads the fixture");
    assert_eq(jsonx_valid(cb, strlen(cb)), 1, "a file with control bytes reads back as valid JSON");
    assert(_lc_has(cb, "red:\\u001b[31mX\\u001b[0m bell:\\u0007 us:\\u001f tab:\\t end") == 1,
      "ESC, BEL and 0x1f are \\u00XX escapes; TAB keeps \\t");

    # ================================================================
    # 3.4.10 — real input schemas and annotations
    # ================================================================
    assert(registry_validate_params(reg, "fs_write", "{}") != 0, "schema: fs_write requires path");
    assert(registry_validate_params(reg, "fs_write", "{\"path\":\"a.txt\"}") != 0, "schema: fs_write requires content (an empty file is written only on purpose)");
    assert_eq(registry_validate_params(reg, "fs_write", "{\"path\":\"a.txt\",\"content\":\"\"}"), 0, "schema: path + empty content passes");
    assert(registry_validate_params(reg, "fs_read", "{\"path\":5}") != 0, "schema: fs_read path must be a string");
    assert(registry_validate_params(reg, "fs_mkdir", "{}") != 0, "schema: fs_mkdir requires path");
    var fl = dispatcher_dispatch(disp, req_new("1", "tools/list"), 0);
    var flr = resp_result(fl);
    if (flr == 0) { flr = ""; }
    assert(_lc_has(flr, "\"required\":[\"path\",\"content\"]") == 1, "tools/list: fs_write publishes path and content as required");
    assert(_lc_has(flr, "\"readOnlyHint\":false,\"destructiveHint\":true,\"idempotentHint\":true,\"openWorldHint\":false") == 1,
      "tools/list: fs_write is destructive, idempotent and not open-world");
    assert(_lc_has(flr, "\"readOnlyHint\":true") == 1, "tools/list: fs_read is read-only");

    # ---------------- 3.4.15: names, truncation, and what fs_mkdir reports ----------------
    var hl[8];
    var decoded = _fs_unescape("caf\\u00e9", &hl);
    assert_eq(load64(&hl), 5, "decode: \\u00e9 is two bytes");
    assert(_lc_has(fs_write_handler("{\"path\":\"build/fst/caf\\u00e9.txt\",\"content\":\"x\"}", 0), "\"isError\":false") == 1, "path: an escaped name is written");
    assert(_lc_has(fs_read_handler("{\"path\":\"build/fst/caf\\u00e9.txt\"}", 0), "\"text\":\"x\"") == 1, "path: ...under the name it decodes to");
    assert(_lc_has(fs_write_handler("{\"path\":\"build/fst/a\\u0000b\",\"content\":\"x\"}", 0), "\"isError\":true") == 1, "path: a NUL is refused, not cut");
    assert(_lc_has(fs_read_handler("{\"path\":\"\\u002e\\u002e/x\"}", 0), "\"isError\":true") == 1, "path: an escaped .. is still ..");
    var surr = _fs_unescape("\\ud83d\\ude00", &hl);
    assert_eq(load64(&hl), 4, "decode: a surrogate pair is four bytes");
    assert_eq(load8(surr), 240, "decode: ...of one code point");
    var lone = _fs_unescape("\\ud83d", &hl);
    assert_eq(load8(lone), 239, "decode: a lone surrogate is U+FFFD");
    # A file bigger than the cap says so.
    var big_sb = str_builder_new();
    str_builder_add_cstr(big_sb, "{\"path\":\"build/fst/big.txt\",\"content\":\"");
    var bi = 0;
    while (bi < 7000) { str_builder_add_cstr(big_sb, "0123456789"); bi = bi + 1; }
    str_builder_add_cstr(big_sb, "\"}");
    fs_write_handler(str_data(str_builder_build(big_sb)), 0);
    assert(_lc_has(fs_read_handler("{\"path\":\"build/fst/big.txt\"}", 0), "[fs_read: truncated]") == 1, "read: a truncated file says it is");
    assert_eq(_lc_has(fs_read_handler("{\"path\":\"build/fst/caf\\u00e9.txt\"}", 0), "[fs_read: truncated]"), 0, "read: ...and a whole one does not");
    # fs_mkdir reports what is there.
    assert(_lc_has(fs_mkdir_handler("{\"path\":\"build/fst/caf\\u00e9.txt\"}", 0), "\"isError\":true") == 1, "mkdir: over a file is an error");
    assert(_lc_has(fs_mkdir_handler("{\"path\":\"build/fst/caf\\u00e9.txt/sub\"}", 0), "\"isError\":true") == 1, "mkdir: under a file is an error");
    assert(_lc_has(fs_mkdir_handler("{\"path\":\"build/fst/mk/a/b\"}", 0), "\"isError\":false") == 1, "mkdir: a new directory is not");
    assert(_lc_has(fs_mkdir_handler("{\"path\":\"build/fst/mk/a/b\"}", 0), "\"isError\":false") == 1, "mkdir: ...and neither is one that exists");

    # 3.7.2: the read buffer goes once the result is made, not with the message. A caller that
    # never rewinds the arena kept 128 KB a call, and a batch kept 64 KB an element.
    var rmsg = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"fs_read\",\"arguments\":{\"path\":\"build/fst/caf\\u00e9.txt\"}}}";
    assert(_lc_has(codec_process_message(rmsg, disp, 0), "\"text\":\"x\""), "arena: fs_read through the codec");
    var ar = bote_req_alloc();
    var ar_before = bote_req_arena_bytes(ar);
    var heap_before = alloc_used();
    var ri = 0;
    while (ri < 20) {
        codec_process_message(rmsg, disp, 0);
        ri = ri + 1;
    }
    assert_eq(bote_req_arena_bytes(ar), ar_before, "arena: twenty reads, never rewound, add no chunk");
    assert((alloc_used() - heap_before) / 20 < 4096, "arena: ...and keep only their results");
    var bsb = str_builder_new();
    str_builder_add_cstr(bsb, "[");
    var bj = 0;
    while (bj < 50) {
        if (bj > 0) { str_builder_add_cstr(bsb, ","); }
        str_builder_add_cstr(bsb, rmsg);
        bj = bj + 1;
    }
    str_builder_add_cstr(bsb, "]");
    var batch = str_data(str_builder_build(bsb));
    bote_req_begin();
    var bres = codec_process_message_a(bote_req_alloc(), batch, disp, 0);
    assert_eq(_occurs(bres, "\"structuredContent\":{\"text\":\"x\""), 50, "arena: a batch of fifty reads, each answered");
    assert(bote_req_arena_bytes(ar) <= ar_before + 262144, "arena: ...holding one read buffer, not fifty");
    var mk[16];
    bote_req_mark(&mk);
    var m1 = alloc_via(ar, 100000);
    bote_req_release(&mk);
    assert(alloc_via(ar, 100000) == m1, "release: what came after the mark is handed out again");
    var m2 = alloc_via(ar, 16);
    bote_req_mark(&mk);
    alloc_via(ar, 16);
    bote_req_release(&mk);
    assert(alloc_via(ar, 16) == m2 + 16, "release: in the same chunk, from the same byte");

    # ---------------- 3.8.4: fs_read's outputSchema ----------------
    # The text in its block, as since 2.8.0, and structuredContent {text, bytes, truncated},
    # judged by the outputSchema it lists, on both revisions.
    sakshi_set_level(SK_ERROR);
    var sr = fs_read_handler("{\"path\":\"build/fst/caf\\u00e9.txt\"}", 0);
    assert(streq(sr, "{\"content\":[{\"type\":\"text\",\"text\":\"x\"}],\"structuredContent\":{\"text\":\"x\",\"bytes\":1,\"truncated\":false},\"isError\":false}") == 1, "structured: the exact bytes");
    var sbig = fs_read_handler("{\"path\":\"build/fst/big.txt\"}", 0);
    assert(_lc_has(sbig, "\\n[fs_read: truncated]\"}],\"structuredContent\":{\"text\":\"0123") == 1, "structured: a cut file's block ends with the note");
    assert(_lc_has(sbig, "012345\",\"bytes\":65536,\"truncated\":true},\"isError\":false}") == 1, "structured: ...its structured text without it, 65536 bytes, truncated");
    assert_eq(_occurs(sbig, "[fs_read: truncated]"), 1, "structured: ...the note once");
    var smod = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"fs_read\",\"arguments\":{\"path\":\"build/fst/caf\\u00e9.txt\"},\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}}}}";
    var sl1 = codec_process_message(rmsg, disp, 0);
    var sl2 = codec_process_message(smod, disp, 0);
    assert(_lc_has(sl1, "\"structuredContent\":{\"text\":\"x\",\"bytes\":1,\"truncated\":false}") == 1 && _lc_has(sl1, "\"isError\":true") == 0, "structured: passes its schema (2025-11-25)");
    assert(_lc_has(sl2, "\"structuredContent\":{\"text\":\"x\",\"bytes\":1,\"truncated\":false}") == 1 && _lc_has(sl2, "\"isError\":true") == 0, "structured: passes its schema (2026-07-28)");
    var sbm = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"fs_read\",\"arguments\":{\"path\":\"build/fst/big.txt\"},\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}}}}";
    var sbr = codec_process_message(sbm, disp, 0);
    assert(_lc_has(sbr, "\"truncated\":true}") == 1 && _lc_has(sbr, "\"isError\":true") == 0, "structured: a cut file passes too");
    var scb = codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"fs_read\",\"arguments\":{\"path\":\"tests/fixtures/control-bytes.txt\"}}}", disp, 0);
    assert(jsonx_valid(scb, strlen(scb)) == 1 && _lc_has(scb, "\"isError\":false") == 1, "structured: control bytes, valid JSON, passing");
    var sref = codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"fs_read\",\"arguments\":{\"path\":\"../x\"}}}", disp, 0);
    assert(_lc_has(sref, "refused unsafe path") == 1 && _lc_has(sref, "\"isError\":true") == 1 && _lc_has(sref, "structuredContent") == 0, "structured: a refusal is an error result, judged by nothing");
    var stl = codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{}}", disp, 0);
    assert(_lc_has(stl, "\"outputSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"") == 1 && _lc_has(stl, "\"required\":[\"text\",\"bytes\",\"truncated\"]}") == 1, "structured: fs_read lists its outputSchema");
    assert_eq(_occurs(stl, "\"outputSchema\""), 1, "structured: ...and fs_write and fs_mkdir none");
    # The text goes twice now, and a call still keeps no more than its result, made at its
    # size: 131 KB for 64 KB of text, where 3.8.3's text block alone, through a growing
    # builder, kept about 139 KB.
    codec_process_message_a(bote_req_begin(), sbm, disp, 0);
    var sh0 = alloc_used();
    var shi = 0;
    while (shi < 5) { codec_process_message_a(bote_req_begin(), sbm, disp, 0); shi = shi + 1; }
    var sper = (alloc_used() - sh0) / 5;
    assert(sper > 2 * 65536 && sper < 2 * 65536 + 1024, "structured: a 64 KB read keeps its result, the text twice, and nothing more");
    _lc_begin();
    fs_tools_register(dispatcher_new(tool_registry_new()));
    _lc_end();
    assert_eq(_lc_count, 0, "structured: registration warns of nothing");
    # (3.8.5, from the review of 3.8.4) The cut goes back three bytes at most, the longest a
    # character needs: a run of bytes that are no UTF-8 came back as nothing.
    var bad = alloc(65601);
    var bi2 = 0;
    while (bi2 < 65600) { store8(bad + bi2, 128); bi2 = bi2 + 1; }
    store8(bad + 65600, 0);
    var bfd = file_open("build/fst/cont.txt", O_WRONLY | O_CREAT | O_TRUNC, 420);
    file_write(bfd, bad, 65600);
    file_close(bfd);
    var cres = fs_read_handler("{\"path\":\"build/fst/cont.txt\"}", 0);
    assert(_lc_has(cres, "\"bytes\":65536,\"truncated\":true") == 1, "cut: bytes that are no UTF-8 cut at the cap (they came back as nothing)");
    var em = alloc(65601);
    var ej = 0;
    while (ej < 65534) { store8(em + ej, 120); ej = ej + 1; }
    store8(em + 65534, 240); store8(em + 65535, 159); store8(em + 65536, 152); store8(em + 65537, 128);
    ej = 65538;
    while (ej < 65600) { store8(em + ej, 121); ej = ej + 1; }
    var efd = file_open("build/fst/emoji.txt", O_WRONLY | O_CREAT | O_TRUNC, 420);
    file_write(efd, em, 65600);
    file_close(efd);
    assert(_lc_has(fs_read_handler("{\"path\":\"build/fst/emoji.txt\"}", 0), "\"bytes\":65534,\"truncated\":true") == 1, "cut: a four-byte character across the cap left out whole");

    return assert_summary();
}

var rc = main();
sys_exit(rc);
