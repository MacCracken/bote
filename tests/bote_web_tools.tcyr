# bote_web_tools.tcyr — unit tests for src/web_tools.cyr.
#
# Covers the pure, tricky logic without touching the network:
#   - _web_is_http / _web_starts_with  (scheme guard)
#   - _web_html_to_text  (tag strip, script/style skip, entity decode, whitespace collapse)
#   - _web_urlencode     (percent-encoding for the search query)
#   - _web_decode_entity (named + numeric entities)
# The network handlers (web_fetch/web_search) are exercised live, not here.
# Run: cyrius test tests/bote_web_tools.tcyr

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fs.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"
include "lib/fnptr.cyr"
include "lib/chrono.cyr"
include "lib/tagged.cyr"
include "lib/freelist.cyr"
include "lib/thread.cyr"
include "lib/thread_local.cyr"
include "lib/sakshi.cyr"
include "lib/assert.cyr"

include "src/log.cyr"
include "src/error.cyr"
include "src/protocol.cyr"
include "src/jsonx.cyr"
include "src/registry.cyr"
include "src/prompts.cyr"
include "src/resources.cyr"
include "src/events.cyr"
include "src/audit.cyr"
include "src/dispatch.cyr"
include "src/codec.cyr"
include "src/schema.cyr"
include "src/host.cyr"
include "src/web_tools.cyr"

# _t_txt: run _web_html_to_text over `src` and NUL-terminate into `dst`; return dst for streq.
fn _t_txt(src, dst) {
    var n = _web_html_to_text(src, strlen(src), dst, 256);
    store8(dst + n, 0);
    return dst;
}

# ---- sakshi capture (3.4.0 logging assertions) -----------------------------
var _lc_buf = 0;
var _lc_level = 0 - 1;
var _lc_count = 0;
fn _lc_hook(ts, level, category, msg, msg_len, sixth) {
    var n = msg_len;
    if (n > 1023) { n = 1023; }
    memcpy(_lc_buf, msg, n);
    store8(_lc_buf + n, 0);
    _lc_level = level;
    _lc_count = _lc_count + 1;
    return 0;
}
fn _lc_begin() {
    if (_lc_buf == 0) { _lc_buf = alloc(1024); }
    store8(_lc_buf, 0);
    _lc_level = 0 - 1;
    _lc_count = 0;
    sakshi_set_emit_hook(&_lc_hook);
    sakshi_set_level(SK_TRACE);
    return 0;
}
fn _lc_end() { sakshi_clear_emit_hook(); return 0; }
# 1 when cstr `hay` contains cstr `needle`.
fn _lc_has(hay, needle) {
    if (hay == 0 || needle == 0) { return 0; }
    var i = 0;
    while (load8(hay + i) != 0) {
        var j = 0;
        while (load8(needle + j) != 0 && load8(hay + i + j) == load8(needle + j)) { j = j + 1; }
        if (load8(needle + j) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# ---- 3.4.4: a fake embedder resolver (no network) ---------------------------
# Answers as an attacker's DNS might. The guard resolves through it, as it
# would through a real embedder's hook, and must classify what it returns.
var _fk_v6_ula = 0;
var _fk_v6_pub = 0;
fn _fake_resolver(ctx, host, family) {
    if (family == SANDHI_RESOLVE_V4) {
        if (streq(host, "rebind.test") == 1) { return 0x0100007F; }               # 127.0.0.1
        if (streq(host, "meta.test") == 1) { return 0xFEA9FEA9; }                 # 169.254.169.254
        if (streq(host, "public.test") == 1) { return 0x22D8B85D; }               # 93.184.216.34
        return 0 - 1;
    }
    if (streq(host, "v6only.test") == 1) { return _fk_v6_ula; }                  # fd00::1
    if (streq(host, "v6pub.test") == 1) { return _fk_v6_pub; }                   # 2001:4860::8888
    return 0;
}
fn _fake_none(ctx, host, family) {
    if (family == SANDHI_RESOLVE_V4) { return 0 - 1; }
    return 0;
}

fn main() {
    alloc_init();
    var dst = alloc(256);

    # ---------------- scheme guard ----------------
    assert_eq(_web_is_http("http://a.com"),  1, "http:// allowed");
    assert_eq(_web_is_http("https://a.com"), 1, "https:// allowed");
    assert_eq(_web_is_http("ftp://a.com"),   0, "ftp:// refused");
    assert_eq(_web_is_http("file:///etc"),   0, "file:// refused");
    assert_eq(_web_is_http("javascript:x"),  0, "javascript: refused");
    assert_eq(_web_is_http(""),              0, "empty refused");
    assert_eq(_web_is_http(0),               0, "null refused");
    assert_eq(_web_starts_with("hello", "he"), 1, "starts_with hit");
    assert_eq(_web_starts_with("hi", "hello"), 0, "starts_with miss (prefix longer)");

    # ---------------- HTML -> text ----------------
    assert(streq(_t_txt("<p>Hello <b>world</b></p>", dst), "Hello world"), "tags stripped, spaces collapsed");
    assert(streq(_t_txt("<script>var x=1;</script>text", dst), "text"), "<script> block skipped");
    assert(streq(_t_txt("<style>.a{color:red}</style>body", dst), "body"), "<style> block skipped");
    assert(streq(_t_txt("a &amp; b &lt;c&gt;", dst), "a & b <c>"), "named entities decoded");
    assert(streq(_t_txt("&quot;q&quot; &#39;a&#39; &nbsp;x", dst), "\"q\" 'a' x"), "quot/apos/nbsp decoded");
    assert(streq(_t_txt("&#65;&#66;", dst), "AB"), "numeric entities decoded");
    assert(streq(_t_txt("   x   y   ", dst), "x y"), "leading/trailing trimmed, runs collapsed");
    assert(streq(_t_txt("<div>\n  line1\n  line2\n</div>", dst), "line1 line2"), "newlines collapse to a space");
    assert(streq(_t_txt("plain", dst), "plain"), "plain text passes through");
    # untrusted-page control bytes + a raw NUL are DROPPED (else invalid JSON / silent truncation downstream)
    var cb = alloc(16);
    store8(cb + 0, 97); store8(cb + 1, 12); store8(cb + 2, 98); store8(cb + 3, 0);   # 'a' FF 'b' NUL
    store8(cb + 4, 99); store8(cb + 5, 1);  store8(cb + 6, 100);                      # 'c' 0x01 'd'
    var cn = _web_html_to_text(cb, 7, dst, 256);
    store8(dst + cn, 0);
    assert(streq(dst, "abcd"), "C0 control bytes + raw NUL dropped (no invalid JSON, no truncation)");
    assert(streq(_t_txt("x&#12;y", dst), "xy"), "&#12; (control) entity dropped");

    # ---------------- url-encode ----------------
    var enc = alloc(64);
    _web_urlencode("a b", enc, 64);    assert(streq(enc, "a%20b"), "space -> %20");
    _web_urlencode("c++", enc, 64);    assert(streq(enc, "c%2B%2B"), "'+' -> %2B");
    _web_urlencode("x-y_z.~", enc, 64); assert(streq(enc, "x-y_z.~"), "unreserved pass through");
    _web_urlencode("a=b&c", enc, 64);  assert(streq(enc, "a%3Db%26c"), "'=' and '&' encoded");

    # ---------------- decode_entity (raw) ----------------
    var e = _web_decode_entity("&amp;xyz", 8, 0);
    assert_eq(e / 1048576, 38, "&amp; -> '&' (0x26)");
    assert_eq(e % 1048576, 5,  "&amp; consumes 5 bytes");
    assert_eq(_web_decode_entity("&bogus;", 7, 0), 0, "unknown entity -> 0 (left literal)");


    # ================================================================
    # 3.4.0 — web_fetch applies the SSRF guard before any network call
    # ================================================================
    # Each of these is refused before _web_get, so no request leaves the box.
    _lc_begin();
    var lo = web_fetch_handler("{\"url\":\"http://127.0.0.1:8080/admin\"}", 0);
    assert(_lc_has(lo, "SSRF guard: loopback") == 1, "web_fetch refuses loopback");
    assert(_lc_has(lo, "\"isError\":true") == 1, "the refusal is an isError result");
    assert_eq(_lc_level, SK_WARN, "the refusal is logged at WARN");
    assert(_lc_has(_lc_buf, "reason=loopback") == 1, "the line names the reason");
    assert(_lc_has(_lc_buf, "host=127.0.0.1") == 1, "the line names the host");
    var md = web_fetch_handler("{\"url\":\"http://169.254.169.254/latest/meta-data/\"}", 0);
    assert(_lc_has(md, "SSRF guard:") == 1, "web_fetch refuses the cloud metadata address");
    var pv = web_fetch_handler("{\"url\":\"http://admin:hunter2@10.1.2.3/\"}", 0);
    assert(_lc_has(pv, "SSRF guard: private") == 1, "web_fetch refuses a private address");
    assert(_lc_has(_lc_buf, "host=10.1.2.3") == 1, "the line names the private host");
    assert_eq(_lc_has(_lc_buf, "hunter2"), 0, "URL userinfo never reaches the log line");
    var v6 = web_fetch_handler("{\"url\":\"http://[::1]/\"}", 0);
    assert(_lc_has(v6, "SSRF guard: loopback") == 1, "web_fetch refuses IPv6 loopback");
    _lc_end();


    # ================================================================
    # 3.4.4 — the resolved address is classified, through sandhi's hook
    # ================================================================
    # Every name below passes the URL pre-check (not a literal, not on the
    # blocklist) and is refused only once its answer is classified. Nothing
    # here leaves the box: each refusal happens before connect.
    _fk_v6_ula = alloc(16);
    memset(_fk_v6_ula, 0, 16);
    store8(_fk_v6_ula, 0xFD); store8(_fk_v6_ula + 15, 1);
    _fk_v6_pub = alloc(16);
    memset(_fk_v6_pub, 0, 16);
    store8(_fk_v6_pub, 0x20); store8(_fk_v6_pub + 1, 0x01); store8(_fk_v6_pub + 2, 0x48);
    store8(_fk_v6_pub + 3, 0x60); store8(_fk_v6_pub + 14, 0x88); store8(_fk_v6_pub + 15, 0x88);

    assert_eq(ssrf_check("http://rebind.test/x"), SSRF_OK, "rebind.test passes the string check (why the hook is needed)");
    sandhi_client_set_resolver(&_fake_resolver, 0);
    _lc_begin();
    var g_rb = web_fetch_handler("{\"url\":\"http://rebind.test/x\"}", 0);
    assert(_lc_has(g_rb, "SSRF guard: loopback, resolved address") == 1, "a name resolving to 127.0.0.1 is refused");
    assert(_lc_has(g_rb, "\"isError\":true") == 1, "the refusal is an isError result");
    assert_eq(_lc_level, SK_WARN, "the resolved-address refusal is a WARN");
    assert(_lc_has(_lc_buf, "host=rebind.test addr=127.0.0.1") == 1, "the line names the host and the address it resolved to");
    assert_eq(_sandhi_client_resolver_fn, &_fake_resolver, "the embedder's hook is restored after the fetch");
    var g_mt = web_fetch_handler("{\"url\":\"https://meta.test/latest/meta-data/\"}", 0);
    assert(_lc_has(g_mt, "SSRF guard: metadata, resolved address") == 1, "a name resolving to 169.254.169.254 is refused");
    var g_v6 = web_fetch_handler("{\"url\":\"http://v6only.test/\"}", 0);
    assert(_lc_has(g_v6, "SSRF guard: private, resolved address") == 1, "a name whose only answer is fd00::1 is refused");
    assert(_lc_has(_lc_buf, "addr=fd00:0:0:0:0:0:0:1") == 1, "the line names the IPv6 address");
    _lc_end();

    # The hook itself, called directly (no request, so no connect):
    _web_prev_fn = &_fake_resolver;
    _web_prev_ctx = 0;
    _web_refused = 0;
    assert_eq(_web_ssrf_resolve(0, "public.test", SANDHI_RESOLVE_V4), 0x22D8B85D, "a public IPv4 answer is passed through");
    assert_eq(_web_refused, 0, "a public answer records no refusal");
    assert_eq(_web_ssrf_resolve(0, "v6pub.test", SANDHI_RESOLVE_V6), _fk_v6_pub, "a public IPv6 answer is passed through");
    assert_eq(_web_ssrf_resolve(0, "rebind.test", SANDHI_RESOLVE_V4), 0 - 1, "a loopback IPv4 answer is refused");
    assert_eq(_web_ssrf_resolve(0, "v6pub.test", SANDHI_RESOLVE_V6), 0, "after an IPv4 refusal the name is refused on IPv6 too");
    _web_refused = 0;
    assert_eq(_web_ssrf_resolve(0, "unknown.test", SANDHI_RESOLVE_V4), 0 - 1, "no answer is no address (sandhi then asks IPv6)");
    assert_eq(_web_refused, 0, "no answer is not a refusal");
    _web_prev_fn = 0;

    # With no hook installed before the fetch, none is left after it. An IPv6
    # literal gives an answer on neither family without a DNS query, so this
    # makes no network call either.
    sandhi_client_clear_resolver();
    _web_get_guarded("http://[2001:db8::1]/");
    assert_eq(sandhi_client_resolver_installed(), 0, "with no hook before, none is installed after");
    sandhi_client_set_resolver(&_fake_none, 0);
    _web_get_guarded("http://nowhere.test/");
    assert_eq(_sandhi_client_resolver_fn, &_fake_none, "an embedder's hook survives a fetch that resolved nothing");
    # The guard never chains to itself, even if its hook was left installed.
    sandhi_client_set_resolver(&_web_ssrf_resolve, 0);
    _web_get_guarded("http://[2001:db8::2]/");
    assert_eq(sandhi_client_resolver_installed(), 0, "a stale guard hook is not treated as an embedder's (no self-recursion)");
    sandhi_client_clear_resolver();

    return assert_summary();
}

var rc = main();
sys_exit(rc);
