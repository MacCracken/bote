fn h_ok(args, claims) { return "{\"content\":[{\"type\":\"text\",\"text\":\"ok\"}]}"; }
fn h_prompt(args, claims) { return "{\"messages\":[]}"; }
fn h_res(uri, claims) { return "{\"contents\":[]}"; }
fn h_array(uri, claims) { return "[1]"; }

var _seen_claims = 0;
fn h_claims(args, claims) {
    _seen_claims = claims;
    return "{\"content\":[]}";
}
fn h_pclaims(args, claims) { _seen_claims = claims; return "{\"messages\":[]}"; }
fn h_rclaims(uri, claims) { _seen_claims = claims; return "{\"contents\":[]}"; }
fn h_cclaims(params, claims) { _seen_claims = claims; return "{\"completion\":{\"values\":[]}}"; }
fn _allow(token, ctx) { return "the-claims"; }
fn _deny(token, ctx) { return 0; }
# Validators and a scope check for 3.6.3: the token is the list of what it holds.
fn _tok(token, ctx) { return token; }
fn _holds(claims, scope, ctx) { return strstr(claims, scope) >= 0; }

# A required scope 200 bytes long, told apart by `i`.
fn _scope_200(i) {
    var out = alloc(201);
    memset(out, 120, 200);
    store8(out + 200, 0);
    store8(out, 65 + i / 26);
    store8(out + 1, 65 + i % 26);
    return out;
}

var _audited = 0;
var _aud_ev = 0;
fn _aud(ctx, ev) {
    _audited = _audited + 1;
    _aud_ev = ev;
    return 0;
}

fn _mk_d() {
    var reg = tool_registry_new();
    registry_register(reg, tool_def_new("t_echo", "Echo", schema_new("object", 0, vec_new())));
    registry_register(reg, tool_def_new("t_claims", "Claims", schema_new("object", 0, vec_new())));
    var props = vec_new();
    vec_push(props, schema_prop_new("n", "{\"type\":\"integer\"}"));
    var req = vec_new();
    vec_push(req, "n");
    var sch = schema_new("object", props, req);
    registry_register(reg, tool_def_with_compiled(tool_def_new("t_int", "Int", sch), compiled_compile(sch)));
    var pp = vec_new();
    vec_push(pp, schema_prop_new("region", "{\"type\":\"string\",\"x-mcp-header\":\"Region\"}"));
    vec_push(pp, schema_prop_new("n", "{\"type\":\"integer\",\"x-mcp-header\":\"Count\"}"));
    vec_push(pp, schema_prop_new("flag", "{\"type\":\"boolean\",\"x-mcp-header\":\"Flag\"}"));
    vec_push(pp, schema_prop_new("a", "{\"type\":\"object\",\"properties\":{\"b\":{\"type\":\"string\",\"x-mcp-header\":\"Deep\"}}}"));
    registry_register(reg, tool_def_new("t_param", "Param", schema_new("object", pp, vec_new())));
    # (3.8.3) An inputSchema given as JSON, its annotated property's type escaped.
    registry_register(reg, tool_def_new("t_jparam", "Param from JSON", tool_schema_from_json("{\"type\":\"object\",\"$defs\":{\"z\":{\"type\":\"string\"}},\"properties\":{\"zone\":{\"type\":\"str\\u0069ng\",\"x-mcp-header\":\"Zone\"}},\"additionalProperties\":false}")));
    var two = vec_new();
    vec_push(two, "files:read");
    vec_push(two, "files:write");
    registry_register(reg, tool_def_with_required_scopes(tool_def_new("t_scoped", "Scoped", schema_new("object", 0, vec_new())), two));
    var many = vec_new();
    var mi = 0;
    while (mi < 64) {
        vec_push(many, _scope_200(mi));
        mi = mi + 1;
    }
    registry_register(reg, tool_def_with_required_scopes(tool_def_new("t_many", "Many", schema_new("object", 0, vec_new())), many));
    # A map's hash is seeded per process. A null key looks in slot 0 and crashes only
    # if a key sits there, about one run in four with this many tools, so a missing
    # guard passes three runs of four. Fill the slot, and every run is that run.
    var zi = 0;
    while (zi < 5000 && load64(load64(registry_entries(reg)) + 16) == 0) {
        var zb = str_builder_new();
        str_builder_add_cstr(zb, "z");
        str_builder_add_int(zb, zi);
        registry_register(reg, tool_def_new(str_data(str_builder_build(zb)), "Z", schema_new("object", 0, vec_new())));
        zi = zi + 1;
    }
    var d = dispatcher_new(reg);
    dispatcher_handle(d, "t_echo", &h_ok);
    dispatcher_handle(d, "t_param", &h_ok);
    dispatcher_handle(d, "t_jparam", &h_ok);
    dispatcher_handle(d, "t_claims", &h_claims);
    dispatcher_handle(d, "t_int", &h_ok);
    dispatcher_handle(d, "t_scoped", &h_claims);
    dispatcher_handle(d, "t_many", &h_claims);
    dispatcher_register_prompt(d, prompt_def_new("p_one", "One", vec_new()), &h_prompt);
    dispatcher_register_prompt(d, prompt_def_new("t_param", "Shares a tool's name", vec_new()), &h_prompt);
    dispatcher_register_resource(d, resource_def_new("res://a", "a", "A", "text/plain"), &h_res);
    dispatcher_register_resource(d, resource_def_new("res://\xC3\xA9", "e", "E", "text/plain"), &h_res);
    dispatcher_register_resource(d, resource_def_new("res://bad", "bad", "Bad", "text/plain"), &h_array);
    # 3.6.6: a prompt, a resource and a template that ask for the same two scopes as t_scoped.
    dispatcher_register_prompt(d, prompt_def_with_required_scopes(prompt_def_new("p_scoped", "Scoped", vec_new()), two), &h_pclaims);
    dispatcher_register_resource(d, resource_def_with_required_scopes(resource_def_new("res://scoped", "s", "S", "text/plain"), two), &h_rclaims);
    dispatcher_register_resource_template(d, resource_template_with_required_scopes(resource_template_new("res://t/{id}", "t", "T", "text/plain"), two), &h_rclaims);
    dispatcher_set_completion(d, &h_cclaims);
    return d;
}

# 1 when `hay` holds `needle`.
fn _has(hay, needle) { return strstr(hay, needle) >= 0; }

fn _one_vec(s) {
    var v = vec_new();
    vec_push(v, s);
    return v;
}

# ---- requests -----------------------------------------------------------------

fn _cat3(a, b, c) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    str_builder_add_cstr(sb, c);
    return str_data(str_builder_build(sb));
}

fn _rep(s, n) {
    var sb = str_builder_new();
    var i = 0;
    while (i < n) {
        str_builder_add_cstr(sb, s);
        i = i + 1;
    }
    return str_data(str_builder_build(sb));
}

fn _raw(verb, hdrs, body) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, verb);
    str_builder_add_cstr(sb, " /mcp HTTP/1.1\r\nHost: x\r\n");
    str_builder_add_cstr(sb, hdrs);
    str_builder_add_cstr(sb, "Content-Length: ");
    str_builder_add_int(sb, strlen(body));
    str_builder_add_cstr(sb, "\r\n\r\n");
    str_builder_add_cstr(sb, body);
    return str_data(str_builder_build(sb));
}

var _META = "\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}}";

# A modern body: `method`, with `extra` (`,"name":...` or "") beside `_meta`.
fn _mb(method, extra) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"");
    str_builder_add_cstr(sb, method);
    str_builder_add_cstr(sb, "\",\"params\":{");
    str_builder_add_cstr(sb, _META);
    str_builder_add_cstr(sb, extra);
    str_builder_add_cstr(sb, "}}");
    return str_data(str_builder_build(sb));
}

# A legacy body with no params.
fn _lb(method) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"");
    str_builder_add_cstr(sb, method);
    str_builder_add_cstr(sb, "\"}");
    return str_data(str_builder_build(sb));
}

var _V = "MCP-Protocol-Version: 2026-07-28\r\n";

# The modern headers for `method`, and `Mcp-Name: name` unless it is 0.
fn _mh(method, name) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, _V);
    str_builder_add_cstr(sb, "Mcp-Method: ");
    str_builder_add_cstr(sb, method);
    str_builder_add_cstr(sb, "\r\n");
    if (name != 0) {
        str_builder_add_cstr(sb, "Mcp-Name: ");
        str_builder_add_cstr(sb, name);
        str_builder_add_cstr(sb, "\r\n");
    }
    return str_data(str_builder_build(sb));
}

# ---- the handlers, over a socketpair ------------------------------------------
#ifndef CYRIUS_TARGET_AGNOS

var _rbuf = 0;
var _rcv = 0;
var _status = 0;
var _replies = 0;
var _head = 0;
var _body = 0;
var _http_cfg = 0;
var _strm_cfg = 0;
var _brg_cfg = 0;

fn _run(kind, raw) { return _run_n(kind, raw, strlen(raw)); }

# _run, for a request of `n` bytes that may hold a NUL.
fn _run_n(kind, raw, n) {
    memcpy(_rbuf, raw, n);
    store8(_rbuf + n, 0);
    # The bridge's endpoint is "/".
    if (kind == 2) {
        var mp = strstr(_rbuf, " /mcp ");
        if (mp >= 0) { memcpy(_rbuf + mp + 2, "   ", 3); }
    }
    var sp[16];
    sys_socketpair(1, 1, 0, &sp);
    var sa = load32(&sp);
    var sb = load32(&sp + 4);
    if (kind == 0) { _http_handle(_http_cfg, sa, _rbuf, n); }
    elif (kind == 1) { _strm_handle(_strm_cfg, sa, _rbuf, n); }
    else { _bridge_handle(_brg_cfg, sa, _rbuf, n); }
    sys_close(sa);
    var got = 0;
    var r = sys_read(sb, _rcv, 262144);
    while (r > 0) {
        got = got + r;
        r = sys_read(sb, _rcv + got, 262144 - got);
    }
    sys_close(sb);
    store8(_rcv + got, 0);
    _replies = 0;
    var ri = 0;
    while (ri + 9 <= got) {
        if (memeq(_rcv + ri, "HTTP/1.1 ", 9) == 1) { _replies = _replies + 1; }
        ri = ri + 1;
    }
    _status = 0;
    if (got > 12) { _status = (load8(_rcv + 9) - 48) * 100 + (load8(_rcv + 10) - 48) * 10 + load8(_rcv + 11) - 48; }
    var e = strstr(_rcv, "\r\n\r\n");
    _head = _rcv;
    _body = "";
    if (e >= 0) {
        store8(_rcv + e + 2, 0);
        _body = _rcv + e + 4;
    }
    return 0;
}

fn _code() {
    var e = jsonx_get_raw(_body, "error");
    if (e == 0) { return ""; }
    return jsonx_get_raw(e, "code");
}

fn _nm(kind, name) {
    if (kind == 0) { return _cat3("http: ", name, ""); }
    if (kind == 1) { return _cat3("streamable: ", name, ""); }
    return _cat3("bridge: ", name, "");
}

# `raw` gets `status`, and the JSON-RPC error `code`, or none when it is "".
fn _t(kind, raw, status, code, name) {
    _run(kind, raw);
    assert_eq(_status, status, _nm(kind, name));
    assert_eq(_replies, 1, _nm(kind, _cat3(name, ": one reply", "")));
    assert(streq(_code(), code) == 1, _nm(kind, _cat3(name, ": the error code", "")));
    return 0;
}

# Bytes `raw` leaves on the heap per message.
fn _heap_per(kind, raw) {
    _run(kind, raw);
    var before = alloc_used();
    var i = 0;
    while (i < 20) {
        _run(kind, raw);
        i = i + 1;
    }
    return (alloc_used() - before) / 20;
}

fn _ok_tool() { return _mb("tools/call", ",\"name\":\"t_echo\""); }

# `raw` with the harness's own Host line gone, for a request that sends its own.
fn _ohost(raw) {
    var at = strstr(raw, "Host: x\r\n");
    var sb = str_builder_new();
    var head = alloc(at + 1);
    memcpy(head, raw, at);
    store8(head + at, 0);
    str_builder_add_cstr(sb, head);
    str_builder_add_cstr(sb, raw + at + 9);
    return str_data(str_builder_build(sb));
}

# A request for `target`, with no body.
fn _get(verb, target, hdrs) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, verb);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, target);
    str_builder_add_cstr(sb, " HTTP/1.1\r\nHost: x\r\n");
    str_builder_add_cstr(sb, hdrs);
    str_builder_add_cstr(sb, "\r\n");
    return str_data(str_builder_build(sb));
}

var _WK = "/.well-known/oauth-protected-resource/mcp";
var _DOC = "{\"resource\":\"https://mcp.example.com/mcp\",\"authorization_servers\":[\"https://as.example.com\"],\"scopes_supported\":[\"files:read\",\"files:write\"],\"bearer_methods_supported\":[\"header\"],\"resource_name\":\"bote test\"}";
var _CHALLENGE = "WWW-Authenticate: Bearer resource_metadata=\"https://mcp.example.com/.well-known/oauth-protected-resource/mcp\", scope=\"files:read files:write\"";

fn _prm_set(k, p) {
    if (k == 0) { http_config_with_resource_metadata(_http_cfg, p); }
    elif (k == 1) { streamable_config_with_resource_metadata(_strm_cfg, p); }
    else { bridge_config_with_resource_metadata(_brg_cfg, p); }
    return 0;
}

fn _prm_bearer(k, fp, ctx) {
    if (k == 0) { http_config_with_bearer_validator(_http_cfg, fp, ctx); }
    elif (k == 1) { streamable_config_with_bearer_validator(_strm_cfg, fp, ctx); }
    else { bridge_config_with_bearer_validator(_brg_cfg, fp, ctx); }
    return 0;
}

# The status of `raw` on `k`.
fn _st(k, raw) {
    _run(k, raw);
    return _status;
}

fn _metadata(k, prm) {
    _prm_set(k, prm);
    _prm_bearer(k, &_deny, 0);
    assert_eq(_st(k, _get("GET", _WK, "")), 200, _nm(k, "metadata: served with no token"));
    assert(streq(_body, _DOC) == 1, _nm(k, "metadata: the document"));
    assert(_has(_head, "Content-Type: application/json"), _nm(k, "metadata: as JSON"));
    assert_eq(_replies, 1, _nm(k, "metadata: one reply"));
    assert_eq(_st(k, _get("GET", _WK, "Authorization: Bearer nope\r\n")), 200, _nm(k, "metadata: a bad token does not matter"));
    assert_eq(_st(k, _get("GET", _cat3(_WK, "?x=1", ""), "")), 200, _nm(k, "metadata: a query is no other path"));
    _run(k, _get("GET", _WK, "Host: evil.example\r\nX-Forwarded-Host: evil.example\r\n"));
    assert(streq(_body, _DOC) == 1, _nm(k, "metadata: no header reaches the document"));
    assert_eq(_st(k, _get("POST", _WK, "")), 405, _nm(k, "metadata: GET alone"));
    assert(_has(_head, "Allow: GET\r\n"), _nm(k, "metadata: ...and says so"));
    assert_eq(_st(k, _get("DELETE", _WK, "")), 405, _nm(k, "metadata: nor DELETE"));
    assert_eq(_st(k, _get("GET", _WK, "Transfer-Encoding: chunked\r\n")), 400, _nm(k, "metadata: Transfer-Encoding is refused here too"));
    assert_eq(_st(k, _get("GET", _WK, "Origin: https://evil.example\r\n")), 403, _nm(k, "metadata: a hostile Origin"));
    assert_eq(_st(k, _get("GET", _cat3(_WK, "x", ""), "")) == 200, 0, _nm(k, "metadata: a longer path is not it"));
    assert_eq(_st(k, _get("GET", "/.well-known/oauth-protected-resource", "")) == 200, 0, _nm(k, "metadata: nor is the root"));

    # The 401.
    _t(k, _raw("POST", _mh("tools/list", 0), _mb("tools/list", "")), 401, "", "no token, with metadata");
    assert(_has(_head, _CHALLENGE), _nm(k, "challenge: names the metadata and the scope"));
    assert(_has(_head, "realm=") == 0, _nm(k, "challenge: and no realm"));
    assert(_has(_head, "error=") == 0, _nm(k, "challenge: no error with no token"));
    _t(k, _raw("POST", _cat3(_mh("tools/list", 0), "Authorization: Bearer nope\r\n", ""), _mb("tools/list", "")), 401, "", "a bad token, with metadata");
    assert(_has(_head, _CHALLENGE) && _has(_head, ", error=\"invalid_token\"\r\n"), _nm(k, "challenge: a refused token says so"));

    if (k == 1) {
        _t(1, _get("GET", "/mcp", ""), 401, "", "a GET with no token, with metadata");
        assert(_has(_head, _CHALLENGE), "streamable: the stream's 401 names it too");
    }

    # Nothing here keeps a byte.
    var long = _rep("x", 60000);
    assert_eq(_heap_per(k, _get("GET", _WK, "")), 0, _nm(k, "heap: the document"));
    assert_eq(_heap_per(k, _get("GET", _cat3(_WK, "/", long), "")), 0, _nm(k, "heap: a 60 KB path"));
    assert_eq(_heap_per(k, _get("GET", _WK, _cat3("Origin: ", long, "\r\n"))), 0, _nm(k, "heap: a 60 KB Origin"));
    assert_eq(_heap_per(k, _raw("POST", _mh("tools/list", 0), _mb("tools/list", ""))), 0, _nm(k, "heap: a 401"));
    assert_eq(_heap_per(k, _raw("POST", _cat3(_mh("tools/list", 0), "Authorization: Bearer ", _cat3(long, "\r\n", "")), _mb("tools/list", ""))), 0, _nm(k, "heap: a 401 for a 60 KB token"));

    # With none configured nothing changes.
    _prm_set(k, 0);
    assert_eq(_st(k, _get("GET", _WK, "")) == 200, 0, _nm(k, "metadata: not served unless configured"));
    _t(k, _raw("POST", _mh("tools/list", 0), _mb("tools/list", "")), 401, "", "no token, no metadata");
    assert(_has(_head, "WWW-Authenticate: Bearer realm=\"mcp\"\r\n"), _nm(k, "challenge: the plain one"));
    _prm_bearer(k, 0, 0);
    return 0;
}

fn _d_of(k) {
    if (k == 0) { return http_config_dispatcher(_http_cfg); }
    if (k == 1) { return streamable_config_dispatcher(_strm_cfg); }
    return bridge_config_dispatcher(_brg_cfg);
}

fn _ah(tok) { return _cat3("Authorization: Bearer ", tok, "\r\n"); }

# A legacy request for `method` with `params`.
fn _sp_body(method, params) {
    return _cat3(_cat3("{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"", method, "\",\"params\":"), params, "}");
}

# A modern tools/call of `tool` with the token `tok`, and `extra` beside its name.
fn _mc_x(tool, tok, extra) {
    return _raw("POST", _cat3(_mh("tools/call", tool), _ah(tok), ""), _mb("tools/call", _cat3(",\"name\":\"", tool, _cat3("\"", extra, ""))));
}
fn _mc(tool, tok) { return _mc_x(tool, tok, ""); }

# The same on the legacy path, in `params`.
fn _lc_body(tool, extra) {
    return _cat3("{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/call\",\"params\":{\"name\":\"", tool, _cat3("\"", extra, "}}"));
}
fn _lc(tool, tok) { return _raw("POST", _ah(tok), _lc_body(tool, "")); }

var _CH403 = "WWW-Authenticate: Bearer error=\"insufficient_scope\", scope=\"files:read files:write\", resource_metadata=\"https://mcp.example.com/.well-known/oauth-protected-resource/mcp\"\r\n";

# `raw` is refused 403, and no handler ran.
fn _t403(k, raw, name) {
    _seen_claims = 0;
    _t(k, raw, 403, "", name);
    assert_eq(_seen_claims, 0, _nm(k, _cat3(name, ": no handler ran", "")));
    return 0;
}

fn _scopes(k, prm) {
    var d = _d_of(k);
    _prm_set(k, prm);
    _prm_bearer(k, &_tok, 0);
    dispatcher_set_scope_check(d, &_holds, 0);
    # A session is another check, ahead of a legacy request that passes this one.
    var st = 0;
    if (k == 0) {
        st = http_config_session_store(_http_cfg);
        http_config_with_session_store(_http_cfg, 0);
    }
    if (k == 1) {
        st = streamable_config_session_store(_strm_cfg);
        streamable_config_with_session_store(_strm_cfg, 0);
    }

    # The 403, on both paths.
    _t403(k, _mc("t_scoped", "files:read"), "scope: one of two");
    assert(_has(_head, _CH403), _nm(k, "scope: the challenge, every scope in it"));
    assert_eq(strlen(_body), 0, _nm(k, "scope: an empty body, like the 401"));
    assert(_has(_head, "HTTP/1.1 403 Forbidden\r\n"), _nm(k, "scope: Forbidden"));
    _t403(k, _mc("t_scoped", "files:write"), "scope: the other of two");
    _t403(k, _mc("t_scoped", "nothing"), "scope: neither");
    _t403(k, _lc("t_scoped", "files:read"), "scope: legacy");
    assert(_has(_head, _CH403), _nm(k, "scope: legacy, the same challenge"));
    _t403(k, _raw("POST", _ah("nothing"), _lc_body("t\\u005fscoped", "")), "scope: an escaped name is the name");
    _t403(k, _raw("POST", _ah("nothing"), "  {\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/\\u0063all\",\"params\":{\"name\":\"t_scoped\"}}"), "scope: an escaped method, and leading space");
    _t403(k, _raw("POST", _ah("nothing"), _lc_body("t_scoped", ",\"arguments\":{\"n\":\"not what a schema wants\"}")), "scope: ahead of the arguments");
    _t403(k, _raw("POST", _ah("nothing"), _lc_body("t_scoped", ",\"version\":\"9.9\"")), "scope: ahead of the version");

    # What goes through.
    _seen_claims = 0;
    _t(k, _mc("t_scoped", "files:read,files:write"), 200, "", "scope: both held");
    assert(_seen_claims != 0 && streq(_seen_claims, "files:read,files:write") == 1, _nm(k, "scope: the handler sees the claims"));
    _t(k, _mc("t_echo", "nothing"), 200, "", "scope: a tool that asks for none");
    _t(k, _raw("POST", _cat3(_mh("tools/list", 0), _ah("nothing"), ""), _mb("tools/list", "")), 200, "", "scope: not a tool call");
    assert_eq(_st(k, _raw("POST", _ah("nothing"), _lc_body("t_nope", ""))) == 403, 0, _nm(k, "scope: an unknown tool is the dispatcher's"));
    assert_eq(_st(k, _raw("POST", _ah("nothing"), "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"prompts/get\",\"params\":{\"name\":\"t_scoped\"}}")) == 403, 0, _nm(k, "scope: another method that happens to name the tool"));
    assert_eq(_st(k, _raw("POST", _ah("nothing"), _lb("tools/call"))) == 403, 0, _nm(k, "scope: no params"));
    assert_eq(_st(k, _raw("POST", _ah("nothing"), "{\"jsonrpc\":\"2.0\",\"id\":7,\"params\":{\"name\":\"t_scoped\"}}")) == 403, 0, _nm(k, "scope: no method"));
    assert_eq(_st(k, _raw("POST", _ah("nothing"), "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":5,\"params\":{\"name\":\"t_scoped\"}}")) == 403, 0, _nm(k, "scope: a method that is no string"));
    assert_eq(_st(k, _raw("POST", _ah("nothing"), "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/call\",\"params\":[\"t_scoped\"]}")) == 403, 0, _nm(k, "scope: params that are no object"));
    assert_eq(_st(k, _raw("POST", _ah("nothing"), "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/call\",\"params\":{\"name\":5}}")) == 403, 0, _nm(k, "scope: a name that is no string"));
    assert_eq(_st(k, _raw("POST", _ah("nothing"), "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/call\",\"params\":{\"name\":\"t_scoped\"}")) == 403, 0, _nm(k, "scope: a body that is no JSON is the codec's"));
    _seen_claims = 0;
    assert_eq(_st(k, _raw("POST", _ah("nothing"), "{\"jsonrpc\":\"2.0\",\"method\":\"tools/call\",\"params\":{\"name\":\"t_scoped\"}}")) == 403, 0, _nm(k, "scope: a notification gets no reply, and so no 403"));
    assert_eq(_seen_claims, 0, _nm(k, "scope: ...and runs nothing"));

    # A repeated key is read one way by everything: never the tool under the wrong check.
    _seen_claims = 0;
    _run(k, _raw("POST", _ah("nothing"), "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/call\",\"params\":{\"name\":\"t_echo\",\"name\":\"t_scoped\"}}"));
    assert_eq(_seen_claims, 0, _nm(k, "scope: a repeated name"));
    _run(k, _raw("POST", _ah("nothing"), "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/call\",\"method\":\"tools/list\",\"params\":{\"name\":\"t_scoped\"}}"));
    assert_eq(_seen_claims, 0, _nm(k, "scope: a repeated method"));
    # (3.8.6) It is the codec's to refuse, whichever of the two the token may not call.
    assert(_st(k, _raw("POST", _ah("nothing"), "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/call\",\"params\":{\"name\":\"t_scoped\",\"name\":\"t_echo\"}}")) != 403, _nm(k, "scope: a repeated name is no 403"));
    assert(_has(_body, "-32600"), _nm(k, "scope: ...but the codec's -32600"));
    assert(_st(k, _raw("POST", _ah("nothing"), "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"prompts/get\",\"params\":{\"name\":\"p_scoped\",\"arguments\":{\"a\":1,\"a\":2}}}")) != 403, _nm(k, "scope: a prompt's repeated argument is no 403"));
    assert(_has(_body, "-32600"), _nm(k, "scope: ...but the codec's -32600"));

    # A batch has no status of its own, so the dispatcher refuses the element.
    _seen_claims = 0;
    var batch = _cat3("[", _lc_body("t_scoped", ""), _cat3(",", _lc_body("t_echo", ""), "]"));
    _run(k, _raw("POST", _ah("nothing"), batch));
    assert_eq(_status, 200, _nm(k, "scope: a batch is a 200"));
    assert(_has(_body, "\"code\":-31403"), _nm(k, "scope: its element is refused"));
    assert(_has(_body, "insufficient scope for tool: t_scoped"), _nm(k, "scope: ...naming the tool"));
    assert(_has(_body, "\"result\""), _nm(k, "scope: the other element still runs"));
    assert_eq(_seen_claims, 0, _nm(k, "scope: ...and the refused one did not"));
    _run(k, _raw("POST", _ah("files:read,files:write"), batch));
    assert(_seen_claims != 0, _nm(k, "scope: a batch with the scopes runs"));

    # 3.6.6: a prompt, a resource, a template, and a completion that names one of them.
    _t403(k, _raw("POST", _ah("files:read"), _sp_body("prompts/get", "{\"name\":\"p_scoped\"}")), "scope: a prompt");
    assert(_has(_head, _CH403), _nm(k, "scope: a prompt's challenge, every scope in it"));
    _t403(k, _raw("POST", _cat3(_mh("prompts/get", "p_scoped"), _ah("files:read"), ""), _mb("prompts/get", ",\"name\":\"p_scoped\"")), "scope: a prompt, modern");
    _t403(k, _raw("POST", _ah("files:write"), _sp_body("resources/read", "{\"uri\":\"res://scoped\"}")), "scope: a resource");
    _t403(k, _raw("POST", _cat3(_mh("resources/read", "res://scoped"), _ah("files:write"), ""), _mb("resources/read", ",\"uri\":\"res://scoped\"")), "scope: a resource, modern");
    _t403(k, _raw("POST", _ah("nothing"), _sp_body("resources/read", "{\"uri\":\"res://t/77\"}")), "scope: a URI a template serves");
    _t403(k, _raw("POST", _ah("nothing"), _sp_body("completion/complete", "{\"ref\":{\"type\":\"ref/prompt\",\"name\":\"p_scoped\"},\"argument\":{\"name\":\"a\",\"value\":\"b\"}}")), "scope: completing a prompt's argument");
    _t403(k, _raw("POST", _ah("nothing"), _sp_body("completion/complete", "{\"ref\":{\"type\":\"ref/resource\",\"uri\":\"res://t/{id}\"},\"argument\":{\"name\":\"id\",\"value\":\"b\"}}")), "scope: completing a template's variable");
    _seen_claims = 0;
    _t(k, _raw("POST", _ah("files:read,files:write"), _sp_body("prompts/get", "{\"name\":\"p_scoped\"}")), 200, "", "scope: a prompt, held");
    assert(_seen_claims != 0, _nm(k, "scope: ...and its handler ran"));
    _t(k, _raw("POST", _ah("files:read,files:write"), _sp_body("resources/read", "{\"uri\":\"res://t/77\"}")), 200, "", "scope: a template's URI, held");
    _t(k, _raw("POST", _ah("nothing"), _sp_body("prompts/get", "{\"name\":\"p_one\"}")), 200, "", "scope: a prompt that asks for none");
    _t(k, _raw("POST", _ah("nothing"), _sp_body("resources/read", "{\"uri\":\"res://a\"}")), 200, "", "scope: a resource that asks for none");
    _t(k, _raw("POST", _ah("nothing"), _sp_body("completion/complete", "{\"ref\":{\"type\":\"ref/prompt\",\"name\":\"p_one\"},\"argument\":{\"name\":\"a\",\"value\":\"b\"}}")), 200, "", "scope: completing an open prompt");
    assert_eq(_st(k, _raw("POST", _ah("nothing"), _sp_body("prompts/get", "{\"name\":\"p_nope\"}"))) == 403, 0, _nm(k, "scope: an unknown prompt is the dispatcher's"));
    assert_eq(_st(k, _raw("POST", _ah("nothing"), _sp_body("resources/read", "{\"uri\":\"res://none\"}"))) == 403, 0, _nm(k, "scope: an unknown resource is the dispatcher's"));
    _seen_claims = 0;
    var pbatch = _cat3("[", _sp_body("prompts/get", "{\"name\":\"p_scoped\"}"), _cat3(",", _sp_body("resources/read", "{\"uri\":\"res://t/1\"}"), "]"));
    _run(k, _raw("POST", _ah("nothing"), pbatch));
    assert(_status == 200 && _has(_body, "insufficient scope for prompt: p_scoped") && _has(_body, "insufficient scope for resource: res://t/1"), _nm(k, "scope: a batch refuses each element"));
    assert_eq(_seen_claims, 0, _nm(k, "scope: ...and runs neither"));
    assert_eq(_st(k, _raw("POST", _ah("nothing"), _sp_body("prompts/get", "{\"title\":\"p_scoped\"}"))) == 403, 0, _nm(k, "scope: a prompts/get with no name is the dispatcher's"));
    assert_eq(_st(k, _raw("POST", _ah("nothing"), _sp_body("resources/read", "{\"url\":\"res://scoped\"}"))) == 403, 0, _nm(k, "scope: a resources/read with no uri is the dispatcher's"));
    dispatcher_set_completion(d, 0);
    assert_eq(_st(k, _raw("POST", _ah("nothing"), _sp_body("completion/complete", "{\"ref\":{\"type\":\"ref/prompt\",\"name\":\"p_scoped\"},\"argument\":{\"name\":\"a\",\"value\":\"b\"}}"))) == 403, 0, _nm(k, "scope: with no completion handler, a completion is the dispatcher's"));
    dispatcher_set_completion(d, &h_cclaims);
    assert_eq(_heap_per(k, _raw("POST", _ah(_cat3("nothing", _rep("x", 60000), "")), _sp_body("prompts/get", "{\"name\":\"p_scoped\"}"))), 0, _nm(k, "scope heap: a prompt's 403 with a 60 KB token"));
    assert_eq(_heap_per(k, _raw("POST", _ah("nothing"), _sp_body("resources/read", _cat3("{\"uri\":\"res://t/", _rep("x", 60000), "\"}")))), 0, _nm(k, "scope heap: a template's 403 with a 60 KB URI"));

    # A refused call is a call: the trail sees it, on the gate's path too.
    dispatcher_set_audit(d, audit_sink_new(&_aud, 0));
    _audited = 0;
    _run(k, _raw("POST", _ah("nothing"), _lc_body("t_scoped", ",\"caller_id\":\"c9\"")));
    assert_eq(_audited, 1, _nm(k, "scope: audited, once"));
    assert(streq(tool_call_event_tool_name(_aud_ev), "t_scoped") == 1, _nm(k, "scope: the tool"));
    assert_eq(tool_call_event_success(_aud_ev), 0, _nm(k, "scope: as a failure"));
    assert(streq(tool_call_event_caller_id(_aud_ev), "c9") == 1, _nm(k, "scope: the caller"));
    assert(streq(tool_call_event_error(_aud_ev), "insufficient scope for tool: t_scoped") == 1, _nm(k, "scope: why"));
    dispatcher_set_audit(d, 0);

    # Scopes required and nothing to read them: closed.
    dispatcher_set_scope_check(d, 0, 0);
    _t403(k, _mc("t_scoped", "files:read,files:write"), "scope: no checker is no scope");
    _t(k, _mc("t_echo", "nothing"), 200, "", "scope: no checker, a tool that asks for none");
    dispatcher_set_scope_check(d, &_holds, 0);

    # Nothing configured to point at.
    _prm_set(k, 0);
    _t403(k, _mc("t_scoped", "nothing"), "scope: no metadata");
    assert(_has(_head, "WWW-Authenticate: Bearer error=\"insufficient_scope\", scope=\"files:read files:write\"\r\n"), _nm(k, "scope: no resource_metadata to name"));
    _prm_set(k, prm);

    # No byte stays, whatever a client makes long, or however many scopes a tool asks for.
    var long = _rep("x", 60000);
    var arg = _cat3(",\"arguments\":{\"a\":\"", long, "\"}");
    assert_eq(_heap_per(k, _mc("t_scoped", long)), 0, _nm(k, "heap: a 403 for a 60 KB token"));
    assert_eq(_heap_per(k, _lc("t_scoped", long)), 0, _nm(k, "heap: ...on the legacy path"));
    assert_eq(_heap_per(k, _mc("t_many", "x")), 0, _nm(k, "heap: a 403 naming 64 long scopes"));
    assert_eq(_heap_per(k, _mc_x("t_scoped", "x", arg)), 0, _nm(k, "heap: a 403 with 60 KB of arguments"));
    assert_eq(_heap_per(k, _raw("POST", _ah("x"), _lc_body("t_scoped", _cat3(",\"caller_id\":\"", long, "\"")))), 0, _nm(k, "heap: a 403 with a 60 KB caller_id"));
    assert_eq(_heap_per(k, _raw("POST", _ah("x"), _cat3("[", _lc_body("t_scoped", arg), "]"))), 0, _nm(k, "heap: a batch element"));
    assert_eq(_heap_per(k, _raw("POST", _ah(long), _cat3("[", _lc_body("t_many", ""), "]"))), 0, _nm(k, "heap: a batch element, a 60 KB token"));
    # A token keeps a byte only when a handler is handed it.
    assert_eq(_heap_per(k, _raw("POST", _cat3(_mh("tools/list", 0), _ah(long), ""), _mb("tools/list", ""))), 0, _nm(k, "heap: a 60 KB token no handler sees"));
    assert_eq(_heap_per(k, _raw("POST", _ah(long), _lb("tools/list"))), 0, _nm(k, "heap: ...on the legacy path"));

    if (k == 0) { http_config_with_session_store(_http_cfg, st); }
    if (k == 1) { streamable_config_with_session_store(_strm_cfg, st); }
    dispatcher_set_scope_check(d, 0, 0);
    _prm_set(k, 0);
    _prm_bearer(k, 0, 0);
    return 0;
}

fn _pc_legacy() {
    return "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/call\",\"params\":{\"name\":\"t_param\",\"arguments\":{\"region\":\"us\"}}}";
}

# A tools/call of t_param with arguments `args`, sending the header lines `hdrs`.
fn _pc(hdrs, args) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, ",\"name\":\"t_param\",\"arguments\":");
    str_builder_add_cstr(sb, args);
    return _raw("POST", _cat3(_mh("tools/call", "t_param"), hdrs, ""), _mb("tools/call", str_data(str_builder_build(sb))));
}

# The same for t_jparam.
fn _pcj(hdrs, args) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, ",\"name\":\"t_jparam\",\"arguments\":");
    str_builder_add_cstr(sb, args);
    return _raw("POST", _cat3(_mh("tools/call", "t_jparam"), hdrs, ""), _mb("tools/call", str_data(str_builder_build(sb))));
}

fn _params(k) {
    # (3.8.3) A header named in an inputSchema given as JSON is judged as one in a ToolSchema.
    _t(k, _pcj("Mcp-Param-Zone: z1\r\n", "{\"zone\":\"z1\"}"), 200, "", "JSON schema: a value and its header");
    assert(_has(_body, "\"resultType\":\"complete\""), _nm(k, "JSON schema: ...reaches the tool"));
    _t(k, _pcj("", "{\"zone\":\"z1\"}"), 400, "-32020", "JSON schema: a value and no header");
    _t(k, _pcj("Mcp-Param-Zone: z2\r\n", "{\"zone\":\"z1\"}"), 400, "-32020", "JSON schema: a header holding another value");
    _t(k, _raw("POST", _mh("tools/list", 0), _mb("tools/list", "")), 200, "", "tools/list");
    assert(_has(_body, "\"x-mcp-header\":\"Region\""), _nm(k, "...carries the annotation as written"));

    # The spec's table of who sends what.
    _t(k, _pc("Mcp-Param-Region: us-west1\r\n", "{\"region\":\"us-west1\"}"), 200, "", "a value and its header");
    assert(_has(_body, "\"resultType\":\"complete\""), _nm(k, "...reaches the tool"));
    _t(k, _pc("", "{}"), 200, "", "no value, no header");
    _t(k, _pc("", "{\"region\":null}"), 200, "", "a null, no header");
    _t(k, _raw("POST", _mh("tools/call", "t_param"), _mb("tools/call", ",\"name\":\"t_param\"")), 200, "", "no arguments at all");
    _t(k, _pc("", "{\"region\":\"us\"}"), 400, "-32020", "a value and no header");
    assert(_has(_body, "\"id\":7") && _has(_body, "Mcp-Param-Region"), _nm(k, "...names the header, with the id"));
    _t(k, _pc("", "{\"n\":1}"), 400, "-32020", "an integer and no header");
    _t(k, _pc("", "{\"flag\":false}"), 400, "-32020", "a boolean and no header");
    _t(k, _pc("", "{\"region\":\"\"}"), 400, "-32020", "an empty string is a value");
    _t(k, _pc("Mcp-Param-Region: x\r\n", "{}"), 400, "-32020", "a header with no value");
    _t(k, _pc("Mcp-Param-Region: x\r\n", "{\"region\":null}"), 400, "-32020", "a header over a null");
    _t(k, _pc("Mcp-Param-Region: eu\r\n", "{\"region\":\"us\"}"), 400, "-32020", "a header holding another value");
    assert(_has(_body, "\"us\"") == 0 && _has(_body, "'eu'") == 0, _nm(k, "...and neither value in the reply"));

    # Header names ignore case; values do not.
    _t(k, _pc("mcp-param-REGION: us\r\n", "{\"region\":\"us\"}"), 200, "", "the header name in any case");
    _t(k, _pc("Mcp-Param-Region: US\r\n", "{\"region\":\"us\"}"), 400, "-32020", "the value in another case");
    _t(k, _pc("Mcp-Param-Region:   us \t\r\n", "{\"region\":\"us\"}"), 200, "", "whitespace around a value");

    # The Value Encoding examples, and what the sentinel leaves literal.
    _t(k, _pc("Mcp-Param-Region: =?base64?SGVsbG8sIOS4lueVjA==?=\r\n", "{\"region\":\"Hello, \\u4e16\\u754c\"}"), 200, "", "non-ASCII in Base64");
    _t(k, _pc("Mcp-Param-Region: =?base64?IHBhZGRlZCA=?=\r\n", "{\"region\":\" padded \"}"), 200, "", "spaces at the ends in Base64");
    _t(k, _pc("Mcp-Param-Region: =?base64?bGluZTEKbGluZTI=?=\r\n", "{\"region\":\"line1\\nline2\"}"), 200, "", "a newline in Base64");
    _t(k, _pc("Mcp-Param-Region: =?base64?PT9iYXNlNjQ/bGl0ZXJhbD89?=\r\n", "{\"region\":\"=?base64?literal?=\"}"), 200, "", "a value that looks like the sentinel");
    _t(k, _pc("Mcp-Param-Region: =?base64??=\r\n", "{\"region\":\"\"}"), 200, "", "an empty string in Base64");
    _t(k, _pc("Mcp-Param-Region:\r\n", "{\"region\":\"\"}"), 200, "", "an empty string as an empty header");
    _t(k, _pc("Mcp-Param-Region: =?base64?SGVsbG8?=\r\n", "{\"region\":\"Hello\"}"), 400, "-32020", "Base64 with its padding missing");
    _t(k, _pc("Mcp-Param-Region: =?base64?SGVs!!!bG8=?=\r\n", "{\"region\":\"Hello\"}"), 400, "-32020", "Base64 with characters outside the alphabet");
    _t(k, _pc("Mcp-Param-Region: SGVsbG8=\r\n", "{\"region\":\"SGVsbG8=\"}"), 200, "", "no markers, a literal");
    _t(k, _pc("Mcp-Param-Region: =?base64?SGVsbG8=\r\n", "{\"region\":\"=?base64?SGVsbG8=\"}"), 200, "", "no closing marker, a literal");
    _t(k, _pc("Mcp-Param-Region: =?base64?SGVsbG8=?=\r\n", "{\"region\":\"Bye\"}"), 400, "-32020", "Base64 holding another value");
    _t(k, _pc("Mcp-Param-Region: a\x01b\r\n", "{\"region\":\"a\\u0001b\"}"), 400, "-32020", "a control byte in the header");
    _t(k, _pc("Mcp-Param-Region: \xC3\xA9\r\n", "{\"region\":\"\xC3\xA9\"}"), 400, "-32020", "raw UTF-8 in the header");
    _t(k, _pc("Mcp-Param-Region: a\\u0000b\r\n", "{\"region\":\"a\\u0000b\"}"), 400, "-32020", "a NUL the header spells as its escape");
    _t(k, _pc("Mcp-Param-Region: a\r\n", "{\"region\":\"a\\u0000b\"}"), 400, "-32020", "a NUL, with the text before it in the header");
    _t(k, _pc("Mcp-Param-Region: =?base64?!!!!?=\r\n", "{\"region\":\"=?base64?!!!!?=\"}"), 400, "-32020", "a sentinel that does not decode, even when the body spells it the same");

    # Integers and booleans.
    _t(k, _pc("Mcp-Param-Count: 42\r\n", "{\"n\":42}"), 200, "", "an integer");
    _t(k, _pc("Mcp-Param-Count: -7\r\n", "{\"n\":-7}"), 200, "", "a negative integer");
    _t(k, _pc("Mcp-Param-Count: 42.0\r\n", "{\"n\":42}"), 200, "", "42.0 and 42 are equal");
    _t(k, _pc("Mcp-Param-Count: 42\r\n", "{\"n\":42.0}"), 200, "", "42 and 42.0 are equal");
    _t(k, _pc("Mcp-Param-Count: 43\r\n", "{\"n\":42}"), 400, "-32020", "another integer");
    _t(k, _pc("Mcp-Param-Count: 9007199254740992\r\n", "{\"n\":9007199254740992}"), 400, "-32020", "past the safe range");
    _t(k, _pc("Mcp-Param-Flag: true\r\n", "{\"flag\":true}"), 200, "", "a boolean");
    _t(k, _pc("Mcp-Param-Flag: false\r\n", "{\"flag\":false}"), 200, "", "the other boolean");
    _t(k, _pc("Mcp-Param-Flag: True\r\n", "{\"flag\":true}"), 400, "-32020", "a boolean spelled otherwise");

    # A value of the wrong type that the header still mirrors is the tool's input
    # error, which the model can correct. One with no text to mirror cannot pass.
    _t(k, _pc("Mcp-Param-Count: 42\r\n", "{\"n\":\"42\"}"), 200, "", "a string where an integer belongs");
    assert(_has(_body, "\"isError\":true"), _nm(k, "...is an input error"));
    _t(k, _pc("Mcp-Param-Count: 1.5\r\n", "{\"n\":1.5}"), 200, "", "a fraction where an integer belongs");
    assert(_has(_body, "\"isError\":true"), _nm(k, "...is an input error"));
    _t(k, _pc("", "{\"region\":{\"x\":1}}"), 400, "-32020", "an object where a string belongs");
    _t(k, _pc("Mcp-Param-Region: x\r\n", "{\"region\":[1]}"), 400, "-32020", "an array where a string belongs");

    # A nested property, and each way of it not being there.
    _t(k, _pc("Mcp-Param-Deep: x\r\n", "{\"a\":{\"b\":\"x\"}}"), 200, "", "a nested value");
    _t(k, _pc("", "{\"a\":{\"b\":\"x\"}}"), 400, "-32020", "a nested value and no header");
    _t(k, _pc("", "{\"a\":{}}"), 200, "", "the leaf absent");
    _t(k, _pc("", "{\"a\":{\"b\":null}}"), 200, "", "the leaf null");
    _t(k, _pc("", "{\"a\":null}"), 200, "", "the parent null");
    _t(k, _pc("", "{\"a\":5}"), 200, "", "the parent no object");
    assert(_has(_body, "\"isError\":true"), _nm(k, "...is an input error"));

    # All of them at once, and the body read as the validator and a handler read it.
    _t(k, _pc("Mcp-Param-Region: us\r\nMcp-Param-Count: 1\r\nMcp-Param-Flag: true\r\nMcp-Param-Deep: x\r\n", "{\"region\":\"us\",\"n\":1,\"flag\":true,\"a\":{\"b\":\"x\"}}"), 200, "", "every header");
    _t(k, _pc("Mcp-Param-Region: us\r\nMcp-Param-Count: 1\r\nMcp-Param-Flag: false\r\nMcp-Param-Deep: x\r\n", "{\"region\":\"us\",\"n\":1,\"flag\":true,\"a\":{\"b\":\"x\"}}"), 400, "-32020", "one of them wrong");
    _t(k, _pc("Mcp-Param-Region: us\r\n", "{\"reg\\u0069on\":\"us\"}"), 200, "", "an escaped key is the same key");
    _t(k, _pc("", "{\"reg\\u0069on\":\"us\"}"), 400, "-32020", "...and needs its header");
    # (3.8.6) A handler's parser may read the last of a repeated key, so it is refused.
    _t(k, _pc("Mcp-Param-Region: us\r\n", "{\"region\":\"us\",\"region\":\"eu\"}"), 400, "-32600", "a repeated key refused");
    _t(k, _pc("Mcp-Param-Region: eu\r\n", "{\"region\":\"us\",\"reg\\u0069on\":\"eu\"}"), 400, "-32600", "...spelled two ways, whichever header");

    # A field on two lines combines into a value that matches nothing.
    _t(k, _pc("Mcp-Param-Region: us\r\nMcp-Param-Region: us\r\n", "{\"region\":\"us\"}"), 400, "-32020", "Mcp-Param on two lines");
    _t(k, _pc("Mcp-Param-Region: us\r\nmcp-param-region: eu\r\n", "{\"region\":\"us\"}"), 400, "-32020", "Mcp-Param on two lines that differ");
    _t(k, _raw("POST", _cat3(_mh("tools/list", 0), "mcp-method: tools/list\r\n", ""), _mb("tools/list", "")), 400, "-32020", "Mcp-Method on two lines");
    _t(k, _raw("POST", _cat3(_mh("tools/call", "t_echo"), "Mcp-Name: t_other\r\n", ""), _ok_tool()), 400, "-32020", "Mcp-Name on two lines");
    _t(k, _raw("POST", _cat3(_mh("tools/list", 0), _V, ""), _mb("tools/list", "")), 400, "-32020", "MCP-Protocol-Version on two lines");

    # A header nothing declares is not bote's to judge.
    _t(k, _pc("Mcp-Param-Other: x\r\n", "{}"), 200, "", "a header t_param does not declare");
    _t(k, _raw("POST", _cat3(_mh("tools/call", "t_echo"), "Mcp-Param-Region: x\r\n", ""), _ok_tool()), 200, "", "a header on a tool with none");
    _t(k, _raw("POST", _cat3(_mh("prompts/get", "p_one"), "Mcp-Param-Region: x\r\n", ""), _mb("prompts/get", ",\"name\":\"p_one\"")), 200, "", "a header on another method");
    _t(k, _raw("POST", _cat3(_mh("prompts/get", "t_param"), "Mcp-Param-Region: x\r\n", ""), _mb("prompts/get", ",\"name\":\"t_param\"")), 200, "", "a prompt named like a tool with headers");
    _t(k, _raw("POST", _mh("tools/call", "t_none"), _mb("tools/call", ",\"name\":\"t_none\",\"arguments\":{\"region\":\"x\"}")), 200, "-32602", "an unknown tool is the dispatcher's");

    # Refused, a request keeps nothing.
    var x = _rep("x", 60000);
    assert_eq(_heap_per(k, _pc(_cat3("Mcp-Param-Region: ", x, "\r\n"), "{\"region\":\"us\"}")), 0, _nm(k, "a 60 KB Mcp-Param leaves no heap"));
    assert_eq(_heap_per(k, _pc("", "{\"region\":\"us\"}")), 0, _nm(k, "a missing Mcp-Param leaves no heap"));
    assert_eq(_heap_per(k, _pc("Mcp-Param-Region: eu\r\n", "{\"region\":\"us\"}")), 0, _nm(k, "a mismatch leaves no heap"));
    assert_eq(_heap_per(k, _pc("Mcp-Param-Region: =?base64?!!!!?=\r\n", "{\"region\":\"us\"}")), 0, _nm(k, "bad Base64 leaves no heap"));
    return 0;
}

fn _clauses(k) {
    # ---- what a modern client sends ----
    _t(k, _raw("POST", _mh("server/discover", 0), _mb("server/discover", "")), 200, "", "server/discover");
    assert(_has(_body, "\"resultType\":\"complete\"") && _has(_body, "supportedVersions"), _nm(k, "...is a modern result"));
    assert(_has(_head, "Content-Type: application/json"), _nm(k, "...in application/json"));
    _t(k, _raw("POST", _mh("tools/list", 0), _mb("tools/list", "")), 200, "", "tools/list");
    assert(_has(_body, "\"ttlMs\":0"), _nm(k, "...with the cache hints"));
    _t(k, _raw("POST", _mh("tools/call", "t_echo"), _ok_tool()), 200, "", "tools/call");
    assert(_has(_body, "\"resultType\":\"complete\""), _nm(k, "...is a modern result"));
    _t(k, _raw("POST", _mh("prompts/get", "p_one"), _mb("prompts/get", ",\"name\":\"p_one\"")), 200, "", "prompts/get");
    _t(k, _raw("POST", _mh("resources/read", "res://a"), _mb("resources/read", ",\"uri\":\"res://a\"")), 200, "", "resources/read, Mcp-Name is the uri");

    # Header names are case-insensitive, and whitespace around a value is not part of it.
    _t(k, _raw("POST", "mcp-protocol-version: 2026-07-28\r\nmcp-METHOD: tools/list\r\n", _mb("tools/list", "")), 200, "", "header names in any case");
    _t(k, _raw("POST", "MCP-Protocol-Version: 2026-07-28 \r\nMcp-Method:\ttools/list\t \r\n", _mb("tools/list", "")), 200, "", "whitespace around a value");

    # The Base64 sentinel.
    _t(k, _raw("POST", _mh("tools/call", "=?base64?dF9lY2hv?="), _ok_tool()), 200, "", "Mcp-Name in the Base64 sentinel");
    _t(k, _raw("POST", _mh("resources/read", "=?base64?cmVzOi8vw6k=?="), _mb("resources/read", ",\"uri\":\"res://\\u00e9\"")), 200, "", "a padded sentinel holding UTF-8, against an escaped body");
    _t(k, _raw("POST", _mh("tools/call", "=?base64?dF9lY2hw?="), _ok_tool()), 400, "-32020", "a sentinel holding another name");
    _t(k, _raw("POST", _mh("tools/call", "=?BASE64?dF9lY2hv?="), _ok_tool()), 400, "-32020", "the markers are case-sensitive");
    _t(k, _raw("POST", _mh("tools/call", "=?base64?!!!!?="), _ok_tool()), 400, "-32020", "a sentinel that does not decode");
    _t(k, _raw("POST", _mh("tools/call", "=?base64?!!!!?="), _mb("tools/call", ",\"name\":\"=?base64?!!!!?=\"")), 400, "-32020", "...even when the body spells it the same");

    # ---- version ----
    # With a version bote does not speak, -32022 comes first: it says what bote does.
    _t(k, _raw("POST", "MCP-Protocol-Version: 1900-01-01\r\n", _mb("tools/list", "")), 400, "-32022", "an unsupported version over a modern _meta");
    _t(k, _raw("POST", "MCP-Protocol-Version: 1900-01-01\r\n", _lb("tools/list")), 400, "-32022", "an unsupported version");
    assert(_has(_body, "\"id\":7"), _nm(k, "...echoes the id"));
    assert(_has(_body, "\"requested\":\"1900-01-01\"") && _has(_body, "\"supported\":[\"2026-07-28\""), _nm(k, "...and says what is supported"));
    _t(k, _raw("POST", "MCP-Protocol-Version: 1900-01-01\r\n", "{\"id\":12x"), 400, "-32022", "an unsupported version over a body that is no JSON");
    assert(_has(_body, "\"id\":null"), _nm(k, "...takes no id from it"));
    _t(k, _raw("POST", "", _mb("tools/list", "")), 400, "-32020", "a modern body with no version header");
    _t(k, _raw("POST", _mh("tools/list", 0), _lb("tools/list")), 400, "-32602", "the modern header with no _meta");
    _t(k, _raw("POST", _mh("tools/list", 0), "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":1}}}"), 400, "-32602", "a version that is no string");
    _t(k, _raw("POST", _mh("tools/list", 0), "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2025-11-25\"}}}"), 400, "-32020", "the header and _meta disagree");
    _t(k, _raw("POST", "MCP-Protocol-Version: 2025-11-25\r\n", _mb("tools/list", "")), 400, "-32020", "an older header over a modern _meta");
    _t(k, _raw("POST", _mh("tools/list", 0), "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\"}}}"), 400, "-32602", "no clientCapabilities");

    # ---- Mcp-Method and Mcp-Name ----
    _t(k, _raw("POST", _V, _mb("tools/list", "")), 400, "-32020", "no Mcp-Method");
    assert(_has(_body, "\"id\":7"), _nm(k, "...echoes the id"));
    _t(k, _raw("POST", _mh("tools/call", "t_echo"), _mb("tools/list", "")), 400, "-32020", "Mcp-Method names another method");
    assert(_has(_body, "does not match body value"), _nm(k, "...and says so"));
    _t(k, _raw("POST", _mh("Tools/List", 0), _mb("tools/list", "")), 400, "-32020", "header values are case-sensitive");
    _t(k, _raw("POST", _mh("tools/li\x01st", 0), _mb("tools/list", "")), 400, "-32020", "a control byte in Mcp-Method");
    _t(k, _raw("POST", _mh("tools/li\x01st", 0), _mb("tools/li\\u0001st", "")), 400, "-32020", "...even when the body spells it the same");
    _t(k, _raw("POST", _mh("tools/call", 0), _ok_tool()), 400, "-32020", "tools/call with no Mcp-Name");
    _t(k, _raw("POST", _mh("prompts/get", 0), _mb("prompts/get", ",\"name\":\"p_one\"")), 400, "-32020", "prompts/get with no Mcp-Name");
    _t(k, _raw("POST", _mh("resources/read", 0), _mb("resources/read", ",\"uri\":\"res://a\"")), 400, "-32020", "resources/read with no Mcp-Name");
    _t(k, _raw("POST", _mh("tools/call", "t_other"), _ok_tool()), 400, "-32020", "Mcp-Name names another tool");
    _t(k, _raw("POST", _mh("prompts/get", "p_two"), _mb("prompts/get", ",\"name\":\"p_one\"")), 400, "-32020", "Mcp-Name names another prompt");
    _t(k, _raw("POST", _mh("resources/read", "res://b"), _mb("resources/read", ",\"uri\":\"res://a\"")), 400, "-32020", "Mcp-Name names another uri");
    _t(k, _raw("POST", _mh("tools/call", "t_\xC3\xA9"), _ok_tool()), 400, "-32020", "a raw non-ASCII Mcp-Name");
    _t(k, _raw("POST", _mh("tools/call", "t_\xC3\xA9"), _mb("tools/call", ",\"name\":\"t_\\u00e9\"")), 400, "-32020", "...even when the body spells it the same");
    _t(k, _raw("POST", _mh("tools/call", "t_echo"), _mb("tools/call", "")), 200, "-32602", "Mcp-Name with no name in the body");

    # ---- JSON-RPC errors and their status ----
    _t(k, _raw("POST", _mh("no/such", 0), _mb("no/such", "")), 404, "-32601", "an unknown method");
    _t(k, _raw("POST", _mh("ping", 0), _mb("ping", "")), 404, "-32601", "ping is gone");
    _t(k, _raw("POST", _mh("initialize", 0), _mb("initialize", "")), 404, "-32601", "initialize is gone");
    _t(k, _raw("POST", _mh("tools/call", "t_none"), _mb("tools/call", ",\"name\":\"t_none\"")), 200, "-32602", "an unknown tool");
    _t(k, _raw("POST", _mh("resources/read", "res://no"), _mb("resources/read", ",\"uri\":\"res://no\"")), 200, "-32602", "a missing resource");
    _t(k, _raw("POST", _mh("tools/list", 0), _mb("tools/list", ",\"cursor\":\"x\"")), 200, "-32602", "an invalid cursor");
    _t(k, _raw("POST", _mh("resources/read", "res://bad"), _mb("resources/read", ",\"uri\":\"res://bad\"")), 200, "-32603", "a result that is no object");
    _t(k, _raw("POST", _mh("tools/call", "t_int"), _mb("tools/call", ",\"name\":\"t_int\",\"arguments\":{\"n\":\"x\"}")), 200, "", "a schema violation is a result");
    assert(_has(_body, "\"isError\":true"), _nm(k, "...with isError"));

    # ---- one message ----
    _t(k, _raw("POST", _mh("tools/list", 0), "[{}]"), 400, "-32600", "a batch under the modern header");
    _t(k, _raw("POST", "", _cat3("[", _mb("tools/list", ""), "]")), 400, "-32600", "a batch naming the modern revision");
    _t(k, _raw("POST", _mh("tools/list", 0), "{nope"), 400, "-32700", "invalid JSON under the modern header");
    _t(k, _raw("POST", _mh("tools/list", 0), ""), 400, "-32700", "an empty body under the modern header");
    _t(k, _raw("POST", _mh("tools/list", 0), "5"), 400, "-32600", "a body that is no object");
    assert(_has(_body, "one message"), _nm(k, "...and says so"));
    _t(k, _raw("POST", _mh("tools/list", 0), "{\"jsonrpc\":\"2.0\",\"id\":7,\"result\":{}}"), 400, "-32600", "a JSON-RPC response");

    # ---- notifications ----
    _t(k, _raw("POST", _V, "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/x\"}"), 202, "", "a modern notification");
    assert_eq(strlen(_body), 0, _nm(k, "...has no body"));
    # (3.8.6) A message naming a key twice is the codec's -32600, with 400 on this path; a
    # notification's too, which the server does not accept (an HTTP error status, not 202).
    _t(k, _pc("", "{\"x\":1,\"x\":2}"), 400, "-32600", "arguments naming a key twice");
    assert(_has(_body, "\"id\":7"), _nm(k, "...with its id"));
    _t(k, _raw("POST", _V, "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/x\",\"params\":{\"a\":1,\"a\":1}}"), 400, "-32600", "a modern notification naming a key twice");
    _t(k, _raw("POST", _mh("tools/list", 0), "{\"jsonrpc\":\"2.0\",\"id\":7,\"id\":8,\"method\":\"tools/list\",\"params\":{}}"), 400, "-32600", "an id named twice");
    assert(_has(_body, "\"id\":null"), _nm(k, "...answered with null"));

    # ---- no sessions on this path ----
    _t(k, _raw("POST", _mh("tools/list", 0), _mb("tools/list", "")), 200, "", "no session needed");
    assert(_has(_head, "ession-Id") == 0, _nm(k, "...and none minted"));
    var stale = _cat3(_mh("tools/list", 0), "Mcp-Session-Id: nope\r\nLast-Event-ID: evt-9\r\n", "");
    _t(k, _raw("POST", stale, _mb("tools/list", "")), 200, "", "Mcp-Session-Id and Last-Event-ID are ignored");
    assert(_has(_head, "ession-Id") == 0, _nm(k, "...and not echoed"));

    # ---- the legacy path keeps what it had ----
    var init = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-11-25\",\"capabilities\":{},\"clientInfo\":{\"name\":\"c\",\"version\":\"1\"}}}";
    _t(k, _raw("POST", "", init), 200, "", "initialize with no version header");
    assert(_has(_head, "MCP-Session-Id: "), _nm(k, "...gets a session"));
    var sidp = strstr(_head, "MCP-Session-Id: ") + 16;
    var sidn = 0;
    while (load8(_head + sidp + sidn) != 13) { sidn = sidn + 1; }
    var sid = _slice_cstr(default_alloc(), _head, sidp, sidn);
    var withsid = _cat3("MCP-Session-Id: ", sid, "\r\n");
    _t(k, _raw("POST", withsid, _lb("tools/list")), 200, "", "a request of 2025-03-26, with a session and no version header");
    assert(_has(_body, "resultType") == 0, _nm(k, "...is legacy"));
    _t(k, _raw("POST", _cat3("MCP-Protocol-Version: 2025-11-25\r\n", withsid, ""), _lb("tools/list")), 200, "", "a legacy version header");
    assert(_has(_body, "resultType") == 0, _nm(k, "...is legacy"));
    _t(k, _raw("POST", "", _lb("tools/list")), 404, "", "the session gate still holds for legacy traffic");
    _t(k, _raw("POST", withsid, "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}"), 202, "", "a legacy notification is 202");
    # (3.8.8) A request the codec refuses at its admission was not taken: a 400, as on the
    # modern path, its id in the error.
    _t(k, _raw("POST", withsid, "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/list\",\"params\":{\"cursor\":\"a\",\"cursor\":\"b\"}}"), 400, "-32600", "a legacy request naming a key twice, refused before it was taken");
    assert(_has(_body, "\"id\":7"), _nm(k, "...its id in the error"));
    # (3.8.7, from the 3.8.6 review) Input bote cannot take as a request is an HTTP error on
    # the legacy path too, as Streamable HTTP has it (a 200 with the error through 3.8.6).
    _t(k, _raw("POST", withsid, "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\",\"params\":{\"a\":1,\"a\":2}}"), 400, "-32600", "a legacy notification naming a key twice is a 400");
    assert(_has(_body, "\"id\":null"), _nm(k, "...its error with no id"));
    _t(k, _raw("POST", withsid, "{\"jsonrpc\":\"1.0\",\"method\":\"notifications/x\"}"), 400, "-32600", "a legacy notification the codec refuses otherwise is a 400");
    _t(k, _raw("POST", withsid, "{\"jsonrpc\":\"2.0\",\"id\":7,\"id\":8,\"method\":\"tools/list\"}"), 400, "-32600", "an id named twice, answered with no id, is a 400");
    _t(k, _raw("POST", withsid, "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"no/such\"}"), 200, "-32601", "control: an error for a request with an id stays a 200");
    # (3.8.8, from the 3.8.7 review) What the codec took, not the shape of its answer: a request
    # whose id is null is taken and its errors are 200s; a batch of nothing taken, and a
    # JSON-RPC response a client sends, are 400s.
    _t(k, _raw("POST", withsid, "{\"jsonrpc\":\"2.0\",\"id\":null,\"method\":\"no/such\"}"), 200, "-32601", "an id of null, taken: its error a 200 (a 400 at 3.8.7)");
    _t(k, _raw("POST", withsid, "{\"jsonrpc\":\"2.0\",\"id\":null,\"method\":\"tools/list\"}"), 200, "", "...and its result a 200");
    _t(k, _raw("POST", withsid, "[{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\",\"params\":5}]"), 400, "", "a batch of one refused notification is a 400 (a 200 at 3.8.7)");
    assert(_has(_body, "\"code\":-32600"), _nm(k, "...its error in the batch's answer"));
    _t(k, _raw("POST", withsid, "[{\"jsonrpc\":\"2.0\",\"method\":\"notifications/x\",\"params\":{\"a\":1,\"a\":2}}]"), 400, "", "...naming a key twice");
    assert(_has(_body, "a key named twice"), _nm(k, "...saying so"));
    _t(k, _raw("POST", withsid, "[1]"), 400, "", "...or holding no object");
    _t(k, _raw("POST", withsid, "[{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"},{\"jsonrpc\":\"2.0\",\"id\":5,\"result\":{}}]"), 400, "", "a batch of a notification and a response is a 400 (a 200 at 3.8.8)");
    _t(k, _raw("POST", withsid, "[{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"},1]"), 400, "", "...and of a notification and no object");
    _t(k, _raw("POST", withsid, "{\"jsonrpc\":\"2.0\",\"id\":5,\"result\":{}}"), 400, "-32600", "a JSON-RPC response a client sends is a 400 (a 200 at 3.8.7)");
    _t(k, _raw("POST", withsid, "[{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"no/such\"},{\"jsonrpc\":\"2.0\",\"method\":\"notifications/x\",\"params\":5}]"), 200, "", "a batch with a request taken is a 200");
    assert(_has(_body, "\"code\":-32601"), _nm(k, "...its error in the answer"));
    _t(k, _raw("POST", withsid, "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"progressToken\":1}}}"), 200, "", "legacy _meta with no version");
    assert(_has(_body, "resultType") == 0, _nm(k, "...is legacy"));
    _t(k, _raw("POST", _cat3("MCP-Protocol-Version: 2025-11-25\r\n", withsid, ""), "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2025-11-25\"}}}"), 200, "", "an older revision in both the header and _meta");
    _t(k, _raw("POST", _cat3("MCP-Protocol-Version: 2025-11-25\r\n", withsid, ""), _cat3("[", _lb("ping"), "]")), 200, "", "a legacy batch");

    # ---- what comes first ----
    _t(k, _raw("POST", _cat3("Origin: https://evil.example\r\n", _mh("tools/list", 0), ""), _mb("tools/list", "")), 403, "", "a hostile Origin, ahead of everything");

    # ---- bytes ----
    var x = _rep("x", 60000);
    var b64 = _rep("eHh4", 15000);
    assert_eq(_heap_per(k, _raw("POST", _mh(x, 0), _mb("tools/list", ""))), 0, _nm(k, "a 60 KB Mcp-Method leaves no heap"));
    assert_eq(_heap_per(k, _raw("POST", _mh("tools/call", x), _ok_tool())), 0, _nm(k, "a 60 KB Mcp-Name leaves no heap"));
    assert_eq(_heap_per(k, _raw("POST", _mh("tools/call", _cat3("=?base64?", b64, "?=")), _ok_tool())), 0, _nm(k, "a 60 KB sentinel leaves no heap"));
    assert_eq(_heap_per(k, _raw("POST", _cat3("MCP-Protocol-Version: ", x, "\r\n"), _lb("tools/list"))), 0, _nm(k, "a 60 KB version leaves no heap"));
    assert_eq(_heap_per(k, _raw("POST", _mh("no/such", 0), _mb("no/such", ""))), 0, _nm(k, "a refused method leaves no heap"));
    assert_eq(_heap_per(k, _raw("POST", _mh("tools/list", 0), _mb("tools/list", ""))), 0, _nm(k, "a modern tools/list leaves no heap"));
    assert_eq(_heap_per(k, _raw("POST", _mh("tools/list", 0), "[{}]")), 0, _nm(k, "a refused batch leaves no heap"));
    return 0;
}
#endif

fn main() {
    alloc_init();

    # ---- pure pieces ----
    var a = default_alloc();
    assert(streq(_he_b64_decode_a(a, "QUJD", 4), "ABC") == 1, "b64: a whole group");
    assert(streq(_he_b64_decode_a(a, "QUI=", 4), "AB") == 1, "b64: one pad");
    assert(streq(_he_b64_decode_a(a, "QQ==", 4), "A") == 1, "b64: two pads");
    assert(streq(_he_b64_decode_a(a, "", 0), "") == 1, "b64: empty");
    assert(streq(_he_b64_decode_a(a, "+/+/", 4), "\xFB\xFF\xBF") == 1, "b64: the standard alphabet");
    assert_eq(_he_b64_decode_a(a, "QQ=", 3), 0, "b64: a length that is no multiple of 4");
    assert_eq(_he_b64_decode_a(a, "QR==", 4), 0, "b64: spare bits set");
    assert_eq(_he_b64_decode_a(a, "QUJ=", 4), 0, "b64: spare bits set, one pad");
    assert_eq(_he_b64_decode_a(a, "Q===", 4), 0, "b64: three pads");
    assert_eq(_he_b64_decode_a(a, "Q=Q=", 4), 0, "b64: padding in the middle");
    assert_eq(_he_b64_decode_a(a, "AA==", 4), 0, "b64: a NUL");
    assert_eq(_he_b64_decode_a(a, "_-_-", 4), 0, "b64: the URL alphabet");
    assert(streq(_he_field_value_a(a, "plain"), "plain") == 1, "name: plain");
    assert(streq(_he_field_value_a(a, "=?base64?QUJD?="), "ABC") == 1, "name: sentinel");
    assert(streq(_he_field_value_a(a, "=?base64??="), "") == 1, "name: an empty sentinel");
    assert(streq(_he_field_value_a(a, "=?base64?="), "=?base64?=") == 1, "name: markers that overlap are no sentinel");
    assert(streq(_he_field_value_a(a, "=?BASE64?QUJD?="), "=?BASE64?QUJD?=") == 1, "name: upper case is no sentinel");
    assert(streq(_he_field_value_a(a, "=?base64?QUJD"), "=?base64?QUJD") == 1, "name: no closing marker");
    assert_eq(_he_field_value_a(a, "=?base64?!?="), 0, "name: a sentinel that does not decode");
    var hc[40];
    bote_http_ctx(&hc, 0, "t", "", 0, 0);
    assert_eq(_he_field_ok(&hc, "X", "a b\tc~"), 1, "header: visible ASCII, space and tab");
    assert_eq(_he_field_ok(&hc, "X", "a\x01b"), 0, "header: a control byte");
    assert_eq(_he_field_ok(&hc, "X", "a\x7Fb"), 0, "header: DEL");
    assert_eq(_he_field_ok(&hc, "X", "\xC3\xA9"), 0, "header: non-ASCII");
    var twice = "POST / HTTP/1.1\r\nMcp-Name: a\r\nHost: x\r\nMCP-NAME: a\r\nMcp-Named: b\r\n\r\nMcp-Name: c\r\nMcp-Method: d\r\nMcp-Method: e\r\n";
    bote_http_ctx(&hc, 0, "t", twice, strlen(twice), 0);
    assert_eq(_he_repeated(&hc, "Mcp-Name"), 1, "repeated: two lines, in any case");
    assert_eq(_he_repeated(&hc, "Host"), 0, "repeated: one line");
    assert_eq(_he_repeated(&hc, "Mcp-Named"), 0, "repeated: a longer name is another field");
    assert_eq(_he_repeated(&hc, "Mcp-Method"), 0, "repeated: past the headers is the body");
    var longer = "POST / HTTP/1.1\r\nMcp-Name: a\r\nMcp-Name-Extra: b\r\n\r\n";
    bote_http_ctx(&hc, 0, "t", longer, strlen(longer), 0);
    assert_eq(_he_repeated(&hc, "Mcp-Name"), 0, "repeated: a name that starts the same is another field");
    var line1 = "Mcp-Name x\r\nMcp-Name: a\r\n\r\n";
    bote_http_ctx(&hc, 0, "t", line1, strlen(line1), 0);
    assert_eq(_he_repeated(&hc, "Mcp-Name"), 0, "repeated: the request line is no header");
    assert_eq(_he_param_matches(bote_req_begin(), "us", "\"us\""), 1, "param: a string");
    assert_eq(_he_param_matches(bote_req_alloc(), "us", "\"eu\""), 0, "param: another string");
    assert_eq(_he_param_matches(bote_req_alloc(), "42", "42"), 1, "param: an integer");
    assert_eq(_he_param_matches(bote_req_alloc(), "42.0", "42"), 1, "param: an integer, compared by value");
    assert_eq(_he_param_matches(bote_req_alloc(), "42", "4.2e1"), 1, "param: ...on either side");
    assert_eq(_he_param_matches(bote_req_alloc(), "-0", "0"), 1, "param: -0 is 0");
    assert_eq(_he_param_matches(bote_req_alloc(), "43", "42"), 0, "param: another integer");
    assert_eq(_he_param_matches(bote_req_alloc(), "42x", "42"), 0, "param: not all of the header is a number");
    assert_eq(_he_param_matches(bote_req_alloc(), "042", "42"), 0, "param: not a JSON number");
    assert_eq(_he_param_matches(bote_req_alloc(), "+42", "42"), 0, "param: a plus sign");
    assert_eq(_he_param_matches(bote_req_alloc(), "", "42"), 0, "param: an empty header for a number");
    assert_eq(_he_param_matches(bote_req_alloc(), "42.5", "42"), 0, "param: a header with a fraction");
    assert_eq(_he_param_matches(bote_req_alloc(), "9007199254740991", "9007199254740991"), 1, "param: the largest safe integer");
    assert_eq(_he_param_matches(bote_req_alloc(), "-9007199254740991", "-9007199254740991"), 1, "param: the smallest");
    assert_eq(_he_param_matches(bote_req_alloc(), "9007199254740992", "9007199254740992"), 0, "param: one past the largest");
    assert_eq(_he_param_matches(bote_req_alloc(), "-9007199254740992", "-9007199254740992"), 0, "param: one past the smallest");
    assert_eq(_he_param_matches(bote_req_alloc(), "1.5", "1.5"), 1, "param: a fraction is compared as text");
    assert_eq(_he_param_matches(bote_req_alloc(), "1.7", "1.5"), 0, "param: not by what it truncates to");
    assert_eq(_he_param_matches(bote_req_alloc(), "true", "true"), 1, "param: true");
    assert_eq(_he_param_matches(bote_req_alloc(), "false", "false"), 1, "param: false");
    assert_eq(_he_param_matches(bote_req_alloc(), "TRUE", "true"), 0, "param: values are case-sensitive");
    assert_eq(_he_param_matches(bote_req_alloc(), "false", "true"), 0, "param: the other boolean");
    assert_eq(_he_param_matches(bote_req_alloc(), "{}", "{}"), 0, "param: an object has no header form");
    assert_eq(_he_param_matches(bote_req_alloc(), "[]", "[]"), 0, "param: nor does an array");
    assert_eq(_he_param_matches(bote_req_alloc(), "a\\u0000b", "\"a\\u0000b\""), 0, "param: a NUL no header can say");
    assert_eq(_he_param_matches(bote_req_alloc(), "a", "\"a\\u0000b\""), 0, "param: nor is it the text before the NUL");
    assert_eq(_he_param_matches(bote_req_alloc(), "", "\"\""), 1, "param: the empty string");
    assert_eq(_he_param_matches(bote_req_alloc(), "a\nb", "\"a\\nb\""), 1, "param: a string compared decoded");
    assert_eq(_he_status_for(0 - 32601), 404, "status: -32601");
    assert_eq(_he_status_for(0 - 32602), 200, "status: a -32602 past the _meta check");
    assert_eq(_he_status_for(0 - 32600), 400, "status: -32600");
    assert_eq(_he_status_for(0 - 32700), 400, "status: -32700");
    assert_eq(_he_status_for(0 - 32020), 400, "status: -32020");
    assert_eq(_he_status_for(0 - 32021), 400, "status: -32021");
    assert_eq(_he_status_for(0 - 32022), 400, "status: -32022");
    assert_eq(_he_status_for(0 - 32603), 200, "status: -32603");
    assert_eq(_he_status_for(0 - 32000), 200, "status: what the spec leaves open");
    # ---- Protected Resource Metadata ----
    var one = vec_new();
    vec_push(one, "https://as.example.com");
    assert_eq(bote_prm_check("https://mcp.example.com/mcp", one, 0), 0, "prm: the spec's example");
    assert_eq(bote_prm_check("https://mcp.example.com", one, 0), 0, "prm: no path");
    assert_eq(bote_prm_check("https://mcp.example.com:8443", one, 0), 0, "prm: a port");
    assert_eq(bote_prm_check("https://mcp.example.com/server/mcp", one, 0), 0, "prm: a longer path");
    assert_eq(bote_prm_check("https://mcp.example.com/", one, 0), 0, "prm: a trailing slash");
    assert_eq(bote_prm_check("http://localhost:8390/mcp", one, 0), 0, "prm: http on localhost");
    assert_eq(bote_prm_check("http://127.0.0.1/mcp", one, 0), 0, "prm: http on 127.0.0.1");
    assert_eq(bote_prm_check("http://[::1]:8390/mcp", one, 0), 0, "prm: http on [::1]");
    assert_eq(bote_prm_check("http://localhost", one, 0), 0, "prm: http on loopback, no path");
    assert(bote_prm_check(0, one, 0) != 0, "prm refused: no resource");
    assert(bote_prm_check("mcp.example.com", one, 0) != 0, "prm refused: no scheme, the spec's example");
    assert(bote_prm_check("https://mcp.example.com#fragment", one, 0) != 0, "prm refused: a fragment, the spec's example");
    assert(bote_prm_check("https://mcp.example.com?x=1", one, 0) != 0, "prm refused: a query");
    assert(bote_prm_check("http://mcp.example.com/mcp", one, 0) != 0, "prm refused: http off loopback");
    assert(bote_prm_check("http://localhost.evil.example/mcp", one, 0) != 0, "prm refused: a name that starts like localhost");
    assert(bote_prm_check("http://127.0.0.10/mcp", one, 0) != 0, "prm refused: an address that starts like loopback");
    assert(bote_prm_check("ftp://mcp.example.com", one, 0) != 0, "prm refused: another scheme");
    assert(bote_prm_check("https://", one, 0) != 0, "prm refused: no host");
    assert(bote_prm_check("https:///mcp", one, 0) != 0, "prm refused: an empty host");
    assert(bote_prm_check("https://:8443", one, 0) != 0, "prm refused: a port alone");
    assert(bote_prm_check("https://user@mcp.example.com", one, 0) != 0, "prm refused: userinfo");
    assert(bote_prm_check("https://x/a b", one, 0) != 0, "prm refused: a space");
    assert(bote_prm_check("https://x/a\"b", one, 0) != 0, "prm refused: a quote, which would end the parameter");
    assert(bote_prm_check("https://x/a\\b", one, 0) != 0, "prm refused: a backslash");
    assert(bote_prm_check("https://x/a\r\nSet-Cookie: 1", one, 0) != 0, "prm refused: a header injected");
    assert(bote_prm_check("https://x/a\r\nSet-Cookie:1", one, 0) != 0, "prm refused: a header injected with no space to catch");
    assert(bote_prm_check("https://x/a\x01b", one, 0) != 0, "prm refused: a control byte");
    assert(bote_prm_check("https://x/a\x7Fb", one, 0) != 0, "prm refused: DEL");
    assert(bote_prm_check("https://x/\xC3\xA9", one, 0) != 0, "prm refused: non-ASCII");
    assert(bote_prm_check("https://mcp.example.com", 0, 0) != 0, "prm refused: no authorization servers");
    assert(bote_prm_check("https://mcp.example.com", vec_new(), 0) != 0, "prm refused: an empty list of them");
    var bad_as = vec_new();
    vec_push(bad_as, "https://as.example.com");
    vec_push(bad_as, "http://as.example.com");
    assert(bote_prm_check("https://mcp.example.com", bad_as, 0) != 0, "prm refused: any bad authorization server");
    var sc = vec_new();
    assert_eq(bote_prm_check("https://x", one, sc), 0, "prm: no scopes");
    vec_push(sc, "files:read");
    assert_eq(bote_prm_check("https://x", one, sc), 0, "prm: a scope");
    assert(bote_prm_check("https://x", one, _one_vec("a b")) != 0, "prm refused: a scope with a space");
    assert(bote_prm_check("https://x", one, _one_vec("a\"b")) != 0, "prm refused: a scope with a quote");
    assert(bote_prm_check("https://x", one, _one_vec("a\\b")) != 0, "prm refused: a scope with a backslash");
    assert(bote_prm_check("https://x", one, _one_vec("a\r\nb")) != 0, "prm refused: a scope with CRLF");
    assert(bote_prm_check("https://x", one, _one_vec("")) != 0, "prm refused: an empty scope");
    assert(bote_prm_check("https://x", one, _one_vec("offline_access")) != 0, "prm refused: offline_access");
    assert_eq(bote_prm_new("nope", one, 0, 0), 0, "prm: new refuses what the check refuses");

    assert(streq(bote_prm_path(bote_prm_new("https://x", one, 0, 0)), "/.well-known/oauth-protected-resource") == 1, "prm path: no path");
    assert(streq(bote_prm_path(bote_prm_new("https://x/", one, 0, 0)), "/.well-known/oauth-protected-resource") == 1, "prm path: a lone slash goes");
    assert(streq(bote_prm_path(bote_prm_new("https://x:8443", one, 0, 0)), "/.well-known/oauth-protected-resource") == 1, "prm path: a port is not a path");
    assert(streq(bote_prm_path(bote_prm_new("https://x:8443/a/b", one, 0, 0)), "/.well-known/oauth-protected-resource/a/b") == 1, "prm path: inserted ahead of the path");
    assert(streq(bote_prm_path(bote_prm_new("https://x/a/", one, 0, 0)), "/.well-known/oauth-protected-resource/a/") == 1, "prm path: only a lone slash goes");
    assert_eq(bote_prm_challenge(0), 0, "prm: no challenge with none configured");
    assert(streq(bote_prm_challenge(bote_prm_new("https://x:8443/mcp", one, 0, 0)), "resource_metadata=\"https://x:8443/.well-known/oauth-protected-resource/mcp\"") == 1, "prm: a challenge with no scope");
    assert(streq(bote_prm_challenge(bote_prm_new("https://x", one, vec_new(), 0)), "resource_metadata=\"https://x/.well-known/oauth-protected-resource\"") == 1, "prm: an empty list of scopes is none");
    var noname = bote_prm_json(bote_prm_new("https://x", one, 0, 0));
    assert(streq(noname, "{\"resource\":\"https://x\",\"authorization_servers\":[\"https://as.example.com\"],\"bearer_methods_supported\":[\"header\"]}") == 1, "prm: what has no value is left out");
    assert(streq(bote_prm_json(bote_prm_new("https://x", one, vec_new(), 0)), noname) == 1, "prm: an empty list of scopes is left out too, RFC 9728 3.2");
    var quoted = bote_prm_json(bote_prm_new("https://x", one, 0, "a\"b\n"));
    assert(jsonx_valid(quoted, strlen(quoted)) == 1 && _has(quoted, "\"resource_name\":\"a\\\"b\\n\""), "prm: a name is escaped");

    assert_eq(bote_protocol_known("2026-07-28"), 1, "known: the modern revision");
    assert_eq(bote_protocol_known("2025-11-25"), 1, "known: a legacy revision");
    assert_eq(bote_protocol_known("1900-01-01"), 0, "known: not a revision");
    assert_eq(bote_protocol_known(0), 0, "known: none");
    assert_eq(validate_protocol_version("2026-07-28"), 0, "validate takes the modern revision");
    assert_eq(_mcp_is_supported("2026-07-28"), 0, "...which initialize never negotiates");

    #ifndef CYRIUS_TARGET_AGNOS
    _rbuf = alloc(262144);
    _rcv = alloc(262146);
    var d = _mk_d();
    _http_cfg = http_config_new("/mcp", 0, 0);
    http_config_with_session_store(_http_cfg, session_store_default());
    store64(_http_cfg + 48, d);
    _strm_cfg = streamable_config_new("/mcp", 0, 0);
    streamable_config_with_session_store(_strm_cfg, session_store_default());
    store64(_strm_cfg + 56, d);
    _strm_init();
    var brg_origins = vec_new();
    vec_push(brg_origins, "http://localhost");
    _brg_cfg = bridge_config_new("127.0.0.1", 0);
    bridge_config_with_dispatcher(_brg_cfg, d);
    bridge_config_with_origins(_brg_cfg, brg_origins);
    _clauses(0);
    _clauses(1);
    _params(0);
    _params(1);
    _params(2);

    # The modern path holds the bridge to the same rules, CORS headers on every reply.
    var cors = "Origin: http://localhost\r\n";
    _t(2, _raw("POST", _cat3(_mh("tools/list", 0), cors, ""), _mb("tools/list", "")), 200, "", "tools/list");
    assert(_has(_head, "Access-Control-Allow-Origin"), "bridge: ...with CORS");
    _t(2, _raw("POST", _cat3(_V, cors, ""), _mb("tools/list", "")), 400, "-32020", "no Mcp-Method");
    assert(_has(_head, "Access-Control-Allow-Origin"), "bridge: a refusal with CORS");
    _t(2, _raw("POST", _cat3(_mh("no/such", 0), cors, ""), _mb("no/such", "")), 404, "-32601", "an unknown method");
    assert(_has(_head, "Access-Control-Allow-Origin"), "bridge: ...with CORS");
    _t(2, _raw("POST", _cat3(_V, cors, ""), "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/x\"}"), 202, "", "a notification");
    assert(_has(_head, "Access-Control-Allow-Origin"), "bridge: ...with CORS");
    _t(2, _raw("POST", _mh("tools/call", "t_none"), _mb("tools/call", ",\"name\":\"t_none\"")), 200, "-32602", "an unknown tool is an error here, not the legacy envelope");
    # Its legacy contract is its own, and stays.
    _t(2, _raw("POST", "", "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/call\",\"params\":{\"name\":\"t_none\"}}"), 200, "", "a legacy unknown tool keeps the bridge's envelope");
    assert(_has(_body, "\"isError\":true"), "bridge: ...isError");
    _t(2, _raw("POST", "", "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/x\"}"), 204, "", "a legacy notification keeps its 204");
    _t(2, _raw("POST", "MCP-Protocol-Version: 2025-11-25\r\n", _pc_legacy()), 200, "", "a legacy call of a tool with headers needs none");
    http_config_with_session_store(_http_cfg, 0);
    streamable_config_with_session_store(_strm_cfg, 0);
    _t(0, _raw("POST", "MCP-Protocol-Version: 2025-11-25\r\n", _pc_legacy()), 200, "", "a legacy call of a tool with headers needs none");
    _t(1, _raw("POST", "MCP-Protocol-Version: 2025-11-25\r\n", _pc_legacy()), 200, "", "a legacy call of a tool with headers needs none");
    assert(_has(_body, "isError") == 0, "streamable: ...and runs it");
    http_config_with_session_store(_http_cfg, session_store_default());
    streamable_config_with_session_store(_strm_cfg, session_store_default());

    var pa = vec_new();
    vec_push(pa, "https://as.example.com");
    var ps = vec_new();
    vec_push(ps, "files:read");
    vec_push(ps, "files:write");
    var prm = bote_prm_new("https://mcp.example.com/mcp", pa, ps, "bote test");
    _metadata(0, prm);
    _metadata(1, prm);
    _metadata(2, prm);
    _scopes(0, prm);
    _scopes(1, prm);
    _scopes(2, prm);

    # A 403 still reaches a page: the bridge's CORS headers go out with it.
    _prm_bearer(2, &_tok, 0);
    dispatcher_set_scope_check(_d_of(2), &_holds, 0);
    _run(2, _raw("POST", _cat3(_ah("nothing"), "Origin: http://localhost\r\n", ""), _lc_body("t_scoped", "")));
    assert_eq(_status, 403, "bridge: a 403 from an allowed Origin");
    assert(_has(_head, "Access-Control-Allow-Origin: http://localhost\r\n"), "bridge: ...carries CORS");
    assert(_has(_head, "WWW-Authenticate: Bearer error=\"insufficient_scope\""), "bridge: ...and the challenge");
    assert(_has(_head, "Access-Control-Expose-Headers: WWW-Authenticate\r\n"), "bridge: ...which a page may read");
    dispatcher_set_scope_check(_d_of(2), 0, 0);
    _prm_bearer(2, 0, 0);

    # 3.6.4: every refusal past the Origin check carries CORS, the 401 first among them:
    # without it a page sees a network error, and OAuth discovery never starts.
    var bo = "Origin: http://localhost\r\n";
    var acao = "Access-Control-Allow-Origin: http://localhost\r\n";
    var expose = "Access-Control-Expose-Headers: WWW-Authenticate\r\n";
    _prm_bearer(2, &_deny, 0);
    _run(2, _raw("POST", bo, _lb("tools/list")));
    assert(_status == 401 && _has(_head, acao) && _has(_head, expose), "bridge: a 401 with no token reaches a page");
    assert(_has(_head, "WWW-Authenticate: Bearer realm=\"mcp\"\r\n"), "bridge: ...with its challenge");
    _run(2, _raw("POST", _cat3(bo, "Authorization: Bearer nope\r\n", ""), _lb("tools/list")));
    assert(_status == 401 && _has(_head, acao) && _has(_head, "error=\"invalid_token\""), "bridge: a refused token's 401 too");
    _prm_set(2, prm);
    _run(2, _raw("POST", bo, _lb("tools/list")));
    assert(_status == 401 && _has(_head, acao) && _has(_head, "resource_metadata="), "bridge: ...and with metadata configured");
    _prm_set(2, 0);
    _prm_bearer(2, 0, 0);
    _run(2, _get("POST", "/nope", bo));
    assert(_status == 404 && _has(_head, acao), "bridge: a 404 reaches a page");
    _run(2, _get("GET", "/nope", bo));
    assert(_status == 404 && _has(_head, acao), "bridge: a GET 404 too");
    _run(2, _get("PUT", "/", bo));
    assert(_status == 405 && _has(_head, acao) && _has(_head, "Allow: POST, GET, OPTIONS\r\n"), "bridge: a 405, with Allow");
    _run(2, _raw("POST", _cat3(bo, "Transfer-Encoding: chunked\r\n", ""), _lb("tools/list")));
    assert(_status == 400 && _has(_head, acao), "bridge: a Transfer-Encoding 400");
    _run(2, _get("POST", "/", _cat3(bo, "Content-Length: 12x\r\n", "")));
    assert(_status == 400 && _has(_head, acao), "bridge: a bad Content-Length");
    _run(2, _get("POST", "/", _cat3(bo, "Content-Length: 900000\r\n", "")));
    assert(_status == 413 && _has(_head, acao), "bridge: a 413");
    _run(2, "POST / HTTP/1.1\r\nHost: x\r\nOrigin: http://localhost\r\nContent-Length: 2\r\n");
    assert(_status == 400 && _has(_head, acao), "bridge: a request with no end to its headers");
    _run(2, _get("POST", "/nope", "Origin: https://evil.example\r\n"));
    assert(_status == 403 && _has(_head, "Access-Control-Allow-Origin") == 0, "bridge: an Origin it refuses gets no CORS");
    _run(0, _get("POST", "/nope", bo));
    assert(_has(_head, "Access-Control-Allow-Origin") == 0, "http: no CORS on its refusals, which is the bridge's alone");
    assert_eq(_heap_per(2, _get("PUT", "/", bo)), 0, "bridge heap: a 405 with CORS");
    _prm_bearer(2, &_deny, 0);
    assert_eq(_heap_per(2, _raw("POST", _cat3(bo, "Authorization: Bearer ", _cat3(_rep("x", 60000), "\r\n", "")), _lb("tools/list"))), 0, "bridge heap: a 401 with CORS, a 60 KB token");
    _prm_bearer(2, 0, 0);
    # A listed Origin reads the document, on the bridge with CORS.
    _prm_set(2, prm);
    _run(2, _get("GET", _WK, "Origin: http://localhost\r\n"));
    assert_eq(_status, 200, "bridge: metadata, for a listed Origin");
    assert(_has(_head, "Access-Control-Allow-Origin: http://localhost"), "bridge: ...with CORS");
    # 3.6.5: the document's own refusals past the Origin check too.
    _run(2, _get("POST", _WK, bo));
    assert(_status == 405 && _has(_head, acao) && _has(_head, "Allow: GET\r\n"), "bridge: metadata's 405 carries CORS, and Allow");
    _run(2, _get("GET", _WK, _cat3(bo, "Transfer-Encoding: chunked\r\n", "")));
    assert(_status == 400 && _has(_head, acao), "bridge: metadata's Transfer-Encoding 400 carries CORS");
    assert_eq(_heap_per(2, _get("POST", _WK, bo)), 0, "bridge heap: metadata's 405 with CORS");
    _prm_set(0, prm);
    _run(0, _get("POST", _WK, ""));
    assert(_status == 405 && _has(_head, "Allow: GET\r\n") && _has(_head, "Access-Control-Allow-Origin") == 0, "http: metadata's 405 has Allow and no CORS");
    _prm_set(0, 0);
    _prm_set(2, 0);

    # 3.6.5: a NUL anywhere in the head is refused, RFC 9110 5.5, before anything reads a
    # header: one reader stops at it and another does not.
    var nk = 0;
    while (nk < 3) {
        var nh = "POST /mcp HTTP/1.1\r\nHost: x\r\nOrigin: http://localhost\r\nX-Note: a";
        var nt = "\r\nContent-Length: 2\r\n\r\n{}";
        var nhl = strlen(nh);
        var ntl = strlen(nt);
        var nreq = alloc(nhl + 1 + 60000 + ntl + 1);
        memcpy(nreq, nh, nhl);
        store8(nreq + nhl, 0);
        memset(nreq + nhl + 1, 120, 60000);
        memcpy(nreq + nhl + 1 + 60000, nt, ntl + 1);
        var nlen = nhl + 1 + 60000 + ntl;
        if (nk == 2) { memcpy(nreq, "POST /    HTTP/1.1", 18); }
        _run_n(nk, nreq, nlen);
        assert(_status == 400 && _replies == 1, _nm(nk, "60 KB behind a NUL in a header is refused"));
        _run_n(nk, nreq, nlen);
        var nb = alloc_used();
        var ni = 0;
        while (ni < 20) { _run_n(nk, nreq, nlen); ni = ni + 1; }
        assert_eq((alloc_used() - nb) / 20, 0, _nm(nk, "...and keeps nothing"));
        nk = nk + 1;
    }

    # An Origin. The rebinding pair is refused and the server's own loopback address
    # is not, with no list set. `Host` here is the harness's `x`, so each line names one.
    var own = "Host: localhost:8390\r\nOrigin: http://localhost:8390\r\n";
    var evil = "Host: evil.example:8390\r\nOrigin: http://evil.example:8390\r\n";
    bridge_config_with_origins(_brg_cfg, 0);
    var kk = 0;
    while (kk < 3) {
        _run(kk, _ohost(_raw("POST", _cat3(_mh("tools/list", 0), own, ""), _mb("tools/list", ""))));
        assert_eq(_status, 200, _nm(kk, "the server's own loopback Origin"));
        _run(kk, _ohost(_raw("POST", _cat3(_mh("tools/list", 0), evil, ""), _mb("tools/list", ""))));
        assert_eq(_status, 403, _nm(kk, "a rebinding page's Origin"));
        kk = kk + 1;
    }
    bridge_config_with_origins(_brg_cfg, brg_origins);
    _run(2, _ohost(_raw("POST", _cat3(_mh("tools/list", 0), own, ""), _mb("tools/list", ""))));
    assert_eq(_status, 403, "bridge: a list is the whole policy");

    # GET and DELETE. `bote http` serves POST alone, in either era.
    _t(1, _raw("GET", _V, ""), 405, "", "GET naming this revision");
    assert(_has(_head, "Allow: POST\r\n"), "streamable: ...says what is allowed");
    _t(1, _raw("DELETE", _V, ""), 405, "", "DELETE naming this revision");
    assert(_has(_head, "Allow: POST, GET\r\n"), "streamable: ...says what is allowed");
    _t(0, _raw("GET", "", ""), 405, "", "GET");
    assert(_has(_head, "Allow: POST\r\n"), "http: ...says what is allowed");
    _t(1, _raw("GET", "", ""), 404, "", "a legacy GET still needs its session");
    _t(1, _raw("GET", "MCP-Protocol-Version: 1900-01-01\r\n", ""), 400, "-32022", "a GET naming an unknown version");
    assert(_has(_body, "\"id\":null"), "streamable: ...has no id to echo");

    # require_protocol: the header is required, and `initialize` is still exempt.
    var init_msg = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-11-25\",\"capabilities\":{},\"clientInfo\":{\"name\":\"c\",\"version\":\"1\"}}}";
    http_config_with_require_protocol(_http_cfg, 1);
    streamable_config_with_require_protocol(_strm_cfg, 1);
    _t(0, _raw("POST", "", _lb("tools/list")), 400, "-32020", "require_protocol with no header");
    _t(1, _raw("POST", "", _lb("tools/list")), 400, "-32020", "require_protocol with no header");
    _t(0, _raw("POST", "", "{\"jsonrpc\":\"2.0\",\"id\":7}"), 400, "-32020", "require_protocol on a body with no method");
    _t(1, _raw("POST", "", "{\"jsonrpc\":\"2.0\",\"id\":7}"), 400, "-32020", "require_protocol on a body with no method");
    _t(0, _raw("POST", "", "{nope"), 400, "-32020", "require_protocol on a body that is no JSON");
    _t(0, _raw("POST", "", init_msg), 200, "", "require_protocol exempts initialize");
    _t(1, _raw("POST", "", init_msg), 200, "", "require_protocol exempts initialize");
    _t(1, _raw("GET", "", ""), 400, "-32020", "require_protocol on a GET");
    http_config_with_require_protocol(_http_cfg, 0);
    streamable_config_with_require_protocol(_strm_cfg, 0);

    # The handler is handed the claims auth produced, on this path too.
    http_config_with_bearer_validator(_http_cfg, &_allow, 0);
    streamable_config_with_bearer_validator(_strm_cfg, &_allow, 0);
    var authed = _cat3(_mh("tools/call", "t_claims"), "Authorization: Bearer tok\r\n", "");
    _t(0, _raw("POST", _mh("tools/list", 0), _mb("tools/list", "")), 401, "", "no token ahead of everything");
    _t(1, _raw("POST", _mh("tools/list", 0), _mb("tools/list", "")), 401, "", "no token ahead of everything");
    _t(0, _raw("POST", authed, _mb("tools/call", ",\"name\":\"t_claims\"")), 200, "", "a token");
    assert(_seen_claims != 0 && streq(_seen_claims, "the-claims") == 1, "http: the handler sees the claims");
    _seen_claims = 0;
    _t(1, _raw("POST", authed, _mb("tools/call", ",\"name\":\"t_claims\"")), 200, "", "a token");
    assert(_seen_claims != 0 && streq(_seen_claims, "the-claims") == 1, "streamable: the handler sees the claims");
    #endif

    return assert_summary();
}

var rc = main();
sys_exit(rc);
