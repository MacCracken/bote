include "src/stream.cyr"
include "src/session.cyr"
include "src/discovery.cyr"
include "src/auth.cyr"
include "src/conn.cyr"
include "src/fetch.cyr"
include "src/http_era.cyr"
include "src/oauth_metadata.cyr"
include "src/listen.cyr"
include "src/transport_stdio.cyr"
include "src/transport_http.cyr"
include "src/transport_unix.cyr"
include "src/bridge.cyr"
include "src/transport_streamable.cyr"
include "src/transport_ws.cyr"

fn h_tool(args, claims) { return "{\"content\":[{\"type\":\"text\",\"text\":\"ok\"}]}"; }
var _ret = 0;
fn h_ret(args, claims) { return _ret; }

fn _cat(a, b) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    return str_data(str_builder_build(sb));
}
fn _cat3(a, b, c) { return _cat(_cat(a, b), c); }
fn _has(s, sub) { if (s != 0 && strstr(s, sub) >= 0) { return 1; } return 0; }
fn _vs(schema, value) { return _sch_check_value_a(bote_req_begin(), parse_property(schema), "v", value); }
fn _ok(schema, value) { if (_vs(schema, value) == 0) { return 1; } return 0; }
fn _n(schema, value) {
    var v = _vs(schema, value);
    if (v == 0) { return 0; }
    return vec_len(v);
}
fn _v0(schema, value) {
    var v = _vs(schema, value);
    if (v == 0) { return "(none)"; }
    return _cat(vec_get(v, 0), "");
}
fn _ase(got, want, name) {
    if (got == 0 || want == 0) { return assert(got == want, name); }
    return assert_streq(got, want, name);
}
fn _msg(method, params) {
    return _cat3(_cat3("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"", method, "\",\"params\":{"), params, "}}");
}
fn _call(d, tool, args) {
    return codec_process_message(_msg("tools/call", _cat3(_cat3("\"name\":\"", tool, "\",\"arguments\":"), args, "")), d, 0);
}
# An array of n items, each `item`.
fn _many(n, item) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "[");
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, item);
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]");
    return str_data(str_builder_build(sb));
}

var _lc_all = 0;
fn _lc_hook(ts, level, category, msg, msg_len, sixth) {
    var n = msg_len;
    if (n > 1023) { n = 1023; }
    var b = alloc(n + 1);
    memcpy(b, msg, n);
    store8(b + n, 0);
    vec_push(_lc_all, b);
    return 0;
}
fn _lc_begin() { _lc_all = vec_new(); sakshi_set_emit_hook(&_lc_hook); sakshi_set_level(SK_TRACE); return 0; }
fn _lc_end() { sakshi_clear_emit_hook(); sakshi_set_level(SK_ERROR); return 0; }
fn _lc_find(sub) {
    var i = 0;
    while (i < vec_len(_lc_all)) {
        if (_has(vec_get(_lc_all, i), sub) == 1) { return vec_get(_lc_all, i); }
        i = i + 1;
    }
    return 0;
}

# (3.8.10) The fewest nanoseconds of three judgements of `value` by `prop`, and of three calls
# of `tool`: a bound on a judgement's time is a multiple of one of these, measured in the same
# process, so it holds under emulation as on the host.
fn _ns3(prop, value) {
    var best = 0;
    var i = 0;
    while (i < 3) {
        var t = clock_now_ns();
        _sch_check_value_a(bote_req_begin(), prop, "v", value);
        var dt = clock_now_ns() - t;
        if (i == 0 || dt < best) { best = dt; }
        i = i + 1;
    }
    return best;
}
fn _call_ns3(d, msg) {
    var best = 0;
    var i = 0;
    while (i < 3) {
        var t = clock_now_ns();
        codec_process_message_a(bote_req_begin(), msg, d, 0);
        var dt = clock_now_ns() - t;
        if (i == 0 || dt < best) { best = dt; }
        i = i + 1;
    }
    return best;
}

var SUITE = "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"$defs\":{\"address\":{\"$anchor\":\"addressDef\",\"type\":\"object\",\"properties\":{\"street\":{\"type\":\"string\"},\"city\":{\"type\":\"string\"}}}},\"properties\":{\"name\":{\"type\":\"string\"},\"address\":{\"$ref\":\"#/$defs/address\"},\"contactMethod\":{\"type\":\"string\",\"enum\":[\"phone\",\"email\"]},\"phone\":{\"type\":\"string\"},\"email\":{\"type\":\"string\"}},\"allOf\":[{\"anyOf\":[{\"required\":[\"phone\"]},{\"required\":[\"email\"]}]}],\"if\":{\"properties\":{\"contactMethod\":{\"const\":\"phone\"}},\"required\":[\"contactMethod\"]},\"then\":{\"required\":[\"phone\"]},\"else\":{\"required\":[\"email\"]},\"additionalProperties\":false}";

fn main() {
    alloc_init();

    # ---- allOf ----
    var al = "{\"allOf\":[{\"type\":\"integer\"},{\"minimum\":5}]}";
    assert(_ok(al, "6") == 1, "allOf: every schema met");
    _ase(_v0(al, "4"), "v: less than minimum", "allOf: one missed, its violation kept");
    _ase(_v0(al, "\"x\""), "v: expected integer", "allOf: ...the other");
    _ase(_v0("{\"allOf\":[{\"properties\":{\"x\":{\"type\":\"integer\"}}}]}", "{\"x\":\"s\"}"), "v.x: expected integer", "allOf: a violation at its path");
    assert_eq(_n("{\"allOf\":[{\"type\":\"string\"},{\"minimum\":5},{\"maxLength\":1}]}", "\"abc\""), 1, "allOf: each keyword by kind, as ever");

    # ---- anyOf ----
    var an = "{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"integer\",\"minimum\":0}]}";
    assert(_ok(an, "\"a\"") == 1 && _ok(an, "3") == 1, "anyOf: either schema");
    _ase(_v0(an, "-1"), "v: matches no schema in anyOf", "anyOf: neither");
    assert_eq(_n(an, "true"), 1, "anyOf: ...one violation, none of the schemas'");
    var ar = "{\"anyOf\":[{\"required\":[\"a\"]},{\"required\":[\"b\"]}]}";
    assert(_ok(ar, "{\"a\":1}") == 1 && _ok(ar, "{\"b\":1}") == 1 && _ok(ar, "{}") == 0, "anyOf: of object schemas");
    assert(_ok("{\"type\":\"array\",\"items\":{\"anyOf\":[{\"type\":\"integer\"},{\"type\":\"null\"}]}}", "[1,null,2]") == 1, "anyOf: under items");
    _ase(_v0("{\"type\":\"array\",\"items\":{\"anyOf\":[{\"type\":\"integer\"},{\"type\":\"null\"}]}}", "[1,\"x\"]"), "v[1]: matches no schema in anyOf", "anyOf: ...at the item's path");

    # ---- oneOf ----
    var on = "{\"oneOf\":[{\"type\":\"integer\"},{\"minimum\":10}]}";
    assert(_ok(on, "5") == 1, "oneOf: the first only");
    assert(_ok(on, "10.5") == 1, "oneOf: the second only");
    assert(_ok(on, "\"x\"") == 1, "oneOf: a string meets the second, which judges numbers");
    _ase(_v0(on, "12"), "v: matches more than one schema in oneOf", "oneOf: both");
    _ase(_v0("{\"oneOf\":[{\"type\":\"integer\"},{\"type\":\"string\"}]}", "true"), "v: matches no schema in oneOf", "oneOf: neither");

    # ---- not ----
    assert(_ok("{\"not\":{\"type\":\"string\"}}", "1") == 1, "not: a value its schema refuses");
    _ase(_v0("{\"not\":{\"type\":\"string\"}}", "\"a\""), "v: matches the schema in not", "not: one it takes");
    assert(_ok("{\"not\":{}}", "1") == 0 && _ok("{\"not\":false}", "1") == 1, "not: {} refuses all, false nothing");
    assert(_ok("{\"not\":{\"not\":{\"type\":\"string\"}}}", "\"a\"") == 1 && _ok("{\"not\":{\"not\":{\"type\":\"string\"}}}", "1") == 0, "not: of not");

    # ---- if / then / else ----
    var it = "{\"if\":{\"properties\":{\"kind\":{\"const\":\"a\"}},\"required\":[\"kind\"]},\"then\":{\"required\":[\"a\"]},\"else\":{\"required\":[\"b\"]}}";
    assert(_ok(it, "{\"kind\":\"a\",\"a\":1}") == 1, "if: met, then met");
    _ase(_v0(it, "{\"kind\":\"a\"}"), "v: missing required field: a", "if: met, then missed");
    assert(_ok(it, "{\"b\":1}") == 1 && _ok(it, "{\"kind\":\"z\",\"b\":1}") == 1, "if: not met, else met");
    _ase(_v0(it, "{}"), "v: missing required field: b", "if: not met, else missed");
    assert(_ok("{\"then\":{\"type\":\"string\"},\"else\":{\"type\":\"string\"}}", "1") == 1, "if: then and else without if judge nothing");
    assert(_ok("{\"if\":{\"type\":\"string\"}}", "1") == 1 && _ok("{\"if\":{\"type\":\"string\"}}", "\"a\"") == 1, "if: with neither branch, nothing");
    assert(_ok("{\"if\":{\"type\":\"string\"},\"then\":{\"maxLength\":1}}", "\"ab\"") == 0 && _ok("{\"if\":{\"type\":\"string\"},\"then\":{\"maxLength\":1}}", "5") == 1, "if: then only");

    # ---- the conformance suite's 2020-12 schema, judged whole ----
    var d = dispatcher_new(tool_registry_new());
    dispatcher_register_tool(d, tool_def_new("t_suite", "d", tool_schema_from_json(SUITE)), &h_tool);
    assert(_has(_call(d, "t_suite", "{\"name\":\"x\",\"contactMethod\":\"phone\",\"phone\":\"1\"}"), "\"text\":\"ok\"") == 1, "suite: by phone, with a phone");
    assert(_has(_call(d, "t_suite", "{\"name\":\"x\",\"contactMethod\":\"phone\",\"email\":\"e\"}"), "missing required field: phone") == 1, "suite: by phone, with an email only: then refuses");
    assert(_has(_call(d, "t_suite", "{\"name\":\"x\",\"email\":\"e\"}"), "\"text\":\"ok\"") == 1, "suite: no method, an email");
    var su = _call(d, "t_suite", "{\"name\":\"x\"}");
    assert(_has(su, "matches no schema in anyOf") == 1 && _has(su, "missing required field: email") == 1, "suite: neither, refused by allOf's anyOf and by else");
    assert(_has(_call(d, "t_suite", "{\"name\":\"x\",\"email\":\"e\",\"fax\":1}"), "fax: additional property not allowed") == 1, "suite: its root's additionalProperties beside them");

    # ---- an inputSchema's root ----
    dispatcher_register_tool(d, tool_def_new("t_root", "d", tool_schema_from_json("{\"type\":\"object\",\"properties\":{\"a\":{},\"b\":{}},\"oneOf\":[{\"required\":[\"a\"]},{\"required\":[\"b\"]}]}")), &h_tool);
    assert(_has(_call(d, "t_root", "{\"a\":1}"), "\"text\":\"ok\"") == 1, "root: oneOf met");
    assert(_has(_call(d, "t_root", "{\"a\":1,\"b\":2}"), "matches more than one schema in oneOf") == 1, "root: ...twice");
    assert(_has(_call(d, "t_root", "{}"), "matches no schema in oneOf") == 1, "root: ...never");
    dispatcher_register_tool(d, tool_def_with_output_schema(tool_def_new("t_out", "d", schema_new("object", 0, vec_new())), "{\"type\":\"object\",\"properties\":{\"v\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]}}}"), &h_ret);
    _ret = "{\"content\":[],\"structuredContent\":{\"v\":null}}";
    assert(_has(_call(d, "t_out", "{}"), "isError") == 0, "result: anyOf met");
    _ret = "{\"content\":[],\"structuredContent\":{\"v\":3}}";
    assert(_has(_call(d, "t_out", "{}"), "structuredContent.v: matches no schema in anyOf") == 1, "result: anyOf missed, refused");

    # ---- the budget ----
    var wide = str_builder_new();
    str_builder_add_cstr(wide, "{\"type\":\"array\",\"items\":{\"anyOf\":[");
    var wi = 0;
    while (wi < 256) { if (wi > 0) { str_builder_add_cstr(wide, ","); } str_builder_add_cstr(wide, "{\"type\":\"string\",\"maxLength\":"); str_builder_add_int(wide, wi); str_builder_add_cstr(wide, "}"); wi = wi + 1; }
    str_builder_add_cstr(wide, ",{\"type\":\"integer\"}]}}");
    var ws = str_data(str_builder_build(wide));
    var wp = parse_property(ws);
    # Each item meets the last of 257 alternatives: every one is asked, and nothing fails
    # early to stop the walk, 12.9 million judgements for 100 KB.
    var nums = _many(50000, "1");
    # (3.8.12) Timed against the same items under an anyOf of two, in this process, so the
    # bound holds under emulation: two seconds was the host's figure, which qemu-aarch64 met
    # at 1.98 s for 3.8.11 and missed at 2.05 s for 3.8.12. The ratio is 13.5 on x86 and 12 on
    # aarch64; judging all 12.9 million would be about 50.
    var cp2 = parse_property("{\"type\":\"array\",\"items\":{\"anyOf\":[{\"type\":\"string\",\"maxLength\":0},{\"type\":\"integer\"}]}}");
    var ns = 0;
    var nc = 0;
    var bv = 0;
    var tr = 0;
    while (tr < 3) {
        var c0 = clock_now_ns();
        _sch_check_value_a(bote_req_begin(), cp2, "v", nums);
        var tc = clock_now_ns() - c0;
        if (tr == 0 || tc < nc) { nc = tc; }
        var t0 = clock_now_ns();
        bv = _sch_check_value_a(bote_req_begin(), wp, "v", nums);
        var tn = clock_now_ns() - t0;
        if (tr == 0 || tn < ns) { ns = tn; }
        tr = tr + 1;
    }
    assert(bv != 0 && vec_len(bv) == 1 && streq(vec_get(bv, 0), "v: more work to judge than its size allows") == 1, "budget: 50,000 items meeting the last of 257 alternatives, refused as too much to judge");
    assert(ns < 30 * nc, "budget: ...stopped at its 3.3 million, in under 30 times an anyOf of two over the same items");
    assert(_has(vec_get(_vs("{\"type\":\"array\",\"items\":{\"anyOf\":[{\"type\":\"string\"}]}}", _many(50000, "1")), 0), "v[0]: matches no schema in anyOf") == 1, "budget: failing items stop at the cap first, as ever");
    assert(_sch_check_value_a(bote_req_begin(), parse_property("{\"type\":\"array\",\"items\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"},{\"type\":\"integer\"}]}}"), "v", _many(50000, "1")) == 0, "budget: 50,000 items meeting an anyOf's third of three, well under it");
    assert(_sch_check_value_a(bote_req_begin(), wp, "v", _many(200, "1")) == 0, "budget: 200 items through the 257 alternatives, under it");
    assert(_sch_check_value_a(bote_req_begin(), parse_property("{\"type\":\"array\",\"items\":{\"type\":\"integer\"}}"), "v", _many(100000, "1")) == 0, "budget: 100,000 items judged once each never near it");
    # A budget of 10 judges no more than ten values: the walk stops, so the items after them
    # earn no violation, and the refusal is said past the cap of 32.
    var bb0 = BOTE_SCH_BUDGET_BASE;
    var bp0 = BOTE_SCH_BUDGET_PER_BYTE;
    BOTE_SCH_BUDGET_BASE = 10;
    BOTE_SCH_BUDGET_PER_BYTE = 0;
    var sv = _vs("{\"type\":\"array\",\"items\":{\"type\":\"integer\"}}", _many(100, "\"x\""));
    assert(sv != 0 && vec_len(sv) < 12 && streq(vec_get(sv, vec_len(sv) - 1), "v: more work to judge than its size allows") == 1, "budget: spent, the walk stops, the refusal last");
    BOTE_SCH_BUDGET_BASE = 0;
    var sv2 = _vs("{\"type\":\"array\",\"items\":{\"type\":\"integer\"}}", _many(100, "\"x\""));
    assert(sv2 != 0 && vec_len(sv2) == 1, "budget: none at all, the refusal alone");
    BOTE_SCH_BUDGET_BASE = 20;
    var sv3 = _vs("{\"type\":\"array\",\"items\":{\"type\":\"integer\"},\"maxItems\":1}", _many(100, "\"x\""));
    assert(sv3 != 0 && streq(vec_get(sv3, vec_len(sv3) - 1), "v: more work to judge than its size allows") == 1, "budget: ...said after the walk's own");
    # The cap filled first: 32 items fail `items`, and `contains` asks of the rest until the
    # budget is spent; the refusal is said as the thirty-third.
    BOTE_SCH_BUDGET_BASE = 80;
    var sv4 = _vs("{\"type\":\"array\",\"items\":{\"type\":\"integer\"},\"contains\":{\"type\":\"integer\"}}", _many(100, "\"x\""));
    assert(sv4 != 0 && vec_len(sv4) == 33 && streq(vec_get(sv4, 32), "v: more work to judge than its size allows") == 1, "budget: past a full cap, the refusal said as the thirty-third");
    BOTE_SCH_BUDGET_BASE = bb0;
    BOTE_SCH_BUDGET_PER_BYTE = bp0;
    var bd = dispatcher_new(tool_registry_new());
    dispatcher_register_tool(bd, tool_def_new("t_wide", "d", tool_schema_from_json(_cat3("{\"type\":\"object\",\"properties\":{\"l\":", ws, "}}"))), &h_tool);
    assert(_has(_call(bd, "t_wide", _cat3("{\"l\":", _many(20000, "1"), "}")), "more work to judge than its size allows") == 1, "budget: an argument refused through the dispatcher");

    # ---- (3.8.10, from the 3.8.9 review) an inputSchema root's composition, alone ----
    var rr = dispatcher_new(tool_registry_new());
    dispatcher_register_tool(rr, tool_def_new("r_one", "d", tool_schema_from_json("{\"type\":\"object\",\"oneOf\":[{\"required\":[\"a\"]},{\"required\":[\"b\"]}]}")), &h_tool);
    var r1 = _call(rr, "r_one", "{}");
    assert(_has(r1, "matches no schema in oneOf") == 1, "root alone: oneOf with no property beside it judged (it ran the handler)");
    assert(_has(r1, "': matches no schema in oneOf") == 1 && _has(r1, ": : ") == 0, "root alone: ...named from the empty path once, not ': : '");
    assert(_has(_call(rr, "r_one", "{\"a\":1}"), "\"text\":\"ok\"") == 1, "root alone: ...and met");
    var du = "{\"type\":\"object\",\"oneOf\":[{\"properties\":{\"kind\":{\"const\":\"a\"},\"n\":{\"type\":\"integer\"}},\"required\":[\"kind\",\"n\"]},{\"properties\":{\"kind\":{\"const\":\"b\"}},\"required\":[\"kind\"]}]}";
    dispatcher_register_tool(rr, tool_def_new("r_union", "d", tool_schema_from_json(du)), &h_tool);
    assert(_has(_call(rr, "r_union", "{\"kind\":\"a\",\"n\":\"not a number\"}"), "matches no schema in oneOf") == 1, "root alone: a discriminated union refusing a member of the wrong type");
    assert(_has(_call(rr, "r_union", "{\"kind\":\"a\",\"n\":1}"), "\"text\":\"ok\"") == 1 && _has(_call(rr, "r_union", "{\"kind\":\"b\"}"), "\"text\":\"ok\"") == 1, "root alone: ...and each kind met");
    dispatcher_register_tool(rr, tool_def_new("r_ep", "d", tool_schema_from_json("{\"type\":\"object\",\"properties\":{},\"anyOf\":[{\"required\":[\"a\"]}]}")), &h_tool);
    dispatcher_register_tool(rr, tool_def_new("r_er", "d", tool_schema_from_json("{\"type\":\"object\",\"required\":[],\"anyOf\":[{\"required\":[\"a\"]}]}")), &h_tool);
    dispatcher_register_tool(rr, tool_def_new("r_af", "d", tool_schema_from_json("{\"allOf\":[false],\"type\":\"object\"}")), &h_tool);
    assert(_has(_call(rr, "r_ep", "{}"), "matches no schema in anyOf") == 1 && _has(_call(rr, "r_er", "{}"), "matches no schema in anyOf") == 1, "root alone: beside an empty properties or required");
    assert(_has(_call(rr, "r_af", "{}"), "not allowed by the schema") == 1, "root alone: allOf of false");
    var rve = registry_validate_params(dispatcher_registry(rr), "r_one", "{}");
    assert(rve != 0 && bote_err_violations(rve) != 0 && _has(vec_get(bote_err_violations(rve), 0), "matches no schema in oneOf") == 1, "root alone: ...through registry_validate_params");
    assert(vec_len(compiled_validate(compiled_compile(tool_schema_from_json("{\"type\":\"object\",\"not\":{}}")), "{}")) == 1, "root alone: ...and compiled_validate");

    # ---- (3.8.10, from the 3.8.9 review) the budget counts the bytes a keyword reads ----
    var uq = str_builder_new();
    str_builder_add_cstr(uq, "{\"type\":\"object\",\"properties\":{\"l\":{\"anyOf\":[");
    wi = 1;
    while (wi <= 256) { if (wi > 1) { str_builder_add_cstr(uq, ","); } str_builder_add_cstr(uq, "{\"uniqueItems\":true,\"not\":{\"minItems\":"); str_builder_add_int(uq, wi); str_builder_add_cstr(uq, "}}"); wi = wi + 1; }
    str_builder_add_cstr(uq, "]}}}");
    dispatcher_register_tool(bd, tool_def_new("t_uq", "d", tool_schema_from_json(str_data(str_builder_build(uq)))), &h_tool);
    var uqa = str_builder_new();
    str_builder_add_cstr(uqa, "{\"l\":[");
    wi = 0;
    while (wi < 11000) { if (wi > 0) { str_builder_add_cstr(uqa, ","); } str_builder_add_int(uqa, 10000 + wi); wi = wi + 1; }
    str_builder_add_cstr(uqa, "]}");
    var uqs = str_data(str_builder_build(uqa));
    assert(strlen(uqs) > 60000 && strlen(uqs) < 70000, "bytes: (an argument of about 64 KB)");
    var uqr = _call(bd, "t_uq", uqs);
    assert(_has(uqr, "more work to judge than its size allows") == 1, "bytes: uniqueItems over 64 KB under 256 alternatives refused as too much to judge");
    # Stopped by what it read: about 33 alternatives' work, where through 3.8.9 all 256 ran
    # (977 ms on the host). The control is one alternative over the same argument.
    dispatcher_register_tool(bd, tool_def_new("t_uq1", "d", tool_schema_from_json("{\"type\":\"object\",\"properties\":{\"l\":{\"anyOf\":[{\"uniqueItems\":true,\"not\":{\"minItems\":1}}]}}}")), &h_tool);
    var uqm = _msg("tools/call", _cat3("\"name\":\"t_uq\",\"arguments\":", uqs, ""));
    var uqm1 = _msg("tools/call", _cat3("\"name\":\"t_uq1\",\"arguments\":", uqs, ""));
    assert(_call_ns3(bd, uqm) < 64 * _call_ns3(bd, uqm1), "bytes: ...in under 64 times one alternative's time (256 through 3.8.9)");
    var big = str_builder_new();
    str_builder_add_cstr(big, "\"");
    wi = 0;
    while (wi < 1000000) { str_builder_add_cstr(big, "aaaaaaaaaa"); wi = wi + 10; }
    str_builder_add_cstr(big, "\"");
    var ml = str_builder_new();
    str_builder_add_cstr(ml, "{\"anyOf\":[");
    wi = 0;
    while (wi < 256) { if (wi > 0) { str_builder_add_cstr(ml, ","); } str_builder_add_cstr(ml, "{\"maxLength\":"); str_builder_add_int(ml, wi); str_builder_add_cstr(ml, "}"); wi = wi + 1; }
    str_builder_add_cstr(ml, "]}");
    var mlp = parse_property(str_data(str_builder_build(ml)));
    var mlv = _sch_check_value_a(bote_req_begin(), mlp, "v", str_data(str_builder_build(big)));
    assert(mlv != 0 && streq(vec_get(mlv, vec_len(mlv) - 1), "v: more work to judge than its size allows") == 1, "bytes: a megabyte string under 256 maxLength alternatives refused");
    assert(_ns3(mlp, str_data(str_builder_build(big))) < 64 * _ns3(parse_property("{\"anyOf\":[{\"maxLength\":0}]}"), str_data(str_builder_build(big))), "bytes: ...in under 64 times one alternative's time (751 ms through 3.8.9)");
    assert(_ok("{\"maxLength\":2000000}", str_data(str_builder_build(big))) == 1, "bytes: one maxLength over a megabyte, well within");
    # Each keyword that reads a value's bytes, under 256 alternatives the value fails: a
    # megabyte string for const and enum, a number of 200,000 digits for integer, type
    # arrays and bounds. Each refused as too much to judge, by what it read.
    var dig = str_builder_new();
    str_builder_add_cstr(dig, "1");
    wi = 0;
    while (wi < 200000) { str_builder_add_cstr(dig, "0000000000"); wi = wi + 10; }
    var digs = str_data(str_builder_build(dig));
    var bigs = str_data(str_builder_build(big));
    var kws = vec_new();
    vec_push(kws, "{\"const\":\"x\"}");
    vec_push(kws, "{\"enum\":[\"x\",\"y\"]}");
    vec_push(kws, "{\"enum\":[[1],{\"a\":1}]}");
    vec_push(kws, "{\"type\":\"integer\",\"not\":{}}");
    vec_push(kws, "{\"type\":[\"integer\",\"null\"],\"not\":{}}");
    vec_push(kws, "{\"minimum\":0,\"maximum\":1}");
    vec_push(kws, "{\"enum\":[1,2]}");
    var kvals = vec_new();
    vec_push(kvals, bigs);
    vec_push(kvals, bigs);
    vec_push(kvals, _cat3("[", bigs, "]"));
    vec_push(kvals, digs);
    vec_push(kvals, digs);
    vec_push(kvals, digs);
    vec_push(kvals, digs);
    var kn = 0;
    while (kn < vec_len(kws)) {
        var alt = str_builder_new();
        str_builder_add_cstr(alt, "{\"anyOf\":[");
        wi = 0;
        while (wi < 256) { if (wi > 0) { str_builder_add_cstr(alt, ","); } str_builder_add_cstr(alt, vec_get(kws, kn)); wi = wi + 1; }
        str_builder_add_cstr(alt, "]}");
        var kp = parse_property(str_data(str_builder_build(alt)));
        var kv = _sch_check_value_a(bote_req_begin(), kp, "v", vec_get(kvals, kn));
        assert(kv != 0 && streq(vec_get(kv, vec_len(kv) - 1), "v: more work to judge than its size allows") == 1, _cat("bytes: refused as too much to judge under ", vec_get(kws, kn)));
        var kp1 = parse_property(_cat3("{\"anyOf\":[", vec_get(kws, kn), "]}"));
        assert(_ns3(kp, vec_get(kvals, kn)) < 64 * _ns3(kp1, vec_get(kvals, kn)), _cat("bytes: ...in under 64 times one alternative's time, ", vec_get(kws, kn)));
        kn = kn + 1;
    }
    assert(_ok("{\"enum\":[\"a\",\"b\"],\"anyOf\":[{\"maxLength\":1},{\"minLength\":0}]}", str_data(str_builder_build(big))) == 0, "bytes: (an enum it is not in)");

    # ---- (3.8.10, from the 3.8.9 review) a batch shares one base ----
    var one = _msg("tools/call", _cat3("\"name\":\"t_wide\",\"arguments\":", _cat3("{\"l\":", _many(200, "1"), "}"), ""));
    assert(_has(codec_process_message(one, bd, 0), "\"text\":\"ok\"") == 1, "batch: one call of 200 items through 257 alternatives, met");
    var bat = str_builder_new();
    str_builder_add_cstr(bat, "[");
    wi = 0;
    while (wi < 80) { if (wi > 0) { str_builder_add_cstr(bat, ","); } str_builder_add_cstr(bat, one); wi = wi + 1; }
    str_builder_add_cstr(bat, "]");
    var bats = str_data(str_builder_build(bat));
    var bar = codec_process_message(bats, bd, 0);
    var nok = 0;
    var nmore = 0;
    var bpos = 0;
    while (strstr(bar + bpos, "\"text\":\"ok\"") >= 0) { nok = nok + 1; bpos = bpos + strstr(bar + bpos, "\"text\":\"ok\"") + 1; }
    bpos = 0;
    while (strstr(bar + bpos, "more work to judge") >= 0) { nmore = nmore + 1; bpos = bpos + strstr(bar + bpos, "more work to judge") + 1; }
    assert(nok >= 1 && nok < 10, "batch: of 80 such calls, the first met and few after it");
    assert_eq(nok + nmore, 80, "batch: ...the rest refused as too much to judge");
    # About one call's work and the rest's own bytes: some twenty calls' time, where through
    # 3.8.9 the batch did eighty calls' work (521 ms on the host).
    assert(_call_ns3(bd, bats) < 40 * _call_ns3(bd, one), "batch: ...in under 40 times one call's time");
    assert(_has(codec_process_message(one, bd, 0), "\"text\":\"ok\"") == 1, "batch: a call after it has a base of its own again");
    assert_eq(load64(bote_req_state() + BOTE_REQ_STATE_POOL), 0, "batch: the shared base closed with the batch");

    # ---- (3.8.10, from the 3.8.9 review) an argument's integer past what a handler holds ----
    var oi = dispatcher_new(tool_registry_new());
    dispatcher_register_tool(oi, tool_def_new("t_oi", "d", tool_schema_from_json("{\"type\":\"object\",\"properties\":{\"n\":{\"anyOf\":[{\"type\":\"integer\"},{\"type\":\"null\"}]},\"m\":{\"oneOf\":[{\"type\":\"integer\"},{\"type\":\"string\"}]}}}")), &h_tool);
    assert(_has(_call(oi, "t_oi", "{\"n\":1e30}"), "integer out of range") == 1, "range: 1e30 through anyOf, refused (it reached the handler)");
    assert(_has(_call(oi, "t_oi", "{\"n\":99999999999999999999}"), "integer out of range") == 1, "range: ...twenty nines");
    assert(_has(_call(oi, "t_oi", "{\"m\":-1e30}"), "integer out of range") == 1, "range: ...through oneOf");
    assert(_has(_call(oi, "t_oi", "{\"n\":5,\"m\":\"s\"}"), "\"text\":\"ok\"") == 1 && _has(_call(oi, "t_oi", "{\"n\":null}"), "\"text\":\"ok\"") == 1, "range: ...and what a handler holds met");
    assert(_has(_call(oi, "t_oi", "{\"n\":1.5}"), "matches no schema in anyOf") == 1, "range: a fraction meets neither, as ever");
    dispatcher_register_tool(oi, tool_def_with_output_schema(tool_def_new("t_oo", "d", schema_new("object", 0, vec_new())), "{\"type\":\"object\",\"properties\":{\"n\":{\"anyOf\":[{\"type\":\"integer\"},{\"type\":\"null\"}]}}}"), &h_ret);
    _ret = "{\"content\":[],\"structuredContent\":{\"n\":1e30}}";
    assert(_has(_call(oi, "t_oo", "{}"), "isError") == 0, "range: a result's is a client's to read whole, as ever");

    # ---- (3.8.10, from the 3.8.9 review) an empty anyOf or oneOf ----
    assert(_ok("{\"anyOf\":[]}", "1") == 0 && _ok("{\"oneOf\":[]}", "1") == 0, "empty: anyOf and oneOf of none refuse every value, as the official client does");
    assert(_ok("{\"allOf\":[]}", "1") == 1, "empty: allOf of none takes every value");
    _ase(_v0("{\"properties\":{\"v\":{\"anyOf\":[]}}}", "{\"v\":1}"), "v.v: matches no schema in anyOf", "empty: ...at its path");

    # ---- (3.8.9, from the 3.8.8 review) each keyword by the schema's dialect ----
    var d07 = "\"$schema\":\"http://json-schema.org/draft-07/schema#\",";
    var d19 = "\"$schema\":\"https://json-schema.org/draft/2019-09/schema\",";
    var d06 = "\"$schema\":\"http://json-schema.org/draft-06/schema#\",";
    assert(_ok(_cat3("{", d07, "\"prefixItems\":[{\"type\":\"string\"}]}"), "[1]") == 1, "dialect: draft-07 has no prefixItems, and judges nothing by it");
    assert(_ok(_cat3("{", d19, "\"prefixItems\":[{\"type\":\"string\"}]}"), "[1]") == 1, "dialect: ...nor 2019-09");
    assert(_ok("{\"prefixItems\":[{\"type\":\"string\"}]}", "[1]") == 0, "dialect: 2020-12, the default, judges it");
    _ase(_v0(_cat3("{", d07, "\"contains\":{\"type\":\"integer\"},\"minContains\":0}"), "[]"), "v: no item matches contains", "dialect: draft-07 judges contains, not minContains, so [] is refused, as a client refuses it");
    assert(_ok(_cat3("{", d19, "\"contains\":{\"type\":\"integer\"},\"minContains\":0}"), "[]") == 1, "dialect: 2019-09 has minContains");
    assert(_ok(_cat3("{", d07, "\"dependentRequired\":{\"a\":[\"b\"]}}"), "{\"a\":1}") == 1, "dialect: draft-07 has no dependentRequired");
    assert(_ok(_cat3("{", d07, "\"dependentSchemas\":{\"a\":false}}"), "{\"a\":1}") == 1, "dialect: ...nor dependentSchemas");
    assert(_ok(_cat3("{", d19, "\"dependentRequired\":{\"a\":[\"b\"]}}"), "{\"a\":1}") == 0, "dialect: 2019-09 has them");
    # (3.8.10, from the 3.8.9 review) Judged, as the official client's draft-07 engine for
    # draft-06 judges it: through 3.8.9 the client refused a result that passed here.
    assert(_ok(_cat3("{", d06, "\"if\":{\"type\":\"string\"},\"then\":{\"maxLength\":1}}"), "\"ab\"") == 0, "dialect: draft-06's if judged, as the official client judges it (3.8.10)");
    assert(_ok(_cat3("{", d07, "\"if\":{\"type\":\"string\"},\"then\":{\"maxLength\":1}}"), "\"ab\"") == 0, "dialect: draft-07 has it");
    assert(_ok(_cat3("{", d06, "\"anyOf\":[{\"type\":\"string\"}]}"), "1") == 0 && _ok(_cat3("{", d06, "\"propertyNames\":{\"maxLength\":1}}"), "{\"ab\":1}") == 0, "dialect: draft-06 has anyOf and propertyNames");
    assert(_ok(_cat3("{", d07, "\"type\":\"object\",\"properties\":{\"p\":{\"prefixItems\":[{\"type\":\"string\"}]}}}"), "{\"p\":[1]}") == 1, "dialect: a property's schema is its root's dialect");
    var dd = dispatcher_new(tool_registry_new());
    dispatcher_register_tool(dd, tool_def_with_output_schema(tool_def_new("t_d07", "d", schema_new("object", 0, vec_new())), _cat3("{", d07, "\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"array\",\"prefixItems\":[{\"type\":\"string\"}]}}}")), &h_ret);
    _ret = "{\"content\":[],\"structuredContent\":{\"a\":[1]}}";
    assert(_has(_call(dd, "t_d07", "{}"), "isError") == 0, "dialect: a draft-07 result a client takes, taken (a tool error at 3.8.8)");
    dispatcher_register_tool(dd, tool_def_new("t_d07i", "d", tool_schema_from_json(_cat3("{", d07, "\"type\":\"object\",\"dependentRequired\":{\"a\":[\"b\"]}}"))), &h_tool);
    assert(_has(_call(dd, "t_d07i", "{\"a\":1}"), "\"text\":\"ok\"") == 1, "dialect: draft-07 arguments its dialect takes, served (refused at 3.8.8)");

    # ---- (3.8.9, from the 3.8.8 review) a dependentRequired name that is no text ----
    _ase(_v0("{\"dependentRequired\":{\"a\":[\"\\ud800\"]}}", "{\"a\":1}"), "v: missing required field: (a name that is no text), which a requires", "names: one that is no text, never met (dropped at 3.8.8)");
    assert(_ok("{\"dependentRequired\":{\"a\":[\"\\ud800\"]}}", "{}") == 1, "names: ...asked only when its member is there");

    # ---- (3.8.9, from the 3.8.8 review) a quiet judgement judges as JSON Schema does ----
    var qd = dispatcher_new(tool_registry_new());
    dispatcher_register_tool(qd, tool_def_new("t_q", "d", tool_schema_from_json("{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"array\",\"contains\":{\"type\":\"integer\"},\"maxContains\":1},\"b\":{\"not\":{\"type\":\"integer\"}},\"c\":{\"type\":\"integer\"}}}")), &h_tool);
    assert(_has(_call(qd, "t_q", "{\"a\":[5,1e30]}"), "a: more items than maxContains match contains") == 1, "quiet: 1e30 is an integer under maxContains (it ran the handler at 3.8.8)");
    assert(_has(_call(qd, "t_q", "{\"b\":1e30}"), "b: matches the schema in not") == 1, "quiet: ...and under not");
    assert(_has(_call(qd, "t_q", "{\"c\":1e30}"), "c: integer out of range") == 1, "quiet: a schema judging it directly still refuses it as past what a handler holds");

    # ---- (3.8.9, from the 3.8.8 review) what the codec took ----
    var td = dispatcher_new(tool_registry_new());
    dispatcher_register_tool(td, tool_def_new("t_t", "d", schema_new("object", 0, vec_new())), &h_tool);
    var okr = codec_process_message("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}", td, 0);
    assert_eq(codec_unanswerable(okr), 0, "taken: a request taken through the heap form");
    var bad = codec_process_message("{\"jsonrpc\":\"2.0\",\"method\":5}", td, 0);
    assert_eq(codec_unanswerable(bad), 1, "taken: ...and a malformed message after it through the heap form, not (it read as taken at 3.8.8)");
    var bn = codec_process_message("[{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"},{\"jsonrpc\":\"2.0\",\"id\":5,\"result\":{}}]", td, 0);
    assert(bn != 0 && codec_unanswerable(bn) == 1, "taken: a batch of a notification and a response took no request (it was taken at 3.8.8)");
    var br = codec_process_message("[{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"},{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"no/such\"}]", td, 0);
    assert(br != 0 && codec_unanswerable(br) == 0, "taken: ...and one with a request did");

    # ---- the WARNs ----
    _lc_begin();
    var wd = dispatcher_new(tool_registry_new());
    dispatcher_register_tool(wd, tool_def_with_output_schema(tool_def_new("w_bad", "d", schema_new("object", 0, vec_new())), "{\"type\":\"object\",\"properties\":{\"b\":{\"anyOf\":[]},\"c\":{\"oneOf\":[{},5]},\"f\":{\"then\":{}}}}"), &h_ret);
    dispatcher_register_tool(wd, tool_def_with_output_schema(tool_def_new("w_good", "d", schema_new("object", 0, vec_new())), "{\"type\":\"object\",\"properties\":{\"a\":{\"allOf\":[{}]},\"b\":{\"anyOf\":[true,{}]},\"c\":{\"oneOf\":[{},false]},\"d\":{\"not\":{}},\"e\":{\"if\":{},\"then\":{},\"else\":false}}}"), &h_ret);
    _lc_end();
    # (3.8.14, from the 3.8.13 review) Of a kind the client's engine refuses, refused, where
    # 3.8.13 warned of each: allOf an object, not a number, if a string.
    var wro = tool_def_new("w_r", "d", schema_new("object", 0, vec_new()));
    assert(_has(registry_check_tool_def(tool_def_with_output_schema(wro, "{\"type\":\"object\",\"properties\":{\"a\":{\"allOf\":{}}}}")), "names allOf with a value of a kind the official client refuses (it takes an array)") == 1, "register: allOf an object refused");
    assert(_has(registry_check_tool_def(tool_def_with_output_schema(wro, "{\"type\":\"object\",\"properties\":{\"d\":{\"not\":5}}}")), "names not with a value of a kind the official client refuses (it takes an object or a boolean)") == 1, "register: not a number refused");
    assert(_has(registry_check_tool_def(tool_def_with_output_schema(wro, "{\"type\":\"object\",\"properties\":{\"e\":{\"if\":\"x\"}}}")), "names if with a value of a kind") == 1, "register: if a string refused");
    assert(_lc_find("anyOf that is no non-empty array of schemas") != 0, "warn: anyOf empty");
    assert(_lc_find("oneOf that is no non-empty array of schemas") != 0, "warn: oneOf holding a number");
    assert(_lc_find("then or else without if") != 0, "warn: then with no if");
    assert(_lc_find("w_good") == 0, "warn: none for each well formed");
    assert(_lc_find("keyword=allOf") == 0 && _lc_find("keyword=anyOf") == 0 && _lc_find("keyword=oneOf") == 0 && _lc_find("keyword=not") == 0 && _lc_find("keyword=if") == 0, "warn: none of them as unenforced");
    _lc_begin();
    var wd2 = dispatcher_new(tool_registry_new());
    dispatcher_register_tool(wd2, tool_def_with_output_schema(tool_def_new("w_d07", "d", schema_new("object", 0, vec_new())), "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"a\":{\"prefixItems\":[{}],\"minContains\":1},\"b\":{\"dependentRequired\":{}}}}"), &h_ret);
    dispatcher_register_tool(wd2, tool_def_with_output_schema(tool_def_new("w_d06", "d", schema_new("object", 0, vec_new())), "{\"$schema\":\"http://json-schema.org/draft-06/schema#\",\"type\":\"object\",\"if\":{},\"then\":{}}"), &h_ret);
    _lc_end();
    assert(_lc_find("prefixItems, which this schema's dialect does not have") != 0, "warn: draft-07's prefixItems");
    assert(_lc_find("minContains, which this schema's dialect does not have") != 0, "warn: ...minContains");
    assert(_lc_find("dependentRequired, which this schema's dialect does not have") != 0, "warn: ...dependentRequired");
    assert(_lc_find("if, which draft-06 does not have and bote judges, as the official client does") != 0, "warn: draft-06's if, judged (3.8.10)");
    assert(_lc_find("if, which this schema's dialect does not have") == 0, "warn: ...and no longer said to judge nothing");
    assert(_lc_find("then or else without if") == 0, "warn: ...and no word of then without if there");

    # ---- the heap and the arena ----
    var hm = _msg("tools/call", "\"name\":\"t_root\",\"arguments\":{\"a\":1,\"b\":2}");
    codec_process_message_a(bote_req_begin(), hm, d, 0);
    var h0 = alloc_used();
    wi = 0;
    while (wi < 50) { codec_process_message_a(bote_req_begin(), hm, d, 0); wi = wi + 1; }
    assert_eq(alloc_used() - h0, 0, "heap: fifty refused calls keep nothing");
    var fa = bote_req_arena_new();
    var fb = bote_req_arena_bytes(fa);
    assert(_sch_check_value_a(fa, parse_property("{\"type\":\"array\",\"items\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"integer\"}]}}"), "v", _many(5000, "1")) == 0, "arena: 5,000 items meeting anyOf's second");
    assert_eq(bote_req_arena_bytes(fa), fb, "arena: ...each quiet judgement given back, the first chunk");
    var cc = _compile_object_body("{\"type\":\"object\",\"properties\":{\"l\":{\"type\":\"array\",\"items\":{\"oneOf\":[{\"type\":\"string\"},{\"minimum\":0}]}}}}");
    var cv = _cat3("{\"l\":", _many(2000, "5"), "}");
    assert_eq(vec_len(compiled_validate(cc, cv)), 0, "heap form: 2,000 items through oneOf pass");
    var hh = alloc_used();
    wi = 0;
    while (wi < 5) { compiled_validate(cc, cv); wi = wi + 1; }
    assert((alloc_used() - hh) / 5 < 256, "heap form: ...keeping only its answer");
    return assert_summary();
}

var rc = main();
sys_exit_group(rc);
