    _cap_reset();
    assert_eq(dispatcher_resource_updated(rsd, 0), 0 - 1, "update: no URI is refused");
    assert_eq(dispatcher_resource_updated(rsd, ""), 0 - 1, "update: ...nor an empty one");
    # Overflow: more URIs than the queue holds, or one too long, and every subscription is
    # told of every URI it holds.
    var rsoi = 0;
    while (rsoi < 17) {
        dispatcher_resource_updated(rsd, _num("res://none/", rsoi));
        rsoi = rsoi + 1;
    }
    assert(atomic_load(rsc + 120) == 1, "overflow: the queue full");
    bote_listen_line_deliver(rsc);
    assert(_has(_cap, _upd("\"file:///a\"", "\"r1\"")) && _has(_cap, _upd("\"file:///dir/\"", "\"r1\"")) && _has(_cap, _upd("\"res://q?x=\\\"1\\\"\"", "\"r1\"")), "overflow: each of r1's URIs");
    assert(_has(_cap, _upd("\"file:///other\"", "\"r2\"")), "overflow: ...and r2's");
    assert_eq(_count(_cap, _UL), 4, "overflow: no more than that");
    assert(atomic_load(rsc + 120) == 0 && atomic_load(rsc + 112) == 0, "overflow: and the queue is empty again");
    _cap_reset();
    dispatcher_resource_updated(rsd, _long_uri(0, 1025));
    bote_listen_line_deliver(rsc);
    assert_eq(_count(_cap, _UL), 4, "overflow: a URI too long to queue overflows it too");
    _cap_reset();
    # A connection's queued updates end with it (3.7.5): the next connection's subscriptions
    # are told of nothing that happened before they listened, an overflow included.
    var dtd = _mk_d(1);
    var dtc = bote_listen_line_new(4);
