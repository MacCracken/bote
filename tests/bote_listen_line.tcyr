    assert(_has(_run(rsc, rsd, _mb("server/discover")), "\"resources\":{\"listChanged\":true,\"subscribe\":true}"), "updates: discover says subscribe on the line");
    assert(_has(_run_plain(rsd, _mb("server/discover")), "subscribe") == 0, "updates: ...and not off it");
    assert(_has(_run(rsc, rsd, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-11-25\"}}"), "subscribe") == 0, "updates: the legacy initialize never says it");
    dispatcher_set_notifications(rsd, 1);
