    bote_listen_line_deliver(spc);
    assert(_has(_cap, "sp://secret") == 0 && _has(_cap, "sp://t/42") == 0 && _has(_cap, "sp://open"), "scopes: ...nor by an overflow, which still tells what it may read");
    dispatcher_register_resource(spd, resource_def_with_required_scopes(resource_def_new("sp://secret", "s", "S", "text/plain"), spsc), &h_res);
