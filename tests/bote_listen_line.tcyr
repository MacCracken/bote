    assert(_has(_cap, _upd("\"sp://secret\"", "\"wp\"")) && _has(_cap, _upd("\"sp://t/42\"", "\"wp\"")), "scopes: ...told of each it holds exactly");
    assert(_has(_cap, "sp://t/43") == 0, "scopes: ...not of one that requires the scope through a prefix");
    assert(_has(_cap, "sp://later") == 0, "scopes: ...nor of one whose scope came after the listen");
    _cap_reset();
    dispatcher_resource_updated(spd, _long_uri(0, 1025));
