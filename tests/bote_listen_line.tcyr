    bote_listen_line_attach(spc, spd, &_cap_write, 0);
    _cap_reset();
    codec_process_message_a(bote_listen_line_begin(spc), _lb("\"nt\"", spf), spd, 0);
    _cap_reset();
    dispatcher_resource_updated(spd, "sp://t/43");
    bote_listen_line_deliver(spc);
    assert(_has(_cap, _upd("\"sp://t/43\"", "\"nt\"")), "scopes: with no token, a prefix covers what it covers");
    bote_listen_line_detach(spc);
    _cap_reset();

    # The list a stream is judged by is the list it keeps: a registration between the two
    # looks leaves it with the one it was judged by, which then no longer serves (3.7.7).
    var fld = _mk_d(1);
    dispatcher_set_scope_check(fld, &_sc_flip, 0);
    var flread = vec_new();
    vec_push(flread, "p:read");
    _flip_list = vec_new();
    vec_push(_flip_list, "p:admin");
    _flip_d = fld;
    _flip_done = 0;
    dispatcher_register_resource(fld, resource_def_with_required_scopes(resource_def_new("fl://doc", "f", "F", "text/plain"), flread), &h_res);
    var fla = bote_req_begin();
    bote_req_set_listen_claims("token=p:read");
    var fls = alloc(BOTE_LISTEN_SLOT_BYTES);
    store64(fls + 280, 0);
    _bl_keep_uris(fla, fls, "{\"notifications\":{\"resourceSubscriptions\":[\"fl://doc\"]}}", fld);
    assert(_flip_done == 1 && load64(load64(fls + 280) + 1) == flread, "scopes: kept with the list it was judged by");
    assert_eq(_bl_slot_covers(fls, "fl://doc"), 0, "scopes: ...which no longer serves it, so it is not told");
    bote_req_begin();

    # Ids by value, and a value holding a NUL by its spelling (3.7.5).
    var ika = bote_req_begin();
    assert(streq(bote_id_key_a(ika, "\"\\u0000a\"", 9), bote_id_key_a(ika, "\"\\\\u0000a\"", 10)) == 0, "id: a NUL's escape is not the spelling of another's value");
    assert(streq(bote_id_key_a(ika, "\"a\\/b\"", 6), bote_id_key_a(ika, "\"a/b\"", 5)) == 1, "id: an escape is its value");
    assert(streq(bote_id_key_a(ika, "\"\\u0000a\"", 9), bote_id_key_a(ika, "\"\\u0000a\"", 9)) == 1, "id: ...and a NUL's, its spelling");
    assert(streq(bote_id_key_a(ika, "\"\\u0000a\"", 9), bote_id_key_a(ika, "\"\\u0000b\"", 9)) == 0, "id: two values that a NUL begins are two ids");
    assert(streq(bote_id_key_a(ika, "\"\\u0000a\"", 9), bote_id_key_a(ika, "\"\"", 2)) == 0, "id: ...and neither is the empty string");
    assert(streq(bote_id_key_a(ika, "7", 1), bote_id_key_a(ika, "\"7\"", 3)) == 0, "id: a number is not the string");

    # Bounds: BOTE_LISTEN_URIS of them, and what fits in BOTE_LISTEN_URI_ROOM.
    var rsmany = vec_new();
    var rsmi = 0;
    while (rsmi < 40) {
        vec_push(rsmany, _num("res://m/", rsmi));
        rsmi = rsmi + 1;
    }
    _run(rsc, rsd, _lb("\"r3\"", _uris_filter(rsmany)));
    assert(_has(_cap, "\"res://m/31\"") && _has(_cap, "\"res://m/32\"") == 0, "bound: 32 URIs honored, not 40");
    _run(rsc, rsd, _cancel("\"r3\""));
    _cap_reset();
    var rsbig = vec_new();
    rsmi = 0;
    while (rsmi < 5) {
        vec_push(rsbig, _long_uri(rsmi, 1000));
        rsmi = rsmi + 1;
    }
    vec_push(rsbig, _long_uri(6, 1025));
    vec_push(rsbig, "res://small");
    _run(rsc, rsd, _lb("\"r4\"", _uris_filter(rsbig)));
    assert_eq(_count(_cap, "res://"), 5, "bound: four of 1000 bytes fit the room, the fifth not, one past the longest not, and a short one after");
    assert(_has(_cap, "res://small"), "bound: ...the short one honored");
    _run(rsc, rsd, _cancel("\"r4\""));
    _cap_reset();
    var rslong = vec_new();
    vec_push(rslong, _long_uri(7, 1025));
    assert(_has(_run(rsc, rsd, _lb("\"r5\"", _uris_filter(rslong))), "") == 1 && _has(_cap, _ack("{}", "\"r5\"")), "bound: a URI past the longest alone is not honored");
    _cap_reset();
    # Where there are no resources, nothing is honored.
    var rsnd = _mk_d(0);
    var rsnc = bote_listen_line_new(2);
    bote_listen_line_attach(rsnc, rsnd, &_cap_write, 0);
    _run(rsnc, rsnd, _lb("\"n\"", "{\"resourceSubscriptions\":[\"file:///a\"]}"));
    assert(_has(_cap, _ack("{}", "\"n\"")) && _has(_cap, "\"resultType\":\"complete\""), "no resources: honored as nothing, and ended");
    bote_listen_line_detach(rsnc);
    _cap_reset();
    # Through the workers' serial sinks, the hook is kept.
    bote_conn_serial_sinks(rsd);
    assert(load64(dispatcher_event_sink(rsd) + 24) == &_bote_conn_updated_serial, "serial: the update hook kept");
    dispatcher_resource_updated(rsd, "file:///a");
    bote_listen_line_deliver(rsc);
    assert(_has(_cap, _upd("\"file:///a\"", "\"r1\"")), "serial: ...and an update through it");
    _cap_reset();
    # The heap: the room is made once a slot, and a delivery is built on the line's arena.
    var rsub = _lb("\"h\"", "{\"resourceSubscriptions\":[\"file:///h\",\"file:///h2\"]}");
    var rsuk = _cancel("\"h\"");
    _run(rsc, rsd, rsub);
    _run(rsc, rsd, rsuk);
    _cap_reset();
    var rsbefore = alloc_used();
    var rsui = 0;
    while (rsui < 10) {
        codec_process_message_a(bote_listen_line_begin(rsc), rsub, rsd, 0);
        codec_process_message_a(bote_listen_line_begin(rsc), rsuk, rsd, 0);
        _cap_reset();
        rsui = rsui + 1;
    }
    assert_eq((alloc_used() - rsbefore) / 10, 0, "heap: a listen with URIs and its cancel keep nothing, once its slot has a room");
    # Long enough, and often enough, that a delivery not rewinding the line's arena would
    # outgrow its first chunk.
    var rsuu = _cat3("file:///a/", _rep("d", 1000), "");
    dispatcher_resource_updated(rsd, rsuu);
    bote_listen_line_deliver(rsc);
    _cap_reset();
    rsbefore = alloc_used();
    rsui = 0;
    while (rsui < 100) {
        dispatcher_resource_updated(rsd, rsuu);
        bote_listen_line_deliver(rsc);
        _cap_reset();
        rsui = rsui + 1;
    }
    assert_eq((alloc_used() - rsbefore) / 100, 0, "heap: an update and its delivery keep nothing");
    # With nothing open, an update is kept for nobody.
    bote_listen_line_detach(rsc);
    dispatcher_resource_updated(rsd, "file:///a");
    assert(atomic_load(rsc + 112) == 0 && atomic_load(rsc + 32) == 0, "update: with none open, kept for nobody");

    # ---------------- waiting on two at once ----------------
    var wp[16];
    sys_socketpair(1, 1, 0, &wp);
    var wa = load32(&wp);
    var wb = load32(&wp + 4);
    bote_listen_line_attach(c, d, &_cap_write, 0);
    var t0 = clock_now_ms();
    assert_eq(bote_listen_line_wait(c, wa, clock_now_ms() + 60), 0, "wait: the deadline passes");
    assert(clock_now_ms() - t0 >= 55, "wait: ...not before it");
    assert_eq(bote_listen_line_wait(c, wa, clock_now_ms() - 1), 0, "wait: a deadline gone already");
    sys_write(wb, "x", 1);
    assert_eq(bote_listen_line_wait(c, wa, 0), 1, "wait: input");
    var drain[8];
    sys_read(wa, &drain, 1);
    _run(c, d, _lb("\"w\"", _TOOLS));
    _cap_reset();
    dispatcher_register_tool(d, _tool("t_wait"), &h_ok);
    assert_eq(bote_listen_line_wait(c, wa, clock_now_ms() + 1000), 2, "wait: a change");
    assert_eq(bote_listen_line_await(c, wa, clock_now_ms() + 60), 0, "await: writes it and waits on");
    assert(streq(_cap, _cat3(_note(_TL, "\"w\""), "\n", "")) == 1, "await: ...having written it");
    sys_close(wb);
    assert_eq(bote_listen_line_await(c, wa, 0), 1, "await: a closed peer is input");
    sys_close(wa);
    bote_listen_line_detach(c);
    _cap_reset();

    # ---------------- stdio, on a thread ----------------
    var sd = _mk_d(1);
    var sc = bote_listen_line_new(4);
    dispatcher_set_events(sd, bote_listen_sink(sc, 0));
    transport_stdio_with_listen(sc);
    var ip[8];
    var op[8];
    sys_pipe(&ip);
    sys_pipe(&op);
    _st_d = sd;
    _st_in = load32(&ip);
    _st_out = load32(&op + 4);
    var sw = load32(&ip + 4);
    var so = _rd_new(load32(&op));
    var st = thread_create(&_stdio_thread, 0);
    _send_line(sw, _lb("\"listen:1\"", _TOOLS));
    assert_eq(_rd_await(so, _ack("{\"toolsListChanged\":true}", "\"listen:1\""), 2000), 1, "stdio: the acknowledgement");
    _send_line(sw, "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/list\"}");
    assert_eq(_rd_await(so, "\"id\":3,\"result\"", 2000), 1, "stdio: a reply beside it");
    dispatcher_register_tool(sd, _tool("s_new"), &h_ok);
    assert_eq(_rd_await(so, _note(_TL, "\"listen:1\""), 2000), 1, "stdio: a change from another thread, written while the client is quiet");
    _send_line(sw, _cancel("\"listen:1\""));
    _send_line(sw, "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"tools/list\"}");
    assert_eq(_rd_await(so, "\"id\":4,\"result\"", 2000), 1, "stdio: the cancel read");
    dispatcher_register_tool(sd, _tool("s_after"), &h_ok);
    _send_line(sw, "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"tools/list\"}");
    assert_eq(_rd_await(so, "\"id\":5,\"result\"", 2000), 1, "stdio: still serving");
    assert_eq(_rd_count(so, _TL), 1, "stdio: nothing more for the cancelled one");
    sys_close(sw);
    thread_join(st);
    sys_close(_st_out);
    assert_eq(_rd_eof(so, 2000), 1, "stdio: ends at EOF");
    assert_eq(bote_listen_open(sc), 0, "stdio: its subscriptions with it");
    # Every line a whole message: one writer.
    var lines = _rd_buf(so);
    var lbad = 0;
    var ls = 0;
    var li = 0;
    var ln = strlen(lines);
    while (li < ln) {
        if (load8(lines + li) == 10) {
            if (jsonx_valid(lines + ls, li - ls) == 0) { lbad = lbad + 1; }
            ls = li + 1;
        }
        li = li + 1;
    }
    assert_eq(lbad, 0, "stdio: every line one whole message");

    # A client that closed its end of stdout (3.7.4): the loop ends, where SIGPIPE killed the
    # process.
    sys_pipe(&ip);
    sys_pipe(&op);
    _st_in = load32(&ip);
    _st_out = load32(&op + 4);
    sw = load32(&ip + 4);
    sys_close(load32(&op));
    st = thread_create(&_stdio_thread, 0);
    _send_line(sw, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"}");
    thread_join(st);
    assert(1 == 1, "stdio: a reply to a closed stdout ends the loop, and the process lives");
    sys_close(sw);
    sys_close(_st_out);

    # A listen whose acknowledgement cannot be written drops the connection, before the next
    # message is served (3.7.4).
    dispatcher_register_tool(sd, _tool("s_count"), &h_count);
    var lcall = "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"tools/call\",\"params\":{\"name\":\"s_count\"}}";
    sys_pipe(&ip);
    sys_pipe(&op);
    _st_in = load32(&ip);
    _st_out = load32(&op + 4);
    sw = load32(&ip + 4);
    sys_close(load32(&op));
    _ran = 0;
    var lboth = _cat3(_lb("\"lb\"", _TOOLS), "\n", lcall);
    _send_line(sw, lboth);
    st = thread_create(&_stdio_thread, 0);
    thread_join(st);
    assert_eq(_ran, 0, "broken: stdio drops before serving the next message");
    sys_close(sw);
    sys_close(_st_out);

    # Changes from four threads at once, beside the loop's own replies.
    sys_pipe(&ip);
    sys_pipe(&op);
    _st_in = load32(&ip);
    _st_out = load32(&op + 4);
    sw = load32(&ip + 4);
    so = _rd_new(load32(&op));
    _ch_d = sd;
    st = thread_create(&_stdio_thread, 0);
    _send_line(sw, _lb("\"many\"", _TOOLS));
    _rd_await(so, "acknowledged", 2000);
    _go = 0;
    var cts = alloc(32);
    var ci = 0;
    while (ci < 4) {
        store64(cts + ci * 8, thread_create(&_changer, ci));
        ci = ci + 1;
    }
    atomic_store(&_go, 1);
    var qi = 0;
    while (qi < 50) {
        _send_line(sw, "{\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"ping\"}");
        qi = qi + 1;
    }
    ci = 0;
    while (ci < 4) {
        thread_join(load64(cts + ci * 8));
        ci = ci + 1;
    }
    _send_line(sw, "{\"jsonrpc\":\"2.0\",\"id\":\"last\",\"method\":\"ping\"}");
    dispatcher_register_tool(sd, _tool("s_final"), &h_ok);
    assert_eq(_rd_await(so, "\"id\":\"last\",\"result\"", 5000), 1, "threads: every reply came");
    assert_eq(_rd_await_n(so, "\"id\":8,\"result\"", 50, 5000), 1, "threads: all fifty");
    sys_close(sw);
    thread_join(st);
    sys_close(_st_out);
    _rd_eof(so, 2000);
    assert(_rd_count(so, _note(_TL, "\"many\"")) >= 1, "threads: the changes were told");
    assert_eq(bote_listen_open(sc), 0, "stdio: a listen still open at EOF ends with the connection");
    lines = _rd_buf(so);
    lbad = 0;
    ls = 0;
    li = 0;
    ln = strlen(lines);
    while (li < ln) {
        if (load8(lines + li) == 10) {
            if (jsonx_valid(lines + ls, li - ls) == 0) { lbad = lbad + 1; }
            ls = li + 1;
        }
        li = li + 1;
    }
    assert_eq(lbad, 0, "threads: every line one whole message, with changes from four threads");
    # An update from another thread, over the real stdio loop (3.7.4).
    sys_pipe(&ip);
    sys_pipe(&op);
    _st_in = load32(&ip);
    _st_out = load32(&op + 4);
    sw = load32(&ip + 4);
    so = _rd_new(load32(&op));
    st = thread_create(&_stdio_thread, 0);
    _send_line(sw, _lb("\"ru\"", "{\"resourceSubscriptions\":[\"res://t/\"]}"));
    _rd_await(so, "acknowledged", 2000);
    _up_d = sd;
    _up_go = 0;
    var uts = alloc(32);
    ci = 0;
    while (ci < 4) {
        store64(uts + ci * 8, thread_create(&_updater, ci));
        ci = ci + 1;
    }
    atomic_store(&_up_go, 1);
    ci = 0;
    while (ci < 4) {
        thread_join(load64(uts + ci * 8));
        ci = ci + 1;
    }
    # 200 URIs through a queue of 16 overflow it whenever the writing thread falls behind, and
    # an update arriving overflowed is told as the URI the subscription holds, `res://t/`:
    # more than happened, never less. The last one is posted once the queue is taken, so it
    # is told as itself. (Posted at once, it failed on a two-core runner, 2 in 6 runs.)
    assert_eq(_line_taken(sc, 5000), 1, "stdio: the writing thread takes four threads' updates while the client is quiet");
    dispatcher_resource_updated(sd, "res://t/last");
    assert_eq(_rd_await(so, _upd("\"res://t/last\"", "\"ru\""), 5000), 1, "stdio: updates from four threads, written while the client is quiet");
    sys_close(sw);
    thread_join(st);
    sys_close(_st_out);
    _rd_eof(so, 2000);
    lines = _rd_buf(so);
    lbad = 0;
    ls = 0;
    li = 0;
    ln = strlen(lines);
    while (li < ln) {
        if (load8(lines + li) == 10) {
            if (jsonx_valid(lines + ls, li - ls) == 0) { lbad = lbad + 1; }
            ls = li + 1;
        }
        li = li + 1;
    }
    assert_eq(lbad, 0, "stdio: every update one whole line");
    assert(_rd_count(so, _UL) >= 2, "stdio: the updates told");
    transport_stdio_with_listen(0);

    # ---------------- a Unix connection, on a thread ----------------
    var ud = _mk_d(0);
    var uc = bote_listen_line_new(4);
    dispatcher_set_events(ud, bote_listen_sink(uc, 0));
    transport_unix_with_listen(uc);
    var up[16];
    sys_socketpair(1, 1, 0, &up);
    _ux_d = ud;
    _ux_fd = load32(&up);
    var ucl = load32(&up + 4);
    var ur = _rd_new(ucl);
    var ut = thread_create(&_unix_thread, 0);
    _send_line(ucl, _lb("\"u\"", _TOOLS));
    assert_eq(_rd_await(ur, _ack("{\"toolsListChanged\":true}", "\"u\""), 2000), 1, "unix: the acknowledgement");
    dispatcher_register_tool(ud, _tool("u_new"), &h_ok);
    assert_eq(_rd_await(ur, _note(_TL, "\"u\""), 2000), 1, "unix: a change while the client is quiet");
    _send_line(ucl, _cancel("\"u\""));
    _send_line(ucl, "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\"}");
    assert_eq(_rd_await(ur, "\"id\":2,\"result\"", 2000), 1, "unix: served after the cancel");
    sys_close(ucl);
    thread_join(ut);
    sys_close(_ux_fd);
    assert_eq(bote_listen_open(uc), 0, "unix: its subscriptions end with the connection");
    # A failed acknowledgement drops the connection before the next message (3.7.4).
    dispatcher_register_tool(ud, _tool("u_count"), &h_count);
    sys_socketpair(1, 1, 0, &up);
    _ux_fd = load32(&up);
    ucl = load32(&up + 4);
    sock_shutdown(_ux_fd, 1);
    _ran = 0;
    _send_line(ucl, _cat3(_lb("\"ub\"", _TOOLS), "\n", "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"tools/call\",\"params\":{\"name\":\"u_count\"}}"));
    ut = thread_create(&_unix_thread, 0);
    thread_join(ut);
    assert_eq(_ran, 0, "broken: unix drops before serving the next message");
    sys_close(_ux_fd);
    sys_close(ucl);
    # The idle deadline counts from what the client last sent, not from the changes.
    BOTE_UNIX_IDLE_MS = 300;
    sys_socketpair(1, 1, 0, &up);
    _ux_fd = load32(&up);
    ucl = load32(&up + 4);
    ur = _rd_new(ucl);
    ut = thread_create(&_unix_thread, 0);
    _send_line(ucl, _lb("\"idle\"", _TOOLS));
    _rd_await(ur, "acknowledged", 2000);
    var it0 = clock_now_ms();
    _ux_done = 0;
    var ik = 0;
    while (ik < 20 && atomic_load(&_ux_done) == 0) {
        dispatcher_register_tool(ud, _tool(_num("u_idle_", ik)), &h_ok);
        _rd_await(ur, "\x01\x02", 50);
        ik = ik + 1;
    }
    thread_join(ut);
    sys_close(_ux_fd);
    assert(atomic_load(&_ux_done) != 0, "idle: a client that sends nothing is closed, changes or not");
    var iel = atomic_load(&_ux_done) - it0;
    assert(iel >= 250 && iel < 900, "idle: ...at the deadline");
    assert(_rd_count(ur, _note(_TL, "\"idle\"")) >= 2, "idle: the changes went out meanwhile");
    sys_close(ucl);
    # A client that sends something late has its deadline counted from then.
    sys_socketpair(1, 1, 0, &up);
    _ux_fd = load32(&up);
    ucl = load32(&up + 4);
    ur = _rd_new(ucl);
    _ux_done = 0;
    it0 = clock_now_ms();
    ut = thread_create(&_unix_thread, 0);
    _send_line(ucl, _lb("\"late\"", _TOOLS));
    _rd_await(ur, "acknowledged", 2000);
    sleep_ms(200);
    _send_line(ucl, "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"ping\"}");
    _rd_await(ur, "\"id\":3", 2000);
    thread_join(ut);
    sys_close(_ux_fd);
    sys_close(ucl);
    iel = atomic_load(&_ux_done) - it0;
    assert(iel >= 450 && iel < 1200, "idle: counted from the client's last line, not its first");
    BOTE_UNIX_IDLE_MS = 0;
    transport_unix_with_listen(0);

    # ---------------- a WebSocket, on a thread ----------------
    var wd = _mk_d(0);
    var wc = bote_listen_line_new(4);
    dispatcher_set_events(wd, bote_listen_sink(wc, 0));
    _ws_cfg = ws_config_new("/mcp", 0, 0);
    store64(_ws_cfg + 40, wd);
    ws_config_with_bearer_validator(_ws_cfg, &_ws_tok, 0);
    ws_config_with_listen(_ws_cfg, wc);
    _ws_req = "GET /mcp HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nAuthorization: Bearer wtok\r\n\r\n";
    var wsp[16];
    sys_socketpair(1, 1, 0, &wsp);
    _ws_fd = load32(&wsp);
    var wcl = load32(&wsp + 4);
    var wr = _rd_new(wcl);
    _ws_ok = 1;
    var keep_recheck = BOTE_WS_RECHECK_MS;
    BOTE_WS_RECHECK_MS = 0;
    var wt = thread_create(&_ws_thread, 0);
    assert_eq(_rd_await(wr, "\r\n\r\n", 2000), 1, "ws: upgraded");
    _ws_send(wcl, _lb("\"ws1\"", _TOOLS));
    assert_eq(_rd_await(wr, _ack("{\"toolsListChanged\":true}", "\"ws1\""), 2000), 1, "ws: the acknowledgement, a frame");
    dispatcher_register_tool(wd, _tool("w_new"), &h_ok);
    assert_eq(_rd_await(wr, _note(_TL, "\"ws1\""), 2000), 1, "ws: a change while the client is quiet");
    var before_deny = load64(wr + 16);
    _ws_ok = 0;
    dispatcher_register_tool(wd, _tool("w_denied"), &h_ok);
    assert_eq(_rd_await(wr, "token no longer valid", 2000), 1, "ws: a token that no longer holds ends the connection before a change goes out");
    thread_join(wt);
    var wbuf = _rd_buf(wr);
    assert(memeq(wbuf + before_deny, "\x88", 1) == 1, "ws: ...with a close frame");
    assert(memeq(wbuf + before_deny + 2, "\x03\xf0", 2) == 1, "ws: ...code 1008");
    assert(_has(wbuf + before_deny, "token no longer valid"), "ws: ...and its reason");
    assert_eq(_rd_count(wr, _TL), 1, "ws: and no change after the token failed");
    sys_close(_ws_fd);
    sys_close(wcl);
    assert_eq(bote_listen_open(wc), 0, "ws: its subscriptions end with the connection");
    BOTE_WS_RECHECK_MS = keep_recheck;
    # A failed acknowledgement drops the connection before the next frame is served (3.7.4).
    dispatcher_register_tool(wd, _tool("w_count"), &h_count);
    sys_socketpair(1, 1, 0, &wsp);
    _ws_fd = load32(&wsp);
    wcl = load32(&wsp + 4);
    wr = _rd_new(wcl);
    _ws_ok = 1;
    wt = thread_create(&_ws_thread, 0);
    _rd_await(wr, "\r\n\r\n", 2000);
    sock_shutdown(_ws_fd, 1);
    _ran = 0;
    _ws_send(wcl, _lb("\"wb\"", _TOOLS));
    _ws_send(wcl, "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"tools/call\",\"params\":{\"name\":\"w_count\"}}");
    thread_join(wt);
    assert_eq(_ran, 0, "broken: ws drops before serving the next frame");
    sys_close(_ws_fd);
    sys_close(wcl);

    # A ping does not stop the changes (3.7.4): the loop waits on its line again after it.
    _ws_ok = 1;
    sys_socketpair(1, 1, 0, &wsp);
    _ws_fd = load32(&wsp);
    wcl = load32(&wsp + 4);
    wr = _rd_new(wcl);
    wt = thread_create(&_ws_thread, 0);
    _rd_await(wr, "\r\n\r\n", 2000);
    _ws_send(wcl, _lb("\"wp\"", _TOOLS));
    _rd_await(wr, "acknowledged", 2000);
    _ws_ping(wcl);
    assert_eq(_rd_await(wr, "\x8a\x02hi", 2000), 1, "ws ping: answered");
    dispatcher_register_tool(wd, _tool("w_after_ping"), &h_ok);
    assert_eq(_rd_await_n(wr, _note(_TL, "\"wp\""), 1, 2000), 1, "ws ping: a change after it goes out with no frame from the client");
    # What judging the token puts on the arena goes with each judgement.
    ws_config_with_bearer_validator(_ws_cfg, &_ws_tok_spend, 0);
    BOTE_WS_RECHECK_MS = 0;
    # 64 KB a judgement, fifty of them: more than the arena, which earlier cases grew, holds.
    _ws_spend = 65536;
    dispatcher_register_tool(wd, _tool("w_spend_0"), &h_ok);
    _rd_await_n(wr, _note(_TL, "\"wp\""), 2, 2000);
    var wab = bote_req_arena_bytes(bote_req_alloc());
    var wsi = 1;
    while (wsi <= 50) {
        dispatcher_register_tool(wd, _tool(_num("w_spend_", wsi)), &h_ok);
        _rd_await_n(wr, _note(_TL, "\"wp\""), 2 + wsi, 2000);
        wsi = wsi + 1;
    }
    assert_eq(_rd_count(wr, _note(_TL, "\"wp\"")), 52, "ws arena: every change delivered");
    assert_eq(bote_req_arena_bytes(bote_req_alloc()), wab, "ws arena: fifty judgements between frames leave it as it was");
    _ws_spend = 0;
    BOTE_WS_RECHECK_MS = keep_recheck;
    ws_config_with_bearer_validator(_ws_cfg, &_ws_tok, 0);
    sys_close(wcl);
    thread_join(wt);
    sys_close(_ws_fd);

    # The idle deadline, with changes going out: from the client's last frame.
    _ws_ok = 1;
    ws_config_with_idle_ms(_ws_cfg, 300);
    sys_socketpair(1, 1, 0, &wsp);
    _ws_fd = load32(&wsp);
    wcl = load32(&wsp + 4);
    wr = _rd_new(wcl);
    _ws_done = 0;
    var wt0 = clock_now_ms();
    wt = thread_create(&_ws_thread, 0);
    _rd_await(wr, "\r\n\r\n", 2000);
    _ws_send(wcl, _lb("\"wi\"", _TOOLS));
    _rd_await(wr, "acknowledged", 2000);
    sleep_ms(200);
    _ws_send(wcl, "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"ping\"}");
    _rd_await(wr, "\"id\":3", 2000);
    var wk = 0;
    while (wk < 30 && atomic_load(&_ws_done) == 0) {
        dispatcher_register_tool(wd, _tool(_num("w_idle_", wk)), &h_ok);
        _rd_await(wr, "\x01\x02", 50);
        wk = wk + 1;
    }
    thread_join(wt);
    sys_close(_ws_fd);
    sys_close(wcl);
    var wel = atomic_load(&_ws_done) - wt0;
    assert(atomic_load(&_ws_done) != 0 && wel >= 450 && wel < 1200, "ws idle: closed at the deadline from the client's last frame, changes or not");
    assert(_rd_count(wr, _note(_TL, "\"wi\"")) >= 2, "ws idle: the changes went out meanwhile");
    ws_config_with_idle_ms(_ws_cfg, 0);
    #endif
    return assert_summary();
}

var rc = main();
sys_exit_group(rc);
