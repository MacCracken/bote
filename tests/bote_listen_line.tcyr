    dispatcher_register_resource(spd, resource_def_with_required_scopes(resource_def_new("sp://secret", "s", "S", "text/plain"), spother), &h_res);
    dispatcher_register_resource(spd, resource_def_with_required_scopes(resource_def_new("sp://t/42", "f", "F", "text/plain"), spother), &h_res);
    _cap_reset();
