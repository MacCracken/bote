    assert(_has(_cap, "\"resourceSubscriptions\":[\"sp://secret\",\"sp://t/42\",\"sp:/\",\"sp://open\",\"sp://later\"]"), "scopes: a token with the scope is honored them all");
    # A scope that comes to a URI after the listen is not the listen's.
