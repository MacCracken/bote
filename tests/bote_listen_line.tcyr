    store64(kjs + 280, 0);
    assert_eq(_bl_keep_uris(kja, kjs, "{\"notifications\":{\"resourceSubscriptions\":[\"sp://secret\",\"sp://open\"]}}", spd), 1, "scopes: kept, judged again: not what the claims may not read");
    assert_eq(load64(kjs + 312), 1, "scopes: ...and the stream marked as made with claims");
    bote_req_set_listen_claims("token=p:secret");
    assert_eq(_bl_keep_uris(kja, kjs, "{\"notifications\":{\"resourceSubscriptions\":[\"sp://secret\",\"sp://open\"]}}", spd), 2, "scopes: ...all of it, for claims that hold the scope");
    assert(load8(load64(kjs + 280)) == 1 && load8(load64(kjs + 280) + 21) == 0, "scopes: ...the scoped one flagged, the open one not");
    assert(load64(load64(kjs + 280) + 1) == spsc && load64(load64(kjs + 280) + 22) == 0, "scopes: ...with the scopes it was judged by (3.7.6)");
    bote_req_begin();
