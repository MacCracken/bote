    assert(_has(_cap, _upd("\"sp://secret\"", "\"wp\"")) && _has(_cap, "sp://later") == 0, "scopes: an overflow tells it what it holds, and not that one");
    # What serves a URI registered again (3.7.6, the 3.7.5 review): with the same scopes it is
    # told still; with another scope, which the token may lack, it is not, nor is a template's
    # URI a resource now serves with another scope, and an overflow tells neither.
    dispatcher_register_resource(spd, resource_def_with_required_scopes(resource_def_new("sp://secret", "s", "S", "text/plain"), spsc), &h_res);
    _cap_reset();
    dispatcher_resource_updated(spd, "sp://secret");
    bote_listen_line_deliver(spc);
