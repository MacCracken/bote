    var spsc = vec_new();
    vec_push(spsc, "p:secret");
    dispatcher_register_resource(spd, resource_def_with_required_scopes(resource_def_new("sp://secret", "s", "S", "text/plain"), spsc), &h_res);
    dispatcher_register_resource_template(spd, resource_template_with_required_scopes(resource_template_new("sp://t/{id}", "t", "T", "text/plain"), spsc), &h_res);
    dispatcher_register_resource(spd, resource_def_new("sp://open", "o", "O", "text/plain"), &h_res);
    var spc = bote_listen_line_new(4);
    dispatcher_set_events(spd, bote_listen_sink(spc, 0));
