    assert(streq(_cap, _cat3(_ack("{\"resourceSubscriptions\":[\"file:///a\",\"file:///dir/\",\"res://q?x=\\\"1\\\"\"]}", "\"r1\""), "\n", "")) == 1, "ack: the honored URIs, and only them");
    _cap_reset();
    _run(rsc, rsd, _lb("\"r2\"", "{\"toolsListChanged\":true,\"resourceSubscriptions\":[\"file:///other\"]}"));
    assert(_has(_cap, "{\"toolsListChanged\":true,\"resourceSubscriptions\":[\"file:///other\"]}"), "ack: beside a list's change");
    _cap_reset();
    assert_eq(dispatcher_resource_updated(rsd, "file:///a"), 0, "update: told");
    assert_eq(_next_updates, 1, "update: passed on to the next sink");
    assert(streq(_next_last, "file:///a") == 1, "update: ...naming it");
    bote_listen_line_deliver(rsc);
    assert(streq(_cap, _cat3(_upd("\"file:///a\"", "\"r1\""), "\n", "")) == 1, "update: to the subscription to it, stamped, and no other");
    _cap_reset();
    dispatcher_resource_updated(rsd, "file:///dir/x/y");
    dispatcher_resource_updated(rsd, "file:///a/b");
    dispatcher_resource_updated(rsd, "file:///a?v=2");
    dispatcher_resource_updated(rsd, "file:///a#f");
    dispatcher_resource_updated(rsd, "file:///ab");
    dispatcher_resource_updated(rsd, "file:///di");
    dispatcher_resource_updated(rsd, "res://q?x=\"1\"");
    bote_listen_line_deliver(rsc);
    assert(_has(_cap, _upd("\"file:///dir/x/y\"", "\"r1\"")), "cover: anything under a URI that ends in /");
    assert(_has(_cap, _upd("\"file:///a/b\"", "\"r1\"")), "cover: a path under it");
    assert(_has(_cap, _upd("\"file:///a?v=2\"", "\"r1\"")), "cover: its query");
    assert(_has(_cap, _upd("\"file:///a#f\"", "\"r1\"")), "cover: its fragment");
    assert(_has(_cap, "file:///ab") == 0 && _has(_cap, "file:///di\"") == 0, "cover: not a URI that only begins the same");
    assert(_has(_cap, _upd("\"res://q?x=\\\"1\\\"\"", "\"r1\"")), "cover: a URI escaped where it goes out");
    assert_eq(_count(_cap, _UL), 5, "cover: five, in all");
    _cap_reset();
    dispatcher_resource_updated(rsd, "file:///other");
    dispatcher_resource_updated(rsd, "file:///other");
    bote_listen_line_deliver(rsc);
