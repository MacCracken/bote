# bote_core_only_smoke.tcyr — drift guard for the opt-in core bundle.
#
# Includes ONLY dist/bote-core.cyr (the 12-module transport-free profile)
# plus the minimal stdlib auto-injected by cyrius. If a future bote
# change wires a core-module symbol against a transport-module helper,
# the core bundle silently regresses and consumers that adopted the
# opt-in profile break. This test catches that drift at CI time.
#
# Run: cyrius test tests/bote_core_only_smoke.tcyr
#
# 2.7.2: lands with the opt-in profile. See
# docs/development/issues/archive/2026-05-10-opt-in-transport-profile.md.

include "dist/bote-core.cyr"

# Test handler: echoes args verbatim.
fn h_echo(args, claims) {
    return args;
}

# Naive substring search over two NUL-terminated cstrs. Returns 1 if
# `needle` occurs in `hay`, else 0.
#
# Hand-rolled on purpose: this file includes ONLY dist/bote-core.cyr plus
# the stdlib cyrius auto-injects, and pulling in an assert/str helper for
# one predicate would weaken the very thing the file is guarding — that
# the core bundle stands up with nothing else linked.
fn _smoke_has(hay, needle) {
    if (hay == 0 || needle == 0) { return 0; }
    var i = 0;
    while (load8(hay + i) != 0) {
        var j = 0;
        while (load8(needle + j) != 0 && load8(hay + i + j) == load8(needle + j)) {
            j = j + 1;
        }
        if (load8(needle + j) == 0) { return 1; }
        i = i + 1;
    }
    # An empty needle trivially matches; keep that consistent for i==0.
    if (load8(needle) == 0) { return 1; }
    return 0;
}

fn main() {
    alloc_init();
    fl_init();

    # Exercise every public surface that consumers of the opt-in core
    # bundle reach for: tool_registry_new, schema_new, tool_def_new,
    # registry_register, dispatcher_new, dispatcher_handle. (Drift
    # detection here is "did it link", not "did it dispatch a JSON-RPC
    # round-trip" — dispatcher_dispatch pulls in codec/jsonx paths
    # that exercise more of the bundle but also depend on stdlib
    # finalisers we don't want to touch in a smoke test.)
    var reg = tool_registry_new();
    if (reg == 0) { return 1; }

    var sch = schema_new("object", 0, vec_new());
    if (sch == 0) { return 2; }

    registry_register(reg, tool_def_new("echo", "echo handler", sch));
    if (registry_contains(reg, "echo") == 0) { return 3; }

    var disp = dispatcher_new(reg);
    if (disp == 0) { return 4; }

    dispatcher_handle(disp, "echo", &h_echo);

    # --- content.cyr, added to [lib.core] at 3.3.6 ---
    #
    # This is the surface core-profile consumers were hand-rolling with a
    # raw str_builder before it shipped here. The guard is deliberately
    # stronger than "did it link": it checks the emitted BYTES, because the
    # whole reason content.cyr belongs in core is that consumers were
    # re-implementing JSON escaping themselves. If escaping regresses, a
    # link-only check would not notice.
    var ct = content_text("hi");
    if (ct == 0) { return 5; }

    # A quote and a backslash must come back escaped, not raw.
    var esc = content_text_response("a\"b\\c");
    if (esc == 0) { return 6; }
    if (_smoke_has(esc, "a\\\"b\\\\c") == 0) { return 7; }

    # The error variant carries the isError discriminator; the success
    # variant deliberately omits the field entirely rather than emitting
    # "isError":false, so assert the ABSENCE too — a regression that
    # started emitting it would still contain "{\"content\":[".
    var blocks = vec_new();
    vec_push(blocks, content_text("x"));
    var ok_arr = content_array(blocks);
    if (_smoke_has(ok_arr, "{\"content\":[") == 0) { return 8; }
    if (_smoke_has(ok_arr, "isError") == 1) { return 9; }
    var err_arr = content_array_error(blocks);
    if (_smoke_has(err_arr, "\"isError\":true") == 0) { return 10; }

    # Inline exit to avoid stdlib finalisers (libro / majra are
    # auto-injected by cyrius.cyml [deps] even though the core bundle
    # doesn't reference them, and their teardown trips the heap
    # heisenbug documented in tests/bote.tcyr).
    syscall(SYS_EXIT, 0);
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
