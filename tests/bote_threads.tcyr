include "src/fs_tools.cyr"
include "tests/fixtures/jwt_vectors.cyr"

#ifndef CYRIUS_TARGET_AGNOS

var _go = 0;
var _n = 0;

fn _wait_go() {
    while (atomic_load(&_go) == 0) { }
    return 0;
}


# (3.8.9) The heap forms' scratch on several threads: each thread judges its own values
# through compiled_validate, and every answer must be its own, whole, the lock holding.
var _sc_comp = 0;
var _sc_bad = 0;
fn _sc_worker(i) {
    while (atomic_load(&_go) == 0) { }
    var k = 0;
    while (k < 300) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "{\"n\":\"t");
        str_builder_add_int(sb, i);
        str_builder_add_cstr(sb, "_");
        str_builder_add_int(sb, k);
        str_builder_add_cstr(sb, "\",\"l\":[1,1]}");
        var v = compiled_validate(_sc_comp, str_data(str_builder_build(sb)));
        if (vec_len(v) != 2) { atomic_fetch_add(&_sc_bad, 1); }
        elif (streq(vec_get(v, 0), "n: expected integer") == 0 || streq(vec_get(v, 1), "l: items 0 and 1 are equal, against uniqueItems") == 0) { atomic_fetch_add(&_sc_bad, 1); }
        k = k + 1;
    }
    return 0;
}

# Run `fp(i)` on `n` threads, i from 0, started together, and wait for them all.
fn _on_threads(fp, n) {
    _go = 0;
    var ts = alloc(n * 8);
    var i = 0;
    while (i < n) {
        store64(ts + i * 8, thread_create(fp, i));
        i = i + 1;
    }
    atomic_store(&_go, 1);
    i = 0;
    while (i < n) {
        thread_join(load64(ts + i * 8));
        i = i + 1;
    }
    return 0;
}

fn _cat3(a, b, c) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    str_builder_add_cstr(sb, c);
    return str_data(str_builder_build(sb));
}

fn _has(hay, needle) { return strstr(hay, needle) >= 0; }

# ---- each thread's request state ---------------------------------------------
var _rs_arena = 0;
var _rs_state = 0;
var _rs_noted = 0;
var _rs_tok_ok = 0;

var _rs_armed = 0;
var _rs_arm_state = 0;

# Arms from a thread that is not the main one, which then has no thread-local block.
fn _rs_arm(i) {
    _rs_armed = bote_conn_arm();
    _rs_arm_state = bote_req_state();
    return 0;
}

fn _rs_worker(i) {
    _wait_go();
    store64(_rs_arena + i * 8, bote_req_alloc());
    store64(_rs_state + i * 8, bote_req_state());
    bote_req_begin();
    var t = alloc_via(bote_req_alloc(), 16);
    store64(t, 1000 + i);
    store8(t + 8, 0);
    bote_req_note_token(t);
    _bf_why("thread");
    # Every thread notes its token before any reads one back.
    atomic_fetch_add(&_rs_noted, 1);
    while (atomic_load(&_rs_noted) < _n) { }
    if (bote_req_token() == t && load64(bote_req_token()) == 1000 + i && bote_req_kept() == 0) {
        atomic_fetch_add(&_rs_tok_ok, 1);
    }
    return 0;
}

# 1 when the n words at p differ from each other and from `other`.
fn _all_apart(p, n, other) {
    var i = 0;
    while (i < n) {
        if (load64(p + i * 8) == 0 || load64(p + i * 8) == other) { return 0; }
        var j = i + 1;
        while (j < n) {
            if (load64(p + i * 8) == load64(p + j * 8)) { return 0; }
            j = j + 1;
        }
        i = i + 1;
    }
    return 1;
}

# ---- the session store -------------------------------------------------------
var _ss_store = 0;
var _ss_bad = 0;

fn _ss_worker(i) {
    _wait_go();
    var k = 0;
    while (k < 400) {
        var sid = session_store_create(_ss_store, "2025-11-25");
        if (sid == 0 || session_store_validate(_ss_store, sid) == 0) { atomic_fetch_add(&_ss_bad, 1); }
        k = k + 1;
    }
    return 0;
}

# ---- a session's outbound bundle, and publishing beside draining ---------------
var _so_sess = 0;
var _so_got = 0;

fn _so_worker(i) {
    _wait_go();
    store64(_so_got + i * 8, _strm_session_outbound(_so_sess));
    return 0;
}

var _pd_store = 0;
var _pd_sid = 0;
var _pd_bad = 0;
var _pd_stop = 0;
var _pd_drains = 0;

var _pd_torn = 0;

# The number after "evt-".
fn _pd_num(id) {
    var n = 0;
    var i = 4;
    while (load8(id + i) >= 48 && load8(id + i) <= 57) {
        n = n * 10 + load8(id + i) - 48;
        i = i + 1;
    }
    return n;
}

# A drain is what the buffer held at one moment: its ids run one after another, with none
# repeated and none missed, which a copy made while another thread pushes does not keep.
fn _pd_drainer(i) {
    _wait_go();
    var sess = session_store_validate(_pd_store, _pd_sid);
    var buf = session_outbound_buffer(_strm_session_outbound(sess));
    while (atomic_load(&_pd_stop) == 0) {
        bote_req_begin();
        var ev = _strm_drain_events_a(bote_req_alloc(), _pd_store, buf, 0);
        var j = 0;
        var prev = 0 - 1;
        while (j < vec_len(ev)) {
            var e = vec_get(ev, j);
            if (e == 0 || memeq(stream_event_id(e), "evt-", 4) == 0) {
                atomic_fetch_add(&_pd_bad, 1);
            } else {
                var n = _pd_num(stream_event_id(e));
                if (prev >= 0 && n != prev + 1) { atomic_fetch_add(&_pd_torn, 1); }
                prev = n;
            }
            j = j + 1;
        }
        atomic_fetch_add(&_pd_drains, 1);
    }
    return 0;
}

# Makes sessions while the publisher walks them.
fn _pd_creator(i) {
    _wait_go();
    while (atomic_load(&_pd_stop) == 0) {
        session_store_create(_pd_store, "2025-11-25");
        var k = 0;
        while (k < 2000) { k = k + 1; }
    }
    return 0;
}

fn _pd_publisher(i) {
    _wait_go();
    var k = 0;
    while (k < 1500) {
        _strm_notify_publish(_pd_store, TOPIC_TOOL_REGISTERED(), "{}");
        k = k + 1;
    }
    atomic_store(&_pd_stop, 1);
    return 0;
}

fn _pd_run(i) {
    if (i == 0) { return _pd_publisher(i); }
    if (i == 1) { return _pd_creator(i); }
    return _pd_drainer(i);
}

# ---- sinks that take their turn ------------------------------------------------
var _snk_in = 0;
var _snk_overlap = 0;
var _snk_calls = 0;
var _snk_d = 0;
var _snk_msg = 0;

fn _snk_log(ctx, ev) {
    if (atomic_fetch_add(&_snk_in, 1) != 0) { _snk_overlap = 1; }
    var k = 0;
    while (k < 2000) { k = k + 1; }
    atomic_fetch_add(&_snk_calls, 1);
    atomic_fetch_add(&_snk_in, 0 - 1);
    return 0;
}

fn _snk_publish(ctx, topic, payload) { return 0; }
fn _snk_tool(args, claims) { return "{}"; }

fn _snk_worker(i) {
    _wait_go();
    var k = 0;
    while (k < 250) {
        codec_process_message_a(bote_req_begin(), _snk_msg, _snk_d, 0);
        k = k + 1;
    }
    return 0;
}

# ---- a JwtSecret: refresh and cache --------------------------------------------
var _jt_now = 1800000000;
var _jt_calls = 0;
var _jt_doc = 0;
var _jt_s = 0;
var _jt_tok = 0;
var _jt_good = 0;
var _jt_bad = 0;
var _jt_expired = 0;

fn _jt_clock() { return atomic_load(&_jt_now); }

# A source that is slow to answer, as a jwks_uri is, and counts each ask.
fn _jt_src(ctx, why_out) {
    atomic_fetch_add(&_jt_calls, 1);
    sleep_ms(30);
    return _jt_doc;
}

fn _jt_ask_worker(i) {
    _wait_go();
    bote_req_begin();
    auth_validator_jwt(_jt_tok, _jt_s);
    return 0;
}

fn _mint_hs256(hdr_json, payload_json, key) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, base64url_encode(hdr_json, strlen(hdr_json)));
    str_builder_add_cstr(sb, ".");
    str_builder_add_cstr(sb, base64url_encode(payload_json, strlen(payload_json)));
    var signing_input = str_cstr(str_builder_build(sb));
    var mac = alloc(32);
    hmac_sha256(key, strlen(key), signing_input, strlen(signing_input), mac);
    var sb2 = str_builder_new();
    str_builder_add_cstr(sb2, signing_input);
    str_builder_add_cstr(sb2, ".");
    str_builder_add_cstr(sb2, base64url_encode(mac, 32));
    return str_cstr(str_builder_build(sb2));
}

var _hc_toks = 0;

fn _hc_worker(i) {
    _wait_go();
    var k = 0;
    while (k < 300) {
        bote_req_begin();
        var t = load64(_hc_toks + ((k + i * 7) % 16) * 8);
        if (auth_validator_jwt(t, _jt_s) == t) { atomic_fetch_add(&_jt_good, 1); }
        else { atomic_fetch_add(&_jt_bad, 1); }
        if (k % 10 == 0) {
            bote_req_begin();
            if (auth_validator_jwt(_jt_tok, _jt_s) != 0) { atomic_fetch_add(&_jt_expired, 1); }
        }
        k = k + 1;
    }
    return 0;
}

# ---- a fork while another thread holds an allocator's lock -----------------------
var _fk_stop = 0;

# Holds lib/alloc.cyr's lock half the time, as a thread that allocates a great deal does.
fn _fk_hold_alloc(i) {
    while (atomic_load(&_fk_stop) == 0) {
        _alloc_lock_acquire();
        var k = 0;
        while (k < 300) { k = k + 1; }
        _alloc_lock_release();
        k = 0;
        while (k < 300) { k = k + 1; }
    }
    return 0;
}

fn _fk_hold_fl(i) {
    while (atomic_load(&_fk_stop) == 0) {
        _fl_lock_acquire();
        var k = 0;
        while (k < 300) { k = k + 1; }
        _fl_lock_release();
        k = 0;
        while (k < 300) { k = k + 1; }
    }
    return 0;
}

fn _fk_child_alloc(ctx, r) {
    var p = alloc(64);
    store64(p, 77);
    bote_fetch_put_int(r, load64(p));
    return 0;
}

fn _fk_child_fl(ctx, r) {
    var p = fl_alloc(64);
    store64(p, 78);
    bote_fetch_put_int(r, load64(p));
    return 0;
}

# How many of `n` fetches of `fp` came back with `want`.
fn _fk_rounds(fp, want, n) {
    var ok = 0;
    var i = 0;
    while (i < n) {
        bote_req_begin();
        var cur[24];
        if (bote_fetch_in_child(fp, 0, 4096, 3000, &cur) == 1 && bote_fetch_int(&cur) == want) { ok = ok + 1; }
        i = i + 1;
    }
    return ok;
}

# ---- the streamable handler on threads -----------------------------------------
var _sh_cfg = 0;
var _sh_ok = 0;
var _sh_bad = 0;

fn _sh_echo(args, claims) { return args; }

fn _sh_raw(hdrs, body) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "POST /mcp HTTP/1.1\r\nHost: x\r\nAccept: application/json\r\n");
    str_builder_add_cstr(sb, hdrs);
    str_builder_add_cstr(sb, "Content-Length: ");
    str_builder_add_int(sb, strlen(body));
    str_builder_add_cstr(sb, "\r\n\r\n");
    str_builder_add_cstr(sb, body);
    return str_data(str_builder_build(sb));
}

# The reply to `raw` from _strm_handle, read into `rcv`, NUL-ended.
fn _sh_run(raw, rbuf, rcv) {
    var n = strlen(raw);
    memcpy(rbuf, raw, n);
    store8(rbuf + n, 0);
    var sp[16];
    sys_socketpair(1, 1, 0, &sp);
    var sa = load32(&sp);
    var sb = load32(&sp + 4);
    _strm_handle(_sh_cfg, sa, rbuf, n);
    sys_close(sa);
    var got = 0;
    var r = sys_read(sb, rcv, 65536);
    while (r > 0) {
        got = got + r;
        r = sys_read(sb, rcv + got, 65536 - got);
    }
    sys_close(sb);
    store8(rcv + got, 0);
    return got;
}

fn _sh_worker(i) {
    _wait_go();
    var rbuf = alloc(70000);
    var rcv = alloc(65600);
    var init = _sh_raw("", "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-11-25\",\"capabilities\":{},\"clientInfo\":{\"name\":\"t\",\"version\":\"1\"}}}");
    var k = 0;
    while (k < 120) {
        _sh_run(init, rbuf, rcv);
        var at = strstr(rcv, "MCP-Session-Id: ");
        if (memeq(rcv, "HTTP/1.1 200", 12) == 0 || at < 0) {
            atomic_fetch_add(&_sh_bad, 1);
        } else {
            var sid = alloc(40);
            memcpy(sid, rcv + at + 16, 32);
            store8(sid + 32, 0);
            var sb = str_builder_new();
            str_builder_add_cstr(sb, "w");
            str_builder_add_int(sb, i * 100000 + k);
            str_builder_add_cstr(sb, "-mark");
            var mark = str_data(str_builder_build(sb));
            var call = _sh_raw(_cat3("MCP-Session-Id: ", sid, "\r\n"),
              _cat3("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"t_echo\",\"arguments\":{\"m\":\"", mark, "\"}}}"));
            _sh_run(call, rbuf, rcv);
            if (memeq(rcv, "HTTP/1.1 200", 12) == 1 && _has(rcv, mark) == 1) { atomic_fetch_add(&_sh_ok, 1); }
            else { atomic_fetch_add(&_sh_bad, 1); }
        }
        k = k + 1;
    }
    return 0;
}

# ---- bote's own tools on threads (3.7.1) ----------------------------------------
# fs_read of four files at once, each thread its own: a result holds its file's marker and
# none of the others'.
var _ft_files = 0;
var _ft_marks = 0;
var _ft_ok = 0;
var _ft_bad = 0;

fn _ft_worker(i) {
    _wait_go();
    var args = _cat3("{\"path\":\"", load64(_ft_files + (i % 4) * 8), "\"}");
    var k = 0;
    while (k < 60) {
        bote_req_begin();
        var r = fs_read_handler(args, 0);
        var good = _has(r, load64(_ft_marks + (i % 4) * 8));
        var j = 0;
        while (j < 4) {
            if (j != i % 4 && _has(r, load64(_ft_marks + j * 8)) == 1) { good = 0; }
            j = j + 1;
        }
        if (good == 1) { atomic_fetch_add(&_ft_ok, 1); } else { atomic_fetch_add(&_ft_bad, 1); }
        k = k + 1;
    }
    return 0;
}

# libro: three threads append through the audit sink while two walk the chain with the tools.
var _lb_ctx = 0;
var _lb_stop = 0;
var _lb_bad = 0;
var _lb_walks = 0;

fn _lb_appender(i) {
    _wait_go();
    var k = 0;
    while (k < 200) {
        libro_audit_log(_lb_ctx, tool_call_event_new("t_lb", 1, 1, 0, 0));
        k = k + 1;
    }
    return 0;
}

fn _lb_walker(i) {
    _wait_go();
    while (atomic_load(&_lb_stop) == 0) {
        var v = libro_tool_verify("{}", 0);
        if (_has(v, "\"ok\":true") == 0) { atomic_fetch_add(&_lb_bad, 1); }
        var q = libro_tool_query("{\"limit\":5}", 0);
        if (_has(q, "\"ok\":true") == 0) { atomic_fetch_add(&_lb_bad, 1); }
        atomic_fetch_add(&_lb_walks, 1);
    }
    return 0;
}

# Retention rewrites the chain: a new entries vec, and the archive's head.
fn _lb_trimmer(i) {
    _wait_go();
    while (atomic_load(&_lb_stop) == 0) {
        var r = libro_tool_retention("{\"policy\":\"keep_count\",\"value\":50}", 0);
        if (r == 0 || _has(r, "isError") == 1) { atomic_fetch_add(&_lb_bad, 1); }
        var k = 0;
        while (k < 20000) { k = k + 1; }
    }
    return 0;
}

var _lb_appenders_done = 0;
fn _lb_run(i) {
    if (i < 3) {
        _lb_appender(i);
        if (atomic_fetch_add(&_lb_appenders_done, 1) == 2) { atomic_store(&_lb_stop, 1); }
        return 0;
    }
    if (i == 5) { return _lb_trimmer(i); }
    return _lb_walker(i);
}

# Children forked from six threads at once, each answering with its own number.
var _fc_ok = 0;
var _fc_bad = 0;

fn _fc_child(n, r) {
    var p = alloc(32);
    store64(p, n);
    bote_fetch_put_int(r, load64(p));
    return 0;
}

fn _fc_worker(i) {
    _wait_go();
    var k = 0;
    while (k < 20) {
        bote_req_begin();
        var cur[24];
        var want = i * 1000 + k;
        if (bote_fetch_in_child(&_fc_child, want, 64, 5000, &cur) == 1 && bote_fetch_int(&cur) == want && bote_fetch_why() == 0) {
            atomic_fetch_add(&_fc_ok, 1);
        } else {
            atomic_fetch_add(&_fc_bad, 1);
        }
        k = k + 1;
    }
    return 0;
}

# ---- registering while a threaded server serves (3.7.1) ---------------------------
# Readers dispatch against tools, prompts and resources that are there throughout, while
# two writers register others: one through dispatcher_register_tool, adding a tool and
# removing the one before, the other through registry_register and dispatcher_handle,
# keeping all it adds, which grows every map and rebuilds it.
var _rg_d = 0;
var _rg_stop = 0;
var _rg_bad = 0;
var _rg_calls = 0;
var _rg_writers = 0;
var RG_N = 1000;

fn _rg_tool(args, claims) { return "{\"content\":[{\"type\":\"text\",\"text\":\"rg-ok\"}]}"; }
fn _rg_prompt(args, claims) { return "{\"messages\":[]}"; }
fn _rg_res(uri, claims) { return "{\"contents\":[{\"uri\":\"rg\",\"text\":\"rg-res\"}]}"; }

fn _rg_name(prefix, i) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, prefix);
    str_builder_add_int(sb, i);
    return str_data(str_builder_build(sb));
}

fn _rg_msg(method, params) {
    return _cat3(_cat3("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"", method, "\",\"params\":"), params, "}");
}

var _rg_msgs = 0;
var _rg_coming = 0 - 1;
var _rg_going = 0 - 1;
var _rg_torn = 0;

# A tool and its handler, read under one hold of the lock: there together, or gone together.
fn _rg_check(k) {
    if (k < 0) { return 0; }
    var nm = _rg_name("rg_dyn_", k);
    bote_reg_read();
    var h = map_has(dispatcher_handlers(_rg_d), nm);
    var c = map_has(registry_entries(dispatcher_registry(_rg_d)), nm);
    bote_reg_read_end();
    if (h != c) { atomic_fetch_add(&_rg_torn, 1); }
    return 0;
}

# A point lookup: the ten tools that stay, the resource, the prompt, and the tool being added
# and the one being taken away.
fn _rg_looker(i) {
    _wait_go();
    var k = 0;
    while (atomic_load(&_rg_stop) == 0) {
        var m = k % 3;
        var at = 10 + k % 10;
        if (m == 1) { at = 7; }
        if (m == 2) { at = 8; }
        var r = codec_process_message_a(bote_req_begin(), load64(_rg_msgs + at * 8), _rg_d, 0);
        var ok = 0;
        if (r != 0) {
            if (m == 0) { ok = _has(r, "rg-ok"); }
            if (m == 1) { ok = _has(r, "rg-res"); }
            if (m == 2) { ok = _has(r, "\"messages\""); }
        }
        if (ok == 0) { atomic_fetch_add(&_rg_bad, 1); }
        _rg_check(atomic_load(&_rg_coming));
        _rg_check(atomic_load(&_rg_going));
        atomic_fetch_add(&_rg_calls, 1);
        k = k + 1;
    }
    return 0;
}

# The four lists, each holding what was there throughout.
fn _rg_lister(i) {
    _wait_go();
    var k = 0;
    while (atomic_load(&_rg_stop) == 0) {
        var m = k % 4;
        var r = codec_process_message_a(bote_req_begin(), load64(_rg_msgs + (1 + m) * 8), _rg_d, 0);
        var ok = 0;
        if (r != 0) {
            if (m == 0) { ok = _has(r, "\"name\":\"rg_base_7\""); }
            if (m == 1) { ok = _has(r, "\"name\":\"rgp_base\""); }
            if (m == 2) { ok = _has(r, "\"uri\":\"rg://base\""); }
            if (m == 3) { ok = _has(r, "\"uriTemplate\":\"rgt://base/{x}\""); }
        }
        if (ok == 0) { atomic_fetch_add(&_rg_bad, 1); }
        atomic_fetch_add(&_rg_calls, 1);
        var p = 0;
        while (p < 20000) { p = p + 1; }
        k = k + 1;
    }
    return 0;
}

fn _rg_done() {
    if (atomic_fetch_add(&_rg_writers, 1) == 1) { atomic_store(&_rg_stop, 1); }
    return 0;
}

fn _rg_writer(i) {
    _wait_go();
    var k = 0;
    while (k < RG_N) {
        atomic_store(&_rg_coming, k);
        dispatcher_register_tool(_rg_d, tool_def_new(_rg_name("rg_dyn_", k), "Dyn", schema_new("object", 0, vec_new())), &_rg_tool);
        dispatcher_register_prompt(_rg_d, prompt_def_new(_rg_name("rgp_dyn_", k), "Dyn", vec_new()), &_rg_prompt);
        dispatcher_register_resource(_rg_d, resource_def_new(_rg_name("rg://dyn/", k), "d", "D", "text/plain"), &_rg_res);
        dispatcher_register_resource_template(_rg_d, resource_template_new(_cat3("rgt://dyn", _rg_name("", k), "/{x}"), "t", "T", "text/plain"), &_rg_res);
        if (k > 0) {
            atomic_store(&_rg_going, k - 1);
            dispatcher_deregister_tool(_rg_d, _rg_name("rg_dyn_", k - 1));
        }
        k = k + 1;
    }
    return _rg_done();
}

fn _rg_grower(i) {
    _wait_go();
    var k = 0;
    while (k < RG_N) {
        var nm = _rg_name("rg_grow_", k);
        registry_register(dispatcher_registry(_rg_d), tool_def_new(nm, "Grow", schema_new("object", 0, vec_new())));
        dispatcher_handle(_rg_d, nm, &_rg_tool);
        dispatcher_register_prompt(_rg_d, prompt_def_new(_rg_name("rgp_grow_", k), "Grow", vec_new()), &_rg_prompt);
        dispatcher_register_resource_template(_rg_d, resource_template_new(_cat3("rgt://grow", _rg_name("", k), "/{x}"), "t", "T", "text/plain"), &_rg_res);
        k = k + 1;
    }
    return _rg_done();
}

# The public lookups an embedder may call, each on a thread of its own in a tight loop,
# with no other call between: one that takes the lock beside it would shelter it.
fn _rg_prober(i) {
    _wait_go();
    var reg = dispatcher_registry(_rg_d);
    var pr = dispatcher_prompts(_rg_d);
    var rr = dispatcher_resources(_rg_d);
    var names = alloc(10 * 8);
    var j = 0;
    while (j < 10) {
        store64(names + j * 8, _rg_name("rg_base_", j));
        j = j + 1;
    }
    var has[8];
    var which = i - 3;
    var k = 0;
    while (atomic_load(&_rg_stop) == 0) {
        var nm = load64(names + (k % 10) * 8);
        var ok = 1;
        if (which == 0) { ok = registry_get(reg, nm) != 0; }
        if (which == 1) { ok = _dsp_handler(_rg_d, nm, &has) == &_rg_tool; }
        if (which == 2) { ok = resource_registry_handler(rr, "rg://base") == &_rg_res; }
        if (which == 3) { ok = prompt_registry_handler(pr, "rgp_base") == &_rg_prompt; }
        if (which == 4) { ok = resource_registry_template_for(rr, "rgt://base/9") != 0; }
        if (ok == 0) { atomic_fetch_add(&_rg_bad, 1); }
        k = k + 1;
    }
    return 0;
}

# One list alone, with no pause, while the writers grow the map under it: `at` is its
# message, `want` what the list must hold.
fn _rg_one_list(at, want) {
    _wait_go();
    while (atomic_load(&_rg_stop) == 0) {
        var r = codec_process_message_a(bote_req_begin(), load64(_rg_msgs + at * 8), _rg_d, 0);
        if (r == 0 || _has(r, want) == 0) { atomic_fetch_add(&_rg_bad, 1); }
        atomic_fetch_add(&_rg_calls, 1);
    }
    return 0;
}

fn _rg_run(i) {
    if (i == 0) { return _rg_writer(i); }
    if (i == 1) { return _rg_grower(i); }
    if (i == 2) { return _rg_lister(i); }
    if (i >= 3 && i <= 7) { return _rg_prober(i); }
    if (i == 8) { return _rg_one_list(2, "\"name\":\"rgp_base\""); }
    if (i == 9) { return _rg_one_list(1, "\"name\":\"rg_base_7\""); }
    if (i == 10) { return _rg_one_list(3, "\"uri\":\"rg://base\""); }
    return _rg_looker(i);
}

# Four threads setting handlers and nothing else, on one dispatcher.
var _hd_d = 0;
fn _hd_writer(i) {
    _wait_go();
    var k = 0;
    while (k < 300) {
        dispatcher_handle(_hd_d, _cat3(_rg_name("hd_", i), "_", _rg_name("", k)), &_rg_tool);
        k = k + 1;
    }
    return 0;
}

# Four threads registering templates and nothing else, into one registry.
var _rt_reg = 0;
fn _rt_writer(i) {
    _wait_go();
    var k = 0;
    while (k < 300) {
        resource_registry_register_template(_rt_reg, resource_template_new(_cat3(_rg_name("rt://", i), _rg_name("/", k), "/{x}"), "t", "T", "text/plain"), &_rg_res);
        k = k + 1;
    }
    return 0;
}

# ---- the first prompt and resource, from four threads at once (3.7.2) --------------------
# A dispatcher makes its prompt and resource registries on first use. Four threads each
# register a prompt, a resource and a template on each of FR_N fresh dispatchers: each made
# its own registry, and the first stored was lost, with what was in it, for nearly all.
var FR_N = 1000;
var _fr_ds = 0;

fn _fr_worker(i) {
    var pn = _rg_name("fr_p", i);
    var ru = _rg_name("fr://r/", i);
    var tu = _cat3(_rg_name("fr://t/", i), "/{x}", "");
    _wait_go();
    var j = 0;
    while (j < FR_N) {
        var d = load64(_fr_ds + j * 8);
        dispatcher_register_prompt(d, prompt_def_new(pn, "P", vec_new()), &_rg_prompt);
        dispatcher_register_resource(d, resource_def_new(ru, "r", "R", "text/plain"), &_rg_res);
        j = j + 1;
    }
    j = 0;
    while (j < FR_N) {
        var td = load64(_fr_ds + (FR_N + j) * 8);
        dispatcher_register_resource_template(td, resource_template_new(tu, "t", "T", "text/plain"), &_rg_res);
        j = j + 1;
    }
    return 0;
}

# ---- a call judged by what serves it (3.7.2) ----------------------------------------
# Writers change what serves a name while callers, whose token lacks the scope `admin`, ask
# for it: a tool registered requiring it and removed; a prompt and a resource that switch
# between a registration requiring it, served by a guarded handler, and one requiring
# nothing, served by a public one; and a resource that switches between no handler, when a
# template requiring the scope serves its URI, and a public handler. A call judged by one
# look at the registry and served by another ran a guarded handler for such a token, once
# in twenty calls. And a tool that switches between a schema requiring `n`, served by a
# handler that must never see a call without it, and one requiring nothing: its arguments
# are checked against the schema of the registration that serves them. Each writer and
# each caller is a thread of its own.
var _js_d = 0;
var _js_writers = 0;
var _js_ran = 0;
var _js_refused = 0;
var _js_public = 0;
var _js_unchecked = 0;
var _js_msgs = 0;
var JS_N = 3000;

fn _js_tool(args, claims) { atomic_fetch_add(&_js_ran, 1); return "{\"content\":[]}"; }
fn _js_prompt(args, claims) { atomic_fetch_add(&_js_ran, 1); return "{\"messages\":[]}"; }
fn _js_res(uri, claims) { atomic_fetch_add(&_js_ran, 1); return "{\"contents\":[]}"; }
fn _js_pub_prompt(args, claims) { atomic_fetch_add(&_js_public, 1); return "{\"messages\":[]}"; }
fn _js_pub_res(uri, claims) { atomic_fetch_add(&_js_public, 1); return "{\"contents\":[]}"; }
fn _js_strict(args, claims) {
    if (_has(args, "\"n\"") == 0) { atomic_fetch_add(&_js_unchecked, 1); }
    return "{\"content\":[]}";
}
fn _js_loose(args, claims) { atomic_fetch_add(&_js_public, 1); return "{\"content\":[]}"; }

# A schema that requires the integer `n`.
fn _js_needs_n() {
    var props = vec_new();
    vec_push(props, schema_prop_new("n", "{\"type\":\"integer\"}"));
    var req = vec_new();
    vec_push(req, "n");
    return schema_new("object", props, req);
}
fn _js_lacks(claims, scope, ctx) { return 0; }

fn _js_admin() {
    var v = vec_new();
    vec_push(v, "admin");
    return v;
}

fn _js_writer(kind) {
    _wait_go();
    var k = 0;
    while (k < JS_N) {
        if (kind == 0) {
            dispatcher_register_tool(_js_d, tool_def_with_required_scopes(tool_def_new("js_tool", "J", schema_new("object", 0, vec_new())), _js_admin()), &_js_tool);
            dispatcher_deregister_tool(_js_d, "js_tool");
        } elif (kind == 1) {
            dispatcher_register_prompt(_js_d, prompt_def_with_required_scopes(prompt_def_new("js_p", "J", vec_new()), _js_admin()), &_js_prompt);
            dispatcher_register_prompt(_js_d, prompt_def_new("js_p", "J", vec_new()), &_js_pub_prompt);
        } elif (kind == 4) {
            dispatcher_register_tool(_js_d, tool_def_new("js_v", "V", _js_needs_n()), &_js_strict);
            dispatcher_register_tool(_js_d, tool_def_new("js_v", "V", schema_new("object", 0, vec_new())), &_js_loose);
        } elif (kind == 2) {
            dispatcher_register_resource(_js_d, resource_def_with_required_scopes(resource_def_new("js://r", "j", "J", "text/plain"), _js_admin()), &_js_res);
            dispatcher_register_resource(_js_d, resource_def_new("js://r", "j", "J", "text/plain"), &_js_pub_res);
        } else {
            dispatcher_register_resource(_js_d, resource_def_new("js://t/1", "j", "J", "text/plain"), 0);
            dispatcher_register_resource(_js_d, resource_def_new("js://t/1", "j", "J", "text/plain"), &_js_pub_res);
        }
        k = k + 1;
    }
    atomic_fetch_add(&_js_writers, 0 - 1);
    return 0;
}

fn _js_caller(kind) {
    _wait_go();
    var m = load64(_js_msgs + kind * 8);
    while (atomic_load(&_js_writers) > 0) {
        var r = codec_process_message_a(bote_req_begin(), m, _js_d, "a-token");
        if (r != 0 && _has(r, "insufficient scope")) { atomic_fetch_add(&_js_refused, 1); }
    }
    return 0;
}

fn _js_run(i) {
    if (i < 5) { return _js_writer(i); }
    return _js_caller(i - 5);
}

# ---- a failure that ends the process, from a worker (3.7.1) -----------------------
# _gen_session_id exits 90 when the kernel gives no entropy. Called with sys_exit from a
# worker, it ended that thread alone, holding the store's lock: the process stayed up and
# the next caller of the store waited for good.
fn _ex_no_entropy(buf, n) { return 0 - 38; }

fn _ex_worker(i) {
    session_store_create(_ss_store, "2025-11-25");
    return 0;
}

# The exit status of a child that makes a session on a worker with no entropy, or -1 if
# it was still running after 5 s.
fn _ex_status() {
    var pid = sys_fork();
    if (pid == 0) {
        _bote_ses_random = &_ex_no_entropy;
        thread_join(thread_create(&_ex_worker, 0));
        session_store_active_count(_ss_store);
        sys_exit_group(0);
    }
    var st[8];
    var end = clock_now_ms() + 5000;
    while (clock_now_ms() < end) {
        if (sys_waitpid(pid, &st, 1) == pid) { return (load64(&st) >> 8) & 255; }
        sleep_ms(10);
    }
    sys_kill(pid, SIGKILL);
    sys_waitpid(pid, &st, 0);
    return 0 - 1;
}

#endif

fn main() {
    alloc_init();
    fl_init();
    #ifndef CYRIUS_TARGET_AGNOS

    # ---------------- each thread's request state ----------------
    assert(bote_req_state() == &_bote_req_g, "before a threaded server, one state for the process");
    var g_arena = bote_req_alloc();
    # Armed on a worker: the main thread, which nothing gave a thread-local block, is given
    # one at its first look, and does not fault.
    var at = thread_create(&_rs_arm, 0);
    thread_join(at);
    assert_eq(_rs_armed, 0, "arm: a slot is claimed, from a thread that is not the main one");
    assert(_rs_arm_state == &_bote_req_g, "arm: the thread that armed keeps the state it had");
    assert(_bote_req_state_fp != 0, "arm: the lookup is set");
    var main_state = bote_req_state();
    assert(main_state != 0 && main_state != &_bote_req_g, "arm: the main thread, without a block, gets a state of its own");
    var main_arena = bote_req_alloc();
    assert(main_arena != 0 && main_arena != g_arena, "arm: ...and an arena");
    assert(bote_req_state() == main_state, "arm: ...the same one each time");
    assert_eq(bote_conn_arm(), 0, "arm again: nothing to do");
    assert(bote_req_state() == main_state, "arm again: ...and nothing changed");
    _n = 6;
    _rs_arena = alloc(_n * 8);
    _rs_state = alloc(_n * 8);
    _on_threads(&_rs_worker, _n);
    assert_eq(_all_apart(_rs_arena, _n, main_arena), 1, "each thread has an arena of its own");
    assert_eq(_all_apart(_rs_state, _n, &_bote_req_g), 1, "and a state of its own");
    assert_eq(_rs_tok_ok, _n, "each thread reads back the token it noted, with the others noting theirs");
    assert(bote_fetch_why() == 0, "a fetch's reason is the thread's own");
    assert(bote_req_token() == 0, "and so is a token");

    # ---------------- the session store ----------------
    _ss_store = session_store_default();
    _on_threads(&_ss_worker, 4);
    assert_eq(_ss_bad, 0, "sessions: each made on four threads at once validates");
    assert_eq(session_store_active_count(_ss_store), 1600, "sessions: none lost");
    assert_eq(vec_len(session_store_ids(_ss_store)), 1600, "sessions: the id list agrees");

    # ---------------- a session's outbound bundle ----------------
    _so_got = alloc(8 * 8);
    var so_split = 0;
    var so_i = 0;
    while (so_i < 60) {
        _so_sess = mcp_session_new("s", "2025-11-25", 0);
        _on_threads(&_so_worker, 8);
        var so_j = 1;
        while (so_j < 8) {
            if (load64(_so_got + so_j * 8) != load64(_so_got)) { so_split = so_split + 1; }
            so_j = so_j + 1;
        }
        so_i = so_i + 1;
    }
    assert_eq(so_split, 0, "outbound: eight threads asking at once share one bundle");

    # ---------------- publishing beside draining ----------------
    _pd_store = session_store_default();
    _pd_sid = session_store_create(_pd_store, "2025-11-25");
    session_store_create(_pd_store, "2025-11-25");
    session_store_create(_pd_store, "2025-11-25");
    _on_threads(&_pd_run, 5);
    assert_eq(_pd_bad, 0, "notify: every drained event is whole, with three threads draining");
    assert_eq(_pd_torn, 0, "notify: and every drain is the buffer at one moment, with sessions made beside it");
    assert(_pd_drains > 0, "notify: the drains ran");
    var pd_buf = session_outbound_buffer(_strm_session_outbound(session_store_validate(_pd_store, _pd_sid)));
    assert_eq(resumption_buffer_len(pd_buf), 1000, "notify: the buffer holds its bound");
    assert(streq(stream_event_id(vec_get(resumption_buffer_events(pd_buf), 999)), "evt-1499") == 1, "notify: and the last event pushed");

    # ---------------- sinks that take their turn ----------------
    var sk_reg = tool_registry_new();
    registry_register(sk_reg, tool_def_new("t_sk", "Sink", schema_new("object", 0, vec_new())));
    _snk_d = dispatcher_new(sk_reg);
    dispatcher_handle(_snk_d, "t_sk", &_snk_tool);
    dispatcher_set_audit(_snk_d, audit_sink_new(&_snk_log, 0));
    var sk_ev = event_sink_set_list_only(event_sink_new(&_snk_publish, 0));
    dispatcher_set_events(_snk_d, sk_ev);
    var sk_au = dispatcher_audit_sink(_snk_d);
    bote_conn_serial_sinks(_snk_d);
    assert(audit_sink_log_fp(dispatcher_audit_sink(_snk_d)) == &_bote_conn_audit_serial, "sinks: the audit sink is wrapped");
    assert(load64(dispatcher_event_sink(_snk_d) + 16) == 1, "sinks: an event sink keeps its list-only flag");
    bote_conn_serial_sinks(_snk_d);
    assert(load64(audit_sink_ctx(dispatcher_audit_sink(_snk_d))) == sk_au, "sinks: wrapped once, around the sink it was given");
    var sk_none = dispatcher_new(sk_reg);
    dispatcher_set_audit(sk_none, audit_sink_noop());
    var sk_noop = dispatcher_audit_sink(sk_none);
    bote_conn_serial_sinks(sk_none);
    assert(dispatcher_audit_sink(sk_none) == sk_noop, "sinks: a sink with no function is left alone");
    assert(dispatcher_event_sink(sk_none) == 0, "sinks: and none stays none");
    _snk_msg = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"t_sk\",\"arguments\":{}}}";
    _on_threads(&_snk_worker, 4);
    assert_eq(_snk_overlap, 0, "sinks: the audit sink is never in two calls at once");
    assert_eq(_snk_calls, 1000, "sinks: and is called for every tools/call");

    # ---------------- a JwtSecret: one refresh between the workers ----------------
    _bote_jwt_clock = &_jt_clock;
    _jt_doc = JV_JWKS_ONE_RSA;
    _jt_s = jwt_secret_new(0);
    jwt_secret_with_audience(_jt_s, JV_AUD);
    jwt_secret_with_key_source(_jt_s, &_jt_src, 0, 600);
    _jt_tok = "aaaaaaaaaaaaaaaaaaaaaaaa.bbbb.cccc";
    _on_threads(&_jt_ask_worker, 8);
    assert_eq(_jt_calls, 1, "jwks: eight workers finding the keys due make one fetch");
    assert_eq(vec_len(jwt_secret_keys(_jt_s)), 1, "jwks: and its keys are taken");
    # A minute on, a token naming a key it does not hold, on every worker at once.
    _jt_now = _jt_now + 61;
    _jt_doc = JV_JWKS;
    _jt_tok = JV_ES_UNKNOWN_KID;
    _on_threads(&_jt_ask_worker, 8);
    assert_eq(_jt_calls, 2, "jwks: eight tokens naming an unknown kid at once make one fetch");
    assert_eq(vec_len(jwt_secret_keys(_jt_s)), 6, "jwks: and the new set is taken");
    _bote_jwt_clock = 0;

    # ---------------- a JwtSecret's cache on threads ----------------
    var hk = "0123456789abcdef0123456789abcdef";
    _jt_s = jwt_secret_with_cache(jwt_secret_with_audience(jwt_secret_new(hk), "https://mcp.example.com/mcp"), 4);
    _hc_toks = alloc(16 * 8);
    var hi = 0;
    while (hi < 16) {
        var hb = str_builder_new();
        str_builder_add_cstr(hb, "{\"aud\":\"https://mcp.example.com/mcp\",\"exp\":4102444800,\"jti\":");
        str_builder_add_int(hb, hi);
        str_builder_add_cstr(hb, "}");
        store64(_hc_toks + hi * 8, _mint_hs256("{\"alg\":\"HS256\",\"typ\":\"JWT\"}", str_data(str_builder_build(hb)), hk));
        hi = hi + 1;
    }
    _jt_tok = _mint_hs256("{\"alg\":\"HS256\",\"typ\":\"JWT\"}", "{\"aud\":\"https://mcp.example.com/mcp\",\"exp\":1000}", hk);
    _jt_good = 0;
    _jt_bad = 0;
    _jt_expired = 0;
    _on_threads(&_hc_worker, 8);
    assert_eq(_jt_good, 2400, "cache: sixteen tokens in four slots, on eight threads, all pass");
    assert_eq(_jt_bad, 0, "cache: none fails");
    assert_eq(_jt_expired, 0, "cache: an expired token never passes");
    assert_eq(jwt_secret_cache_hits(_jt_s) + jwt_secret_cache_misses(_jt_s), 2640, "cache: every lookup counted once");

    # ---------------- a fork while another thread holds an allocator's lock ----------------
    _fk_stop = 0;
    var fk_t = thread_create(&_fk_hold_alloc, 0);
    var fk_ok = _fk_rounds(&_fk_child_alloc, 77, 24);
    atomic_store(&_fk_stop, 1);
    thread_join(fk_t);
    assert_eq(fk_ok, 24, "fork: a child allocates though another thread held the allocator's lock");
    _fk_stop = 0;
    fk_t = thread_create(&_fk_hold_fl, 0);
    fk_ok = _fk_rounds(&_fk_child_fl, 78, 24);
    atomic_store(&_fk_stop, 1);
    thread_join(fk_t);
    assert_eq(fk_ok, 24, "fork: and the freelist's");

    # ---------------- the streamable handler on threads ----------------
    var sh_reg = tool_registry_new();
    registry_register(sh_reg, tool_def_new("t_echo", "Echo", schema_new("object", 0, vec_new())));
    var sh_d = dispatcher_new(sh_reg);
    dispatcher_handle(sh_d, "t_echo", &_sh_echo);
    var sh_store = session_store_default();
    dispatcher_set_events(sh_d, strm_notify_sink(sh_store));
    _sh_cfg = streamable_config_new("/mcp", 0x0100007F, 0);
    streamable_config_with_session_store(_sh_cfg, sh_store);
    assert_eq(streamable_config_workers(_sh_cfg), 0, "workers: none unless asked");
    streamable_config_with_workers(_sh_cfg, 4);
    assert_eq(streamable_config_workers(_sh_cfg), 4, "workers: as asked");
    store64(_sh_cfg + 56, sh_d);
    _strm_init();
    _on_threads(&_sh_worker, 6);
    assert_eq(_sh_bad, 0, "streamable: six threads in the handler at once, no reply wrong");
    assert_eq(_sh_ok, 720, "streamable: every call answered with its own arguments");
    assert_eq(session_store_active_count(sh_store), 720, "streamable: every session kept");

    # A drain renders what it sends on the arena: a GET, and a POST that carries the
    # pending events, keep nothing however many are pending.
    var dr_rbuf = alloc(70000);
    var dr_rcv = alloc(65600);
    var dr_sid = session_store_create(sh_store, "2025-11-25");
    var dr_i = 0;
    while (dr_i < 40) {
        _strm_notify_publish(sh_store, TOPIC_TOOL_REGISTERED(), "{}");
        dr_i = dr_i + 1;
    }
    var dr_get = _cat3("GET /mcp HTTP/1.1\r\nHost: x\r\nAccept: text/event-stream\r\nMCP-Session-Id: ", dr_sid, "\r\n\r\n");
    _sh_run(dr_get, dr_rbuf, dr_rcv);
    assert(_has(dr_rcv, "id: evt-39") == 1, "drain: a GET sends what is pending");
    var dr_at = alloc_used();
    dr_i = 0;
    while (dr_i < 20) {
        _sh_run(dr_get, dr_rbuf, dr_rcv);
        dr_i = dr_i + 1;
    }
    assert_eq(alloc_used() - dr_at, 0, "drain heap: twenty GETs of forty events keep nothing");
    var dr_post = _cat3("POST /mcp HTTP/1.1\r\nHost: x\r\nAccept: application/json, text/event-stream\r\nMCP-Session-Id: ", dr_sid,
      "\r\nContent-Length: 40\r\n\r\n{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"ping\"}");
    _sh_run(dr_post, dr_rbuf, dr_rcv);
    assert(_has(dr_rcv, "text/event-stream") == 1 && _has(dr_rcv, "id: evt-39") == 1, "drain: a POST carries them too");
    dr_at = alloc_used();
    dr_i = 0;
    while (dr_i < 20) {
        _sh_run(dr_post, dr_rbuf, dr_rcv);
        dr_i = dr_i + 1;
    }
    assert_eq(alloc_used() - dr_at, 0, "drain heap: twenty POSTs carrying them keep nothing");

    # ---------------- bote's own tools on threads (3.7.1) ----------------
    _ft_files = alloc(4 * 8);
    _ft_marks = alloc(4 * 8);
    store64(_ft_files, "LICENSE");
    store64(_ft_marks, "GNU GENERAL PUBLIC LICENSE");
    store64(_ft_files + 8, "CLAUDE.md");
    store64(_ft_marks + 8, "Claude Code Instructions");
    store64(_ft_files + 16, "SECURITY.md");
    store64(_ft_marks + 16, "Reporting a Vulnerability");
    store64(_ft_files + 24, "CHANGELOG.md");
    store64(_ft_marks + 24, "All notable changes to bote");
    _on_threads(&_ft_worker, 8);
    assert_eq(_ft_bad, 0, "fs_read: eight threads reading four files, none handed another's");
    assert_eq(_ft_ok, 480, "fs_read: every read its own file");

    var lb_chain = chain_new();
    _lb_ctx = libro_audit_new(lb_chain);
    libro_tools_init(lb_chain);
    _on_threads(&_lb_run, 5);
    assert_eq(_lb_bad, 0, "libro: the chain verifies at every walk, with three threads appending");
    assert(_lb_walks > 0, "libro: the walks ran");
    assert_eq(vec_len(load64(lb_chain)), 600, "libro: every append kept");
    assert(_has(libro_tool_verify("{}", 0), "\"ok\":true") == 1, "libro: and the chain verifies after");
    # And again with retention rewriting the chain beside the appends and the walks.
    var lb2 = chain_new();
    _lb_ctx = libro_audit_new(lb2);
    libro_tools_init(lb2);
    _lb_stop = 0;
    _lb_appenders_done = 0;
    _lb_walks = 0;
    _on_threads(&_lb_run, 6);
    assert_eq(_lb_bad, 0, "libro: every walk verifies, with retention rewriting the chain beside it");
    assert(_lb_walks > 0, "libro: those walks ran");
    assert(vec_len(load64(lb2)) <= 600 && _has(libro_tool_verify("{}", 0), "\"ok\":true") == 1, "libro: and the chain verifies after");

    _on_threads(&_fc_worker, 6);
    assert_eq(_fc_bad, 0, "fetch: children forked from six threads at once");
    assert_eq(_fc_ok, 120, "fetch: each answered its own thread with its own number");

    # ---------------- registering while serving (3.7.1) ----------------
    _rg_d = dispatcher_new(tool_registry_new());
    var rg_i = 0;
    while (rg_i < 10) {
        dispatcher_register_tool(_rg_d, tool_def_new(_rg_name("rg_base_", rg_i), "Base", schema_new("object", 0, vec_new())), &_rg_tool);
        rg_i = rg_i + 1;
    }
    dispatcher_register_prompt(_rg_d, prompt_def_new("rgp_base", "Base", vec_new()), &_rg_prompt);
    dispatcher_register_resource(_rg_d, resource_def_new("rg://base", "b", "B", "text/plain"), &_rg_res);
    dispatcher_register_resource_template(_rg_d, resource_template_new("rgt://base/{x}", "t", "T", "text/plain"), &_rg_res);
    _rg_msgs = alloc(20 * 8);
    store64(_rg_msgs + 8, _rg_msg("tools/list", "{}"));
    store64(_rg_msgs + 16, _rg_msg("prompts/list", "{}"));
    store64(_rg_msgs + 24, _rg_msg("resources/list", "{}"));
    store64(_rg_msgs + 32, _rg_msg("resources/templates/list", "{}"));
    store64(_rg_msgs + 56, _rg_msg("resources/read", "{\"uri\":\"rg://base\"}"));
    store64(_rg_msgs + 64, _rg_msg("prompts/get", "{\"name\":\"rgp_base\",\"arguments\":{}}"));
    rg_i = 0;
    while (rg_i < 10) {
        store64(_rg_msgs + (10 + rg_i) * 8, _rg_msg("tools/call", _cat3("{\"name\":\"rg_base_", _rg_name("", rg_i), "\",\"arguments\":{}}")));
        rg_i = rg_i + 1;
    }
    _on_threads(&_rg_run, 13);
    assert_eq(_rg_bad, 0, "register: three threads looking up and one listing, while two register 1,000 tools, prompts, resources and templates each");
    assert(_rg_calls > 100, "register: the readers ran");
    assert_eq(_rg_torn, 0, "register: a tool and its handler appear and go together");
    assert_eq(registry_len(dispatcher_registry(_rg_d)), 10 + 1 + RG_N, "register: the ten that stayed, the last one added and every one kept");
    assert(registry_contains(dispatcher_registry(_rg_d), _rg_name("rg_dyn_", RG_N - 1)) == 1 && registry_contains(dispatcher_registry(_rg_d), _rg_name("rg_dyn_", RG_N - 2)) == 0, "register: the last added, the one before removed");
    assert_eq(prompt_registry_len(dispatcher_prompts(_rg_d)), 1 + 2 * RG_N, "register: every prompt kept, from both writers");
    assert_eq(resource_registry_len(dispatcher_resources(_rg_d)), 1 + RG_N, "register: every resource kept");
    assert_eq(vec_len(resource_registry_templates(dispatcher_resources(_rg_d))), 1 + 2 * RG_N, "register: every template kept, from both writers");
    var rg_has[8];
    assert(_dsp_handler(_rg_d, _rg_name("rg_dyn_", RG_N - 1), &rg_has) == &_rg_tool && load64(&rg_has) == 1, "register: the last tool's handler is there");
    _dsp_handler(_rg_d, "rg_dyn_5", &rg_has);
    assert_eq(load64(&rg_has), 0, "register: a removed tool's is gone");
    var rg_lost = 0;
    rg_i = 0;
    while (rg_i < RG_N) {
        if (_dsp_handler(_rg_d, _rg_name("rg_grow_", rg_i), &rg_has) != &_rg_tool) { rg_lost = rg_lost + 1; }
        rg_i = rg_i + 1;
    }
    assert_eq(rg_lost, 0, "register: every handler the second writer set is there");
    _rt_reg = resource_registry_new();
    _on_threads(&_rt_writer, 4);
    assert_eq(vec_len(resource_registry_templates(_rt_reg)), 1200, "register: four threads registering templates at once lose none");

    # ---------------- the first prompt and resource, from four threads (3.7.2) ----------------
    _fr_ds = alloc(2 * FR_N * 8);
    var fr_i = 0;
    while (fr_i < 2 * FR_N) {
        store64(_fr_ds + fr_i * 8, dispatcher_new(tool_registry_new()));
        fr_i = fr_i + 1;
    }
    _on_threads(&_fr_worker, 4);
    var fr_lost_p = 0;
    var fr_lost_r = 0;
    var fr_lost_t = 0;
    fr_i = 0;
    while (fr_i < FR_N) {
        var frd = load64(_fr_ds + fr_i * 8);
        if (prompt_registry_len(dispatcher_prompts(frd)) != 4) { fr_lost_p = fr_lost_p + 1; }
        if (resource_registry_len(dispatcher_resources(frd)) != 4) { fr_lost_r = fr_lost_r + 1; }
        var frt = load64(_fr_ds + (FR_N + fr_i) * 8);
        if (vec_len(resource_registry_templates(dispatcher_resources(frt))) != 4) { fr_lost_t = fr_lost_t + 1; }
        fr_i = fr_i + 1;
    }
    assert_eq(fr_lost_p, 0, "first: no dispatcher lost a prompt registered beside another thread's first");
    assert_eq(fr_lost_r, 0, "first: nor a resource");
    assert_eq(fr_lost_t, 0, "first: nor a template");

    # ---------------- a call judged by what serves it (3.7.2) ----------------
    _js_d = dispatcher_new(tool_registry_new());
    dispatcher_set_scope_check(_js_d, &_js_lacks, 0);
    dispatcher_register_prompt(_js_d, prompt_def_new("js_p", "J", vec_new()), &_js_pub_prompt);
    dispatcher_register_resource(_js_d, resource_def_new("js://r", "j", "J", "text/plain"), &_js_pub_res);
    dispatcher_register_resource_template(_js_d, resource_template_with_required_scopes(resource_template_new("js://t/{id}", "t", "T", "text/plain"), _js_admin()), &_js_res);
    _js_msgs = alloc(40);
    store64(_js_msgs, _rg_msg("tools/call", "{\"name\":\"js_tool\"}"));
    store64(_js_msgs + 8, _rg_msg("prompts/get", "{\"name\":\"js_p\"}"));
    store64(_js_msgs + 16, _rg_msg("resources/read", "{\"uri\":\"js://r\"}"));
    store64(_js_msgs + 24, _rg_msg("resources/read", "{\"uri\":\"js://t/1\"}"));
    store64(_js_msgs + 32, _rg_msg("tools/call", "{\"name\":\"js_v\",\"arguments\":{}}"));
    _js_writers = 5;
    _on_threads(&_js_run, 10);
    assert_eq(_js_ran, 0, "judged: no guarded handler ran for a token without its scope");
    assert_eq(_js_unchecked, 0, "judged: no handler ran with arguments another registration's schema passed");
    assert(_js_refused > 0, "judged: calls were refused for the scope");
    assert(_js_public > 0, "judged: and the public registrations answered");
    _hd_d = dispatcher_new(tool_registry_new());
    _on_threads(&_hd_writer, 4);
    assert_eq(map_count(dispatcher_handlers(_hd_d)), 1200, "register: four threads setting handlers at once lose none");

    # ---------------- (3.8.9) the heap forms' scratch, on six threads ----------------
    _sc_comp = _compile_object_body("{\"type\":\"object\",\"properties\":{\"n\":{\"type\":\"integer\"},\"l\":{\"uniqueItems\":true}}}");
    _on_threads(&_sc_worker, 6);
    assert_eq(_sc_bad, 0, "scratch: 1,800 judgements through compiled_validate on six threads, each answer its own and whole");
    # ---------------- a failure that ends the process, from a worker ----------------
    assert_eq(_ex_status(), 90, "exit: no entropy on a worker ends the process with 90, not the thread");
    #endif
    return assert_summary();
}

var rc = main();
sys_exit(rc);
