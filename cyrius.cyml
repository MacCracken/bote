[package]
name = "bote"
version = "${file:VERSION}"
description = "MCP core service in Cyrius — stable 2.x. JSON-RPC 2.0, six transports, bearer auth + JWT HS256 + RFC 7636 PKCE, libro audit tools, content blocks (with annotations), host registry + IPv4/IPv6 SSRF guard, pluggable sandbox runner (kavach 3.9.3 shape)"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/bote"
language = "cyrius"
cyrius = "6.5.20"

[build]
entry = "src/main.cyr"
output = "build/bote"

# `[lib]` exists so `cyrius distlib` can concatenate src/ into
# dist/bote.cyr for downstream consumers (phylax, t-ron, sutra,
# jalwa, rasa, mneme, etc.) that want the MCP core surface as a
# single bundle. Order mirrors the include order in src/main.cyr —
# critical for Cyrius single-pass forward-reference resolution.
#
# libro_tools is now part of the default bundle (2.7.5). It was
# parked through the 2.6.x line — first pending the libro 2.x API
# port (the entry_*/merkle_proof/libro_export accessors retired in
# libro 2.0, re-implemented as raw struct-offset helpers at 2.6.2),
# then held out for fn_table headroom. The 6.1.x cap raise (fn_table
# at 58%/60% on src/main.cyr, well under the 95% gate) makes the
# headroom argument moot, so it folds back into the full bundle and
# the default binary. It is NOT in dist/bote-core.cyr: like
# audit_libro, it depends on a live libro chain, which the
# transport-free core profile deliberately excludes.
#   cyrius distlib       → dist/bote.cyr      (default [lib], full bundle — 30 modules)
#   cyrius distlib core  → dist/bote-core.cyr ([lib.core], 11 transport-free modules)
[lib]
modules = [
    "src/error.cyr",
    "src/protocol.cyr",
    "src/jsonx.cyr",
    "src/registry.cyr",
    "src/prompts.cyr",
    "src/resources.cyr",
    "src/events.cyr",
    "src/audit.cyr",
    "src/audit_libro.cyr",
    "src/events_majra.cyr",
    "src/dispatch.cyr",
    "src/codec.cyr",
    "src/schema.cyr",
    "src/stream.cyr",
    "src/session.cyr",
    "src/discovery.cyr",
    "src/auth.cyr",
    "src/jwt.cyr",
    "src/pkce.cyr",
    "src/transport_stdio.cyr",
    "src/transport_http.cyr",
    "src/transport_unix.cyr",
    "src/bridge.cyr",
    "src/transport_streamable.cyr",
    "src/transport_ws.cyr",
    "src/content.cyr",
    "src/host.cyr",
    "src/libro_tools.cyr",
    "src/fs_tools.cyr",
    "src/web_tools.cyr",
]

# Core-only opt-in bundle (2.7.2; 9 modules then, 11 since the 3.0.0
# prompts/resources capabilities). Transport-free modules for
# consumers that wrap bote's Dispatcher / Registry / Audit surface
# but supply their own transport — e.g. t-ron 2.1.x's SecurityGate
# middleware. Excludes the transports (stdio/http/unix/bridge/
# streamable/ws), auth, session, discovery, content, host, audit_libro,
# events_majra. Keeps consumers off the cyrius 2 MB compile-source cap
# while still allowing the single-bundle DEPS-PATTERN.
#
# See docs/development/issues/archive/2026-05-10-opt-in-transport-profile.md
# for the rationale and split derivation.
[lib.core]
modules = [
    "src/error.cyr",
    "src/protocol.cyr",
    "src/jsonx.cyr",
    "src/registry.cyr",
    "src/prompts.cyr",
    "src/resources.cyr",
    "src/events.cyr",
    "src/audit.cyr",
    "src/dispatch.cyr",
    "src/codec.cyr",
    "src/schema.cyr",
]

# ── Dependencies ─────────────────────────────────────────────────
# Cyrius-stdlib modules. `cyrius deps` copies these from the
# version-pinned snapshot into ./lib/ (gitignored). The list mirrors
# the include order at the top of src/main.cyr so the manifest stays
# load-bearing.
[deps]
stdlib = [
    "string",
    "fmt",
    "alloc",
    "vec",
    "str",
    "slice",
    "syscalls",
    "io",
    "args",
    "assert",
    "hashmap",
    # bayan = the 6.1.x consolidated data module: JSON (json_parse /
    # json_get back-compat shims over bayan_json_*), base64 / base64url,
    # csv, u128. Subsumes the pre-6.1 `json` + `base64` stdlib modules,
    # which no longer ship as standalone files. bote consumes json_parse /
    # json_get (registry.cyr) and base64url_decode (jwt.cyr).
    "bayan",
    "fnptr",
    "chrono",
    "tagged",
    "net",
    "async",
    # dynlib MUST precede fdlopen: 6.3.x's fdlopen.cyr references
    # dynlib_auxv_get / dynlib_read_auxv (auxv-based loader base
    # resolution), and cyrius is single-pass. dynlib pulls fnptr +
    # result via its own includes.
    "dynlib",
    "fdlopen",
    "freelist",
    "thread",
    "atomic",
    "sync",
    # thread_local MUST follow thread and precede sigil. sigil 3.7.14's
    # crypto_scratch exercises the TLS path; without thread_local's
    # storage the binaries link clean but SIGILL at first crypto use
    # (exit 132). Latent through sigil ≤3.7.12 (3.7.10's crypto_scratch
    # never hit the TLS path), surfaced by the 3.7.14 bump at 2.7.6.
    # See libro 2.7.4 CHANGELOG for the original diagnosis.
    "thread_local",
    "sakshi",
    # NOTE: the pre-6.1 `bigint` stdlib module was retired — sigil 3.x
    # bundles its own u256/u384 (`bigint_ext`) inline, and bote has no
    # direct big-integer use, so no replacement entry is needed. (`ganita`
    # in 6.1.x is an unrelated linear-algebra / matrix module, not bigint.)
    # ct / keccak / random must precede sigil — cyrius is single-pass
    # and sigil 3.x's ML-DSA + AES-GCM surfaces reference ct_eq_bytes_lens,
    # ct_select, _keccak_*, shake256, random_bytes. bote itself only
    # consumes sha256_hex; the linker needs these declared even if DCE
    # prunes most call sites. See phylax 1.1.1 CHANGELOG for the
    # original write-up of this pull-through.
    "ct",
    "keccak",
    "random",
    "sigil",
    "tls",
    "sandhi",
    # ws_server lives only in src/transport_ws.cyr + tests/bote_ws.tcyr
    # — auto-injecting it would burn compile-source budget in every
    # other test file. Kept out of [deps] stdlib; pulled in manually by
    # the ws-specific entry/test files only. 2.7.2 cyrius 5.10.x cap fix.
]

# libro audit chain — single-file dist bundle. cyrius deps clones
# libro at the tag and copies dist/libro.cyr into lib/libro.cyr.
# That's the only file we include from main.cyr; the bundle is
# self-contained (no further includes).
#
# patra (lib/patra.cyr, the audit store) arrives via libro's own
# `[deps.patra]` manifest block — NOT via `dist/libro.deps`, which
# lists only the 22 stdlib leaves and contains no patra entry. The
# mechanism matters: a sidecar leaf and a nested manifest dep resolve
# differently. (Corrected at 3.2.0; the comment claimed the sidecar.)
#
# 2.8.4 appends a 5th field to `struct chain` (`streaming`, 32 -> 40
# bytes) for the new `chain_new_streaming()` write-through
# constructor. Appended, so src/libro_tools.cyr's raw +0 offset read
# is unaffected; bote still calls plain `chain_new()`.
# 2.8.5 is what lets bote's defensive `[deps.sakshi]` go: it bumps libro's own
# `[deps.patra]` 1.12.12 -> 1.13.0, terminating the stale-sakshi chain three
# levels down. It also moves `[deps.sigil]` / `[deps.sigil_tpm]` 3.12.1 -> 3.12.7
# (the PKCS#1 v1.5 and RSA-PSS bypasses) — libro fed the overlay through BOTH
# pins, not just patra. ⚠ libro's sidecar no longer declares `sakshi`; bote is
# unaffected because it declares `"sakshi"` in its own `[deps].stdlib` above,
# but do not remove that declaration on the assumption libro supplies it.
[deps.libro]
git = "https://github.com/MacCracken/libro"
path = "../libro"
tag = "2.8.5"
modules = ["dist/libro.cyr"]

# majra pub/sub — same single-file dist bundle pattern. The default
# profile is bote-appropriate (core pubsub engine without backends);
# upgrade to `dist/majra-signed.cyr` or `-backends.cyr` if a future
# bote transport ever needs signed envelopes or network backends.
[deps.majra]
git = "https://github.com/MacCracken/majra"
path = "../majra"
tag = "2.6.3"
modules = ["dist/majra.cyr"]

# ── `[deps.sakshi]` DELETED at 3.3.1 — both of its preconditions landed ──
#
# It was a FORWARD pin (2.4.8 -> 2.4.10), defensive against a transitive chain
# and NOT against anything bote wants: bote references zero sakshi symbols
# directly; it sits in `[deps].stdlib` only because libro links it.
#
# ⚠ **Removing it was tried EARLIER at 3.3.1 and made things worse**, which is
# why the mechanism is kept here rather than the conclusion. `sakshi` is in
# `[deps].stdlib`, so deleting the block looked like a pure simplification that
# would let the module track the fold. What actually happened:
#
#     cyrius deps --no-lock  ->  lib/sakshi.cyr = 2.4.2   (stale stdlib registry)
#     cyrius lib sync --full ->  lib/sakshi.cyr = 2.4.10  (the fold, correct)
#     cyrius deps --lock     ->  lib/sakshi.cyr = 2.4.10  (still correct)
#     cyrius build           ->  lib/sakshi.cyr = 2.4.2   (implicit resolve, WRONG)
#
# The three-step ends clean and the very next build silently reverts it — which
# is why this must be verified AFTER a build, never after the sync.
#
# The source was three levels down and was never bote's:
#
#     bote -> [deps.libro] 2.8.4 -> [deps.patra] 1.12.12 -> [deps.sakshi] 2.4.2
#
# ✅ **Both blockers are now cleared (2026-08-12):**
#
#   1. cyrius **6.5.20 re-folds patra 1.13.0** — `lib/patra.cyr` in the snapshot
#      reads `# Version: 1.13.0`, and 1.13.0 carries zero `[deps.*]` blocks.
#   2. **libro 2.8.5 bumps `[deps.patra]` 1.12.12 -> 1.13.0**, terminating the
#      chain. ⚠ libro deliberately KEPT the block rather than deleting it: bote
#      consumes `dist/libro.cyr`, which calls `patra_*` 54 times and defines
#      none, and bote declares no patra of its own — so bote can only get patra
#      by resolving libro's `[deps.patra]` transitively. Deleting it there would
#      strand bote. libro's manifest carries the measurement.
#
# Verified after a `cyrius build` (not after the three-step) that `lib/sakshi.cyr`
# holds at the snapshot's 2.4.10 with this block gone.
#
# ⚠ **If a sakshi pin is ever reintroduced here, note the bundle hazard**: bote
# publishes `dist/bote.cyr` and `dist/bote-core.cyr`, and on a bundle-publishing
# library a git dep can make `cyrius distlib` reclassify a module OUT of the
# stdlib leaves and drop it from the `.deps` sidecars, breaking clean-room
# consumers. kavach hit exactly that.

# sigil crypto — pinned explicitly to the self-contained single-file
# dist bundle (same pattern as libro / majra). The stdlib registry has
# historically lagged the self-contained sigil bundle (the 6.1.x
# registry resolved `sigil` to 3.7.10, whose `dist/sigil.cyr` dangled a
# guarded `include "src/sha_ni.cyr"` / `include "src/aes_ni.cyr"` that
# broke single-file consumers). 3.7.12 inlined the SHA-NI / AES-NI banks
# and 3.7.14 keeps the bundle self-contained, so the explicit pin both
# upgrades to the fixed bundle and stops `cyrius deps` from clobbering
# lib/sigil.cyr with a stale registry version. bote consumes sha256 /
# hmac_sha256 / ed25519_init (src/jwt.cyr, src/pkce.cyr); ct / keccak /
# random still precede it via [deps] stdlib for the single-pass forward
# refs, and thread_local now precedes sigil for its TLS crypto_scratch
# path (3.7.14 SIGILL guard — see the [deps] stdlib note above).
#
# 3.12.1 makes that ordering guard load-bearing for a SECOND reason:
# the crypto-bank TLS slot moved from a hardcoded literal 8 to an
# allocator-claimed slot via `thread_local_alloc()` (CAS-gated
# `_sigil_ensure_slot`). It is the only change in 3.12.1.
#
# 3.2.0 also realigns tag ↔ lock. 3.1.4 shipped `tag = "3.12.0"` while
# cyrius.lock already recorded 3.12.1's dist hash (292e0a2d…) — the
# local `path = "../sigil"` override vendored the 3.12.1 body and
# masked it, exactly the drift the 3.1.4 CHANGELOG called out for
# libro. A clean git+tag CI checkout would have vendored 3.12.0
# (c36d26a0…) and failed `cyrius deps --verify`. Tag, lock and
# vendored body now agree.
# ⚠ **`[deps.sigil]` was REMOVED at 3.3.1, and it was pinning bote to a sigil
# with two known authentication bypasses.** Same mechanism as the sakshi block
# above: `sigil` is already in `[deps].stdlib`, sigil is FOLDED INTO the cyrius
# stdlib snapshot, and this git dep overlaid the fold — so bote and every
# consumer that resolves through bote's manifest built **3.12.1** while the
# 6.5.19 snapshot ships **3.12.7**. What that skipped:
#
#   * **3.12.5 — PKCS#1 v1.5 verify accepted forged signatures.** The two
#     operands of the final compare lived in `cbank()`-banked file-scope globals,
#     so a lane collision let one thread's valid pair satisfy another thread's
#     check. Measured by the reporting consumer at **888 forged accepted of
#     400,000**, alongside 70% of *valid* signatures wrongly rejected.
#   * **3.12.6 — the same class in RSA-PSS**, which is what TLS 1.3
#     CertificateVerify runs through (`lib/tls_native_hs13.cyr`). bote makes
#     outbound TLS and terminates it in `src/transport_http.cyr` /
#     `transport_streamable.cyr` / `transport_ws.cyr`, so this is on bote's own
#     peer-authentication path, not a theoretical one. Root cause was a cyrius
#     tail-call frame-release bug, fixed in 6.5.14 — which this pin also predated.
#   * 3.12.2-3.12.4: public-exponent modexp schedule, and the first two stages of
#     the lane localisation.
#
# bote's own JWT is HS256 (`hmac_sha256`) and PKCE is SHA-256, neither of which
# touches the RSA paths — but the TLS transports do, and a consumer inheriting
# this downgrade gets it everywhere.
#
# The original reason for the pin is also gone. It read: the stdlib *registry*
# lagged the self-contained bundle (the 6.1.x registry resolved `sigil` to
# 3.7.10, whose `dist/sigil.cyr` dangled guarded `include "src/sha_ni.cyr"` /
# `"src/aes_ni.cyr"` lines that broke single-file consumers). 3.7.12 inlined
# those banks; the fold has been self-contained since. There is no registry left
# to outrun.
#
# ⚠ **Ordering in `[deps].stdlib` is still load-bearing and did not change.**
# `ct` / `keccak` / `random` must precede `sigil` (single-pass forward refs to
# `ct_eq_bytes_lens`, `ct_select`, `_keccak_*`, `shake256`, `random_bytes`), and
# `thread_local` must precede it too — without TLS storage the binaries link
# clean and then SIGILL at first crypto use (exit 132). That guard became
# load-bearing for a second reason at 3.12.1, when the crypto-bank TLS slot moved
# from a hardcoded literal 8 to a CAS-gated `thread_local_alloc()`.
#
# ⚠ Same rule as sakshi: **do not re-add this as a git dep.** It would reclassify
# sigil out of the stdlib leaves in `dist/bote.deps` and break clean-room
# consumers.
