[package]
name = "bote"
version = "${file:VERSION}"
description = "MCP core service in Cyrius — JSON-RPC 2.0, six transports, bearer auth + JWT HS256 + RFC 7636 PKCE, prompts / resources / completion, libro audit tools, content blocks with annotations, host registry + IPv4/IPv6 SSRF guard, pluggable sandbox runner (kavach shape)"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/bote"
language = "cyrius"
cyrius = "6.6.6"

[build]
entry = "src/main.cyr"
output = "build/bote"

# Modules `cyrius distlib` bundles into dist/bote.cyr — the full surface that
# consumers (phylax, t-ron, sutra, jalwa, rasa, mneme, …) vendor as one file.
# Order matches the include order in src/main.cyr: cyrius is single-pass, so
# a module must follow everything it references.
#
# audit_libro and libro_tools need a live libro chain, which is why they are
# here and not in [lib.core].
#
#   cyrius distlib       → dist/bote.cyr       (this profile, 30 modules)
#   cyrius distlib core  → dist/bote-core.cyr  ([lib.core], 12 modules)
[lib]
modules = [
    "src/error.cyr",
    "src/protocol.cyr",
    "src/jsonx.cyr",
    "src/registry.cyr",
    "src/prompts.cyr",
    "src/resources.cyr",
    "src/events.cyr",
    "src/audit.cyr",
    "src/audit_libro.cyr",
    "src/events_majra.cyr",
    "src/dispatch.cyr",
    "src/codec.cyr",
    "src/schema.cyr",
    "src/stream.cyr",
    "src/session.cyr",
    "src/discovery.cyr",
    "src/auth.cyr",
    "src/jwt.cyr",
    "src/pkce.cyr",
    "src/transport_stdio.cyr",
    "src/transport_http.cyr",
    "src/transport_unix.cyr",
    "src/bridge.cyr",
    "src/transport_streamable.cyr",
    "src/transport_ws.cyr",
    "src/content.cyr",
    "src/host.cyr",
    "src/libro_tools.cyr",
    "src/fs_tools.cyr",
    "src/web_tools.cyr",
]

# Transport-free profile for consumers that wrap bote's Dispatcher / Registry /
# Prompts / Resources / Audit surface but supply their own transport (e.g.
# t-ron's SecurityGate). Excludes the transports, auth, session, discovery,
# host, audit_libro and events_majra. Contract: DEPS-PATTERN.md.
#
# content.cyr is deliberately LAST: it calls `_json_emit_escaped`, which
# dispatch.cyr defines. Its only other references are already in the core
# closure, so it adds no stdlib leaf to dist/bote-core.deps.
[lib.core]
modules = [
    "src/error.cyr",
    "src/protocol.cyr",
    "src/jsonx.cyr",
    "src/registry.cyr",
    "src/prompts.cyr",
    "src/resources.cyr",
    "src/events.cyr",
    "src/audit.cyr",
    "src/dispatch.cyr",
    "src/codec.cyr",
    "src/schema.cyr",
    "src/content.cyr",
]

# Stdlib modules `cyrius deps` copies into lib/ (gitignored). Mirrors the
# include order at the top of src/main.cyr. The order is load-bearing:
#
#   * dynlib before fdlopen — fdlopen reaches dynlib_auxv_get.
#   * thread, thread_local before sigil — sigil's crypto scratch lives in TLS;
#     without the storage the binary links clean and SIGILLs (exit 132) at
#     first crypto use.
#   * ct, keccak, random before sigil — forward references to
#     ct_eq_bytes_lens, ct_select, _keccak_*, shake256, random_bytes.
#
# sakshi is listed because libro links it, not because bote calls it.
#
# sigil, sakshi and patra arrive through this fold. There is no `deps.sigil`
# or `deps.sakshi` block and none should be added: a git dep over a folded
# module overlays the snapshot with a pin that goes stale, and on a
# bundle-publishing library it reclassifies the module OUT of the stdlib
# leaves in the dist/*.deps sidecars, breaking clean-room consumers.
#
# ws_server is deliberately absent: src/transport_ws.cyr and
# tests/bote_ws.tcyr include it by hand so no other unit pays its
# compile-source cost.
#
# No comments inside the array.
[deps]
stdlib = [
    "string",
    "fmt",
    "alloc",
    "vec",
    "str",
    "slice",
    "syscalls",
    "io",
    "args",
    "assert",
    "hashmap",
    "bayan",
    "fnptr",
    "chrono",
    "tagged",
    "net",
    "async",
    "dynlib",
    "fdlopen",
    "freelist",
    "thread",
    "atomic",
    "sync",
    "thread_local",
    "sakshi",
    "ct",
    "keccak",
    "random",
    "sigil",
    "tls",
    "sandhi",
]

# Two rules for the git deps below.
#
# 1. Write `deps.NAME` in comments, never the bracketed section header:
#    distlib's sidecar scan is unanchored and can match comment prose.
#
# 2. `path` beats `tag` when the sibling checkout resolves, and skips
#    commit-pin verification — a local checkout vendors the WORKING TREE and
#    masks a wrong tag. Verify the vendored bytes against the tag before a
#    release, and verify transitive versions AFTER `cyrius build` (it does an
#    implicit resolve), never after `cyrius deps` alone.

# libro audit chain — self-contained single-file bundle. patra (lib/patra.cyr,
# the audit store) arrives through libro's own `deps.patra` block, not through
# dist/libro.deps.
#
# Struct-layout contract: src/libro_tools.cyr reads `struct chain` and
# `struct entry` by raw offset (libro exposes no getters for them) and
# `struct error` through libro's #derive(accessors) getters. A field APPENDED
# to a struct is safe for a raw reader to ignore; a field INSERTED AT THE
# FRONT moves everything. Check both structs on every bump.
[deps.libro]
git = "https://github.com/MacCracken/libro"
path = "../libro"
tag = "2.10.3"
modules = ["dist/libro.cyr"]

# majra pub/sub — default profile (core pubsub engine, no backends). bote uses
# pubsub_new / pubsub_subscribe / pubsub_publish only. Move to
# dist/majra-signed.cyr or -backends.cyr only if a transport ever needs signed
# envelopes or network backends.
[deps.majra]
git = "https://github.com/MacCracken/majra"
path = "../majra"
tag = "2.9.1"
modules = ["dist/majra.cyr"]
