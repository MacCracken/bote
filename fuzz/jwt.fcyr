# Fuzz: a bearer token is a client's bytes, read before anything has judged them, so a
# crash is a remote crash and a byte kept is a slow one. Each property has its own exit:
#
#   10  _jwt_b64u_a takes only what the encoder writes, and what it takes decodes as
#       bayan's does, on every substitution of every encoded text;
#   20  any byte of a good token, changed to anything else, gets it refused: a token
#       has one spelling, and a signature covers all of it;
#   30  nothing a token holds, signed or not, crashes the claim reads;
#   40  refusing a token leaves nothing on the heap;
#   50  a JWK Set of any bytes neither crashes the loader nor loads a key from a set the
#       check refused;
#   60  a scope is held exactly when a plain split of the list holds it, and a chain of
#       rules reaches what a transitive closure says, on every graph of four scopes.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"
include "lib/fnptr.cyr"
include "lib/chrono.cyr"
include "lib/tagged.cyr"
include "lib/freelist.cyr"
include "lib/thread.cyr"
include "lib/thread_local.cyr"  # sigil 3.7.14 TLS crypto_scratch — SIGILL guard
include "lib/sakshi.cyr"
include "lib/sigil.cyr"

include "src/log.cyr"
include "src/error.cyr"
include "src/protocol.cyr"
include "src/jsonx.cyr"
include "src/jwt.cyr"
include "tests/fixtures/jwt_vectors.cyr"

alloc_init();
sakshi_set_level(SK_ERROR);

var _KEY = "0123456789abcdef0123456789abcdef";
var _AUD = "https://mcp.example.com/mcp";
var _sub = "\x01\t\n \"'\\/:.-_=+,{}[]0AZaz\x7F\xC3\xFF";
var _buf = alloc(2048);

fn _mint(payload) {
    var hdr = "{\"alg\":\"HS256\"}";
    var sb = str_builder_new();
    str_builder_add_cstr(sb, base64url_encode(hdr, strlen(hdr)));
    str_builder_add_cstr(sb, ".");
    str_builder_add_cstr(sb, base64url_encode(payload, strlen(payload)));
    var input = str_data(str_builder_build(sb));
    var mac = alloc(32);
    hmac_sha256(_KEY, strlen(_KEY), input, strlen(input), mac);
    var out = str_builder_new();
    str_builder_add_cstr(out, input);
    str_builder_add_cstr(out, ".");
    str_builder_add_cstr(out, base64url_encode(mac, 32));
    return str_data(str_builder_build(out));
}

# Ours against bayan's, on `enc` and every substitution of it.
fn _decode_case(enc) {
    var n = strlen(enc);
    var i = 0;
    while (i <= n) {
        var si = 0;
        while (si < strlen(_sub)) {
            memcpy(_buf, enc, n);
            store8(_buf + n, 0);
            if (i < n) { store8(_buf + i, load8(_sub + si)); }
            var ol[8];
            var ours = _jwt_b64u_a(bote_req_begin(), _buf, n, &ol);
            if (ours != 0) {
                var theirs = base64url_decode(_buf, n);
                if (theirs == 0 || load64(theirs + 8) != load64(&ol)) { sys_exit(10); }
                if (memeq(ours, load64(theirs), load64(&ol)) == 0) { sys_exit(10); }
                var again = base64url_encode(ours, load64(&ol));
                if (streq(again, _buf) == 0) { sys_exit(10); }
            }
            si = si + 1;
        }
        i = i + 1;
    }
    return 0;
}

var plain = alloc(64);
var pl = 0;
while (pl < 40) {
    var fi = 0;
    while (fi < pl) {
        store8(plain + fi, (fi * 37 + pl * 11) % 256);
        fi = fi + 1;
    }
    _decode_case(base64url_encode(plain, pl));
    pl = pl + 1;
}

var s = jwt_secret_with_audience(jwt_secret_new(_KEY), _AUD);
var iss = vec_new();
vec_push(iss, "https://as.example.com");
jwt_secret_with_issuers(s, iss);

var good = _mint("{\"aud\":[\"x\",\"https://mcp.example.com/mcp\"],\"iss\":\"https://as.example.com\",\"exp\":4102444800}");
if (auth_validator_jwt_hs256(good, s) == 0) { sys_exit(20); }

var gn = strlen(good);
var mut = alloc(gn + 1);
var gi = 0;
while (gi < gn) {
    var c = 1;
    while (c < 256) {
        if (c != load8(good + gi)) {
            memcpy(mut, good, gn + 1);
            store8(mut + gi, c);
            bote_req_begin();
            if (auth_validator_jwt_hs256(mut, s) != 0) { sys_exit(20); }
        }
        c = c + 1;
    }
    gi = gi + 1;
}

# A signed token holding anything: the claim reads run on it.
var claims = "{\"aud\":[\"a\",{\"b\":[1]},\"https://mcp.example.com/mcp\"],\"iss\":\"https://as.example.com\",\"nbf\":5,\"exp\":4102444800}";
var cn = strlen(claims);
var ci = 0;
while (ci < cn) {
    var si2 = 0;
    while (si2 < strlen(_sub)) {
        memcpy(_buf, claims, cn);
        store8(_buf + cn, 0);
        store8(_buf + ci, load8(_sub + si2));
        var tok = _mint(_buf);
        bote_req_begin();
        auth_validator_jwt_hs256(tok, s);
        si2 = si2 + 1;
    }
    ci = ci + 1;
}

# Refusing costs the heap nothing.
var before = alloc_used();
var hi = 0;
while (hi < 200) {
    bote_req_begin();
    auth_validator_jwt_hs256("eyJhbGciOiJIUzI1NiJ9.e30.AAAA", s);
    memcpy(mut, good, gn + 1);
    store8(mut + gn - 3, 65);
    auth_validator_jwt_hs256(mut, s);
    hi = hi + 1;
}
if (alloc_used() != before) { sys_exit(40); }

# Every bit-flipped byte of a good token, on keys a verify of which takes milliseconds, so
# one change a byte and not 255.
var ks = jwt_secret_with_audience(jwt_secret_from_jwks(JV_JWKS), JV_AUD);
fn _flip_case(tok) {
    if (auth_validator_jwt(tok, ks) == 0) { sys_exit(20); }
    var n = strlen(tok);
    var t = alloc(n + 1);
    var i = 0;
    while (i < n) {
        memcpy(t, tok, n + 1);
        store8(t + i, load8(t + i) ^ 1);
        bote_req_begin();
        if (auth_validator_jwt(t, ks) != 0) { sys_exit(20); }
        i = i + 1;
    }
    return 0;
}
_flip_case(JV_RS_GOOD);
_flip_case(JV_ES_GOOD);

fn _jwks_sweep(set) {
    var n = strlen(set);
    var t = alloc(n + 1);
    var i = 0;
    while (i < n) {
        var si = 0;
        while (si < strlen(_sub)) {
            memcpy(t, set, n + 1);
            store8(t + i, load8(_sub + si));
            var why = jwt_jwks_check(t);
            var sec = jwt_secret_from_jwks(t);
            if ((why == 0) != (sec != 0)) { sys_exit(50); }
            si = si + 1;
        }
        i = i + 1;
    }
    return 0;
}
_jwks_sweep(JV_JWKS_ONE_EC);
_jwks_sweep(JV_JWKS_ONE_RSA);

# 1 when splitting `list` on spaces gives `want`.
fn _split_holds(list, want) {
    var n = strlen(list);
    var w = alloc_via(bote_req_alloc(), n + 1);
    var s = 0;
    var i = 0;
    while (i <= n) {
        if (i == n || load8(list + i) == 32) {
            memcpy(w, list + s, i - s);
            store8(w + i - s, 0);
            if (i > s && streq(w, want) == 1) { return 1; }
            s = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

fn _scope_case(tok, want) {
    var a = bote_req_begin();
    var got = jwt_scope_check(tok, want, 0);
    var dot1 = _jwt_dot(tok, strlen(tok), 0);
    var dot2 = _jwt_dot(tok, strlen(tok), dot1 + 1);
    var plen[8];
    var payload = _jwt_b64u_a(a, tok + dot1 + 1, dot2 - dot1 - 1, &plen);
    var list = _jwt_granted_a(a, payload, load64(&plen));
    var expect = 0;
    if (list != 0) { expect = _split_holds(list, want); }
    if (got != expect) { sys_exit(60); }
    return 0;
}

var sc_seed = "{\"scope\":\" a ab  files:read files \",\"scp\":[\"b\",\"c d\",5,{\"e\":1},\"f\"]}";
var sc_scp = "{\"sub\":\"x\",\"scp\":[\"b\",\"c d\",5,{\"e\":1},\"f\",[\"g\"]]}";
fn _scope_sweep(seed) {
    var n = strlen(seed);
    var i = 0;
    while (i < n) {
        var si = 0;
        while (si < strlen(_sub)) {
            memcpy(_buf, seed, n);
            store8(_buf + n, 0);
            store8(_buf + i, load8(_sub + si));
            var tok = _mint(_buf);
            _scope_case(tok, "a");
            _scope_case(tok, "ab");
            _scope_case(tok, "files");
            _scope_case(tok, "files:read");
            _scope_case(tok, "b");
            _scope_case(tok, "c");
            _scope_case(tok, "f");
            si = si + 1;
        }
        i = i + 1;
    }
    return 0;
}
_scope_sweep(sc_seed);
_scope_sweep(sc_scp);

# Every directed graph on four scopes, against a closure worked out another way.
var sc_names = vec_new();
vec_push(sc_names, "p");
vec_push(sc_names, "q");
vec_push(sc_names, "r");
vec_push(sc_names, "t");
var graph = 0;
while (graph < 4096) {
    var rules = jwt_scope_rules_new();
    var reach = alloc(16);
    var bit = 0;
    var gb = 0;
    while (gb < 4) {
        var gn2 = 0;
        while (gn2 < 4) {
            if (gb != gn2) {
                if ((graph >> bit) & 1 == 1) {
                    jwt_scope_rule(rules, vec_get(sc_names, gb), vec_get(sc_names, gn2));
                    store8(reach + gb * 4 + gn2, 1);
                }
                bit = bit + 1;
            }
            gn2 = gn2 + 1;
        }
        store8(reach + gb * 4 + gb, 1);
        gb = gb + 1;
    }
    var k = 0;
    while (k < 4) {
        var ri = 0;
        while (ri < 16) {
            var ra = ri / 4;
            var rb = ri % 4;
            if (load8(reach + ra * 4 + k) == 1 && load8(reach + k * 4 + rb) == 1) { store8(reach + ri, 1); }
            ri = ri + 1;
        }
        k = k + 1;
    }
    var from = 0;
    while (from < 4) {
        var to = 0;
        while (to < 4) {
            var al = bote_req_begin();
            if (_jwt_scope_held(al, vec_get(sc_names, from), vec_get(sc_names, to), rules) != load8(reach + from * 4 + to)) { sys_exit(60); }
            to = to + 1;
        }
        from = from + 1;
    }
    graph = graph + 1;
}

sys_exit(0);
