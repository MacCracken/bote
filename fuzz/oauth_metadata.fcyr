# Fuzz: what an operator configures goes out inside a quoted header parameter and a JSON
# document, on every 401 and to anyone who asks. Each property has its own exit code:
#
#   10  whatever bote_prm_check accepts cannot leave its parameter: the challenge is one
#       line, with exactly the quotes bote wrote;
#   20  the document is valid JSON that reads back as what was configured;
#   30  a tool that requires a scope runs for no token without it, on any substitution of
#       a request: a gate that reads a body one way and a dispatcher that reads it
#       another is how a check like this is walked around;
#   40  and refusing such a call leaves nothing on the heap.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/hashmap.cyr"
include "lib/bayan.cyr"
include "lib/fnptr.cyr"
include "lib/chrono.cyr"
include "lib/tagged.cyr"
include "lib/net.cyr"
include "lib/async.cyr"
include "lib/fdlopen.cyr"
include "lib/tls.cyr"
include "lib/sandhi.cyr"
include "lib/freelist.cyr"
include "lib/thread.cyr"
include "lib/thread_local.cyr"  # sigil 3.7.14 TLS crypto_scratch — SIGILL guard
include "lib/sakshi.cyr"
include "lib/sigil.cyr"
include "lib/patra.cyr"
include "lib/libro.cyr"
include "lib/majra.cyr"

include "src/log.cyr"
include "src/error.cyr"
include "src/protocol.cyr"
include "src/jsonx.cyr"
include "src/registry.cyr"
include "src/prompts.cyr"
include "src/resources.cyr"
include "src/events.cyr"
include "src/audit.cyr"
include "src/audit_libro.cyr"
include "src/events_majra.cyr"
include "src/dispatch.cyr"
include "src/codec.cyr"
include "src/schema.cyr"
include "src/stream.cyr"
include "src/session.cyr"
include "src/auth.cyr"
include "src/http_era.cyr"
include "src/oauth_metadata.cyr"
include "src/listen.cyr"

alloc_init();
sakshi_set_level(SK_ERROR);

var _sub = "\x01\t\n\r \"'\\/:?#@%.[]{}<>^`|~0aZ\x7F\xC3\xFF";

fn _count(s, c) {
    var n = 0;
    var i = 0;
    while (load8(s + i) != 0) {
        if (load8(s + i) == c) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn _judge(resource, server, scope) {
    var servers = vec_new();
    vec_push(servers, server);
    var scopes = vec_new();
    vec_push(scopes, scope);
    if (bote_prm_check(resource, servers, scopes) != 0) { return 0; }
    var p = bote_prm_new(resource, servers, scopes, "name");
    if (p == 0) { sys_exit(10); }
    var c = bote_prm_challenge(p);
    if (_count(c, 13) != 0 || _count(c, 10) != 0 || _count(c, 92) != 0 || _count(c, 34) != 4) { sys_exit(10); }
    var j = bote_prm_json(p);
    if (jsonx_valid(j, strlen(j)) == 0) { sys_exit(20); }
    var a = default_alloc();
    var got = jsonx_get_str_dec_a(a, j, "resource");
    if (got == 0 || streq(got, resource) == 0) { sys_exit(20); }
    return 1;
}

# `s` with each byte replaced by each of _sub, and each result passed to `f`.
fn _sweep(which, s) {
    var n = strlen(s);
    var t = alloc(n + 1);
    var i = 0;
    while (i < n) {
        var si = 0;
        while (si < strlen(_sub)) {
            memcpy(t, s, n);
            store8(t + n, 0);
            store8(t + i, load8(_sub + si));
            if (which == 0) { _judge(t, "https://as.example.com", "files:read"); }
            elif (which == 1) { _judge("https://mcp.example.com/mcp", t, "files:read"); }
            else { _judge("https://mcp.example.com/mcp", "https://as.example.com", t); }
            si = si + 1;
        }
        i = i + 1;
    }
    return 0;
}

if (_judge("https://mcp.example.com/mcp", "https://as.example.com", "files:read") != 1) { sys_exit(10); }
_sweep(0, "https://mcp.example.com:8443/a/mcp");
_sweep(0, "http://127.0.0.1:8390/mcp");
_sweep(1, "https://as.example.com/tenant");
_sweep(2, "files:read");

var _ran = 0;
fn _h_scoped(args, claims) {
    _ran = _ran + 1;
    return "{\"content\":[]}";
}
fn _never(claims, scope, ctx) { return 0; }

var sreg = tool_registry_new();
var sneed = vec_new();
vec_push(sneed, "files:write");
registry_register(sreg, tool_def_with_required_scopes(tool_def_new("s", "Scoped", schema_new("object", 0, vec_new())), sneed));
var sd = dispatcher_new(sreg);
dispatcher_handle(sd, "s", &_h_scoped);
dispatcher_set_scope_check(sd, &_never, 0);

var gate_seeds = vec_new();
vec_push(gate_seeds, "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/call\",\"params\":{\"name\":\"s\",\"arguments\":{\"a\":1}}}");
vec_push(gate_seeds, "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/call\",\"params\":{\"name\":\"\\u0073\",\"name\":\"s\"}}");
vec_push(gate_seeds, "[{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/call\",\"params\":{\"name\":\"s\"}},{\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"tools/call\",\"params\":{\"name\":\"s\"}}]");
vec_push(gate_seeds, "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/call\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\",\"io.modelcontextprotocol/clientCapabilities\":{}},\"name\":\"s\"}}");
var gate_subs = "\x01\t\n \"'\\/{}[]:,su0A\xC3\xFF";
var gate_buf = alloc(4096);

fn _gate_sweep() {
    var si = 0;
    while (si < vec_len(gate_seeds)) {
        var seed = vec_get(gate_seeds, si);
        var n = strlen(seed);
        var i = 0;
        while (i < n) {
            var bi = 0;
            while (bi < strlen(gate_subs)) {
                memcpy(gate_buf, seed, n);
                store8(gate_buf + i, load8(gate_subs + bi));
                store8(gate_buf + n, 0);
                var a = bote_req_begin();
                var hc[40];
                bote_http_ctx(&hc, 0 - 1, "fuzz", gate_buf, n, 0);
                if (bote_http_scope_gate(&hc, sd, gate_buf, "a-token", 0) == 0) {
                    codec_process_message_a(a, gate_buf, sd, "a-token");
                }
                if (_ran != 0) { sys_exit(30); }
                bi = bi + 1;
            }
            i = i + 1;
        }
        si = si + 1;
    }
    return 0;
}

_gate_sweep();
var gate_used = alloc_used();
_gate_sweep();
if (alloc_used() != gate_used) { sys_exit(40); }

sys_exit(0);
