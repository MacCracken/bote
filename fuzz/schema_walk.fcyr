        _add(a, sb, vec_get(_KEYS, _r(vec_len(_KEYS))));
        _add(a, sb, "\":");
        _value(a, sb, depth + 1);
        j = j + 1;
    }
    _add(a, sb, "}");
    return 0;
}

# ---- The reference, on bayan's trees ----

fn _s_is(s, lit) {
    if (s == 0) { return 0; }
    if (str_len(s) != strlen(lit)) { return 0; }
    return memeq(str_data(s), lit, strlen(lit));
}
fn _s_eq(x, y) {
    if (str_len(x) != str_len(y)) { return 0; }
    return memeq(str_data(x), str_data(y), str_len(x));
}
fn _member(v, name) {
    var i = 0;
    while (i < bayan_json_v_obj_len(v)) {
        if (_s_is(bayan_json_v_obj_key(v, i), name) == 1) { return bayan_json_v_obj_val(v, i); }
        i = i + 1;
    }
    return 0;
}
fn _int_kw(s, kw) {
    var m = _member(s, kw);
    if (m == 0 || bayan_json_v_is_int(m) == 0) { return 0 - 99; }
    return bayan_json_v_int(m);
}
# Characters as a client counts them (3.8.6): each maximal part of the bytes is one, a
# sequence whole (a code point) or not (a U+FFFD), the lead byte and each continuation
# byte that still makes a prefix of one (Unicode 3.9, "maximal subparts"). bayan hands back
# bytes that are no UTF-8 as they were, and an escape always decodes whole.
fn _cps(st) {
    var p = str_data(st);
    var n = str_len(st);
    var c = 0;
    var i = 0;
    while (i < n) {
        var b = load8(p + i);
        var need = 0;
        var lo = 128;
        var hi = 191;
        if (b >= 194 && b <= 223) { need = 1; }
        elif (b >= 224 && b <= 239) { need = 2; if (b == 224) { lo = 160; } if (b == 237) { hi = 159; } }
        elif (b >= 240 && b <= 244) { need = 3; if (b == 240) { lo = 144; } if (b == 244) { hi = 143; } }
        var k = 1;
        while (k <= need && i + k < n) {
            var cb = load8(p + i + k);
            var l2 = 128;
            var h2 = 191;
            if (k == 1) { l2 = lo; h2 = hi; }
            if (cb < l2 || cb > h2) { break; }
            k = k + 1;
        }
        c = c + 1;
        i = i + k;
    }
    return c;
}
fn _is_num(v) {
    if (bayan_json_v_is_int(v) == 1) { return 1; }
    return bayan_json_v_is_float(v);
}

# (3.8.7) 1 when the bytes of `st` are UTF-8 throughout: each maximal part a whole sequence.
fn _utf8_ok(st) {
    var p = str_data(st);
    var n = str_len(st);
    var i = 0;
    while (i < n) {
        var b = load8(p + i);
        var need = 0 - 1;
        var lo = 128;
        var hi = 191;
        if (b < 128) { need = 0; }
        elif (b >= 194 && b <= 223) { need = 1; }
        elif (b >= 224 && b <= 239) { need = 2; if (b == 224) { lo = 160; } if (b == 237) { hi = 159; } }
        elif (b >= 240 && b <= 244) { need = 3; if (b == 240) { lo = 144; } if (b == 244) { hi = 143; } }
        if (need < 0) { return 0; }
        var k = 1;
        while (k <= need) {
            if (i + k >= n) { return 0; }
            var cb = load8(p + i + k);
            var l2 = 128;
            var h2 = 191;
            if (k == 1) { l2 = lo; h2 = hi; }
            if (cb < l2 || cb > h2) { return 0; }
            k = k + 1;
        }
        i = i + need + 1;
    }
    return 1;
}
# The bytes of `st` as a client reads them, each maximal part that is no sequence a U+FFFD:
# a cstr with its length at *ol.
fn _client(st, ol) {
    var p = str_data(st);
    var n = str_len(st);
    var o = alloc(n * 3 + 1);
    var w = 0;
    var i = 0;
    while (i < n) {
        var b = load8(p + i);
        var need = 0;
        var lo = 128;
        var hi = 191;
        var bad = 0;
        if (b < 128) { need = 0; }
        elif (b >= 194 && b <= 223) { need = 1; }
        elif (b >= 224 && b <= 239) { need = 2; if (b == 224) { lo = 160; } if (b == 237) { hi = 159; } }
        elif (b >= 240 && b <= 244) { need = 3; if (b == 240) { lo = 144; } if (b == 244) { hi = 143; } }
        else { bad = 1; }
        var k = 1;
        while (bad == 0 && k <= need && i + k < n) {
            var cb = load8(p + i + k);
            var l2 = 128;
            var h2 = 191;
            if (k == 1) { l2 = lo; h2 = hi; }
            if (cb < l2 || cb > h2) { break; }
            k = k + 1;
        }
        if (bad == 0 && k == need + 1) {
            var c = 0;
            while (c < k) { store8(o + w, load8(p + i + c)); w = w + 1; c = c + 1; }
        } else {
            store8(o + w, 239); store8(o + w + 1, 191); store8(o + w + 2, 189);
            w = w + 3;
        }
        i = i + k;
    }
    store64(ol, w);
    return o;
}
# Two strings equal: as a client reads them (`client` 1), or, where a string that is no text
# equals nothing, as their bytes are.
fn _str_eq(x, y, client) {
    if (client == 0) {
        if (_utf8_ok(x) == 0 || _utf8_ok(y) == 0) { return 0; }
        return _s_eq(x, y);
    }
    var lx[8];
    var ly[8];
    var cx = _client(x, &lx);
    var cy = _client(y, &ly);
    if (load64(&lx) != load64(&ly)) { return 0; }
    if (load64(&lx) == 0) { return 1; }
    return memeq(cx, cy, load64(&lx));
}
# JSON Schema's equality on bayan's trees. The pools hold one fraction, 1.5, so two
# fractions are equal and a fraction is no integer.
fn _veq(x, y, client) {
    if (bayan_json_v_is_null(x) == 1) { return bayan_json_v_is_null(y); }
    if (bayan_json_v_is_bool(x) == 1) {
        if (bayan_json_v_is_bool(y) == 0) { return 0; }
        if (bayan_json_v_bool(x) == bayan_json_v_bool(y)) { return 1; }
        return 0;
    }
    if (bayan_json_v_is_int(x) == 1) {
        if (bayan_json_v_is_int(y) == 0) { return 0; }
        if (bayan_json_v_int(x) == bayan_json_v_int(y)) { return 1; }
        return 0;
    }
    if (bayan_json_v_is_float(x) == 1) { return bayan_json_v_is_float(y); }
    if (bayan_json_v_is_str(x) == 1) {
        if (bayan_json_v_is_str(y) == 0) { return 0; }
        return _str_eq(bayan_json_v_str(x), bayan_json_v_str(y), client);
    }
    if (bayan_json_v_is_arr(x) == 1) {
        if (bayan_json_v_is_arr(y) == 0) { return 0; }
        var n = bayan_json_v_arr_len(x);
        if (n != bayan_json_v_arr_len(y)) { return 0; }
        var i = 0;
        while (i < n) { if (_veq(bayan_json_v_arr_get(x, i), bayan_json_v_arr_get(y, i), client) == 0) { return 0; } i = i + 1; }
        return 1;
    }
    if (bayan_json_v_is_obj(x) == 1) {
        if (bayan_json_v_is_obj(y) == 0) { return 0; }
        var m = bayan_json_v_obj_len(x);
        if (m != bayan_json_v_obj_len(y)) { return 0; }
        var j = 0;
        while (j < m) {
            var hit = 0;
            var q = 0;
            while (q < m && hit == 0) {
                if (_s_eq(bayan_json_v_obj_key(x, j), bayan_json_v_obj_key(y, q)) == 1) {
                    if (_veq(bayan_json_v_obj_val(x, j), bayan_json_v_obj_val(y, q), client) == 0) { return 0; }
                    hit = 1;
                }
                q = q + 1;
            }
            if (hit == 0) { return 0; }
            j = j + 1;
        }
        return 1;
    }
    return 0;
}
# 1 when `inst` is of the type a `type` name `nm` (a bayan Str) names.
fn _type_is(nm, inst) {
    if (_s_is(nm, "string") == 1) { return bayan_json_v_is_str(inst); }
    if (_s_is(nm, "integer") == 1) { return bayan_json_v_is_int(inst); }
    if (_s_is(nm, "number") == 1) { return _is_num(inst); }
    if (_s_is(nm, "boolean") == 1) { return bayan_json_v_is_bool(inst); }
    if (_s_is(nm, "null") == 1) { return bayan_json_v_is_null(inst); }
    if (_s_is(nm, "array") == 1) { return bayan_json_v_is_arr(inst); }
    if (_s_is(nm, "object") == 1) { return bayan_json_v_is_obj(inst); }
    return 0;
}

# 1 when the reference finds `inst` valid against `sch`.
var _ROOT = 0;

fn _ok(sch, inst) {
    # (3.8.14) The root a `$dynamicRef` names.
    if (_member(sch, "$dynamicRef") != 0 && _ok(_ROOT, inst) == 0) { return 0; }
    # (3.8.10) The definition a `$ref` names.
    var rf = _member(sch, "$ref");
    if (rf != 0) {
        var rs = bayan_json_v_str(rf);
        var dig = str_data(rs) + str_len(rs) - 1;
        var tgt = _member(_member(_ROOT, "$defs"), _cat_d(load8(dig)));
        if (tgt == 0) { println("reference: a $ref the grammar did not draw"); return 0 - 1; }
        if (_ok(tgt, inst) == 0) { return 0; }
    }
    var t = _member(sch, "type");
    if (t != 0 && bayan_json_v_is_arr(t) == 1) {
        var tok = 0;
        var ti = 0;
        while (ti < bayan_json_v_arr_len(t)) { if (_type_is(bayan_json_v_str(bayan_json_v_arr_get(t, ti)), inst) == 1) { tok = 1; } ti = ti + 1; }
        if (tok == 0) { return 0; }
        t = 0;
    }
    var cst = _member(sch, "const");
    if (cst != 0 && _veq(cst, inst, 0) == 0) { return 0; }
    # (3.8.9) Composition.
    var alo = _member(sch, "allOf");
    if (alo != 0) {
        var aq = 0;
        while (aq < bayan_json_v_arr_len(alo)) { if (_ok(bayan_json_v_arr_get(alo, aq), inst) == 0) { return 0; } aq = aq + 1; }
    }
    var ano = _member(sch, "anyOf");
    if (ano != 0) {
        var ah = 0;
        var anq = 0;
        while (anq < bayan_json_v_arr_len(ano)) { if (_ok(bayan_json_v_arr_get(ano, anq), inst) == 1) { ah = 1; } anq = anq + 1; }
        if (ah == 0) { return 0; }
    }
    var ono = _member(sch, "oneOf");
    if (ono != 0) {
        var oh = 0;
        var onq = 0;
        while (onq < bayan_json_v_arr_len(ono)) { if (_ok(bayan_json_v_arr_get(ono, onq), inst) == 1) { oh = oh + 1; } onq = onq + 1; }
        if (oh != 1) { return 0; }
    }
    var nto = _member(sch, "not");
    if (nto != 0 && _ok(nto, inst) == 1) { return 0; }
    var ifo = _member(sch, "if");
    if (ifo != 0) {
        var bro = _member(sch, "else");
        if (_ok(ifo, inst) == 1) { bro = _member(sch, "then"); }
        if (bro != 0 && _ok(bro, inst) == 0) { return 0; }
    }
    var en = _member(sch, "enum");
    if (en != 0) {
        var found = 0;
        var ei = 0;
        while (ei < bayan_json_v_arr_len(en)) {
            if (_veq(bayan_json_v_arr_get(en, ei), inst, 0) == 1) { found = 1; }
            ei = ei + 1;
        }
        if (found == 0) { return 0; }
    }
    if (t != 0) {
        if (_s_is(bayan_json_v_str(t), "string") == 1 && bayan_json_v_is_str(inst) == 0) { return 0; }
        if (_s_is(bayan_json_v_str(t), "integer") == 1 && bayan_json_v_is_int(inst) == 0) { return 0; }
        if (_s_is(bayan_json_v_str(t), "boolean") == 1 && bayan_json_v_is_bool(inst) == 0) { return 0; }
        if (_s_is(bayan_json_v_str(t), "null") == 1 && bayan_json_v_is_null(inst) == 0) { return 0; }
        if (_s_is(bayan_json_v_str(t), "array") == 1 && bayan_json_v_is_arr(inst) == 0) { return 0; }
        if (_s_is(bayan_json_v_str(t), "object") == 1 && bayan_json_v_is_obj(inst) == 0) { return 0; }
    }
    # (3.8.11) multipleOf, the value and the multiple times four: the values drawn are
    # integers and 1.5, the multiples 2, 3 and 0.5.
    var mof = _member(sch, "multipleOf");
    if (mof != 0 && (bayan_json_v_is_int(inst) == 1 || bayan_json_v_is_float(inst) == 1)) {
        var m4 = 2;
        if (bayan_json_v_is_int(mof) == 1) { m4 = 4 * bayan_json_v_int(mof); }
        var v4 = 6;
        if (bayan_json_v_is_int(inst) == 1) { v4 = 4 * bayan_json_v_int(inst); }
        if (v4 % m4 != 0) { return 0; }
    }
    var pat = _member(sch, "pattern");
    if (pat != 0 && bayan_json_v_is_str(inst) == 1 && _pat_ok(bayan_json_v_str(pat), bayan_json_v_str(inst)) == 0) { return 0; }
    # (3.8.13) format: a string format judges strings, int32 numbers.
    var fmt = _member(sch, "format");
    if (fmt != 0 && _fmt_ref(bayan_json_v_str(fmt), inst) == 0) { return 0; }
    if (bayan_json_v_is_str(inst) == 1) {
        var cp = _cps(bayan_json_v_str(inst));
        var mnl = _int_kw(sch, "minLength");
        if (mnl != 0 - 99 && cp < mnl) { return 0; }
        var mxl = _int_kw(sch, "maxLength");
        if (mxl != 0 - 99 && cp > mxl) { return 0; }
    }
    if (bayan_json_v_is_int(inst) == 1) {
        var iv = bayan_json_v_int(inst);
        var mi = _int_kw(sch, "minimum");
        if (mi != 0 - 99 && iv < mi) { return 0; }
        var ma = _int_kw(sch, "maximum");
        if (ma != 0 - 99 && iv > ma) { return 0; }
        var xi = _int_kw(sch, "exclusiveMinimum");
        if (xi != 0 - 99 && iv <= xi) { return 0; }
        var xa = _int_kw(sch, "exclusiveMaximum");
        if (xa != 0 - 99 && iv >= xa) { return 0; }
    }
    if (bayan_json_v_is_float(inst) == 1) {
        # 1.5 against small integer bounds.
        var fmi = _int_kw(sch, "minimum");
        if (fmi != 0 - 99 && fmi > 1) { return 0; }
        var fma = _int_kw(sch, "maximum");
        if (fma != 0 - 99 && fma < 2) { return 0; }
        var fxi = _int_kw(sch, "exclusiveMinimum");
        if (fxi != 0 - 99 && fxi > 1) { return 0; }
        var fxa = _int_kw(sch, "exclusiveMaximum");
        if (fxa != 0 - 99 && fxa < 2) { return 0; }
    }
    if (bayan_json_v_is_arr(inst) == 1) {
        var it = _member(sch, "items");
        var n = bayan_json_v_arr_len(inst);
        # (3.8.8) prefixItems first, items for the rest; contains counted.
        var pfx = _member(sch, "prefixItems");
        var npx = 0;
        if (pfx != 0) { npx = bayan_json_v_arr_len(pfx); }
        var k = 0;
        while (k < n) {
            if (k < npx) {
                if (_ok(bayan_json_v_arr_get(pfx, k), bayan_json_v_arr_get(inst, k)) == 0) { return 0; }
            } elif (it != 0) {
                if (_ok(it, bayan_json_v_arr_get(inst, k)) == 0) { return 0; }
            }
            k = k + 1;
        }
        var cns = _member(sch, "contains");
        if (cns != 0) {
            var hits = 0;
            var ck = 0;
            while (ck < n) { if (_ok(cns, bayan_json_v_arr_get(inst, ck)) == 1) { hits = hits + 1; } ck = ck + 1; }
            var mnc = _int_kw(sch, "minContains");
            if (mnc == 0 - 99) { mnc = 1; }
            if (hits < mnc) { return 0; }
            var mxc = _int_kw(sch, "maxContains");
            if (mxc != 0 - 99 && hits > mxc) { return 0; }
        }
        var mni = _int_kw(sch, "minItems");
        if (mni != 0 - 99 && n < mni) { return 0; }
        var mxi = _int_kw(sch, "maxItems");
        if (mxi != 0 - 99 && n > mxi) { return 0; }
        var uq = _member(sch, "uniqueItems");
        if (uq != 0 && bayan_json_v_is_bool(uq) == 1 && bayan_json_v_bool(uq) == 1) {
            var ua = 0;
            while (ua < n) {
                var ub = ua + 1;
                while (ub < n) {
                    if (_veq(bayan_json_v_arr_get(inst, ua), bayan_json_v_arr_get(inst, ub), 1) == 1) { return 0; }
                    ub = ub + 1;
                }
                ua = ua + 1;
            }
        }
    }
    if (bayan_json_v_is_obj(inst) == 1) {
        var props = _member(sch, "properties");
        var req = _member(sch, "required");
        var ap = _member(sch, "additionalProperties");
        var nm = bayan_json_v_obj_len(inst);
        var j = 0;
        while (j < nm) {
            var key = bayan_json_v_obj_key(inst, j);
            var val = bayan_json_v_obj_val(inst, j);
            # The first occurrence of a key the schema names; every occurrence of one it does not.
            var named = 0;
            var ps = 0;
            if (props != 0) {
                var pk = 0;
                while (pk < bayan_json_v_obj_len(props)) {
                    if (_s_eq(bayan_json_v_obj_key(props, pk), key) == 1) { named = 1; ps = bayan_json_v_obj_val(props, pk); }
                    pk = pk + 1;
                }
            }
            if (req != 0) {
                var rk = 0;
                while (rk < bayan_json_v_arr_len(req)) {
                    if (_s_eq(bayan_json_v_str(bayan_json_v_arr_get(req, rk)), key) == 1) { named = 1; }
                    rk = rk + 1;
                }
            }
            var first = 1;
            if (named == 1) {
                var q = 0;
                while (q < j) { if (_s_eq(bayan_json_v_obj_key(inst, q), key) == 1) { first = 0; } q = q + 1; }
            }
            if (first == 1) {
                # (3.8.12) Each pattern the key matches judges the value, and a matched key is no
                # additional property.
                var pmatch = 0;
                var ppr = _member(sch, "patternProperties");
                if (ppr != 0) {
                    var pq = 0;
                    while (pq < bayan_json_v_obj_len(ppr)) {
                        if (_pat_ok(bayan_json_v_obj_key(ppr, pq), key) == 1) {
                            pmatch = 1;
                            if (_ok(bayan_json_v_obj_val(ppr, pq), val) == 0) { return 0; }
                        }
                        pq = pq + 1;
                    }
                }
                if (ps != 0) {
                    if (_ok(ps, val) == 0) { return 0; }
                } elif (ap != 0 && pmatch == 0) {
                    if (bayan_json_v_is_bool(ap) == 1) {
                        if (bayan_json_v_bool(ap) == 0) { return 0; }
                    } elif (_ok(ap, val) == 0) { return 0; }
                }
            }
            j = j + 1;
        }
        if (req != 0) {
            var ri = 0;
            while (ri < bayan_json_v_arr_len(req)) {
                var rs = bayan_json_v_str(bayan_json_v_arr_get(req, ri));
                var present = 0;
                var mk = 0;
                while (mk < nm) { if (_s_eq(bayan_json_v_obj_key(inst, mk), rs) == 1) { present = 1; } mk = mk + 1; }
                if (present == 0) { return 0; }
                ri = ri + 1;
            }
        }
        var mnp = _int_kw(sch, "minProperties");
        if (mnp != 0 - 99 && nm < mnp) { return 0; }
        var mxp = _int_kw(sch, "maxProperties");
        if (mxp != 0 - 99 && nm > mxp) { return 0; }
        # (3.8.8) propertyNames as the grammar draws it, by a length or an enum.
        var pns = _member(sch, "propertyNames");
        if (pns != 0) {
            var pml = _int_kw(pns, "maxLength");
            var pen = _member(pns, "enum");
            var pk = 0;
            while (pk < nm) {
                var kk = bayan_json_v_obj_key(inst, pk);
                if (pml != 0 - 99 && _cps(kk) > pml) { return 0; }
                if (pen != 0) {
                    var pf = 0;
                    var pq = 0;
                    while (pq < bayan_json_v_arr_len(pen)) { if (_s_eq(bayan_json_v_str(bayan_json_v_arr_get(pen, pq)), kk) == 1) { pf = 1; } pq = pq + 1; }
                    if (pf == 0) { return 0; }
                }
                pk = pk + 1;
            }
        }
        var dre = _member(sch, "dependentRequired");
        if (dre != 0) {
            var dq = 0;
            while (dq < bayan_json_v_obj_len(dre)) {
                if (_has_key(inst, bayan_json_v_obj_key(dre, dq)) == 1) {
                    var dl = bayan_json_v_obj_val(dre, dq);
                    var dj = 0;
                    while (dj < bayan_json_v_arr_len(dl)) { if (_has_key(inst, bayan_json_v_str(bayan_json_v_arr_get(dl, dj))) == 0) { return 0; } dj = dj + 1; }
                }
                dq = dq + 1;
            }
        }
        var dse = _member(sch, "dependentSchemas");
        if (dse != 0) {
            var dz = 0;
            while (dz < bayan_json_v_obj_len(dse)) {
                if (_has_key(inst, bayan_json_v_obj_key(dse, dz)) == 1 && _ok(bayan_json_v_obj_val(dse, dz), inst) == 0) { return 0; }
                dz = dz + 1;
            }
        }
    }
    return 1;
}

# "d" and the digit `c`.
fn _cat_d(c) {
    var o = alloc(3);
    store8(o, 100);
    store8(o + 1, c);
    store8(o + 2, 0);
    return o;
}

# (3.8.13) The formats the grammar draws, by hand in another form: a date as its digits and
# the days of its month, an ipv4 as four decimal parts with no leading zero to 255, int32 an
# integer from -2^31 to 2^31 - 1 (the pool's numbers are integers and 1.5).
fn _fmt_ref(f, inst) {
    if (_s_is(f, "int32") == 1) {
        if (bayan_json_v_is_float(inst) == 1) { return 0; }
        if (bayan_json_v_is_int(inst) == 1) {
            var iv = bayan_json_v_int(inst);
            if (iv < 0 - 2147483648 || iv > 2147483647) { return 0; }
        }
        return 1;
    }
    if (bayan_json_v_is_str(inst) == 0) { return 1; }
    var st = bayan_json_v_str(inst);
    var d = str_data(st);
    var n = str_len(st);
    if (_s_is(f, "date") == 1) {
        if (n != 10 || load8(d + 4) != 45 || load8(d + 7) != 45) { return 0; }
        var v = vec_new();
        var i = 0;
        var acc = 0;
        while (i <= 10) {
            if (i == 4 || i == 7 || i == 10) { vec_push(v, acc); acc = 0; }
            else {
                var c = load8(d + i);
                if (c < 48 || c > 57) { return 0; }
                acc = acc * 10 + c - 48;
            }
            i = i + 1;
        }
        var y = vec_get(v, 0);
        var m = vec_get(v, 1);
        var dd = vec_get(v, 2);
        var leap = 0;
        if ((y % 400 == 0) || (y % 4 == 0 && y % 100 != 0)) { leap = 1; }
        var days = 31;
        if (m == 2) { days = 28 + leap; }
        elif (m == 4 || m == 6 || m == 9 || m == 11) { days = 30; }
        if (m < 1 || m > 12 || dd < 1 || dd > days) { return 0; }
        return 1;
    }
    # ipv4
    var parts = 0;
    var k = 0;
    var ps = 0;
    while (k <= n) {
        if (k == n || load8(d + k) == 46) {
            var len = k - ps;
            if (len < 1 || len > 3) { return 0; }
            if (len > 1 && load8(d + ps) == 48) { return 0; }
            var o = 0;
            var j = ps;
            while (j < k) {
                var cj = load8(d + j);
                if (cj < 48 || cj > 57) { return 0; }
                o = o * 10 + cj - 48;
                j = j + 1;
            }
            if (o > 255) { return 0; }
            parts = parts + 1;
            ps = k + 1;
        }
        k = k + 1;
    }
    if (parts != 4) { return 0; }
    return 1;
}

# (3.8.11) Each pattern the grammar draws, judged by hand on the string as a client holds it.
fn _pat_ok(p, st) {
    var d = str_data(st);
    var n = str_len(st);
    if (_s_is(p, "^a") == 1) { if (n > 0 && load8(d) == 97) { return 1; } return 0; }
    if (_s_is(p, "b$") == 1) { if (n > 0 && load8(d + n - 1) == 98) { return 1; } return 0; }
    if (_s_is(p, "x") == 1) {
        var i = 0;
        while (i < n) { if (load8(d + i) == 120) { return 1; } i = i + 1; }
        return 0;
    }
    if (_s_is(p, "^[a-c]*$") == 1) {
        var j = 0;
        while (j < n) { var c = load8(d + j); if (c < 97 || c > 99) { return 0; } j = j + 1; }
        return 1;
    }
    # ^.{2}$: two code points, neither a line terminator.
    var k = 0;
    while (k < n) {
        var b = load8(d + k);
        if (b == 10 || b == 13) { return 0; }
        if (b == 226 && k + 2 < n && load8(d + k + 1) == 128 && (load8(d + k + 2) == 168 || load8(d + k + 2) == 169)) { return 0; }
        k = k + 1;
    }
    if (_cps(st) == 2) { return 1; }
    return 0;
}

# 1 when the object `inst` has a member keyed `k` (a bayan Str).
fn _has_key(inst, k) {
    var i = 0;
    while (i < bayan_json_v_obj_len(inst)) {
        if (_s_eq(bayan_json_v_obj_key(inst, i), k) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn main() {
    sakshi_set_level(SK_ERROR);
    _pools();
    var big = bote_req_begin();
    alloc_via(big, 8388608);
    var heap = 0;
    var passed = 0;
    var refused = 0;
    var skipped = 0;
    var round = 0;
    while (round < 20000) {
        var sa = default_alloc();
        # (3.8.10) The definitions first, each naming only those after it, then the root,
        # naming any.
        _ref_n = _r(4);
        _dyn_on = 0;
        if (_r(3) == 0) { _dyn_on = 1; }
        _dyn_ok = 0;
        var dsb = str_builder_new();
        var di = 0;
        while (di < _ref_n) {
            if (di > 0) { _add(sa, dsb, ","); }
            _add(sa, dsb, "\"d");
            _addi(sa, dsb, di);
            _add(sa, dsb, "\":");
            _ref_lo = di + 1;
            _schema(sa, dsb, 1);
            di = di + 1;
        }
        _ref_lo = 0;
        var ssb = str_builder_new();
        _schema(sa, ssb, 0);
        var sch = str_data(str_builder_build(ssb));
        if (_ref_n > 0) {
            var wsb = str_builder_new();
            _add(sa, wsb, "{\"$defs\":{");
            _add(sa, wsb, str_data(str_builder_build(dsb)));
            _add(sa, wsb, "}");
            if (strlen(sch) > 2) { _add(sa, wsb, ","); }
            _add(sa, wsb, sch + 1);
            sch = str_data(str_builder_build(wsb));
        }
        if (_dyn_on == 1) {
            var ysb = str_builder_new();
            _add(sa, ysb, "{\"$dynamicAnchor\":\"r\"");
            if (strlen(sch) > 2) { _add(sa, ysb, ","); }
            _add(sa, ysb, sch + 1);
            sch = str_data(str_builder_build(ysb));
        }
        var prop = parse_property(sch);
        var sv = bayan_json_v_parse_buf(sch, strlen(sch));
        _ROOT = sv;
        var k = 0;
        while (k < 6) {
            var a = bote_req_begin();
            var vsb = str_builder_new_a(a);
            _sb_grow_a(a, vsb, 4096);
            _value(a, vsb, 0);
            var inst = str_data(str_builder_build_a(a, vsb));
            var iv = bayan_json_v_parse_buf(inst, strlen(inst));
            # bayan refuses an object that names a key twice, so it cannot judge that value:
            # bote's reading of one is its unit tests'.
            if (iv == 0) { skipped = skipped + 1; k = k + 1; continue; }
            var want = _ok(sv, iv);
            if (want < 0) { println(sch); return 10; }
            var h0 = alloc_used();
            var got = 0;
            if (_sch_check_value_a(a, prop, "v", inst) == 0) { got = 1; }
            heap = heap + alloc_used() - h0;
            if (got != want) { println(sch); println(inst); println_int(got); return 10; }
            if (got == 1) { passed = passed + 1; } else { refused = refused + 1; }
            k = k + 1;
        }
        round = round + 1;
    }
    if (passed < 1000 || refused < 1000) { println_int(passed); println_int(refused); return 20; }
    if (heap != 0) { println_int(heap); return 30; }
    println("schema_walk: every value bayan parses judged as the reference judges it, 0 heap bytes");
    println_int(passed);
    println_int(refused);
    return 0;
}

var rc = main();
sys_exit_group(rc);
