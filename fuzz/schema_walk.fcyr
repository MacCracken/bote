include "src/audit.cyr"
include "src/dispatch.cyr"
include "src/codec.cyr"
include "src/schema.cyr"


alloc_init();

var _rng = 2718281828459045235;
fn _rand() {
    _rng = _rng ^ (_rng << 13);
    _rng = _rng ^ (_rng >> 7);
    _rng = _rng ^ (_rng << 17);
    if (_rng < 0) { return 0 - _rng; }
    return _rng;
}
fn _r(n) { return _rand() % n; }

var _NAMES = 0;
var _KEYS = 0;
var _STRS = 0;
var _ENUMS = 0;
var _ANYV = 0;
var _TARR = 0;
fn _pools() {
    # (3.8.7) Values a `const` or an `enum` of any value names, and type arrays.
    _ANYV = vec_new();
    vec_push(_ANYV, "\"x\""); vec_push(_ANYV, "\"ab\""); vec_push(_ANYV, "1"); vec_push(_ANYV, "2");
    vec_push(_ANYV, "-3"); vec_push(_ANYV, "1.5"); vec_push(_ANYV, "null"); vec_push(_ANYV, "true");
    vec_push(_ANYV, "false"); vec_push(_ANYV, "[1]"); vec_push(_ANYV, "[]"); vec_push(_ANYV, "{}");
    vec_push(_ANYV, "{\"a\":1}"); vec_push(_ANYV, "\"\\u00e9t\\u00e9\""); vec_push(_ANYV, "[true,null]");
    _TARR = vec_new();
    vec_push(_TARR, "[\"string\",\"null\"]"); vec_push(_TARR, "[\"integer\",\"string\"]");
    vec_push(_TARR, "[\"array\",\"object\"]"); vec_push(_TARR, "[\"boolean\",\"null\",\"integer\"]");
    vec_push(_TARR, "[\"object\",\"null\"]"); vec_push(_TARR, "[\"integer\"]");
    _NAMES = vec_new();
    # (3.8.6) A name of 300 bytes, and keys that spell it plainly, with an escape, and one byte
    # short of it: the walk decodes a long key where a schema has more than eight names.
    var lg = alloc(301);
    memset(lg, 76, 300);
    store8(lg + 300, 0);
    var lge = alloc(306);
    memset(lge, 76, 299);
    memcpy(lge + 299, "\\u004c", 7);
    var lgs = alloc(300);
    memset(lgs, 76, 299);
    store8(lgs + 299, 0);
    vec_push(_NAMES, "a"); vec_push(_NAMES, "b"); vec_push(_NAMES, "c"); vec_push(_NAMES, "d");
    vec_push(_NAMES, lg);
    _KEYS = vec_new();
    vec_push(_KEYS, "a"); vec_push(_KEYS, "b"); vec_push(_KEYS, "c"); vec_push(_KEYS, "d");
    vec_push(_KEYS, "e"); vec_push(_KEYS, "\\u0061"); vec_push(_KEYS, "\\u0062"); vec_push(_KEYS, "zz");
    vec_push(_KEYS, lg); vec_push(_KEYS, lge); vec_push(_KEYS, lgs);
    _STRS = vec_new();
    vec_push(_STRS, "\"\""); vec_push(_STRS, "\"x\""); vec_push(_STRS, "\"ab\""); vec_push(_STRS, "\"abc\"");
    vec_push(_STRS, "\"abcd\""); vec_push(_STRS, "\"\\u00e9t\\u00e9\""); vec_push(_STRS, "\"\\ud83d\\ude00\"");
    vec_push(_STRS, "\"a\\nb\""); vec_push(_STRS, "\"é\""); vec_push(_STRS, "\"x\\u0079\""); vec_push(_STRS, "\"日本\"");
    # (3.8.6) Bytes that are no UTF-8, which a client reads as U+FFFD for each maximal part.
    vec_push(_STRS, "\"\x80\x80\x80\""); vec_push(_STRS, "\"\xe0\x80\x80\""); vec_push(_STRS, "\"a\xc3\"");
    vec_push(_STRS, "\"\xc3\\u0041\""); vec_push(_STRS, "\"\xf0\x9f\x98\""); vec_push(_STRS, "\"\xed\xa0\x80b\"");
    vec_push(_STRS, "\"\xff\xfe\""); vec_push(_STRS, "\"\xe1\x80A\""); vec_push(_STRS, "\"\xc3\xa9\x80\"");
    # (3.8.13) Strings near the formats' edges.
    vec_push(_STRS, "\"2020-02-29\""); vec_push(_STRS, "\"2021-02-29\""); vec_push(_STRS, "\"1.2.3.4\"");
    vec_push(_STRS, "\"01.2.3.4\""); vec_push(_STRS, "\"255.0.0.256\"");
    _ENUMS = vec_new();
    vec_push(_ENUMS, "\"x\""); vec_push(_ENUMS, "\"ab\""); vec_push(_ENUMS, "\"xy\""); vec_push(_ENUMS, "\"\\u00e9t\\u00e9\"");
    return 0;
}

fn _add(a, sb, s) { str_builder_add_cstr_a(a, sb, s); return 0; }
fn _addi(a, sb, v) { str_builder_add_int_a(a, sb, v); return 0; }

# A member `kw` with a small integer, or with a count from 0 to 3.
fn _kw_int(a, sb, kw, v, sep) {
    if (sep == 1) { _add(a, sb, ","); }
    _add(a, sb, "\"");
    _add(a, sb, kw);
    _add(a, sb, "\":");
    _addi(a, sb, v);
    return 1;
}

# (3.8.10) The definitions a `$ref` may name from the schema being drawn: d<_ref_lo> to
